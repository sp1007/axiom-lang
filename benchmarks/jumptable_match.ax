// RFC 0028 benchmark: dense 32-arm i64 match dispatched in a hot loop.
// Built twice (linear vs -jumptable) and timed externally; the LCG index defeats
// the branch predictor so the linear chain pays its true average compare count.
fn dispatch(op: i64) -> i64:
    match op:
        0:
            return 3
        1:
            return 7
        2:
            return 1
        3:
            return 9
        4:
            return 2
        5:
            return 8
        6:
            return 4
        7:
            return 6
        8:
            return 5
        9:
            return 0
        10:
            return 3
        11:
            return 7
        12:
            return 1
        13:
            return 9
        14:
            return 2
        15:
            return 8
        16:
            return 4
        17:
            return 6
        18:
            return 5
        19:
            return 0
        20:
            return 3
        21:
            return 7
        22:
            return 1
        23:
            return 9
        24:
            return 2
        25:
            return 8
        26:
            return 4
        27:
            return 6
        28:
            return 5
        29:
            return 0
        30:
            return 3
        31:
            return 7
        _:
            return 11

fn main() -> i32:
    mut acc := 0 as i64
    mut s := 12345 as i64
    mut i := 0
    while i < 20000000:
        s = (s * 1103515245 + 12345) % 2147483648
        mut op := s % 32
        acc = acc + dispatch(op)
        i = i + 1
    return (acc % 251) as i32
