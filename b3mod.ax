// Fixture for B3: a lazily-loaded (non-bundled) module that calls into the
// BUNDLED stdlib. Its symbols' decl_node indices belong to the root unit's tree.
pub fn plat_known() -> bool:
    return @compiler_intrinsic("is_windows")

pub fn twice(n: i64) -> i64:
    let d = ax_str_len("ab")
    return n * d
