import std.io

fn main():
    let r = std.io.open("bootstrap/stage1/main.ax")
    if r.is_ok():
        let f = r.unwrap()
        let r2 = f.read_all()
        if r2.is_ok():
            print("SUCCESS! Content length: ")
            println(r2.unwrap().len)
        else:
            print("read_all failed: ")
            println(r2.unwrap_err())
    else:
        print("open failed: ")
        println(r.unwrap_err())
