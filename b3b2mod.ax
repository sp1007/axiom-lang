// Fixture (not a standalone test): the imported half of bin/t_b3b2modname.ax.
// Its NAME is the whole point -- it has NO DOT, so `replace(mod_name, ".", "/")` in
// ax_driver_load_module finds nothing to substitute and returns its INPUT, making
// `rel_path` an ALIAS of `mod_name` (B3b-2). The deliberate type errors below force the
// loader down the one path that PRINTS the module name, so the name is observable.
// Compiled on its own this file is expected to be REJECTED; that is the point.
pub fn broken(x: i64) -> i64:
    return x + "not a number"

pub fn also_broken(x: i64) -> i64:
    return x + true
