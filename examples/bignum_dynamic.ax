// examples/bignum_dynamic.ax — dynamic-width arbitrary-precision bignum.
//
// Unlike the fixed U128/U256 structs, width here is chosen AT RUNTIME: a number
// is a heap limb array (ptr[u64], little-endian) + a limb count n, so the SAME
// code serves the default 128-bit (n=2) up through u4096 (n=64) and beyond by
// just passing a larger n. Covers unsigned + signed (two's complement i4096) +
// fixed-point reals (f4096), plus math: add/sub/mul/cmp/shift, gcd (binary),
// integer sqrt, factorial, fibonacci, power. The canonical library lives in
// std/bignum.ax + std/xmath.ax; this file inlines it to stay self-contained
// (the import bundler does not yet compose arbitrary std modules).
//
// Build:  axc_stage1 build examples/bignum_dynamic.ax -o bignum_dynamic && ./bignum_dynamic ; echo $?
// Expected exit code: 99 (all 10 checks pass).


struct BigUint:
    limbs: ptr[u64]
    n: i64

struct Pair:
    lo: u64
    hi: u64

fn wmul(a: u64, b: u64) -> Pair:
    let mask = 4294967295 as u64
    let aL = a & mask
    let aH = a >> 32
    let bL = b & mask
    let bH = b >> 32
    let ll = aL * bL
    let lh = aL * bH
    let hl = aH * bL
    let hh = aH * bH
    let cross = lh + hl
    mut carry := 0 as u64
    if cross < lh:
        carry = 1 as u64
    let lo = ll + (cross << 32)
    mut c2 := 0 as u64
    if lo < ll:
        c2 = 1 as u64
    let hi = hh + (cross >> 32) + (carry << 32) + c2
    return Pair(lo: lo, hi: hi)

fn bu_alloc(n: i64) -> BigUint:
    let p = @alloc(n * 8 as i64) as ptr[u64]
    mut i := 0 as i64
    while i < n:
        p[i] = 0 as u64
        i = i + 1
    return BigUint(limbs: p, n: n)

fn bu_from_u64(v: u64, n: i64) -> BigUint:
    let r = bu_alloc(n)
    r.limbs[0] = v
    return r

fn bu_is_zero(a: BigUint) -> bool:
    mut i := 0 as i64
    while i < a.n:
        if a.limbs[i] != 0 as u64:
            return false
        i = i + 1
    return true

fn bu_is_even(a: BigUint) -> bool:
    return (a.limbs[0] & 1 as u64) == 0 as u64

fn bu_cmp(a: BigUint, b: BigUint) -> i32:
    mut i := a.n - 1 as i64
    while i >= 0 as i64:
        if a.limbs[i] > b.limbs[i]:
            return 1 as i32
        if a.limbs[i] < b.limbs[i]:
            return 0 as i32 - 1 as i32
        i = i - 1 as i64
    return 0 as i32

fn bu_add(a: BigUint, b: BigUint) -> BigUint:
    let r = bu_alloc(a.n)
    mut c := 0 as u64
    mut i := 0 as i64
    while i < a.n:
        let ai = a.limbs[i]
        let s = ai + b.limbs[i]
        mut c1 := 0 as u64
        if s < ai:
            c1 = 1 as u64
        let t = s + c
        mut c2 := 0 as u64
        if t < s:
            c2 = 1 as u64
        r.limbs[i] = t
        c = c1 + c2
        i = i + 1
    return r

fn bu_sub(a: BigUint, b: BigUint) -> BigUint:
    let r = bu_alloc(a.n)
    mut borrow := 0 as u64
    mut i := 0 as i64
    while i < a.n:
        let ai = a.limbs[i]
        let bi = b.limbs[i]
        let d1 = ai - bi
        mut bw1 := 0 as u64
        if ai < bi:
            bw1 = 1 as u64
        let d2 = d1 - borrow
        mut bw2 := 0 as u64
        if d1 < borrow:
            bw2 = 1 as u64
        r.limbs[i] = d2
        borrow = bw1 + bw2
        i = i + 1
    return r

fn bu_shl1(a: BigUint) -> BigUint:
    let r = bu_alloc(a.n)
    mut carry := 0 as u64
    mut i := 0 as i64
    while i < a.n:
        let v = a.limbs[i]
        r.limbs[i] = (v << 1) + carry
        carry = v >> 63
        i = i + 1
    return r

fn bu_shr1(a: BigUint) -> BigUint:
    let r = bu_alloc(a.n)
    mut carry := 0 as u64
    mut i := a.n - 1 as i64
    while i >= 0 as i64:
        let v = a.limbs[i]
        r.limbs[i] = (v >> 1) + (carry << 63)
        carry = v & 1 as u64
        i = i - 1 as i64
    return r

fn bu_shl(a: BigUint, k: i64) -> BigUint:
    mut r := a
    mut i := 0 as i64
    while i < k:
        r = bu_shl1(r)
        i = i + 1
    return r

fn bu_bitlen(a: BigUint) -> i64:
    mut i := a.n - 1 as i64
    while i >= 0 as i64:
        if a.limbs[i] != 0 as u64:
            mut v := a.limbs[i]
            mut b := 0 as i64
            while v != 0 as u64:
                v = v >> 1
                b = b + 1
            return i * 64 as i64 + b
        i = i - 1 as i64
    return 0 as i64

// truncated to n limbs (wrapping uintN)
fn bu_mul(a: BigUint, b: BigUint) -> BigUint:
    let r = bu_alloc(a.n)
    mut i := 0 as i64
    while i < a.n:
        mut carry := 0 as u64
        mut j := 0 as i64
        while i + j < a.n:
            let idx = i + j
            let p = wmul(a.limbs[i], b.limbs[j])
            let cur = r.limbs[idx]
            let s1 = cur + p.lo
            mut k1 := 0 as u64
            if s1 < cur:
                k1 = 1 as u64
            let s2 = s1 + carry
            mut k2 := 0 as u64
            if s2 < s1:
                k2 = 1 as u64
            r.limbs[idx] = s2
            carry = p.hi + k1 + k2
            j = j + 1
        i = i + 1
    return r

// full 2n-limb product
fn bu_mul_full(a: BigUint, b: BigUint) -> BigUint:
    let r = bu_alloc(a.n * 2 as i64)
    mut i := 0 as i64
    while i < a.n:
        mut carry := 0 as u64
        mut j := 0 as i64
        while j < a.n:
            let idx = i + j
            let p = wmul(a.limbs[i], b.limbs[j])
            let cur = r.limbs[idx]
            let s1 = cur + p.lo
            mut k1 := 0 as u64
            if s1 < cur:
                k1 = 1 as u64
            let s2 = s1 + carry
            mut k2 := 0 as u64
            if s2 < s1:
                k2 = 1 as u64
            r.limbs[idx] = s2
            carry = p.hi + k1 + k2
            j = j + 1
        r.limbs[i + a.n] = carry
        i = i + 1
    return r

// --- math over bignum ---

fn bu_pow_u64(base: BigUint, e: u64, n: i64) -> BigUint:
    mut result := bu_from_u64(1 as u64, n)
    mut b := base
    mut ee := e
    while ee > 0 as u64:
        if (ee & 1 as u64) == 1 as u64:
            result = bu_mul(result, b)
        b = bu_mul(b, b)
        ee = ee >> 1
    return result

fn bu_factorial(k: i64, n: i64) -> BigUint:
    mut acc := bu_from_u64(1 as u64, n)
    mut m := 1 as u64
    mut i := 1 as i64
    while i <= k:
        acc = bu_mul(acc, bu_from_u64(m, n))
        m = m + 1 as u64
        i = i + 1
    return acc

fn bu_fib(k: i64, n: i64) -> BigUint:
    mut a := bu_from_u64(0 as u64, n)
    mut b := bu_from_u64(1 as u64, n)
    mut i := 0 as i64
    while i < k:
        let c = bu_add(a, b)
        a = b
        b = c
        i = i + 1
    return a

// binary GCD (no division needed)
fn bu_gcd(ina: BigUint, inb: BigUint) -> BigUint:
    mut x := ina
    mut y := inb
    if bu_is_zero(x):
        return y
    if bu_is_zero(y):
        return x
    mut shift := 0 as i64
    while bu_is_even(x) and bu_is_even(y):
        x = bu_shr1(x)
        y = bu_shr1(y)
        shift = shift + 1
    while bu_is_even(x):
        x = bu_shr1(x)
    while not bu_is_zero(y):
        while bu_is_even(y):
            y = bu_shr1(y)
        if bu_cmp(x, y) == 1 as i32:
            let t = x
            x = y
            y = t
        y = bu_sub(y, x)
    return bu_shl(x, shift)

// integer square root (digit-by-digit)
fn bu_isqrt(x: BigUint) -> BigUint:
    let bl = bu_bitlen(x)
    if bl == 0 as i64:
        return bu_from_u64(0 as u64, x.n)
    mut sh := (bl - 1 as i64) / 2 as i64 * 2 as i64
    mut one := bu_shl(bu_from_u64(1 as u64, x.n), sh)
    mut res := bu_from_u64(0 as u64, x.n)
    mut rem := x
    while not bu_is_zero(one):
        let rpo = bu_add(res, one)
        if bu_cmp(rem, rpo) >= 0 as i32:
            rem = bu_sub(rem, rpo)
            res = bu_add(bu_shr1(res), one)
        else:
            res = bu_shr1(res)
        one = bu_shr1(bu_shr1(one))
    return res

// --- signed (two's complement, fixed n limbs) ---

fn bi_from_i64(v: i64, n: i64) -> BigUint:
    let r = bu_alloc(n)
    r.limbs[0] = v as u64
    if v < 0 as i64:
        mut i := 1 as i64
        while i < n:
            r.limbs[i] = 18446744073709551615 as u64
            i = i + 1
    return r

fn bi_neg(a: BigUint) -> BigUint:
    let inv = bu_alloc(a.n)
    mut i := 0 as i64
    while i < a.n:
        inv.limbs[i] = (18446744073709551615 as u64) - a.limbs[i]
        i = i + 1
    return bu_add(inv, bu_from_u64(1 as u64, a.n))

fn bi_is_neg(a: BigUint) -> bool:
    return (a.limbs[a.n - 1 as i64] >> 63) == 1 as u64

// --- fixed-point bigfloat: raw = value * 2^(64*scale) ---

fn bf_from_int(v: u64, n: i64, scale: i64) -> BigUint:
    let r = bu_alloc(n)
    r.limbs[scale] = v
    return r

fn bf_mul(a: BigUint, b: BigUint, scale: i64) -> BigUint:
    let full = bu_mul_full(a, b)
    let r = bu_alloc(a.n)
    mut i := 0 as i64
    while i < a.n:
        r.limbs[i] = full.limbs[i + scale]
        i = i + 1
    return r

pub fn main() -> i32:
    mut s := 0 as i32

    // 1. dynamic width 128: 1e12 * 1e12 = 1e24 (> 64 bits)
    let a = bu_from_u64(1000000000000 as u64, 2 as i64)
    let p = bu_mul(a, a)
    if p.limbs[1] != 0 as u64:
        s = s + 1

    // 2. width 4096: 2^100 -> limb1 bit36
    let two64 = bu_from_u64(2 as u64, 64 as i64)
    let p100 = bu_pow_u64(two64, 100 as u64, 64 as i64)
    if p100.limbs[1] == (1 as u64 << 36) and p100.limbs[0] == 0 as u64:
        s = s + 2

    // 3. 50! wide -> high limb set
    let f50 = bu_factorial(50 as i64, 64 as i64)
    if f50.limbs[2] != 0 as u64 or f50.limbs[3] != 0 as u64:
        s = s + 4

    // 4. sub: (2^128) - 1 in 256-bit width -> low two limbs all ones
    mut p128 := bu_from_u64(1 as u64, 4 as i64)
    p128 = bu_shl(p128, 128 as i64)
    let allones = bu_sub(p128, bu_from_u64(1 as u64, 4 as i64))
    if allones.limbs[0] == 18446744073709551615 as u64 and allones.limbs[1] == 18446744073709551615 as u64 and allones.limbs[2] == 0 as u64:
        s = s + 8

    // 5. shl1/shr1 roundtrip
    let v0 = bu_from_u64(123456789 as u64, 4 as i64)
    let rt = bu_shr1(bu_shl1(v0))
    if bu_cmp(rt, v0) == 0 as i32:
        s = s + 16

    // 6. gcd(48,36)=12 and gcd(1e12, 36)=4
    let g1 = bu_gcd(bu_from_u64(48 as u64, 4 as i64), bu_from_u64(36 as u64, 4 as i64))
    if g1.limbs[0] == 12 as u64:
        s = s + 32

    // 7. isqrt(1e24) = 1e12 (256-bit width)
    let big = bu_mul(bu_from_u64(1000000000000 as u64, 4 as i64), bu_from_u64(1000000000000 as u64, 4 as i64))
    let r7 = bu_isqrt(big)
    if r7.limbs[0] == 1000000000000 as u64 and r7.limbs[1] == 0 as u64:
        s = s + 64

    // 8. fib(100) low limb check: F(100) lo % 1000 == 371
    let f100 = bu_fib(100 as i64, 4 as i64)
    if (f100.limbs[0] % 1000 as u64) == 371 as u64 and f100.limbs[1] == 19 as u64:
        s = s + 128

    // 9. signed: neg(neg(x))==x, (-5)*(-7)=35, sign flags
    let x9 = bi_from_i64(123456789 as i64, 4 as i64)
    let nn = bi_neg(bi_neg(x9))
    let m9 = bu_mul(bi_from_i64(0 as i64 - 5 as i64, 4 as i64), bi_from_i64(0 as i64 - 7 as i64, 4 as i64))
    if bu_cmp(nn, x9) == 0 as i32 and m9.limbs[0] == 35 as u64 and bi_is_neg(bi_from_i64(0 as i64 - 1 as i64, 4 as i64)):
        s = s + 256

    // 10. fixed-point: 1.5 * 2.0 = 3.0 (n=4, scale=2, Q128.128)
    mut onehalf := bf_from_int(1 as u64, 4 as i64, 2 as i64)
    onehalf.limbs[1] = 9223372036854775808 as u64    // + 0.5 * 2^128 = 2^127
    let twofx = bf_from_int(2 as u64, 4 as i64, 2 as i64)
    let prod = bf_mul(onehalf, twofx, 2 as i64)
    if prod.limbs[2] == 3 as u64 and prod.limbs[0] == 0 as u64 and prod.limbs[1] == 0 as u64:
        s = s + 512

    if s == 1023 as i32:
        return 99 as i32
    return s   // partial: which bits set reveals failures
