// AXIOM Standard Library — bootstrap/runtime/syscall.ax
//
// Raw OS system call wrappers for Linux and Win32 FFI for Windows.

extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64

extern "C" fn VirtualAlloc(lpAddress: ptr[void], dwSize: u64, flAllocationType: u32, flProtect: u32) -> ptr[void]
extern "C" fn VirtualFree(lpAddress: ptr[void], dwSize: u64, dwFreeType: u32) -> i32
extern "C" fn GetStdHandle(nStdHandle: u32) -> ptr[void]
extern "C" fn WriteFile(hFile: ptr[void], lpBuffer: ptr[void], nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: ptr[void], lpOverlapped: ptr[void]) -> i32
extern "C" fn ExitProcess(uExitCode: u32)

pub fn sys_mmap(addr: ptr[void], len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> ptr[void]:
    if @compiler_intrinsic("is_windows"):
        // Windows flAllocationType: MEM_COMMIT | MEM_RESERVE = 0x3000
        // flProtect: PAGE_READWRITE = 0x04
        return VirtualAlloc(addr, len, 0x3000 as u32, 0x04 as u32)
    else:
        // Linux: SYS_MMAP = 9
        let res = syscall(9 as u64, addr as u64, len, prot as u64, flags as u64, fd as u64, offset as u64)
        return res as ptr[void]

pub fn sys_munmap(addr: ptr[void], len: u64) -> i32:
    if @compiler_intrinsic("is_windows"):
        // Windows dwFreeType: MEM_RELEASE = 0x8000
        // VirtualFree returns non-zero on success, 0 on failure. We map success to 0, failure to -1.
        let res = VirtualFree(addr, 0 as u64, 0x8000 as u32)
        if res != 0:
            return 0
        return -1
    else:
        // Linux: SYS_MUNMAP = 11
        let res = syscall(11 as u64, addr as u64, len, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        return res as i32

pub fn sys_write(fd: i32, buf: ptr[void], count: u64) -> i64:
    if @compiler_intrinsic("is_windows"):
        mut std_handle := 0xFFFFFFF4 as u32 // STD_ERROR_HANDLE
        if fd == 1:
            std_handle = 0xFFFFFFF5 as u32 // STD_OUTPUT_HANDLE
        let h = GetStdHandle(std_handle)
        mut written := 0 as u32
        let res = WriteFile(h, buf, count as u32, &written as ptr[void], null as ptr[void])
        if res != 0:
            return written as i64
        return -1
    else:
        // Linux: SYS_WRITE = 1
        return syscall(1 as u64, fd as u64, buf as u64, count, 0 as u64, 0 as u64, 0 as u64)

pub fn sys_exit(code: i32):
    if @compiler_intrinsic("is_windows"):
        ExitProcess(code as u32)
    else:
        // Linux: SYS_EXIT = 60
        syscall(60 as u64, code as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
