// bootstrap/stage1/ctgc.ax
// Compile-Time Garbage Collection (CTGC) injector.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct CtgcInjector:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub active_vars: U32Vec // Stack of active sym_idx's
    pub active_var_decls: U32Vec // Stack of AST node decl indices
    pub free_enabled: bool // RFC 0015 P3: -ctgc-free opt-in; OFF => whole pass is inert
    pub report_only: bool // RFC 0015 P3 precursor: -ctgc-free-report — PRINT the freeable set, inject nothing (dump-only, byte-identical output)

pub fn new_ctgc_injector(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[CtgcInjector]:
    let ci = @alloc(@compiler_intrinsic("size_of")[CtgcInjector]()) as ptr[CtgcInjector]
    ci.tree = tree
    ci.pool = pool
    ci.symtable = symtable
    ci.typetable = typetable
    ci.active_vars = new_u32_vec()
    ci.active_var_decls = new_u32_vec()
    ci.free_enabled = false
    ci.report_only = false
    return ci

pub fn run(mut self: ptr[CtgcInjector]):
    // RFC 0015 P3: the whole pass is opt-in behind -ctgc-free. With BOTH flags OFF
    // (the default, incl. the self-host build) run() returns immediately and no
    // OP_DESTROY is injected, so output is byte-identical to the historical no-op
    // (fixpoint A==B). -ctgc-free ON => compile-time free activates. -ctgc-free-report
    // ON => the traversal runs but only PRINTS the freeable set (no tree mutation,
    // still byte-identical output) — the P3 measurement precursor.
    if not self.free_enabled and not self.report_only:
        return
    self.traverse_and_inject(0 as u32, 0 as u32)

// A local is freeable (CTGC may free it) iff it is a NON-escaping heap aggregate.
// Reads SYM_FLAG_ESCAPES (4096, sym-flag space) set by the EscapeAnalyser -- NOT the
// old FLAG_ESCAPES_TO_HEAP (128), which aliases SYM_FLAG_MOVED. Factored out so the
// block-fall-through pass and (future) callers share ONE predicate; the logic is
// byte-identical to the original inline collect so fall-through free is unchanged.
pub fn is_freeable_local(self: ptr[CtgcInjector], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32:
        return false
    let sym = self.symtable.symbols.data[sym_idx]
    if (sym.flags & SYM_FLAG_ESCAPES) != 0 as u16:
        return false
    let type_id = sym.type_id
    if type_id == 0 as u32 or (type_id as i64) >= self.typetable.entries.len:
        return false
    let entry = self.typetable.entries.data[type_id]
    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
        return true
    return false

pub fn traverse_and_inject(mut self: ptr[CtgcInjector], node_idx: u32, parent_idx: u32):
    // Guard: node 0 is the real NODE_PROGRAM root (ast.ax::new_ast_tree), so the
    // historical `node_idx == 0` clause made the pass a permanent no-op. Recursive
    // descents already filter `!= 0` at every call site, so only 0xffffffff is a
    // genuine sentinel. Reached only when free_enabled (gated in run()).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_BLOCK:
        let start_len = self.active_vars.len

        // Single ORDERED pass (RFC 0015 P3 return-path free): descend into each child,
        // then push a freeable var AFTER its decl has been passed, so `active_vars`
        // reflects program order -- a local is on the stack only once its declaration
        // has been descended past. This is what makes return-path free sound: at a
        // NODE_RETURN_STMT (handled below) the ENTIRE stack is provably initialised, so
        // freeing it never touches a not-yet-declared local. The freeable SET and the
        // reverse (LIFO) destroy order at fall-through are identical to the old
        // two-pass collect, so the shipped fall-through free is byte-unchanged.
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let ck = self.tree.nodes.data[child_idx].kind
            let cpay = self.tree.nodes.data[child_idx].payload
            self.traverse_and_inject(child_idx, node_idx)
            if ck == NODE_VAR_DECL:
                if self.is_freeable_local(cpay):
                    self.active_vars.push(cpay)
                    self.active_var_decls.push(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

        // Inject destroy statements for THIS block's vars at fall-through (block end).
        let num_block_vars = self.active_vars.len - start_len
        if num_block_vars > 0 as i64:
            mut idx := self.active_vars.len - 1 as i64
            while idx >= start_len:
                let sym_idx = self.active_vars.data[idx]
                if self.report_only:
                    // Dump-only precursor: PRINT the freeable local, mutate nothing.
                    // Enumerates the freeable set across the compiled program so the
                    // future activation session can inspect the (currently un-enumerated)
                    // borrow-alias blast radius. See [[ctgc-p3-scoping-2026-07-18]].
                    let sym = self.symtable.symbols.data[sym_idx]
                    let nm = self.pool.get_str(sym.name_id)
                    ax_puts_local(std.string.concat("[ctgc-freeable] ", nm))
                else:
                    // Create NODE_DESTROY_STMT node
                    let destroy_node = self.tree.add_node(NODE_DESTROY_STMT, node.token_idx)
                    self.tree.nodes.data[destroy_node].payload = sym_idx
                    self.append_child_node(node_idx, destroy_node)
                idx = idx - 1

            // Pop them from stack
            self.active_vars.len = start_len
            self.active_var_decls.len = start_len

    elif kind == NODE_RETURN_STMT:
        // RFC 0015 P3 return-path free. A `return` exits ALL enclosing scopes, so every
        // currently-live freeable local must be freed on this path too -- otherwise a
        // local live on a return path leaks (the old fall-through-only behaviour). We
        // append the destroys as TRAILING children of the return node; lower_return
        // lowers them AFTER the return value is materialised, so `return r.field` reads
        // `r` before `r` is freed (no UAF -- the reason we do NOT inject a plain destroy
        // *before* the return). Every stack entry is provably initialised here
        // (ordered-descent above), and the EscapeAnalyser has already excluded any local
        // whose memory can reach the return value (t_ctgcfreeesc pins that). report_only
        // must stay byte-identical (no tree mutation), so it appends nothing.
        let val_child = node.first_child
        if val_child != 0 as u32:
            self.traverse_and_inject(val_child, node_idx)
        if self.free_enabled and self.active_vars.len > 0 as i64:
            mut ri := self.active_vars.len - 1 as i64
            while ri >= 0 as i64:
                let sym_idx = self.active_vars.data[ri]
                let destroy_node = self.tree.add_node(NODE_DESTROY_STMT, node.token_idx)
                self.tree.nodes.data[destroy_node].payload = sym_idx
                self.append_child_node(node_idx, destroy_node)
                ri = ri - 1 as i64

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.traverse_and_inject(child_idx, node_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn append_child_node(mut self: ptr[CtgcInjector], parent: u32, child: u32):
    if self.tree.nodes.data[parent].first_child == 0 as u32:
        self.tree.nodes.data[parent].first_child = child
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while self.tree.nodes.data[cur].next_sibling != 0 as u32:
        cur = self.tree.nodes.data[cur].next_sibling
    self.tree.nodes.data[cur].next_sibling = child

pub fn insert_before(mut self: ptr[CtgcInjector], parent: u32, target: u32, new_node: u32):
    if self.tree.nodes.data[parent].first_child == target:
        self.tree.nodes.data[new_node].next_sibling = target
        self.tree.nodes.data[parent].first_child = new_node
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while cur != 0 as u32:
        if self.tree.nodes.data[cur].next_sibling == target:
            self.tree.nodes.data[new_node].next_sibling = target
            self.tree.nodes.data[cur].next_sibling = new_node
            return
        cur = self.tree.nodes.data[cur].next_sibling
