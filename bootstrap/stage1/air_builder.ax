// bootstrap/stage1/air_builder.ax
// SSA-form Intermediate Representation (AIR) builder for self-hosted AXIOM frontend.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64

pub struct LocalMapEntry:
    pub name_id: u32
    pub reg: u32

pub struct LocalMap:
    pub entries: ptr[LocalMapEntry]
    pub count: u32
    pub capacity: u32

pub fn new_local_map() -> ptr[LocalMap]:
    let capacity = 16 as u32
    let entries = @alloc(capacity as i64 * 8) as ptr[LocalMapEntry]
    mut i := 0 as i64
    while i < capacity as i64:
        entries[i] = LocalMapEntry(name_id: 0 as u32, reg: 0 as u32)
        i = i + 1
    let lm = @alloc(@compiler_intrinsic("size_of")[LocalMap]()) as ptr[LocalMap]
    lm.entries = entries
    lm.count = 0 as u32
    lm.capacity = capacity
    return lm

pub fn free_local_map(mut self: ptr[LocalMap]):
    if self.entries != null as ptr[LocalMapEntry]:
        @free(self.entries as ptr[u8])

fn local_map_hash(v: u32) -> u32:
    mut hash := 2166136261 as u32
    hash = hash ^ (v & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 8 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 16 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 24 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    return hash

pub fn local_map_put(mut self: ptr[LocalMap], name_id: u32, reg: u32):
    if self.count * 4 as u32 > self.capacity * 3 as u32:
        self.local_map_grow()
    self.local_map_insert(name_id, reg)
    self.count = self.count + 1 as u32

fn local_map_insert(self: ptr[LocalMap], name_id: u32, reg: u32):
    let mask = self.capacity - 1 as u32
    mut idx = local_map_hash(name_id) & mask
    while true:
        if self.entries[idx].name_id == 0 as u32 or self.entries[idx].name_id == name_id:
            self.entries[idx].name_id = name_id
            self.entries[idx].reg = reg
            return
        idx = (idx + 1 as u32) & mask

pub fn local_map_get(self: ptr[LocalMap], name_id: u32) -> u32:
    if self.capacity == 0 as u32:
        return 0 as u32
    let mask = self.capacity - 1 as u32
    mut idx = local_map_hash(name_id) & mask
    let start_idx = idx
    while true:
        let entry = self.entries[idx]
        if entry.name_id == 0 as u32:
            return 0 as u32
        if entry.name_id == name_id:
            return entry.reg
        idx = (idx + 1 as u32) & mask
        if idx == start_idx:
            break
    return 0 as u32

fn local_map_grow(mut self: ptr[LocalMap]):
    let old_entries = self.entries
    let old_capacity = self.capacity
    let new_cap = old_capacity * 2 as u32
    self.capacity = new_cap
    self.entries = @alloc(new_cap as i64 * 8) as ptr[LocalMapEntry]
    mut i := 0 as i64
    while i < new_cap as i64:
        self.entries[i] = LocalMapEntry(name_id: 0 as u32, reg: 0 as u32)
        i = i + 1

    i = 0 as i64
    while i < old_capacity as i64:
        let entry = old_entries[i]
        if entry.name_id != 0 as u32:
            self.local_map_insert(entry.name_id, entry.reg)
        i = i + 1
    @free(old_entries as ptr[u8])

pub struct AirModuleBuilder:
    pub tree: ptr[AstTree]
    pub symbols: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub pool: ptr[InternPool]
    pub module: AirModule
    pub node_types: ptr[u32]

pub fn new_air_module_builder(tree: ptr[AstTree], symbols: ptr[SymbolTable], typetable: ptr[TypeTable], pool: ptr[InternPool], node_types: ptr[u32]) -> ptr[AirModuleBuilder]:
    let amb = @alloc(@compiler_intrinsic("size_of")[AirModuleBuilder]()) as ptr[AirModuleBuilder]
    amb.tree = tree
    amb.symbols = symbols
    amb.typetable = typetable
    amb.pool = pool
    amb.module = AirModule(funcs: new_air_func_vec(), globals: new_air_global_vec())
    amb.node_types = node_types
    return amb

pub fn free_air_module_builder(self: ptr[AirModuleBuilder]):
    free_air_module(self.module)

pub fn get_token_text(self: ptr[AirModuleBuilder], token_idx: u32) -> str:
    let tok = self.tree.tokens.data[token_idx as i64]
    if tok.len == 0 as u16:
        return alloc_str_from_raw(null as ptr[u8], 0)
    let start_ptr = ((get_str_ptr(self.tree.src)) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn parse_int_from_str(s: str) -> i64:
    let len = std.string.len(s)
    if len == 0:
        return 0 as i64
    mut i := 0
    mut sign := 1 as i64
    if s[0] as u8 == '-' as u8:
        sign = -1 as i64
        i = 1
    elif s[0] as u8 == '+' as u8:
        i = 1

    mut base := 10 as i64
    if i + 1 < len and s[i] as u8 == '0' as u8:
        let next_char = s[i + 1] as u8
        if next_char == 'x' as u8 or next_char == 'X' as u8:
            base = 16 as i64
            i = i + 2
        elif next_char == 'o' as u8 or next_char == 'O' as u8:
            base = 8 as i64
            i = i + 2
        elif next_char == 'b' as u8 or next_char == 'B' as u8:
            base = 2 as i64
            i = i + 2

    mut val := 0 as i64
    while i < len:
        let c = s[i] as u8
        // digit-group separator: skip and keep scanning (e.g. 1_000_000)
        if c == '_' as u8:
            i = i + 1
            continue
        mut digit := -1 as i64
        if c >= '0' as u8 and c <= '9' as u8:
            digit = (c - '0' as u8) as i64
        elif c >= 'a' as u8 and c <= 'f' as u8:
            digit = (c - 'a' as u8 + 10 as u8) as i64
        elif c >= 'A' as u8 and c <= 'F' as u8:
            digit = (c - 'A' as u8 + 10 as u8) as i64

        if digit < 0 or digit >= base:
            break

        val = val * base + digit
        i = i + 1

    return val * sign

pub fn map_binary_op(op: str) -> u16:
    if op == "+":
        return OP_IADD
    if op == "-":
        return OP_ISUB
    if op == "*":
        return OP_IMUL
    if op == "/":
        return OP_IDIV
    if op == "%":
        return OP_IMOD
    if op == "==":
        return OP_EQ
    if op == "!=":
        return OP_NE
    if op == "<":
        return OP_LT
    if op == "<=":
        return OP_LE
    if op == ">":
        return OP_GT
    if op == ">=":
        return OP_GE
    if op == "and" or op == "&&" or op == "&":
        return OP_AND
    if op == "or" or op == "||" or op == "|":
        return OP_OR
    if op == "^":
        return OP_XOR
    if op == "<<":
        return OP_SHL
    if op == ">>":
        return OP_SHR
    return OP_NOP

pub struct FuncLowering:
    pub mb: ptr[AirModuleBuilder]
    pub fb: ptr[AirFuncBuilder]
    pub locals: ptr[LocalMap]
    pub params: U32Vec
    pub terminated: bool
    pub loop_conds: U32Vec
    pub loop_exits: U32Vec
    // BUG#89: per-loop counter register + type used to advance a `for` loop's counter
    // when `continue` short-circuits to the condition. The body-tail increment only
    // runs on normal fall-through, so `continue` (which jumps straight to cond) must
    // emit the same increment inline first, or the counter never advances -> infinite
    // loop. A while-loop pushes reg 0 (no increment). Kept parallel to loop_conds.
    pub loop_incr_regs: U32Vec
    pub loop_incr_types: U32Vec
    // RFC 0020 P2b: per-loop counter STEP register. 0 means the default +1 (range /
    // array / Vec / bytes loops). For `for c in str` the step is the current
    // codepoint's UTF-8 byte width, so the counter advances variably — both the
    // body-tail increment and `continue` add this reg instead of a constant 1.
    pub loop_incr_steps: U32Vec
    // RFC 0006 (#38.4): deferred expression node indices, in textual order.
    // Flushed LIFO at every return and at function exit (Go-style function-level
    // defer). See lower_defer / flush_defers.
    pub defers: U32Vec

pub fn new_func_lowering(mb: ptr[AirModuleBuilder], fb: ptr[AirFuncBuilder], params: U32Vec) -> ptr[FuncLowering]:
    let fl = @alloc(@compiler_intrinsic("size_of")[FuncLowering]()) as ptr[FuncLowering]
    fl.mb = mb
    fl.fb = fb
    fl.locals = new_local_map()
    fl.params = params
    fl.terminated = false
    fl.loop_conds = new_u32_vec()
    fl.loop_exits = new_u32_vec()
    fl.loop_incr_regs = new_u32_vec()
    fl.loop_incr_types = new_u32_vec()
    fl.loop_incr_steps = new_u32_vec()
    fl.defers = new_u32_vec()
    return fl

pub fn free_func_lowering(mut self: ptr[FuncLowering]):
    free_local_map(self.locals)
    if self.params.data != null as ptr[u32]:
        @free(self.params.data as ptr[u8])
    if self.loop_conds.data != null as ptr[u32]:
        @free(self.loop_conds.data as ptr[u8])
    if self.loop_exits.data != null as ptr[u32]:
        @free(self.loop_exits.data as ptr[u8])
    if self.loop_incr_regs.data != null as ptr[u32]:
        @free(self.loop_incr_regs.data as ptr[u8])
    if self.loop_incr_types.data != null as ptr[u32]:
        @free(self.loop_incr_types.data as ptr[u8])
    if self.loop_incr_steps.data != null as ptr[u32]:
        @free(self.loop_incr_steps.data as ptr[u8])
    if self.defers.data != null as ptr[u32]:
        @free(self.defers.data as ptr[u8])

pub fn register_params(mut self: ptr[FuncLowering], func_idx: u32, func_node: AstNode):
    mut child := func_node.first_child
    mut param_idx := 0 as i64
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_PARAM_DECL:
            mut name_id := cn.payload
            if name_id == 0 as u32:
                let tok_str = self.mb.get_token_text(cn.token_idx)
                name_id = self.mb.pool.intern(tok_str)
                @free(get_str_ptr(tok_str))

            let reg = self.fb.fresh_reg()
            mut type_id := 0 as u32
            if param_idx < self.params.len:
                type_id = self.params.data[param_idx] as u32

            self.fb.emit(AirInst(
                opcode: OP_COPY,
                type_id: type_id,
                dest: reg,
                src1: (param_idx + 1) as u32,
                src2: 0 as u32,
            ))

            self.locals.local_map_put(name_id, reg)
            param_idx = param_idx + 1
        child = cn.next_sibling

pub fn builder_type_size_and_align(table: ptr[TypeTable], type_id: u32, out_size: ptr[u32], out_align: ptr[u32]):
    if type_id == 0 as u32:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32
        return

    mut entry := &table.entries.data[type_id]
    if entry.size != 0 as u32:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return

    if entry.kind == TYPE_KIND_PRIMITIVE:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return
    elif entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
        // For a generic instance, find the concrete struct definition by name.
        // If none matches (the base is a pointer-layout sum/option/result, not a
        // struct), fall through to the 8-byte pointer default — never index the
        // structs array with a sum index, which yields a garbage size and breaks
        // the value-passing/return ABI (e.g. Result returned as 16 bytes).
        mut struct_idx := 0xffffffff as u32
        if entry.kind == TYPE_KIND_STRUCT:
            struct_idx = entry.extra
        else:
            mut idx := 0 as i64
            while idx < table.entries.len:
                let e = table.entries.data[idx]
                if e.kind == TYPE_KIND_STRUCT and e.name_id == entry.name_id:
                    struct_idx = e.extra
                    break
                idx = idx + 1
        if struct_idx != 0xffffffff as u32:
            let info = table.structs.data[struct_idx]
            mut offset := 0 as u32
            mut max_align := 1 as u32
            mut i := 0 as i64
            while i < info.fields.len:
                let f = info.fields.data[i]
                mut f_size := 0 as u32
                mut f_align := 0 as u32
                builder_type_size_and_align(table, f.type_id, &f_size, &f_align)
                if f_align == 0 as u32:
                    f_align = 8 as u32
                // Align offset
                offset = (offset + f_align - 1 as u32) & ~(f_align - 1 as u32)
                offset = offset + f_size
                if f_align > max_align:
                    max_align = f_align
                i = i + 1

            mut size := (offset + max_align - 1 as u32) & ~(max_align - 1 as u32)
            if size == 0 as u32:
                size = 8 as u32
            entry.size = size
            entry.align = max_align
            out_size[0] = size
            out_align[0] = max_align
        else:
            out_size[0] = 8 as u32
            out_align[0] = 8 as u32
    elif entry.kind == TYPE_KIND_ARRAY:
        let elem_id = entry.extra
        let length = entry.name_id
        mut elem_size := 0 as u32
        mut elem_align := 0 as u32
        builder_type_size_and_align(table, elem_id, &elem_size, &elem_align)
        let size = elem_size * length
        entry.size = size
        entry.align = elem_align
        out_size[0] = size
        out_align[0] = elem_align
    else:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32

pub fn try_lower_sizeof(mut self: ptr[FuncLowering], idx: u32) -> u32:
    let node = self.mb.tree.nodes.data[idx as i64]
    if node.kind != NODE_CALL_EXPR:
        return 0 as u32
    
    let callee_idx = node.first_child
    if callee_idx == 0 as u32:
        return 0 as u32
    let callee_node = self.mb.tree.nodes.data[callee_idx as i64]
    if callee_node.kind != NODE_INDEX_EXPR:
        return 0 as u32
        
    let inner_call_idx = callee_node.first_child
    if inner_call_idx == 0 as u32:
        return 0 as u32
    let inner_call_node = self.mb.tree.nodes.data[inner_call_idx as i64]
    if inner_call_node.kind != NODE_CALL_EXPR:
        return 0 as u32
        
    let inner_callee_idx = inner_call_node.first_child
    if inner_callee_idx == 0 as u32:
        return 0 as u32
    let inner_callee_node = self.mb.tree.nodes.data[inner_callee_idx as i64]
    if inner_callee_node.kind != NODE_IDENT:
        return 0 as u32
        
    let inner_callee_name = self.mb.get_token_text(inner_callee_node.token_idx)
    let is_intrinsic = (inner_callee_name == "compiler_intrinsic" or inner_callee_name == "@compiler_intrinsic")
    @free(get_str_ptr(inner_callee_name))
    if not is_intrinsic:
        return 0 as u32
        
    // Check if the argument is "size_of"
    let arg_idx = self.mb.tree.nodes.data[inner_callee_idx as i64].next_sibling
    if arg_idx == 0 as u32:
        return 0 as u32
    let arg_node = self.mb.tree.nodes.data[arg_idx as i64]
    if arg_node.kind != NODE_STRING_LIT:
        return 0 as u32
        
    let arg_text = self.mb.get_token_text(arg_node.token_idx)
    let is_sizeof = (arg_text == "\"size_of\"" or arg_text == "'size_of'" or arg_text == "size_of")
    @free(get_str_ptr(arg_text))
    if not is_sizeof:
        return 0 as u32
        
    // The type node is the index of the index expr (next sibling of the inner call)
    let type_node_idx = self.mb.tree.nodes.data[inner_call_idx as i64].next_sibling
    if type_node_idx == 0 as u32 or type_node_idx == 0xffffffff as u32 or (type_node_idx as i64) >= self.mb.tree.nodes.len:
        return 0 as u32
        
    let type_node = self.mb.tree.nodes.data[type_node_idx as i64]
        
    mut target_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        target_type = self.mb.node_types[type_node_idx as i64]
    if target_type == 0 as u32:
        let sym_idx = type_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            target_type = self.mb.symbols.symbols.data[sym_idx as i64].type_id
            
    mut size := 0 as u32
    mut align := 0 as u32
    if target_type == 0 as u32:
        size = 8 as u32
    elif (target_type as i64) >= self.mb.typetable.entries.len:
        size = 8 as u32
    else:
        builder_type_size_and_align(self.mb.typetable, target_type, &size, &align)
    
    // Emit an OP_ICONST with the evaluated size!
    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 4 as u32, // i64
        dest: reg,
        src1: size,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_expr(mut self: ptr[FuncLowering], idx: u32) -> u32:
    if idx == 0 as u32:
        return 0 as u32
        
    let sizeof_reg = self.try_lower_sizeof(idx)
    if sizeof_reg != 0 as u32:
        return sizeof_reg
        
    let node = self.mb.tree.nodes.data[idx as i64]
    if node.kind == NODE_INT_LIT:
        return self.lower_int_lit(idx, node)
    if node.kind == NODE_FLOAT_LIT:
        return self.lower_float_lit(idx, node)
    if node.kind == NODE_BOOL_LIT:
        return self.lower_bool_lit(node)
    if node.kind == NODE_NIL_LIT:
        return self.lower_nil_lit()
    if node.kind == NODE_STRING_LIT:
        return self.lower_string_lit(node)
    if node.kind == NODE_CHAR_LIT:
        return self.lower_char_lit(node)
    if node.kind == NODE_IDENT:
        return self.lower_ident(node)
    if node.kind == NODE_CLOSURE_EXPR:
        // RFC 0008: a lambda-lifted closure reference. Its payload is the resolved
        // symbol index of the synthesized top-level function (set by the resolver).
        // Emit its address exactly like a bare function name (BUG#49 fn-ptr path).
        let cl_faddr = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_FUNC_ADDR,
            type_id: 4 as u32,
            dest: cl_faddr,
            src1: node.payload,
            src2: 0 as u32,
        ))
        return cl_faddr
    if node.kind == NODE_BINARY_EXPR:
        return self.lower_binary_expr(idx, node)
    if node.kind == NODE_UNARY_EXPR:
        return self.lower_unary_expr(idx, node)
    if node.kind == NODE_CALL_EXPR:
        return self.lower_call_expr(idx, node)
    if node.kind == NODE_FIELD_EXPR:
        return self.lower_field_expr(idx, node)
    if node.kind == NODE_INDEX_EXPR:
        return self.lower_index_expr(idx, node)
    if node.kind == NODE_CAST_EXPR:
        return self.lower_cast_expr(idx, node)
    if node.kind == NODE_DEREF_EXPR:
        return self.lower_deref_expr(idx, node)
    if node.kind == NODE_SPAWN_EXPR:
        return self.lower_spawn_expr(idx, node)
    if node.kind == NODE_AWAIT_EXPR:
        return self.lower_await_expr(idx, node)
    if node.kind == NODE_STRUCT_LIT:
        return self.lower_struct_lit(idx, node)
    if node.kind == NODE_ARRAY_LIT:
        return self.lower_array_lit(idx, node)
    return 0 as u32

pub fn lower_int_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    let val = parse_int_from_str(text)
    @free(get_str_ptr(text))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: type_id,
        dest: reg,
        src1: val as u32,
        src2: (val >> 32 as i64) as u32,
    ))
    return reg

pub fn lower_float_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut fv := atof(get_str_ptr(text))
    @free(get_str_ptr(text))

    mut type_id := 10 as u32 // default f64
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    // RFC 0006: carry the IEEE-754 bit pattern of the constant (NOT the
    // int-truncated value) split across src1(low32)/src2(high32). For f32 narrow
    // to single precision first so the 32-bit pattern lands in src1 (src2=0).
    // (`fv as f32` here is a dead path during self-host — the compiler source has
    // no f32 literals — so it cannot affect the fixpoint; it only runs when
    // compiling user code with f32 literals.)
    mut bits := (&fv as ptr[u64])[0]
    if type_id == 9 as u32:
        mut f32v := fv as f32
        bits = ((&f32v as ptr[u32])[0]) as u64
    self.fb.emit(AirInst(
        opcode: OP_FCONST,
        type_id: type_id,
        dest: reg,
        src1: (bits & (0xFFFFFFFF as u64)) as u32,
        src2: (bits >> (32 as u64)) as u32,
    ))
    return reg

pub fn lower_bool_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut val := 0 as u32
    if text == "true":
        val = 1 as u32
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 11 as u32, // bool
        dest: reg,
        src1: val,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_nil_lit(mut self: ptr[FuncLowering]) -> u32:
    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 0 as u32,
        dest: reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_string_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    let str_id = self.mb.pool.intern(text)
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 12 as u32, // string
        dest: reg,
        src1: str_id,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_char_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut val := 0 as u32
    let length = std.string.len(text)
    if length > 0:
        if length >= 3 and text[0] as u8 == '\'' as u8 and text[length - 1] as u8 == '\'' as u8:
            if text[1] as u8 == '\\' as u8 and length >= 4:
                let esc = text[2] as u8
                if esc == 'n' as u8:
                    val = 10 as u32
                elif esc == 't' as u8:
                    val = 9 as u32
                elif esc == 'r' as u8:
                    val = 13 as u32
                elif esc == '\'' as u8:
                    val = 39 as u32
                elif esc == '\\' as u8:
                    val = 92 as u32
                elif esc == '0' as u8:
                    val = 0 as u32
                elif esc == 'b' as u8:
                    val = 8 as u32
                elif esc == 'f' as u8:
                    val = 12 as u32
                else:
                    val = esc as u32
            else:
                val = text[1] as u32
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 13 as u32, // char8
        dest: reg,
        src1: val,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_ident(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let text = self.mb.get_token_text(node.token_idx)
    if text == "null" or text == "nil":
        @free(get_str_ptr(text))
        return self.lower_nil_lit()
    if text == "None":
        // Bare `None` in expression position: pointer-layout null sum value.
        @free(get_str_ptr(text))
        let none_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: 4 as u32,
            dest: none_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        return none_reg
    let actual_name_id = self.mb.pool.intern(text)

    mut is_resolved := false
    mut sym_idx := 0 as u32
    if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[node.payload as i64]
        if sym.name_id == actual_name_id:
            is_resolved = true
            sym_idx = node.payload

    @free(get_str_ptr(text))

    if is_resolved:
        let sym = self.mb.symbols.symbols.data[sym_idx as i64]
        if sym.kind == SYM_CONST:
            mut init_expr := 0 as u32
            mut child := self.mb.tree.nodes.data[sym.decl_node as i64].first_child
            while child != 0 as u32:
                let child_node = self.mb.tree.nodes.data[child as i64]
                if child_node.kind != NODE_TYPE_EXPR and child_node.kind != NODE_GENERIC_TYPE:
                    init_expr = child
                child = child_node.next_sibling
            if init_expr != 0 as u32:
                return self.lower_expr(init_expr)
            return 0 as u32

        if sym.kind == SYM_VARIANT and sym.type_id != 0 as u32 and (sym.type_id as i64) < self.mb.typetable.entries.len:
            // RFC 0004: bare no-payload user variant (e.g. `Green`) in expr
            // position. Only user sum types (kind 6); builtin None handled above.
            if self.mb.typetable.entries.data[sym.type_id as i64].kind == TYPE_KIND_SUM:
                return self.lower_variant_construct(sym_idx, 0 as u32)

        if sym.kind == SYM_FUNC:
            // Bare top-level function name used as a value -> function pointer.
            // Emit its address; type_id carries the function symbol index.
            let faddr = self.fb.fresh_reg()
            // type_id = i64 so the result register is a plain 8-byte GPR value
            // (a code address); the function's SYMBOL index rides in src1 for the
            // backend relocation. (Overloading type_id with the symbol index
            // would make get_register_type mis-type the register.)
            self.fb.emit(AirInst(
                opcode: OP_FUNC_ADDR,
                type_id: 4 as u32,
                dest: faddr,
                src1: sym_idx,
                src2: 0 as u32,
            ))
            return faddr
        if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
            return 0 as u32
        // RFC 0017 / BUG#82: a module-level global reads from its static storage
        // (OP_GLOBAL_ADDR + OP_LOAD), not a per-function vreg.
        if sym.kind == SYM_VAR and self.mb.builder_global_index(sym_idx) != -1 as i64:
            return self.lower_global_read(sym_idx, sym.type_id)
        let reg = self.locals.local_map_get(sym_idx)
        return reg

    return 0 as u32

// RFC 0017 / BUG#82: read a module-level global's value from static storage. Composes
// OP_GLOBAL_ADDR (address via lea rip + reloc) with OP_LOAD (sized by the value type).
pub fn lower_global_read(mut self: ptr[FuncLowering], sym_idx: u32, type_id: u32) -> u32:
    let addr = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_GLOBAL_ADDR, type_id: 4 as u32, dest: addr, src1: sym_idx, src2: 0 as u32))
    let val = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_LOAD, type_id: type_id, dest: val, src1: addr, src2: 0 as u32))
    return val

// RFC 0017 / BUG#82: write `value_reg` into a module-level global's static storage.
// Composes OP_GLOBAL_ADDR with OP_STORE (src1 = address, src2 = value).
pub fn lower_global_write(mut self: ptr[FuncLowering], sym_idx: u32, type_id: u32, value_reg: u32):
    let addr = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_GLOBAL_ADDR, type_id: 4 as u32, dest: addr, src1: sym_idx, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_STORE, type_id: type_id, dest: addr, src1: value_reg, src2: 0 as u32))

// BUG#86 / RFC 0016 P3: lower a short-circuit `and`/`or`. The result is carried
// out of the diamond in one vreg (`sc_res`), written on each path:
//   AND: sc_res = lhs; if lhs -> eval rhs, sc_res = rhs; else keep lhs(=false)
//   OR : sc_res = lhs; if lhs keep lhs(=true); else -> eval rhs, sc_res = rhs
// This produces blocks *in the middle of expression evaluation*, out of physical
// control-flow order — correct only because compute_liveness is now CFG-aware
// (RFC 0016 P2'): sc_res's live interval covers the linear hull of the diamond.
pub fn lower_short_circuit(mut self: ptr[FuncLowering], lhs_idx: u32, rhs_idx: u32, is_and: bool, result_type: u32) -> u32:
    let sc_res = self.fb.fresh_reg()

    // LHS in the current block; seed sc_res with it (the value taken when we skip RHS).
    let lhs_reg = self.lower_expr(lhs_idx)
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: sc_res, src1: lhs_reg, src2: 0 as u32))

    let rhs_block = self.fb.new_block()
    let merge_block = self.fb.new_block()
    let entry_block = self.fb.current_block()

    // OP_BRANCH: dest = false-target, src1 = cond, src2 = true-target.
    if is_and:
        // lhs true -> evaluate rhs; lhs false -> merge with sc_res already = false.
        self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: merge_block, src1: lhs_reg, src2: rhs_block))
    else:
        // lhs true -> merge with sc_res already = true; lhs false -> evaluate rhs.
        self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: rhs_block, src1: lhs_reg, src2: merge_block))
    self.fb.add_edge(entry_block, rhs_block)
    self.fb.add_edge(entry_block, merge_block)

    // RHS block: evaluate rhs, overwrite sc_res, fall to merge.
    self.fb.switch_to(rhs_block)
    self.terminated = false
    let rhs_reg = self.lower_expr(rhs_idx)
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: sc_res, src1: rhs_reg, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
    self.fb.add_edge(self.fb.current_block(), merge_block)

    // Merge: sc_res holds the short-circuit result.
    self.fb.switch_to(merge_block)
    self.terminated = false
    return sc_res

pub fn lower_binary_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    // RFC 0006 (#38.3): `**` exponentiation. Handled before the generic binary
    // path because the exponent controls evaluation: a constant non-negative
    // exponent is unrolled to a chain of multiplies, otherwise a runtime loop is
    // synthesized. (Previously `**` mapped to OP_NOP -> garbage result.)
    let op_peek = self.mb.get_token_text(node.token_idx)
    let is_pow = op_peek == "**"
    @free(get_str_ptr(op_peek))
    if is_pow:
        return self.lower_power(idx, node, child)

    // BUG#86 / RFC 0016 P3: short-circuit logical `and`/`&&`/`or`/`||` (NOT the
    // bitwise `&`/`|`, which map to the same OP_AND/OP_OR but must stay eager).
    // Spec (p09-t06, p08-t04) mandates: `a and b` evaluates b only if a is true;
    // `a or b` evaluates b only if a is false. Distinguished purely by token text
    // (opcode alone can't tell `and` from `&`). Safe to enable now that liveness
    // is CFG-aware (P2') — the diamond-carried result vreg is allocated correctly.
    let sc_tok = self.mb.get_token_text(node.token_idx)
    let sc_is_and = sc_tok == "and" or sc_tok == "&&"
    let sc_is_or = sc_tok == "or" or sc_tok == "||"
    @free(get_str_ptr(sc_tok))
    if sc_is_and or sc_is_or:
        let sc_rhs = self.mb.tree.nodes.data[child as i64].next_sibling
        if sc_rhs != 0 as u32:
            mut sc_rtype := 4 as u32   // bool
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                sc_rtype = self.mb.node_types[idx as i64]
            return self.lower_short_circuit(child, sc_rhs, sc_is_and, sc_rtype)

    // RFC 0007: operator overloading. When the lhs operand is a user type
    // (struct/sum/generic-inst), `a <op> b` lowers to the conventional method
    // call `a.<name>(b)` (+ -> add, == -> eq, < -> lt, ...). Builtin numeric
    // operands skip this entirely and keep their native codegen (fixpoint-safe,
    // since the compiler never applies operators to user types).
    if self.mb.node_types != null as ptr[u32]:
        let lhs_t = self.mb.node_types[child as i64]
        if lhs_t != 0 as u32 and (lhs_t as i64) < self.mb.typetable.entries.len:
            let le = self.mb.typetable.entries.data[lhs_t as i64]
            if le.kind == TYPE_KIND_STRUCT or le.kind == TYPE_KIND_SUM or le.kind == TYPE_KIND_GENERIC_INST:
                let op_tok = self.mb.get_token_text(node.token_idx)
                let mname = op_to_method_name(op_tok)
                let is_ne = op_tok == "!="
                @free(get_str_ptr(op_tok))
                if not (mname == ""):
                    let rhs_node_idx = self.mb.tree.nodes.data[child as i64].next_sibling
                    mut rhs_t := 0 as u32
                    if rhs_node_idx != 0 as u32:
                        rhs_t = self.mb.node_types[rhs_node_idx as i64]
                    let msym = self.resolve_op_method(mname, lhs_t, rhs_t)
                    if msym != 0 as u32:
                        return self.lower_op_overload(idx, node, child, msym, is_ne)

    // BUG#88: `str + str` -> std.string.concat(a, b). The `str` primitive is not a
    // STRUCT/SUM/GENERIC_INST, so the RFC 0007 operator-overload path above skips it,
    // and `+` fell through to OP_IADD on the two 16-byte str values -> garbage/crash
    // with NO diagnostic. AXIOM intends `+` to concatenate strings (std/os.ax uses
    // `s + "." + ext`). Lower it to the library `concat` call, reusing the overload
    // call-emission path (resolve the concat symbol by name + (str,str) params).
    if self.mb.node_types != null as ptr[u32]:
        let sc_lt = self.mb.node_types[child as i64]
        let sc_rhs_i = self.mb.tree.nodes.data[child as i64].next_sibling
        if sc_lt == TYPE_STRING and sc_rhs_i != 0 as u32 and self.mb.node_types[sc_rhs_i as i64] == TYPE_STRING:
            let sc_op = self.mb.get_token_text(node.token_idx)
            let sc_is_plus = sc_op == "+"
            @free(get_str_ptr(sc_op))
            if sc_is_plus:
                let csym = self.resolve_op_method("concat", TYPE_STRING, TYPE_STRING)
                if csym != 0 as u32:
                    return self.lower_op_overload(idx, node, child, csym, false)

    let lhs_reg = self.lower_expr(child)

    let rhs_idx = self.mb.tree.nodes.data[child as i64].next_sibling
    if rhs_idx == 0 as u32:
        return lhs_reg

    let rhs_reg = self.lower_expr(rhs_idx)

    let op_token = self.mb.get_token_text(node.token_idx)
    mut opcode := map_binary_op(op_token)
    @free(get_str_ptr(op_token))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    // RFC 0006 (BUG#33): float arithmetic. When the RESULT type is float, the
    // operator selects the float opcode (OP_FADD/FSUB/FMUL/FDIV) instead of the
    // integer one, and any integer operand is promoted to float with a real
    // OP_ITOF (cvtsi2sd) — NOT a copy-reinterpret. f64 fully supported here;
    // f32 reuses the sd path for now (precise single-precision is a follow-up
    // needing the ss encoder family). Comparison ops keep result type bool, so
    // they never enter this branch (float compare is a separate follow-up).
    mut op_l := lhs_reg
    mut op_r := rhs_reg
    if type_id == 9 as u32 or type_id == 10 as u32:
        if opcode == OP_IADD:
            opcode = OP_FADD
        elif opcode == OP_ISUB:
            opcode = OP_FSUB
        elif opcode == OP_IMUL:
            opcode = OP_FMUL
        elif opcode == OP_IDIV:
            opcode = OP_FDIV
        if opcode == OP_FADD or opcode == OP_FSUB or opcode == OP_FMUL or opcode == OP_FDIV:
            if self.mb.node_types != null as ptr[u32]:
                let lt = self.mb.node_types[child as i64]
                let rt = self.mb.node_types[rhs_idx as i64]
                if lt != 9 as u32 and lt != 10 as u32:
                    let lconv = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: lconv, src1: lhs_reg, src2: 0 as u32))
                    op_l = lconv
                if rt != 9 as u32 and rt != 10 as u32:
                    let rconv = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: rconv, src1: rhs_reg, src2: 0 as u32))
                    op_r = rconv

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: op_l,
        src2: op_r,
    ))
    return reg

// RFC 0007: map a binary operator's token text to its conventional method name
// (Rust core::ops style). Returns "" for operators that are not overloadable.
// `!=` maps to `eq` (the caller negates the bool result).
fn op_to_method_name(op: str) -> str:
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "/":
        return "div"
    if op == "%":
        return "rem"
    if op == "==" or op == "!=":
        return "eq"
    if op == "<":
        return "lt"
    if op == "<=":
        return "le"
    if op == ">":
        return "gt"
    if op == ">=":
        return "ge"
    return ""

// RFC 0007: unwrap ptr/ref layers off a type id (helper for method matching).
fn op_unwrap_type(self: ptr[FuncLowering], t: u32) -> u32:
    mut u := t
    mut e := self.mb.typetable.entries.data[u as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        u = e.extra as u32
        e = self.mb.typetable.entries.data[u as i64]
    return u

// RFC 0007: resolve a struct/sum operator method by conventional name on a
// receiver type. Mirrors the non-generic method resolution in lower_call_expr:
// scan SYM_FUNC symbols whose (mangled) name matches `method_name`, whose first
// parameter (self, unwrapped) equals the receiver type AND — when `rhs_type` is
// known (non-zero) — whose second parameter (unwrapped) equals it. The rhs match
// supports mixed-type overloads (`add(self, o: u32)`) and, crucially, avoids
// silently calling `add(self, o: BigInt)` with a wrong-typed rhs. Returns 0 when
// no method matches (the operand types have no defined operator).
pub fn resolve_op_method(self: ptr[FuncLowering], method_name: str, rec_type: u32, rhs_type: u32) -> u32:
    let method_id = self.mb.pool.intern(method_name)
    let unwrapped = self.op_unwrap_type(rec_type)
    mut rhs_unwrapped := 0 as u32
    if rhs_type != 0 as u32:
        rhs_unwrapped = self.op_unwrap_type(rhs_type)
    mut i := 0 as i64
    while i < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
            let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len > 0 as i64:
                    let fp = self.op_unwrap_type(fi.params.data[0] as u32)
                    if fp == unwrapped:
                        // Constrain the rhs (2nd param) only when its type is
                        // known; binary operators always have a 2nd param.
                        mut rhs_ok := true
                        if rhs_unwrapped != 0 as u32:
                            rhs_ok = false
                            if fi.params.len > 1 as i64:
                                let sp = self.op_unwrap_type(fi.params.data[1] as u32)
                                if sp == rhs_unwrapped:
                                    rhs_ok = true
                        if rhs_ok:
                            return i as u32
        i = i + 1 as i64
    return 0 as u32

// RFC 0007: lower an overloaded operator `a <op> b` to the method call
// `a.<method>(b)` (method symbol `msym` already resolved). Mirrors the
// method-call emission in lower_call_expr: a 2-element arg block [self, rhs] and
// an OP_CALL whose type_id carries the method symbol (src1=0). `!=` reuses the
// `eq` method and negates the bool result with OP_NOT.
pub fn lower_op_overload(mut self: ptr[FuncLowering], idx: u32, node: AstNode, base_idx: u32, msym: u32, is_ne: bool) -> u32:
    let rhs_idx = self.mb.tree.nodes.data[base_idx as i64].next_sibling
    let lhs_reg = self.lower_expr(base_idx)
    mut rhs_reg := 0 as u32
    if rhs_idx != 0 as u32:
        rhs_reg = self.lower_expr(rhs_idx)

    let arg_start = self.fb.emit_extra(2 as u32)
    self.fb.emit_extra(lhs_reg)
    self.fb.emit_extra(rhs_reg)

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_CALL,
        type_id: msym,
        dest: reg,
        src1: 0 as u32,
        src2: arg_start,
    ))

    if is_ne:
        let neg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_NOT, type_id: 11 as u32, dest: neg, src1: reg, src2: 0 as u32))
        return neg
    return reg

// RFC 0006 (#38.3): emit the multiplicative identity (1) for the power base type.
// Integer -> OP_ICONST 1; float -> OP_FCONST with the IEEE bit pattern of 1.0
// (single- or double-precision per type_id), mirroring lower_float_lit.
fn emit_one(mut self: ptr[FuncLowering], type_id: u32, is_float: bool) -> u32:
    let reg = self.fb.fresh_reg()
    if is_float:
        mut fone := 1.0 as f64
        mut bits := (&fone as ptr[u64])[0]
        if type_id == 9 as u32:
            mut f1 := fone as f32
            bits = ((&f1 as ptr[u32])[0]) as u64
        self.fb.emit(AirInst(opcode: OP_FCONST, type_id: type_id, dest: reg, src1: (bits & (0xFFFFFFFF as u64)) as u32, src2: (bits >> (32 as u64)) as u32))
    else:
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: type_id, dest: reg, src1: 1 as u32, src2: 0 as u32))
    return reg

// RFC 0006 (#38.3): lower `base ** exp`. Result type drives int (OP_IMUL) vs
// float (OP_FMUL); an integer base is promoted with a real OP_ITOF when the
// result is float. A constant non-negative exponent <= 64 is unrolled into a
// chain of multiplies; any other exponent (variable, or out of the unroll
// bound) emits a count-down runtime loop. Negative/fractional exponents are not
// supported (integer -> 0 path, float fractional unsupported) — rare and
// flagged as a known limitation, not silently miscompiled into garbage.
pub fn lower_power(mut self: ptr[FuncLowering], idx: u32, node: AstNode, base_idx: u32) -> u32:
    let exp_idx = self.mb.tree.nodes.data[base_idx as i64].next_sibling
    if exp_idx == 0 as u32:
        return self.lower_expr(base_idx)

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    let is_float = type_id == 9 as u32 or type_id == 10 as u32

    // Base evaluated exactly once (no double side effects).
    mut base_reg := self.lower_expr(base_idx)
    if is_float and self.mb.node_types != null as ptr[u32]:
        let bt = self.mb.node_types[base_idx as i64]
        if bt != 9 as u32 and bt != 10 as u32:
            let bc = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: bc, src1: base_reg, src2: 0 as u32))
            base_reg = bc

    mut mul_op := OP_IMUL
    if is_float:
        mul_op = OP_FMUL

    // Constant exponent -> unroll.
    let exp_node = self.mb.tree.nodes.data[exp_idx as i64]
    if exp_node.kind == NODE_INT_LIT:
        let etext = self.mb.get_token_text(exp_node.token_idx)
        let n = parse_int_from_str(etext)
        @free(get_str_ptr(etext))
        if n >= 0 as i64 and n <= 64 as i64:
            if n == 0 as i64:
                return self.emit_one(type_id, is_float)
            if n == 1 as i64:
                let cp = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_COPY, type_id: type_id, dest: cp, src1: base_reg, src2: 0 as u32))
                return cp
            mut acc := self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: acc, src1: base_reg, src2: base_reg))
            mut k := 2 as i64
            while k < n:
                let nx = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: nx, src1: acc, src2: base_reg))
                acc = nx
                k = k + 1 as i64
            return acc

    // Variable exponent -> count-down loop. acc and cnt are loop-carried via
    // OP_COPY into fixed vregs, exactly how the front-end lowers user `mut`
    // locals across blocks (register-machine IR, no phi).
    let exp_reg = self.lower_expr(exp_idx)
    let acc = self.emit_one(type_id, is_float)
    let cnt = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: 3 as u32, dest: cnt, src1: exp_reg, src2: 0 as u32))

    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()
    let entry_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(entry_block, cond_block)

    self.fb.switch_to(cond_block)
    let zero = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 3 as u32, dest: zero, src1: 0 as u32, src2: 0 as u32))
    let test = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_GT, type_id: 11 as u32, dest: test, src1: cnt, src2: zero))
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: exit_block, src1: test, src2: body_block))
    self.fb.add_edge(cond_block, body_block)
    self.fb.add_edge(cond_block, exit_block)

    self.fb.switch_to(body_block)
    let nacc = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: nacc, src1: acc, src2: base_reg))
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: type_id, dest: acc, src1: nacc, src2: 0 as u32))
    let one_c = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 3 as u32, dest: one_c, src1: 1 as u32, src2: 0 as u32))
    let ncnt = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ISUB, type_id: 3 as u32, dest: ncnt, src1: cnt, src2: one_c))
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: 3 as u32, dest: cnt, src1: ncnt, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(body_block, cond_block)

    self.fb.switch_to(exit_block)
    self.terminated = false
    return acc

pub fn lower_unary_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    // BUG#84: `&a[i]` on a SCALAR element. lower_expr(child) below would LOAD the
    // element value (OP_INDEX), and OP_MAKE_REF then takes the address of that
    // TEMPORARY -- so the returned pointer aliases a stack temp, not the array slot
    // (writes are lost; reads past index 0 hit zeroed stack). Emit OP_INDEX_ADDR
    // (base + i*elem_size, no load) directly and return it, bypassing OP_MAKE_REF.
    // Aggregate `&agg[i]` is left on the existing OP_INDEX (which already yields the
    // element address for aggregates) + OP_MAKE_REF pass-through path, so the
    // compiler's own `&self.data[i]` self-codegen is unchanged.
    let child_node = self.mb.tree.nodes.data[child as i64]
    let op_tok0 = self.mb.get_token_text(node.token_idx)
    let is_ref_op = op_tok0 == "&"
    @free(get_str_ptr(op_tok0))
    if is_ref_op and child_node.kind == NODE_INDEX_EXPR:
        mut elem_ty := 0 as u32
        if self.mb.node_types != null as ptr[u32] and self.mb.node_types[child as i64] != 0 as u32:
            elem_ty = self.mb.node_types[child as i64] as u32
        if elem_ty != 0 as u32 and not type_is_aggregate(self.mb.typetable, elem_ty):
            let arr_child = child_node.first_child
            let arr_reg2 = self.lower_expr(arr_child)
            let idx_child = self.mb.tree.nodes.data[arr_child as i64].next_sibling
            mut idx_reg2 := 0 as u32
            if idx_child != 0 as u32:
                idx_reg2 = self.lower_expr(idx_child)
            mut ref_ty := elem_ty
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                ref_ty = self.mb.node_types[idx as i64] as u32
            let areg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_INDEX_ADDR,
                type_id: ref_ty,
                dest: areg,
                src1: arr_reg2,
                src2: idx_reg2,
            ))
            return areg

    // BUG#85: `&s.f` on a SCALAR field -- same defect as `&a[i]`. lower_expr(child)
    // (OP_GET_FIELD) LOADS the field value for scalars, so OP_MAKE_REF would take the
    // address of that temp. Emit OP_FIELD_ADDR (base + field_offset LEA, no load).
    // Only a genuine field LOAD (has an object child, not a qualified-variant/const
    // field-expr) with a scalar field type; aggregate `&s.aggfield` keeps the
    // OP_GET_FIELD (already returns the field address) + OP_MAKE_REF path.
    if is_ref_op and child_node.kind == NODE_FIELD_EXPR and child_node.first_child != 0 as u32 and (child_node.flags & 2048 as u16) == 0 as u16:
        mut fld_ty := 0 as u32
        if self.mb.node_types != null as ptr[u32] and self.mb.node_types[child as i64] != 0 as u32:
            fld_ty = self.mb.node_types[child as i64] as u32
        if fld_ty != 0 as u32 and not type_is_aggregate(self.mb.typetable, fld_ty):
            let obj_reg2 = self.lower_expr(child_node.first_child)
            mut ref_ty2 := fld_ty
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                ref_ty2 = self.mb.node_types[idx as i64] as u32
            let freg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_FIELD_ADDR,
                type_id: ref_ty2,
                dest: freg,
                src1: obj_reg2,
                src2: child_node.extra_idx,
            ))
            return freg

    let operand_reg = self.lower_expr(child)

    let op_token = self.mb.get_token_text(node.token_idx)
    mut opcode := OP_NOP
    if op_token == "-":
        opcode = OP_NEG
    elif op_token == "not" or op_token == "!":
        opcode = OP_NOT
    elif op_token == "~":
        opcode = OP_NOT
    elif op_token == "&":
        opcode = OP_MAKE_REF
    @free(get_str_ptr(op_token))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: operand_reg,
        src2: 0 as u32,
    ))
    return reg

fn air_starts_with(s: str, prefix: str) -> bool:
    let s_len = std.string.len(s)
    let p_len = std.string.len(prefix)
    if s_len < p_len:
        return false
    let s_ptr = get_str_ptr(s)
    let p_ptr = get_str_ptr(prefix)
    mut i := 0 as i64
    while i < p_len:
        if s_ptr[i] != p_ptr[i]:
            return false
        i = i + 1 as i64
    return true

fn match_base_names(base1: str, base2: str) -> bool:
    if base1 == base2:
        return true
    let len1 = std.string.len(base1)
    let len2 = std.string.len(base2)
    if len1 == 0 as i64 or len2 == 0 as i64:
        return false
        
    let ptr1 = get_str_ptr(base1)
    let ptr2 = get_str_ptr(base2)
    
    mut dot1 := -1 as i64
    mut i1 := len1 - 1 as i64
    while i1 >= 0 as i64:
        if ptr1[i1] == '.' as u8:
            dot1 = i1
            break
        i1 = i1 - 1
        
    mut dot2 := -1 as i64
    mut i2 := len2 - 1 as i64
    while i2 >= 0 as i64:
        if ptr2[i2] == '.' as u8:
            dot2 = i2
            break
        i2 = i2 - 1
        
    mut start1 := 0 as i64
    if dot1 != -1 as i64:
        start1 = dot1 + 1 as i64
        
    mut start2 := 0 as i64
    if dot2 != -1 as i64:
        start2 = dot2 + 1 as i64
    
    let sub_len1 = len1 - start1
    let sub_len2 = len2 - start2
    
    if sub_len1 != sub_len2:
        return false
        
    mut k := 0 as i64
    while k < sub_len1:
        if ptr1[start1 + k] != ptr2[start2 + k]:
            return false
        k = k + 1
        
    return true

fn match_mangled_method_raw_bytes(pool: ptr[InternPool], sym_id: u32, method_id: u32) -> bool:
    if sym_id == method_id:
        return true
    if sym_id == 0 as u32 or method_id == 0 as u32:
        return false
        
    let sym_entry = pool.ids[sym_id as i64 - 1]
    let method_entry = pool.ids[method_id as i64 - 1]
    
    let sym_bytes = (pool.arena as i64 + sym_entry.start as i64) as ptr[u8]
    let method_bytes = (pool.arena as i64 + method_entry.start as i64) as ptr[u8]
    
    let sym_len = sym_entry.len as i64
    let method_len = method_entry.len as i64
    
    if sym_len < method_len:
        return false
        
    mut i := 0 as i64
    while i <= sym_len - method_len:
        mut matches := true
        mut j := 0 as i64
        while j < method_len:
            if sym_bytes[i + j] != method_bytes[j]:
                matches = false
                break
            j = j + 1 as i64
            
        if matches:
            mut post_ok := false
            if i + method_len == sym_len:
                post_ok = true
            elif i + method_len + 2 <= sym_len:
                if sym_bytes[i + method_len] == 95 as u8 and sym_bytes[i + method_len + 1] == 95 as u8:
                    post_ok = true
                    
            if post_ok:
                mut pre_ok := false
                if i == 0:
                    pre_ok = true
                else:
                    let prev_char = sym_bytes[i - 1]
                    if prev_char == 46 as u8 or prev_char == 95 as u8: // '.' or '_'
                        pre_ok = true
                        
                if pre_ok:
                    return true
                    
        i = i + 1 as i64
        
    return false

fn match_mangled_method_name(sym_name: str, method_name: str) -> bool:
    if sym_name == method_name:
        return true
    let prefix = std.string.concat("_AX_std_", method_name)
    let full_prefix = std.string.concat(prefix, "__")
    let starts := air_starts_with(sym_name, full_prefix)
    @free(get_str_ptr(prefix))
    @free(get_str_ptr(full_prefix))
    return starts

pub fn lower_call_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let callee_node = self.mb.tree.nodes.data[child as i64]

    // BUG#90: intercept Option/Result methods (unwrap/is_some/is_none/is_ok/is_err) on
    // a receiver typed as Option/Result, and emit the SAME deterministic pointer-tagged
    // inline logic lower_match_tagged uses (Some/Ok=box non-null/even; payload=[box]).
    // std/result.ax reads the box via `(&self)[0]`, which crashes when self's param
    // home-slot doesn't hold the box pointer (e.g. an Option returned by a mono'd
    // generic method). This is off the stdlib ABI, same tactic RFC 0012 used for match.
    if callee_node.kind == NODE_FIELD_EXPR and self.mb.node_types != null as ptr[u32]:
        let orc_recv = callee_node.first_child
        if orc_recv != 0 as u32:
            let orc_rty = self.mb.node_types[orc_recv as i64]
            if self.opt_res_kind(orc_rty) >= 0 as i64:
                let mtok = self.mb.get_token_text(callee_node.token_idx)
                mut orc_handled := false
                mut orc_reg := 0 as u32
                if mtok == "unwrap":
                    let rr = self.lower_expr(orc_recv)
                    mut pl_type := 4 as u32
                    if self.mb.node_types[idx as i64] != 0 as u32:
                        pl_type = self.mb.node_types[idx as i64] as u32
                    orc_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_DEREF, type_id: pl_type, dest: orc_reg, src1: rr, src2: 0 as u32))
                    orc_handled = true
                elif mtok == "is_some" or mtok == "is_none":
                    let rr = self.lower_expr(orc_recv)
                    let zr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zr, src1: 0 as u32, src2: 0 as u32))
                    orc_reg = self.fb.fresh_reg()
                    mut opc := OP_NE
                    if mtok == "is_none":
                        opc = OP_EQ
                    self.fb.emit(AirInst(opcode: opc, type_id: 11 as u32, dest: orc_reg, src1: rr, src2: zr))
                    orc_handled = true
                elif mtok == "is_ok" or mtok == "is_err":
                    let rr = self.lower_expr(orc_recv)
                    let onr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: onr, src1: 1 as u32, src2: 0 as u32))
                    let bitr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: bitr, src1: rr, src2: onr))
                    let zr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zr, src1: 0 as u32, src2: 0 as u32))
                    orc_reg = self.fb.fresh_reg()
                    mut opc := OP_EQ
                    if mtok == "is_err":
                        opc = OP_NE
                    self.fb.emit(AirInst(opcode: opc, type_id: 11 as u32, dest: orc_reg, src1: bitr, src2: zr))
                    orc_handled = true
                safe_free_str(mtok)
                if orc_handled:
                    return orc_reg

    if callee_node.kind == NODE_FIELD_EXPR:
        let field_name_id = callee_node.payload
        let field_name = self.mb.pool.get(field_name_id)
        if field_name == "new":
            mut is_collection_new := false
            let rec_node = callee_node.first_child
            if rec_node != 0 as u32:
                mut ret_type := 0 as u32
                if self.mb.node_types != null as ptr[u32]:
                    ret_type = self.mb.node_types[idx as i64]
                if ret_type != 0 as u32 and (ret_type as i64) < self.mb.typetable.entries.len:
                    let entry = self.mb.typetable.entries.data[ret_type as i64]
                    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                        is_collection_new = true
            
            if is_collection_new:
                mut ret_type := 0 as u32
                if self.mb.node_types != null as ptr[u32]:
                    ret_type = self.mb.node_types[idx as i64]
                return self.lower_struct_constructor_call(idx, node, ret_type)
    
    if callee_node.kind == NODE_IDENT:
        let sym_idx = callee_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let name_id = self.mb.symbols.symbols.data[sym_idx as i64].name_id
            let name = self.mb.pool.get(name_id)
            if name == "compiler_intrinsic":
                let arg_idx = callee_node.next_sibling
                if arg_idx != 0 as u32:
                    let arg_node = self.mb.tree.nodes.data[arg_idx as i64]
                    if arg_node.kind == NODE_STRING_LIT:
                        let arg_text = self.mb.get_token_text(arg_node.token_idx)
                        mut lower_to_const := false
                        mut const_type := 0 as u32
                        mut const_val := 0 as u32
                        
                        if arg_text == "\"is_windows\"" or arg_text == "'is_windows'" or arg_text == "is_windows":
                            lower_to_const = true
                            const_type = 11 as u32
                            const_val = 1 as u32
                        elif arg_text == "\"is_linux\"" or arg_text == "'is_linux'" or arg_text == "is_linux":
                            lower_to_const = true
                            const_type = 11 as u32
                            const_val = 0 as u32
                        elif arg_text == "\"is_macos\"" or arg_text == "'is_macos'" or arg_text == "is_macos":
                            lower_to_const = true
                            const_type = 11 as u32
                            const_val = 0 as u32
                        elif arg_text == "\"os_name\"" or arg_text == "'os_name'" or arg_text == "os_name":
                            lower_to_const = true
                            const_type = 12 as u32
                            const_val = self.mb.pool.intern("\"windows\"")
                        elif arg_text == "\"arch_name\"" or arg_text == "'arch_name'" or arg_text == "arch_name":
                            lower_to_const = true
                            const_type = 12 as u32
                            const_val = self.mb.pool.intern("\"x86_64\"")
                        elif arg_text == "\"path_separator\"" or arg_text == "'path_separator'" or arg_text == "path_separator":
                            lower_to_const = true
                            const_type = 12 as u32
                            const_val = self.mb.pool.intern("\"\\\\\"")
                        
                        if lower_to_const:
                            @free(get_str_ptr(arg_text))
                            let reg = self.fb.fresh_reg()
                            self.fb.emit(AirInst(
                                opcode: OP_ICONST,
                                type_id: const_type,
                                dest: reg,
                                src1: const_val,
                                src2: 0 as u32,
                            ))
                            return reg
                        @free(get_str_ptr(arg_text))
    
    // Check if callee is a constant — if so, inline the value rather than calling
    if callee_node.kind == NODE_IDENT:
        let const_sym_idx = callee_node.payload
        if const_sym_idx != 0 as u32 and (const_sym_idx as i64) < self.mb.symbols.symbols.len:
            let const_sym = self.mb.symbols.symbols.data[const_sym_idx as i64]
            if const_sym.kind == SYM_CONST:
                // Inline the constant value by lowering its initializer expression
                mut init_expr := 0 as u32
                mut const_child := self.mb.tree.nodes.data[const_sym.decl_node as i64].first_child
                while const_child != 0 as u32:
                    let const_child_node = self.mb.tree.nodes.data[const_child as i64]
                    if const_child_node.kind != NODE_TYPE_EXPR and const_child_node.kind != NODE_GENERIC_TYPE:
                        init_expr = const_child
                    const_child = const_child_node.next_sibling
                if init_expr != 0 as u32:
                    return self.lower_expr(init_expr)
                // Const with no initializer — return 0
                let zero_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 3 as u32,
                    dest: zero_reg,
                    src1: 0 as u32,
                    src2: 0 as u32,
                ))
                return zero_reg
    
    // Check if callee is a method call on a struct
    mut is_method_call := false
    mut method_sym_idx := 0 as u32
    mut receiver_node_idx := 0 as u32
    if callee_node.kind == NODE_FIELD_EXPR:
        receiver_node_idx = callee_node.first_child
        
        if (callee_node.flags & 2048 as u16) != 0 as u16:
            let spec_sym_idx = callee_node.payload
            mut is_real_method := false
            mut rec_type := 0 as u32
            if receiver_node_idx != 0 as u32:
                let receiver_node = self.mb.tree.nodes.data[receiver_node_idx as i64]
                mut is_module_rec := false
                mut rec_sym_idx := 0 as u32
                if receiver_node.kind == NODE_IDENT:
                    rec_sym_idx = receiver_node.payload
                elif receiver_node.kind == NODE_FIELD_EXPR:
                    if (receiver_node.flags & 2048 as u16) != 0 as u16:
                        rec_sym_idx = receiver_node.payload
                if rec_sym_idx != 0 as u32 and (rec_sym_idx as i64) < self.mb.symbols.symbols.len:
                    let rec_sym = self.mb.symbols.symbols.data[rec_sym_idx as i64]
                    if rec_sym.kind == SYM_MODULE:
                        is_module_rec = true
                if not is_module_rec:
                    if self.mb.node_types != null as ptr[u32]:
                        rec_type = self.mb.node_types[receiver_node_idx as i64]
                        if rec_type == 0 as u32:
                            is_real_method = true
                        elif (rec_type as i64) < self.mb.typetable.entries.len:
                            mut entry = self.mb.typetable.entries.data[rec_type as i64]
                            while (entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF) and (rec_type as i64) < self.mb.typetable.entries.len:
                                rec_type = entry.extra
                                if (rec_type as i64) < self.mb.typetable.entries.len:
                                    entry = self.mb.typetable.entries.data[rec_type as i64]
                            if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                                is_real_method = true
            
            if is_real_method:
                if spec_sym_idx != 0 as u32 and (spec_sym_idx as i64) < self.mb.symbols.symbols.len:
                    let sym = self.mb.symbols.symbols.data[spec_sym_idx as i64]
                    if sym.kind == SYM_FUNC:
                        let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
                        if t_entry.kind == TYPE_KIND_FUNC:
                            let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                            if fi.params.len > 0 as i64:
                                is_method_call = true
                                method_sym_idx = spec_sym_idx
        if not is_method_call:
            mut resolved := false

            if not resolved:
                receiver_node_idx = callee_node.first_child
                if receiver_node_idx != 0 as u32 and self.mb.node_types != null as ptr[u32]:
                    mut rec_type := self.mb.node_types[receiver_node_idx as i64]
                    if rec_type != 0 as u32 and (rec_type as i64) < self.mb.typetable.entries.len:
                        mut entry = self.mb.typetable.entries.data[rec_type as i64]
                        while (entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF) and (rec_type as i64) < self.mb.typetable.entries.len:
                            rec_type = entry.extra
                            if (rec_type as i64) < self.mb.typetable.entries.len:
                                entry = self.mb.typetable.entries.data[rec_type as i64]
                        
                        if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                            let m_name_tok = self.mb.get_token_text(callee_node.token_idx)
                            let method_id = self.mb.pool.intern(m_name_tok)
                            safe_free_str(m_name_tok)
                            mut i := 0 as i64
                            while i < self.mb.symbols.symbols.len:
                                let sym = self.mb.symbols.symbols.data[i]
                                if sym.kind == SYM_FUNC:
                                    if match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
                                        let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
                                        if t_entry.kind == TYPE_KIND_FUNC:
                                            let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                                            if fi.params.len > 0 as i64:
                                                mut first_param := fi.params.data[0]
                                                mut p_entry = self.mb.typetable.entries.data[first_param as i64]
                                                while p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
                                                    first_param = p_entry.extra
                                                    p_entry = self.mb.typetable.entries.data[first_param as i64]
                                                
                                                mut matches_type := false
                                                if first_param == rec_type:
                                                    matches_type = true
                                                if matches_type:
                                                    method_sym_idx = i as u32
                                                    resolved = true
                                                    is_method_call = true
                                                    break
                                i = i + 1 as i64

    // Variant constructors (Ok/Err/Some/None) use the pointer-layout sum
    // representation, matching the C backend macros ax_Result_ok/ax_Result_err:
    // payload is boxed on the heap; Err sets tag bit 0; None is the null pointer.
    // std/result.ax reads this layout when ax_sum_layout_is_pointer() is true.
    // Detection is by token text: the variant symbol may come from an imported
    // module whose intern pool differs from this module's, so the symbol's
    // name_id cannot be compared against self.mb.pool here.
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let v_name = self.mb.get_token_text(callee_node.token_idx)
        mut variant_ctor := 0 as i64
        if v_name == "Ok":
            variant_ctor = 1
        elif v_name == "Err":
            variant_ctor = 2
        elif v_name == "Some":
            variant_ctor = 3
        elif v_name == "None":
            variant_ctor = 4
        @free(get_str_ptr(v_name))
        if variant_ctor != 0:
            if variant_ctor == 4:
                // None = null pointer (a plain 8-byte i64 zero).
                let none_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 4 as u32,
                    dest: none_reg,
                    src1: 0 as u32,
                    src2: 0 as u32,
                ))
                return none_reg
            mut payload_reg := 0 as u32
            mut payload_t := 0 as u32
            let payload_idx = callee_node.next_sibling
            if payload_idx != 0 as u32:
                payload_reg = self.lower_expr(payload_idx)
                if self.mb.node_types != null as ptr[u32]:
                    payload_t = self.mb.node_types[payload_idx as i64]
            // RFC 0012: type the box register with a real Option/Result type
            // (kind 11/12), computed LOCALLY from the payload type — NOT `str` (12).
            // The kind-11/12 entry is size-16 (so OP_ALLOC still reserves room for a
            // str payload) but AGGREGATE, so — exactly like a user sum (kind 6) — the
            // value is an 8-byte box pointer that copies/passes as a pointer. Because
            // the register type is no longer str(12), EQ/COPY/MAKE_REF stop taking the
            // string-by-address deref path, which is what lets `match` (lower_match_
            // tagged) dispatch on the box pointer. Done here (not via typecheck) to
            // keep the change off the stdlib's generic Option/Result ABI.
            mut box_ty := 12 as u32
            if variant_ctor == 3:
                box_ty = self.mb.typetable.register_option(payload_t)
            elif variant_ctor == 1:
                box_ty = self.mb.typetable.register_result(payload_t, 0 as u32)
            elif variant_ctor == 2:
                box_ty = self.mb.typetable.register_result(0 as u32, payload_t)
            let box_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_ALLOC,
                type_id: box_ty,
                dest: box_reg,
                src1: 0 as u32,
                src2: 0 as u32,
            ))
            if payload_reg != 0 as u32:
                // str payloads copy all 16 bytes; everything else stores
                // the 8-byte value (scalars and struct heap pointers).
                mut store_t := 4 as u32
                if payload_t == 12 as u32:
                    store_t = 12 as u32
                self.fb.emit(AirInst(
                    opcode: OP_STORE,
                    type_id: store_t,
                    dest: box_reg,
                    src1: payload_reg,
                    src2: 0 as u32,
                ))
            if variant_ctor == 2:
                let one_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 4 as u32,
                    dest: one_reg,
                    src1: 1 as u32,
                    src2: 0 as u32,
                ))
                let tagged_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_OR,
                    type_id: box_ty,
                    dest: tagged_reg,
                    src1: box_reg,
                    src2: one_reg,
                ))
                return tagged_reg
            return box_reg

    // RFC 0004: a non-builtin user sum variant with a payload, e.g. `Circle(r)`.
    // Reached only when the Ok/Err/Some/None name match above did NOT apply, so
    // Option/Result keep their pointer layout while user sums get the tag-in-box
    // layout. Guarded on TYPE_KIND_SUM so only kind-6 sums take this path.
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let vcsym_idx = callee_node.payload
        if vcsym_idx != 0 as u32 and (vcsym_idx as i64) < self.mb.symbols.symbols.len:
            let vcsym = self.mb.symbols.symbols.data[vcsym_idx as i64]
            if vcsym.kind == SYM_VARIANT and vcsym.type_id != 0 as u32 and (vcsym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[vcsym.type_id as i64].kind == TYPE_KIND_SUM:
                    let payload_arg = callee_node.next_sibling
                    return self.lower_variant_construct(vcsym_idx, payload_arg)

    // RFC 0004: qualified payload-variant construction `EnumType.Ctor(x)`. The
    // callee is a NODE_FIELD_EXPR that typecheck bound to the variant symbol
    // (flag 2048); build the same tag-in-box value the bare `Ctor(x)` path above
    // does, with the call's first argument as the payload. Without this the
    // callee lowered as an OP_GET_FIELD on the type name and crashed.
    if not is_method_call and callee_node.kind == NODE_FIELD_EXPR and (callee_node.flags & 2048 as u16) != 0 as u16:
        let fvsym_idx = callee_node.payload
        if fvsym_idx != 0 as u32 and (fvsym_idx as i64) < self.mb.symbols.symbols.len:
            let fvsym = self.mb.symbols.symbols.data[fvsym_idx as i64]
            if fvsym.kind == SYM_VARIANT and fvsym.type_id != 0 as u32 and (fvsym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[fvsym.type_id as i64].kind == TYPE_KIND_SUM:
                    let fpayload_arg = callee_node.next_sibling
                    return self.lower_variant_construct(fvsym_idx, fpayload_arg)

    mut is_struct_constructor := false
    mut struct_type_id := 0 as u32

    if not is_method_call:
        if callee_node.kind == NODE_IDENT:
            let sym_idx = callee_node.payload
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
                let sym = self.mb.symbols.symbols.data[sym_idx as i64]
                if sym.kind == SYM_STRUCT:
                    is_struct_constructor = true
                    struct_type_id = sym.type_id
                    // BUG#74: for a generic struct constructed with no explicit
                    // type args (`Pair(first: v, ...)`), typecheck records the
                    // concrete MONOMORPHIZED struct type on the call node itself
                    // (node_types[idx]); prefer it over the bare template
                    // (sym.type_id) so the value is built with the SAME packed
                    // field layout the receiving generic function reads it back
                    // through. Without this the value used the template's generic
                    // 8-byte field slots (second field always at offset 8) while
                    // the callee read a packed concrete struct -- every combo
                    // except a fully-8-byte-aligned one (e.g. Pair[i32,i32],
                    // packed second at offset 4) coincidentally matched. Guarded
                    // to STRUCT/GENERIC_INST and `ct != sym.type_id`, so a
                    // non-generic struct (node_types == template) is unchanged.
                    if self.mb.node_types != null as ptr[u32]:
                        let ct = self.mb.node_types[idx as i64]
                        if ct != 0 as u32 and ct != sym.type_id and (ct as i64) < self.mb.typetable.entries.len:
                            let ce = self.mb.typetable.entries.data[ct as i64]
                            if ce.kind == TYPE_KIND_STRUCT or ce.kind == TYPE_KIND_GENERIC_INST:
                                struct_type_id = ct
        elif callee_node.kind == NODE_INDEX_EXPR or callee_node.kind == NODE_GENERIC_TYPE:
            if self.mb.node_types != null as ptr[u32]:
                let t_id = self.mb.node_types[child as i64]
                if t_id != 0 as u32 and (t_id as i64) < self.mb.typetable.entries.len:
                    let entry = self.mb.typetable.entries.data[t_id as i64]
                    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                        is_struct_constructor = true
                        struct_type_id = t_id

    if is_struct_constructor:
        return self.lower_struct_constructor_call(idx, node, struct_type_id)

    let temp_args = @alloc(128 * 4) as ptr[u32]
    mut temp_count := 0 as u32

    if is_method_call:
        let receiver_reg = self.lower_expr(receiver_node_idx)
        temp_args[temp_count as i64] = receiver_reg
        temp_count = temp_count + 1 as u32

    mut arg := callee_node.next_sibling
    while arg != 0 as u32:
        let arg_reg = self.lower_expr(arg)
        temp_args[temp_count as i64] = arg_reg
        temp_count = temp_count + 1 as u32
        arg = self.mb.tree.nodes.data[arg as i64].next_sibling

    let arg_start = self.fb.emit_extra(temp_count)
    mut i := 0 as u32
    while i < temp_count:
        self.fb.emit_extra(temp_args[i as i64])
        i = i + 1 as u32

    @free(temp_args as ptr[u8])

    mut type_id := 0 as u32
    mut callee_reg := 0 as u32

    if is_method_call:
        type_id = method_sym_idx as u32
        callee_reg = 0 as u32
    else:
        if callee_node.kind == NODE_IDENT:
            let call_sym_idx = callee_node.payload
            mut is_var_or_param := false
            if call_sym_idx != 0 as u32 and (call_sym_idx as i64) < self.mb.symbols.symbols.len:
                let call_sym = self.mb.symbols.symbols.data[call_sym_idx as i64]
                if call_sym.kind == SYM_VAR or call_sym.kind == SYM_PARAM:
                    is_var_or_param = true
            if is_var_or_param:
                // SYM_VAR/SYM_PARAM — indirect call through function pointer variable
                callee_reg = self.lower_ident(callee_node)
                if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                    type_id = self.mb.node_types[idx as i64] as u32
            else:
                callee_reg = 0 as u32
                type_id = callee_node.payload as u32
        elif callee_node.kind == NODE_FIELD_EXPR and (callee_node.flags & 2048 as u16) != 0 as u16:
            callee_reg = 0 as u32
            type_id = callee_node.payload as u32
        elif (callee_node.kind == NODE_INDEX_EXPR or callee_node.kind == NODE_GENERIC_TYPE) and callee_node.payload != 0 as u32 and (callee_node.payload as i64) < self.mb.symbols.symbols.len and self.mb.symbols.symbols.data[callee_node.payload as i64].kind == SYM_FUNC:
            // BUG#62: explicit generic instantiation `f[T](args)` (e.g. hash_key[K](key)
            // in a mono'd HashMap method, or new[i32]()). Typecheck's NODE_INDEX_EXPR
            // path instantiates the template and stamps the node payload with the
            // instance FUNC symbol; without this branch the callee fell into
            // lower_expr(INDEX_EXPR) — an ARRAY INDEX of the template symbol — and
            // the backends emitted a phantom `ax_<template>` extern (link failure)
            // or an indirect call through garbage. Guarded on SYM_FUNC so struct
            // instantiations (SYM_STRUCT/SYM_TYPE_ALIAS payloads) and plain indexing
            // (payload 0) are untouched. Direct call, same convention as above.
            callee_reg = 0 as u32
            type_id = callee_node.payload as u32
        else:
            callee_reg = self.lower_expr(child)
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                type_id = self.mb.node_types[idx as i64] as u32
            else:
                if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
                    let sym = self.mb.symbols.symbols.data[node.payload as i64]
                    if sym.type_id != 0 as u32:
                        type_id = sym.type_id as u32

    mut opcode := OP_CALL
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let sym_idx = callee_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let name_id = self.mb.symbols.symbols.data[sym_idx as i64].name_id
            let name = self.mb.pool.get(name_id)
            if (name == "syscall0" or name == "syscall1" or name == "syscall2" or
                name == "syscall3" or name == "syscall4" or name == "syscall5" or
                name == "syscall6"):
                opcode = OP_SYSCALL

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: callee_reg,
        src2: arg_start,
    ))
    return reg

pub fn lower_field_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    if (node.flags & 2048 as u16) != 0 as u16:
        let sym_idx = node.payload
        if self.mb.symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[sym_idx as i64]
            // RFC 0011 P4 inc4a: a library-provided const has no AST initializer
            // (decl_node 0); its value was carried in the `.lib` interface and stashed in
            // next_overload. Inline it directly as an integer constant.
            if sym.kind == SYM_CONST and sym.decl_node == 0 as u32:
                let lc_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: sym.type_id,
                    dest: lc_reg,
                    src1: sym.next_overload,
                    src2: 0 as u32,
                ))
                return lc_reg
            if sym.kind == SYM_CONST and sym.decl_node != 0 as u32:
                mut init_expr := 0 as u32
                
                mut imported_mod := null as ptr[ModuleInfo]
                if self.mb.symbols.lazy_resolver != null as ptr[void]:
                    imported_mod = lazy_resolver_find_module_of_symbol(self.mb.symbols.lazy_resolver as ptr[LazyResolver], sym_idx)
                
                let saved_tree = self.mb.tree
                let saved_node_types = self.mb.node_types
                if imported_mod != null as ptr[ModuleInfo] and imported_mod.ast_tree != null as ptr[AstTree]:
                    self.mb.tree = imported_mod.ast_tree
                    self.mb.node_types = imported_mod.node_types as ptr[u32]

                mut child_const := 0 as u32
                if (sym.decl_node as i64) < self.mb.tree.nodes.len:
                    child_const = self.mb.tree.nodes.data[sym.decl_node as i64].first_child
                while child_const != 0 as u32 and (child_const as i64) < self.mb.tree.nodes.len:
                    let child_const_node = self.mb.tree.nodes.data[child_const as i64]
                    if child_const_node.kind != NODE_TYPE_EXPR and child_const_node.kind != NODE_GENERIC_TYPE:
                        init_expr = child_const
                    child_const = child_const_node.next_sibling
                
                mut val_reg := 0 as u32
                if init_expr != 0 as u32:
                    val_reg = self.lower_expr(init_expr)
                
                self.mb.tree = saved_tree
                self.mb.node_types = saved_node_types
                
                return val_reg
            
            // RFC 0004: qualified nullary-variant construction `EnumType.Variant`.
            // Typecheck bound this field-expr to the variant symbol (flag 2048); build
            // the same tagged value a bare `Variant` would, instead of an OP_GET_FIELD
            // on the type name (which read a garbage receiver and crashed). Only
            // no-payload variants complete here; a payload variant `EnumType.Ctor(x)`
            // is a call and is built in lower_call_expr with its argument.
            if sym.kind == SYM_VARIANT and sym.type_id != 0 as u32 and (sym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[sym.type_id as i64].kind == TYPE_KIND_SUM:
                    mut ntag := -1 as i64
                    mut npayload := 0 as u32
                    self.find_variant_info(sym.type_id, sym.name_id, &ntag, &npayload)
                    if npayload == TYPE_UNKNOWN:
                        return self.lower_variant_construct(sym_idx, 0 as u32)
            if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
                return 0 as u32
            let reg = self.locals.local_map_get(sym_idx)
            return reg
        return 0 as u32

    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let obj_reg = self.lower_expr(child)
    let field_idx = node.extra_idx

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_GET_FIELD,
        type_id: type_id,
        dest: reg,
        src1: obj_reg,
        src2: field_idx,
    ))
    return reg

pub fn lower_index_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    mut arr_reg = self.lower_expr(child)
    let idx_expr = self.mb.tree.nodes.data[child as i64].next_sibling
    mut idx_reg := 0 as u32
    if idx_expr != 0 as u32:
        idx_reg = self.lower_expr(idx_expr)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // RFC 0021: `v[i]` on a `Vec[T]` is `vec.data[i]`. The operand is a by-address
    // `{data,len,cap}` aggregate, so index its `data` POINTER field, not the header.
    // Load `data` first, then OP_INDEX on it -- the same sequence the for-in-vec
    // lowering uses (~3688). Detected by the operand's static Vec base name, so plain
    // pointer/array `p[i]` (the only forms the compiler itself uses) is unchanged and
    // the self-host fixpoint stays A==B.
    if self.mb.node_types != null as ptr[u32]:
        let child_ty = self.mb.node_types[child as i64]
        if child_ty != 0 as u32 and (child_ty as i64) < self.mb.typetable.entries.len:
            let ce = self.mb.typetable.entries.data[child_ty as i64]
            if (ce.kind == TYPE_KIND_GENERIC_INST or ce.kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(ce.name_id)) == "Vec":
                let data_nid = self.mb.pool.intern("data")
                mut vd_idx := 0 as u32
                let vd_type = fl_resolve_field(self, child_ty, data_nid, &vd_idx)
                if vd_type != 0 as u32:
                    let data_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: vd_type, dest: data_reg, src1: arr_reg, src2: vd_idx))
                    arr_reg = data_reg

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_INDEX,
        type_id: type_id,
        dest: reg,
        src1: arr_reg,
        src2: idx_reg,
    ))
    return reg

pub fn lower_cast_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let src_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // RFC 0020: `str` <-> `bytes` share the same {ptr,len} 16-byte repr, so the cast
    // is a pure reinterpret (a zero-cost view). Reuse the source register directly —
    // an OP_CAST would treat the value as an 8-byte scalar and drop the len field.
    if self.mb.node_types != null as ptr[u32] and (type_id == 12 as u32 or type_id == 22 as u32):
        let src_ty0 = self.mb.node_types[child as i64]
        if src_ty0 == 12 as u32 or src_ty0 == 22 as u32:
            return src_reg

    // RFC 0006 (BUG#33/BUG#35): int↔float casts must be real convert
    // instructions, not OP_CAST copy-reinterpret. int→float → OP_ITOF
    // (cvtsi2sd); float→int → OP_FTOI (cvttsd2si, truncate toward zero).
    // int↔int and f32↔f64 stay OP_CAST for now (f32↔f64 precise convert is a
    // follow-up with the ss encoder family).
    mut opcode := OP_CAST
    if self.mb.node_types != null as ptr[u32] and type_id != 0 as u32:
        let src_ty = self.mb.node_types[child as i64]
        if src_ty != 0 as u32:
            let dst_is_float = type_id == 9 as u32 or type_id == 10 as u32
            let src_is_float = src_ty == 9 as u32 or src_ty == 10 as u32
            if dst_is_float and not src_is_float:
                opcode = OP_ITOF
            elif src_is_float and not dst_is_float:
                opcode = OP_FTOI

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: src_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_deref_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let ptr_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // Dereferencing a ptr[str] yields a 16-byte str value. The deref node's own
    // inferred type is not always monomorphised to the concrete pointee (a
    // generic T resolving to str stays generic in node_types), which would make
    // both regalloc and the selector treat the result as 8 bytes and drop the
    // str's len field. Recover the concrete type from the operand's pointee.
    if self.mb.node_types != null as ptr[u32] and type_id != 12 as u32:
        let child_type = self.mb.node_types[child as i64]
        if child_type != 0 as u32 and (child_type as i64) < self.mb.typetable.entries.len:
            let ce = self.mb.typetable.entries.data[child_type as i64]
            if (ce.kind == TYPE_KIND_POINTER or ce.kind == TYPE_KIND_REF) and ce.extra == 12 as u32:
                type_id = 12 as u32
            elif (ce.kind == TYPE_KIND_POINTER or ce.kind == TYPE_KIND_REF) and ce.extra != 0 as u32 and (ce.extra as i64) < self.mb.typetable.entries.len:
                // Recover concrete aggregate pointee so the selector treats `p.*`
                // (p: ptr[Struct/Sum/etc]) as a by-address aggregate value (returns
                // the pointer) instead of loading the full struct size. The deref's
                // own inferred type stays generic when p came from `masked as ptr[T]`
                // in Result/Option.unwrap. Mirrors the str (12) recovery above.
                let pe = self.mb.typetable.entries.data[ce.extra as i64]
                if pe.kind == TYPE_KIND_STRUCT or pe.kind == TYPE_KIND_ARRAY or pe.kind == TYPE_KIND_TUPLE or pe.kind == TYPE_KIND_SUM or pe.kind == TYPE_KIND_GENERIC_INST or pe.kind == TYPE_KIND_OPTION or pe.kind == TYPE_KIND_RESULT:
                    type_id = ce.extra

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_DEREF,
        type_id: type_id,
        dest: reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_spawn_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    mut target_reg := 0 as u32
    mut type_id := 0 as u32
    let child_node = self.mb.tree.nodes.data[child as i64]
    if child_node.kind == NODE_CALL_EXPR:
        let callee_node_idx = child_node.first_child
        if callee_node_idx != 0 as u32:
            target_reg = self.lower_expr(callee_node_idx)
            let callee_node = self.mb.tree.nodes.data[callee_node_idx as i64]
            if callee_node.kind == NODE_IDENT:
                type_id = callee_node.payload as u32
    else:
        target_reg = self.lower_expr(child)

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_SPAWN,
        type_id: type_id,
        dest: reg,
        src1: target_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_await_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let future_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_AWAIT,
        type_id: type_id,
        dest: reg,
        src1: future_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_struct_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    let struct_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: struct_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    mut child := node.first_child
    mut field_idx := 0 as u32
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_NAMED_ARG:
            let val_child = cn.first_child
            if val_child != 0 as u32:
                let val_reg = self.lower_expr(val_child)
                self.fb.emit(AirInst(
                    opcode: OP_SET_FIELD,
                    type_id: type_id,
                    dest: val_reg,
                    src1: struct_reg,
                    src2: field_idx,
                ))
            field_idx = field_idx + 1 as u32
        child = cn.next_sibling
    return struct_reg

pub fn lower_array_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // Element type (needed so OP_STORE below scales the index by the right
    // element size -- mirrors the `a[i] = v` index-assignment lowering,
    // which reads `entry.extra` the same way; see lower_assign_stmt).
    mut elem_type_id := 0 as u32
    if type_id != 0 as u32 and (type_id as i64) < self.mb.typetable.entries.len:
        let arr_entry = self.mb.typetable.entries.data[type_id as i64]
        if arr_entry.kind == TYPE_KIND_ARRAY or arr_entry.kind == TYPE_KIND_SLICE or arr_entry.kind == TYPE_KIND_POINTER:
            elem_type_id = arr_entry.extra as u32

    let arr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: arr_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    mut child := node.first_child
    mut elem_idx := 0 as u32
    while child != 0 as u32:
        let elem_reg = self.lower_expr(child)

        let idx_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: 3 as u32, // i32
            dest: idx_reg,
            src1: elem_idx,
            src2: 0 as u32,
        ))

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: elem_type_id,
            dest: arr_reg,
            src1: elem_reg,
            src2: idx_reg,
        ))

        elem_idx = elem_idx + 1 as u32
        child = self.mb.tree.nodes.data[child as i64].next_sibling
    return arr_reg

pub fn lower_struct_constructor_call(mut self: ptr[FuncLowering], idx: u32, node: AstNode, type_id: u32) -> u32:
    let struct_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id as u32,
        dest: struct_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let callee = node.first_child
    if callee == 0 as u32:
        return struct_reg

    mut child := self.mb.tree.nodes.data[callee as i64].next_sibling
    mut field_idx := 0 as u32
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_NAMED_ARG:
            let val_child = cn.first_child
            if val_child != 0 as u32:
                let val_reg = self.lower_expr(val_child)
                self.fb.emit(AirInst(
                    opcode: OP_SET_FIELD,
                    type_id: type_id as u32,
                    dest: val_reg,
                    src1: struct_reg,
                    src2: field_idx,
                ))
            field_idx = field_idx + 1 as u32
        else:
            let val_reg = self.lower_expr(child)
            self.fb.emit(AirInst(
                opcode: OP_SET_FIELD,
                type_id: type_id as u32,
                dest: val_reg,
                src1: struct_reg,
                src2: field_idx,
            ))
            field_idx = field_idx + 1 as u32
        child = cn.next_sibling
    return struct_reg

pub fn emit_heap_alloc(mut self: ptr[FuncLowering], type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: ptr_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let ref_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_MAKE_REF,
        type_id: type_id,
        dest: ref_reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return ref_reg

pub fn emit_deref(mut self: ptr[FuncLowering], ref_reg: u32, type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_DEREF,
        type_id: type_id,
        dest: ptr_reg,
        src1: ref_reg,
        src2: 0 as u32,
    ))
    return ptr_reg

pub fn emit_move(mut self: ptr[FuncLowering], src_reg: u32, type_id: u32) -> u32:
    let dest_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_MOVE,
        type_id: type_id,
        dest: dest_reg,
        src1: src_reg,
        src2: 0 as u32,
    ))
    return dest_reg

pub fn emit_free(mut self: ptr[FuncLowering], ptr_reg: u32):
    self.fb.emit(AirInst(
        opcode: OP_FREE,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: ptr_reg,
        src2: 0 as u32,
    ))

pub fn emit_arena_alloc(mut self: ptr[FuncLowering], arena_reg: u32, type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ARENA_ALLOC,
        type_id: type_id,
        dest: ptr_reg,
        src1: arena_reg,
        src2: 0 as u32,
    ))
    return ptr_reg

pub fn emit_alias_reuse(mut self: ptr[FuncLowering], ptr_reg: u32, type_id: u32) -> u32:
    let dest_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALIAS_REUSE,
        type_id: type_id,
        dest: dest_reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return dest_reg

pub fn lower_ownership_aware(mut self: ptr[FuncLowering], idx: u32, node: AstNode, init_reg: u32) -> u32:
    if node.flags & FLAG_ESCAPES_TO_HEAP != 0 as u16:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        let ref_reg = self.emit_heap_alloc(type_id)

        if init_reg != 0 as u32:
            let ptr_reg = self.emit_deref(ref_reg, type_id)
            self.fb.emit(AirInst(
                opcode: OP_STORE,
                type_id: 0 as u32,
                dest: ptr_reg,
                src1: init_reg,
                src2: 0 as u32,
            ))
        return ref_reg

    if node.flags & FLAG_USES_ARENA != 0 as u16:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        let ptr_reg = self.emit_arena_alloc(0 as u32, type_id)
        if init_reg != 0 as u32:
            self.fb.emit(AirInst(
                opcode: OP_STORE,
                type_id: 0 as u32,
                dest: ptr_reg,
                src1: init_reg,
                src2: 0 as u32,
            ))
        return ptr_reg

    if node.flags & FLAG_IS_MOVED != 0 as u16 and init_reg != 0 as u32:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        return self.emit_move(init_reg, type_id)

    return init_reg

pub fn lower_alias_stmt(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        let cn = self.mb.tree.nodes.data[node.first_child as i64]
        let src_reg = self.lower_expr(node.first_child)

        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        self.emit_alias_reuse(src_reg, type_id)

pub fn lower_block(mut self: ptr[FuncLowering], block_idx: u32):
    let node = self.mb.tree.nodes.data[block_idx as i64]
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        self.lower_stmt(child, cn)
        child = cn.next_sibling

// RFC 0004: look up the sequential tag + payload type of variant `name_id`
// inside sum type `sum_type_id`. Returns true if found.
// BUG#91: resolve a type to the underlying user-sum type id, seeing through a
// GENERIC_INST (e.g. an unannotated `One(42)` types as GENERIC_INST `Opt[i64]`, not
// the kind-6 sum). A generic instance's name_id equals its base type's name_id
// (same shortcut builder_type_size uses for structs). Returns 0 if not a sum.
pub fn resolve_sum_type(self: ptr[FuncLowering], type_id: u32) -> u32:
    if type_id == 0 as u32 or (type_id as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let e = self.mb.typetable.entries.data[type_id as i64]
    if e.kind == TYPE_KIND_SUM:
        return type_id
    if e.kind == TYPE_KIND_GENERIC_INST:
        mut k := 0 as i64
        while k < self.mb.typetable.entries.len:
            let e2 = self.mb.typetable.entries.data[k]
            if e2.kind == TYPE_KIND_SUM and e2.name_id == e.name_id:
                return k as u32
            k = k + 1
    return 0 as u32

// BUG#90: does `s` equal `prefix` or start with it? (zero-alloc; both are views.)
pub fn name_has_prefix(s: str, prefix: str) -> bool:
    let pl = std.string.len(prefix)
    let sl = std.string.len(s)
    if sl < pl:
        return false
    let sp = get_str_ptr(s)
    let pp = get_str_ptr(prefix)
    mut i := 0 as i64
    while i < pl:
        if sp[i] != pp[i]:
            return false
        i = i + 1 as i64
    return true

// BUG#90: classify a receiver type as Option (0), Result (1), or neither (-1), seeing
// through kind 11/12 and a GENERIC_INST/SUM whose base name is Option/Result.
pub fn opt_res_kind(self: ptr[FuncLowering], type_id: u32) -> i64:
    if type_id == 0 as u32 or (type_id as i64) >= self.mb.typetable.entries.len:
        return -1 as i64
    let e = self.mb.typetable.entries.data[type_id as i64]
    if e.kind == TYPE_KIND_OPTION:
        return 0 as i64
    if e.kind == TYPE_KIND_RESULT:
        return 1 as i64
    if (e.kind == TYPE_KIND_GENERIC_INST or e.kind == TYPE_KIND_SUM) and e.name_id != 0 as u32:
        let nm = self.mb.pool.get(e.name_id)
        if name_has_prefix(nm, "Option"):
            return 0 as i64
        if name_has_prefix(nm, "Result"):
            return 1 as i64
    return -1 as i64

pub fn find_variant_info(self: ptr[FuncLowering], sum_type_id: u32, name_id: u32, out_tag: ptr[i64], out_payload: ptr[u32]) -> bool:
    out_tag[0] = -1 as i64
    out_payload[0] = 0 as u32
    let resolved_sum = self.resolve_sum_type(sum_type_id)
    if resolved_sum == 0 as u32:
        return false
    let entry = self.mb.typetable.entries.data[resolved_sum as i64]
    let sum_extra = entry.extra
    if (sum_extra as i64) >= self.mb.typetable.sumtypes.len:
        return false
    let sum_info = self.mb.typetable.sumtypes.data[sum_extra as i64]
    mut j := 0 as i64
    while j < sum_info.variants.len:
        let v = sum_info.variants.data[j]
        if v.name_id == name_id:
            out_tag[0] = v.tag as i64
            out_payload[0] = v.payload_type
            return true
        j = j + 1
    return false

// RFC 0004: construct a user sum value. `payload_arg_idx` is the AST node of the
// single payload argument (0 = no payload). The value is an 8-byte pointer to a
// heap box [tag@0, payload@8]; reuses OP_ALLOC/OP_SET_FIELD (the sum reg type
// makes field_offset yield 0 and 8 for fields 0 and 1).
pub fn lower_variant_construct(mut self: ptr[FuncLowering], variant_sym_idx: u32, payload_arg_idx: u32) -> u32:
    let vsym = self.mb.symbols.symbols.data[variant_sym_idx as i64]
    let sum_type_id = vsym.type_id
    mut tag := -1 as i64
    mut payload_type := 0 as u32
    self.find_variant_info(sum_type_id, vsym.name_id, &tag, &payload_type)
    if tag < 0 as i64:
        tag = 0 as i64

    let box_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: sum_type_id,
        dest: box_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let tag_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 4 as u32,
        dest: tag_reg,
        src1: tag as u32,
        src2: 0 as u32,
    ))
    self.fb.emit(AirInst(
        opcode: OP_SET_FIELD,
        type_id: sum_type_id,
        dest: tag_reg,
        src1: box_reg,
        src2: 0 as u32,
    ))

    if payload_arg_idx != 0 as u32:
        // RFC 0019: a SYNTHESIZED (flagged) payload struct — a multi-field variant
        // (`Rect(3,4)`) or a single >8B primitive wrap (`Text(str)`). Gather the N call
        // args into a fresh struct box (arg[i] -> struct field i), then store the struct
        // pointer into box field 1 — a value byte-identical to a user single-struct
        // payload, and one that fits the box's 8-byte payload slot. A plain single
        // payload (scalar or user struct) takes the existing path below.
        mut is_multifield := false
        if payload_type != 0 as u32 and (payload_type as i64) < self.mb.typetable.entries.len:
            let pe = self.mb.typetable.entries.data[payload_type as i64]
            if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16:
                is_multifield = true
        if is_multifield:
            let struct_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ALLOC, type_id: payload_type, dest: struct_reg, src1: 0 as u32, src2: 0 as u32))
            mut arg := payload_arg_idx
            mut fi := 0 as u32
            while arg != 0 as u32:
                let arg_reg = self.lower_expr(arg)
                self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: payload_type, dest: arg_reg, src1: struct_reg, src2: fi))
                arg = self.mb.tree.nodes.data[arg as i64].next_sibling
                fi = fi + 1 as u32
            self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: sum_type_id, dest: struct_reg, src1: box_reg, src2: 1 as u32))
        else:
            let pl_reg = self.lower_expr(payload_arg_idx)
            self.fb.emit(AirInst(
                opcode: OP_SET_FIELD,
                type_id: sum_type_id,
                dest: pl_reg,
                src1: box_reg,
                src2: 1 as u32,
            ))
    return box_reg

// RFC 0004: lower `match` on a user sum value to a tag-dispatch if/elif chain.
// Each arm pattern is one of: NODE_VARIANT_PAT (tag + bind payload), bare
// NODE_BINDING_PAT whose name IS a variant (tag, no bind), bare NODE_BINDING_PAT
// of a non-variant name (catch-all, binds scrutinee), or NODE_WILDCARD_PAT
// (catch-all). The scrutinee box pointer is read once; field 0 = tag, field 1 =
// payload. v1 handles sum scrutinees only.
// RFC 0012: classify a `match` as Option (0) / Result (1) / neither (-1) by its
// arm pattern names. Some/None ⇒ Option, Ok/Err ⇒ Result. Uses the pattern's TOKEN
// text (reliable in the current module), not the scrutinee's static type.
pub fn match_arms_tagged_kind(mut self: ptr[FuncLowering], scrutinee_idx: u32) -> i64:
    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut result := -1 as i64
    while arm != 0 as u32:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        if arm_node.kind == NODE_MATCH_ARM:
            let pat = arm_node.first_child
            if pat != 0 as u32:
                let pat_node = self.mb.tree.nodes.data[pat as i64]
                if pat_node.kind == NODE_VARIANT_PAT or pat_node.kind == NODE_BINDING_PAT:
                    let ptext = self.mb.get_token_text(pat_node.token_idx)
                    if ptext == "Some" or ptext == "None":
                        result = 0 as i64
                    elif ptext == "Ok" or ptext == "Err":
                        result = 1 as i64
                    @free(get_str_ptr(ptext))
                    if result >= 0 as i64:
                        return result
        arm = arm_node.next_sibling
    return result

// RFC 0012: dispatch `match` on an Option/Result (kind 11/12) scrutinee. Unlike a
// user sum (tag@field0, payload@field1), these are pointer-tagged: the scrutinee
// register holds an 8-byte box pointer — None = null(0), Some = non-null; Ok = box
// with bit0 clear, Err = box|1; the payload lives at [box & ~1 + 0]. Arms are
// classified by the pattern's TOKEN text (Some/None/Ok/Err), because the builtin
// variants are not registered in the sum table and cross-module name_ids are
// unreliable here (see the constructor comment). is_res selects Result vs Option.
pub fn lower_match_tagged(mut self: ptr[FuncLowering], scrutinee_idx: u32, scrut_reg: u32, is_res: bool):
    // The scrutinee's static type is the monomorphised std Option/Result sum
    // (`type Option[T] = Some(T)|None`), so find_variant_info can recover each
    // arm's payload TYPE — needed to load the payload at the right width (a str
    // payload is a 16-byte by-address value, everything else an 8-byte slot).
    mut scrut_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        scrut_type = self.mb.node_types[scrutinee_idx as i64]
    let merge_block = self.fb.new_block()
    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut done := false
    while arm != 0 as u32 and not done:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        let next_arm = arm_node.next_sibling
        if arm_node.kind != NODE_MATCH_ARM:
            arm = next_arm
            continue
        let pat = arm_node.first_child
        if pat == 0 as u32:
            arm = next_arm
            continue
        let pat_node = self.mb.tree.nodes.data[pat as i64]
        let body = pat_node.next_sibling

        // Classify the arm by its pattern token text.
        mut arm_kind := -1 as i64   // 0=None 1=Some 2=Ok 3=Err
        mut is_default := false
        mut bind_sym := 0 as u32          // catch-all binding of the whole scrutinee
        mut payload_bind_sym := 0 as u32  // variant payload binding
        let pat_variant_sym = pat_node.payload  // variant symbol (for payload type lookup)
        if pat_node.kind == NODE_WILDCARD_PAT:
            is_default = true
        else:
            let ptext = self.mb.get_token_text(pat_node.token_idx)
            if ptext == "None":
                arm_kind = 0
            elif ptext == "Some":
                arm_kind = 1
            elif ptext == "Ok":
                arm_kind = 2
            elif ptext == "Err":
                arm_kind = 3
            @free(get_str_ptr(ptext))
            if arm_kind < 0 as i64:
                // A bare non-variant identifier is a catch-all binding.
                if pat_node.kind == NODE_BINDING_PAT:
                    is_default = true
                    bind_sym = pat_node.payload
                else:
                    is_default = true
            elif pat_node.kind == NODE_VARIANT_PAT:
                let arg = pat_node.first_child
                if arg != 0 as u32 and self.mb.tree.nodes.data[arg as i64].kind == NODE_BINDING_PAT:
                    payload_bind_sym = self.mb.tree.nodes.data[arg as i64].payload

        if is_default:
            if bind_sym != 0 as u32:
                self.locals.local_map_put(bind_sym, scrut_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)
            done = true
        else:
            // Build the discriminant register to compare against zero.
            // None/Some: the box pointer itself. Ok/Err: (box & 1).
            mut disc_reg := scrut_reg
            if arm_kind == 2 as i64 or arm_kind == 3 as i64:
                let one_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: one_reg, src1: 1 as u32, src2: 0 as u32))
                let and_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: and_reg, src1: scrut_reg, src2: one_reg))
                disc_reg = and_reg
            let zero_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zero_reg, src1: 0 as u32, src2: 0 as u32))
            let cmp_reg = self.fb.fresh_reg()
            // None (0) and Ok (bit0==0) take the arm when the discriminant == 0;
            // Some (non-null) and Err (bit0==1) take it when != 0.
            mut cmp_op := OP_EQ
            if arm_kind == 1 as i64 or arm_kind == 3 as i64:
                cmp_op = OP_NE
            self.fb.emit(AirInst(opcode: cmp_op, type_id: 11 as u32, dest: cmp_reg, src1: disc_reg, src2: zero_reg))

            let then_block = self.fb.new_block()
            let else_block = self.fb.new_block()
            self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: else_block, src1: cmp_reg, src2: then_block))
            let cur = self.fb.current_block()
            self.fb.add_edge(cur, then_block)
            self.fb.add_edge(cur, else_block)

            self.fb.switch_to(then_block)
            self.terminated = false
            if payload_bind_sym != 0 as u32:
                // box = scrut (Some/Ok) or scrut & ~1 (Err); payload = [box+0].
                mut box_reg := scrut_reg
                if arm_kind == 3 as i64:
                    let mask_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: mask_reg, src1: 0xFFFFFFFE as u32, src2: 0xFFFFFFFF as u32))
                    let cleared = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: cleared, src1: scrut_reg, src2: mask_reg))
                    box_reg = cleared
                // Recover the payload TYPE: prefer the scrutinee sum's variant info
                // (gives str/struct/scalar exactly), then the binding symbol's type,
                // then i64. Extract via OP_DEREF (not a raw 8-byte load) so a str
                // payload gets its full 16-byte by-address value and a struct/scalar
                // gets its correct width — mirroring how `.*`/GET_FIELD read a payload.
                mut pl_type := 0 as u32
                if pat_variant_sym != 0 as u32 and (pat_variant_sym as i64) < self.mb.symbols.symbols.len:
                    let vname = self.mb.symbols.symbols.data[pat_variant_sym as i64].name_id
                    mut vt := -1 as i64
                    mut vpl := 0 as u32
                    if self.find_variant_info(scrut_type, vname, &vt, &vpl):
                        pl_type = vpl
                // Option/Result are registered as dedicated kinds (11/12) with the
                // payload in `extra` (Some/Ok inner) and `name_id` (Result Err) — not
                // as a sum with a variant vector — so find_variant_info can't see them.
                // Derive the payload type directly so a str (12) payload gets its full
                // 16-byte DEREF instead of the 8-byte default (else `s.len` reads junk).
                if pl_type == 0 as u32 and scrut_type != 0 as u32 and (scrut_type as i64) < self.mb.typetable.entries.len:
                    let se = self.mb.typetable.entries.data[scrut_type as i64]
                    if se.kind == TYPE_KIND_OPTION:
                        pl_type = se.extra
                    elif se.kind == TYPE_KIND_RESULT:
                        if arm_kind == 3 as i64:
                            pl_type = se.name_id
                        else:
                            pl_type = se.extra
                if pl_type == 0 as u32 and (payload_bind_sym as i64) < self.mb.symbols.symbols.len:
                    let bt = self.mb.symbols.symbols.data[payload_bind_sym as i64].type_id
                    if bt != 0 as u32:
                        pl_type = bt
                // A str payload is stored INLINE as a 16-byte str: the constructor
                // (Some/Ok/Err, ~line 1656) uses store_t=12 whenever the payload EXPR is
                // str. But for a str variant the sum table records the RFC 0019 synth
                // struct that WRAPS the str (a single-str-field struct), whose type id
                // isn't str(12) — so a plain DEREF would take the 8-byte path and drop
                // the length half (`s.len` reads junk). Unwrap a single-str-field struct
                // back to str(12) so the DEREF loads the full 16 bytes, mirroring the
                // constructor exactly. (Genuine multi-field / >8B user-struct payloads
                // are heap-boxed as an 8-byte pointer and must NOT be unwrapped.)
                if pl_type != 0 as u32 and (pl_type as i64) < self.mb.typetable.entries.len:
                    let pe = self.mb.typetable.entries.data[pl_type as i64]
                    if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16 and (pe.extra as i64) < self.mb.typetable.structs.len:
                        let si = self.mb.typetable.structs.data[pe.extra as i64]
                        if si.fields.len == 1 as i64 and si.fields.data[0].type_id == 12 as u32:
                            pl_type = 12 as u32
                if pl_type == 0 as u32:
                    pl_type = 4 as u32
                let pl_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_DEREF, type_id: pl_type, dest: pl_reg, src1: box_reg, src2: 0 as u32))
                self.locals.local_map_put(payload_bind_sym, pl_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)

            self.fb.switch_to(else_block)
            self.terminated = false
        arm = next_arm

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)
    self.fb.switch_to(merge_block)
    self.terminated = false

pub fn lower_match(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let scrutinee_idx = node.first_child
    if scrutinee_idx == 0 as u32:
        return
    let scrut_reg = self.lower_expr(scrutinee_idx)

    mut scrut_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        scrut_type = self.mb.node_types[scrutinee_idx as i64]

    // RFC 0012: Option/Result use the pointer-tagged layout (None=null, Some=box;
    // Ok=even box, Err=box|1; payload at [box&~1]), NOT the user-sum tag-at-field-0
    // box. Detect them by ARM NAMES (Some/None ⇒ Option, Ok/Err ⇒ Result) rather
    // than the scrutinee's static type: the builtin variants are declared as a
    // generic sum in std/result.ax, so typecheck may type the scrutinee as that sum
    // (or leave it untyped), and codegen always emits the pointer-tagged layout for
    // these names. Classifying by name keeps the whole fix inside the backend, off
    // the stdlib's generic Option/Result ABI. -1 = not tagged, 0 = Option, 1 = Result.
    let tagged_kind = self.match_arms_tagged_kind(scrutinee_idx)
    if tagged_kind >= 0 as i64:
        self.lower_match_tagged(scrutinee_idx, scrut_reg, tagged_kind == 1 as i64)
        return

    mut is_sum := false
    // BUG#91: a user sum scrutinee may be typed as a GENERIC_INST (unannotated generic
    // construction like `One(42)` for `Opt[T]`), not a kind-6 SUM. Resolve through it,
    // else the match silently lowered to nothing (the whole `match` disappeared).
    if self.resolve_sum_type(scrut_type) != 0 as u32:
        is_sum = true
    // RFC 0006 (BUG#37/#38.2): `match` on a plain integer/bool/char scrutinee is
    // the C-`switch` equivalent — compare the value itself against literal-pattern
    // values. (1-8 = int widths, 11 = bool, 13 = char8, 15/16 = isize/usize.)
    mut is_int := false
    if not is_sum:
        if (scrut_type >= 1 as u32 and scrut_type <= 8 as u32) or scrut_type == 11 as u32 or scrut_type == 13 as u32 or scrut_type == 15 as u32 or scrut_type == 16 as u32:
            is_int = true
    if not is_sum and not is_int:
        return

    // The register compared against each arm: the tag (sum) or the value (int).
    mut match_reg := scrut_reg
    if is_sum:
        let tag_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_GET_FIELD,
            type_id: 4 as u32,
            dest: tag_reg,
            src1: scrut_reg,
            src2: 0 as u32,
        ))
        match_reg = tag_reg

    let merge_block = self.fb.new_block()

    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut done := false
    while arm != 0 as u32 and not done:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        let next_arm = arm_node.next_sibling
        if arm_node.kind != NODE_MATCH_ARM:
            arm = next_arm
            continue
        let pat = arm_node.first_child
        if pat == 0 as u32:
            arm = next_arm
            continue
        let pat_node = self.mb.tree.nodes.data[pat as i64]
        let body = pat_node.next_sibling

        // Classify the pattern.
        mut is_default := false
        mut variant_tag := -1 as i64
        mut payload_type := 0 as u32
        mut bind_sym := 0 as u32        // catch-all binding (whole scrutinee)
        mut payload_bind_sym := 0 as u32 // variant payload binding

        if pat_node.kind == NODE_WILDCARD_PAT:
            is_default = true
        elif pat_node.kind == NODE_LITERAL_PAT:
            // C-switch case: compare the scrutinee value against this literal.
            let ltext = self.mb.get_token_text(pat_node.token_idx)
            variant_tag = parse_int_from_str(ltext)
            @free(get_str_ptr(ltext))
        elif pat_node.kind == NODE_VARIANT_PAT:
            let vsi = pat_node.payload
            if vsi != 0 as u32:
                let vname = self.mb.symbols.symbols.data[vsi as i64].name_id
                self.find_variant_info(scrut_type, vname, &variant_tag, &payload_type)
            let arg = pat_node.first_child
            if arg != 0 as u32 and self.mb.tree.nodes.data[arg as i64].kind == NODE_BINDING_PAT:
                payload_bind_sym = self.mb.tree.nodes.data[arg as i64].payload
        elif pat_node.kind == NODE_BINDING_PAT:
            // Bare ident: it is a no-payload variant if its name matches one,
            // otherwise a catch-all binding of the whole scrutinee.
            let bsi = pat_node.payload
            mut bname := 0 as u32
            if bsi != 0 as u32:
                bname = self.mb.symbols.symbols.data[bsi as i64].name_id
            mut t := -1 as i64
            mut pt := 0 as u32
            if self.find_variant_info(scrut_type, bname, &t, &pt):
                variant_tag = t
            else:
                is_default = true
                bind_sym = bsi
        else:
            is_default = true

        if is_default:
            if bind_sym != 0 as u32:
                self.locals.local_map_put(bind_sym, scrut_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)
            done = true
        else:
            if variant_tag < 0 as i64:
                variant_tag = 0 as i64
            mut const_type := 4 as u32   // i64 tag (sum)
            if is_int:
                const_type = scrut_type  // compare in the scrutinee's own width/signedness
            let const_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ICONST, type_id: const_type, dest: const_reg, src1: (variant_tag & (0xFFFFFFFF as i64)) as u32, src2: ((variant_tag >> (32 as i64)) & (0xFFFFFFFF as i64)) as u32))
            let cmp_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_EQ, type_id: 11 as u32, dest: cmp_reg, src1: match_reg, src2: const_reg))

            let then_block = self.fb.new_block()
            let else_block = self.fb.new_block()
            self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: else_block, src1: cmp_reg, src2: then_block))
            let cur = self.fb.current_block()
            self.fb.add_edge(cur, then_block)
            self.fb.add_edge(cur, else_block)

            self.fb.switch_to(then_block)
            self.terminated = false
            if payload_bind_sym != 0 as u32:
                let pat_arg0 = pat_node.first_child
                mut is_mf := false
                if pat_arg0 != 0 as u32 and payload_type != 0 as u32 and (payload_type as i64) < self.mb.typetable.entries.len:
                    let pe2 = self.mb.typetable.entries.data[payload_type as i64]
                    if pe2.kind == TYPE_KIND_STRUCT and (pe2.flags & 1 as u16) != 0 as u16:
                        is_mf = true
                if is_mf:
                    // RFC 0019: multi-field variant — read the struct payload pointer from
                    // box field 1, then bind each pattern var to its struct field.
                    let struct_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: payload_type, dest: struct_reg, src1: scrut_reg, src2: 1 as u32))
                    let s_idx = self.mb.typetable.entries.data[payload_type as i64].extra
                    mut bp := pat_arg0
                    mut bfi := 0 as u32
                    while bp != 0 as u32:
                        if self.mb.tree.nodes.data[bp as i64].kind == NODE_BINDING_PAT:
                            let bsym = self.mb.tree.nodes.data[bp as i64].payload
                            mut fld_ty := 0 as u32
                            if (s_idx as i64) < self.mb.typetable.structs.len and (bfi as i64) < self.mb.typetable.structs.data[s_idx as i64].fields.len:
                                fld_ty = self.mb.typetable.structs.data[s_idx as i64].fields.data[bfi as i64].type_id
                            let f_reg = self.fb.fresh_reg()
                            self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: fld_ty, dest: f_reg, src1: struct_reg, src2: bfi))
                            if bsym != 0 as u32:
                                self.locals.local_map_put(bsym, f_reg)
                        bp = self.mb.tree.nodes.data[bp as i64].next_sibling
                        bfi = bfi + 1 as u32
                else:
                    let pl_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: payload_type, dest: pl_reg, src1: scrut_reg, src2: 1 as u32))
                    self.locals.local_map_put(payload_bind_sym, pl_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)

            self.fb.switch_to(else_block)
            self.terminated = false
        arm = next_arm

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)
    self.fb.switch_to(merge_block)
    self.terminated = false

pub fn lower_stmt(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.terminated:
        return

    if node.kind == NODE_VAR_DECL:
        self.lower_var_decl(idx, node)
    elif node.kind == NODE_ASSIGN_STMT:
        self.lower_assign(idx, node)
    elif node.kind == NODE_RETURN_STMT:
        self.lower_return(idx, node)
    elif node.kind == NODE_IF_STMT:
        self.lower_if(idx, node)
    elif node.kind == NODE_WHILE_STMT:
        self.lower_while(idx, node)
    elif node.kind == NODE_MATCH_STMT:
        self.lower_match(idx, node)
    elif node.kind == NODE_FOR_STMT:
        self.lower_for(idx, node)
    elif node.kind == NODE_BLOCK:
        self.lower_block(idx)
    elif node.kind == NODE_DESTROY_STMT:
        self.lower_destroy(idx, node)
    elif node.kind == NODE_ALIAS_STMT:
        self.lower_alias_stmt(idx, node)
    elif node.kind == NODE_DEFER_STMT:
        self.lower_defer(idx, node)
    elif node.kind == NODE_BREAK_STMT:
        self.lower_break(idx, node)
    elif node.kind == NODE_CONTINUE_STMT:
        self.lower_continue(idx, node)
    elif node.kind == NODE_UNSAFE_BLOCK or node.kind == NODE_ARENA_BLOCK:
        // RFC 0006 (#38.5/#38.6): execute the inner block transparently. unsafe
        // (gen-check disable) and arena (alloc routing) semantics are deferred.
        if node.first_child != 0 as u32:
            self.lower_block(node.first_child)
    else:
        self.lower_expr(idx)

pub fn lower_break(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.loop_exits.len == 0 as i64:
        return
    let target = self.loop_exits.data[self.loop_exits.len - 1]
    self.fb.emit(AirInst(
        opcode: OP_JUMP,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: target,
        src2: 0 as u32,
    ))
    self.fb.add_edge(self.fb.current_block(), target)
    self.terminated = true

pub fn lower_continue(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.loop_conds.len == 0 as i64:
        return
    // BUG#89: `continue` jumps to the loop condition, bypassing the body-tail
    // increment. For a `for` loop, advance the counter inline first (same +1 the tail
    // emits) so it does not spin forever; a while-loop has incr_reg 0 and is skipped.
    if self.loop_incr_regs.len > 0 as i64:
        let incr_reg = self.loop_incr_regs.data[self.loop_incr_regs.len - 1]
        if incr_reg != 0 as u32:
            let incr_type = self.loop_incr_types.data[self.loop_incr_types.len - 1]
            // RFC 0020 P2b: a non-zero step reg (str codepoint width) advances the
            // counter variably; otherwise add a constant 1.
            mut step_reg := self.loop_incr_steps.data[self.loop_incr_steps.len - 1]
            if step_reg == 0 as u32:
                step_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: incr_type,
                    dest: step_reg,
                    src1: 1 as u32,
                    src2: 0 as u32,
                ))
            let nv_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_IADD,
                type_id: incr_type,
                dest: nv_reg,
                src1: incr_reg,
                src2: step_reg,
            ))
            self.fb.emit(AirInst(
                opcode: OP_COPY,
                type_id: incr_type,
                dest: incr_reg,
                src1: nv_reg,
                src2: 0 as u32,
            ))
    let target = self.loop_conds.data[self.loop_conds.len - 1]
    self.fb.emit(AirInst(
        opcode: OP_JUMP,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: target,
        src2: 0 as u32,
    ))
    self.fb.add_edge(self.fb.current_block(), target)
    self.terminated = true

pub fn lower_var_decl(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let name_id = node.payload
    mut type_id := 0 as u32

    mut init_reg := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_PTR_TYPE and cn.kind != NODE_SLICE_TYPE and cn.kind != NODE_ARRAY_TYPE and cn.kind != NODE_FUNC_TYPE and cn.kind != NODE_GENERIC_TYPE:
            init_reg = self.lower_expr(child)
        child = cn.next_sibling

    if init_reg != 0 as u32:
        mut src_reg := init_reg
        if node.flags & (FLAG_ESCAPES_TO_HEAP | FLAG_USES_ARENA | FLAG_IS_MOVED) != 0 as u16:
            src_reg = self.lower_ownership_aware(idx, node, init_reg)

        let reg = self.fb.fresh_reg()
        mut var_type_id := 0 as u32
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                var_type_id = sym.type_id as u32

        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: var_type_id,
            dest: reg,
            src1: src_reg,
            src2: 0 as u32,
        ))
        self.locals.local_map_put(name_id, reg)
    else:
        let reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: type_id,
            dest: reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        self.locals.local_map_put(name_id, reg)

// RFC 0006 (#38.1): lower the RHS value of an assignment, applying compound
// `op=` semantics. `a op= b` desugars to `a = a op b` — the lhs is re-read as an
// expression for its current value (simple lvalues; side-effecting bases are
// evaluated twice, acceptable for now). The op follows the lhs type: float ->
// OP_F*, unsigned div handled downstream by the selector. Plain `=` returns the
// rhs unchanged. (Was silently dropping the op so `a += b` ran as `a = b`.)
pub fn assign_value(mut self: ptr[FuncLowering], node: AstNode, lhs_idx: u32, rhs_idx: u32) -> u32:
    let rhs_reg = self.lower_expr(rhs_idx)
    let op_text = self.mb.get_token_text(node.token_idx)
    mut bop := OP_NOP
    if op_text == "+=":
        bop = OP_IADD
    elif op_text == "-=":
        bop = OP_ISUB
    elif op_text == "*=":
        bop = OP_IMUL
    elif op_text == "/=":
        bop = OP_IDIV
    elif op_text == "%=":
        bop = OP_IMOD
    @free(get_str_ptr(op_text))
    if bop == OP_NOP:
        return rhs_reg
    mut rty := 3 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[lhs_idx as i64] != 0 as u32:
        rty = self.mb.node_types[lhs_idx as i64] as u32
    if rty == 9 as u32 or rty == 10 as u32:
        if bop == OP_IADD:
            bop = OP_FADD
        elif bop == OP_ISUB:
            bop = OP_FSUB
        elif bop == OP_IMUL:
            bop = OP_FMUL
        elif bop == OP_IDIV:
            bop = OP_FDIV
    let cur_reg = self.lower_expr(lhs_idx)
    let comb = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: bop, type_id: rty, dest: comb, src1: cur_reg, src2: rhs_reg))
    return comb

pub fn lower_assign(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let lhs_idx = node.first_child
    if lhs_idx == 0 as u32:
        return
    let lhs_node = self.mb.tree.nodes.data[lhs_idx as i64]

    if lhs_node.kind == NODE_FIELD_EXPR:
        let obj_idx = lhs_node.first_child
        let obj_reg = self.lower_expr(obj_idx)
        let field_idx = lhs_node.extra_idx

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        let val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let obj_type = self.mb.node_types[obj_idx as i64]
        if obj_type != 0 as u32 and (obj_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[obj_type as i64]
            if entry.kind == TYPE_KIND_POINTER:
                type_id = entry.extra as u32
            else:
                type_id = obj_type as u32

        self.fb.emit(AirInst(
            opcode: OP_SET_FIELD,
            type_id: type_id,
            dest: val_reg,
            src1: obj_reg,
            src2: field_idx,
        ))
        return

    elif lhs_node.kind == NODE_INDEX_EXPR:
        let arr_idx = lhs_node.first_child
        let arr_reg = self.lower_expr(arr_idx)
        let index_idx = self.mb.tree.nodes.data[arr_idx as i64].next_sibling
        mut index_reg := 0 as u32
        if index_idx != 0 as u32:
            index_reg = self.lower_expr(index_idx)

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        let val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let arr_type = self.mb.node_types[arr_idx as i64]
        if arr_type != 0 as u32 and (arr_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[arr_type as i64]
            if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_SLICE or entry.kind == TYPE_KIND_ARRAY:
                type_id = entry.extra as u32

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: type_id,
            dest: arr_reg,
            src1: val_reg,
            src2: index_reg,
        ))
        return

    elif lhs_node.kind == NODE_DEREF_EXPR:
        let ptr_idx = lhs_node.first_child
        let ptr_reg = self.lower_expr(ptr_idx)

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        let val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let ptr_type = self.mb.node_types[ptr_idx as i64]
        if ptr_type != 0 as u32 and (ptr_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[ptr_type as i64]
            if entry.kind == TYPE_KIND_POINTER:
                type_id = entry.extra as u32

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: type_id,
            dest: ptr_reg,
            src1: val_reg,
            src2: 0 as u32,
        ))
        return

    mut name_id := lhs_node.payload
    if name_id == 0 as u32:
        let text = self.mb.get_token_text(lhs_node.token_idx)
        name_id = self.mb.pool.intern(text)
        @free(get_str_ptr(text))

    let rhs_idx = lhs_node.next_sibling
    if rhs_idx == 0 as u32:
        return
    let rhs_node = self.mb.tree.nodes.data[rhs_idx as i64]
    let val_reg = self.assign_value(node, lhs_idx, rhs_idx)

    mut type_id := 3 as u32 // default i32
    if lhs_node.payload != 0 as u32 and (lhs_node.payload as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[lhs_node.payload as i64]
        if sym.type_id != 0 as u32:
            type_id = sym.type_id as u32

    // RFC 0017 / BUG#82: assigning to a module-level global writes its static storage
    // (OP_GLOBAL_ADDR + OP_STORE), not a per-function vreg — so the value persists
    // across calls and read-modify-write is correct.
    if lhs_node.payload != 0 as u32 and (lhs_node.payload as i64) < self.mb.symbols.symbols.len:
        if self.mb.symbols.symbols.data[lhs_node.payload as i64].kind == SYM_VAR and self.mb.builder_global_index(lhs_node.payload) != -1 as i64:
            self.lower_global_write(lhs_node.payload, type_id, val_reg)
            return

    let existing_reg = self.locals.local_map_get(name_id)
    if existing_reg != 0 as u32:
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: type_id,
            dest: existing_reg,
            src1: val_reg,
            src2: 0 as u32,
        ))
    else:
        self.locals.local_map_put(name_id, val_reg)

pub fn lower_return(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    mut ret_val := 0 as u32
    if node.first_child != 0 as u32:
        ret_val = self.lower_expr(node.first_child)

    // RFC 0006 (#38.4): run deferred expressions (LIFO) after the return value
    // is computed but before transferring control, on every return path.
    self.flush_defers()

    self.fb.emit(AirInst(
        opcode: OP_RETURN,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: ret_val,
        src2: 0 as u32,
    ))
    self.terminated = true

pub fn lower_if(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let merge_block = self.fb.new_block()

    let cond_node_idx = node.first_child
    if cond_node_idx == 0 as u32:
        return
    let cond_node = self.mb.tree.nodes.data[cond_node_idx as i64]

    let body_node_idx = cond_node.next_sibling
    if body_node_idx == 0 as u32:
        return
    let body_node = self.mb.tree.nodes.data[body_node_idx as i64]

    let next_clause_idx = body_node.next_sibling

    self.lower_if_chain(cond_node_idx, cond_node, body_node_idx, body_node, next_clause_idx, merge_block)

    // Merge block
    self.fb.switch_to(merge_block)
    self.terminated = false

pub fn lower_if_chain(mut self: ptr[FuncLowering], cond_idx: u32, cond_node: AstNode, body_idx: u32, body_node: AstNode, next_clause_idx: u32, merge_block: u32):
    let then_block = self.fb.new_block()
    let else_block = self.fb.new_block()

    // Lower condition
    let cond_reg = self.lower_expr(cond_idx)

    // Branch
    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: else_block,
        src1: cond_reg,
        src2: then_block,
    ))
    let cur_block = self.fb.current_block()
    self.fb.add_edge(cur_block, then_block)
    self.fb.add_edge(cur_block, else_block)

    // Then block
    self.fb.switch_to(then_block)
    self.terminated = false
    if body_node.kind == NODE_BLOCK:
        self.lower_block(body_idx)
    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)

    // Else block
    self.fb.switch_to(else_block)
    self.terminated = false
    mut delegated := false
    if next_clause_idx != 0 as u32:
        let cn = self.mb.tree.nodes.data[next_clause_idx as i64]
        if cn.kind == NODE_ELSE_CLAUSE:
            let else_body_idx = cn.first_child
            if else_body_idx != 0 as u32:
                let else_body_node = self.mb.tree.nodes.data[else_body_idx as i64]
                if else_body_node.kind == NODE_BLOCK:
                    self.lower_block(else_body_idx)
        elif cn.kind == NODE_ELIF_CLAUSE:
            let elif_cond_idx = cn.first_child
            if elif_cond_idx != 0 as u32:
                let elif_cond_node = self.mb.tree.nodes.data[elif_cond_idx as i64]
                let elif_body_idx = elif_cond_node.next_sibling
                if elif_body_idx != 0 as u32:
                    let elif_body_node = self.mb.tree.nodes.data[elif_body_idx as i64]
                    self.lower_if_chain(elif_cond_idx, elif_cond_node, elif_body_idx, elif_body_node, cn.next_sibling, merge_block)
                    delegated = true

    if not self.terminated and not delegated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)

pub fn lower_while(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()

    self.loop_conds.push(cond_block)
    self.loop_exits.push(exit_block)
    // BUG#89: a while-loop has no loop increment — `continue` jumps straight to cond.
    // Push reg 0 so lower_continue emits no increment (keeps stacks parallel).
    self.loop_incr_regs.push(0 as u32)
    self.loop_incr_types.push(0 as u32)
    self.loop_incr_steps.push(0 as u32)

    let cur_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(cur_block, cond_block)

    // Condition
    self.fb.switch_to(cond_block)
    self.terminated = false
    let child = node.first_child
    if child == 0 as u32:
        self.loop_conds.pop()
        self.loop_exits.pop()
        self.loop_incr_regs.pop()
        self.loop_incr_types.pop()
        self.loop_incr_steps.pop()
        return
    let cn = self.mb.tree.nodes.data[child as i64]
    let cond_reg = self.lower_expr(child)

    // BUG#86: lowering the condition may itself create blocks (short-circuit
    // `and`/`or` builds a diamond), so the block that actually holds the OP_BRANCH
    // is the *current* block, not `cond_block`. Attribute the CFG edges to it —
    // otherwise the merge block has no recorded successor to the exit and
    // remove_unreachable_blocks() wrongly NOPs the exit's `ret` (infinite loop at
    // -O1). lower_if_chain already does this; while must match.
    let branch_block = self.fb.current_block()
    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: exit_block,
        src1: cond_reg,
        src2: body_block,
    ))
    self.fb.add_edge(branch_block, body_block)
    self.fb.add_edge(branch_block, exit_block)

    // Body
    self.fb.switch_to(body_block)
    self.terminated = false
    let body_child = cn.next_sibling
    if body_child != 0 as u32:
        let bcn = self.mb.tree.nodes.data[body_child as i64]
        if bcn.kind == NODE_BLOCK:
            self.lower_block(body_child)

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
        self.fb.add_edge(body_block, cond_block)

    // Exit
    self.fb.switch_to(exit_block)
    self.terminated = false

    self.loop_conds.pop()
    self.loop_exits.pop()
    self.loop_incr_regs.pop()
    self.loop_incr_types.pop()
    self.loop_incr_steps.pop()

// RFC 0018 P2: resolve the underlying struct of a STRUCT/GENERIC_INST type and
// return the type_id of the field whose name interns to `field_name_id`, writing its
// field index to *out_idx. Returns 0 if not resolvable. Mirrors the typecheck field
// resolution (generic-inst base-name match) so indices agree with OP_GET_FIELD.
fn fl_resolve_field(self: ptr[FuncLowering], type_id: u32, field_name_id: u32, out_idx: ptr[u32]) -> u32:
    if (type_id as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let entry = self.mb.typetable.entries.data[type_id as i64]
    mut struct_extra := entry.extra
    mut is_struct := false
    if entry.kind == TYPE_KIND_STRUCT:
        is_struct = true
    elif entry.kind == TYPE_KIND_GENERIC_INST:
        let entry_base = extract_qualified_base_name(self.mb.pool.get(entry.name_id))
        mut i := 0 as i64
        while i < self.mb.typetable.entries.len:
            let e = self.mb.typetable.entries.data[i]
            if e.kind == TYPE_KIND_STRUCT:
                let e_base = extract_qualified_base_name(self.mb.pool.get(e.name_id))
                if e_base == entry_base:
                    struct_extra = e.extra
                    is_struct = true
                    break
            i = i + 1
    if not is_struct or (struct_extra as i64) >= self.mb.typetable.structs.len:
        return 0 as u32
    let si = &self.mb.typetable.structs.data[struct_extra as i64]
    mut j := 0 as i64
    while j < si.fields.len:
        if si.fields.data[j].name_id == field_name_id:
            out_idx.* = j as u32
            return si.fields.data[j].type_id
        j = j + 1
    return 0 as u32

pub fn lower_for(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()

    self.loop_conds.push(cond_block)
    self.loop_exits.push(exit_block)

    let sym_idx = node.payload
    // BUG#87: the loop variable must be keyed in local_map by its SYMBOL INDEX
    // (node.payload), because that is the key lower_ident uses to read it
    // (`local_map_get(sym_idx)`) — exactly like a `let`/`mut` var-decl (which keys by
    // node.payload too). Keying by `sym.name_id` here stored it under a different key,
    // so every body reference to the loop variable missed the map and read 0/garbage
    // (the loop still ran the right count since lower_for's own get/put were mutually
    // consistent). name_id below IS the symbol index despite the name.
    mut name_id := sym_idx
    mut type_id := 3 as u32 // default i32

    if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[sym_idx as i64]
        if sym.type_id != 0 as u32:
            type_id = sym.type_id as u32

    let range_expr_idx = node.first_child
    mut start_reg := 0 as u32
    mut limit_reg := 0 as u32
    mut is_range := false
    // RFC 0018 P1: `for x in <fixed-array>` element iteration state.
    mut is_collection := false
    mut coll_reg := 0 as u32
    mut elem_type := 0 as u32
    mut coll_len := 0 as u32
    // RFC 0018 P2: `for x in vec` (Vec[T]) state. Unlike a fixed array the length is a
    // RUNTIME field (vec.len) and the elements live behind the vec.data pointer, so we
    // load both fields instead of using a compile-time bound / direct OP_INDEX.
    mut is_vec := false
    mut vec_data_idx := 0 as u32
    mut vec_data_type := 0 as u32
    mut vec_len_idx := 0 as u32
    // RFC 0020 P2: `for b in bytes` — like an array (direct OP_INDEX on the value,
    // which yields the u8 byte) but with a RUNTIME bound (bytes.len, field 1).
    mut is_bytes := false
    // RFC 0020 P2b: `for c in str` — UTF-8 codepoint iteration. The counter is a BYTE
    // offset; each iteration calls std.string.utf8_decode(s, off) -> packed
    // (width<<32)|codepoint, binds the loop var (rune) to the codepoint, and advances
    // the offset by the variable width (str_width_reg).
    mut is_string := false
    mut str_decode_sym := 0 as u32
    mut str_width_reg := 0 as u32
    // Type of the numeric counter driving the loop: for a range/integer-bound loop
    // the counter IS the loop variable (its type); for a collection loop the counter
    // is an internal i32 index (the loop variable holds the element instead).
    mut counter_type := type_id

    if range_expr_idx != 0 as u32:
        let range_node = self.mb.tree.nodes.data[range_expr_idx as i64]
        if range_node.kind == NODE_BINARY_EXPR:
            let op_text = self.mb.get_token_text(range_node.token_idx)
            if op_text == "..":
                is_range = true
                let start_node_idx = range_node.first_child
                if start_node_idx != 0 as u32:
                    start_reg = self.lower_expr(start_node_idx)
                    let start_node = self.mb.tree.nodes.data[start_node_idx as i64]
                    let end_node_idx = start_node.next_sibling
                    if end_node_idx != 0 as u32:
                        limit_reg = self.lower_expr(end_node_idx)
            @free(get_str_ptr(op_text))

    // RFC 0018 P1: detect a fixed-array iteree. node_types holds the iteree's type;
    // a TYPE_KIND_ARRAY carries compile-time length in name_id and element type in
    // extra. (An integer-bound `for i in n` has a numeric type here and stays on the
    // 0..n counter path below.) Typecheck rejects Vec/HashMap/struct/sum (P2).
    if not is_range and range_expr_idx != 0 as u32 and self.mb.node_types != null as ptr[u32]:
        let coll_ty = self.mb.node_types[range_expr_idx as i64] as u32
        if coll_ty != 0 as u32 and (coll_ty as i64) < self.mb.typetable.entries.len:
            let coll_kind = self.mb.typetable.entries.data[coll_ty as i64].kind
            if coll_kind == TYPE_KIND_ARRAY:
                is_collection = true
                elem_type = self.mb.typetable.entries.data[coll_ty as i64].extra
                coll_len = self.mb.typetable.entries.data[coll_ty as i64].name_id
                counter_type = 3 as u32 // i32 index counter
            elif (coll_kind == TYPE_KIND_GENERIC_INST or coll_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(self.mb.typetable.entries.data[coll_ty as i64].name_id)) == "Vec":
                // RFC 0018 P2: iterate a Vec[T] by loading vec.len (bound) and indexing
                // vec.data. The loop variable's type (type_id) is the element type T,
                // bound by typecheck. Counter is i64 to match the i64 len field.
                let data_nid = self.mb.pool.intern("data")
                let len_nid = self.mb.pool.intern("len")
                vec_data_type = fl_resolve_field(self, coll_ty, data_nid, &vec_data_idx)
                let len_ty = fl_resolve_field(self, coll_ty, len_nid, &vec_len_idx)
                if vec_data_type != 0 as u32 and len_ty != 0 as u32:
                    is_collection = true
                    is_vec = true
                    elem_type = type_id // loop var type == element type T
                    counter_type = 4 as u32 // i64 index counter (matches vec.len)
            elif coll_ty == TYPE_BYTES:
                // RFC 0020 P2: bytes shares str's {ptr@0, len@1} repr; OP_INDEX on the
                // value yields a u8 (proven by `b[i]`), so iterate like an array with a
                // runtime bound = bytes.len (field 1).
                is_collection = true
                is_bytes = true
                elem_type = 5 as u32 // u8
                counter_type = 4 as u32 // i64 index counter (matches the i64 len field)
                vec_len_idx = 1 as u32 // len is field 1 in the {ptr,len} layout
            elif coll_ty == TYPE_STRING:
                // RFC 0020 P2b: iterate UTF-8 codepoints. Resolve the decode helper via
                // the same symbol path the `str + str` -> concat overload uses (a direct
                // `string.utf8_decode(..)` call currently miscompiles for str args).
                let dsym = self.resolve_op_method("utf8_decode", TYPE_STRING, 4 as u32)
                if dsym != 0 as u32:
                    is_collection = true
                    is_string = true
                    str_decode_sym = dsym
                    elem_type = 7 as u32 // rune (u32 codepoint)
                    counter_type = 4 as u32 // i64 byte offset
                    vec_len_idx = 1 as u32 // str.len (byte length) is field 1
                    str_width_reg = self.fb.fresh_reg()

    let iter_reg = self.fb.fresh_reg()
    if is_range:
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: type_id,
            dest: iter_reg,
            src1: start_reg,
            src2: 0 as u32,
        ))
    elif is_collection:
        // Evaluate the collection base once; iter_reg is the internal 0-based index.
        coll_reg = self.lower_expr(range_expr_idx)
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: counter_type,
            dest: iter_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        limit_reg = self.fb.fresh_reg()
        if is_vec or is_bytes or is_string:
            // Runtime bound: load the len (i64) field once before the loop
            // (Vec.len / bytes.len / str.len byte length, all at vec_len_idx).
            self.fb.emit(AirInst(
                opcode: OP_GET_FIELD,
                type_id: 4 as u32, // i64
                dest: limit_reg,
                src1: coll_reg,
                src2: vec_len_idx,
            ))
        else:
            self.fb.emit(AirInst(
                opcode: OP_ICONST,
                type_id: counter_type,
                dest: limit_reg,
                src1: coll_len,
                src2: 0 as u32,
            ))
    else:
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: type_id,
            dest: iter_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        if range_expr_idx != 0 as u32:
            limit_reg = self.lower_expr(range_expr_idx)

    // For a collection loop the loop variable is bound in the body (to arr[i]); the
    // counter register iter_reg must NOT shadow it.
    if not is_collection:
        self.locals.local_map_put(name_id, iter_reg)

    // BUG#89: record the counter (iter_reg) + its type so `continue` can advance it
    // inline before jumping to cond (the body-tail increment only runs on fall-through).
    self.loop_incr_regs.push(iter_reg)
    self.loop_incr_types.push(counter_type)
    // str: advance by the codepoint width (str_width_reg); others: 0 => default +1.
    self.loop_incr_steps.push(str_width_reg)

    let cur_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(cur_block, cond_block)

    // Condition
    self.fb.switch_to(cond_block)
    self.terminated = false

    let cmp_reg = self.fb.fresh_reg()
    // Range/integer-bound: counter is the loop var (local_map). Collection: counter is
    // the internal iter_reg. (For a range, local_map_get(name_id) == iter_reg, so the
    // emitted OP_LT is byte-identical to before.)
    mut current_iter := iter_reg
    if not is_collection:
        current_iter = self.locals.local_map_get(name_id)
    self.fb.emit(AirInst(
        opcode: OP_LT,
        type_id: 11 as u32, // bool
        dest: cmp_reg,
        src1: current_iter,
        src2: limit_reg,
    ))

    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: exit_block,
        src1: cmp_reg,
        src2: body_block,
    ))
    self.fb.add_edge(cond_block, body_block)
    self.fb.add_edge(cond_block, exit_block)

    // Body
    self.fb.switch_to(body_block)
    self.terminated = false

    // RFC 0018 P1: at the top of each iteration bind the loop variable to arr[i].
    // The loop var maps directly to this OP_INDEX result (no OP_COPY), which handles
    // scalar elements by-value and aggregate elements by-address (RFC 0001 §5).
    if is_collection and is_string:
        // RFC 0020 P2b: decode the UTF-8 codepoint at the current byte offset via
        // std.string.utf8_decode(s, off) -> packed (width<<32)|codepoint. Bind the
        // loop var (rune) to the low 32 bits; stash the width (high 32) for the
        // variable increment.
        let arg_start = self.fb.emit_extra(2 as u32)
        self.fb.emit_extra(coll_reg)
        self.fb.emit_extra(iter_reg)
        let packed_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_CALL, type_id: str_decode_sym, dest: packed_reg, src1: 0 as u32, src2: arg_start))
        // codepoint = packed & 0xFFFFFFFF
        let mask_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: mask_reg, src1: 0xFFFFFFFF as u32, src2: 0 as u32))
        let cp_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: cp_reg, src1: packed_reg, src2: mask_reg))
        // width = packed >> 32 (logical) -> str_width_reg (used by the increment)
        let sh_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: sh_reg, src1: 32 as u32, src2: 0 as u32))
        self.fb.emit(AirInst(opcode: OP_SHR, type_id: 4 as u32, dest: str_width_reg, src1: packed_reg, src2: sh_reg))
        self.locals.local_map_put(name_id, cp_reg)
    elif is_collection:
        // The array/Vec base to index: for a fixed array the collection reg IS the
        // element base; for a Vec the elements live behind the vec.data pointer, so
        // load that field first (per-iteration — cheap, and keeps coll_reg as the
        // struct for the len already read above).
        mut index_base := coll_reg
        if is_vec:
            let data_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_GET_FIELD,
                type_id: vec_data_type,
                dest: data_reg,
                src1: coll_reg,
                src2: vec_data_idx,
            ))
            index_base = data_reg
        let elem_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_INDEX,
            type_id: elem_type,
            dest: elem_reg,
            src1: index_base,
            src2: iter_reg,
        ))
        self.locals.local_map_put(name_id, elem_reg)

    if range_expr_idx != 0 as u32:
        let range_node = self.mb.tree.nodes.data[range_expr_idx as i64]
        let body_node_idx = range_node.next_sibling
        if body_node_idx != 0 as u32:
            let body_node = self.mb.tree.nodes.data[body_node_idx as i64]
            if body_node.kind == NODE_BLOCK:
                self.lower_block(body_node_idx)

    if not self.terminated:
        // Step amount: for `for c in str` advance by the codepoint width; otherwise +1.
        mut step_reg := str_width_reg
        if not is_string:
            step_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_ICONST,
                type_id: counter_type,
                dest: step_reg,
                src1: 1 as u32,
                src2: 0 as u32,
            ))
        mut current_iter2 := iter_reg
        if not is_collection:
            current_iter2 = self.locals.local_map_get(name_id)
        let new_val_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_IADD,
            type_id: counter_type,
            dest: new_val_reg,
            src1: current_iter2,
            src2: step_reg,
        ))
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: counter_type,
            dest: current_iter2,
            src1: new_val_reg,
            src2: 0 as u32,
        ))

        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
        self.fb.add_edge(body_block, cond_block)

    // Exit
    self.fb.switch_to(exit_block)
    self.terminated = false

    self.loop_conds.pop()
    self.loop_exits.pop()
    self.loop_incr_regs.pop()
    self.loop_incr_types.pop()
    self.loop_incr_steps.pop()

pub fn lower_destroy(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        let val_reg = self.lower_expr(node.first_child)
        self.fb.emit(AirInst(
            opcode: OP_DESTROY,
            type_id: 0 as u32,
            dest: 0 as u32,
            src1: val_reg,
            src2: 0 as u32,
        ))
    else:
        let sym_id = node.payload
        if sym_id != 0 as u32 and (sym_id as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[sym_id as i64]
            let reg = self.locals.local_map_get(sym.name_id)
            if reg != 0 as u32:
                self.fb.emit(AirInst(
                    opcode: OP_DESTROY,
                    type_id: 0 as u32,
                    dest: 0 as u32,
                    src1: reg,
                    src2: 0 as u32,
                ))

// RFC 0006 (#38.4): a `defer expr` registers the expression to run at scope
// exit instead of executing it now (the old stub ran it immediately, which was
// wrong). We record the expr node index in textual order; flush_defers emits
// them LIFO at each return and at function exit. Function-level (Go) semantics:
// an unconditional `defer` at the top of a function runs on every return path.
// LIMITATION: a defer inside a not-taken conditional branch is still emitted at
// later exits (no runtime registration) — documented in knowledge/bugs.md.
pub fn lower_defer(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        self.defers.push(node.first_child)

// Emit all registered deferred expressions into the current block, last-in
// first-out. Does NOT clear the list: each control-flow exit path (return /
// fall-through) is a distinct basic block and must run the defers once.
pub fn flush_defers(mut self: ptr[FuncLowering]):
    if self.defers.len == 0 as i64:
        return
    mut i := self.defers.len - 1 as i64
    while i >= 0 as i64:
        self.lower_expr(self.defers.data[i])
        i = i - 1 as i64

pub fn ensure_return(mut self: ptr[FuncLowering]):
    if not self.terminated:
        self.flush_defers()
        self.fb.emit(AirInst(
            opcode: OP_RETURN,
            type_id: 0 as u32,
            dest: 0 as u32,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        self.terminated = true

pub fn lower_func(self: ptr[AirModuleBuilder], idx: u32, node: AstNode) -> AirFunc:
    if node.flags & FLAG_IS_EXTERN != 0 as u16:
        return AirFunc(sym_id: 0 as u32, name: 0 as u32, params: new_u32_vec(), ret_type: 0 as u32, blocks: new_basic_block_vec(), insts: new_air_inst_vec(), extras: new_u32_vec(), is_async: false, is_extern: true, block_instrs: new_u32_vec(), block_succs: new_u32_vec(), block_preds: new_u32_vec())

    mut name_id := 0 as u32
    mut ret_type_id := 0 as u32
    mut param_types := new_u32_vec()

    let sym_idx = node.payload
    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symbols.symbols.len:
        let sym = self.symbols.symbols.data[sym_idx as i64]
        name_id = sym.name_id
        if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.typetable.entries.len:
            let entry = self.typetable.entries.data[sym.type_id as i64]
            if entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[entry.extra as i64]
                ret_type_id = fi.ret
                

                
                mut i := 0 as i64
                while i < fi.params.len:
                    param_types.push(fi.params.data[i])
                    i = i + 1

    if name_id == 0 as u32:
        let text = self.get_token_text(node.token_idx)
        name_id = self.pool.intern(text)
        @free(get_str_ptr(text))

    mut fb := new_air_func_builder(name_id, ret_type_id)
    mut fl := new_func_lowering(self, fb, param_types)

    fl.register_params(idx, node)

    mut body_idx := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child as i64]
        if cn.kind == NODE_BLOCK:
            body_idx = child
        child = cn.next_sibling

    if body_idx != 0 as u32:
        fl.lower_block(body_idx)

    fl.ensure_return()

    mut fn_built := fl.fb.build_func()
    fn_built.sym_id = sym_idx
    fn_built.is_async = (node.flags & FLAG_IS_ASYNC != 0 as u16)
    fn_built.params.data = fl.params.data
    fn_built.params.len = fl.params.len
    fn_built.params.cap = fl.params.cap

    fl.params.data = null as ptr[u32]

    free_func_lowering(fl)
    return fn_built

// RFC 0017 / BUG#82: fold a module-level global's constant initializer as a floating
// value (handles a leading unary +/- and int→float promotion). Only reached for f32/f64
// globals; kept in lockstep with typecheck.ax's ax_global_init_is_const gate.
pub fn builder_global_fold_float(self: ptr[AirModuleBuilder], idx: u32) -> f64:
    if idx == 0 as u32:
        return 0.0
    let node = self.tree.nodes.data[idx as i64]
    if node.kind == NODE_CAST_EXPR:
        return self.builder_global_fold_float(node.first_child)
    if node.kind == NODE_UNARY_EXPR:
        let op = self.get_token_text(node.token_idx)
        let is_neg = op == "-"
        @free(get_str_ptr(op))
        let inner = self.builder_global_fold_float(node.first_child)
        if is_neg:
            return 0.0 - inner
        return inner
    if node.kind == NODE_FLOAT_LIT:
        let text = self.get_token_text(node.token_idx)
        let fv = atof(get_str_ptr(text))
        @free(get_str_ptr(text))
        return fv
    if node.kind == NODE_INT_LIT:
        let text = self.get_token_text(node.token_idx)
        let v = parse_int_from_str(text)
        @free(get_str_ptr(text))
        return v as f64
    return 0.0

// RFC 0017 / BUG#82: fold a module-level global's constant initializer as an i64 bit
// pattern (integers/bools/chars, with a leading unary +/-). Absent init folds to zero.
pub fn builder_global_fold_int(self: ptr[AirModuleBuilder], idx: u32) -> i64:
    if idx == 0 as u32:
        return 0 as i64
    let node = self.tree.nodes.data[idx as i64]
    if node.kind == NODE_CAST_EXPR:
        return self.builder_global_fold_int(node.first_child)
    if node.kind == NODE_UNARY_EXPR:
        let op = self.get_token_text(node.token_idx)
        let is_neg = op == "-"
        @free(get_str_ptr(op))
        let inner = self.builder_global_fold_int(node.first_child)
        if is_neg:
            return 0 as i64 - inner
        return inner
    if node.kind == NODE_INT_LIT:
        let text = self.get_token_text(node.token_idx)
        let v = parse_int_from_str(text)
        @free(get_str_ptr(text))
        return v
    if node.kind == NODE_BOOL_LIT:
        let text = self.get_token_text(node.token_idx)
        mut v := 0 as i64
        if text == "true":
            v = 1 as i64
        @free(get_str_ptr(text))
        return v
    if node.kind == NODE_CHAR_LIT:
        let text = self.get_token_text(node.token_idx)
        mut val := 0 as i64
        let length = std.string.len(text)
        if length >= 3 and text[0] as u8 == '\'' as u8 and text[length - 1] as u8 == '\'' as u8:
            if text[1] as u8 == '\\' as u8 and length >= 4:
                let esc = text[2] as u8
                if esc == 'n' as u8:
                    val = 10 as i64
                elif esc == 't' as u8:
                    val = 9 as i64
                elif esc == 'r' as u8:
                    val = 13 as i64
                elif esc == '\'' as u8:
                    val = 39 as i64
                elif esc == '\\' as u8:
                    val = 92 as i64
                elif esc == '0' as u8:
                    val = 0 as i64
                elif esc == 'b' as u8:
                    val = 8 as i64
                elif esc == 'f' as u8:
                    val = 12 as i64
                else:
                    val = esc as i64
            else:
                val = text[1] as i64
        @free(get_str_ptr(text))
        return val
    return 0 as i64

// RFC 0017 / BUG#82: fold a global's constant initializer to the raw i64 bit pattern
// stored in AirGlobal.init_lo. Float types (f32=9, f64=10) encode IEEE-754 bits; every
// other scalar uses the integer value.
pub fn builder_fold_global_init(self: ptr[AirModuleBuilder], idx: u32, type_id: u32) -> i64:
    if type_id == 9 as u32:
        let fv = self.builder_global_fold_float(idx)
        mut f32v := fv as f32
        return ((&f32v as ptr[u32])[0]) as i64
    if type_id == 10 as u32:
        let fv = self.builder_global_fold_float(idx)
        mut d := fv
        return ((&d as ptr[u64])[0]) as i64
    return self.builder_global_fold_int(idx)

// RFC 0017 / BUG#82: collect one module-level `let`/`mut` declaration into the module's
// global table. The typechecker Phase 4 gate has already rejected non-scalar and
// non-constant-init globals, so this only sees valid scalars.
pub fn collect_global(self: ptr[AirModuleBuilder], node: AstNode):
    let sym_idx = node.payload
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symbols.symbols.len:
        return
    let type_id = self.symbols.symbols.data[sym_idx as i64].type_id
    mut size := 0 as u32
    mut align := 0 as u32
    builder_type_size_and_align(self.typetable, type_id, &size, &align)
    if size == 0 as u32 or size > 8 as u32:
        return
    mut init_expr := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child as i64]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_PTR_TYPE and cn.kind != NODE_SLICE_TYPE and cn.kind != NODE_ARRAY_TYPE and cn.kind != NODE_FUNC_TYPE and cn.kind != NODE_GENERIC_TYPE:
            init_expr = child
        child = cn.next_sibling
    let bits = self.builder_fold_global_init(init_expr, type_id)
    (&self.module.globals).push(AirGlobal(sym_id: sym_idx, type_id: type_id, size: size, init_lo: bits))

// RFC 0017 / BUG#82: index of a symbol in the module's global table, or -1. Used by
// lower_ident / assignment lowering to route reads/writes through OP_GLOBAL_ADDR.
pub fn builder_global_index(self: ptr[AirModuleBuilder], sym_idx: u32) -> i64:
    mut i := 0 as i64
    while i < self.module.globals.len:
        if self.module.globals.data[i].sym_id == sym_idx:
            return i
        i = i + 1
    return -1 as i64

pub fn build_module(self: ptr[AirModuleBuilder]):
    let root = self.tree.nodes.data[0]
    // RFC 0017 / BUG#82: collect module-level globals FIRST so every function body that
    // reads/writes a global can route it through OP_GLOBAL_ADDR (membership is complete
    // before any function is lowered).
    mut gchild := root.first_child
    while gchild != 0 as u32:
        let gnode = self.tree.nodes.data[gchild as i64]
        if gnode.kind == NODE_VAR_DECL:
            self.collect_global(gnode)
        gchild = gnode.next_sibling
    mut child := root.first_child
    while child != 0 as u32:
        let node = self.tree.nodes.data[child as i64]
        if node.kind == NODE_FUNC_DECL:
            if node.flags & FLAG_IS_EXTERN == 0 as u16 and node.flags & FLAG_IS_GENERIC == 0 as u16:
                let fn_val = self.lower_func(child, node)
                self.module.funcs.push(fn_val)
        elif node.kind == NODE_STRUCT_DECL:
            if node.flags & FLAG_IS_GENERIC == 0 as u16:
                mut member := node.first_child
                while member != 0 as u32:
                    let member_node = self.tree.nodes.data[member as i64]
                    if member_node.kind == NODE_FUNC_DECL:
                        if member_node.flags & FLAG_IS_EXTERN == 0 as u16 and member_node.flags & FLAG_IS_GENERIC == 0 as u16:
                            let fn_val = self.lower_func(member, member_node)
                            self.module.funcs.push(fn_val)
                    member = member_node.next_sibling
        elif node.kind == NODE_TYPE_ALIAS_DECL:
            if node.flags & FLAG_IS_GENERIC == 0 as u16:
                mut member := node.first_child
                while member != 0 as u32:
                    let member_node = self.tree.nodes.data[member as i64]
                    if member_node.kind == NODE_FUNC_DECL:
                        if member_node.flags & FLAG_IS_EXTERN == 0 as u16 and member_node.flags & FLAG_IS_GENERIC == 0 as u16:
                            let fn_val = self.lower_func(member, member_node)
                            self.module.funcs.push(fn_val)
                    member = member_node.next_sibling
        child = node.next_sibling

pub fn builder_str_to_null_terminated(self: ptr[AirModuleBuilder], s: str) -> ptr[u8]:
    let len = std.string.len(s)
    let p = @alloc(len + 1) as ptr[u8]
    @memcpy(p, s as ptr[u8], len)
    p[len] = 0 as u8
    return p
