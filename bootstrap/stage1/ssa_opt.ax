// bootstrap/stage1/ssa_opt.ax
// SSA linear Intermediate Representation (AIR) O1 optimization passes:
// Constant Folding, Copy Propagation, and Dead Code Elimination.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct ConstVal:
    pub known: bool
    pub val: u64

pub struct SsaOptimizer:
    pub level: u8

pub fn new_ssa_optimizer() -> SsaOptimizer:
    return SsaOptimizer(level: 1 as u8)

pub fn max_reg_id(f: ptr[AirFunc]) -> u32:
    mut max_id := 0 as u32
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.dest > max_id:
            max_id = inst.dest
        // src1 is a register only if it is a register operand (not block target or immediate constant)
        // src2 is a register only if it is a register operand
        if inst.opcode != OP_ICONST and inst.opcode != OP_FCONST and inst.opcode != OP_JUMP:
            if inst.src1 > max_id:
                max_id = inst.src1
            if inst.src2 > max_id and inst.opcode != OP_BRANCH:
                max_id = inst.src2
        i = i + 1 as i64
    return max_id

pub fn is_unary_foldable(op: u16) -> bool:
    return op == OP_NEG or op == OP_NOT

pub fn has_side_effect(op: u16) -> bool:
    if op == OP_STORE or op == OP_FREE or op == OP_DESTROY or op == OP_ALIAS_REUSE:
        return true
    if op == OP_CALL or op == OP_SPAWN or op == OP_SEND:
        return true
    // A raw syscall (write/mmap/exit/...) performs I/O or memory effects the optimizer
    // cannot see. Without this, a result-discarding `syscall(1,1,buf,len,..)` (e.g. the
    // freestanding Linux print runtime) was deleted as a pure dead value.
    if op == OP_SYSCALL:
        return true
    if op == OP_RETURN or op == OP_JUMP or op == OP_BRANCH:
        return true
    if op == OP_SET_FIELD:
        return true
    return false

pub fn opcode_is_control(op: u16) -> bool:
    if op == OP_JUMP or op == OP_BRANCH or op == OP_CALL or op == OP_RETURN:
        return true
    if op == OP_LOOP_BEGIN or op == OP_LOOP_END:
        return true
    return false

pub fn eval_binary(op: u16, a: u64, b: u64, out_val: ptr[u64]) -> bool:
    let ai = a as i64
    let bi = b as i64

    if op == OP_IADD:
        out_val[0] = (ai + bi) as u64
        return true
    elif op == OP_ISUB:
        out_val[0] = (ai - bi) as u64
        return true
    elif op == OP_IMUL:
        out_val[0] = (ai * bi) as u64
        return true
    elif op == OP_IDIV:
        if bi == 0 as i64:
            return false
        out_val[0] = (ai / bi) as u64
        return true
    elif op == OP_IMOD:
        if bi == 0 as i64:
            return false
        out_val[0] = (ai % bi) as u64
        return true
    elif op == OP_EQ:
        mut res := 0 as u64
        if ai == bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_NE:
        mut res := 0 as u64
        if ai != bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_LT:
        mut res := 0 as u64
        if ai < bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_LE:
        mut res := 0 as u64
        if ai <= bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_GT:
        mut res := 0 as u64
        if ai > bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_GE:
        mut res := 0 as u64
        if ai >= bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_AND:
        out_val[0] = a & b
        return true
    elif op == OP_OR:
        out_val[0] = a | b
        return true
    elif op == OP_XOR:
        out_val[0] = a ^ b
        return true
    elif op == OP_SHL or op == OP_SHR:
        // Do NOT const-fold `const << const` / `const >> const`. When both operands
        // were compile-time constants this fold produced a WRONG value at -O1 (the
        // folded `iconst` came out 0 -> garbage) and crashed native codegen on some
        // `>>` inputs, while `-O0` and every non-both-const shift (var<<var,
        // var<<const, const<<var) were correct. The arithmetic here (`a << b`) is
        // itself right and var-shifts work, so the defect is in how the folded
        // constant is applied/materialized for a shift specifically; leaving shifts
        // to the (correct) runtime lowering restores correctness. The lost
        // optimization -- folding two integer LITERALS in a shift -- is negligible.
        // (BUG from bug-probe round 5; exact fold/apply micro-cause still open.)
        return false

    return false

pub fn eval_unary(op: u16, a: u64, out_val: ptr[u64]) -> bool:
    if op == OP_NEG:
        out_val[0] = (-(a as i64)) as u64
        return true
    // BUG#22: do NOT const-fold OP_NOT here. eval_unary has no operand type, and
    // OP_NOT is overloaded (bool logical `!` vs integer bitwise `~`). Folding it as
    // logical (a==0) corrupted bitwise `~const` (e.g. `~4095` -> 0), which broke
    // every `& ~(align-1)` idiom (struct layout, PE RVAs -> SizeOfImage=0). Leave
    // it unfolded; the type-aware selector (x86_selector OP_NOT) lowers it right.
    return false

// A register whose address is taken (the operand of OP_MAKE_REF) can be mutated
// through that pointer later — by a store, or by a call that receives the
// pointer. Such a register must NOT be treated as a compile-time constant by the
// value-folding passes even if it was defined by an ICONST: folding a use like
// `if flag` after `set(&flag)` to its initial constant skips the memory reload
// that actually observes the mutation. (The backend already spills address-taken
// vregs to a stack slot, so at -O0 the reload happens correctly; this only guards
// the optimizer from short-circuiting it.) Returns a bool[max_reg+1] marking each
// such register; caller frees it.
pub fn mark_addr_taken_regs(f: ptr[AirFunc], max_reg: u32) -> ptr[bool]:
    let arr = @alloc(max_reg as i64 + 1 as i64) as ptr[bool]
    @memset(arr as ptr[void], 0 as u8, max_reg as i64 + 1 as i64)
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_MAKE_REF and inst.src1 != 0 as u32 and inst.src1 <= max_reg:
            arr[inst.src1] = true
        i = i + 1 as i64
    return arr

// Wrap a folded integer constant to the width of its AIR type so a compile-time
// fold matches the runtime narrow-register op. `type_id` is the canonical
// primitive id (i8=1,i16=2,i32=3,i64=4,u8=5,u16=6,u32=7,u64=8,bool=11,char8=13,
// isize=15,usize=16). Only sub-64-bit integer types are masked; 8-byte ints,
// unknown (0), and non-integer ids are returned unchanged (floats are already
// excluded from folding by the has_flt guard). Signed narrow types sign-extend
// to 64 bits; unsigned narrow types zero-extend. See
// [[bug-const-fold-narrow-int-wrap]].
pub fn fold_narrow_mask(type_id: u16, val: u64) -> u64:
    let t = type_id as i64
    mut wbytes := 0 as i64
    mut signed := false
    if t == 1 as i64:
        wbytes = 1
        signed = true
    elif t == 2 as i64:
        wbytes = 2
        signed = true
    elif t == 3 as i64:
        wbytes = 4
        signed = true
    elif t == 5 as i64:
        wbytes = 1
    elif t == 6 as i64:
        wbytes = 2
    elif t == 7 as i64:
        wbytes = 4
    elif t == 11 as i64:
        wbytes = 1
    elif t == 13 as i64:
        wbytes = 1
    if wbytes == 0 as i64 or wbytes >= 8 as i64:
        return val
    let bits = (wbytes * 8 as i64) as u64
    let mask = ((1 as u64) << bits) - 1 as u64
    mut m := val & mask
    if signed:
        let sign_bit = (1 as u64) << (bits - 1 as u64)
        if (m & sign_bit) != 0 as u64:
            m = m | (mask ^ (0xFFFFFFFFFFFFFFFF as u64))
    return m

pub fn fold_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32 and inst.opcode != OP_BRANCH:
            def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32

    // BUG#40: float constants must NOT be integer-folded. eval_binary treats all
    // operands as i64, but comparison opcodes (OP_EQ/NE/LT/LE/GT/GE) are shared by
    // int and float (the selector picks comisd vs cmp by operand type). Folding a
    // float comparison with integer semantics on its IEEE-754 bit pattern gives a
    // wrong result (e.g. `1.41 > 10.0` at -O1). Track which constant regs came from
    // OP_FCONST and skip folding any binary op with a float operand (float
    // arithmetic uses distinct OP_F* opcodes that eval_binary already rejects; only
    // the shared comparisons need this guard).
    let is_flt = @alloc(max_reg as i64 + 1 as i64) as ptr[bool]
    @memset(is_flt as ptr[void], 0 as u8, max_reg as i64 + 1 as i64)

    mut changed := false
    let out_val = @alloc(8 as i64) as ptr[u64]
    let addr_taken = mark_addr_taken_regs(f, max_reg)

    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]

        if inst.opcode == OP_ICONST or inst.opcode == OP_FCONST:
            if inst.dest != 0 as u32:
                if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                    if inst.opcode == OP_ICONST:
                        let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
                        vals[inst.dest] = ConstVal(known: true, val: full_val)
                    else:
                        vals[inst.dest] = ConstVal(known: true, val: inst.src1 as u64)
                        if inst.dest <= max_reg:
                            is_flt[inst.dest] = true
                else:
                    vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
            i = i + 1 as i64
            continue

        if not opcode_is_binary_alu(inst.opcode) and not is_unary_foldable(inst.opcode):
            if inst.dest != 0 as u32:
                vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
            i = i + 1 as i64
            continue

        if opcode_is_binary_alu(inst.opcode):
            let src1_val = vals[inst.src1]
            let src2_val = vals[inst.src2]
            // BUG#40: never integer-fold an op with a float constant operand.
            let has_flt = is_flt[inst.src1] or is_flt[inst.src2]
            if src1_val.known and src2_val.known and not has_flt:
                let ok = eval_binary(inst.opcode, src1_val.val, src2_val.val, out_val)
                if ok:
                    // Narrow-integer wrap: eval_binary computes in full 64-bit, but a
                    // sub-64-bit result (u8/u16/u32/i8/i16/i32) must wrap to its type
                    // width exactly as the runtime 32/16/8-bit register op does. Without
                    // this, folding `u32 4000000000 + 500000000` kept 4_500_000_000 at
                    // -O1 (runtime wraps to 205_032_704) — a silent O0-vs-O1 miscompile.
                    // Signed narrow types sign-extend so the stored i64 constant matches
                    // the runtime value.
                    // GUARD: AIR type_id is NOT always the true value width (e.g. a
                    // negated i64::MIN literal in to_str carries an i32 type_id); masking
                    // such a mislabeled op would corrupt a full-width value (i64::MIN->0).
                    // Only wrap when BOTH operands already fit the declared width — then
                    // the type_id is consistent with the values and the wrap reflects a
                    // genuine narrow-type overflow. See [[bug-const-fold-narrow-int-wrap]].
                    if fold_narrow_mask(inst.type_id, src1_val.val) == src1_val.val and fold_narrow_mask(inst.type_id, src2_val.val) == src2_val.val:
                        out_val[0] = fold_narrow_mask(inst.type_id, out_val[0])
                    inst.opcode = OP_ICONST
                    inst.src1 = (out_val[0] & 0xFFFFFFFF as u64) as u32
                    inst.src2 = ((out_val[0] >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                    if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                        vals[inst.dest] = ConstVal(known: true, val: out_val[0])
                    else:
                        vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
                    changed = true
                    i = i + 1 as i64
                    continue

        if is_unary_foldable(inst.opcode):
            let src1_val = vals[inst.src1]
            // BUG#40 sibling: never integer-fold OP_NEG on a FLOAT operand. eval_unary
            // computes two's-complement `-(a as i64)`, which corrupts an IEEE-754 bit
            // pattern (a float `-x` folded to garbage/0.0 at -O1). Leave float neg to
            // the selector's XMM sign-flip. Mirrors the binary fold's has_flt guard.
            if src1_val.known and not is_flt[inst.src1]:
                let ok = eval_unary(inst.opcode, src1_val.val, out_val)
                if ok:
                    // Narrow-integer wrap (see the binary fold above): OP_NEG on an
                    // i8/i16/i32/u8/u16/u32 must wrap to its width. Same operand-fit
                    // GUARD: skip when the operand doesn't fit the declared width (a
                    // mislabeled type_id, e.g. negated i64::MIN carrying an i32 type_id).
                    if fold_narrow_mask(inst.type_id, src1_val.val) == src1_val.val:
                        out_val[0] = fold_narrow_mask(inst.type_id, out_val[0])
                    inst.opcode = OP_ICONST
                    inst.src1 = (out_val[0] & 0xFFFFFFFF as u64) as u32
                    inst.src2 = ((out_val[0] >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                    if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                        vals[inst.dest] = ConstVal(known: true, val: out_val[0])
                    else:
                        vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
                    changed = true
                    i = i + 1 as i64
                    continue

        if inst.dest != 0 as u32:
            vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(vals as ptr[u8])
    @free(out_val as ptr[u8])
    @free(addr_taken as ptr[u8])
    @free(is_flt as ptr[u8])
    return changed

pub fn copy_prop_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    let copy_map = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(copy_map as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    // BUG#31: an ADDRESS-TAKEN vreg must never participate in a copy chain. For
    // `mut modrm := 0; &modrm; ...; use modrm`, the front end emits
    // `%6 = copy %5; mkref %6` (the variable %6 is the addr-taken cell). The
    // callee writes %6's stack slot through the pointer, so %6 is NOT a true copy
    // of %5 — its value changes invisibly. If we record copy_map[%6]=%5 and then
    // rewrite the data read of %6 to %5 (its stale init) while the mkref/store
    // stays on %6, the read observes the pre-call value -> every `mov reg,reg`
    // collapsed to modrm=0 in self-host stage3 (the backend already force-spills
    // addr-taken vregs; this only stops the optimizer from short-circuiting the
    // reload). Mirror fold_func's `not addr_taken[...]` guard. Guard BOTH ends:
    // dest addr-taken (its memory mutates) and src addr-taken (the snapshot
    // diverges from the live cell after a later through-pointer write).
    let addr_taken = mark_addr_taken_regs(f, max_reg)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32:
            if inst.dest <= max_reg:
                def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    i = 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP:
            if (inst.opcode == OP_COPY or inst.opcode == OP_MOVE) and inst.dest != 0 as u32 and inst.src1 != 0 as u32:
                if inst.dest <= max_reg and inst.src1 <= max_reg:
                    if def_counts[inst.dest] == 1 as u32 and def_counts[inst.src1] == 1 as u32 and not addr_taken[inst.dest] and not addr_taken[inst.src1]:
                        copy_map[inst.dest] = inst.src1
        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]
        if inst.opcode == OP_NOP or inst.opcode == OP_ICONST or inst.opcode == OP_FCONST:
            i = i + 1 as i64
            continue

        // BUG (fn-ptr): OP_FUNC_ADDR encodes the FUNCTION SYMBOL INDEX (an
        // immediate) in src1, not a value vreg — analogous to GET_FIELD/SET_FIELD
        // src2 below (BUG#15). Copy-propagating it corrupts the symbol selector
        // whenever the index numerically collides with a vreg id in a copy chain
        // (e.g. `let f = add` renumbers vregs so add's sym_idx aliases a live
        // copy) -> wrong function address -> crash. Leave src1 untouched here.
        if inst.src1 != 0 as u32 and inst.opcode != OP_JUMP and inst.opcode != OP_FUNC_ADDR:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1

            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        // BUG#15: GET_FIELD/SET_FIELD encode the FIELD INDEX (an immediate) in
        // src2, not a value vreg. Copy-propagating it corrupts the field selector
        // whenever the index numerically collides with a vreg id that is in a
        // copy chain (e.g. field 6 "count" rewritten to vreg 1). src2 here must be
        // left untouched; only true value operands may be propagated.
        if inst.src2 != 0 as u32 and not opcode_is_control(inst.opcode) and inst.opcode != OP_GET_FIELD and inst.opcode != OP_SET_FIELD:
            mut curr := inst.src2
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1

            if curr != inst.src2:
                inst.src2 = curr
                changed = true

        if inst.dest != 0 as u32 and (inst.opcode == OP_STORE or inst.opcode == OP_SET_FIELD):
            mut curr := inst.dest
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.dest:
                inst.dest = curr
                changed = true

        if inst.opcode == OP_BRANCH and inst.src1 != 0 as u32:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        if inst.opcode == OP_RETURN and inst.src1 != 0 as u32:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        // OP_SYSCALL carries its argument vregs in `extras` exactly like OP_CALL
        // (count at extras[src2], args following), so copy-propagate them the same way.
        if inst.opcode == OP_CALL or inst.opcode == OP_SYSCALL:
            let arg_start = inst.src2
            mut arg_count := 0 as u32
            if arg_start < f.extras.len as u32:
                arg_count = f.extras.data[arg_start]

            mut idx := 0 as u32
            while idx < arg_count:
                let arg_reg_idx = arg_start + 1 as u32 + idx
                let arg_reg = f.extras.data[arg_reg_idx]
                if arg_reg != 0 as u32:
                    mut curr := arg_reg
                    mut depth := 0
                    while curr != 0 as u32 and depth < 100:
                        let parent = copy_map[curr]
                        if parent == 0 as u32:
                            break
                        curr = parent
                        depth = depth + 1

                    if curr != arg_reg:
                        f.extras.data[arg_reg_idx] = curr
                        changed = true
                idx = idx + 1 as u32

        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(copy_map as ptr[u8])
    @free(addr_taken as ptr[u8])
    return changed

pub fn remove_unreachable_blocks(f: ptr[AirFunc]) -> bool:
    if f.blocks.len <= 1 as i64:
        return false

    let reachable = @alloc(f.blocks.len) as ptr[bool]
    @memset(reachable as ptr[void], 0 as u8, f.blocks.len)
    reachable[0] = true

    let queue = @alloc(f.blocks.len * 4 as i64) as ptr[u32]
    mut head := 0 as i64
    mut tail := 0 as i64

    queue[tail] = 0 as u32
    tail = tail + 1 as i64

    while head < tail:
        let cur = queue[head]
        head = head + 1 as i64

        if (cur as i64) < f.blocks.len:
            let blk = f.blocks.data[cur]
            mut i := 0 as u32
            while i < blk.succs_len:
                let succ = f.block_succs.data[blk.succs_start + i]
                if (succ as i64) < f.blocks.len:
                    if not reachable[succ]:
                        reachable[succ] = true
                        queue[tail] = succ
                        tail = tail + 1 as i64
                i = i + 1 as u32

    if tail == f.blocks.len:
        @free(reachable as ptr[u8])
        @free(queue as ptr[u8])
        return false

    mut bi := 0 as i64
    while bi < f.blocks.len:
        if not reachable[bi]:
            mut blk := &f.blocks.data[bi]
            mut i := 0 as u32
            while i < blk.instrs_len:
                let inst_idx = f.block_instrs.data[blk.instrs_start + i]
                if (inst_idx as i64) < f.insts.len:
                    f.insts.data[inst_idx].opcode = OP_NOP
                    f.insts.data[inst_idx].type_id = 0 as u16
                    f.insts.data[inst_idx].dest = 0 as u32
                    f.insts.data[inst_idx].src1 = 0 as u32
                    f.insts.data[inst_idx].src2 = 0 as u32
                i = i + 1 as u32
            blk.instrs_len = 0 as u32
            blk.succs_len = 0 as u32
            blk.preds_len = 0 as u32
        bi = bi + 1 as i64

    @free(reachable as ptr[u8])
    @free(queue as ptr[u8])
    return true

pub fn dce_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let use_count = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(use_count as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_NOP:
            i = i + 1 as i64
            continue

        // OP_SYSCALL shares OP_CALL's extras-based argument list; its arg vregs are
        // real uses. Without counting them, DCE deletes the instructions that compute
        // the syscall number / fd / buffer / length, so the inlined `syscall(...)`
        // executes with garbage registers (e.g. write(2) wrote nothing on Linux).
        if inst.opcode == OP_CALL or inst.opcode == OP_SYSCALL:
            let arg_start = inst.src2
            mut arg_count := 0 as u32
            if arg_start < f.extras.len as u32:
                arg_count = f.extras.data[arg_start]

            mut idx := 0 as u32
            while idx < arg_count:
                let arg_reg = f.extras.data[arg_start + 1 as u32 + idx]
                if arg_reg != 0 as u32:
                    use_count[arg_reg] = use_count[arg_reg] + 1 as u32
                idx = idx + 1 as u32
            // BUG (fn-ptr): an INDIRECT call carries its target in src1 (the vreg
            // holding the function address, e.g. from a local `let f = add`). It is
            // a real use — without counting it, DCE sees the OP_FUNC_ADDR def as
            // dead (no side effect) and deletes it, leaving the call target as
            // garbage -> crash at -O1. Direct calls have src1==0 (no-op here).
            // OP_SYSCALL's src1 is the dead `syscall` callee address — intentionally
            // NOT counted, so it stays eliminated (and never becomes an import).
            if inst.opcode == OP_CALL and inst.src1 != 0 as u32:
                use_count[inst.src1] = use_count[inst.src1] + 1 as u32
            i = i + 1 as i64
            continue

        if inst.opcode == OP_ICONST or inst.opcode == OP_FCONST or inst.opcode == OP_JUMP:
            i = i + 1 as i64
            continue

        if inst.opcode == OP_BRANCH:
            if inst.src1 != 0 as u32:
                use_count[inst.src1] = use_count[inst.src1] + 1 as u32
            i = i + 1 as i64
            continue

        if inst.dest != 0 as u32 and (inst.opcode == OP_STORE or inst.opcode == OP_SET_FIELD):
            use_count[inst.dest] = use_count[inst.dest] + 1 as u32

        if inst.src1 != 0 as u32:
            use_count[inst.src1] = use_count[inst.src1] + 1 as u32

        if inst.src2 != 0 as u32:
            use_count[inst.src2] = use_count[inst.src2] + 1 as u32

        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32:
            if not has_side_effect(inst.opcode):
                if use_count[inst.dest] == 0 as u32:
                    inst.opcode = OP_NOP
                    inst.type_id = 0 as u16
                    inst.dest = 0 as u32
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    changed = true
        i = i + 1 as i64

    @free(use_count as ptr[u8])

    if remove_unreachable_blocks(f):
        changed = true

    return changed

// Loop-Invariant Code Motion — RFC 0025 "model A" (sound on non-SSA AIR).
//
// RE-ENABLED in the -O2/-O3 pipeline (see SsaOptimizer.run). AIR is NON-SSA (a
// register may be reassigned inside a loop: an induction variable `i = i + 1`, an
// accumulator `acc = acc + i`). A naive LICM that hoists a definition and NOPs the
// in-loop copy is only valid under single-assignment, so on a multiply-defined
// register it moves/erases the wrong definition → the loop body reads a stale
// register → the compiled program crashes at run time. The previous naive pass hit
// exactly this (a plain `while i<N: acc=acc+i; i=i+1` sum loop segfaulted at run
// time). Model A closes that hole with three gates that make every hoist provably
// safe WITHOUT building SSA:
//
//   1. WHITELIST (is_hoistable_op): only pure, fault-free, register/immediate-
//      operand ALU ops (add/sub/mul, float add/sub/mul, compares, bitwise, neg/not).
//      EXCLUDES: constants (OP_ICONST/OP_FCONST — no compute benefit, and forcing a
//      const into a loop-crossing register only adds register pressure), all memory
//      ops (may fault — the address may be valid only inside the loop), div/mod
//      (trap on div-by-zero if the loop never runs), and everything with a side
//      effect (store/call/syscall). RFC 0025 D3 + empirical: including constants
//      previously reintroduced a segfault; excluding them is all-safety / no-loss.
//   2. SINGLE-DEF GATE: hoist a candidate only if its dest register is defined
//      EXACTLY ONCE in the whole function AND every register operand is defined
//      exactly once, OUTSIDE the loop. This is the non-SSA soundness key: a
//      single-def register cannot be the wrong definition, and def_block[reg] is
//      then unambiguous. Any induction/accumulator var is multiply-defined → never
//      hoisted (correct: it is not invariant anyway).
//   3. UNIQUE DOMINATING PRE-HEADER: hoist only into a loop header that has EXACTLY
//      ONE predecessor with lower loop_depth (all other preds are back-edges), which
//      makes that predecessor a true pre-header that dominates the header. If a
//      unique pre-header cannot be established, the loop is skipped (hoist nothing).
//
// The two crash fixes the naive pass needed are kept (they are shared by the sound
// strength_reduction/loop_unroll passes): insert_inst_at adjusts instrs_start by
// PHYSICAL layout position, and register-operand reads guard against ICONST/FCONST/
// JUMP/BRANCH immediate slots. Acceptance test (RFC 0025 §4): differential O0..O3 on
// the loop battery + a must-hoist positive oracle + building the compiler at -O2 and
// running the full regression on the -O2-built compiler (self-build is blind — it
// uses -O1, so LICM never runs during it).

// Pure, fault-free ALU ops whose operands are all registers/immediates. These are
// the ONLY ops model-A LICM will relocate (RFC 0025 D3). Deliberately excludes
// OP_ICONST/OP_FCONST (constants), OP_IDIV/OP_IMOD/OP_FDIV (trap), memory ops
// (LOAD/GET_FIELD/INDEX/... — may fault), casts/conversions (src2 may encode a
// width, not a register), and anything with a side effect.
pub fn is_hoistable_op(op: u16) -> bool:
    if op == OP_IADD or op == OP_ISUB or op == OP_IMUL:
        return true
    if op == OP_FADD or op == OP_FSUB or op == OP_FMUL:
        return true
    if op == OP_EQ or op == OP_NE or op == OP_LT or op == OP_LE or op == OP_GT or op == OP_GE:
        return true
    if op == OP_AND or op == OP_OR or op == OP_XOR or op == OP_SHL or op == OP_SHR:
        return true
    if op == OP_NEG or op == OP_NOT:
        return true
    // OP_COPY is deliberately not hoisted; instead copy_prop_func runs BEFORE LICM
    // (see SsaOptimizer.run) to collapse the copies a lowered invariant chain
    // `t1=a*b; t2=t1+c` leaves between its links. Once t2's operand is t1 directly,
    // LICM's within-pass chaining hoists the whole chain (after hoisting t1,
    // def_block[t1]=pre-header, so the direct-operand t2 is then invariant too).
    //
    // KNOWN LIMITATION (measured, not a bug): a chain link whose OPERAND vreg is
    // REUSED inside the loop does not hoist. Example: `t1=a*b; t2=t1+c` where AIR
    // reuses c's vreg for an unrelated loop temp → c has def_count==2 (one def at
    // loop depth) → the single-def gate conservatively (correctly) refuses to hoist
    // t2, since it cannot prove WHICH def of c reaches the use without reaching-
    // definitions. Non-reused chains DO fully hoist (verified). Closing this gap
    // needs reaching-defs / SSA — the model-B path RFC 0025 scopes as a separate
    // epic; refusing to hoist here is always sound.
    return false

// Fill preheader[b] with the pre-header block id for every loop-body block b whose
// INNERMOST loop has a unique dominating pre-header, else 0xffffffff. A natural loop
// is identified by a back-edge b->h (h a successor of b, h's block id <= b's). Its
// header h has a unique pre-header iff exactly one pred of h has loop_depth < h's;
// that pred then dominates h (every other pred is a back-edge, only reachable after
// h). Membership is the classic backward walk from the back-edge source, stopping at
// the header. Only blocks whose own loop_depth equals the header's are assigned here
// (their innermost loop is this one); blocks in a nested inner loop have a higher
// depth and are assigned when that inner loop's back-edge is processed. Deterministic
// (fixed block/succ/pred iteration order).
pub fn compute_loop_preheaders(f: ptr[AirFunc], preheader: ptr[u32]):
    let nblocks = f.blocks.len
    if nblocks == 0 as i64:
        return
    let in_loop = @alloc(nblocks) as ptr[bool]
    let queue = @alloc(nblocks * 4 as i64) as ptr[u32]

    mut b := 0 as u32
    while b < nblocks as u32:
        let blk = f.blocks.data[b]
        mut si := 0 as u32
        while si < blk.succs_len:
            let h = f.block_succs.data[blk.succs_start + si]
            if h <= b and h < nblocks as u32:
                let hd = f.blocks.data[h].loop_depth
                // unique pre-header of h = the sole pred with lower loop_depth
                mut ph := 0xffffffff as u32
                mut nph := 0 as i64
                mut pi := 0 as u32
                while pi < f.blocks.data[h].preds_len:
                    let p = f.block_preds.data[f.blocks.data[h].preds_start + pi]
                    if p < nblocks as u32:
                        if f.blocks.data[p].loop_depth < hd:
                            ph = p
                            nph = nph + 1 as i64
                    pi = pi + 1 as u32

                if nph == 1 as i64:
                    // membership: {h} U preds*(b) not crossing h
                    @memset(in_loop as ptr[void], 0 as u8, nblocks)
                    in_loop[h] = true
                    in_loop[b] = true
                    mut head := 0 as i64
                    mut tail := 0 as i64
                    if h != b:
                        queue[tail] = b
                        tail = tail + 1 as i64
                    while head < tail:
                        let curr = queue[head]
                        head = head + 1 as i64
                        let curr_blk = f.blocks.data[curr]
                        mut ppi := 0 as u32
                        while ppi < curr_blk.preds_len:
                            let pred = f.block_preds.data[curr_blk.preds_start + ppi]
                            if pred < nblocks as u32:
                                if not in_loop[pred]:
                                    in_loop[pred] = true
                                    queue[tail] = pred
                                    tail = tail + 1 as i64
                            ppi = ppi + 1 as u32
                    // assign pre-header to member blocks at the header's depth
                    mut i := 0 as i64
                    while i < nblocks:
                        if in_loop[i] and f.blocks.data[i].loop_depth == hd:
                            preheader[i] = ph
                        i = i + 1 as i64
            si = si + 1 as u32
        b = b + 1 as u32

    @free(in_loop as ptr[u8])
    @free(queue as ptr[u8])

pub fn licm_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let n = max_reg as i64 + 1 as i64
    // per-register def COUNT (single-def gate) + the block of its (last) def.
    let def_count = @alloc(n * 4 as i64) as ptr[u32]
    @memset(def_count as ptr[void], 0 as u8, n * 4 as i64)
    let def_block = @alloc(n * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, n * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_count[inst.dest] = def_count[inst.dest] + 1 as u32
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    // per-block -> unique dominating pre-header (0xffffffff if none)
    let preheader = @alloc(f.blocks.len * 4 as i64) as ptr[u32]
    @memset(preheader as ptr[void], 0xff as u8, f.blocks.len * 4 as i64)
    compute_loop_preheaders(f, preheader)

    mut changed := false

    bi = 0 as i64
    while bi < f.blocks.len:
        // Fresh re-reads of block/inst fields on every use: a hoist calls
        // insert_inst_at, which may REALLOCATE f.insts.data and shifts instrs_start
        // of physically-later blocks — a captured ptr[AirInst]/AirBlock would be
        // stale (this segfaulted the naive pass at -O2/-O3 on any loop).
        let ph = preheader[bi]
        if ph != 0xffffffff as u32:
            let cur_depth = f.blocks.data[bi].loop_depth
            mut inst_i := 0 as u32
            while inst_i < f.blocks.data[bi].instrs_len:
                let inst_idx = f.block_instrs.data[f.blocks.data[bi].instrs_start + inst_i]
                let op = f.insts.data[inst_idx].opcode
                let ty = f.insts.data[inst_idx].type_id
                let dst = f.insts.data[inst_idx].dest
                let s1 = f.insts.data[inst_idx].src1
                let s2 = f.insts.data[inst_idx].src2

                // Gate 1: whitelist. Gate 2a: dest single-def.
                if is_hoistable_op(op) and dst != 0 as u32 and dst <= max_reg and def_count[dst] == 1 as u32:
                    // Gate 2b: every register operand single-def AND defined outside
                    // the loop. For whitelisted ops src1/src2 are always registers
                    // (or 0 for the unused slot of a unary op).
                    mut ok := true
                    if s1 != 0 as u32:
                        if s1 > max_reg or def_count[s1] != 1 as u32:
                            ok = false
                        else:
                            let db = def_block[s1]
                            if db == 0xffffffff as u32 or f.blocks.data[db].loop_depth >= cur_depth:
                                ok = false
                    if ok and s2 != 0 as u32:
                        if s2 > max_reg or def_count[s2] != 1 as u32:
                            ok = false
                        else:
                            let db = def_block[s2]
                            if db == 0xffffffff as u32 or f.blocks.data[db].loop_depth >= cur_depth:
                                ok = false

                    if ok:
                        // Insert BEFORE the pre-header's terminator (appending after
                        // the jump into the loop would be dead code / undefined dest).
                        mut pos := f.blocks.data[ph].instrs_len
                        if pos > 0 as u32:
                            let last_idx = f.block_instrs.data[f.blocks.data[ph].instrs_start + (pos - 1 as u32)]
                            let last_op = f.insts.data[last_idx].opcode
                            if last_op == OP_JUMP or last_op == OP_BRANCH or last_op == OP_RETURN:
                                pos = pos - 1 as u32

                        insert_inst_at(f, ph, pos, AirInst(
                            opcode: op,
                            type_id: ty,
                            dest: dst,
                            src1: s1,
                            src2: s2
                        ))

                        // The value is now defined in the pre-header (still exactly
                        // one def). A dependent invariant later in the same block sees
                        // this and becomes hoistable too (single-pass chaining).
                        def_block[dst] = ph

                        // NOP the original in place, addressed by index (the insert
                        // may have reallocated f.insts.data).
                        f.insts.data[inst_idx].opcode = OP_NOP
                        f.insts.data[inst_idx].type_id = 0 as u16
                        f.insts.data[inst_idx].dest = 0 as u32
                        f.insts.data[inst_idx].src1 = 0 as u32
                        f.insts.data[inst_idx].src2 = 0 as u32

                        changed = true
                inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    @free(def_count as ptr[u8])
    @free(def_block as ptr[u8])
    @free(preheader as ptr[u8])
    return changed

pub fn insert_inst_at(f: ptr[AirFunc], block_id: u32, pos_in_block: u32, inst: AirInst) -> u32:
    let new_inst_idx = f.insts.push(inst)
    let blk = &f.blocks.data[block_id]
    let insert_pos = blk.instrs_start + pos_in_block

    f.block_instrs.push(0 as u32)
    mut shift_i := f.block_instrs.len - 1 as i64
    while shift_i > insert_pos as i64:
        f.block_instrs.data[shift_i] = f.block_instrs.data[shift_i - 1 as i64]
        shift_i = shift_i - 1 as i64
    f.block_instrs.data[insert_pos] = new_inst_idx
    blk.instrs_len = blk.instrs_len + 1 as u32

    // Bump instrs_start for every OTHER block whose region is PHYSICALLY at or
    // after the insertion point. `block_instrs` is a flat array laid out in
    // physical (instrs_start) order, which is NOT necessarily block-index order —
    // an optimizer may make a loop's pre-header (lower instrs_start) have a HIGHER
    // block index than the loop body (e.g. LICM hoisting into `pre_header_id > bi`).
    // The old `index > block_id` adjustment then failed to shift a physically-later
    // block that happened to have a lower index, corrupting its instruction window
    // (duplicate/garbage indices → out-of-bounds read → compiler SEGV at -O2/-O3).
    // Comparing physical positions is correct regardless of index ordering.
    mut adjust_bi := 0 as i64
    while adjust_bi < f.blocks.len:
        if adjust_bi != block_id as i64:
            if f.blocks.data[adjust_bi].instrs_start >= insert_pos:
                f.blocks.data[adjust_bi].instrs_start = f.blocks.data[adjust_bi].instrs_start + 1 as u32
        adjust_bi = adjust_bi + 1 as i64
    return new_inst_idx

pub fn compute_loop_depths(f: ptr[AirFunc]) -> bool:
    mut bi := 0 as i64
    while bi < f.blocks.len:
        f.blocks.data[bi].loop_depth = 0 as u8
        bi = bi + 1 as i64

    mut changed := false
    let in_loop = @alloc(f.blocks.len) as ptr[bool]
    let queue = @alloc(f.blocks.len * 4 as i64) as ptr[u32]

    mut b := 0 as u32
    while b < f.blocks.len as u32:
        let blk = f.blocks.data[b]
        mut succ_i := 0 as u32
        while succ_i < blk.succs_len:
            let h = f.block_succs.data[blk.succs_start + succ_i]
            if h <= b and h < f.blocks.len as u32:
                @memset(in_loop as ptr[void], 0 as u8, f.blocks.len)
                in_loop[h] = true
                in_loop[b] = true

                mut head := 0 as i64
                mut tail := 0 as i64
                
                if h != b:
                    queue[tail] = b
                    tail = tail + 1 as i64

                while head < tail:
                    let curr = queue[head]
                    head = head + 1 as i64

                    let curr_blk = f.blocks.data[curr]
                    mut pred_i := 0 as u32
                    while pred_i < curr_blk.preds_len:
                        let pred = f.block_preds.data[curr_blk.preds_start + pred_i]
                        if pred < f.blocks.len as u32:
                            if not in_loop[pred]:
                                in_loop[pred] = true
                                queue[tail] = pred
                                tail = tail + 1 as i64
                        pred_i = pred_i + 1 as u32

                mut i := 0 as i64
                while i < f.blocks.len:
                    if in_loop[i]:
                        let old_depth = f.blocks.data[i].loop_depth
                        if old_depth < 255 as u8:
                            f.blocks.data[i].loop_depth = old_depth + 1 as u8
                            changed = true
                    i = i + 1 as i64
            succ_i = succ_i + 1 as u32
        b = b + 1 as u32

    @free(in_loop as ptr[u8])
    @free(queue as ptr[u8])
    return changed

pub fn strength_reduction_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_block = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    mut changed := false
    mut next_reg := max_reg + 1 as u32

    bi = 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        if blk.loop_depth > 0 as u8:
            mut pre_header_id := 0xffffffff as u32
            mut pred_i := 0 as u32
            while pred_i < blk.preds_len:
                let pred = f.block_preds.data[blk.preds_start + pred_i]
                if pred < f.blocks.len as u32:
                    if f.blocks.data[pred].loop_depth < blk.loop_depth:
                        pre_header_id = pred
                        break
                pred_i = pred_i + 1 as u32

            if pre_header_id != 0xffffffff as u32:
                mut iv_reg := 0 as u32
                mut step_val := 0 as u32
                mut step_reg := 0 as u32
                mut is_add := true

                mut inst_i := 0 as u32
                while inst_i < blk.instrs_len:
                    let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
                    let inst = f.insts.data[inst_idx]
                    if inst.opcode == OP_COPY and inst.dest != 0 as u32:
                        let src = inst.src1
                        let src_def_idx = f.block_instrs.data[blk.instrs_start + inst_i - 1 as u32]
                        let src_def = f.insts.data[src_def_idx]
                        if src_def.dest == src and (src_def.opcode == OP_IADD or src_def.opcode == OP_ISUB):
                            if src_def.src1 == inst.dest:
                                iv_reg = inst.dest
                                step_reg = src_def.src2
                                is_add = (src_def.opcode == OP_IADD)
                                break
                            elif src_def.src2 == inst.dest and src_def.opcode == OP_IADD:
                                iv_reg = inst.dest
                                step_reg = src_def.src1
                                is_add = true
                                break
                    inst_i = inst_i + 1 as u32

                if iv_reg != 0 as u32:
                    inst_i = 0 as u32
                    while inst_i < blk.instrs_len:
                        let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
                        mut inst := &f.insts.data[inst_idx]
                        if inst.opcode == OP_IMUL and inst.dest != 0 as u32:
                            mut c_reg := 0 as u32
                            if inst.src1 == iv_reg:
                                c_reg = inst.src2
                            elif inst.src2 == iv_reg:
                                c_reg = inst.src1
                            
                            if c_reg != 0 as u32:
                                mut is_invariant := false
                                let c_def_b = def_block[c_reg]
                                if c_def_b == 0xffffffff as u32:
                                    is_invariant = true
                                else:
                                    if f.blocks.data[c_def_b].loop_depth < blk.loop_depth:
                                        is_invariant = true
                                        
                                if is_invariant:
                                    mut start_reg := 0 as u32
                                    let ph_blk = f.blocks.data[pre_header_id]
                                    mut ph_inst_i := 0 as u32
                                    while ph_inst_i < ph_blk.instrs_len:
                                        let ph_inst_idx = f.block_instrs.data[ph_blk.instrs_start + ph_inst_i]
                                        let ph_inst = f.insts.data[ph_inst_idx]
                                        if (ph_inst.opcode == OP_COPY or ph_inst.opcode == OP_MOVE) and ph_inst.dest == iv_reg:
                                            start_reg = ph_inst.src1
                                            break
                                        elif ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                            start_reg = iv_reg
                                            break
                                        ph_inst_i = ph_inst_i + 1 as u32
                                        
                                    if start_reg != 0 as u32:
                                        let acc_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        mut init_inst := AirInst(
                                            opcode: OP_IMUL,
                                            type_id: inst.type_id,
                                            dest: acc_reg,
                                            src1: start_reg,
                                            src2: c_reg
                                        )
                                        if start_reg == iv_reg:
                                            mut iv_const_val := 0 as u32
                                            let ph_blk2 = f.blocks.data[pre_header_id]
                                            mut ph_inst_i2 := 0 as u32
                                            while ph_inst_i2 < ph_blk2.instrs_len:
                                                let ph_inst_idx = f.block_instrs.data[ph_blk2.instrs_start + ph_inst_i2]
                                                let ph_inst = f.insts.data[ph_inst_idx]
                                                if ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                                    iv_const_val = ph_inst.src1
                                                    break
                                                ph_inst_i2 = ph_inst_i2 + 1 as u32
                                            let temp_start_reg = next_reg
                                            next_reg = next_reg + 1 as u32
                                            insert_inst_at(f, pre_header_id, ph_blk2.instrs_len - 1 as u32, AirInst(
                                                opcode: OP_ICONST,
                                                type_id: inst.type_id,
                                                dest: temp_start_reg,
                                                src1: iv_const_val,
                                                src2: 0 as u32
                                            ))
                                            init_inst.src1 = temp_start_reg
                                        
                                        insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, init_inst)
                                        
                                        inst.opcode = OP_COPY
                                        inst.src1 = acc_reg
                                        inst.src2 = 0 as u32
                                        
                                        let step_mul_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        let new_acc_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        mut copy_pos := 0 as u32
                                        mut loop_inst_i := 0 as u32
                                        while loop_inst_i < blk.instrs_len:
                                            let loop_inst_idx = f.block_instrs.data[blk.instrs_start + loop_inst_i]
                                            let loop_inst = f.insts.data[loop_inst_idx]
                                            if loop_inst.opcode == OP_COPY and loop_inst.dest == iv_reg:
                                                copy_pos = loop_inst_i + 1 as u32
                                                break
                                            loop_inst_i = loop_inst_i + 1 as u32
                                            
                                        if copy_pos != 0 as u32:
                                            insert_inst_at(f, bi as u32, copy_pos, AirInst(
                                                opcode: OP_IMUL,
                                                type_id: inst.type_id,
                                                dest: step_mul_reg,
                                                src1: step_reg,
                                                src2: c_reg
                                            ))
                                            
                                            mut add_op := OP_IADD as u16
                                            if not is_add:
                                                add_op = OP_ISUB
                                                
                                            insert_inst_at(f, bi as u32, copy_pos + 1 as u32, AirInst(
                                                opcode: add_op,
                                                type_id: inst.type_id,
                                                dest: new_acc_reg,
                                                src1: acc_reg,
                                                src2: step_mul_reg
                                            ))
                                            
                                            insert_inst_at(f, bi as u32, copy_pos + 2 as u32, AirInst(
                                                opcode: OP_COPY,
                                                type_id: inst.type_id,
                                                dest: acc_reg,
                                                src1: new_acc_reg,
                                                src2: 0 as u32
                                            ))
                                            
                                            changed = true
                        inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    @free(def_block as ptr[u8])
    return changed

pub fn loop_unroll_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_block = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_ICONST and inst.dest != 0 as u32:
            let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
            vals[inst.dest] = ConstVal(known: true, val: full_val)
        i = i + 1 as i64

    mut changed := false
    mut next_reg := max_reg + 1 as u32

    bi = 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        if blk.loop_depth > 0 as u8:
            // UNIQUE dominating pre-header only (RFC 0025): exactly one predecessor
            // with lower loop_depth (all others are back-edges), and the header has
            // exactly two predecessors (pre-header + single back-edge). This is the
            // simple natural loop the single-block clone can reproduce; anything else
            // (multiple entries, irreducible, non-unique pre-header) is skipped.
            mut pre_header_id := 0xffffffff as u32
            mut ph_count := 0 as i64
            mut pred_i := 0 as u32
            while pred_i < blk.preds_len:
                let pred = f.block_preds.data[blk.preds_start + pred_i]
                if pred < f.blocks.len as u32:
                    if f.blocks.data[pred].loop_depth < blk.loop_depth:
                        pre_header_id = pred
                        ph_count = ph_count + 1 as i64
                pred_i = pred_i + 1 as u32

            if pre_header_id != 0xffffffff as u32 and ph_count == 1 as i64 and blk.preds_len == 2 as u32:
                mut cond_inst_idx := 0xffffffff as u32
                mut loop_body_block_id := 0xffffffff as u32
                mut exit_block_id := 0xffffffff as u32

                if blk.instrs_len > 0 as u32:
                    let final_inst_idx = f.block_instrs.data[blk.instrs_start + blk.instrs_len - 1 as u32]
                    let final_inst = f.insts.data[final_inst_idx]
                    if final_inst.opcode == OP_BRANCH:
                        cond_inst_idx = final_inst_idx
                        exit_block_id = final_inst.dest
                        loop_body_block_id = final_inst.src2

                if cond_inst_idx != 0xffffffff as u32 and loop_body_block_id < f.blocks.len as u32 and loop_body_block_id != bi as u32:
                    let cond_inst = f.insts.data[cond_inst_idx]
                    mut cmp_inst_idx := 0xffffffff as u32
                    mut inst_idx_i := blk.instrs_start
                    while inst_idx_i < blk.instrs_start + blk.instrs_len:
                        let idx = f.block_instrs.data[inst_idx_i]
                        let inst = f.insts.data[idx]
                        if inst.dest == cond_inst.src1 and (inst.opcode == OP_LT or inst.opcode == OP_LE):
                            cmp_inst_idx = idx
                            break
                        inst_idx_i = inst_idx_i + 1 as u32

                    if cmp_inst_idx != 0xffffffff as u32:
                        let cmp_inst = f.insts.data[cmp_inst_idx]
                        let iv_reg = cmp_inst.src1
                        let limit_reg = cmp_inst.src2

                        let limit_val_const = vals[limit_reg]
                        if limit_val_const.known:
                            let limit_val = limit_val_const.val
                            mut start_reg := 0 as u32
                            let ph_blk = f.blocks.data[pre_header_id]
                            mut ph_inst_i := 0 as u32
                            while ph_inst_i < ph_blk.instrs_len:
                                let ph_inst_idx = f.block_instrs.data[ph_blk.instrs_start + ph_inst_i]
                                let ph_inst = f.insts.data[ph_inst_idx]
                                if (ph_inst.opcode == OP_COPY or ph_inst.opcode == OP_MOVE) and ph_inst.dest == iv_reg:
                                    start_reg = ph_inst.src1
                                    break
                                elif ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                    start_reg = iv_reg
                                    break
                                ph_inst_i = ph_inst_i + 1 as u32

                            if start_reg != 0 as u32:
                                mut start_val := 0 as u64
                                mut start_known := false
                                if start_reg == iv_reg:
                                    let ph_blk2 = f.blocks.data[pre_header_id]
                                    mut ph_inst_i2 := 0 as u32
                                    while ph_inst_i2 < ph_blk2.instrs_len:
                                        let ph_inst_idx = f.block_instrs.data[ph_blk2.instrs_start + ph_inst_i2]
                                        let ph_inst = f.insts.data[ph_inst_idx]
                                        if ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                            start_val = ((ph_inst.src2 as u64) << 32 as u64) | (ph_inst.src1 as u64)
                                            start_known = true
                                            break
                                        ph_inst_i2 = ph_inst_i2 + 1 as u32
                                else:
                                    let start_val_const = vals[start_reg]
                                    if start_val_const.known:
                                        start_val = start_val_const.val
                                        start_known = true

                                if start_known:
                                    mut step_val := 1 as u32
                                    let body_blk = f.blocks.data[loop_body_block_id]
                                    mut body_inst_i := 0 as u32
                                    while body_inst_i < body_blk.instrs_len:
                                        let b_inst_idx = f.block_instrs.data[body_blk.instrs_start + body_inst_i]
                                        let b_inst = f.insts.data[b_inst_idx]
                                        if b_inst.opcode == OP_IADD and (b_inst.src1 == iv_reg or b_inst.src2 == iv_reg):
                                            mut step_reg := b_inst.src2
                                            if b_inst.src2 == iv_reg:
                                                step_reg = b_inst.src1
                                            let step_val_const = vals[step_reg]
                                            if step_val_const.known:
                                                step_val = step_val_const.val as u32
                                                break
                                        body_inst_i = body_inst_i + 1 as u32

                                    let cmp_op = cmp_inst.opcode
                                    mut trip_count := 0 as u32
                                    if cmp_op == OP_LT:
                                        if limit_val > start_val and step_val > 0 as u32:
                                            trip_count = ((limit_val - start_val) / (step_val as u64)) as u32
                                    elif cmp_op == OP_LE:
                                        if limit_val >= start_val and step_val > 0 as u32:
                                            trip_count = ((limit_val - start_val) / (step_val as u64) + 1 as u64) as u32

                                    // SAFETY GATE (RFC 0025 / bug-o2-large-code): only
                                    // unroll a SINGLE-BLOCK body that jumps straight back
                                    // to the header, with NO nested control flow, calls,
                                    // side effects, or memory ops the single-block clone
                                    // cannot faithfully reproduce. (a) body's only
                                    // successor is the header; (b) no BRANCH (nested if),
                                    // CALL/SPAWN/SEND/SYSCALL (clobbers/effects), STORE/
                                    // SET_FIELD/FREE/DESTROY (memory effects the clone
                                    // would duplicate/misorder), or LOAD/INDEX/GET_FIELD
                                    // (may alias the mutated memory). Bail on anything not
                                    // provably a pure-register straight-line body.
                                    mut body_ok := true
                                    if body_blk.succs_len != 1 as u32:
                                        body_ok = false
                                    elif f.block_succs.data[body_blk.succs_start] != bi as u32:
                                        body_ok = false
                                    mut bchk := 0 as u32
                                    while body_ok and bchk < body_blk.instrs_len:
                                        let bi_idx = f.block_instrs.data[body_blk.instrs_start + bchk]
                                        let bop = f.insts.data[bi_idx].opcode
                                        if bop == OP_BRANCH or bop == OP_CALL or bop == OP_SPAWN or bop == OP_SEND or bop == OP_SYSCALL or bop == OP_RECV or bop == OP_AWAIT:
                                            body_ok = false
                                        elif bop == OP_STORE or bop == OP_SET_FIELD or bop == OP_FREE or bop == OP_DESTROY or bop == OP_ALIAS_REUSE:
                                            body_ok = false
                                        elif bop == OP_LOAD or bop == OP_INDEX or bop == OP_GET_FIELD or bop == OP_INDEX_ADDR or bop == OP_FIELD_ADDR or bop == OP_GLOBAL_ADDR or bop == OP_ALLOC:
                                            body_ok = false
                                        bchk = bchk + 1 as u32

                                    if body_ok and trip_count > 0 as u32 and trip_count <= 4 as u32:
                                        // SOUND full unroll on non-SSA AIR. `cur[r]` = the
                                        // register currently holding original reg r's value.
                                        // Initialised to identity and PERSISTED across
                                        // iterations, so a loop-carried value (an
                                        // accumulator `acc = acc + iv`) is threaded: each
                                        // iteration reads cur[acc] (the previous iteration's
                                        // fresh result) and writes a new cur[acc]. The old
                                        // pass reset the map every iteration, so iteration k
                                        // read the ORIGINAL acc (and even read its own fresh
                                        // dest before defining it) → the miscompile that
                                        // segfaulted a -O2-built compiler.
                                        let cur = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
                                        mut ci := 0 as u32
                                        while ci <= max_reg:
                                            cur[ci] = ci
                                            ci = ci + 1 as u32

                                        mut iter := 0 as u32
                                        while iter < trip_count:
                                            let curr_iv_val = start_val + (iter as u64) * (step_val as u64)
                                            let temp_iv_reg = next_reg
                                            next_reg = next_reg + 1 as u32
                                            insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                opcode: OP_ICONST,
                                                type_id: 3 as u32,
                                                dest: temp_iv_reg,
                                                src1: (curr_iv_val & 0xFFFFFFFF as u64) as u32,
                                                src2: ((curr_iv_val >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                                            ))

                                            mut body_inst_i2 := 0 as u32
                                            while body_inst_i2 < body_blk.instrs_len:
                                                let b_inst_idx = f.block_instrs.data[body_blk.instrs_start + body_inst_i2]
                                                let b_inst = f.insts.data[b_inst_idx]
                                                if b_inst.opcode == OP_JUMP or b_inst.opcode == OP_BRANCH or b_inst.opcode == OP_NOP:
                                                    body_inst_i2 = body_inst_i2 + 1 as u32
                                                    continue

                                                // Read operands THROUGH cur[] (iv → this
                                                // iteration's const). ICONST/FCONST pack
                                                // immediates in src1/src2 — never remap them.
                                                mut src1 := b_inst.src1
                                                if b_inst.opcode != OP_ICONST and b_inst.opcode != OP_FCONST:
                                                    if src1 == iv_reg:
                                                        src1 = temp_iv_reg
                                                    elif src1 != 0 as u32 and src1 <= max_reg:
                                                        src1 = cur[src1]

                                                mut src2 := b_inst.src2
                                                if b_inst.opcode != OP_ICONST and b_inst.opcode != OP_FCONST and b_inst.opcode != OP_BRANCH:
                                                    if src2 == iv_reg:
                                                        src2 = temp_iv_reg
                                                    elif src2 != 0 as u32 and src2 <= max_reg:
                                                        src2 = cur[src2]

                                                // Fresh dest, then publish it to cur AFTER
                                                // the reads above (so this instruction's own
                                                // sources still saw the prior value).
                                                mut dest := b_inst.dest
                                                if b_inst.dest != 0 as u32 and b_inst.dest != iv_reg:
                                                    dest = next_reg
                                                    next_reg = next_reg + 1 as u32

                                                insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                    opcode: b_inst.opcode,
                                                    type_id: b_inst.type_id,
                                                    dest: dest,
                                                    src1: src1,
                                                    src2: src2
                                                ))
                                                if b_inst.dest != 0 as u32 and b_inst.dest != iv_reg and b_inst.dest <= max_reg:
                                                    cur[b_inst.dest] = dest
                                                body_inst_i2 = body_inst_i2 + 1 as u32
                                            iter = iter + 1 as u32

                                        // Copy each body-defined register's FINAL value back
                                        // to its original name, so any post-loop read of it
                                        // sees the unrolled result. Over-copying a dead temp
                                        // is harmless (DCE removes it). Then set the induction
                                        // variable to its post-loop value (start + trip*step),
                                        // the value it holds when the original loop exits.
                                        mut cb := 0 as u32
                                        while cb < body_blk.instrs_len:
                                            let cb_idx = f.block_instrs.data[body_blk.instrs_start + cb]
                                            let cb_inst = f.insts.data[cb_idx]
                                            let od = cb_inst.dest
                                            if cb_inst.opcode != OP_NOP and od != 0 as u32 and od != iv_reg and od <= max_reg:
                                                if cur[od] != od:
                                                    insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                        opcode: OP_COPY,
                                                        type_id: cb_inst.type_id,
                                                        dest: od,
                                                        src1: cur[od],
                                                        src2: 0 as u32
                                                    ))
                                                    cur[od] = od
                                            cb = cb + 1 as u32

                                        let final_iv_val = start_val + (trip_count as u64) * (step_val as u64)
                                        insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                            opcode: OP_ICONST,
                                            type_id: 3 as u32,
                                            dest: iv_reg,
                                            src1: (final_iv_val & 0xFFFFFFFF as u64) as u32,
                                            src2: ((final_iv_val >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                                        ))

                                        @free(cur as ptr[u8])

                                        let ph_blk3 = &f.blocks.data[pre_header_id]
                                        let ph_final_idx = f.block_instrs.data[ph_blk3.instrs_start + ph_blk3.instrs_len - 1 as u32]
                                        mut ph_final := &f.insts.data[ph_final_idx]
                                        ph_final.opcode = OP_JUMP
                                        ph_final.src1 = exit_block_id
                                        ph_final.src2 = 0 as u32

                                        f.block_succs.data[ph_blk3.succs_start] = exit_block_id
                                        ph_blk3.succs_len = 1 as u32

                                        changed = true
                                        break
        bi = bi + 1 as i64

    @free(def_block as ptr[u8])
    @free(vals as ptr[u8])
    return changed

// Algebraic simplification pass:
// Handles identity operations (x+0, x*1, x/1), zero annihilation (x*0),
// self-ops (x-x=0, x^x=0, x&x=x), comparison tautologies (x==x→1),
// and constant branch folding (branch(const)→jump).
pub fn alg_simp_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32 and inst.opcode != OP_BRANCH:
            def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32
    let addr_taken = mark_addr_taken_regs(f, max_reg)
    i = 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_ICONST and inst.dest != 0 as u32:
            if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
                vals[inst.dest] = ConstVal(known: true, val: full_val)
        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]

        if inst.opcode == OP_IADD:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 0 as u64:
                    // x + 0 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                else:
                    let v1 = vals[inst.src1]
                    if v1.known and v1.val == 0 as u64:
                        // 0 + x = x
                        inst.opcode = OP_COPY
                        inst.src1 = inst.src2
                        inst.src2 = 0 as u32
                        changed = true

        elif inst.opcode == OP_ISUB:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x - x = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true
                else:
                    let v2 = vals[inst.src2]
                    if v2.known and v2.val == 0 as u64:
                        // x - 0 = x
                        inst.opcode = OP_COPY
                        inst.src2 = 0 as u32
                        changed = true

        elif inst.opcode == OP_IMUL:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                let v1 = vals[inst.src1]
                let v2 = vals[inst.src2]
                if (v2.known and v2.val == 0 as u64) or (v1.known and v1.val == 0 as u64):
                    // x * 0 = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true
                elif v2.known and v2.val == 1 as u64:
                    // x * 1 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                elif v1.known and v1.val == 1 as u64:
                    // 1 * x = x
                    inst.opcode = OP_COPY
                    inst.src1 = inst.src2
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_IDIV:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 1 as u64:
                    // x / 1 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_IMOD:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 1 as u64:
                    // x % 1 = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true

        elif inst.opcode == OP_AND:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x & x = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                else:
                    let v1 = vals[inst.src1]
                    let v2 = vals[inst.src2]
                    if (v1.known and v1.val == 0 as u64) or (v2.known and v2.val == 0 as u64):
                        // x & 0 = 0
                        inst.opcode = OP_ICONST
                        inst.src1 = 0 as u32
                        inst.src2 = 0 as u32
                        if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                            vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                        changed = true

        elif inst.opcode == OP_OR:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x | x = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_XOR:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x ^ x = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true

        elif inst.opcode == OP_SHL or inst.opcode == OP_SHR:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 0 as u64:
                    // x << 0 = x, x >> 0 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_EQ:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x == x = true
                inst.opcode = OP_ICONST
                inst.src1 = 1 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 1 as u64)
                changed = true

        elif inst.opcode == OP_NE:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x != x = false
                inst.opcode = OP_ICONST
                inst.src1 = 0 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                changed = true

        elif inst.opcode == OP_LT or inst.opcode == OP_GT:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x < x = false, x > x = false
                inst.opcode = OP_ICONST
                inst.src1 = 0 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                changed = true

        elif inst.opcode == OP_LE or inst.opcode == OP_GE:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x <= x = true, x >= x = true
                inst.opcode = OP_ICONST
                inst.src1 = 1 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 1 as u64)
                changed = true

        elif inst.opcode == OP_BRANCH:
            // Constant branch folding: branch(known_const) -> jump
            if inst.src1 != 0 as u32:
                let cond_val = vals[inst.src1]
                if cond_val.known:
                    let true_blk = inst.src2
                    let false_blk = inst.dest
                    if cond_val.val != 0 as u64:
                        inst.opcode = OP_JUMP
                        inst.src1 = true_blk
                        inst.src2 = 0 as u32
                        inst.dest = 0 as u32
                    else:
                        inst.opcode = OP_JUMP
                        inst.src1 = false_blk
                        inst.src2 = 0 as u32
                        inst.dest = 0 as u32
                    changed = true

        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(vals as ptr[u8])
    @free(addr_taken as ptr[u8])
    return changed

// Per-basic-block Common Subexpression Elimination:
// Within each block, finds duplicate pure computations and replaces later
// occurrences with COPY of the first result, enabling DCE to remove the redundant
// computation.
pub fn cse_func(f: ptr[AirFunc]) -> bool:
    mut changed := false

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]

        mut i := 0 as u32
        while i < blk.instrs_len:
            let inst_idx_i = f.block_instrs.data[blk.instrs_start + i]
            let inst_i = f.insts.data[inst_idx_i]

            if inst_i.opcode == OP_NOP or inst_i.dest == 0 as u32 or has_side_effect(inst_i.opcode):
                i = i + 1 as u32
                continue
            if inst_i.opcode == OP_ICONST or inst_i.opcode == OP_FCONST:
                i = i + 1 as u32
                continue
            if not opcode_is_binary_alu(inst_i.opcode) and inst_i.opcode != OP_NEG and inst_i.opcode != OP_NOT:
                i = i + 1 as u32
                continue

            // Scan earlier instructions in this block for an identical
            // expression. CSE keys on (opcode, src1, src2) — sound ONLY while
            // neither source operand is redefined between the two instructions.
            // AIR is not strict SSA (a mutable local reuses one register), so
            // `b = b * b; b = b * b` lowers to `t1 = MUL b,b; b = COPY t1;
            // t2 = MUL b,b; b = COPY t2` — the two MULs look identical but the
            // second must recompute against the reassigned `b`. Scan DOWNWARD
            // from i and STOP at the first instruction that redefines src1 or
            // src2: any match beyond it would reuse a stale value (the silent
            // -O1 miscompile: second squaring became a no-op).
            mut j := (i as i64) - 1 as i64
            while j >= 0 as i64:
                let inst_idx_j = f.block_instrs.data[blk.instrs_start + (j as u32)]
                let inst_j = f.insts.data[inst_idx_j]
                // A redefinition of either source invalidates all earlier
                // candidates (check BEFORE matching so a self-referential
                // `b = <op> b` that redefines its own source is not reused).
                if inst_j.dest != 0 as u32 and (inst_j.dest == inst_i.src1 or inst_j.dest == inst_i.src2):
                    break
                if inst_j.opcode == inst_i.opcode and inst_j.src1 == inst_i.src1 and inst_j.src2 == inst_i.src2 and inst_j.dest != 0 as u32 and inst_j.opcode != OP_NOP:
                    mut cur_inst := &f.insts.data[inst_idx_i]
                    cur_inst.opcode = OP_COPY
                    cur_inst.src1 = inst_j.dest
                    cur_inst.src2 = 0 as u32
                    changed = true
                    break
                j = j - 1 as i64
            i = i + 1 as u32

        bi = bi + 1 as i64

    return changed

// Functions exceeding this instruction count skip expensive O(n²) and
// structural passes (CSE, LICM, strength reduction, loop unrolling) to
// avoid blowing compilation time on giant switch-dispatch functions.
pub const OPT_LARGE_FUNC_THRESHOLD: i64 = 2000

pub fn run(mut self: SsaOptimizer, mut m: ptr[AirModule]):
    mut fi := 0 as i64
    while fi < m.funcs.len:
        mut f := &m.funcs.data[fi]
        if not f.is_extern:
            let is_large = f.insts.len > OPT_LARGE_FUNC_THRESHOLD

            // Structural passes: run once before iterative value passes.
            // LICM/strength-reduction/unrolling expose new constants that
            // the iterative loop below will clean up.
            if self.level >= 2 as u8 and not is_large:
                // Collapse copies BEFORE LICM so an invariant chain fully hoists. A
                // lowered `t1=a*b; t2=t1+c` emits `t1=imul; tc=copy t1; t2=iadd tc,c`;
                // without this, LICM (whitelist excludes OP_COPY) hoists only t1 — the
                // copy keeps t2's operand "in the loop". copy_prop rewrites t2 to use
                // t1 directly, so LICM's within-pass chaining then hoists t2 as well
                // (after hoisting t1, def_block[t1]=pre-header → the direct-operand t2
                // is invariant). CFG-preserving, so loop_depths below stay valid.
                copy_prop_func(f)
                compute_loop_depths(f)
                licm_func(f) // RFC 0025: sound model-A LICM (single-def gate + whitelist + unique pre-header)
                strength_reduction_func(f)
                // RFC 0025: sound full unroll of const-trip (<=4) loops. Re-enabled
                // after rewriting the renaming: the OLD pass reset its rename map every
                // iteration, so a loop-carried accumulator (`acc = acc + iv`) read the
                // ORIGINAL acc each iteration (and read its own fresh dest before
                // defining it) → a -O2-built compiler SEGFAULTED on every input
                // ([[bug-o2-large-code-miscompile]]). The new loop_unroll_func threads
                // values through a PERSISTENT cur[] map, copies each body-defined
                // register's final value back to its original name, sets the induction
                // variable to its post-loop value, and BAILS on any body containing a
                // branch (nested control flow it cannot clone). Gated on the same
                // -O2-self-compile acceptance test as LICM (self-build is -O1 = blind).
                loop_unroll_func(f)

            // Iterative value passes: fold → simplify → propagate → eliminate.
            // Converges in 2-4 iterations for typical functions.
            mut iter := 0
            while iter < 6:
                mut changed := false

                if fold_func(f):
                    changed = true
                if alg_simp_func(f):
                    changed = true
                if copy_prop_func(f):
                    changed = true
                if not is_large:
                    if cse_func(f):
                        changed = true
                if dce_func(f):
                    changed = true

                if not changed:
                    break
                iter = iter + 1
        fi = fi + 1 as i64
