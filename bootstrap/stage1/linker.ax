// bootstrap/stage1/linker.ax
// Custom self-hosted ELF64 & PE/COFF relocations resolver and segment merger.

import std.string

extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fread(buffer: ptr[void], size: i64, count: i64, stream: ptr[void]) -> i64
extern "C" fn fclose(stream: ptr[void]) -> i32
extern "C" fn fseek(stream: ptr[void], offset: i64, origin: i32) -> i32
extern "C" fn ftell(stream: ptr[void]) -> i64
extern "C" fn rewind(stream: ptr[void])

pub fn x86_slice_to_str(data: ptr[u8], len: i64) -> str:
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, data, len)
    buf[len] = 0 as u8
    return buf as str

// --------------------------------------------------------------------------
// Basic Binary Decoding & Encoding Helpers
// --------------------------------------------------------------------------

pub fn read_u16_le(data: ptr[u8], off: i64) -> u16:
    let b0 = data[off] as u16
    let b1 = data[off + 1] as u16
    return b0 | (b1 << 8 as u16)

// BUG#20: the native backend miscompiles an OR-chain of 3+ shifted operands
// (e.g. `b0 | (b1<<8) | (b2<<16) | (b3<<24)`) under register pressure — the b0/b1
// terms come back wrong (verified at -O0 and -O1; the 2-operand read_u16_le is
// fine, a single-accumulator form is fine). This corrupted every COFF field read
// at self-link time -> empty symbol names -> "Unresolved external symbol ''".
// Rewrite as a single-accumulator fold (low register pressure) which compiles
// correctly. (Root fix belongs in the selector/regalloc for wide OR trees.)
pub fn read_u32_le(data: ptr[u8], off: i64) -> u32:
    mut r := data[off] as u32
    r = r | ((data[off + 1] as u32) << 8 as u32)
    r = r | ((data[off + 2] as u32) << 16 as u32)
    r = r | ((data[off + 3] as u32) << 24 as u32)
    return r

pub fn read_u64_le(data: ptr[u8], off: i64) -> u64:
    mut r := data[off] as u64
    r = r | ((data[off + 1] as u64) << 8 as u64)
    r = r | ((data[off + 2] as u64) << 16 as u64)
    r = r | ((data[off + 3] as u64) << 24 as u64)
    r = r | ((data[off + 4] as u64) << 32 as u64)
    r = r | ((data[off + 5] as u64) << 40 as u64)
    r = r | ((data[off + 6] as u64) << 48 as u64)
    r = r | ((data[off + 7] as u64) << 56 as u64)
    return r

pub fn write_u32_le(data: ptr[u8], off: i64, val: u32):
    data[off] = (val & 0xFF as u32) as u8
    data[off + 1] = ((val >> 8 as u32) & 0xFF as u32) as u8
    data[off + 2] = ((val >> 16 as u32) & 0xFF as u32) as u8
    data[off + 3] = ((val >> 24 as u32) & 0xFF as u32) as u8

pub fn write_u64_le(data: ptr[u8], off: i64, val: u64):
    data[off] = (val & 0xFF as u64) as u8
    data[off + 1] = ((val >> 8 as u64) & 0xFF as u64) as u8
    data[off + 2] = ((val >> 16 as u64) & 0xFF as u64) as u8
    data[off + 3] = ((val >> 24 as u64) & 0xFF as u64) as u8
    data[off + 4] = ((val >> 32 as u64) & 0xFF as u64) as u8
    data[off + 5] = ((val >> 40 as u64) & 0xFF as u64) as u8
    data[off + 6] = ((val >> 48 as u64) & 0xFF as u64) as u8
    data[off + 7] = ((val >> 56 as u64) & 0xFF as u64) as u8
// --------------------------------------------------------------------------
// Linker Structures and Dynamic Vectors
// --------------------------------------------------------------------------

pub struct LinkerSymbol:
    pub name: str
    pub section: i64
    pub offset: u64
    pub size: u64
    pub defined: bool

pub struct LinkerSymbolVec:
    pub data: ptr[LinkerSymbol]
    pub len: i64
    pub cap: i64

pub fn new_linker_symbol_vec() -> LinkerSymbolVec:
    return LinkerSymbolVec(data: null as ptr[LinkerSymbol], len: 0, cap: 0)

pub fn push_linker_symbol(mut self: ptr[LinkerSymbolVec], s: LinkerSymbol):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 48) as ptr[LinkerSymbol]
        if self.data != null as ptr[LinkerSymbol]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 48)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = s
    self.len = self.len + 1

pub struct ParsedReloc:
    pub offset: i64
    pub sym_idx: u32
    pub is_pc: bool
    pub addend: i64

pub struct ParsedRelocVec:
    pub data: ptr[ParsedReloc]
    pub len: i64
    pub cap: i64

pub fn new_parsed_reloc_vec() -> ParsedRelocVec:
    return ParsedRelocVec(data: null as ptr[ParsedReloc], len: 0, cap: 0)

pub fn push_parsed_reloc(mut self: ptr[ParsedRelocVec], r: ParsedReloc):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[ParsedReloc]
        if self.data != null as ptr[ParsedReloc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = r
    self.len = self.len + 1

pub struct LinkerStrVec:
    pub data: ptr[str]
    pub len: i64
    pub cap: i64

pub fn new_linker_str_vec() -> LinkerStrVec:
    return LinkerStrVec(data: null as ptr[str], len: 0, cap: 0)

pub fn push_linker_str(mut self: ptr[LinkerStrVec], s: str):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 16) as ptr[str]
        if self.data != null as ptr[str]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 16)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = s
    self.len = self.len + 1

pub struct ParsedObject:
    pub text: ByteVec
    pub rdata: ByteVec
    pub symbols: LinkerSymbolVec
    pub sym_names: LinkerStrVec
    pub relocs: ParsedRelocVec
    pub va: u64
    // RFC 0017 / BUG#82: writable module-level global storage (COFF section 3). `data_va`
    // is the image virtual address assigned to this object's data block during layout.
    pub data: ByteVec
    pub data_va: u64
    // RFC 0030 P3: zero-initialized global storage (`.bss`, logical section 4). There is no
    // byte vector — the whole point is that these bytes are absent from the file. Only the
    // EXTENT travels, and the image reserves it as virtual-only space that the loader zeroes.
    pub bss_size: i64
    pub bss_va: u64

pub struct ParsedObjectPtrVec:
    pub data: ptr[ptr[ParsedObject]]
    pub len: i64
    pub cap: i64

pub fn new_parsed_object_ptr_vec() -> ParsedObjectPtrVec:
    return ParsedObjectPtrVec(data: null as ptr[ptr[ParsedObject]], len: 0, cap: 0)

pub fn push_parsed_object_ptr(mut self: ptr[ParsedObjectPtrVec], p: ptr[ParsedObject]):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[ptr[ParsedObject]]
        if self.data != null as ptr[ptr[ParsedObject]]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = p
    self.len = self.len + 1

// --------------------------------------------------------------------------
// ELF64 parser
// --------------------------------------------------------------------------

pub fn linker_parse_elf(data: ptr[u8], data_len: i64) -> ptr[ParsedObject]:
    let shoff = read_u64_le(data, 40) as i64
    let shnum = read_u16_le(data, 60) as i64

    mut text_off := 0 as i64
    mut text_size := 0 as i64

    // RFC 0017 ELF globals: .rodata (string literals) and writable .data (module
    // globals) are SHT_PROGBITS too — route by sh_flags (EXECINSTR -> .text,
    // WRITE -> .data, neither -> .rodata) instead of "last PROGBITS wins".
    mut rodata_off := 0 as i64
    mut rodata_size := 0 as i64
    mut gdata_off := 0 as i64
    mut gdata_size := 0 as i64
    mut text_hdr_idx := -1 as i64
    mut rodata_hdr_idx := -1 as i64
    mut gdata_hdr_idx := -1 as i64

    mut symtab_off := 0 as i64
    mut symtab_size := 0 as i64

    mut strtab_off := 0 as i64
    mut strtab_size := 0 as i64

    mut rela_off := 0 as i64
    mut rela_size := 0 as i64

    // RFC 0030 P4: .bss (SHT_NOBITS). Tracked by header index so its symbols can be
    // remapped to the LOGICAL section 4, the same normalisation the COFF path does — the
    // physical index differs between the two emitters (7 for ELF, 3 or 4 for COFF).
    mut elf_bss_size := 0 as i64
    mut elf_bss_hdr_idx := -1 as i64

    mut i := 0 as i64
    while i < shnum:
        let off = shoff + i * 64
        let sh_type = read_u32_le(data, off + 4)
        let sh_flags = read_u64_le(data, off + 8)
        let sh_offset = read_u64_le(data, off + 24) as i64
        let sh_size = read_u64_le(data, off + 32) as i64

        if sh_type == 1 as u32: // SHT_PROGBITS
            if (sh_flags & 4 as u64) != 0 as u64: // SHF_EXECINSTR -> .text
                text_off = sh_offset
                text_size = sh_size
                text_hdr_idx = i
            elif (sh_flags & 1 as u64) != 0 as u64: // SHF_WRITE -> .data (globals)
                gdata_off = sh_offset
                gdata_size = sh_size
                gdata_hdr_idx = i
            else: // read-only, non-exec -> .rodata (string literals)
                rodata_off = sh_offset
                rodata_size = sh_size
                rodata_hdr_idx = i
        elif sh_type == 2 as u32: // SHT_SYMTAB
            symtab_off = sh_offset
            symtab_size = sh_size
        elif sh_type == 3 as u32: // SHT_STRTAB
            strtab_off = sh_offset
            strtab_size = sh_size
        elif sh_type == 4 as u32: // SHT_RELA
            rela_off = sh_offset
            rela_size = sh_size
        elif sh_type == 8 as u32: // SHT_NOBITS -> .bss (RFC 0030 P4)
            // No file bytes: sh_size is the extent to reserve, sh_offset is meaningless.
            elf_bss_size = sh_size
            elf_bss_hdr_idx = i
        i = i + 1
        
    mut sym_names := new_linker_str_vec()
    if symtab_size > 0:
        let num_syms = symtab_size / 24
        mut sym_i := 0 as i64
        while sym_i < num_syms:
            let off = symtab_off + sym_i * 24
            let name_offset = read_u32_le(data, off) as i64
            
            mut name_str := ""
            if name_offset < strtab_size:
                let str_ptr = (data as i64 + strtab_off + name_offset) as ptr[u8]
                let max_len = strtab_size - name_offset
                mut char_len := 0 as i64
                while char_len < max_len and str_ptr[char_len] != 0 as u8:
                    char_len = char_len + 1
                name_str = x86_slice_to_str(str_ptr, char_len)
            push_linker_str(&sym_names, name_str)
            sym_i = sym_i + 1
            
    mut symbols := new_linker_symbol_vec()
    if symtab_size > 0:
        let num_syms = symtab_size / 24
        mut sym_i := 1 as i64 // skip first NULL symbol
        while sym_i < num_syms:
            let off = symtab_off + sym_i * 24
            let sec_idx = read_u16_le(data, off + 6)
            let val64 = read_u64_le(data, off + 8)
            let size = read_u64_le(data, off + 16)

            let name = sym_names.data[sym_i]
            let is_defined = sec_idx != 0 as u16

            // Normalize ELF section-header indices to the linker's canonical scheme
            // (1=.text, 2=.rodata/.rdata, 3=.data) so all downstream `section == N`
            // logic is format-agnostic. (The AXIOM ELF writer emits exactly this
            // layout already; the remap keeps foreign objects working too.)
            mut mapped_sec := sec_idx as i64
            if sec_idx as i64 == text_hdr_idx:
                mapped_sec = 1 as i64
            elif sec_idx as i64 == rodata_hdr_idx:
                mapped_sec = 2 as i64
            elif elf_bss_hdr_idx >= 0 as i64 and sec_idx as i64 == elf_bss_hdr_idx:
                mapped_sec = 4 as i64
            elif sec_idx as i64 == gdata_hdr_idx:
                mapped_sec = 3 as i64

            push_linker_symbol(&symbols, LinkerSymbol(
                name: name,
                section: mapped_sec,
                offset: val64,
                size: size,
                defined: is_defined
            ))
            sym_i = sym_i + 1
            
    mut relocs := new_parsed_reloc_vec()
    if rela_size > 0:
        let num_relocs = rela_size / 24
        mut rel_i := 0 as i64
        while rel_i < num_relocs:
            let off = rela_off + rel_i * 24
            let r_offset = read_u64_le(data, off) as i64
            let r_info = read_u64_le(data, off + 8)
            let r_addend = read_u64_le(data, off + 16) as i64
            
            let sym_idx = (r_info >> 32 as u64) as u32
            let r_type = (r_info & 0xFFFFFFFF as u64) as u32
            let is_pc = r_type == 2 as u32 or r_type == 4 as u32 // PC32 or PLT32
            
            push_parsed_reloc(&relocs, ParsedReloc(
                offset: r_offset,
                sym_idx: sym_idx,
                is_pc: is_pc,
                addend: r_addend
            ))
            rel_i = rel_i + 1
            
    mut text_vec := new_byte_vec()
    if text_size > 0:
        push_bytes(&text_vec, (data as i64 + text_off) as ptr[u8], text_size)

    // .rodata rides along exactly like COFF .rdata: the merge appends it right after
    // .text, and section-2 symbols resolve at text.len + offset.
    mut rodata_vec := new_byte_vec()
    if rodata_size > 0:
        push_bytes(&rodata_vec, (data as i64 + rodata_off) as ptr[u8], rodata_size)

    // RFC 0017 ELF globals: writable .data content; placed by the ELF exe emitter.
    mut gdata_vec := new_byte_vec()
    if gdata_size > 0:
        push_bytes(&gdata_vec, (data as i64 + gdata_off) as ptr[u8], gdata_size)

    let obj = @alloc(@compiler_intrinsic("size_of")[ParsedObject]()) as ptr[ParsedObject]
    obj.text = text_vec
    obj.rdata = rodata_vec
    obj.symbols = symbols
    obj.sym_names = sym_names
    obj.relocs = relocs
    obj.va = 0 as u64
    obj.data = gdata_vec
    obj.data_va = 0 as u64
    // RFC 0030 P4 will populate these from SHT_NOBITS; zeroed for now so the ELF path is
    // unchanged and the field is never read uninitialised.
    obj.bss_size = elf_bss_size
    obj.bss_va = 0 as u64
    return obj

// --------------------------------------------------------------------------
// PE/COFF parser
// --------------------------------------------------------------------------

pub fn linker_parse_coff(data: ptr[u8], data_len: i64) -> ptr[ParsedObject]:
    let num_sections = read_u16_le(data, 2) as i64
    let symtab_off = read_u32_le(data, 8) as i64
    let sym_count = read_u32_le(data, 12) as i64
    
    mut text_off := 0 as i64
    mut text_size := 0 as i64
    mut relocs_off := 0 as i64
    mut num_relocs := 0 as i64
    
    mut rdata_off := 0 as i64
    mut rdata_size := 0 as i64

    // RFC 0017 / BUG#82: optional writable .data section (module-level globals).
    mut data_sec_off := 0 as i64
    mut data_sec_size := 0 as i64
    // RFC 0030 P3: `.bss` extent and its 1-based COFF section number. The number is needed
    // because `.bss` is index 4 when `.data` exists but index 3 when every global is
    // zero-initialized, so symbols must be remapped by the header they actually name
    // rather than by a hardcoded constant.
    mut bss_sec_size := 0 as i64
    mut bss_hdr_num := 0 as i64

    mut i := 0 as i64
    while i < num_sections:
        let off = 20 + i * 40

        // Read section name (first 8 bytes)
        mut is_text := false
        if data[off] == '.' as u8 and data[off + 1] == 't' as u8 and data[off + 2] == 'e' as u8 and data[off + 3] == 'x' as u8 and data[off + 4] == 't' as u8:
            is_text = true

        mut is_rdata := false
        if data[off] == '.' as u8 and data[off + 1] == 'r' as u8 and data[off + 2] == 'd' as u8 and data[off + 3] == 'a' as u8 and data[off + 4] == 't' as u8 and data[off + 5] == 'a' as u8:
            is_rdata = true

        // `.data` (writable globals). Distinguished from `.rdata` by the leading char.
        mut is_data := false
        if data[off] == '.' as u8 and data[off + 1] == 'd' as u8 and data[off + 2] == 'a' as u8 and data[off + 3] == 't' as u8 and data[off + 4] == 'a' as u8 and data[off + 5] == 0 as u8:
            is_data = true

        // RFC 0030 P3: `.bss` — zero-initialized globals. Its SizeOfRawData is 0 by
        // construction, so the extent must be read from VirtualSize (+8) rather than the
        // +16 field every other section here uses.
        mut is_bss := false
        if data[off] == '.' as u8 and data[off + 1] == 'b' as u8 and data[off + 2] == 's' as u8 and data[off + 3] == 's' as u8 and data[off + 4] == 0 as u8:
            is_bss = true

        if is_text:
            text_size = read_u32_le(data, off + 16) as i64
            text_off = read_u32_le(data, off + 20) as i64
            relocs_off = read_u32_le(data, off + 24) as i64
            num_relocs = read_u16_le(data, off + 32) as i64
        elif is_rdata:
            rdata_size = read_u32_le(data, off + 16) as i64
            rdata_off = read_u32_le(data, off + 20) as i64
        elif is_data:
            data_sec_size = read_u32_le(data, off + 16) as i64
            data_sec_off = read_u32_le(data, off + 20) as i64
        elif is_bss:
            bss_sec_size = read_u32_le(data, off + 8) as i64
            bss_hdr_num = (i + 1 as i64) as i64 // COFF section numbers are 1-based

        i = i + 1
        
    let strtab_off = symtab_off + sym_count * 18
    let strtab_size = data_len - strtab_off
    
    mut sym_names := new_linker_str_vec()
    mut symbols := new_linker_symbol_vec()
    
    mut sym_i := 0 as i64
    while sym_i < sym_count:
        let off = symtab_off + sym_i * 18
        mut name_str := ""
        
        let first4 = read_u32_le(data, off)
        if first4 == 0 as u32:
            let str_off = read_u32_le(data, off + 4) as i64
            if str_off < strtab_size:
                let str_ptr = (data as i64 + strtab_off + str_off) as ptr[u8]
                let max_len = strtab_size - str_off
                mut char_len := 0 as i64
                while char_len < max_len and str_ptr[char_len] != 0 as u8:
                    char_len = char_len + 1
                name_str = x86_slice_to_str(str_ptr, char_len)
        else:
            let name_ptr = (data as i64 + off) as ptr[u8]
            mut char_len := 0 as i64
            while char_len < 8 and name_ptr[char_len] != 0 as u8:
                char_len = char_len + 1
            name_str = x86_slice_to_str(name_ptr, char_len)
            
        let val = read_u32_le(data, off + 8)
        let sec_num = read_u16_le(data, off + 12) as i16
        let aux_count = data[off + 17]
        
        let is_def_sym = sec_num > 0 as i16
        if name_str == "ax_pathbuf_new" or name_str == "ax_parse_proc_cmdline" or name_str == "ax_Ok" or name_str == "ax_Err" or name_str == "ax_Some" or name_str == "ax_get_global_state_internal" or name_str == "ax_SEGMENT_SIZE" or name_str == "ax_pathbuf_new" or name_str == "ax_parse_proc_cmdline":
            let name_nt = x86_str_to_null_terminated(name_str)
            ax_printf_local("[Debug Linker Parse Symbol] name=%s, sec_num=%d, offset=%d, defined=%d\n", name_nt as i64, sec_num as i64, val as i64, is_def_sym as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            @free(name_nt)

        push_linker_str(&sym_names, name_str)
        // BUG#21: lower_struct_constructor_call (native air_builder) assigns
        // named args POSITIONALLY, ignoring field names. Omitting `size` here
        // made `defined` land in the `size` slot and left `defined` zeroed ->
        // every parsed symbol read as undefined -> defined funcs never entered
        // func_names -> "Unresolved external symbol" for all internal calls.
        // List ALL fields in declaration order so positional lowering is correct.
        // RFC 0030 P3: normalise `.bss` to the LOGICAL section 4 regardless of the index it
        // occupies in this object, so every downstream `section == 4` test is stable. The
        // other three already coincide with their logical numbers (.text 1, .rdata 2,
        // .data 3), so this is the identity for them.
        mut mapped_sec_num := sec_num as i64
        if bss_hdr_num > 0 as i64 and mapped_sec_num == bss_hdr_num:
            mapped_sec_num = 4 as i64

        push_linker_symbol(&symbols, LinkerSymbol(
            name: name_str,
            section: mapped_sec_num,
            offset: val as u64,
            size: 0 as u64,
            defined: is_def_sym
        ))

        sym_i = sym_i + 1
        
        mut k := 0 as u8
        while k < aux_count:
            push_linker_str(&sym_names, "")
            push_linker_symbol(&symbols, LinkerSymbol(name: "", section: 0, offset: 0 as u64, size: 0 as u64, defined: false))
            sym_i = sym_i + 1
            k = k + 1 as u8
            
    mut relocs := new_parsed_reloc_vec()
    mut rel_idx := 0 as i64
    while rel_idx < num_relocs:
        let off = relocs_off + rel_idx * 10
        let virt_addr = read_u32_le(data, off) as i64
        let sym_idx = read_u32_le(data, off + 4)
        let rel_type = read_u16_le(data, off + 8)
        
        let is_pc = rel_type == 4 as u16 // IMAGE_REL_AMD64_REL32
        mut addend := 0 as i64
        if is_pc:
            addend = -4 as i64
            
        push_parsed_reloc(&relocs, ParsedReloc(
            offset: virt_addr,
            sym_idx: sym_idx,
            is_pc: is_pc,
            addend: addend
        ))
        rel_idx = rel_idx + 1
        
    mut text_vec := new_byte_vec()
    if text_size > 0:
        push_bytes(&text_vec, (data as i64 + text_off) as ptr[u8], text_size)
        
    mut rdata_vec := new_byte_vec()
    if rdata_size > 0:
        push_bytes(&rdata_vec, (data as i64 + rdata_off) as ptr[u8], rdata_size)

    mut data_vec := new_byte_vec()
    if data_sec_size > 0:
        push_bytes(&data_vec, (data as i64 + data_sec_off) as ptr[u8], data_sec_size)

    let obj = @alloc(@compiler_intrinsic("size_of")[ParsedObject]()) as ptr[ParsedObject]
    obj.text = text_vec
    obj.rdata = rdata_vec
    obj.symbols = symbols
    obj.sym_names = sym_names
    obj.relocs = relocs
    obj.va = 0 as u64
    obj.data = data_vec
    obj.data_va = 0 as u64
    obj.bss_size = bss_sec_size
    obj.bss_va = 0 as u64
    return obj

// --------------------------------------------------------------------------
// Unified Linker Implementation
// --------------------------------------------------------------------------

// RFC 0009: per-DLL import bucket for user `extern "C" from "x.dll"` symbols.
// Built-in DLLs (kernel32/ax_runtime/ucrtbase) keep their dedicated code path;
// user DLLs are handled additively via a vector of these buckets.
pub struct UserDllBucket:
    pub name: str            // DLL filename, e.g. "anylib.dll"
    pub imports: LinkerStrVec // imported symbol names
    pub iat_offset: i64      // offset within idata_buf (computed during layout)
    pub ilt_offset: i64
    pub name_offset: i64
    pub hn_rvas: ptr[u32]    // hint-name RVAs, one per import

pub struct UserDllBucketVec:
    pub data: ptr[UserDllBucket]
    pub len: i64
    pub cap: i64

pub fn new_user_dll_bucket_vec() -> UserDllBucketVec:
    return UserDllBucketVec(data: null as ptr[UserDllBucket], len: 0, cap: 0)

pub fn push_user_dll_bucket(mut self: ptr[UserDllBucketVec], b: UserDllBucket):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let esize = @compiler_intrinsic("size_of")[UserDllBucket]()
        let new_data = @alloc(new_cap * esize) as ptr[UserDllBucket]
        if self.data != null as ptr[UserDllBucket]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * esize)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = b
    self.len = self.len + 1

// Find the bucket index for dll_name, creating a new empty bucket if absent.
pub fn user_bucket_find_or_add(mut buckets: ptr[UserDllBucketVec], dll_name: str) -> i64:
    mut i := 0 as i64
    while i < buckets.len:
        if buckets.data[i].name == dll_name:
            return i
        i = i + 1
    push_user_dll_bucket(buckets, UserDllBucket(name: dll_name, imports: new_linker_str_vec(), iat_offset: 0, ilt_offset: 0, name_offset: 0, hn_rvas: null as ptr[u32]))
    return buckets.len - 1

pub struct AxiomLinker:
    pub input_files: LinkerStrVec
    pub output_path: str
    // RFC 0009: parallel arrays mapping a user extern symbol name -> its DLL name.
    pub user_dll_syms: LinkerStrVec
    pub user_dll_names: LinkerStrVec
    // RFC 0009 P2: clean names of #[export] functions + DLL (--shared) mode.
    pub export_names: LinkerStrVec
    pub is_shared: bool

pub fn new_axiom_linker() -> AxiomLinker:
    return AxiomLinker(input_files: new_linker_str_vec(), output_path: "", user_dll_syms: new_linker_str_vec(), user_dll_names: new_linker_str_vec(), export_names: new_linker_str_vec(), is_shared: false)


pub fn align_byte_vec(vec: ptr[ByteVec], alignment: i64):
    while vec.len % alignment != 0:
        push_byte(vec, 0 as u8)

pub fn is_valid_symbol_name(name: str) -> bool:
    let len = std.string.len(name)
    if len == 0:
        return false
    let ptr = get_str_ptr(name)
    mut idx := 0 as i64
    while idx < len:
        let c = ptr[idx]
        if c <= 32 as u8 or c >= 127 as u8:
            return false
        idx = idx + 1
    return true

pub fn is_valid_runtime_dll_symbol(name: str) -> bool:
    if (name == "__ax_runtime_init" or name == "__ax_runtime_shutdown" or
        name == "ax___ax_runtime_init" or name == "ax___ax_runtime_shutdown" or
        name == "ax_actor_spawn" or name == "ax_actor_step" or
        name == "ax_actor_is_running" or name == "ax_actor_has_messages" or
        name == "ax_str_eq" or name == "ax_str_len" or
        name == "ax_str_concat" or name == "ax_str_replace" or
        name == "ax_str_slice" or name == "ax_str_char_count" or
        name == "ax_str_contains" or name == "ax_str_ends_with" or
        name == "ax_str_index_of" or name == "ax_str_starts_with" or
        name == "ax_str_trim" or name == "ax_free" or
        name == "ax_alloc" or name == "ax_realloc" or
        name == "ax_println_str" or name == "ax_println_i64" or
        name == "ax_println_f64" or name == "ax_println_bool" or
        name == "ax_print_str" or name == "ax_print_i64" or
        name == "ax_print_f64" or name == "ax_print_bool" or
        name == "ax_assert_axiom" or name == "ax_panic" or
        name == "ax_time_now_ns" or name == "ax_timer_after" or
        name == "ax_scheduler_stats" or name == "ax_scheduler_submit" or
        name == "ax_scheduler_init" or name == "ax_scheduler_run" or
        name == "ax_scheduler_shutdown" or name == "ax_compiler_intrinsic" or
        name == "ax_get_global_state_internal" or name == "ax_str_parse_i64" or
        name == "ax_str_parse_f64" or name == "ax_sum_layout_is_pointer" or
        name == "ax_actor_stop" or name == "ax_actor_ref_to_u64" or
        name == "ax_i64_to_str"):
        return true
    return false

pub fn get_dll_for_symbol(name: str) -> str:
    if (name == "steals_attempted" or name == "steals_succeeded" or name == "tasks_executed" or
        name == "running" or name == "head" or name == "total_executed" or
        name == "worker_count" or name == "total_submitted" or name == "total_steals" or
        name == "alloc" or name == "q" or name == "msg" or name == "actor" or name == "SEGMENT_MAGIC" or
        name == "ax_steals_attempted" or name == "ax_steals_succeeded" or name == "ax_tasks_executed" or
        name == "ax_running" or name == "ax_head" or name == "ax_total_executed" or
        name == "ax_worker_count" or name == "ax_total_submitted" or name == "ax_total_steals" or
        name == "ax_q" or name == "ax_msg" or name == "ax_actor" or name == "ax_total_executed" or name == "ax_SEGMENT_MAGIC" or
        name == "syscall"):
        return "none"

    if (name == "VirtualAlloc" or name == "VirtualFree" or name == "ExitProcess" or name == "TerminateProcess" or 
        name == "GetLastError" or name == "GetStdHandle" or name == "WriteFile" or
        name == "CreateFileA" or name == "ReadFile" or name == "CloseHandle" or
        name == "CreateDirectoryA" or name == "RemoveDirectoryA" or name == "DeleteFileA" or
        name == "MoveFileA" or name == "CopyFileA" or name == "GetFileAttributesA" or
        name == "GetCommandLineA" or name == "GetEnvironmentVariableA" or name == "SetEnvironmentVariableA" or
        name == "GetCommandLineW"):
        return "kernel32.dll"
        
    let ptr = get_str_ptr(name)
    let len = std.string.len(name)
    if len >= 3 and ptr[0] == 'a' as u8 and ptr[1] == 'x' as u8 and ptr[2] == '_' as u8:
        if is_valid_runtime_dll_symbol(name):
            return "ax_runtime.dll"
        return "none"
    if len >= 5 and ptr[0] == '_' as u8 and ptr[1] == '_' as u8 and ptr[2] == 'a' as u8 and ptr[3] == 'x' as u8 and ptr[4] == '_' as u8:
        if is_valid_runtime_dll_symbol(name):
            return "ax_runtime.dll"
        return "none"
        
    return "ucrtbase.dll"

pub fn add_unique_import(imports: ptr[LinkerStrVec], name: str):
    mut found := false
    mut i := 0 as i64
    while i < imports.len:
        if imports.data[i] == name:
            found = true
            break
        i = i + 1
    if not found:
        push_linker_str(imports, name)

// RFC 0009: return the user-declared DLL for `name` (from `extern "C" from`),
// or "" if the symbol has no explicit binding (falls back to whitelist).
pub fn user_dll_for_symbol(self: ptr[AxiomLinker], name: str) -> str:
    mut i := 0 as i64
    while i < self.user_dll_syms.len:
        if self.user_dll_syms.data[i] == name:
            return self.user_dll_names.data[i]
        i = i + 1
    return ""

pub fn write_buf_u32_le(data: ptr[u8], off: i64, val: u32):
    data[off] = (val & 0xFF as u32) as u8
    data[off + 1] = ((val >> 8 as u32) & 0xFF as u32) as u8
    data[off + 2] = ((val >> 16 as u32) & 0xFF as u32) as u8
    data[off + 3] = ((val >> 24 as u32) & 0xFF as u32) as u8

pub fn write_buf_u64_le(data: ptr[u8], off: i64, val: u64):
    write_buf_u32_le(data, off, (val & 0xFFFFFFFF as u64) as u32)
    write_buf_u32_le(data, off + 4, ((val >> 32 as u64) & 0xFFFFFFFF as u64) as u32)

pub fn linker_build_pe_headers(
    out: ptr[ByteVec],
    code_raw_size: u32,
    idata_raw_size: u32,
    entry_rva: u32,
    idata_rva: u32,
    idata_size: u32,
    iat_rva: u32,
    iat_size: u32,
    export_rva: u32,      // RFC 0009 P2: .edata RVA (0 = no export section)
    export_size: u32,     // export directory virtual size (data dir 0)
    edata_raw_size: u32,  // file-aligned .edata size (0 = EXE, byte-identical path)
    edata_file_off: u32,  // .edata PointerToRawData
    is_dll: bool,         // set IMAGE_FILE_DLL characteristic
    idata_virt_size: u32  // RFC 0030: writable-region VirtualSize incl. the .bss tail
):
    // RFC 0009 P2: when edata_raw_size == 0 this function is byte-identical to the
    // original 2-section EXE emitter; export params only take effect for --shared.
    mut num_sections := 2 as u16
    if edata_raw_size > 0 as u32:
        num_sections = 3 as u16
    mut coff_chars := 0x0026 as u16
    if is_dll:
        coff_chars = 0x2026 as u16 // + IMAGE_FILE_DLL (0x2000)
    // 1. DOS Header
    push_byte(out, 0x4D as u8) // 'M'
    push_byte(out, 0x5A as u8) // 'Z'
    mut i := 2 as i64
    while i < 0x3C:
        push_byte(out, 0 as u8)
        i = i + 1
    push_u32_le(out, 0x80 as u32) // e_lfanew
    i = 0x40
    while i < 0x80:
        push_byte(out, 0 as u8)
        i = i + 1
        
    // 2. PE Signature
    push_byte(out, 0x50 as u8) // 'P'
    push_byte(out, 0x45 as u8) // 'E'
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    
    // 3. COFF File Header
    push_u16_le(out, 0x8664 as u16) // Machine (AMD64)
    push_u16_le(out, num_sections) // NumberOfSections (2 EXE / 3 DLL)
    push_u32_le(out, 0 as u32) // TimeDateStamp
    push_u32_le(out, 0 as u32) // PointerToSymbolTable
    push_u32_le(out, 0 as u32) // NumberOfSymbols
    push_u16_le(out, 240 as u16) // SizeOfOptionalHeader
    push_u16_le(out, coff_chars) // Characteristics (+IMAGE_FILE_DLL for --shared)
    
    // 4. Optional Header (PE32+)
    push_u16_le(out, 0x020B as u16) // Magic
    push_byte(out, 1 as u8) // MajorLinkerVersion
    push_byte(out, 0 as u8) // MinorLinkerVersion
    push_u32_le(out, code_raw_size) // SizeOfCode
    push_u32_le(out, idata_raw_size) // SizeOfInitializedData
    mut uninit_size := 0 as u32
    if idata_virt_size > idata_raw_size:
        uninit_size = idata_virt_size - idata_raw_size
    push_u32_le(out, uninit_size) // SizeOfUninitializedData (RFC 0030)
    push_u32_le(out, entry_rva) // AddressOfEntryPoint
    push_u32_le(out, 0x1000 as u32) // BaseOfCode
    push_u64_le(out, 0x140000000 as u64) // ImageBase
    push_u32_le(out, 0x1000 as u32) // SectionAlignment
    push_u32_le(out, 0x200 as u32) // FileAlignment
    push_u16_le(out, 6 as u16) // MajorOperatingSystemVersion
    push_u16_le(out, 0 as u16) // MinorOperatingSystemVersion
    push_u16_le(out, 0 as u16) // MajorImageVersion
    push_u16_le(out, 0 as u16) // MinorImageVersion
    push_u16_le(out, 6 as u16) // MajorSubsystemVersion
    push_u16_le(out, 0 as u16) // MinorSubsystemVersion
    push_u32_le(out, 0 as u32) // Win32VersionValue
    
    mut last_sec_end := idata_rva + idata_virt_size
    if edata_raw_size > 0 as u32:
        last_sec_end = export_rva + edata_raw_size
    let size_of_image = (last_sec_end + 0xFFF as u32) & (0xFFFFF000 as u32)
    push_u32_le(out, size_of_image) // SizeOfImage
    push_u32_le(out, 0x400 as u32) // SizeOfHeaders
    push_u32_le(out, 0 as u32) // CheckSum
    push_u16_le(out, 3 as u16) // Subsystem (Console)
    push_u16_le(out, 0x0160 as u16) // DllCharacteristics
    push_u64_le(out, 0x1000000 as u64) // SizeOfStackReserve (16MB) — BUG#28: 1MB
                                       // overflowed when stage2 typechecks the
                                       // full compiler (deep recursion); stage1
                                       // had 2MB. 16MB gives ample headroom.
    push_u64_le(out, 0x1000 as u64) // SizeOfStackCommit (OS auto-grows to reserve)
    push_u64_le(out, 0x100000 as u64) // SizeOfHeapReserve
    push_u64_le(out, 0x1000 as u64) // SizeOfHeapCommit
    push_u32_le(out, 0 as u32) // LoaderFlags
    push_u32_le(out, 16 as u32) // NumberOfRvaAndSizes
    
    // Data Directories
    // Dir 0: Export (RFC 0009 P2 — only for --shared; 0/0 for EXE)
    push_u32_le(out, export_rva)
    push_u32_le(out, export_size)
    // Dir 1: Import
    push_u32_le(out, idata_rva)
    push_u32_le(out, idata_size)
    // Dir 2 to 11 (10 entries = 80 bytes)
    mut dir_i := 2 as i64
    while dir_i < 12:
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        dir_i = dir_i + 1
    // Dir 12: IAT
    push_u32_le(out, iat_rva)
    push_u32_le(out, iat_size)
    // Dir 13 to 15 (3 entries = 24 bytes)
    dir_i = 13
    while dir_i < 16:
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        dir_i = dir_i + 1
        
    // 5. Section Headers
    // Section 1: .text
    push_byte(out, '.' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 'e' as u8)
    push_byte(out, 'x' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_u32_le(out, code_raw_size) // VirtualSize
    push_u32_le(out, 0x1000 as u32) // VirtualAddress
    push_u32_le(out, code_raw_size) // SizeOfRawData
    push_u32_le(out, 0x400 as u32) // PointerToRawData
    push_u32_le(out, 0 as u32) // PointerToRelocations
    push_u32_le(out, 0 as u32) // PointerToLinenumbers
    push_u16_le(out, 0 as u16) // NumberOfRelocations
    push_u16_le(out, 0 as u16) // NumberOfLinenumbers
    push_u32_le(out, 0x60000020 as u32) // Characteristics
    
    // Section 2: .idata
    push_byte(out, '.' as u8)
    push_byte(out, 'i' as u8)
    push_byte(out, 'd' as u8)
    push_byte(out, 'a' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 'a' as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_u32_le(out, idata_virt_size) // VirtualSize (RFC 0030: includes the zero-filled .bss tail)
    push_u32_le(out, idata_rva) // VirtualAddress
    push_u32_le(out, idata_raw_size) // SizeOfRawData (file bytes only)
    push_u32_le(out, 0x400 as u32 + code_raw_size) // PointerToRawData
    push_u32_le(out, 0 as u32)
    push_u32_le(out, 0 as u32)
    push_u16_le(out, 0 as u16)
    push_u16_le(out, 0 as u16)
    push_u32_le(out, 0xC0000040 as u32) // Characteristics

    // Section 3: .edata (RFC 0009 P2 — only when exporting)
    if edata_raw_size > 0 as u32:
        push_byte(out, '.' as u8)
        push_byte(out, 'e' as u8)
        push_byte(out, 'd' as u8)
        push_byte(out, 'a' as u8)
        push_byte(out, 't' as u8)
        push_byte(out, 'a' as u8)
        push_byte(out, 0 as u8)
        push_byte(out, 0 as u8)
        push_u32_le(out, export_size) // VirtualSize
        push_u32_le(out, export_rva) // VirtualAddress
        push_u32_le(out, edata_raw_size) // SizeOfRawData
        push_u32_le(out, edata_file_off) // PointerToRawData
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        push_u16_le(out, 0 as u16)
        push_u16_le(out, 0 as u16)
        push_u32_le(out, 0x40000040 as u32) // Characteristics: init data, read-only

    align_byte_vec(out, 0x400 as i64)

pub fn linker_build_elf_headers(out: ptr[ByteVec], code_raw_size: u32, entry_va: u64, dynamic_offset: u32, dynamic_size: u32, bss_extent: u32):
    // 1. e_ident
    push_byte(out, 0x7F as u8)
    push_byte(out, 'E' as u8)
    push_byte(out, 'L' as u8)
    push_byte(out, 'F' as u8)
    push_byte(out, 2 as u8) // ELFCLASS64
    push_byte(out, 1 as u8) // ELFDATA2LSB
    push_byte(out, 1 as u8) // EV_CURRENT
    push_byte(out, 0 as u8) // ELFOSABI_NONE
    mut i := 8 as i64
    while i < 16:
        push_byte(out, 0 as u8)
        i = i + 1
        
    // 2. Type, Machine, Version
    push_u16_le(out, 2 as u16) // ET_EXEC
    push_u16_le(out, 62 as u16) // EM_X86_64
    push_u32_le(out, 1 as u32) // EV_CURRENT
    
    // 3. Entry point virtual address
    push_u64_le(out, entry_va)
    
    // 4. Program header offset
    push_u64_le(out, 64 as u64) // immediately follows ELF header
    
    // 5. Section header offset
    push_u64_le(out, 0 as u64) // no section headers
    
    if dynamic_size > 0:
        // 6. Flags, Header Sizes
        push_u32_le(out, 0 as u32) // e_flags
        push_u16_le(out, 64 as u16) // e_ehsize
        push_u16_le(out, 56 as u16) // e_phentsize
        push_u16_le(out, 3 as u16) // e_phnum (3 program headers)
        push_u16_le(out, 0 as u16) // e_shentsize
        push_u16_le(out, 0 as u16) // e_shnum
        push_u16_le(out, 0 as u16) // e_shstrndx
        
        // 7. Program Header Table
        // PHDR 1: PT_INTERP
        push_u32_le(out, 3 as u32) // p_type: PT_INTERP
        push_u32_le(out, 4 as u32) // p_flags: PF_R
        push_u64_le(out, 232 as u64) // p_offset: starts immediately after PHDRs (64 + 3*56 = 232)
        push_u64_le(out, 0x400000 as u64 + 232 as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64 + 232 as u64) // p_paddr
        push_u64_le(out, 28 as u64) // p_filesz: "/lib64/ld-linux-x86-64.so.2\0" is 28 bytes
        push_u64_le(out, 28 as u64) // p_memsz
        push_u64_le(out, 1 as u64) // p_align
        
        // PHDR 2: PT_LOAD
        push_u32_le(out, 1 as u32) // p_type: PT_LOAD
        push_u32_le(out, 7 as u32) // p_flags: PF_R | PF_W | PF_X
        push_u64_le(out, 0 as u64) // p_offset: starts at beginning of file
        push_u64_le(out, 0x400000 as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64) // p_paddr
        push_u64_le(out, 512 as u64 + code_raw_size as u64) // p_filesz
        push_u64_le(out, 512 as u64 + code_raw_size as u64 + bss_extent as u64) // p_memsz (RFC 0030 P4)
        push_u64_le(out, 4096 as u64) // p_align
        
        // PHDR 3: PT_DYNAMIC
        push_u32_le(out, 2 as u32) // p_type: PT_DYNAMIC
        push_u32_le(out, 6 as u32) // p_flags: PF_R | PF_W
        push_u64_le(out, dynamic_offset as u64) // p_offset
        push_u64_le(out, 0x400000 as u64 + dynamic_offset as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64 + dynamic_offset as u64) // p_paddr
        push_u64_le(out, dynamic_size as u64) // p_filesz
        push_u64_le(out, dynamic_size as u64) // p_memsz
        push_u64_le(out, 8 as u64) // p_align
        
        // Write the interpreter path at offset 232
        let interp_str = "/lib64/ld-linux-x86-64.so.2" as ptr[u8]
        mut c_i := 0 as i64
        while c_i < 27:
            push_byte(out, interp_str[c_i])
            c_i = c_i + 1
        push_byte(out, 0 as u8) // null-terminate
        
        align_byte_vec(out, 512 as i64)
    else:
        // 6. Flags, Header Sizes
        push_u32_le(out, 0 as u32) // e_flags
        push_u16_le(out, 64 as u16) // e_ehsize
        push_u16_le(out, 56 as u16) // e_phentsize
        push_u16_le(out, 1 as u16) // e_phnum (1 PT_LOAD segment)
        push_u16_le(out, 0 as u16) // e_shentsize
        push_u16_le(out, 0 as u16) // e_shnum
        push_u16_le(out, 0 as u16) // e_shstrndx
        
        // 7. Program Header Table (1 entry: PT_LOAD segment)
        push_u32_le(out, 1 as u32) // p_type: PT_LOAD
        // PF_R | PF_W | PF_X: the RFC 0017 globals region (writable .data) lives inside
        // this single LOAD segment, so it must be writable. (Splitting into separate
        // RX/RW segments is a follow-up refinement; the dynamic case below is RWX too.)
        push_u32_le(out, 7 as u32) // p_flags: PF_R | PF_W | PF_X
        push_u64_le(out, 0 as u64) // p_offset: starts at beginning of file
        push_u64_le(out, 0x400000 as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64) // p_paddr
        push_u64_le(out, 128 as u64 + code_raw_size as u64) // p_filesz: maps entire executable file!
        // RFC 0030 P4: p_memsz exceeds p_filesz by the .bss extent; the kernel supplies
        // zero pages for the difference. Equal when bss_extent is 0, so unchanged output.
        push_u64_le(out, 128 as u64 + code_raw_size as u64 + bss_extent as u64) // p_memsz
        push_u64_le(out, 0x1000 as u64) // p_align
        
        align_byte_vec(out, 128 as i64)

pub fn axiom_linker_add_input(mut self: ptr[AxiomLinker], file: str):
    push_linker_str(&self.input_files, file)

// RFC 0009 P2: byte-wise lexicographic string ordering (PE export name table
// must be sorted so the loader's binary search resolves imports).
pub fn linker_str_less(a: str, b: str) -> bool:
    let la = std.string.len(a)
    let lb = std.string.len(b)
    let pa = get_str_ptr(a)
    let pb = get_str_ptr(b)
    mut n := la
    if lb < la:
        n = lb
    mut i := 0 as i64
    while i < n:
        if pa[i] != pb[i]:
            return pa[i] < pb[i]
        i = i + 1
    return la < lb

// Return the filename portion of a path (after the last '/' or '\\').
pub fn linker_basename(path: str) -> str:
    let len = std.string.len(path)
    let p = get_str_ptr(path)
    mut start := 0 as i64
    mut i := 0 as i64
    while i < len:
        if p[i] == '/' as u8 or p[i] == 92 as u8: // '\\'
            start = i + 1
        i = i + 1
    return alloc_str_from_raw((p as i64 + start) as ptr[u8], len - start)

// RFC 0009 P2: build a PE .edata (IMAGE_EXPORT_DIRECTORY + EAT + name-pointer +
// ordinal tables + strings). export_names are sorted in place. Each export "foo"
// resolves to the defined symbol "ax_foo" (AXIOM's uniform mangling prefix).
pub fn build_export_edata(export_names: ptr[LinkerStrVec], func_names: ptr[LinkerStrVec], func_offsets: ptr[ParsedRelocVec], edata_rva: u32, dll_name: str, out: ptr[ByteVec]):
    let n = export_names.len
    // 1. Insertion-sort names lexicographically (in place)
    mut a := 1 as i64
    while a < n:
        let key = export_names.data[a]
        mut b := a - 1
        while b >= 0 and linker_str_less(key, export_names.data[b]):
            export_names.data[b + 1] = export_names.data[b]
            b = b - 1
        export_names.data[b + 1] = key
        a = a + 1

    // 2. Layout offsets within .edata
    let eat_off = 40 as i64
    let enpt_off = eat_off + n * 4
    let ord_off = enpt_off + n * 4
    let str_off = ord_off + n * 2

    // 3. Build string blob: DLL name first, then each export name
    mut strbuf := new_byte_vec()
    let dll_name_rva = (edata_rva as i64 + str_off) as u32
    let dnp = get_str_ptr(dll_name)
    let dnl = std.string.len(dll_name)
    mut ci := 0 as i64
    while ci < dnl:
        push_byte(&strbuf, dnp[ci])
        ci = ci + 1
    push_byte(&strbuf, 0 as u8)

    let name_rvas = @alloc(n * 4) as ptr[u32]
    mut k := 0 as i64
    while k < n:
        name_rvas[k] = (edata_rva as i64 + str_off + strbuf.len) as u32
        let nm = export_names.data[k]
        let np = get_str_ptr(nm)
        let nl = std.string.len(nm)
        mut c2 := 0 as i64
        while c2 < nl:
            push_byte(&strbuf, np[c2])
            c2 = c2 + 1
        push_byte(&strbuf, 0 as u8)
        k = k + 1

    // 4. Resolve each export to its defined-symbol RVA (mangled "ax_" + name)
    let eat_rvas = @alloc(n * 4) as ptr[u32]
    k = 0
    while k < n:
        let mangled = std.string.concat("ax_", export_names.data[k])
        mut rva := 0 as u32
        mut fi := 0 as i64
        while fi < func_names.len:
            if func_names.data[fi] == mangled:
                rva = (0x1000 as i64 + func_offsets.data[fi].offset) as u32
                break
            fi = fi + 1
        @free(get_str_ptr(mangled))
        eat_rvas[k] = rva
        k = k + 1

    // 5. Emit export directory table
    push_u32_le(out, 0 as u32) // ExportFlags
    push_u32_le(out, 0 as u32) // TimeDateStamp
    push_u16_le(out, 0 as u16) // MajorVersion
    push_u16_le(out, 0 as u16) // MinorVersion
    push_u32_le(out, dll_name_rva) // Name RVA
    push_u32_le(out, 1 as u32) // OrdinalBase
    push_u32_le(out, n as u32) // NumberOfFunctions
    push_u32_le(out, n as u32) // NumberOfNames
    push_u32_le(out, (edata_rva as i64 + eat_off) as u32) // EAT RVA
    push_u32_le(out, (edata_rva as i64 + enpt_off) as u32) // Name-pointer table RVA
    push_u32_le(out, (edata_rva as i64 + ord_off) as u32) // Ordinal table RVA

    k = 0
    while k < n:
        push_u32_le(out, eat_rvas[k]) // Export Address Table
        k = k + 1
    k = 0
    while k < n:
        push_u32_le(out, name_rvas[k]) // Name Pointer Table
        k = k + 1
    k = 0
    while k < n:
        push_u16_le(out, k as u16) // Ordinal Table (0-based into EAT)
        k = k + 1
    push_bytes(out, strbuf.data, strbuf.len)

    if strbuf.data != null as ptr[u8]:
        @free(strbuf.data)
    @free(name_rvas as ptr[u8])
    @free(eat_rvas as ptr[u8])

// RFC 0011 P1: static-library (`.lib`) writer — standard COFF `!<arch>` format.
pub fn push_u32_be(out: ptr[ByteVec], val: u32):
    push_byte(out, ((val >> 24 as u32) & 0xFF as u32) as u8)
    push_byte(out, ((val >> 16 as u32) & 0xFF as u32) as u8)
    push_byte(out, ((val >> 8 as u32) & 0xFF as u32) as u8)
    push_byte(out, (val & 0xFF as u32) as u8)

// Left-justified, space-padded ASCII field of exactly `width` bytes.
fn ar_field_str(out: ptr[ByteVec], s: str, width: i64):
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < width:
        if i < n:
            push_byte(out, p[i])
        else:
            push_byte(out, ' ' as u8)
        i = i + 1

// Decimal ASCII, left-justified, space-padded to `width` bytes.
fn ar_field_decimal(out: ptr[ByteVec], val: i64, width: i64):
    let buf = @alloc(24) as ptr[u8]
    mut m := val
    mut k := 0 as i64
    if m == 0:
        buf[0] = '0' as u8
        k = 1
    else:
        while m > 0:
            buf[k] = ('0' as u8) + (m % 10 as i64) as u8
            k = k + 1
            m = m / 10 as i64
    mut i := 0 as i64
    while i < width:
        if i < k:
            push_byte(out, buf[k - 1 - i])
        else:
            push_byte(out, ' ' as u8)
        i = i + 1
    @free(buf)

// A 60-byte `ar` member header.
fn ar_write_header(out: ptr[ByteVec], name: str, size: i64):
    ar_field_str(out, name, 16)     // Name (slash-terminated for COFF)
    ar_field_str(out, "0", 12)      // Date
    ar_field_str(out, "", 6)        // UID
    ar_field_str(out, "", 6)        // GID
    ar_field_str(out, "0", 8)       // Mode
    ar_field_decimal(out, size, 10) // Size
    push_byte(out, 0x60 as u8)      // end marker "`\n"
    push_byte(out, 0x0A as u8)

// RFC 0011 P4 (increment 2): append a raw string's bytes to a ByteVec.
fn iface_push_str(out: ptr[ByteVec], s: str):
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < n:
        push_byte(out, p[i])
        i = i + 1

// RFC 0011 P4 (increment 2): append a base-10 integer to a ByteVec.
fn iface_push_int(out: ptr[ByteVec], val: i64):
    if val == 0:
        push_byte(out, '0' as u8)
        return
    let buf = @alloc(24) as ptr[u8]
    mut m := val
    mut k := 0 as i64
    while m > 0:
        buf[k] = ('0' as u8) + (m % 10 as i64) as u8
        k = k + 1
        m = m / 10 as i64
    while k > 0:
        k = k - 1
        push_byte(out, buf[k])
    @free(buf)

// RFC 0011 P4 (increment 2): canonical, compilation-stable token for a type in the
// interface. Primitive TypeIDs are fixed constants (portable across builds); pointer /
// slice recurse; everything else (structs, generics, sums) is a "?" placeholder until a
// later increment teaches the interface to carry those declarations. The token must be
// derivable identically by producer and consumer from the same primitive-ID contract.
fn iface_type_token(types: ptr[TypeTable], type_id: u32, pool: ptr[InternPool]) -> str:
    if type_id == TYPE_I8:
        return "i8"
    if type_id == TYPE_I16:
        return "i16"
    if type_id == TYPE_I32:
        return "i32"
    if type_id == TYPE_I64:
        return "i64"
    if type_id == TYPE_U8:
        return "u8"
    if type_id == TYPE_U16:
        return "u16"
    if type_id == TYPE_U32:
        return "u32"
    if type_id == TYPE_U64:
        return "u64"
    if type_id == TYPE_F32:
        return "f32"
    if type_id == TYPE_F64:
        return "f64"
    if type_id == TYPE_BOOL:
        return "bool"
    if type_id == TYPE_STRING:
        return "string"
    if type_id == TYPE_CHAR8:
        return "char8"
    if type_id == TYPE_VOID:
        return "void"
    if type_id == TYPE_ISIZE:
        return "isize"
    if type_id == TYPE_USIZE:
        return "usize"
    if type_id == TYPE_UNKNOWN:
        return "?"
    if (type_id as i64) >= types.entries.len:
        return "?"
    let ekind = types.entries.data[type_id].kind
    if ekind == TYPE_KIND_POINTER:
        return "ptr"
    if ekind == TYPE_KIND_SLICE:
        return "slice"
    // RFC 0011 P4 inc4b: a struct type round-trips by NAME. The consumer re-registers the
    // struct (from its `S` line) and maps the name back to a type_id, so functions/consts
    // that reference the struct resolve exactly. Requires the pool to fetch the name.
    if ekind == TYPE_KIND_STRUCT and pool != null as ptr[InternPool]:
        let snid = types.entries.data[type_id].name_id
        if snid != 0 as u32:
            let sname = pool.get(snid)
            if std.string.len(sname) > 0:
                return sname
    return "?"

// RFC 0011 P4 (increment 2): serialize the public interface of a translation unit into
// the `__axiom_iface` text payload. One `F` line per public function:
//   F <name> <nparams> <p0> <p1> ... -> <ret>
// where each type is an `iface_type_token`. The linker symbol is `ax_<name>` (uniform
// mangling), so the consumer re-derives it — the interface stays source-level. Structs,
// consts, and generics are future increments; only functions appear today.
pub fn build_lib_iface_text(symtable: ptr[SymbolTable], pool: ptr[InternPool], types: ptr[TypeTable], tree: ptr[AstTree]) -> str:
    mut bv := new_byte_vec()
    iface_push_str(&bv, "AXIFACE1\n")
    // RFC 0011 P4 inc4b: emit `S <name> <nfields> <fname> <ftok> ...` for each public struct
    // whose fields are ALL primitive, BEFORE the F/C lines that may reference it by name. The
    // consumer recomputes size/align from the same fields, so the layout matches exactly.
    // Structs with pointer/nested-struct fields are a later slice (field-access typing needs
    // the pointee/struct, which the token drops today).
    mut ss := 0 as i64
    while ss < symtable.symbols.len:
        if symtable.symbols.data[ss].kind == SYM_STRUCT and (symtable.symbols.data[ss].flags & SYM_FLAG_PUB) != 0 as u16:
            let st_tid = symtable.symbols.data[ss].type_id
            if st_tid != 0 as u32 and (st_tid as i64) < types.entries.len and types.entries.data[st_tid].kind == TYPE_KIND_STRUCT:
                let s_extra = types.entries.data[st_tid].extra
                if (s_extra as i64) < types.structs.len:
                    let sinfo = &types.structs.data[s_extra]
                    mut all_prim := sinfo.fields.len > 0
                    mut fk := 0 as i64
                    while fk < sinfo.fields.len:
                        if iface_token_to_type(iface_type_token(types, sinfo.fields.data[fk].type_id, pool)) == TYPE_UNKNOWN:
                            all_prim = false
                        fk = fk + 1
                    if all_prim:
                        let st_name = pool.get(symtable.symbols.data[ss].name_id)
                        if std.string.len(st_name) > 0:
                            iface_push_str(&bv, "S ")
                            iface_push_str(&bv, st_name)
                            push_byte(&bv, ' ' as u8)
                            iface_push_int(&bv, sinfo.fields.len)
                            mut fm := 0 as i64
                            while fm < sinfo.fields.len:
                                push_byte(&bv, ' ' as u8)
                                iface_push_str(&bv, pool.get(sinfo.fields.data[fm].name_id))
                                push_byte(&bv, ' ' as u8)
                                iface_push_str(&bv, iface_type_token(types, sinfo.fields.data[fm].type_id, pool))
                                fm = fm + 1
                            push_byte(&bv, 0x0A as u8)
        ss = ss + 1
    mut si := 0 as i64
    while si < symtable.symbols.len:
        let sym_kind = symtable.symbols.data[si].kind
        let sym_flags = symtable.symbols.data[si].flags
        let sym_tid = symtable.symbols.data[si].type_id
        // RFC 0011 P4 inc4a: export a public integer const as `C <name> <type> <value>` so a
        // consumer can inline it without the library source. Only INT_LIT initializers of a
        // primitive-int type round-trip today (non-negative, <2^32); anything else is skipped.
        if sym_kind == SYM_CONST and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            let c_decl = symtable.symbols.data[si].decl_node
            let c_tok = iface_type_token(types, sym_tid, pool)
            if c_decl != 0 as u32 and (c_decl as i64) < tree.nodes.len and c_tok != "?":
                mut c_init := 0 as u32
                mut c_child := tree.nodes.data[c_decl as i64].first_child
                while c_child != 0 as u32 and (c_child as i64) < tree.nodes.len:
                    let ccn = tree.nodes.data[c_child as i64]
                    if ccn.kind != NODE_TYPE_EXPR and ccn.kind != NODE_GENERIC_TYPE:
                        c_init = c_child
                    c_child = ccn.next_sibling
                if c_init != 0 as u32 and tree.nodes.data[c_init as i64].kind == NODE_INT_LIT:
                    let c_tok_idx = tree.nodes.data[c_init as i64].token_idx
                    let c_ltok = tree.tokens.data[c_tok_idx as i64]
                    if c_ltok.len != 0 as u16:
                        let c_sp = ((get_str_ptr(tree.src)) as i64 + c_ltok.offset as i64) as ptr[u8]
                        let c_txt = alloc_str_from_raw(c_sp, c_ltok.len as i64)
                        let c_val = parse_int_from_str(c_txt)
                        @free(get_str_ptr(c_txt))
                        let c_name = pool.get(symtable.symbols.data[si].name_id)
                        if std.string.len(c_name) > 0:
                            iface_push_str(&bv, "C ")
                            iface_push_str(&bv, c_name)
                            push_byte(&bv, ' ' as u8)
                            iface_push_str(&bv, c_tok)
                            push_byte(&bv, ' ' as u8)
                            iface_push_int(&bv, c_val)
                            push_byte(&bv, 0x0A as u8)
        if sym_kind == SYM_FUNC and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            if (sym_tid as i64) < types.entries.len and types.entries.data[sym_tid].kind == TYPE_KIND_FUNC:
                let f_idx = types.entries.data[sym_tid].extra
                if (f_idx as i64) < types.funcs.len:
                    let fi = &types.funcs.data[f_idx]
                    let name = pool.get(symtable.symbols.data[si].name_id)
                    if std.string.len(name) > 0:
                        iface_push_str(&bv, "F ")
                        iface_push_str(&bv, name)
                        push_byte(&bv, ' ' as u8)
                        iface_push_int(&bv, fi.params.len)
                        mut pi := 0 as i64
                        while pi < fi.params.len:
                            push_byte(&bv, ' ' as u8)
                            iface_push_str(&bv, iface_type_token(types, fi.params.data[pi], pool))
                            pi = pi + 1
                        iface_push_str(&bv, " -> ")
                        iface_push_str(&bv, iface_type_token(types, fi.ret, pool))
                        push_byte(&bv, 0x0A as u8)
        si = si + 1
    return alloc_str_from_raw(bv.data, bv.len)

// RFC 0011 P4 (increment 3f): generate an FFI wrapper module for a produced DLL. For each
// `#[export]`ed function it emits `pub extern "C" from "<dll>" fn <name>(p0: T0, …) -> T`,
// so a consumer `import`s ONE wrapper instead of hand-writing an extern per function. Types
// use the interface tokens (primitive sigs today). `dll_filename` is the bare DLL name used
// in the `from` clause (resolved by the OS loader at runtime). When `export_all` is true
// (a `library`-marked module) every pub fn is bound so the wrapper matches the DLL's full
// public API; otherwise only `#[export]`ed functions are bound (RFC 0009 P2 behavior).
pub fn build_dll_wrapper_text(symtable: ptr[SymbolTable], pool: ptr[InternPool], types: ptr[TypeTable], dll_filename: str, export_all: bool) -> str:
    mut bv := new_byte_vec()
    iface_push_str(&bv, "// Auto-generated FFI bindings for ")
    iface_push_str(&bv, dll_filename)
    iface_push_str(&bv, " (RFC 0011 P4). `import` this module to call the DLL by name.\n")
    mut si := 0 as i64
    while si < symtable.symbols.len:
        let sym_kind = symtable.symbols.data[si].kind
        let sym_flags = symtable.symbols.data[si].flags
        let sym_tid = symtable.symbols.data[si].type_id
        let sym_nid = symtable.symbols.data[si].name_id
        if sym_kind == SYM_FUNC and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            mut is_exp := export_all
            if not export_all:
                mut ek := 0 as i64
                while ek < symtable.export_syms.len:
                    if symtable.export_syms.data[ek] == sym_nid:
                        is_exp = true
                    ek = ek + 1
            if is_exp and (sym_tid as i64) < types.entries.len and types.entries.data[sym_tid].kind == TYPE_KIND_FUNC:
                let f_idx = types.entries.data[sym_tid].extra
                if (f_idx as i64) < types.funcs.len:
                    let fi = &types.funcs.data[f_idx]
                    let name = pool.get(sym_nid)
                    if std.string.len(name) > 0:
                        iface_push_str(&bv, "pub extern \"C\" from \"")
                        iface_push_str(&bv, dll_filename)
                        iface_push_str(&bv, "\" fn ")
                        iface_push_str(&bv, name)
                        push_byte(&bv, '(' as u8)
                        mut pi := 0 as i64
                        while pi < fi.params.len:
                            if pi > 0:
                                iface_push_str(&bv, ", ")
                            iface_push_str(&bv, "p")
                            iface_push_int(&bv, pi)
                            iface_push_str(&bv, ": ")
                            iface_push_str(&bv, iface_type_token(types, fi.params.data[pi], pool))
                            pi = pi + 1
                        push_byte(&bv, ')' as u8)
                        if fi.ret != TYPE_VOID:
                            iface_push_str(&bv, " -> ")
                            iface_push_str(&bv, iface_type_token(types, fi.ret, pool))
                        push_byte(&bv, 0x0A as u8)
        si = si + 1
    return alloc_str_from_raw(bv.data, bv.len)

// Wrap a compiled `.obj` into a single-member COFF archive with a first-linker-member
// symbol index (all defined symbols → the one object member). Also writes a binary
// staleness manifest `<out>.manifest` (RFC 0011 §3.4). `iface_text`, when non-empty,
// is written verbatim as the `__axiom_iface` member (RFC 0011 P4); empty falls back to
// the exported-symbol list (increment-1 behavior).
pub fn axiom_write_static_lib(obj_path: str, out_path: str, src_hash: u64, iface_text: str) -> bool:
    let path_nt = x86_str_to_null_terminated(obj_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        ax_puts_local("Error: staticlib could not open object file")
        return false
    fseek(f, 0, 2)
    let osize = ftell(f)
    rewind(f)
    let obuf = @alloc(osize) as ptr[u8]
    fread(obuf as ptr[void], 1, osize, f)
    fclose(f)

    // Collect defined symbol names (the archive's exports).
    let obj = linker_parse_coff(obuf, osize)
    mut symnames := new_linker_str_vec()
    mut si := 0 as i64
    while si < obj.symbols.len:
        let sym = &obj.symbols.data[si]
        if sym.defined and is_valid_symbol_name(sym.name):
            add_unique_import(&symnames, sym.name)
        si = si + 1

    // Layout: [8 magic][60 idx-hdr][idx-data(+pad)][60 obj-hdr][obj-data(+pad)]
    mut idx_data := 4 as i64 + symnames.len * 4
    mut sn := 0 as i64
    while sn < symnames.len:
        idx_data = idx_data + std.string.len(symnames.data[sn]) + 1
        sn = sn + 1
    mut idx_pad := 0 as i64
    if idx_data % 2 != 0:
        idx_pad = 1
    let obj_member_off = 8 as i64 + 60 + idx_data + idx_pad

    mut ar := new_byte_vec()
    let magic = "!<arch>\n"
    let mp = get_str_ptr(magic)
    mut mi := 0 as i64
    while mi < 8:
        push_byte(&ar, mp[mi])
        mi = mi + 1
    // First linker member: symbol index (name "/").
    ar_write_header(&ar, "/", idx_data)
    push_u32_be(&ar, symnames.len as u32)
    sn = 0
    while sn < symnames.len:
        push_u32_be(&ar, obj_member_off as u32)
        sn = sn + 1
    sn = 0
    while sn < symnames.len:
        let nm = symnames.data[sn]
        let np = get_str_ptr(nm)
        let nl = std.string.len(nm)
        mut c := 0 as i64
        while c < nl:
            push_byte(&ar, np[c])
            c = c + 1
        push_byte(&ar, 0 as u8)
        sn = sn + 1
    if idx_pad == 1:
        push_byte(&ar, 0x0A as u8)
    // Object member.
    ar_write_header(&ar, "axiom.o/", osize)
    push_bytes(&ar, obuf, osize)
    if osize % 2 != 0:
        push_byte(&ar, 0x0A as u8)

    // RFC 0011 P4 (increment 1): self-describing interface member. Placed LAST so the
    // symbol-index offsets (which point at the object member) are unaffected. The `ar`
    // member name begins with "__" so the P2 consumer loop skips it (not linkable code).
    // v1 payload is the archive's exported-symbol list; real type signatures land in
    // increment 2. The member is additive — omitting/ignoring it changes nothing.
    mut iface := new_byte_vec()
    if std.string.len(iface_text) > 0:
        // P4 inc2: real signatures built by the caller (build_lib_iface_text).
        let itp = get_str_ptr(iface_text)
        let itl = std.string.len(iface_text)
        mut iti := 0 as i64
        while iti < itl:
            push_byte(&iface, itp[iti])
            iti = iti + 1
    else:
        // inc1 fallback: exported-symbol list.
        let ihdr = "AXIFACE1\n"
        let ihp = get_str_ptr(ihdr)
        mut ihi := 0 as i64
        while ihi < std.string.len(ihdr):
            push_byte(&iface, ihp[ihi])
            ihi = ihi + 1
        mut isn := 0 as i64
        while isn < symnames.len:
            push_byte(&iface, 'S' as u8)
            push_byte(&iface, ' ' as u8)
            let inm = symnames.data[isn]
            let inp = get_str_ptr(inm)
            let inl = std.string.len(inm)
            mut ic := 0 as i64
            while ic < inl:
                push_byte(&iface, inp[ic])
                ic = ic + 1
            push_byte(&iface, 0x0A as u8)
            isn = isn + 1
    ar_write_header(&ar, "__axiom_iface/", iface.len)
    push_bytes(&ar, iface.data, iface.len)
    if iface.len % 2 != 0:
        push_byte(&ar, 0x0A as u8)
    if iface.data != null as ptr[u8]:
        @free(iface.data)

    let out_nt = x86_str_to_null_terminated(out_path)
    let of = fopen(out_nt as ptr[void], get_str_ptr("wb"))
    @free(out_nt)
    if of == null as ptr[void]:
        ax_puts_local("Error: staticlib could not write output file")
        return false
    fwrite(ar.data as ptr[void], 1, ar.len, of)
    fclose(of)

    // Staleness manifest: hash of the SOURCE (passed in) so an unchanged source
    // reuses the .lib (RFC 0011 §3.4). Falls back to the object hash if 0.
    mut h := src_hash
    if h == 0 as u64:
        h = 5381 as u64
        mut hi := 0 as i64
        while hi < osize:
            h = ((h << 5 as u64) + h) + obuf[hi] as u64
            hi = hi + 1
    let man_path = std.string.concat(out_path, ".manifest")
    let man_nt = x86_str_to_null_terminated(man_path)
    let mf = fopen(man_nt as ptr[void], get_str_ptr("wb"))
    @free(man_nt)
    if mf != null as ptr[void]:
        mut man := new_byte_vec()
        let hdr = "AXLIB1\n"
        let hp = get_str_ptr(hdr)
        mut hj := 0 as i64
        while hj < std.string.len(hdr):
            push_byte(&man, hp[hj])
            hj = hj + 1
        push_u32_le(&man, (h & 0xFFFFFFFF as u64) as u32)
        push_u32_le(&man, ((h >> 32 as u64) & 0xFFFFFFFF as u64) as u32)
        fwrite(man.data as ptr[void], 1, man.len, mf)
        fclose(mf)
        if man.data != null as ptr[u8]:
            @free(man.data)

    @free(obuf)
    if ar.data != null as ptr[u8]:
        @free(ar.data)
    return true

// RFC 0011 P4 (increment 1): locate the `__axiom_iface` member in a `.lib` archive and
// print its raw payload to stdout. Round-trip verifier for the interface writer above;
// later increments replace the printing with in-memory interface reconstruction. Returns
// false if the file is unreadable, not an archive, or carries no interface member.
pub fn axiom_read_lib_iface(lib_path: str) -> bool:
    let path_nt = x86_str_to_null_terminated(lib_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        ax_puts_local("Error: iface could not open .lib")
        return false
    fseek(f, 0, 2)
    let size = ftell(f)
    rewind(f)
    let buf = @alloc(size) as ptr[u8]
    fread(buf as ptr[void], 1, size, f)
    fclose(f)
    if size < 8 or buf[0] != '!' as u8 or buf[1] != '<' as u8:
        ax_puts_local("Error: not a COFF !<arch> library")
        @free(buf)
        return false
    mut apos := 8 as i64
    mut found := false
    while apos + 60 <= size:
        mut msize := 0 as i64
        mut dd := 0 as i64
        while dd < 10:
            let ch = buf[apos + 48 as i64 + dd]
            if ch >= '0' as u8 and ch <= '9' as u8:
                msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
            dd = dd + 1
        let data_off = apos + 60 as i64
        // Member name (offset 0, slash-terminated) — match "__axiom_iface".
        if buf[apos] == '_' as u8 and buf[apos + 1 as i64] == '_' as u8:
            print_raw_ptr((buf as i64 + data_off) as ptr[u8], msize)
            found = true
        apos = data_off + msize
        if msize % 2 as i64 != 0:
            apos = apos + 1
    @free(buf)
    if not found:
        ax_puts_local("Error: no __axiom_iface member in library")
    return found

// ── RFC 0011 P4 (increment 3a): the interface READER ─────────────────────────────
// Inverse of build_lib_iface_text — parses the `__axiom_iface` payload back into an
// in-memory signature list. This is what the import-driven resolver (inc3b) will consume
// to typecheck an app against a precompiled `.lib` without touching the library source.

// One parsed public function signature. `params`/`ret` are reconstructed TypeIDs.
pub struct IfaceFunc:
    name: str
    params: U32Vec
    ret: u32

pub struct IfaceFuncVec:
    data: ptr[IfaceFunc]
    len: i64
    cap: i64

pub fn new_iface_func_vec() -> IfaceFuncVec:
    return IfaceFuncVec(data: null as ptr[IfaceFunc], len: 0, cap: 0)

pub fn push_iface_func(mut self: ptr[IfaceFuncVec], f: IfaceFunc):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[IfaceFunc]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[IfaceFunc]
        if self.data != null as ptr[IfaceFunc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = f
    self.len = self.len + 1

// RFC 0011 P4 inc4a: one parsed public integer constant (`C <name> <type> <value>`).
pub struct IfaceConst:
    name: str
    type_id: u32
    value: i64

pub struct IfaceConstVec:
    data: ptr[IfaceConst]
    len: i64
    cap: i64

pub fn new_iface_const_vec() -> IfaceConstVec:
    return IfaceConstVec(data: null as ptr[IfaceConst], len: 0, cap: 0)

pub fn push_iface_const(mut self: ptr[IfaceConstVec], c: IfaceConst):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[IfaceConst]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[IfaceConst]
        if self.data != null as ptr[IfaceConst]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = c
    self.len = self.len + 1

// Inverse of iface_type_token: map an interface token back to a stable primitive TypeID.
// Non-primitive tokens ("ptr"/"slice"/"?") reconstruct to TYPE_UNKNOWN for now — inc4
// will carry the pointee/struct so they round-trip exactly.
pub fn iface_token_to_type(tok: str) -> u32:
    if tok == "i8":
        return TYPE_I8
    if tok == "i16":
        return TYPE_I16
    if tok == "i32":
        return TYPE_I32
    if tok == "i64":
        return TYPE_I64
    if tok == "u8":
        return TYPE_U8
    if tok == "u16":
        return TYPE_U16
    if tok == "u32":
        return TYPE_U32
    if tok == "u64":
        return TYPE_U64
    if tok == "f32":
        return TYPE_F32
    if tok == "f64":
        return TYPE_F64
    if tok == "bool":
        return TYPE_BOOL
    if tok == "string":
        return TYPE_STRING
    if tok == "char8":
        return TYPE_CHAR8
    if tok == "void":
        return TYPE_VOID
    if tok == "isize":
        return TYPE_ISIZE
    if tok == "usize":
        return TYPE_USIZE
    return TYPE_UNKNOWN

// Parse a base-10 token to i64 (defensive: stops at first non-digit).
fn iface_atoi(s: str) -> i64:
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut v := 0 as i64
    mut i := 0 as i64
    while i < n:
        if p[i] >= '0' as u8 and p[i] <= '9' as u8:
            v = v * 10 as i64 + (p[i] as i64 - '0' as i64)
        i = i + 1
    return v

// Split a byte range [start,end) into whitespace-delimited token strings.
fn iface_line_tokens(p: ptr[u8], start: i64, end: i64) -> LinkerStrVec:
    mut toks := new_linker_str_vec()
    mut k := start
    while k < end:
        while k < end and p[k] == ' ' as u8:
            k = k + 1
        if k >= end:
            break
        let ts = k
        while k < end and p[k] != ' ' as u8:
            k = k + 1
        push_linker_str(&toks, alloc_str_from_raw((p as i64 + ts) as ptr[u8], k - ts))
    return toks

// Read the raw `__axiom_iface` payload of a .lib as a heap string ("" if absent).
pub fn read_lib_iface_bytes(lib_path: str) -> str:
    let path_nt = x86_str_to_null_terminated(lib_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        return ""
    fseek(f, 0, 2)
    let size = ftell(f)
    rewind(f)
    let buf = @alloc(size) as ptr[u8]
    fread(buf as ptr[void], 1, size, f)
    fclose(f)
    if size < 8 or buf[0] != '!' as u8 or buf[1] != '<' as u8:
        @free(buf)
        return ""
    mut apos := 8 as i64
    mut out := ""
    while apos + 60 <= size:
        mut msize := 0 as i64
        mut dd := 0 as i64
        while dd < 10:
            let ch = buf[apos + 48 as i64 + dd]
            if ch >= '0' as u8 and ch <= '9' as u8:
                msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
            dd = dd + 1
        let data_off = apos + 60 as i64
        if buf[apos] == '_' as u8 and buf[apos + 1 as i64] == '_' as u8:
            out = alloc_str_from_raw((buf as i64 + data_off) as ptr[u8], msize)
        apos = data_off + msize
        if msize % 2 as i64 != 0:
            apos = apos + 1
    @free(buf)
    return out

// Parse a `.lib`'s interface member into a signature list. Recognizes "F <name> <n>
// <p0>..<pn-1> -> <ret>" lines; ignores the AXIFACE1 header and the inc1 "S" fallback.
pub fn parse_lib_iface(lib_path: str) -> IfaceFuncVec:
    mut result := new_iface_func_vec()
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    if n == 0:
        return result
    let p = get_str_ptr(text)
    mut i := 0 as i64
    while i < n:
        mut j := i
        while j < n and p[j] != 0x0A as u8:
            j = j + 1
        let toks = iface_line_tokens(p, i, j)
        if toks.len >= 4 and toks.data[0] == "F":
            let name = toks.data[1]
            let nparams = iface_atoi(toks.data[2])
            mut fn_params := new_u32_vec()
            mut t := 3 as i64
            mut pc := 0 as i64
            while pc < nparams and t < toks.len:
                fn_params.push(iface_token_to_type(toks.data[t]))
                t = t + 1
                pc = pc + 1
            mut ret := TYPE_VOID
            if t < toks.len and toks.data[t] == "->":
                t = t + 1
            if t < toks.len:
                ret = iface_token_to_type(toks.data[t])
            push_iface_func(&result, IfaceFunc(name: name, params: fn_params, ret: ret))
        i = j + 1
    return result

// RFC 0011 P4 inc4a: parse the `C <name> <type> <value>` const lines of a `.lib` interface
// into a value list, so a consumer can register + inline library constants without source.
pub fn parse_lib_iface_consts(lib_path: str) -> IfaceConstVec:
    mut result := new_iface_const_vec()
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    if n == 0:
        return result
    let p = get_str_ptr(text)
    mut i := 0 as i64
    while i < n:
        mut j := i
        while j < n and p[j] != 0x0A as u8:
            j = j + 1
        let toks = iface_line_tokens(p, i, j)
        if toks.len >= 4 and toks.data[0] == "C":
            let name = toks.data[1]
            let type_id = iface_token_to_type(toks.data[2])
            let value = iface_atoi(toks.data[3])
            push_iface_const(&result, IfaceConst(name: name, type_id: type_id, value: value))
        i = j + 1
    return result

// Round-trip self-check for the `iface` verb: dump the raw payload, then re-emit the
// signatures FROM the parsed in-memory form (via iface_type_token) so a match proves the
// reader reconstructs what the writer produced.
pub fn axiom_check_lib_iface(lib_path: str, types: ptr[TypeTable]) -> bool:
    let ok = axiom_read_lib_iface(lib_path)
    if not ok:
        return false
    ax_puts_local("=== parsed (reader round-trip) ===")
    let funcs = parse_lib_iface(lib_path)
    mut i := 0 as i64
    while i < funcs.len:
        let f = &funcs.data[i]
        mut line := new_byte_vec()
        iface_push_str(&line, "F ")
        iface_push_str(&line, f.name)
        push_byte(&line, ' ' as u8)
        iface_push_int(&line, f.params.len)
        mut pi := 0 as i64
        while pi < f.params.len:
            push_byte(&line, ' ' as u8)
            iface_push_str(&line, iface_type_token(types, f.params.data[pi], null as ptr[InternPool]))
            pi = pi + 1
        iface_push_str(&line, " -> ")
        iface_push_str(&line, iface_type_token(types, f.ret, null as ptr[InternPool]))
        push_byte(&line, 0x0A as u8)
        print_raw_ptr(line.data, line.len)
        if line.data != null as ptr[u8]:
            @free(line.data)
        i = i + 1
    return true

pub fn axiom_linker_link(self: ptr[AxiomLinker]) -> bool:
    mut objects := new_parsed_object_ptr_vec()
    mut format := "coff"
    mut kernel32_iat_offset := 0 as i64
    mut iat_offset := 0 as i64
    mut total_iat_size := 0 as i64
    
    // 1. Load and parse all object files
    mut i := 0 as i64
    while i < self.input_files.len:
        let path = self.input_files.data[i]
        let path_nt = x86_str_to_null_terminated(path)
        let file = fopen(path_nt as ptr[void], get_str_ptr("rb"))
        @free(path_nt)
        if file == null as ptr[void]:
            ax_puts_local("Error: Linker could not open input file: ")
            ax_puts_local(path)
            return false
            
        fseek(file, 0, 2)
        let size = ftell(file)
        rewind(file)
        
        if size <= 4:
            ax_puts_local("Error: Input file too small: ")
            ax_puts_local(path)
            fclose(file)
            return false
            
        let buffer = @alloc(size) as ptr[u8]
        fread(buffer as ptr[void], 1, size, file)
        fclose(file)
        
        mut obj := null as ptr[ParsedObject]
        if buffer[0] == '!' as u8 and buffer[1] == '<' as u8:
            // RFC 0011 P2: COFF !<arch> static library — pull all member objects.
            // (Single-member archives today; whole-archive inclusion, dead-strip later.)
            format = "coff"
            mut apos := 8 as i64
            while apos + 60 <= size:
                mut msize := 0 as i64
                mut dd := 0 as i64
                while dd < 10:
                    let ch = buffer[apos + 48 as i64 + dd]
                    if ch >= '0' as u8 and ch <= '9' as u8:
                        msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
                    dd = dd + 1
                let data_off = apos + 60 as i64
                // Skip special members: "/" (symbol index), "//" (long names), and any
                // "__"-prefixed AXIOM metadata member (e.g. "__axiom_iface") — not code.
                if buffer[apos] != '/' as u8 and not (buffer[apos] == '_' as u8 and buffer[apos + 1 as i64] == '_' as u8):
                    let mobj = linker_parse_coff((buffer as i64 + data_off) as ptr[u8], msize)
                    push_parsed_object_ptr(&objects, mobj)
                apos = data_off + msize
                if msize % 2 as i64 != 0:
                    apos = apos + 1
        elif buffer[0] == 0x7F as u8 and buffer[1] == 'E' as u8 and buffer[2] == 'L' as u8 and buffer[3] == 'F' as u8:
            obj = linker_parse_elf(buffer, size)
            format = "elf64"
        elif read_u16_le(buffer, 0) == 0x8664 as u16:
            obj = linker_parse_coff(buffer, size)
            format = "coff"
        else:
            ax_puts_local("Error: Unsupported object format in: ")
            ax_puts_local(path)
            @free(buffer)
            return false

        @free(buffer)
        if obj != null as ptr[ParsedObject]:
            push_parsed_object_ptr(&objects, obj)
        i = i + 1
        
    // 2. Pre-scan defined functions and dynamic imports (to determine base address & stubs early)
    mut func_names := new_linker_str_vec()
    
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut sym_i := 0 as i64
        while sym_i < obj.symbols.len:
            let sym = &obj.symbols.data[sym_i]
            // RFC 0017 / BUG#82: section-3 (.data global) symbols are added to
            // func_names/func_offsets LATER, after the writable data region is laid out
            // (their image RVA is not known yet). Skip here to keep the two arrays parallel.
            // RFC 0030 P3: section 4 (.bss) is excluded here for the same reason section 3
            // is — these passes treat a symbol's offset as a TEXT offset, and a global's
            // offset is relative to its own region. Letting .bss through resolved every
            // OP_GLOBAL_ADDR to a code address and segfaulted on first access.
            if sym.defined and sym.section != 3 as i64 and sym.section != 4 as i64:
                push_linker_str(&func_names, sym.name)
            sym_i = sym_i + 1
        i = i + 1

    mut kernel32_imports := new_linker_str_vec()
    mut ax_runtime_imports := new_linker_str_vec()
    mut ucrtbase_imports := new_linker_str_vec()
    mut user_buckets := new_user_dll_bucket_vec() // RFC 0009: per-DLL user extern imports

    // RFC 0017 / BUG#82: names of module-level global data symbols (COFF section 3). A
    // reloc targeting one of these is a DEFINED reference (its VA is resolved later, once
    // the writable data region is laid out inside .idata), NOT a dynamic import — so the
    // import classifier below must skip them.
    mut global_names := new_linker_str_vec()
    mut gi_scan := 0 as i64
    while gi_scan < objects.len:
        let gobj = objects.data[gi_scan]
        mut gs := 0 as i64
        while gs < gobj.symbols.len:
            let gsym = &gobj.symbols.data[gs]
            if gsym.defined and gsym.section == 3 as i64:
                push_linker_str(&global_names, gsym.name)
            gs = gs + 1
        gi_scan = gi_scan + 1

    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut r_i := 0 as i64
        while r_i < obj.relocs.len:
            let r = &obj.relocs.data[r_i]
            if r.sym_idx < obj.sym_names.len as u32:
                let target_name = obj.sym_names.data[r.sym_idx]
                if target_name != "" and target_name != "main" and target_name != "_AX_main_main_v_v" and is_valid_symbol_name(target_name):
                    mut is_defined := false
                    mut search := 0 as i64
                    while search < func_names.len:
                        if func_names.data[search] == target_name:
                            is_defined = true
                            break
                        search = search + 1

                    if not is_defined:
                        mut gsearch := 0 as i64
                        while gsearch < global_names.len:
                            if global_names.data[gsearch] == target_name:
                                is_defined = true
                                break
                            gsearch = gsearch + 1

                    if not is_defined:
                        let user_dll = user_dll_for_symbol(self, target_name)
                        if user_dll != "":
                            // RFC 0009: explicit `extern "C" from "x.dll"` binding.
                            let ub = user_bucket_find_or_add(&user_buckets, user_dll)
                            add_unique_import(&user_buckets.data[ub].imports, target_name)
                        else:
                            let dll = get_dll_for_symbol(target_name)
                            let name_nt = x86_str_to_null_terminated(target_name)
                            ax_printf_local("[Debug Linker Import] DLL=%s, symbol=%s\n", get_str_ptr(dll) as i64, name_nt as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            @free(name_nt)
                            if dll == "kernel32.dll":
                                add_unique_import(&kernel32_imports, target_name)
                            elif dll == "ax_runtime.dll":
                                add_unique_import(&ax_runtime_imports, target_name)
                            elif dll == "none" or dll == "":
                                // Skip dynamic import for dummy/clashed field symbols
                                is_defined = true
                            else:
                                add_unique_import(&ucrtbase_imports, target_name)

            r_i = r_i + 1
        i = i + 1
        
    // RFC 0009 P3 Linux: the kernel32 bucket (dead code behind folded is_windows
    // branches) and the ax_runtime.dll bucket (freestanding AXIOM twins are bundled
    // in-program and bound by the ax_-twin fallback in the resolve pass) must NOT become
    // ELF dynamic imports — the PLT here has no lazy-resolver stub, so .dynamic carries
    // DT_BIND_NOW and ld.so would abort the load on any unresolvable name. Only the
    // libc bucket (ucrtbase on Windows) is a real DT_NEEDED dependency on Linux.
    if format == "elf64":
        kernel32_imports.len = 0
        ax_runtime_imports.len = 0

    mut thunk_count := kernel32_imports.len + ax_runtime_imports.len + ucrtbase_imports.len
    // RFC 0009: user-DLL imports also get thunks + IAT slots
    mut user_total_imports := 0 as i64
    mut ubc_i := 0 as i64
    while ubc_i < user_buckets.len:
        user_total_imports = user_total_imports + user_buckets.data[ubc_i].imports.len
        ubc_i = ubc_i + 1
    thunk_count = thunk_count + user_total_imports
    
    // 3. Section Layout
    mut merged_code := new_byte_vec()
    mut base_addr := 0x140001000 as u64 // code starts at 0x140001000 for PE
    if format == "elf64":
        if thunk_count > 0:
            base_addr = 0x400200 as u64 // ELF code starts at 0x400200 if we have 512 bytes headers
        else:
            base_addr = 0x400080 as u64 // ELF code starts at 0x400080 if 128 bytes headers
            
    mut func_offsets := new_parsed_reloc_vec() // piggyback on ParsedReloc to store offsets
    
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        obj.va = base_addr + merged_code.len as u64
        
        mut sym_i := 0 as i64
        while sym_i < obj.symbols.len:
            let sym = &obj.symbols.data[sym_i]
            // RFC 0017 / BUG#82: skip section-3 globals (added after data-region layout).
            // RFC 0030 P3: section 4 (.bss) is excluded here for the same reason section 3
            // is — these passes treat a symbol's offset as a TEXT offset, and a global's
            // offset is relative to its own region. Letting .bss through resolved every
            // OP_GLOBAL_ADDR to a code address and segfaulted on first access.
            if sym.defined and sym.section != 3 as i64 and sym.section != 4 as i64:
                mut offset_va := sym.offset
                if sym.section == 2: // .rdata
                    offset_va = obj.text.len as u64 + sym.offset
                push_parsed_reloc(&func_offsets, ParsedReloc(offset: (merged_code.len as u64 + offset_va) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
            sym_i = sym_i + 1

        push_bytes(&merged_code, obj.text.data, obj.text.len)
        push_bytes(&merged_code, obj.rdata.data, obj.rdata.len)
        i = i + 1
        
    mut thunks_offset := (merged_code.len + 15) & ~15
    mut thunks_rva := 0x1000 as u32 + thunks_offset as u32
    mut thunks_size := thunk_count * 6
    
    mut idata_rva := (0x1000 as i64 + thunks_offset + thunks_size as i64 + 4095) & ~4095
    
    // Construct .idata and thunks for COFF
    mut idata_buf := new_byte_vec()
    // RFC 0030 P3: total virtual extent of the writable region INCLUDING the zero-filled
    // .bss tail. Stays 0 when no object carries .bss, which is what keeps existing output
    // byte-identical (the header code then falls back to the raw size, exactly as before).
    mut bss_virt_extent := 0 as i64
    mut dyn_sym_names := new_linker_str_vec()
    mut dyn_sym_rvas := null as ptr[u32]
    
    mut kernel32_hn_rvas := null as ptr[u32]
    mut ax_runtime_hn_rvas := null as ptr[u32]
    mut ucrtbase_hn_rvas := null as ptr[u32]
    
    if format == "coff" and thunk_count > 0:
        dyn_sym_rvas = @alloc(thunk_count * 4) as ptr[u32]
        
        let has_kernel32 = kernel32_imports.len > 0
        let has_ax_runtime = ax_runtime_imports.len > 0
        let has_ucrtbase = ucrtbase_imports.len > 0
        mut K := 0 as i64
        if has_kernel32:
            K = K + 1
        if has_ax_runtime:
            K = K + 1
        if has_ucrtbase:
            K = K + 1
        K = K + user_buckets.len // RFC 0009: one IDT descriptor per user DLL

        let idt_size = (K + 1) * 20
        iat_offset = (idt_size + 7) & ~7
        
        mut kernel32_iat_offset := 0 as i64
        mut kernel32_iat_size := 0 as i64
        mut ax_runtime_iat_offset := iat_offset
        mut ax_runtime_iat_size := 0 as i64
        mut ucrtbase_iat_offset := iat_offset
        mut ucrtbase_iat_size := 0 as i64
        
        mut cur_iat_offset := iat_offset
        
        if has_kernel32:
            kernel32_iat_offset = cur_iat_offset
            kernel32_iat_size = (kernel32_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + kernel32_iat_size
            
        if has_ax_runtime:
            ax_runtime_iat_offset = cur_iat_offset
            ax_runtime_iat_size = (ax_runtime_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + ax_runtime_iat_size
            
        if has_ucrtbase:
            ucrtbase_iat_offset = cur_iat_offset
            ucrtbase_iat_size = (ucrtbase_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + ucrtbase_iat_size

        mut ub_i := 0 as i64
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].iat_offset = cur_iat_offset
            cur_iat_offset = cur_iat_offset + (user_buckets.data[ub_i].imports.len + 1) * 8
            ub_i = ub_i + 1

        total_iat_size = cur_iat_offset - iat_offset
        let ilt_offset = iat_offset + total_iat_size
        mut cur_ilt_offset := ilt_offset
        
        mut kernel32_ilt_offset := 0 as i64
        mut kernel32_ilt_size := 0 as i64
        if has_kernel32:
            kernel32_ilt_offset = cur_ilt_offset
            kernel32_ilt_size = (kernel32_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + kernel32_ilt_size
            
        mut ax_runtime_ilt_offset := 0 as i64
        mut ax_runtime_ilt_size := 0 as i64
        if has_ax_runtime:
            ax_runtime_ilt_offset = cur_ilt_offset
            ax_runtime_ilt_size = (ax_runtime_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + ax_runtime_ilt_size
            
        mut ucrtbase_ilt_offset := 0 as i64
        mut ucrtbase_ilt_size := 0 as i64
        if has_ucrtbase:
            ucrtbase_ilt_offset = cur_ilt_offset
            ucrtbase_ilt_size = (ucrtbase_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + ucrtbase_ilt_size

        ub_i = 0
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].ilt_offset = cur_ilt_offset
            cur_ilt_offset = cur_ilt_offset + (user_buckets.data[ub_i].imports.len + 1) * 8
            ub_i = ub_i + 1

        let total_ilt_size = cur_ilt_offset - ilt_offset
        let dll_names_offset = ilt_offset + total_ilt_size
        mut cur_offset := dll_names_offset
        
        mut kernel32_name_offset := 0 as i64
        if has_kernel32:
            kernel32_name_offset = cur_offset
            cur_offset = cur_offset + 13
            
        mut ax_runtime_name_offset := 0 as i64
        if has_ax_runtime:
            ax_runtime_name_offset = cur_offset
            cur_offset = cur_offset + 15
            
        mut ucrtbase_name_offset := 0 as i64
        if has_ucrtbase:
            ucrtbase_name_offset = cur_offset
            cur_offset = cur_offset + 13

        ub_i = 0
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].name_offset = cur_offset
            cur_offset = cur_offset + std.string.len(user_buckets.data[ub_i].name) + 1
            ub_i = ub_i + 1

        mut hint_name_start_offset := cur_offset
        if hint_name_start_offset % 2 != 0:
            hint_name_start_offset = hint_name_start_offset + 1
        
        
        // Pre-fill idata_buf with zeros
        mut zero_i := 0 as i64
        while zero_i < hint_name_start_offset as i64:
            push_byte(&idata_buf, 0 as u8)
            zero_i = zero_i + 1
            
        if has_kernel32:
            kernel32_hn_rvas = @alloc(kernel32_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < kernel32_imports.len:
                kernel32_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = kernel32_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
                
        if has_ax_runtime:
            ax_runtime_hn_rvas = @alloc(ax_runtime_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < ax_runtime_imports.len:
                ax_runtime_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = ax_runtime_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
                
        if has_ucrtbase:
            ucrtbase_hn_rvas = @alloc(ucrtbase_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < ucrtbase_imports.len:
                ucrtbase_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = ucrtbase_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1

        // RFC 0009: hint-name entries for user-DLL imports
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let nimp = imp.len
            let hn = @alloc(nimp * 4) as ptr[u32]
            user_buckets.data[ub_i].hn_rvas = hn
            mut j := 0 as i64
            while j < nimp:
                hn[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = imp.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
            ub_i = ub_i + 1

        // Write active DLL names
        if has_kernel32:
            let name_ptr = "kernel32.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 12:
                idata_buf.data[kernel32_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[kernel32_name_offset as i64 + 12] = 0 as u8
            
        if has_ax_runtime:
            let name_ptr = "ax_runtime.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 14:
                idata_buf.data[ax_runtime_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[ax_runtime_name_offset as i64 + 14] = 0 as u8
            
        if has_ucrtbase:
            let name_ptr = "ucrtbase.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 12:
                idata_buf.data[ucrtbase_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[ucrtbase_name_offset as i64 + 12] = 0 as u8

        // RFC 0009: write user DLL name strings
        ub_i = 0
        while ub_i < user_buckets.len:
            let nm = user_buckets.data[ub_i].name
            let noff = user_buckets.data[ub_i].name_offset
            let nlen = std.string.len(nm)
            let np = get_str_ptr(nm)
            mut c_i := 0 as i64
            while c_i < nlen:
                idata_buf.data[noff + c_i] = np[c_i]
                c_i = c_i + 1
            idata_buf.data[noff + nlen] = 0 as u8
            ub_i = ub_i + 1

        // Write ILT and IAT entries
        if has_kernel32:
            mut j := 0 as i64
            while j < kernel32_imports.len:
                let val = kernel32_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, kernel32_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, kernel32_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, kernel32_iat_offset as i64 + kernel32_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, kernel32_ilt_offset as i64 + kernel32_imports.len * 8, 0 as u64)
            
        if has_ax_runtime:
            mut j := 0 as i64
            while j < ax_runtime_imports.len:
                let val = ax_runtime_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, ax_runtime_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, ax_runtime_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, ax_runtime_iat_offset as i64 + ax_runtime_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ax_runtime_ilt_offset as i64 + ax_runtime_imports.len * 8, 0 as u64)
            
        if has_ucrtbase:
            mut j := 0 as i64
            while j < ucrtbase_imports.len:
                let val = ucrtbase_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, ucrtbase_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, ucrtbase_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, ucrtbase_iat_offset as i64 + ucrtbase_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ucrtbase_ilt_offset as i64 + ucrtbase_imports.len * 8, 0 as u64)

        // RFC 0009: write user-DLL ILT/IAT entries
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let hn = user_buckets.data[ub_i].hn_rvas
            let iato = user_buckets.data[ub_i].iat_offset
            let ilto = user_buckets.data[ub_i].ilt_offset
            mut j := 0 as i64
            while j < imp.len:
                let val = hn[j] as u64
                write_buf_u64_le(idata_buf.data, iato + j * 8, val)
                write_buf_u64_le(idata_buf.data, ilto + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, iato + imp.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ilto + imp.len * 8, 0 as u64)
            ub_i = ub_i + 1

        // Write IDT entries
        mut entry_idx := 0 as i64
        if has_kernel32:
            let ilt_rva = (idata_rva as i64 + kernel32_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + kernel32_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + kernel32_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1
            
        if has_ax_runtime:
            let ilt_rva = (idata_rva as i64 + ax_runtime_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + ax_runtime_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + ax_runtime_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1
            
        if has_ucrtbase:
            let ilt_rva = (idata_rva as i64 + ucrtbase_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + ucrtbase_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + ucrtbase_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1

        // RFC 0009: IDT descriptors for user DLLs
        ub_i = 0
        while ub_i < user_buckets.len:
            let u_ilt_rva = (idata_rva as i64 + user_buckets.data[ub_i].ilt_offset) as u32
            let u_name_rva = (idata_rva as i64 + user_buckets.data[ub_i].name_offset) as u32
            let u_iat_rva = (idata_rva as i64 + user_buckets.data[ub_i].iat_offset) as u32
            let uoff = entry_idx * 20
            write_buf_u32_le(idata_buf.data, uoff, u_ilt_rva)
            write_buf_u32_le(idata_buf.data, uoff + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, uoff + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, uoff + 12, u_name_rva)
            write_buf_u32_le(idata_buf.data, uoff + 16, u_iat_rva)
            entry_idx = entry_idx + 1
            ub_i = ub_i + 1

        let off = entry_idx * 20
        write_buf_u32_le(idata_buf.data, off, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 12, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 16, 0 as u32)

        // RFC 0017 / BUG#82: place module-level global storage at the END of the writable
        // .idata section, after the import directory. Every write_buf into idata_buf above
        // uses fixed offsets computed earlier, so appending here perturbs nothing. Each
        // object's .data block is appended (8-byte aligned) and its section-3 symbols are
        // registered into func_names/func_offsets (parallel — both skip section 3 in the
        // earlier passes) so OP_GLOBAL_ADDR PC32 relocs resolve to the global's image VA.
        mut gobj_i := 0 as i64
        while gobj_i < objects.len:
            let gobj = objects.data[gobj_i]
            if gobj.data.len > 0:
                while (idata_buf.len % 8 as i64) != 0 as i64:
                    push_byte(&idata_buf, 0 as u8)
                let region_rva = (idata_rva as i64 + idata_buf.len) as u64
                gobj.data_va = region_rva
                mut db := 0 as i64
                while db < gobj.data.len:
                    push_byte(&idata_buf, gobj.data.data[db])
                    db = db + 1
                mut gsym_i := 0 as i64
                while gsym_i < gobj.symbols.len:
                    let gsym = &gobj.symbols.data[gsym_i]
                    if gsym.defined and gsym.section == 3 as i64:
                        push_linker_str(&func_names, gsym.name)
                        let sym_rva = region_rva + gsym.offset
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (sym_rva - 0x1000 as u64) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    gsym_i = gsym_i + 1
            gobj_i = gobj_i + 1

        // RFC 0030 P3: reserve zero-initialized global storage AFTER every file-backed
        // block. These bytes exist only in the image: they extend the section's VirtualSize
        // while SizeOfRawData keeps covering just idata_buf, and the loader zero-fills the
        // difference. Doing this in a SECOND pass is what guarantees the file-backed prefix
        // stays contiguous — interleaving it with the .data pass would strand real bytes
        // beyond the raw size and truncate them.
        mut bss_cursor := idata_buf.len as i64
        mut bobj_i := 0 as i64
        while bobj_i < objects.len:
            let bobj = objects.data[bobj_i]
            if bobj.bss_size > 0 as i64:
                while (bss_cursor % 16 as i64) != 0 as i64:
                    bss_cursor = bss_cursor + 1 as i64
                let brva = (idata_rva as i64 + bss_cursor) as u64
                bobj.bss_va = brva
                bss_cursor = bss_cursor + bobj.bss_size
                mut bsym_i := 0 as i64
                while bsym_i < bobj.symbols.len:
                    let bsym = &bobj.symbols.data[bsym_i]
                    if bsym.defined and bsym.section == 4 as i64:
                        push_linker_str(&func_names, bsym.name)
                        let bsym_rva = brva + bsym.offset
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (bsym_rva - 0x1000 as u64) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    bsym_i = bsym_i + 1
            bobj_i = bobj_i + 1
        bss_virt_extent = bss_cursor

        // Pad merged_code to thunks_offset
        while merged_code.len < thunks_offset:
            push_byte(&merged_code, 0 as u8)
            
        // Append all thunks
        mut thunk_i := 0 as i64
        
        mut k_j := 0 as i64
        while k_j < kernel32_imports.len:
            let sym_name = kernel32_imports.data[k_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + kernel32_iat_offset as u32 + k_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva
            
            thunk_i = thunk_i + 1
            k_j = k_j + 1
            
        mut ax_j := 0 as i64
        while ax_j < ax_runtime_imports.len:
            let sym_name = ax_runtime_imports.data[ax_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + ax_runtime_iat_offset as u32 + ax_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva
            
            thunk_i = thunk_i + 1
            ax_j = ax_j + 1
            
        mut u_j := 0 as i64
        while u_j < ucrtbase_imports.len:
            let sym_name = ucrtbase_imports.data[u_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + ucrtbase_iat_offset as u32 + u_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva

            thunk_i = thunk_i + 1
            u_j = u_j + 1

        // RFC 0009: thunks for user-DLL imports (name-based reloc resolves via dyn_sym_names)
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let iato = user_buckets.data[ub_i].iat_offset
            mut j := 0 as i64
            while j < imp.len:
                let sym_name = imp.data[j]
                let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
                let iat_rva_sym = idata_rva as u32 + iato as u32 + j as u32 * 8 as u32
                let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32

                push_byte(&merged_code, 0xFF as u8)
                push_byte(&merged_code, 0x25 as u8)
                push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)

                push_linker_str(&dyn_sym_names, sym_name)
                dyn_sym_rvas[thunk_i] = th_rva

                thunk_i = thunk_i + 1
                j = j + 1
            ub_i = ub_i + 1

    // Construct dyn_buf for ELF64
    mut dyn_buf := new_byte_vec()
    mut offset_dynamic := 0 as i64
    mut size_dynamic := 0 as i64
    // Code-start-relative offset where dyn_buf is placed in the image (align16 of the
    // thunks end). The emit path needs it to compute PT_DYNAMIC's FILE offset — the
    // original `512 + offset_dynamic` forgot the code in between, pointing PT_DYNAMIC
    // into .text (ld.so read machine code as dynamic tags and crashed).
    mut dyn_file_off := 0 as i64
    if format == "elf64" and thunk_count > 0:
        dyn_sym_rvas = @alloc(thunk_count * 4) as ptr[u32]
        
        mut dyn_imports := new_linker_str_vec()
        mut dyn_libs := new_linker_str_vec()
        
        mut has_ax_lib := false
        mut has_c_lib := false
        
        mut scan_j := 0 as i64
        while scan_j < kernel32_imports.len:
            push_linker_str(&dyn_imports, kernel32_imports.data[scan_j])
            has_ax_lib = true
            scan_j = scan_j + 1
            
        scan_j = 0
        while scan_j < ax_runtime_imports.len:
            push_linker_str(&dyn_imports, ax_runtime_imports.data[scan_j])
            has_ax_lib = true
            scan_j = scan_j + 1
            
        scan_j = 0
        while scan_j < ucrtbase_imports.len:
            push_linker_str(&dyn_imports, ucrtbase_imports.data[scan_j])
            has_c_lib = true
            scan_j = scan_j + 1
            
        if has_ax_lib:
            push_linker_str(&dyn_libs, "libax_runtime.so")
        if has_c_lib:
            push_linker_str(&dyn_libs, "libc.so.6")
            
        // 1. Build .dynstr
        mut dynstr_buf := new_byte_vec()
        push_byte(&dynstr_buf, 0 as u8)
        
        let lib_str_offsets = @alloc(dyn_libs.len * 8) as ptr[u64]
        mut lib_i := 0 as i64
        while lib_i < dyn_libs.len:
            lib_str_offsets[lib_i] = dynstr_buf.len as u64
            let name = dyn_libs.data[lib_i]
            let name_len = std.string.len(name)
            let name_ptr = get_str_ptr(name)
            mut char_i := 0 as i64
            while char_i < name_len:
                push_byte(&dynstr_buf, name_ptr[char_i])
                char_i = char_i + 1
            push_byte(&dynstr_buf, 0 as u8)
            lib_i = lib_i + 1
            
        let sym_str_offsets = @alloc(dyn_imports.len * 8) as ptr[u64]
        mut sym_i := 0 as i64
        while sym_i < dyn_imports.len:
            sym_str_offsets[sym_i] = dynstr_buf.len as u64
            let name = dyn_imports.data[sym_i]
            let name_len = std.string.len(name)
            let name_ptr = get_str_ptr(name)
            mut char_i := 0 as i64
            while char_i < name_len:
                push_byte(&dynstr_buf, name_ptr[char_i])
                char_i = char_i + 1
            push_byte(&dynstr_buf, 0 as u8)
            sym_i = sym_i + 1
            
        // 2. Build .dynsym
        mut dynsym_buf := new_byte_vec()
        mut zero_idx := 0 as i64
        while zero_idx < 24:
            push_byte(&dynsym_buf, 0 as u8)
            zero_idx = zero_idx + 1
            
        sym_i = 0
        while sym_i < dyn_imports.len:
            push_u32_le(&dynsym_buf, sym_str_offsets[sym_i] as u32)
            push_byte(&dynsym_buf, 0x12 as u8) // STB_GLOBAL << 4 | STT_FUNC = 0x12
            push_byte(&dynsym_buf, 0 as u8)
            push_u16_le(&dynsym_buf, 0 as u16) // SHN_UNDEF = 0
            push_u64_le(&dynsym_buf, 0 as u64)
            push_u64_le(&dynsym_buf, 0 as u64)
            sym_i = sym_i + 1
            
        // 3. Build .hash
        mut hash_buf := new_byte_vec()
        push_u32_le(&hash_buf, 1 as u32) // nbucket = 1
        push_u32_le(&hash_buf, (1 as i64 + dyn_imports.len) as u32) // nchain
        push_u32_le(&hash_buf, 1 as u32) // bucket[0] = 1
        push_u32_le(&hash_buf, 0 as u32) // chain[0] = 0
        mut chain_idx := 2 as i64
        while chain_idx <= 1 as i64 + dyn_imports.len:
            if chain_idx == 1 as i64 + dyn_imports.len:
                push_u32_le(&hash_buf, 0 as u32)
            else:
                push_u32_le(&hash_buf, chain_idx as u32)
            chain_idx = chain_idx + 1
            
        // 4. Build .got.plt
        mut got_plt_buf := new_byte_vec()
        push_u64_le(&got_plt_buf, 0 as u64) // link to _DYNAMIC
        push_u64_le(&got_plt_buf, 0 as u64)
        push_u64_le(&got_plt_buf, 0 as u64)
        sym_i = 0
        while sym_i < dyn_imports.len:
            push_u64_le(&got_plt_buf, 0 as u64)
            sym_i = sym_i + 1
            
        // 5. Calculate offsets of sections inside dyn_buf
        let offset_dynstr = 0 as i64
        let size_dynstr = dynstr_buf.len
        
        let offset_dynsym = (size_dynstr + 7) & ~7
        let size_dynsym = dynsym_buf.len
        
        let offset_hash = (offset_dynsym + size_dynsym + 7) & ~7
        let size_hash = hash_buf.len
        
        let offset_got_plt = (offset_hash + size_hash + 7) & ~7
        let size_got_plt = got_plt_buf.len
        
        let offset_rela_plt = (offset_got_plt + size_got_plt + 7) & ~7
        let size_rela_plt = dyn_imports.len * 24
        
        offset_dynamic = (offset_rela_plt + size_rela_plt + 7) & ~7
        size_dynamic = (dyn_libs.len + 15) * 16 // 15 fixed tags (incl. DT_JMPREL) + one DT_NEEDED per lib
        
        // 6. Compute virtual addresses
        let dyn_offset = (thunks_offset + thunks_size + 15) & ~15
        dyn_file_off = dyn_offset
        let dyn_base_va = base_addr + dyn_offset as u64
        
        let dynstr_va = dyn_base_va + offset_dynstr as u64
        let dynsym_va = dyn_base_va + offset_dynsym as u64
        let hash_va = dyn_base_va + offset_hash as u64
        let got_plt_va = dyn_base_va + offset_got_plt as u64
        let rela_plt_va = dyn_base_va + offset_rela_plt as u64
        let dynamic_va = dyn_base_va + offset_dynamic as u64
        
        // 7. Build .rela.plt
        mut rela_plt_buf := new_byte_vec()
        sym_i = 0
        while sym_i < dyn_imports.len:
            let r_offset = got_plt_va + 24 as u64 + sym_i as u64 * 8 as u64
            let r_info = ((1 as u64 + sym_i as u64) << 32 as u64) | 7 as u64 // R_X86_64_JUMP_SLOT = 7
            push_u64_le(&rela_plt_buf, r_offset)
            push_u64_le(&rela_plt_buf, r_info)
            push_u64_le(&rela_plt_buf, 0 as u64)
            sym_i = sym_i + 1
            
        // 8. Build .dynamic
        mut dynamic_buf := new_byte_vec()
        mut lib_idx := 0 as i64
        while lib_idx < dyn_libs.len:
            push_u64_le(&dynamic_buf, 1 as u64) // DT_NEEDED
            push_u64_le(&dynamic_buf, lib_str_offsets[lib_idx])
            lib_idx = lib_idx + 1
            
        push_u64_le(&dynamic_buf, 2 as u64) // DT_PLTRELSZ
        push_u64_le(&dynamic_buf, rela_plt_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 20 as u64) // DT_PLTREL
        push_u64_le(&dynamic_buf, 7 as u64) // DT_RELA
        
        push_u64_le(&dynamic_buf, 3 as u64) // DT_PLTGOT
        push_u64_le(&dynamic_buf, got_plt_va)
        
        push_u64_le(&dynamic_buf, 4 as u64) // DT_HASH
        push_u64_le(&dynamic_buf, hash_va)
        
        push_u64_le(&dynamic_buf, 5 as u64) // DT_STRTAB
        push_u64_le(&dynamic_buf, dynstr_va)
        
        push_u64_le(&dynamic_buf, 6 as u64) // DT_SYMTAB
        push_u64_le(&dynamic_buf, dynsym_va)
        
        push_u64_le(&dynamic_buf, 10 as u64) // DT_STRSZ
        push_u64_le(&dynamic_buf, dynstr_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 11 as u64) // DT_SYMENT
        push_u64_le(&dynamic_buf, 24 as u64)
        
        push_u64_le(&dynamic_buf, 7 as u64) // DT_RELA
        push_u64_le(&dynamic_buf, rela_plt_va)
        
        push_u64_le(&dynamic_buf, 8 as u64) // DT_RELASZ
        push_u64_le(&dynamic_buf, rela_plt_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 9 as u64) // DT_RELAENT
        push_u64_le(&dynamic_buf, 24 as u64)
        
        // DT_JMPREL: VA of the PLT relocation table. glibc pairs DT_PLTRELSZ/DT_PLTREL
        // with this tag; leaving it out while PLTRELSZ != 0 made ld.so walk a NULL
        // Elf64_Rela array during BIND_NOW relocation processing (segfault at 8 = the
        // r_info field of entry 0).
        push_u64_le(&dynamic_buf, 23 as u64) // DT_JMPREL
        push_u64_le(&dynamic_buf, rela_plt_va)

        push_u64_le(&dynamic_buf, 24 as u64) // DT_BIND_NOW
        push_u64_le(&dynamic_buf, 1 as u64)

        push_u64_le(&dynamic_buf, 30 as u64) // DT_FLAGS
        push_u64_le(&dynamic_buf, 8 as u64) // DF_BIND_NOW
        
        push_u64_le(&dynamic_buf, 0 as u64) // DT_NULL
        push_u64_le(&dynamic_buf, 0 as u64)
        
        // 9. Assemble dyn_buf
        push_bytes(&dyn_buf, dynstr_buf.data, dynstr_buf.len)
        
        while dyn_buf.len < offset_dynsym:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, dynsym_buf.data, dynsym_buf.len)
        
        while dyn_buf.len < offset_hash:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, hash_buf.data, hash_buf.len)
        
        while dyn_buf.len < offset_got_plt:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, got_plt_buf.data, got_plt_buf.len)
        
        while dyn_buf.len < offset_rela_plt:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, rela_plt_buf.data, rela_plt_buf.len)
        
        while dyn_buf.len < offset_dynamic:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, dynamic_buf.data, dynamic_buf.len)
        
        // 10. Generate ELF PLT stubs inside merged_code
        // Pad merged_code to thunks_offset
        while merged_code.len < thunks_offset:
            push_byte(&merged_code, 0 as u8)
            
        mut thunk_i := 0 as i64
        
        // Generate for kernel32
        mut k_j := 0 as i64
        while k_j < kernel32_imports.len:
            let sym_name = kernel32_imports.data[k_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            k_j = k_j + 1
            
        // Generate for ax_runtime
        mut ax_j := 0 as i64
        while ax_j < ax_runtime_imports.len:
            let sym_name = ax_runtime_imports.data[ax_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            ax_j = ax_j + 1
            
        // Generate for ucrtbase
        mut u_j := 0 as i64
        while u_j < ucrtbase_imports.len:
            let sym_name = ucrtbase_imports.data[u_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            u_j = u_j + 1

        // Pad merged_code to dyn_offset so dyn_buf lands in the file exactly at the
        // VA (base_addr + dyn_offset) all the DT_* pointers above were computed with.
        while merged_code.len < dyn_offset:
            push_byte(&merged_code, 0 as u8)

        // Clean up temporary buffers
        if dynstr_buf.data != null as ptr[u8]:
            @free(dynstr_buf.data)
        if dynsym_buf.data != null as ptr[u8]:
            @free(dynsym_buf.data)
        if hash_buf.data != null as ptr[u8]:
            @free(hash_buf.data)
        if got_plt_buf.data != null as ptr[u8]:
            @free(got_plt_buf.data)
        if rela_plt_buf.data != null as ptr[u8]:
            @free(rela_plt_buf.data)
        if dynamic_buf.data != null as ptr[u8]:
            @free(dynamic_buf.data)
        @free(lib_str_offsets as ptr[u8])
        @free(sym_str_offsets as ptr[u8])
        @free(dyn_imports.data as ptr[u8])
        @free(dyn_libs.data as ptr[u8])

    // RFC 0017 ELF globals: lay out each object's writable .data block in a region that
    // follows merged_code + dyn_buf in the emitted image (code-start-relative offsets, so
    // the standard `target_va = base_addr + offset` resolution below applies unchanged).
    // Mirrors the COFF path, which appends globals to the end of .idata. Registered into
    // func_names/func_offsets BEFORE relocation resolution so OP_GLOBAL_ADDR relocs bind.
    mut elf_data_buf := new_byte_vec()
    // RFC 0030 P4: bytes of zero-initialized global storage that exist in memory only.
    // Stays 0 for PE and for ELF programs without large zero globals, so p_memsz keeps
    // equalling p_filesz and the emitted headers are unchanged.
    mut elf_bss_extent := 0 as i64
    if format == "elf64":
        let elf_data_base = merged_code.len + dyn_buf.len
        // 8-align the region base within the image.
        mut edb_pad := (8 as i64 - (elf_data_base % 8 as i64)) % 8 as i64
        while edb_pad > 0:
            push_byte(&elf_data_buf, 0 as u8)
            edb_pad = edb_pad - 1
        mut gobj_e := 0 as i64
        while gobj_e < objects.len:
            let gobj = objects.data[gobj_e]
            if gobj.data.len > 0:
                while ((elf_data_base + elf_data_buf.len) % 8 as i64) != 0 as i64:
                    push_byte(&elf_data_buf, 0 as u8)
                let region_off = elf_data_base + elf_data_buf.len
                gobj.data_va = base_addr + region_off as u64
                mut edb := 0 as i64
                while edb < gobj.data.len:
                    push_byte(&elf_data_buf, gobj.data.data[edb])
                    edb = edb + 1
                mut gsym_e := 0 as i64
                while gsym_e < gobj.symbols.len:
                    let gsym = &gobj.symbols.data[gsym_e]
                    if gsym.defined and gsym.section == 3 as i64:
                        push_linker_str(&func_names, gsym.name)
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (region_off as u64 + gsym.offset) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    gsym_e = gsym_e + 1
            gobj_e = gobj_e + 1
        // RFC 0030 P4: reserve .bss AFTER every file-backed block, virtual-only. The PT_LOAD
        // segment's p_memsz grows to cover it while p_filesz stays at the file size, so the
        // kernel maps the tail as anonymous zero pages. Mirrors the PE path exactly.
        mut ebss_cursor := elf_data_base + elf_data_buf.len
        mut ebobj_i := 0 as i64
        while ebobj_i < objects.len:
            let ebobj = objects.data[ebobj_i]
            if ebobj.bss_size > 0 as i64:
                while (ebss_cursor % 16 as i64) != 0 as i64:
                    ebss_cursor = ebss_cursor + 1 as i64
                ebobj.bss_va = base_addr + ebss_cursor as u64
                let ebase = ebss_cursor
                ebss_cursor = ebss_cursor + ebobj.bss_size
                mut ebsym_i := 0 as i64
                while ebsym_i < ebobj.symbols.len:
                    let ebsym = &ebobj.symbols.data[ebsym_i]
                    if ebsym.defined and ebsym.section == 4 as i64:
                        push_linker_str(&func_names, ebsym.name)
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (ebase as u64 + ebsym.offset) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    ebsym_i = ebsym_i + 1
            ebobj_i = ebobj_i + 1
        elf_bss_extent = ebss_cursor - (elf_data_base + elf_data_buf.len)

    // 3. Resolve & Apply Relocations
    mut has_reloc_error := false
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut r_i := 0 as i64
        while r_i < obj.relocs.len:
            let r = &obj.relocs.data[r_i]
            if r.sym_idx >= obj.sym_names.len as u32:
                r_i = r_i + 1
                continue
                
            let target_name = obj.sym_names.data[r.sym_idx]
            mut target_offset := -1 as i64
            
            mut search := 0 as i64
            while search < func_names.len:
                if func_names.data[search] == target_name:
                    target_offset = func_offsets.data[search].offset
                    break
                search = search + 1
                
            mut target_va := 0 as u64
            if target_offset == -1 as i64 and target_name == "syscall":
                mut search_ax := 0 as i64
                while search_ax < func_names.len:
                    if func_names.data[search_ax] == "ax_syscall":
                        target_offset = func_offsets.data[search_ax].offset
                        break
                    search_ax = search_ax + 1

            // RFC 0009 P3 Linux: an unresolved C-ABI runtime name X (extern decl or a
            // DLL redirect like ax_panic / ax_get_global_state_internal) binds to its
            // bundled AXIOM twin `ax_X` (the mangled symbol of `pub fn X`). Generalizes
            // the syscall -> ax_syscall mapping above. ELF-only: on COFF these names
            // are genuine ax_runtime.dll imports and must stay dynamic.
            if target_offset == -1 as i64 and format == "elf64":
                let twin_name = std.string.concat("ax_", target_name)
                mut search_tw := 0 as i64
                while search_tw < func_names.len:
                    if func_names.data[search_tw] == twin_name:
                        target_offset = func_offsets.data[search_tw].offset
                        break
                    search_tw = search_tw + 1
                @free(get_str_ptr(twin_name))

            if target_offset != -1 as i64:
                target_va = base_addr + target_offset as u64
            else:
                // Check if it is a dynamic import
                mut dyn_search := 0 as i64
                mut found_dyn := false
                while dyn_search < dyn_sym_names.len:
                    if dyn_sym_names.data[dyn_search] == target_name:
                        target_va = base_addr + (dyn_sym_rvas[dyn_search] - 0x1000 as u32) as u64
                        found_dyn = true
                        break
                    dyn_search = dyn_search + 1
                    
                if not found_dyn:
                    // RFC 0009 P3 Linux: Windows-API / ax_runtime.dll names with no
                    // bundled twin sit in dead code (their is_windows branches folded
                    // away, but whole-function DCE does not exist yet, so the emitted-
                    // but-unreachable bodies still carry the relocs). Patch 0 with a
                    // warning instead of failing the link. Everything else stays a
                    // hard error on both formats.
                    mut dead_win_import := false
                    if format == "elf64":
                        let dll_home = get_dll_for_symbol(target_name)
                        if dll_home == "kernel32.dll" or is_valid_runtime_dll_symbol(target_name):
                            dead_win_import = true
                    if dead_win_import:
                        ax_printf_local("Linker Warning (elf64): dead Windows/runtime import '%s' patched to 0\n", (get_str_ptr(target_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        target_va = 0 as u64
                    else:
                        ax_printf_local("Linker Error: Unresolved external symbol '%s'\n", (get_str_ptr(target_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        has_reloc_error = true
                        target_va = 0 as u64
                
            let rel_offset = (obj.va - base_addr) as i64 + r.offset
            if rel_offset + 4 as i64 > merged_code.len:
                r_i = r_i + 1
                continue
                
            if r.is_pc:
                let pc = base_addr + rel_offset as u64
                let val = (target_va as i64 - pc as i64 + r.addend) as u32
                write_u32_le(merged_code.data, rel_offset, val)
            else:
                if rel_offset + 8 as i64 <= merged_code.len:
                    let val = target_va + r.addend as u64
                    write_u64_le(merged_code.data, rel_offset, val)
                    
            r_i = r_i + 1
        i = i + 1
        
    // Find entry point RVA
    mut entry_rva := 0x1000 as u32
    mut entry_search := 0 as i64
    while entry_search < func_names.len:
        let fn_name = func_names.data[entry_search]
        if fn_name == "main" or fn_name == "_AX_main_main_v_v":
            let name_nt = x86_str_to_null_terminated(fn_name)
            let offset_val = func_offsets.data[entry_search].offset
            ax_printf_local("[Debug Linker Entry] Found entry fn=%s, offset=%d, RVA=%d\n", name_nt as i64, offset_val as i64, (0x1000 as i64 + offset_val) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            @free(name_nt)
            entry_rva = (0x1000 as i64 + offset_val) as u32
            break
        entry_search = entry_search + 1

    // RFC 0009 P2: a --shared DLL has no DllMain → AddressOfEntryPoint = 0.
    if self.is_shared:
        entry_rva = 0 as u32
        
    // 4. Emit Executable
    let output_path_nt = x86_str_to_null_terminated(self.output_path)
    let file = fopen(output_path_nt as ptr[void], get_str_ptr("wb"))
    @free(output_path_nt)
    if file == null as ptr[void]:
        ax_puts_local("Error: Linker could not write output file")
        return false
        
    if format == "coff":
        // Align code to FileAlignment (0x200)
        let orig_code_len = merged_code.len
        align_byte_vec(&merged_code, 0x200 as i64)
        
        let code_raw_size = merged_code.len as u32
        let idata_raw_size = (idata_buf.len as i64 + 0x1FF) as u32 & 0xFFFFFE00 as u32
        // VirtualSize must cover the .bss tail; SizeOfRawData still covers only the file
        // bytes. When there is no .bss this stays equal to idata_raw_size, so the emitted
        // headers are unchanged for every program that does not use the feature.
        mut idata_virt_size := idata_raw_size
        if bss_virt_extent as u32 > idata_virt_size:
            idata_virt_size = bss_virt_extent as u32
        align_byte_vec(&idata_buf, 0x200 as i64)
        
        let iat_rva = idata_rva as u32 + iat_offset as u32
        let iat_size = total_iat_size as u32
        
        mut K_count := 0 as u32
        if kernel32_imports.len > 0:
            K_count = K_count + 1 as u32
        if ax_runtime_imports.len > 0:
            K_count = K_count + 1 as u32
        if ucrtbase_imports.len > 0:
            K_count = K_count + 1 as u32
        let idt_size = (K_count + 1 as u32) * 20 as u32

        // RFC 0009 P2: build the export table (.edata) after .idata, when exporting.
        mut edata_buf := new_byte_vec()
        mut export_rva := 0 as u32
        mut export_virt_size := 0 as u32
        mut edata_raw_size := 0 as u32
        mut edata_file_off := 0 as u32
        mut is_dll := self.is_shared
        if self.export_names.len > 0:
            export_rva = ((idata_rva as i64 + idata_raw_size as i64 + 0xFFF) & ~0xFFF) as u32
            let dll_base = linker_basename(self.output_path)
            build_export_edata(&self.export_names, &func_names, &func_offsets, export_rva, dll_base, &edata_buf)
            @free(get_str_ptr(dll_base))
            export_virt_size = edata_buf.len as u32
            edata_file_off = 0x400 as u32 + code_raw_size + idata_raw_size
            align_byte_vec(&edata_buf, 0x200 as i64)
            edata_raw_size = edata_buf.len as u32
            is_dll = true

        mut pe_headers := new_byte_vec()
        linker_build_pe_headers(&pe_headers, code_raw_size, idata_raw_size, entry_rva, idata_rva as u32, idata_raw_size, iat_rva, iat_size, export_rva, export_virt_size, edata_raw_size, edata_file_off, is_dll, idata_virt_size)

        fwrite(pe_headers.data as ptr[void], 1, pe_headers.len, file)
        fwrite(merged_code.data as ptr[void], 1, merged_code.len, file)
        if idata_buf.len > 0:
            fwrite(idata_buf.data as ptr[void], 1, idata_buf.len, file)
        if edata_buf.len > 0:
            fwrite(edata_buf.data as ptr[void], 1, edata_buf.len, file)

        @free(pe_headers.data)
        if edata_buf.data != null as ptr[u8]:
            @free(edata_buf.data)
    else:
        // elf64
        let entry_va = base_addr + (entry_rva - 0x1000 as u32) as u64
        mut elf_headers := new_byte_vec()
        
        mut dynamic_offset := 0 as u32
        mut dynamic_size := 0 as u32
        if dyn_buf.len > 0:
            // File offset of the .dynamic array = headers(512) + code up to dyn_buf
            // (dyn_file_off) + offset of .dynamic inside dyn_buf.
            dynamic_offset = (512 as i64 + dyn_file_off + offset_dynamic) as u32
            dynamic_size = size_dynamic as u32
            
        linker_build_elf_headers(&elf_headers, (merged_code.len + dyn_buf.len + elf_data_buf.len) as u32, entry_va, dynamic_offset, dynamic_size, elf_bss_extent as u32)

        fwrite(elf_headers.data as ptr[void], 1, elf_headers.len, file)
        fwrite(merged_code.data as ptr[void], 1, merged_code.len, file)
        if dyn_buf.len > 0:
            fwrite(dyn_buf.data as ptr[void], 1, dyn_buf.len, file)
        // RFC 0017 ELF globals: writable data region (offsets registered pre-relocation).
        if elf_data_buf.len > 0:
            fwrite(elf_data_buf.data as ptr[void], 1, elf_data_buf.len, file)

        @free(elf_headers.data)
        
    fclose(file)
    
    // Free structures
    if merged_code.data != null as ptr[u8]:
        @free(merged_code.data)
    if idata_buf.data != null as ptr[u8]:
        @free(idata_buf.data)
    if dyn_buf.data != null as ptr[u8]:
        @free(dyn_buf.data)
    if elf_data_buf.data != null as ptr[u8]:
        @free(elf_data_buf.data)
        
    if dyn_sym_rvas != null as ptr[u32]:
        @free(dyn_sym_rvas as ptr[u8])
    if kernel32_hn_rvas != null as ptr[u32]:
        @free(kernel32_hn_rvas as ptr[u8])
    if ax_runtime_hn_rvas != null as ptr[u32]:
        @free(ax_runtime_hn_rvas as ptr[u8])
    if ucrtbase_hn_rvas != null as ptr[u32]:
        @free(ucrtbase_hn_rvas as ptr[u8])
        
    if kernel32_imports.data != null as ptr[str]:
        @free(kernel32_imports.data as ptr[u8])
    if ax_runtime_imports.data != null as ptr[str]:
        @free(ax_runtime_imports.data as ptr[u8])
    if ucrtbase_imports.data != null as ptr[str]:
        @free(ucrtbase_imports.data as ptr[u8])
    if dyn_sym_names.data != null as ptr[str]:
        @free(dyn_sym_names.data as ptr[u8])
        
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        if obj.text.data != null as ptr[u8]:
            @free(obj.text.data)
        if obj.rdata.data != null as ptr[u8]:
            @free(obj.rdata.data)
        if obj.symbols.data != null as ptr[LinkerSymbol]:
            @free(obj.symbols.data as ptr[u8])
        if obj.sym_names.data != null as ptr[str]:
            @free(obj.sym_names.data as ptr[u8])
        if obj.relocs.data != null as ptr[ParsedReloc]:
            @free(obj.relocs.data as ptr[u8])
        @free(obj as ptr[u8])
        i = i + 1
        
    @free(objects.data as ptr[u8])
    @free(func_names.data as ptr[u8])
    @free(func_offsets.data as ptr[u8])
    if has_reloc_error:
        return false
    return true
