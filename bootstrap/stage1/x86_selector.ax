// RFC 0006 (BUG#36): wrap an arithmetic result to its declared integer width.
// x86-64 integer arithmetic runs in full 64-bit registers, so a narrow result
// (i8/i16/i32/u8/u16/u32) is NOT truncated: `200u8 + 100u8` stays 300 instead
// of wrapping to 44. After each overflow-producing op (add/sub/mul/shl/neg) we
// re-truncate (unsigned) or sign-extend (signed) the dest to its width, reusing
// emit_load_extend. Invariant: every producer of a narrow value (load, cast,
// arithmetic) normalizes it, so operands are always in range and the
// range-preserving ops (and/or/xor/shr/div/mod) need no extra mask.
pub fn emit_wrap_to_width(mut sel: ptr[InstructionSelector], dest: u32, type_id: u32, mut out_insts: ptr[MachInstVec]):
    mut size := 0 as u32
    if type_id == TYPE_I8 or type_id == TYPE_U8:
        size = 1 as u32
    elif type_id == TYPE_I16 or type_id == TYPE_U16:
        size = 2 as u32
    elif type_id == TYPE_I32 or type_id == TYPE_U32:
        size = 4 as u32
    if size != 0 as u32:
        emit_load_extend(sel, dest, size, type_id, out_insts)

// BUG#24: a shift by a CONSTANT amount must use the x86 immediate form
// (`SHL dst, imm8`) rather than `MOV RCX, count; SHL dst, %cl`. The CL form
// clobbers RCX, but the register allocator does not model that clobber, so any
// live value held in RCX across the shift is silently destroyed. This bit
// x86_encode_modrm_rr where `rm_field` lived in RCX across the `<<6`/`<<3` that
// build a modrm byte → reg encoded wrong → every native prologue corrupted.
// Returns the shift amount (0..63) if `vreg` is defined by an OP_ICONST with a
// usable value, else -1. Mirrors is_float_vreg's defining-inst scan.
pub fn const_shift_amount(fn_ptr: ptr[AirFunc], vreg: u32) -> i64:
    // Chase the defining instruction of the shift-count vreg back to an
    // ICONST, looking THROUGH width casts and copies. A source-level shift
    // such as `x << 3 as u8` lowers the count as ICONST(3) -> CAST(u8), so
    // the SHL's src2 points at the CAST, not the ICONST. Matching only a bare
    // ICONST here would mis-classify every cast-wrapped constant shift as a
    // variable shift and fall back to the `MOV RCX,count; SHL dst,%cl` form,
    // which clobbers RCX and corrupts any value the allocator placed there
    // (e.g. `rm_field` inside x86_encode_modrm_rr). Casts that narrow a value
    // are still safe: we only accept the underlying ICONST when its value is
    // already in [0,64), so a truncating cast can never widen the result.
    mut cur := vreg
    mut depth := 0 as i64
    while depth < 16 as i64:
        if cur == 0 as u32:
            return -1 as i64
        // NON-SSA GUARD (variable-shift-in-loop miscompile): AIR is non-SSA, so a count
        // vreg can have MORE THAN ONE definition. A loop induction var (`mut k := 0` then
        // `k = k + 1`) is defined by an init ICONST AND the increment; a first-match scan
        // would find the init ICONST and mis-classify `1 << k` as a CONSTANT shift by k's
        // loop-ENTRY value, emitting `SHL dst,imm8` with the stale immediate (so every
        // `1 << k` in a loop computed `1 << 0`). Only accept a vreg with EXACTLY ONE def.
        // Mirrors const_divisor_pow2's identical guard.
        mut def_count := 0 as i64
        mut dscan := 0 as i64
        while dscan < fn_ptr.insts.len:
            if fn_ptr.insts.data[dscan].dest == cur:
                def_count = def_count + 1 as i64
            dscan = dscan + 1
        if def_count != 1 as i64:
            return -1 as i64
        mut found := false
        mut i := 0 as i64
        while i < fn_ptr.insts.len:
            let inst = &fn_ptr.insts.data[i]
            if inst.dest == cur:
                if inst.opcode == OP_ICONST:
                    let v = (inst.src1 as i64) | ((inst.src2 as i64) << (32 as i64))
                    if v >= 0 as i64 and v < 64 as i64:
                        return v
                    return -1 as i64
                if inst.opcode == OP_CAST or inst.opcode == OP_COPY or inst.opcode == OP_MOVE:
                    cur = inst.src1
                    found = true
                    break
                return -1 as i64
            i = i + 1
        if not found:
            return -1 as i64
        depth = depth + 1
    return -1 as i64

// Returns k in [1,62] if `vreg` is (through casts/copies) an OP_ICONST == 2^k, with
// EXACTLY ONE definition (AIR is non-SSA: a first-match scan of a re-defined vreg would
// pick a stale ICONST and strength-reduce a runtime divisor by the wrong power of two).
pub fn const_divisor_pow2(fn_ptr: ptr[AirFunc], vreg: u32) -> i64:
    mut cur := vreg
    mut depth := 0 as i64
    while depth < 16 as i64:
        if cur == 0 as u32:
            return -1 as i64
        mut def_count := 0 as i64
        mut dscan := 0 as i64
        while dscan < fn_ptr.insts.len:
            if fn_ptr.insts.data[dscan].dest == cur:
                def_count = def_count + 1 as i64
            dscan = dscan + 1
        if def_count != 1 as i64:
            return -1 as i64
        mut found := false
        mut i := 0 as i64
        while i < fn_ptr.insts.len:
            let inst = &fn_ptr.insts.data[i]
            if inst.dest == cur:
                if inst.opcode == OP_ICONST:
                    let v = (inst.src1 as i64) | ((inst.src2 as i64) << (32 as i64))
                    if v > 1 as i64 and v <= (1 as i64 << (62 as i64)) and (v & (v - 1 as i64)) == 0 as i64:
                        mut k := 0 as i64
                        mut t := v
                        while t > 1 as i64:
                            t = t >> (1 as i64)
                            k = k + 1 as i64
                        return k
                    return -1 as i64
                if inst.opcode == OP_CAST or inst.opcode == OP_COPY or inst.opcode == OP_MOVE:
                    cur = inst.src1
                    found = true
                    break
                return -1 as i64
            i = i + 1
        if not found:
            return -1 as i64
        depth = depth + 1
    return -1 as i64

pub fn sel_type_is_8byte_int(sel: ptr[InstructionSelector], tid: u32) -> bool:
    if tid == 9 as u32 or tid == 10 as u32:
        return false
    if (tid as i64) < sel.table.entries.len:
        return sel.table.entries.data[tid as i64].size == 8 as u32
    return false

pub fn select_inst(mut sel: ptr[InstructionSelector], inst: ptr[AirInst], mut out_insts: ptr[MachInstVec]):
