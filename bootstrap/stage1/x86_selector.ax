// bootstrap/stage1/x86_selector.ax
// Instruction selector for x86-64 in self-hosted AXIOM.
// Translates flat/block AIR instructions into virtual-register machine instructions (MachInst).

import std.string

pub const MACH_NOP: u16 = 0
pub const MACH_MOV: u16 = 1
pub const MACH_MOV_IMM: u16 = 2
pub const MACH_ADD: u16 = 3
pub const MACH_SUB: u16 = 4
pub const MACH_IMUL: u16 = 5
pub const MACH_IDIV: u16 = 6
pub const MACH_CQO: u16 = 7
pub const MACH_NEG: u16 = 8
pub const MACH_NOT: u16 = 9
pub const MACH_AND: u16 = 10
pub const MACH_OR: u16 = 11
pub const MACH_XOR: u16 = 12
pub const MACH_SHL: u16 = 13
pub const MACH_SAR: u16 = 14
pub const MACH_CMP: u16 = 15
pub const MACH_TEST: u16 = 16
pub const MACH_SETCC: u16 = 17
pub const MACH_MOVZX_B: u16 = 18
pub const MACH_JMP: u16 = 19
pub const MACH_JCC: u16 = 20
pub const MACH_CALL: u16 = 21
pub const MACH_CALL_INDIRECT: u16 = 22
pub const MACH_RET: u16 = 23
pub const MACH_PUSH: u16 = 24
pub const MACH_POP: u16 = 25
pub const MACH_LEA: u16 = 26
pub const MACH_LOAD: u16 = 27
pub const MACH_STORE: u16 = 28
pub const MACH_XOR_ZERO: u16 = 29
pub const MACH_LABEL: u16 = 30
pub const MACH_SYSCALL: u16 = 31
pub const MACH_SHR: u16 = 32
pub const MACH_FADD: u16 = 33
pub const MACH_FSUB: u16 = 34
pub const MACH_FMUL: u16 = 35
pub const MACH_FDIV: u16 = 36
pub const MACH_FCMP: u16 = 37
pub const MACH_ITOF: u16 = 38
pub const MACH_FTOI: u16 = 39
pub const MACH_MOVDQ: u16 = 40
pub const MACH_MOVQD: u16 = 41
pub const MACH_DIV: u16 = 42   // unsigned divide (F7 /6); MACH_IDIV is signed (/7)
pub const MACH_CVTSS2SD: u16 = 43  // f32 -> f64 widen
pub const MACH_CVTSD2SS: u16 = 44  // f64 -> f32 narrow
// RFC 0006 f32: float MachInsts (FADD/FSUB/FMUL/FDIV/FCMP/ITOF/FTOI/MOVDQ) carry
// the operand width in `padding`: 4 = single (ss/movd), else double (sd/movq).

pub const OPND_NONE: u8 = 0
pub const OPND_VREG: u8 = 1
pub const OPND_PHYS: u8 = 2
pub const OPND_IMM: u8 = 3
pub const OPND_LABEL: u8 = 4
pub const OPND_MEM: u8 = 5

pub const CC_O: u8 = 0x00
pub const CC_NO: u8 = 0x01
pub const CC_B: u8 = 0x02
pub const CC_AE: u8 = 0x03
pub const CC_E: u8 = 0x04
pub const CC_NE: u8 = 0x05
pub const CC_BE: u8 = 0x06
pub const CC_A: u8 = 0x07
pub const CC_S: u8 = 0x08
pub const CC_NS: u8 = 0x09
pub const CC_PE: u8 = 0x0A
pub const CC_PO: u8 = 0x0B
pub const CC_L: u8 = 0x0C
pub const CC_GE: u8 = 0x0D
pub const CC_LE: u8 = 0x0E
pub const CC_G: u8 = 0x0F

pub fn cond_code_to_str(cc: u8) -> str:
    if cc == CC_O:
        return "o"
    if cc == CC_NO:
        return "no"
    if cc == CC_B:
        return "b"
    if cc == CC_AE:
        return "ae"
    if cc == CC_E:
        return "e"
    if cc == CC_NE:
        return "ne"
    if cc == CC_BE:
        return "be"
    if cc == CC_A:
        return "a"
    if cc == CC_S:
        return "s"
    if cc == CC_NS:
        return "ns"
    if cc == CC_PE:
        return "pe"
    if cc == CC_PO:
        return "po"
    if cc == CC_L:
        return "l"
    if cc == CC_GE:
        return "ge"
    if cc == CC_LE:
        return "le"
    if cc == CC_G:
        return "g"
    return "??"

pub struct MachOperand:
    pub kind: u8
    pub phys: u8
    pub padding: u16
    pub vreg: u32
    pub label: u32
    pub imm: i64

pub struct MachInst:
    pub op: u16
    pub cc: u8
    pub padding: u8
    pub dst: MachOperand
    pub src1: MachOperand
    pub src2: MachOperand

pub struct MachInstVec:
    pub data: ptr[MachInst]
    pub len: i64
    pub cap: i64

pub fn new_mach_inst_vec() -> MachInstVec:
    return MachInstVec(data: null as ptr[MachInst], len: 0, cap: 0)

pub fn push(mut self: MachInstVec, inst: MachInst) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 80) as ptr[MachInst]
        if self.data != null as ptr[MachInst]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 80)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = inst
    self.len = self.len + 1
    return idx

pub fn type_size_and_align(table: ptr[TypeTable], type_id: u32, out_size: ptr[u32], out_align: ptr[u32]):
    if type_id == 0 as u32:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32
        return

    mut entry := &table.entries.data[type_id]
    if entry.size != 0 as u32:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return

    if entry.kind == TYPE_KIND_PRIMITIVE:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return
    elif entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
        mut struct_idx := 0xffffffff as u32
        if entry.kind == TYPE_KIND_STRUCT:
            struct_idx = entry.extra
        else:
            mut idx := 0 as i64
            while idx < table.entries.len:
                let e = table.entries.data[idx]
                if e.kind == TYPE_KIND_STRUCT and e.name_id == entry.name_id:
                    struct_idx = e.extra
                    break
                idx = idx + 1
        
        if struct_idx != 0xffffffff as u32:
            let info = table.structs.data[struct_idx]
            mut offset := 0 as u32
            mut max_align := 1 as u32
            mut i := 0 as i64
            while i < info.fields.len:
                let f = info.fields.data[i]
                mut f_size := 0 as u32
                mut f_align := 0 as u32
                type_size_and_align(table, f.type_id, &f_size, &f_align)
                if f_align == 0 as u32:
                    f_align = 8 as u32
                // Align offset
                offset = (offset + f_align - 1 as u32) & ~(f_align - 1 as u32)
                offset = offset + f_size
                if f_align > max_align:
                    max_align = f_align
                i = i + 1
            
            mut size := (offset + max_align - 1 as u32) & ~(max_align - 1 as u32)
            if size == 0 as u32:
                size = 8 as u32
            entry.size = size
            entry.align = max_align
            out_size[0] = size
            out_align[0] = max_align
        else:
            out_size[0] = 8 as u32
            out_align[0] = 8 as u32
    elif entry.kind == TYPE_KIND_ARRAY:
        let elem_id = entry.extra
        let length = entry.name_id
        mut elem_size := 0 as u32
        mut elem_align := 0 as u32
        type_size_and_align(table, elem_id, &elem_size, &elem_align)
        if elem_align == 0 as u32:
            elem_align = 8 as u32
        let size = length * elem_size
        entry.size = size
        entry.align = elem_align
        out_size[0] = size
        out_align[0] = elem_align
    else:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32

pub fn field_offset(table: ptr[TypeTable], struct_type_id: u32, field_idx: u32) -> u32:
    if struct_type_id == 0 as u32:
        return field_idx * 8 as u32
    // ax_printf_local("[Debug field_offset] struct_type_id=%d, table.entries.len=%d\n", struct_type_id as i64, table.entries.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // fflush(null as ptr[void])
    mut real_type_id := struct_type_id
    mut entry = table.entries.data[real_type_id]
    if entry.kind == 9 as u8: // TYPE_KIND_POINTER = 9
        real_type_id = entry.extra
        entry = table.entries.data[real_type_id]
    // ax_printf_local("[field_offset] struct_type_id=%d, entry.kind=%d, entry.extra=%d, entry.size=%d\n", real_type_id as i64, entry.kind as i64, entry.extra as i64, entry.size as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // fflush(null as ptr[void])
    if entry.kind != 1 as u8 and entry.kind != 8 as u8: // TYPE_KIND_STRUCT = 1, TYPE_KIND_GENERIC_INST = 8
        return field_idx * 8 as u32
    
    mut struct_idx := 0xffffffff as u32
    if entry.kind == 1 as u8:
        struct_idx = entry.extra
    else:
        mut idx := 0 as i64
        while idx < table.entries.len:
            let e = table.entries.data[idx]
            if e.kind == 1 as u8 and e.name_id == entry.name_id:
                struct_idx = e.extra
                break
            idx = idx + 1
            
    if struct_idx == 0xffffffff as u32:
        return field_idx * 8 as u32
        
    let info = table.structs.data[struct_idx]
    // ax_printf_local("[field_offset] info.fields.len=%d, info.fields.data=%x\n", info.fields.len as i64, (info.fields.data as i64) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // fflush(null as ptr[void])
    mut offset := 0 as u32
    mut i := 0 as i64
    while i < info.fields.len:
        let f = info.fields.data[i]
        mut f_size := 0 as u32
        mut f_align := 0 as u32
        type_size_and_align(table, f.type_id, &f_size, &f_align)
        if f_align == 0 as u32:
            f_align = 8 as u32
        // Align offset
        offset = (offset + f_align - 1 as u32) & ~(f_align - 1 as u32)
        // ax_printf_local("[field_offset]   field %d: name_id=%d, type_id=%d, f_size=%d, f_align=%d, aligned_offset=%d\n", i as i64, f.name_id as i64, f.type_id as i64, f_size as i64, f_align as i64, offset as i64, 0 as i64, 0 as i64)
        // fflush(null as ptr[void])
        if i as u32 == field_idx:
            return offset
        offset = offset + f_size
        i = i + 1
    return field_idx * 8 as u32

pub fn field_size(table: ptr[TypeTable], struct_type_id: u32, field_idx: u32) -> u32:
    if struct_type_id == 0 as u32:
        return 8 as u32
    // ax_printf_local("[Debug field_size] struct_type_id=%d, table.entries.len=%d\n", struct_type_id as i64, table.entries.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // fflush(null as ptr[void])
    mut real_type_id := struct_type_id
    mut entry = table.entries.data[real_type_id]
    if entry.kind == 9 as u8: // TYPE_KIND_POINTER = 9
        real_type_id = entry.extra
        entry = table.entries.data[real_type_id]
    if entry.kind != 1 as u8 and entry.kind != 8 as u8: // TYPE_KIND_STRUCT = 1, TYPE_KIND_GENERIC_INST = 8
        return 8 as u32
    
    mut struct_idx := 0xffffffff as u32
    if entry.kind == 1 as u8:
        struct_idx = entry.extra
    else:
        mut idx := 0 as i64
        while idx < table.entries.len:
            let e = table.entries.data[idx]
            if e.kind == 1 as u8 and e.name_id == entry.name_id:
                struct_idx = e.extra
                break
            idx = idx + 1
            
    if struct_idx == 0xffffffff as u32:
        return 8 as u32
        
    let info = table.structs.data[struct_idx]
    if field_idx as i64 >= info.fields.len:
        return 8 as u32
    let f = info.fields.data[field_idx]
    mut f_size := 0 as u32
    mut f_align := 0 as u32
    type_size_and_align(table, f.type_id, &f_size, &f_align)
    if f_size == 0 as u32:
        return 8 as u32
    return f_size

// Returns true if `type_id` is a value-aggregate held BY ADDRESS in this backend:
// struct(1), array(3), tuple(5), sum(6), generic-inst(8), option(11), result(12).
// Scalars (primitive 0, func 2, generic 7, pointer 9, ref 10, interface 13) are not.
// Used by OP_INDEX: indexing an array of aggregates must yield the element ADDRESS
// (the by-address convention), not load the element bytes as a scalar value.
pub fn type_is_aggregate(table: ptr[TypeTable], type_id: u32) -> bool:
    if type_id as i64 >= table.entries.len:
        return false
    let k = table.entries.data[type_id].kind
    if k == 1 as u8 or k == 3 as u8 or k == 5 as u8 or k == 6 as u8 or k == 8 as u8 or k == 11 as u8 or k == 12 as u8:
        return true
    return false

// Returns true if field `field_idx` of `struct_type_id` is itself an aggregate
// (a struct / generic-inst), i.e. a nested value struct. Such a field is held
// BY ADDRESS (like every small struct value in this backend), so GET_FIELD must
// return the field's ADDRESS (LEA base+disp), NOT load its bytes as a scalar —
// otherwise a sub-field access (`outer.inner.x`) would deref the inline value as
// a pointer and fault. Mirrors field_size's navigation. `str` (a 16-byte builtin)
// is NOT reported here and is handled by the size==16 copy path.
pub fn field_is_aggregate(table: ptr[TypeTable], struct_type_id: u32, field_idx: u32) -> bool:
    if struct_type_id == 0 as u32:
        return false
    mut real_type_id := struct_type_id
    mut entry = table.entries.data[real_type_id]
    if entry.kind == 9 as u8: // TYPE_KIND_POINTER = 9
        real_type_id = entry.extra
        entry = table.entries.data[real_type_id]
    if entry.kind != 1 as u8 and entry.kind != 8 as u8: // STRUCT=1, GENERIC_INST=8
        return false
    mut struct_idx := 0xffffffff as u32
    if entry.kind == 1 as u8:
        struct_idx = entry.extra
    else:
        mut idx := 0 as i64
        while idx < table.entries.len:
            let e = table.entries.data[idx]
            if e.kind == 1 as u8 and e.name_id == entry.name_id:
                struct_idx = e.extra
                break
            idx = idx + 1
    if struct_idx == 0xffffffff as u32:
        return false
    let info = table.structs.data[struct_idx]
    if field_idx as i64 >= info.fields.len:
        return false
    let f = info.fields.data[field_idx]
    // Is the field's own type a value-aggregate held BY ADDRESS? That covers
    // struct(1), array(3), tuple(5), sum(6), generic-inst(8), option(11),
    // result(12). Scalars (primitive 0, func 2, pointer 9, ref 10) are NOT —
    // they are loaded by value. A small tagged type (sum/option/result, e.g. an
    // 8-byte enum) is the case that crashed stage2->stage3: its tag/payload sub-
    // field needs the field ADDRESS, not the inline bytes deref'd as a pointer.
    if f.type_id as i64 >= table.entries.len:
        return false
    let fk = table.entries.data[f.type_id].kind
    if fk == 1 as u8 or fk == 3 as u8 or fk == 5 as u8 or fk == 6 as u8 or fk == 8 as u8 or fk == 11 as u8 or fk == 12 as u8:
        return true
    return false

// BUG#59: is field `field_idx` of `struct_type_id` a POINTER-SUM (sum kind 6,
// option 11, result 12)? Such a value is an 8-byte box pointer (its entry.size is
// 16 — the box allocation — but the VALUE stored in the field is the pointer). It
// must be loaded/stored as an 8-byte pointer, NOT a 16-byte inline block copy: the
// dest/source register is homed as an 8-byte pointer (regalloc_is_16byte excludes
// kinds 6/11/12), so a 16-byte block copy overruns the 8-byte slot and corrupts the
// stack. Same by-address-vs-pointer-repr tension as BUG#51/56.
pub fn field_is_pointer_sum(table: ptr[TypeTable], struct_type_id: u32, field_idx: u32) -> bool:
    if struct_type_id == 0 as u32:
        return false
    mut real_type_id := struct_type_id
    mut entry = table.entries.data[real_type_id]
    if entry.kind == 9 as u8: // TYPE_KIND_POINTER
        real_type_id = entry.extra
        entry = table.entries.data[real_type_id]
    if entry.kind != 1 as u8 and entry.kind != 8 as u8: // STRUCT, GENERIC_INST
        return false
    mut struct_idx := 0xffffffff as u32
    if entry.kind == 1 as u8:
        struct_idx = entry.extra
    else:
        mut idx := 0 as i64
        while idx < table.entries.len:
            let e = table.entries.data[idx]
            if e.kind == 1 as u8 and e.name_id == entry.name_id:
                struct_idx = e.extra
                break
            idx = idx + 1
    if struct_idx == 0xffffffff as u32:
        return false
    let info = table.structs.data[struct_idx]
    if field_idx as i64 >= info.fields.len:
        return false
    let f = info.fields.data[field_idx]
    if f.type_id as i64 >= table.entries.len:
        return false
    let fk = table.entries.data[f.type_id].kind
    if fk == 6 as u8 or fk == 11 as u8 or fk == 12 as u8:
        return true
    return false

pub fn abi_int_arg_reg(abi: str, idx: i64) -> u8:
    if abi == "win64":
        return get_win64_arg_reg(idx)
    return get_sysv_arg_reg(idx)

pub fn abi_float_arg_reg(abi: str, idx: i64) -> u8:
    if abi == "win64":
        return get_win64_float_arg_reg(idx)
    return get_sysv_float_arg_reg(idx)

pub fn abi_return_reg(abi: str) -> u8:
    return REG_RAX

pub struct InstructionSelector:
    pub fn_ptr: ptr[AirFunc]
    pub abi_name: str
    pub table: ptr[TypeTable]
    pub param_idx_processed: i32
    pub symbols: ptr[SymbolTable]
    pub pool: ptr[InternPool]
    pub max_vreg: u32
    pub max_label: u32
    // PERF: def-index over fn_ptr.insts (vreg -> first defining inst index, else
    // -1), built once in select_all. get_register_type consults it to jump-start
    // its scan instead of scanning from 0 on every call. null/0 = not built.
    pub def_idx: ptr[i32]
    pub def_size: i64

pub fn next_vreg(sel: ptr[InstructionSelector]) -> u32:
    sel.max_vreg = sel.max_vreg + 1 as u32
    return sel.max_vreg

pub fn next_label(sel: ptr[InstructionSelector]) -> u32:
    sel.max_label = sel.max_label + 1 as u32
    return sel.max_label

// RFC 0006 (BUG#34.1): integer signedness for division/shift/compare selection.
// Unsigned: u8=5 u16=6 u32=7 u64=8 usize=16. (Distinct name from wasm.ax's
// is_type_unsigned to avoid a duplicate global symbol after concatenation.)
pub fn sel_type_is_unsigned(t: u32) -> bool:
    return t == 5 as u32 or t == 6 as u32 or t == 7 as u32 or t == 8 as u32 or t == 16 as u32

pub fn get_register_type(sel: ptr[InstructionSelector], reg: u32) -> u32:
    if reg == 0:
        return 0 as u32
    if reg >= 1 as u32 and reg <= sel.fn_ptr.params.len as u32:
        return sel.fn_ptr.params.data[reg as i64 - 1 as i64] as u32
    mut i := 0 as i64
    // PERF: jump-start at reg's defining inst; [0, def_idx[reg]) all have dest!=reg
    // (provably identical to scanning from 0). def_idx[reg] == -1 → no def → 0.
    if sel.def_idx != null as ptr[i32] and (reg as i64) < sel.def_size:
        let d0 = sel.def_idx[reg as i64]
        if d0 < 0 as i32:
            return 0 as u32
        i = d0 as i64
    while i < sel.fn_ptr.insts.len:
        let inst = &sel.fn_ptr.insts.data[i]
        if inst.dest == reg:
            if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
                let sym_idx = inst.type_id as u32
                if sym_idx != 0 as u32 and (sym_idx as i64) < sel.symbols.symbols.len:
                    let sym = sel.symbols.symbols.data[sym_idx as i64]
                    if sym.kind == SYM_FUNC:
                        let func_type = sym.type_id
                        if func_type != 0 as u32 and (func_type as i64) < sel.table.entries.len:
                            let entry = sel.table.entries.data[func_type as i64]
                            if entry.kind == TYPE_KIND_FUNC:
                                let fi_idx = entry.extra
                                if (fi_idx as i64) < sel.table.funcs.len:
                                    let fi = sel.table.funcs.data[fi_idx as i64]
                                    return fi.ret
                    elif sym.kind == SYM_STRUCT:
                        return sym.type_id
                return 0 as u32
            return inst.type_id as u32
        i = i + 1
    return 0 as u32

// Thin wrapper preserving the original signature (16 call sites, mostly in the
// selector where the call count is O(insts) total — not hot). Passes a null cache
// so the scan below runs its plain linear form.
pub fn regalloc_is_16byte(vreg: u32, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> bool:
    return regalloc_is_16byte_cached(vreg, fn_ptr, table, symbols, null as ptr[i32], 0 as i64)

// PERF: same body as the linear form, but when `def_idx` is supplied the scan
// STARTS at def_idx[vreg] (the first inst with dest==vreg) instead of 0. Every
// index in [0, def_idx[vreg]) has dest != vreg, so skipping them is provably
// identical — only the wasted no-op iterations are removed, the loop body (incl.
// its control-flow-op skip) is untouched. def_idx[vreg] == -1 means no def → the
// linear form would scan to the end and return false, so we return false directly.
// Called with a real cache in the spill-all fallback (per-interval) and
// insert_spill_code (per-spilled-operand), turning O(vregs × insts) into O(insts).
pub fn regalloc_is_16byte_cached(vreg: u32, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable], def_idx: ptr[i32], def_size: i64) -> bool:
    if vreg == 0:
        return false
    if vreg >= 1 as u32 and vreg <= fn_ptr.params.len as u32:
        let type_id = fn_ptr.params.data[vreg as i64 - 1 as i64] as u32
        if type_id < table.entries.len as u32:
            let size = table.entries.data[type_id].size
            // RFC 0001 / Family C: only `str` (PRIMITIVE) is inline-16; a 16-byte
            // by-address aggregate param is an 8-byte pointer.
            if size == 16 as u32 and not type_is_aggregate(table, type_id):
                return true
        return false
    mut i := 0 as i64
    if def_idx != null as ptr[i32] and (vreg as i64) < def_size:
        let d0 = def_idx[vreg as i64]
        if d0 < 0 as i32:
            return false
        i = d0 as i64
    while i < fn_ptr.insts.len:
        let inst = &fn_ptr.insts.data[i]
        if inst.dest == vreg:
            let op = inst.opcode
            // Ignore control-flow, store, and other instructions that don't actually define a destination register
            if op != OP_BRANCH and op != OP_JUMP and op != OP_RETURN and op != OP_STORE and op != OP_SET_FIELD and op != OP_FREE and op != OP_DESTROY and op != OP_LOOP_BEGIN and op != OP_LOOP_END and op != OP_SEND:
                if op == OP_CALL:
                    if inst.src1 == 0 as u32: // Direct function call
                        let sym_idx = inst.type_id as u32
                        if symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < symbols.symbols.len:
                            let sym = &symbols.symbols.data[sym_idx as i64]
                            if sym.kind == 1 as u8 or sym.kind == 10 as u8: // SYM_FUNC or other func symbol kinds
                                let fn_type_id = sym.type_id as u32
                                if fn_type_id < table.entries.len as u32:
                                    let entry = &table.entries.data[fn_type_id]
                                    if entry.kind == 2 as u8: // TYPE_KIND_FUNC = 2
                                        let fi = &table.funcs.data[entry.extra as i64]
                                        let ret_type_id = fi.ret
                                        // str (12) is a 16-byte return value
                                        if ret_type_id == 12 as u32:
                                            return true
                                        if ret_type_id < table.entries.len as u32:
                                            let size = table.entries.data[ret_type_id].size
                                            // RFC 0001: 16-byte aggregate return = 8-byte pointer
                                            if size == 16 as u32 and not type_is_aggregate(table, ret_type_id):
                                                return true
                    else: // Dynamic function call
                        let type_id = inst.type_id as u32
                        if type_id == 12 as u32:
                            return true
                        if type_id < table.entries.len as u32:
                            let size = table.entries.data[type_id].size
                            // RFC 0001: 16-byte aggregate return = 8-byte pointer
                            if size == 16 as u32 and not type_is_aggregate(table, type_id):
                                return true
                    return false
                elif op == OP_ALLOC or op == OP_ARENA_ALLOC or op == OP_SYSCALL:
                    return false
                elif op == OP_COPY or op == OP_MOVE:
                    let type_id = inst.type_id as u32
                    if type_id < table.entries.len as u32:
                        let size = table.entries.data[type_id].size
                        // BUG#30: only `str` (an INLINE 16-byte primitive) is held
                        // 16-byte-inline (home = the data). A by-address aggregate
                        // (struct/sum/option/result/array/tuple) of size 16 is
                        // POINTER-repr (8-byte): its vreg holds the heap address,
                        // exactly like the alloc/source it is copied from. Reporting
                        // it 16-byte here gave the copy result a 16-byte inline home
                        // while the source was an 8-byte pointer -> copy stored the
                        // pointer into the inline home and getfld then read the home
                        // (=pointer) instead of dereferencing. Fall through to the
                        // source so the copy matches the source representation.
                        if size == 16 as u32 and not type_is_aggregate(table, type_id):
                            return true
                    // COPY/MOVE preserve the type, so the source size is
                    // authoritative when the dest type_id is unset/generic.
                    return regalloc_is_16byte_cached(inst.src1, fn_ptr, table, symbols, def_idx, def_size)
                elif op == OP_CAST:
                    // A cast CHANGES the type: size strictly by the destination
                    // type, never the source. e.g. str(16)->ptr(8) must report
                    // 8-byte; recursing to src1 (the str) would wrongly give
                    // the dest 2 spill slots and corrupt it on every later use.
                    let type_id = inst.type_id as u32
                    if type_id == 12 as u32:
                        return true
                    if type_id < table.entries.len as u32:
                        let size = table.entries.data[type_id].size
                        if size == 16 as u32:
                            return true
                    return false
                elif op == OP_DEREF:
                    // Deref of ptr[str]/ref[str] yields a 16-byte str value even
                    // when the deref's own type_id stayed a generic param. Size
                    // by the concrete pointee of the source pointer register.
                    let type_id = inst.type_id as u32
                    // str (12) is always 16 bytes; match the selector which
                    // hardcodes this, rather than relying on entries[12].size
                    // which may be unset in some type tables.
                    if type_id == 12 as u32:
                        return true
                    // BUG#60: a deref that yields a tagged pointer-repr aggregate
                    // (sum/option/result, and struct/array/tuple) has entry.size 16
                    // but the vreg holds the 8-byte BOX POINTER, not 16 inline bytes.
                    // This is exactly a nested `Some(inner)` where inner is itself an
                    // Option: the outer match binds `inner` via OP_DEREF typed Option
                    // (size 16). Without the aggregate exclusion (mirroring the COPY /
                    // CALL / else cases) it reported 16-byte-inline, so every later use
                    // of `inner` — the inner match's discriminant test and its payload
                    // OP_DEREF — spill-reloaded with LEA(&slot) instead of MOV(slot→reg)
                    // and read the slot ADDRESS as the box (double-deref returned garbage,
                    // exit 8 not 42). Only genuine str (handled above / ptr[str] below)
                    // is truly inline-16.
                    if type_id < table.entries.len as u32:
                        if table.entries.data[type_id].size == 16 as u32 and not type_is_aggregate(table, type_id):
                            return true
                    mut src_ty := 0 as u32
                    if inst.src1 >= 1 as u32 and inst.src1 <= fn_ptr.params.len as u32:
                        src_ty = fn_ptr.params.data[inst.src1 as i64 - 1 as i64] as u32
                    else:
                        mut k := 0 as i64
                        // PERF: jump-start at src1's def (same skip-no-op-prefix
                        // reasoning as the outer scan). def_idx[src1] == -1 → no def.
                        if def_idx != null as ptr[i32] and (inst.src1 as i64) < def_size:
                            let ds = def_idx[inst.src1 as i64]
                            if ds >= 0 as i32:
                                k = ds as i64
                            else:
                                k = fn_ptr.insts.len
                        while k < fn_ptr.insts.len:
                            let din = &fn_ptr.insts.data[k]
                            if din.dest == inst.src1:
                                src_ty = din.type_id as u32
                                break
                            k = k + 1
                    if src_ty < table.entries.len as u32:
                        let se = table.entries.data[src_ty]
                        if (se.kind == TYPE_KIND_POINTER or se.kind == TYPE_KIND_REF) and se.extra == 12 as u32:
                            return true
                    return false
                else:
                    let type_id = inst.type_id as u32
                    if type_id < table.entries.len as u32:
                        let size = table.entries.data[type_id].size
                        // BUG#56: a tagged pointer-repr value (sum/option/result,
                        // kinds 6/11/12) has size 16 (box = [tag,payload]) but its
                        // vreg holds the 8-byte BOX POINTER, not 16 inline bytes.
                        // This case defines e.g. an OP_GET_FIELD dest; without the
                        // guard a sum-typed field load reported 16-byte, so the spill
                        // reload used LEA(&slot) instead of MOV(slot→reg) when the reg
                        // was later a GET_FIELD base — reading the slot ADDRESS as the
                        // box, i.e. a nested-sum payload extraction miscompile. Only
                        // these tagged kinds are excluded; size-16 struct/array/tuple
                        // handling is unchanged (they keep the prior classification).
                        mut tk := 0 as u8
                        if type_id < table.entries.len as u32:
                            tk = table.entries.data[type_id].kind
                        let is_tagged_ptr = tk == 6 as u8 or tk == 11 as u8 or tk == 12 as u8
                        if size == 16 as u32 and not is_tagged_ptr:
                            return true
                    return false
        i = i + 1
    return false


// unsf_cc = the condition code for SSE float comparisons (comisd sets CF/ZF) AND,
// conveniently, for UNSIGNED integer comparisons — x86 shares the below/above
// codes (B/BE/A/AE) for both. int_cc = the signed-integer code (L/LE/G/GE).
pub fn select_comparison(sel: ptr[InstructionSelector], inst: ptr[AirInst], int_cc: u8, unsf_cc: u8, out_insts: ptr[MachInstVec]):
    let src_type = get_register_type(sel, inst.src1)
    if src_type == 9 as u32 or src_type == 10 as u32:
        mut cmpw := 8 as u8
        if src_type == 9 as u32:
            cmpw = 4 as u8
        out_insts.push(MachInst(op: MACH_FCMP, cc: 0 as u8, padding: cmpw, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src2, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        out_insts.push(MachInst(op: MACH_SETCC, cc: unsf_cc, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    else:
        // RFC 0006 (BUG#34.3): unsigned integer types compare with the below/above
        // codes; only signed types use L/LE/G/GE. Was always int_cc (signed) →
        // wrong for u32/u64 operands with the high bit set.
        mut icc := int_cc
        if sel_type_is_unsigned(src_type):
            icc = unsf_cc
        out_insts.push(MachInst(op: MACH_CMP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src2, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        out_insts.push(MachInst(op: MACH_SETCC, cc: icc, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    out_insts.push(MachInst(op: MACH_MOVZX_B, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub fn emit_block_copy_ext(sel: ptr[InstructionSelector], dst_reg: u32, dst_disp: u32, src_reg: u32, src_disp: u32, size: u32, out_insts: ptr[MachInstVec]):
    mut offset := 0 as u32
    mut remaining := size
    while remaining >= 8 as u32:
        let tmp_val = next_vreg(sel)
        out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: src_reg, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (src_disp + offset) as i64)))
        out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dst_reg, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (dst_disp + offset) as i64)))
        offset = offset + 8 as u32
        remaining = remaining - 8 as u32
        
    if remaining >= 4 as u32:
        let tmp_val = next_vreg(sel)
        out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 4 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: src_reg, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (src_disp + offset) as i64)))
        out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 4 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dst_reg, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (dst_disp + offset) as i64)))
        offset = offset + 4 as u32
        remaining = remaining - 4 as u32
        
    if remaining >= 2 as u32:
        let tmp_val = next_vreg(sel)
        out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 2 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: src_reg, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (src_disp + offset) as i64)))
        out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 2 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dst_reg, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (dst_disp + offset) as i64)))
        offset = offset + 2 as u32
        remaining = remaining - 2 as u32
        
    if remaining >= 1 as u32:
        let tmp_val = next_vreg(sel)
        out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 1 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: src_reg, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (src_disp + offset) as i64)))
        out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 1 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dst_reg, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: (dst_disp + offset) as i64)))

pub fn emit_block_copy(sel: ptr[InstructionSelector], dst_reg: u32, dst_disp: u32, src_reg: u32, size: u32, out_insts: ptr[MachInstVec]):
    mut final_src_reg := src_reg
    if regalloc_is_16byte(src_reg, sel.fn_ptr, sel.table, sel.symbols):
        final_src_reg = next_vreg(sel)
        out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, 
            dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: final_src_reg, label: 0 as u32, imm: 0 as i64), 
            src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: src_reg, label: 0 as u32, imm: 0 as i64), 
            src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    emit_block_copy_ext(sel, dst_reg, dst_disp, final_src_reg, 0 as u32, size, out_insts)

// BUG#23: extend a freshly-loaded sub-64-bit scalar in `dest` to full register
// width. A 4-byte `mov r32,[mem]` zero-extends the upper 32 bits, which is wrong
// for SIGNED element types (i8/i16/i32): a negative value loses its sign. This was
// latent because i32 values are almost always non-negative — until the -1 sentinel
// filled into coff_sym_map (@memset 0xff). Loading it zero-extended to 0xFFFFFFFF,
// so `target_sym_idx == -1 as i32` was always false → extern symbols were never
// created → natively-built binaries emitted 0 imports (extern calls -> *ABS*).
// Signed types sign-extend (SHL/SAR by (64-bits)); unsigned/bool/char keep the
// zero-extending AND mask (their previous, correct behavior).
pub fn emit_load_extend(mut sel: ptr[InstructionSelector], dest: u32, size: u32, type_id: u32, mut out_insts: ptr[MachInstVec]):
    let is_signed = (type_id == TYPE_I8 or type_id == TYPE_I16 or type_id == TYPE_I32)
    if is_signed:
        mut shift := 32 as i64
        if size == 1 as u32:
            shift = 56 as i64
        elif size == 2 as u32:
            shift = 48 as i64
        out_insts.push(MachInst(op: MACH_SHL, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: shift), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        out_insts.push(MachInst(op: MACH_SAR, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: shift), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        return
    mut mask := 4294967295 as i64
    if size == 1 as u32:
        mask = 255 as i64
    elif size == 2 as u32:
        mask = 65535 as i64
    let tmp_mask = next_vreg(sel)
    out_insts.push(MachInst(op: MACH_MOV_IMM, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_mask, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: mask), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    out_insts.push(MachInst(op: MACH_AND, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_mask, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

// RFC 0006 (BUG#36): wrap an arithmetic result to its declared integer width.
// x86-64 integer arithmetic runs in full 64-bit registers, so a narrow result
// (i8/i16/i32/u8/u16/u32) is NOT truncated: `200u8 + 100u8` stays 300 instead
// of wrapping to 44. After each overflow-producing op (add/sub/mul/shl/neg) we
// re-truncate (unsigned) or sign-extend (signed) the dest to its width, reusing
// emit_load_extend. Invariant: every producer of a narrow value (load, cast,
// arithmetic) normalizes it, so operands are always in range and the
// range-preserving ops (and/or/xor/shr/div/mod) need no extra mask.
pub fn emit_wrap_to_width(mut sel: ptr[InstructionSelector], dest: u32, type_id: u32, mut out_insts: ptr[MachInstVec]):
    mut size := 0 as u32
    if type_id == TYPE_I8 or type_id == TYPE_U8:
        size = 1 as u32
    elif type_id == TYPE_I16 or type_id == TYPE_U16:
        size = 2 as u32
    elif type_id == TYPE_I32 or type_id == TYPE_U32:
        size = 4 as u32
    if size != 0 as u32:
        emit_load_extend(sel, dest, size, type_id, out_insts)

// BUG#24: a shift by a CONSTANT amount must use the x86 immediate form
// (`SHL dst, imm8`) rather than `MOV RCX, count; SHL dst, %cl`. The CL form
// clobbers RCX, but the register allocator does not model that clobber, so any
// live value held in RCX across the shift is silently destroyed. This bit
// x86_encode_modrm_rr where `rm_field` lived in RCX across the `<<6`/`<<3` that
// build a modrm byte → reg encoded wrong → every native prologue corrupted.
// Returns the shift amount (0..63) if `vreg` is defined by an OP_ICONST with a
// usable value, else -1. Mirrors is_float_vreg's defining-inst scan.
pub fn const_shift_amount(fn_ptr: ptr[AirFunc], vreg: u32) -> i64:
    // Chase the defining instruction of the shift-count vreg back to an
    // ICONST, looking THROUGH width casts and copies. A source-level shift
    // such as `x << 3 as u8` lowers the count as ICONST(3) -> CAST(u8), so
    // the SHL's src2 points at the CAST, not the ICONST. Matching only a bare
    // ICONST here would mis-classify every cast-wrapped constant shift as a
    // variable shift and fall back to the `MOV RCX,count; SHL dst,%cl` form,
    // which clobbers RCX and corrupts any value the allocator placed there
    // (e.g. `rm_field` inside x86_encode_modrm_rr). Casts that narrow a value
    // are still safe: we only accept the underlying ICONST when its value is
    // already in [0,64), so a truncating cast can never widen the result.
    mut cur := vreg
    mut depth := 0 as i64
    while depth < 16 as i64:
        if cur == 0 as u32:
            return -1 as i64
        mut found := false
        mut i := 0 as i64
        while i < fn_ptr.insts.len:
            let inst = &fn_ptr.insts.data[i]
            if inst.dest == cur:
                if inst.opcode == OP_ICONST:
                    let v = (inst.src1 as i64) | ((inst.src2 as i64) << (32 as i64))
                    if v >= 0 as i64 and v < 64 as i64:
                        return v
                    return -1 as i64
                if inst.opcode == OP_CAST or inst.opcode == OP_COPY or inst.opcode == OP_MOVE:
                    cur = inst.src1
                    found = true
                    break
                return -1 as i64
            i = i + 1
        if not found:
            return -1 as i64
        depth = depth + 1
    return -1 as i64

pub fn select_inst(mut sel: ptr[InstructionSelector], inst: ptr[AirInst], mut out_insts: ptr[MachInstVec]):
    let op = inst.opcode
    if op == OP_NOP:
        return

    if op == OP_ICONST:
        let t_id = inst.type_id as u32
        mut is_str := (t_id == 12 as u32)
        if t_id < sel.table.entries.len as u32:
            if sel.table.entries.data[t_id].size == 16 as u32:
