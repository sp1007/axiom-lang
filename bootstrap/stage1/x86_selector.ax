            emit_block_copy(sel, inst.src1, disp, inst.dest, size, out_insts)
        else:
            out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: size as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: disp as i64)))

    elif op == OP_MAKE_REF:
        // `&x`. For a SCALAR, x lives in its stack slot, so &x = slot home address
        // (LEA [src1], which the spill rewrite turns into LEA [RBP+slot]).
        // For a multi-byte by-address AGGREGATE (struct/array/tuple/generic-inst/str),
        // the value vreg ALREADY holds the address where the aggregate data lives, so
        // &agg = that value — emit MOV (which the spill rewrite loads from the slot).
        // Using LEA on a spilled aggregate would yield &slot not the data address,
        // breaking idioms like `(&s as ptr[str])[0]` (print_raw_ptr / reinterpret).
        //
        // EXCEPTION: sum/option/result (kind 6/11/12) use the pointer-layout
        // representation — the VALUE is an 8-byte (tagged) box pointer that lives in
        // its slot like a scalar. std/result.ax reads `(&self) as ptr[u64]; raw[0]`
        // expecting raw[0] to BE that box pointer, i.e. &self must be the SLOT address
        // (LEA), not the box pointer itself. Treating them as multi-byte aggregates
        // here (MOV) made `&self` yield the box pointer, so raw[0] read the boxed
        // PAYLOAD instead of the pointer → Result/Option.unwrap() corruption → the
        // read_all()/fread() crash that blocked stage2->stage3.
        let ref_src_type = get_register_type(sel, inst.src1)
        mut ref_src_kind := 0 as u8
        if (ref_src_type as i64) < sel.table.entries.len:
            ref_src_kind = sel.table.entries.data[ref_src_type].kind
        let ref_is_ptr_sum = ref_src_kind == 6 as u8 or ref_src_kind == 11 as u8 or ref_src_kind == 12 as u8
        if type_is_aggregate(sel.table, ref_src_type) and not ref_is_ptr_sum:
            out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    elif op == OP_DEREF:
        mut type_size := 8 as u32
        let src_type = get_register_type(sel, inst.src1)
        if src_type == 12 as u32:
            out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, 
                dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), 
                src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), 
                src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            let tmp_ptr = next_vreg(sel)
            out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, 
                dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.src1, label: 0 as u32, imm: 0 as i64), 
                src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                
            out_insts.push(MachInst(op: MACH_AND, cc: 0 as u8, padding: 0 as u8, 
                dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 281474976710655 as i64)))

            let type_id = get_register_type(sel, inst.dest)
            if type_id < sel.table.entries.len as u32:
                type_size = sel.table.entries.data[type_id].size

            // str (type 12) is a 16-byte {ptr,len} value: dereferencing a
            // ptr[str] must read all 16 bytes. Forcing 8 here dropped the len
            // field, so Result/Option unwrap of a str payload returned a str
            // with a garbage length.
            if type_id == 12 as u32:
                type_size = 16 as u32

            // The deref's own type_id is not always monomorphised to the
            // concrete pointee (a generic T resolving to str). Recover the size
            // from the source pointer's concrete register type when it is
            // ptr[str]/ref[str]. Limited to str because struct values are 8-byte
            // heap references whose entry.size is the full struct size.
            if src_type < sel.table.entries.len as u32:
                let se = sel.table.entries.data[src_type]
                if (se.kind == TYPE_KIND_POINTER or se.kind == TYPE_KIND_REF) and se.extra == 12 as u32:
                    type_size = 16 as u32

            // Deref of ptr[aggregate] (`p.*` where p: ptr[Struct/Sum/etc], not str):
            // aggregate VALUES are 8-byte heap references in this backend (e.g.
            // Ok(Struct(..)) stores the 8-byte struct reference into its box, so
            // [box] = the struct's heap pointer). `entry.size` is the FULL struct
            // size, so MACH_LOAD of that many bytes is wrong — load the 8-byte
            // reference. The deref's own type_id (T) is often left generic when p
            // came from `masked as ptr[T]` in Result/Option.unwrap, so detect
            // aggregateness from both the (build-time recovered) dest type and the
            // operand's concrete pointee. Root cause of Result.unwrap() of a struct
            // payload (`typed_ptr.*`) returning a corrupt struct → fread crash.
            mut deref_is_agg := false
            if type_size != 16 as u32 and type_is_aggregate(sel.table, type_id):
                deref_is_agg = true
            if type_size != 16 as u32 and src_type < sel.table.entries.len as u32:
                let se2 = sel.table.entries.data[src_type]
                if (se2.kind == TYPE_KIND_POINTER or se2.kind == TYPE_KIND_REF) and type_is_aggregate(sel.table, se2.extra):
                    deref_is_agg = true
            if deref_is_agg:
                type_size = 8 as u32

            if type_size == 16 as u32:
                let tmp_dest_addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

                let tmp_val1 = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val1, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val1, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

                let tmp_val2 = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val2, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val2, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: type_size as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

        if type_size == 1 as u32 or type_size == 2 as u32 or type_size == 4 as u32:
            emit_load_extend(sel, inst.dest, type_size, get_register_type(sel, inst.dest), out_insts)

    else:
        out_insts.push(MachInst(op: MACH_NOP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

// Materialize all parameters into their param vregs at function entry.
//
// The previous design materialized params lazily on first use. For 8-byte
// params that emitted `MOV pvreg = arg_reg`, which the register allocator
// detects (param_idx_of_vreg) and protects from being colored with a *later*
// param's arg register. But 16-byte (str) params materialize via LOAD/LEA/STORE
// with fresh scratch temps that carry no such protection, so an earlier str
// param's scratch could grab a later param's incoming arg register (e.g. RDX),
// clobbering it before that later param was read. The symptom: with two str
// params, reading the 2nd returned the 1st's value.
//
// Fix: snapshot every integer-register-passed argument into a fresh vreg via
// `MOV snap = arg_reg` FIRST. Those MOVs are param-tagged and mutually
// non-clobbering, so after this phase all original arg registers are safely
// captured and later value-loading scratch may use any register. Then load each
// parameter's value from its snapshot. param_idx_processed is set past the end
// so the lazy per-instruction paths are skipped.
pub fn emit_param_prologue(sel: ptr[InstructionSelector], out_insts: ptr[MachInstVec]):
    let nparams = sel.fn_ptr.params.len
    if nparams <= 0 as i64:
        return
    let snaps = @alloc(nparams * 4 as i64) as ptr[u32]
    // Phase 1: snapshot incoming arg registers (protected MOVs).
    // RFC 0006: a float param (f32/f64) arrives in the positional XMM arg reg
    // (XMM0..XMM3 on win64), not the integer arg reg. Reading it from RCX/RDX
    // yielded garbage → all float fn args were 0. The snapshot MOV preserves the
    // raw 64 bits even if `snap` is GPR-classified (movq is bit-exact), and the
    // param vreg (float-typed) is XMM-classified so phase-2 movq restores it.
    mut p := 0 as i64
    while p < nparams:
        snaps[p] = 0 as u32
        let pty_snap = sel.fn_ptr.params.data[p] as u32
        mut phys := abi_int_arg_reg(sel.abi_name, p)
        if pty_snap == 9 as u32 or pty_snap == 10 as u32:
            phys = abi_float_arg_reg(sel.abi_name, p)
        if phys != REG_NONE:
            let snap = next_vreg(sel)
            snaps[p] = snap
            out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: phys, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        p = p + 1
    // Phase 2: store each parameter's value into its param vreg.
    p = 0 as i64
    while p < nparams:
        let pvreg = (p + 1 as i64) as u32
        mut psize := 8 as u32
        let pty = sel.fn_ptr.params.data[p] as u32
        if pty < sel.table.entries.len as u32:
            psize = sel.table.entries.data[pty as i64].size
        mut phys := abi_int_arg_reg(sel.abi_name, p)
        if pty == 9 as u32 or pty == 10 as u32:
            phys = abi_float_arg_reg(sel.abi_name, p)
        if phys != REG_NONE:
            let snap = snaps[p]
            // RFC 0001: `str` (16-byte PRIMITIVE) is passed as a pointer and copied
            // 16-byte-inline into its param home. A by-address aggregate param is
            // ITSELF an 8-byte pointer in the arg register — store it directly (the
            // else branch); copying 16 bytes made the home hold the data while
            // getfld then derefs it -> deref of the field value (segfault, tsp).
            if psize == 16 as u32 and not type_is_aggregate(sel.table, pty):
                // arg register held a pointer to the 16-byte value
                let lo = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                let hi = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                let addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            // stack-passed parameter (arg index >= number of register args)
            mut offset := 0 as i64
            if sel.abi_name == "win64":
                offset = 48 as i64 + (p - 4 as i64) * 8 as i64
            else:
                offset = 16 as i64 + (p - 6 as i64) * 8 as i64
            // RFC 0001: see register-passed case above — aggregate = 8-byte pointer.
            if psize == 16 as u32 and not type_is_aggregate(sel.table, pty):
                let saddr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)))
                let lo = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                let hi = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                let addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)))
        p = p + 1
    @free(snaps as ptr[u8])

pub fn select_all(f: ptr[AirFunc], abi: str, table: ptr[TypeTable], symbols: ptr[SymbolTable], pool: ptr[InternPool]) -> MachInstVec:
    mut actual_max_vreg := 0 as u32
    mut vi := 0 as i64
    while vi < f.insts.len:
        let inst = &f.insts.data[vi]
        if inst.dest > actual_max_vreg:
            actual_max_vreg = inst.dest
        vi = vi + 1

    mut actual_max_label := 0 as u32
    mut bi_init := 0 as i64
    while bi_init < f.blocks.len:
        let bb = &f.blocks.data[bi_init]
        if bb.id > actual_max_label:
            actual_max_label = bb.id
        bi_init = bi_init + 1

    if actual_max_label < 1000000 as u32:
        actual_max_label = 1000000 as u32

    // PERF: build the def-index once (sized to the max AIR dest); get_register_type
    // uses it to avoid an O(insts) scan per call (25 call sites, many per inst).
    let gr_def_size = (actual_max_vreg as i64) + 1 as i64
    let gr_def_idx = build_vreg_def_idx(f, gr_def_size)

    mut sel := InstructionSelector(
        fn_ptr: f,
        abi_name: abi,
        table: table,
        param_idx_processed: 0,
        symbols: symbols,
        pool: pool,
        max_vreg: actual_max_vreg,
        max_label: actual_max_label,
        def_idx: gr_def_idx,
        def_size: gr_def_size
    )
    mut result := new_mach_inst_vec()

    let fn_name = pool.get(f.name)
    let is_main = (fn_name == "main" or fn_name == "_AX_main_main_v_v")

    if f.blocks.len > 0:
        mut bi := 0 as i64
        while bi < f.blocks.len:
            let bb = &f.blocks.data[bi]
            result.push(MachInst(op: MACH_LABEL, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_LABEL, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: bb.id, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
            
            if is_main and bi == 0 as i64:
                if abi == "win64":
                    result.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 32 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                result.push(MachInst(op: MACH_CALL, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: -4 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                if abi == "win64":
                    result.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 32 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

            if bi == 0 as i64:
                emit_param_prologue(&sel, &result)
                sel.param_idx_processed = sel.fn_ptr.params.len as i32

            mut i := 0 as i64
            while i < bb.instrs_len as i64:
                let inst_idx = f.block_instrs.data[bb.instrs_start as i64 + i]
                if inst_idx < f.insts.len as u32:
                    let inst = &f.insts.data[inst_idx as i64]
                    select_inst(&sel, inst, &result)
                i = i + 1
            bi = bi + 1
    else:
        emit_param_prologue(&sel, &result)
        sel.param_idx_processed = sel.fn_ptr.params.len as i32
        mut i := 0 as i64
        while i < f.insts.len:
            let inst = &f.insts.data[i]
            select_inst(&sel, inst, &result)
            i = i + 1

    @free(gr_def_idx as ptr[u8])
    return result
