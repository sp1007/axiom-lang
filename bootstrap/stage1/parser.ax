// bootstrap/stage1/parser.ax
// AXIOM Recursive Descent + Pratt parser written in AXIOM itself.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

// Pratt binding power constants
pub const BP_NONE: i32 = 0
pub const BP_OR: i32 = 10
pub const BP_AND: i32 = 20
pub const BP_NOT: i32 = 30
pub const BP_CMP: i32 = 40
pub const BP_BIT_OR: i32 = 50
pub const BP_BIT_XOR: i32 = 60
pub const BP_BIT_AND: i32 = 70
pub const BP_SHIFT: i32 = 80
pub const BP_ADD: i32 = 90
pub const BP_MUL: i32 = 100
pub const BP_POWER: i32 = 110
pub const BP_AS: i32 = 115
pub const BP_UNARY: i32 = 120
pub const BP_POSTFIX: i32 = 130

pub struct Parser:
    tokens: TokenVec
    pos: i64
    tree: ptr[AstTree]
    pool: ptr[InternPool]
    src: str
    diags_count: i64
    current_struct: u32       // RFC 0002: intern id of struct being parsed (0 = none); for untyped `self`
    current_struct_tok: u32   // RFC 0002: token idx of that struct's name (for synthesized self type node)

pub fn new_parser(tokens: TokenVec, src: str, pool: ptr[InternPool]) -> ptr[Parser]:
    let parser = @alloc(512) as ptr[Parser]
    parser[0] = Parser(
        tokens: tokens,
        pos: 0,
        tree: new_ast_tree(src, tokens),
        pool: pool,
        src: src,
        diags_count: 0,
        current_struct: 0 as u32,
        current_struct_tok: 0 as u32,
    )
    return parser

pub fn peek(mut self: ptr[Parser]) -> Token:
    // Skip bare NEWLINEs
    while self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_NEWLINE:
        self.pos = self.pos + 1
    if self.pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[self.pos]

pub fn peek_raw(self: ptr[Parser]) -> Token:
    if self.pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[self.pos]

pub fn peek_at(self: ptr[Parser], offset: i64) -> Token:
    mut pos := self.pos + offset
    while pos < self.tokens.len and self.tokens.data[pos].kind == TK_NEWLINE:
        pos = pos + 1
    if pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[pos]

pub fn consume(mut self: ptr[Parser]) -> Token:
    let tok = self.peek()
    if self.pos < self.tokens.len:
        self.pos = self.pos + 1
    return tok

pub fn check(mut self: ptr[Parser], kind: u8) -> bool:
    return self.peek().kind == kind

pub fn check_raw(self: ptr[Parser], kind: u8) -> bool:
    return self.peek_raw().kind == kind

pub fn errorf(mut self: ptr[Parser], tok: Token, msg: str):
    self.diags_count = self.diags_count + 1
    // Simple diagnostic printing
    ax_printf_local("error: %s at offset %d\n", (msg as ptr[u8]) as i64, tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

pub fn expect(mut self: ptr[Parser], kind: u8) -> Token:
    let tok = self.peek()
    if tok.kind != kind:
        ax_printf_local("[DEBUG-EXPECT-FAIL] expected=%d got=%d offset=%d\n", kind as i64, tok.kind as i64, tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_printf_local("[DEBUG-SURROUNDING] self.pos=%d tokens.len=%d\n", self.pos as i64, self.tokens.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        mut idx := self.pos - 5 as i64
        if idx < 0 as i64:
            idx = 0 as i64
        while idx < self.pos + 5 as i64 and idx < self.tokens.len:
            let t = self.tokens.data[idx]
            ax_printf_local("  tokens[%d]: kind=%d offset=%d\n", idx as i64, t.kind as i64, t.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            idx = idx + 1
        self.errorf(tok, "unexpected token")
        return tok
    return self.consume()

pub fn expect_newline(mut self: ptr[Parser]):
    // A `;` separates multiple statements on one physical line and is equivalent to a
    // newline terminator (e.g. `putchar(x); fflush(null)`). Consume it so the next
    // statement parses cleanly — previously this raised a spurious "expected newline"
    // diagnostic even though codegen recovered (BUG#53 companion; §8: no false errors).
    if self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_SEMICOLON:
        self.pos = self.pos + 1
        return
    if self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_NEWLINE:
        self.pos = self.pos + 1
        return
    let raw = self.peek_raw()
    if raw.kind != TK_EOF and raw.kind != TK_DEDENT:
        self.errorf(raw, "expected newline")

pub fn token_idx(self: ptr[Parser], tok: Token) -> u32:
    mut lo := 0 as i64
    mut hi := self.tokens.len
    while lo < hi:
        let mid = (lo + hi) / 2
        if self.tokens.data[mid].offset < tok.offset:
            lo = mid + 1
        else:
            hi = mid
    if lo < self.tokens.len:
        return lo as u32
    return 0 as u32

pub fn token_text(self: ptr[Parser], tok: Token) -> str:
    if tok.len == 0 as u16:
        return ""
    let start_ptr = ((self.src as ptr[u8]) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn append_child(mut self: ptr[Parser], parent: u32, child: u32):
    if self.tree.nodes.data[parent].first_child == NULL_IDX:
        self.tree.nodes.data[parent].first_child = child
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while self.tree.nodes.data[cur].next_sibling != NULL_IDX:
        cur = self.tree.nodes.data[cur].next_sibling
    self.tree.nodes.data[cur].next_sibling = child

pub fn set_payload(mut self: ptr[Parser], node: u32, payload: u32):
    self.tree.nodes.data[node].payload = payload

pub fn set_flags(mut self: ptr[Parser], node: u32, flags: u16):
    self.tree.nodes.data[node].flags = self.tree.nodes.data[node].flags | flags

fn left_binding_power(kind: u8) -> i32:
    if kind == TK_OR:
        return BP_OR
    if kind == TK_AND:
        return BP_AND
    if kind == TK_EQ_EQ or kind == TK_BANG_EQ or kind == TK_LT or kind == TK_GT or kind == TK_LT_EQ or kind == TK_GT_EQ:
        return BP_CMP
    if kind == TK_PIPE:
        return BP_BIT_OR
    if kind == TK_CARET:
        return BP_BIT_XOR
    if kind == TK_AMP:
        return BP_BIT_AND
    if kind == TK_LT_LT or kind == TK_GT_GT:
        return BP_SHIFT
    if kind == TK_PLUS or kind == TK_MINUS:
        return BP_ADD
    if kind == TK_STAR or kind == TK_SLASH or kind == TK_PERCENT:
        return BP_MUL
    if kind == TK_STAR_STAR:
        return BP_POWER
    if kind == TK_AS:
        return BP_AS
    if kind == TK_DOT_DOT:
        return 35 // range
    if kind == TK_DOT or kind == TK_DOT_STAR or kind == TK_L_BRACKET or kind == TK_L_PAREN:
        return BP_POSTFIX
    return BP_NONE

pub fn parse_expr_with_prec(mut self: ptr[Parser], min_bp: i32) -> u32:
    mut left := self.parse_nud()
    if left == 0 as u32:
        return 0 as u32
    while true:
        let tok = self.peek_raw()
        let bp = left_binding_power(tok.kind)
        if bp <= min_bp:
            break
        left = self.parse_led(left, tok, bp)
        if left == 0 as u32:
            break
    // Diagnostic recovery: a `{` immediately after a complete primary is never
    // valid in expression position -- struct literals use call syntax
    // `Type(field: value)`, and blocks are indentation-based (no brace blocks).
    // Without this, a Rust/Go-style `Point{x: 1, y: 2}` detonates into a ~10-
    // error cascade ("expected newline" + "expected expression nud" per token).
    // Emit ONE targeted diagnostic and skip the balanced brace block to recover.
    // Fixpoint-safe: the compiler's own sources never place `{` after an
    // expression, so this branch never fires during self-compilation (A==B).
    if left != 0 as u32:
        if self.peek_raw().kind == TK_L_BRACE:
            let brace_tok = self.peek_raw()
            self.errorf(brace_tok, "struct literals use parentheses, not braces: write `Type(field: value, ...)`")
            self.consume() // '{'
            mut depth := 1 as i32
            while depth > 0 as i32 and not self.check_raw(TK_EOF):
                let t = self.peek_raw()
                if t.kind == TK_L_BRACE:
                    depth = depth + 1 as i32
                elif t.kind == TK_R_BRACE:
                    depth = depth - 1 as i32
                self.consume()
    return left

pub fn parse_nud(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT:
        self.consume()
        let node = self.tree.add_node(NODE_IDENT, self.token_idx(tok))
        let text = self.token_text(tok)
        let name_id = self.pool.intern(text)
        @free(text as ptr[u8])
        self.set_payload(node, name_id)
        return node
    if tok.kind == TK_INT_LIT:
        self.consume()
        return self.tree.add_node(NODE_INT_LIT, self.token_idx(tok))
    if tok.kind == TK_FLOAT_LIT:
        self.consume()
        return self.tree.add_node(NODE_FLOAT_LIT, self.token_idx(tok))
    if tok.kind == TK_STRING_LIT:
        self.consume()
        return self.tree.add_node(NODE_STRING_LIT, self.token_idx(tok))
    if tok.kind == TK_CHAR_LIT:
        self.consume()
        return self.tree.add_node(NODE_CHAR_LIT, self.token_idx(tok))
    if tok.kind == TK_TRUE or tok.kind == TK_FALSE:
        self.consume()
        return self.tree.add_node(NODE_BOOL_LIT, self.token_idx(tok))
    if tok.kind == TK_NIL:
        self.consume()
        return self.tree.add_node(NODE_NIL_LIT, self.token_idx(tok))
    // RFC 0008: closure/lambda `|params| -> RetType body-expr`. A leading `|` in
    // NUD (prefix) position is unambiguous (infix bitwise-or is a LED, and sum
    // types never begin an expression). MVP: params + return type are annotated
    // (no inference); body is a single expression. Lifted to a top-level function
    // by lift_closures() before name resolution, then reuses fn-ptr lowering.
    if tok.kind == TK_PIPE:
        return self.parse_closure_expr()
    if tok.kind == TK_MINUS or tok.kind == TK_TILDE or tok.kind == TK_AMP:
        self.consume()
        let node = self.tree.add_node(NODE_UNARY_EXPR, self.token_idx(tok))
        let operand = self.parse_expr_with_prec(BP_UNARY)
        if operand != 0 as u32:
            self.append_child(node, operand)
        return node
    if tok.kind == TK_NOT:
        self.consume()
        let node = self.tree.add_node(NODE_UNARY_EXPR, self.token_idx(tok))
        let operand = self.parse_expr_with_prec(BP_NOT)
        if operand != 0 as u32:
            self.append_child(node, operand)
        return node
    if tok.kind == TK_L_PAREN:
        self.consume() // '('
        let inner = self.parse_expr_with_prec(BP_NONE)
        // RFC 0022: a `,` here promotes the group to a TUPLE literal. `(e)` (no
        // comma) stays a grouping expression (unchanged). `(e,)` is a 1-tuple;
        // `(a, b, ...)` an N-tuple; a trailing comma before `)` is allowed. A
        // comma in this prefix position was previously a hard parse error, so
        // this only accepts new syntax and cannot affect existing programs
        // (self-host A==B preserved, cf. the array-literal NUD).
        if self.check(TK_COMMA):
            let node = self.tree.add_node(NODE_TUPLE_EXPR, self.token_idx(tok))
            if inner != 0 as u32:
                self.append_child(node, inner)
            while self.check(TK_COMMA):
                self.consume() // ','
                if self.check(TK_R_PAREN):
                    break // trailing comma
                let prev_pos = self.pos
                let e = self.parse_expr_with_prec(BP_NONE)
                if e != 0 as u32:
                    self.append_child(node, e)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        self.expect(TK_R_PAREN)
        return inner
    if tok.kind == TK_L_BRACKET:
        // Array literal `[e0, e1, ...]`. Unambiguous in NUD (primary) position:
        // `[` here can only start a NEW expression (postfix indexing `a[i]` is
        // handled as a LED on an already-parsed primary, not here) -- this
        // combination was previously always a parse error ("expected
        // expression nud"), so no existing valid syntax is affected.
        self.consume() // '['
        let node = self.tree.add_node(NODE_ARRAY_LIT, self.token_idx(tok))
        while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(node, expr)
            if not self.check(TK_R_BRACKET):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACKET)
        return node
    if tok.kind == TK_SPAWN:
        self.consume()
        let node = self.tree.add_node(NODE_SPAWN_EXPR, self.token_idx(tok))
        let expr = self.parse_expr_with_prec(BP_UNARY)
        if expr != 0 as u32:
            self.append_child(node, expr)
        return node
    if tok.kind == TK_AWAIT:
        self.consume()
        let node = self.tree.add_node(NODE_AWAIT_EXPR, self.token_idx(tok))
        let expr = self.parse_expr_with_prec(BP_UNARY)
        if expr != 0 as u32:
            self.append_child(node, expr)
        return node
    if tok.kind == TK_HASH:
        let hash_tok = self.consume()
        let run_tok = self.expect(TK_IDENT)
        let run_text = self.token_text(run_tok)
        mut is_run := false
        if std.string.len(run_text) > 0:
            if run_text == "run":
                is_run = true
            @free(run_text as ptr[u8])

        if is_run:
            let comptime_node = self.tree.add_node(NODE_COMPTIME, self.token_idx(hash_tok))
            if self.check(TK_L_BRACE):
                self.consume() // '{'
                let block_node = self.tree.add_node(NODE_BLOCK, self.token_idx(run_tok))
                while not self.check(TK_R_BRACE) and not self.check(TK_EOF):
                    let prev_pos = self.pos
                    let stmt = self.parse_stmt()
                    if stmt != 0 as u32:
                        self.append_child(block_node, stmt)
                    if self.pos == prev_pos:
                        self.consume()
                self.expect(TK_R_BRACE)
                self.append_child(comptime_node, block_node)
            elif self.check(TK_COLON):
                self.consume() // ':'
                let block_node = self.parse_block()
                if block_node != 0 as u32:
                    self.append_child(comptime_node, block_node)
            else:
                let expr_node = self.parse_expr_with_prec(BP_NONE)
                if expr_node != 0 as u32:
                    self.append_child(comptime_node, expr_node)
            return comptime_node
        else:
            return self.tree.add_node(NODE_ERROR, self.token_idx(hash_tok))

    self.errorf(tok, "expected expression nud")
    self.consume()
    return 0 as u32

pub fn parse_led(mut self: ptr[Parser], left: u32, op_tok: Token, bp: i32) -> u32:
    self.consume() // consume operator
    if (op_tok.kind == TK_OR or op_tok.kind == TK_AND or
        op_tok.kind == TK_EQ_EQ or op_tok.kind == TK_BANG_EQ or
        op_tok.kind == TK_LT or op_tok.kind == TK_GT or op_tok.kind == TK_LT_EQ or op_tok.kind == TK_GT_EQ or
        op_tok.kind == TK_PIPE or op_tok.kind == TK_CARET or op_tok.kind == TK_AMP or
        op_tok.kind == TK_LT_LT or op_tok.kind == TK_GT_GT or
        op_tok.kind == TK_PLUS or op_tok.kind == TK_MINUS or
        op_tok.kind == TK_STAR or op_tok.kind == TK_SLASH or op_tok.kind == TK_PERCENT or
        op_tok.kind == TK_DOT_DOT):
        let node = self.tree.add_node(NODE_BINARY_EXPR, self.token_idx(op_tok))
        mut flags := 0 as u16
        if (op_tok.kind == TK_EQ_EQ or op_tok.kind == TK_BANG_EQ or
            op_tok.kind == TK_LT or op_tok.kind == TK_GT or
            op_tok.kind == TK_LT_EQ or op_tok.kind == TK_GT_EQ):
            flags = 1 as u16
        elif op_tok.kind == TK_AND or op_tok.kind == TK_OR:
            flags = 2 as u16
        if flags != 0 as u16:
            self.set_flags(node, flags)
        self.append_child(node, left)
        let right = self.parse_expr_with_prec(bp)
        if right != 0 as u32:
            self.append_child(node, right)
        return node
    if op_tok.kind == TK_STAR_STAR:
        let node = self.tree.add_node(NODE_BINARY_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        let right = self.parse_expr_with_prec(bp - 1)
        if right != 0 as u32:
            self.append_child(node, right)
        return node
    if op_tok.kind == TK_DOT:
        let tok = self.peek()
        // RFC 0022: `t.0` / `t.1` — an INT_LIT selector is tuple field access.
        // Rewrite it to the synth field name `_f<N>` so it resolves against the
        // tuple's anonymous struct fields via ordinary name-based resolution.
        // `t.0` was previously a hard parse error, so this only adds syntax.
        if self.check(TK_INT_LIT):
            let field_tok = self.consume()
            let itext = self.token_text(field_tok)
            let fname = std.string.concat("_f", itext)
            @free(itext as ptr[u8])
            let node = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
            self.append_child(node, left)
            self.set_payload(node, self.pool.intern(fname))
            @free(fname as ptr[u8])
            let field_name = self.tree.add_node(NODE_IDENT, self.token_idx(field_tok))
            self.append_child(node, field_name)
            return node
        let field_tok = self.expect(TK_IDENT)
        let node = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
        self.append_child(node, left)
        let text = self.token_text(field_tok)
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        let field_name = self.tree.add_node(NODE_IDENT, self.token_idx(field_tok))
        self.append_child(node, field_name)
        return node
    if op_tok.kind == TK_DOT_STAR:
        let node = self.tree.add_node(NODE_DEREF_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        return node
    if op_tok.kind == TK_L_BRACKET:
        let node = self.tree.add_node(NODE_INDEX_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let idx = self.parse_expr_with_prec(BP_NONE)
            if idx != 0 as u32:
                self.append_child(node, idx)
            if not self.check(TK_R_BRACKET):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACKET)
        return node
    if op_tok.kind == TK_L_PAREN:
        return self.parse_call_args(left, op_tok)
    if op_tok.kind == TK_AS:
        let node = self.tree.add_node(NODE_CAST_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        let type_node = self.parse_type_expr()
        if type_node != 0 as u32:
            self.append_child(node, type_node)
        return node

    return left

pub fn parse_call_args(mut self: ptr[Parser], callee: u32, lparen: Token) -> u32:
    let node = self.tree.add_node(NODE_CALL_EXPR, self.token_idx(lparen))
    self.append_child(node, callee)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        if self.check(TK_IDENT) and self.peek_at(1 as i64).kind == TK_COLON:
            let arg_node = self.tree.add_node(NODE_NAMED_ARG, self.token_idx(self.peek()))
            let name_tok = self.consume()
            self.consume() // :
            let text = self.token_text(name_tok)
            let name_id = self.pool.intern(text)
            @free(text as ptr[u8])
            self.set_payload(arg_node, name_id)
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(arg_node, expr)
            self.append_child(node, arg_node)
        else:
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(node, expr)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)
    return node

pub fn parse_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_LET or tok.kind == TK_MUT:
        return self.parse_var_decl()
    if tok.kind == TK_RETURN:
        return self.parse_return_stmt()
    if tok.kind == TK_IF:
        return self.parse_if_stmt()
    if tok.kind == TK_WHILE:
        return self.parse_while_loop()
    if tok.kind == TK_FOR:
        return self.parse_for_loop()
    if tok.kind == TK_MATCH:
        return self.parse_match_stmt()
    if tok.kind == TK_BREAK:
        return self.parse_break_stmt()
    if tok.kind == TK_CONTINUE:
        return self.parse_continue_stmt()
    if tok.kind == TK_UNSAFE:
        return self.parse_unsafe_block()
    if tok.kind == TK_IN:
        return self.parse_arena_block()
    if tok.kind == TK_DEFER:
        return self.parse_defer_stmt()

    return self.parse_expr_stmt()

// RFC 0006 (#38.4): `defer Expr NEWLINE`. The expression is recorded (not run)
// and executed at scope exit, LIFO. See air_builder.lower_defer / flush_defers.
pub fn parse_defer_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_DEFER)
    let node = self.tree.add_node(NODE_DEFER_STMT, self.token_idx(tok))
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect_newline()
    return node

// RFC 0006 (#38.5/#38.6): `unsafe:` and `in [arena]:` blocks. Both are parsed
// and their body lowered transparently (codegen no-op wrapper) — unsafe disables
// generational checks (not yet enforced) and arena routes allocations (routing
// deferred); for now both just execute their inner block.
pub fn parse_unsafe_block(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_UNSAFE)
    let node = self.tree.add_node(NODE_UNSAFE_BLOCK, self.token_idx(tok))
    self.expect(TK_COLON)
    let block = self.parse_block()
    if block != 0 as u32:
        self.append_child(node, block)
    return node

pub fn parse_arena_block(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IN)
    let node = self.tree.add_node(NODE_ARENA_BLOCK, self.token_idx(tok))
    self.expect(TK_L_BRACKET)
    let name = self.expect(TK_IDENT)
    let text = self.token_text(name)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_R_BRACKET)
    self.expect(TK_COLON)
    let block = self.parse_block()
    if block != 0 as u32:
        self.append_child(node, block)
    return node

pub fn parse_break_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_BREAK)
    let node = self.tree.add_node(NODE_BREAK_STMT, self.token_idx(tok))
    self.expect_newline()
    return node

pub fn parse_continue_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_CONTINUE)
    let node = self.tree.add_node(NODE_CONTINUE_STMT, self.token_idx(tok))
    self.expect_newline()
    return node

pub fn parse_var_decl(mut self: ptr[Parser]) -> u32:
    let tok = self.consume() // let/mut
    // RFC 0022 P3: tuple destructuring `let (a, b, ...) = EXPR`. A `(` right after
    // `let`/`mut` (where a binding NAME is otherwise required) is unambiguous.
    if self.check(TK_L_PAREN):
        return self.parse_tuple_destructure(tok)
    let node = self.tree.add_node(NODE_VAR_DECL, self.token_idx(tok))
    if tok.kind == TK_MUT:
        self.set_flags(node, FLAG_IS_MUT as u16)
    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    if self.check(TK_COLON):
        self.consume() // ':'
        let t = self.parse_type_expr()
        if t != 0 as u32:
            self.append_child(node, t)
    // The initializer `=`/`:=` is always on the SAME physical line as the declaration.
    // Probe with check_raw (non-skipping): `check` calls the newline-skipping `peek`,
    // which — on a declaration with NO initializer (`mut g: i64`) — would consume the
    // terminating newline while looking for `=`, leaving `expect_newline` staring at the
    // NEXT statement ("expected newline" desync). A raw probe leaves the newline intact
    // so a no-initializer decl terminates cleanly (module globals then default to a
    // zeroed `.data` slot; see collect_global).
    if self.check_raw(TK_EQ) or self.check_raw(TK_COLON_EQ):
        self.consume()
        let val = self.parse_expr_with_prec(BP_NONE)
        if val != 0 as u32:
            self.append_child(node, val)
    self.expect_newline()
    return node

// RFC 0022 P3: desugar `let (a, b, ...) = EXPR` into a scope-transparent block:
//   { let __td<n> = EXPR ; let a = __td<n>._f0 ; let b = __td<n>._f1 ; ... }
// A bare NODE_BLOCK does not push a scope in the resolver, so the bindings land in
// the ENCLOSING scope (visible after the destructure). The temp evaluates EXPR once;
// each binding reads one tuple field through the ordinary tuple field-access path
// (`_f<i>`). `_` bindings are skipped. Nested patterns are deferred (P3+): bindings
// must be plain names or `_`.
pub fn parse_tuple_destructure(mut self: ptr[Parser], kw_tok: Token) -> u32:
    let is_mut = (kw_tok.kind == TK_MUT)
    self.consume() // '('
    mut names := new_u32_vec()   // interned binding name ids; 0 == wildcard `_`
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let nt = self.peek()
        if nt.kind == TK_IDENT:
            self.consume()
            let ntext = self.token_text(nt)
            if std.string.len(ntext) == 1 as i64 and ntext[0] == 95 as u8: // '_'
                (&names).push(0 as u32)
            else:
                (&names).push(self.pool.intern(ntext))
            @free(ntext as ptr[u8])
        else:
            self.errorf(nt, "tuple destructuring binding must be a name or `_`")
            self.consume()
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)
    if self.check_raw(TK_EQ) or self.check_raw(TK_COLON_EQ):
        self.consume()
    else:
        self.errorf(self.peek(), "tuple destructuring requires an initializer `= EXPR`")
    let init = self.parse_expr_with_prec(BP_NONE)
    self.expect_newline()

    let block = self.tree.add_node(NODE_BLOCK, self.token_idx(kw_tok))
    // Unique temp name from the block's own (unique) node index.
    let uniq = std.string.to_str(block as i64)
    let tmp_str = std.string.concat("__td", uniq)
    safe_free_str(uniq)
    let tmp_name_id = self.pool.intern(tmp_str)
    safe_free_str(tmp_str)
    let tmp_decl = self.tree.add_node(NODE_VAR_DECL, self.token_idx(kw_tok))
    self.set_payload(tmp_decl, tmp_name_id)
    if init != 0 as u32:
        self.append_child(tmp_decl, init)
    self.append_child(block, tmp_decl)

    mut i := 0 as i64
    while i < names.len:
        let nm = names.data[i]
        if nm != 0 as u32:
            let bind = self.tree.add_node(NODE_VAR_DECL, self.token_idx(kw_tok))
            if is_mut:
                self.set_flags(bind, FLAG_IS_MUT as u16)
            self.set_payload(bind, nm)
            // field access: __td._f<i>
            let obj = self.tree.add_node(NODE_IDENT, self.token_idx(kw_tok))
            self.set_payload(obj, tmp_name_id)
            let fld = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(kw_tok))
            self.append_child(fld, obj)
            let istr = std.string.to_str(i)
            let fstr = std.string.concat("_f", istr)
            safe_free_str(istr)
            self.set_payload(fld, self.pool.intern(fstr))
            safe_free_str(fstr)
            let fid = self.tree.add_node(NODE_IDENT, self.token_idx(kw_tok))
            self.append_child(fld, fid)
            self.append_child(bind, fld)
            self.append_child(block, bind)
        i = i + 1 as i64
    if names.data != null as ptr[u32]:
        @free(names.data as ptr[u8])
    return block

pub fn parse_return_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_RETURN)
    let node = self.tree.add_node(NODE_RETURN_STMT, self.token_idx(tok))
    let raw = self.peek_raw()
    if raw.kind != TK_NEWLINE and raw.kind != TK_DEDENT and raw.kind != TK_EOF:
        let val = self.parse_expr_with_prec(BP_NONE)
        if val != 0 as u32:
            self.append_child(node, val)
    self.expect_newline()
    return node

pub fn parse_if_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IF)
    let node = self.tree.add_node(NODE_IF_STMT, self.token_idx(tok))
    let cond = self.parse_expr_with_prec(BP_NONE)
    if cond != 0 as u32:
        self.append_child(node, cond)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)

    while self.check(TK_ELIF):
        let elif_tok = self.consume()
        let elif_node = self.tree.add_node(NODE_ELIF_CLAUSE, self.token_idx(elif_tok))
        let elif_cond = self.parse_expr_with_prec(BP_NONE)
        if elif_cond != 0 as u32:
            self.append_child(elif_node, elif_cond)
        self.expect(TK_COLON)
        let elif_body = self.parse_block()
        if elif_body != 0 as u32:
            self.append_child(elif_node, elif_body)
        self.append_child(node, elif_node)

    if self.check(TK_ELSE):
        let else_tok = self.consume()
        let else_node = self.tree.add_node(NODE_ELSE_CLAUSE, self.token_idx(else_tok))
        self.expect(TK_COLON)
        let else_body = self.parse_block()
        if else_body != 0 as u32:
            self.append_child(else_node, else_body)
        self.append_child(node, else_node)

    return node

pub fn parse_while_loop(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_WHILE)
    let node = self.tree.add_node(NODE_WHILE_STMT, self.token_idx(tok))
    let cond = self.parse_expr_with_prec(BP_NONE)
    if cond != 0 as u32:
        self.append_child(node, cond)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)
    return node

pub fn parse_for_loop(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_FOR)
    let node = self.tree.add_node(NODE_FOR_STMT, self.token_idx(tok))
    let var_tok = self.expect(TK_IDENT)
    let text = self.token_text(var_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_IN)
    let iter = self.parse_expr_with_prec(BP_NONE)
    if iter != 0 as u32:
        self.append_child(node, iter)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)
    return node

pub fn parse_match_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_MATCH)
    let node = self.tree.add_node(NODE_MATCH_STMT, self.token_idx(tok))
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect(TK_COLON)
    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after match")
        return node
    self.consume() // consume INDENT
    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let arm = self.parse_match_arm()
        if arm != 0 as u32:
            self.append_child(node, arm)
        if self.pos == prev_pos:
            self.pos = self.pos + 1
    if self.check(TK_DEDENT):
        self.consume()
    return node

pub fn parse_match_arm(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_MATCH_ARM, self.token_idx(tok))
    let pat = self.parse_pattern()
    if pat != 0 as u32:
        self.append_child(node, pat)
    self.expect(TK_COLON)
    if self.check(TK_INDENT):
        let body = self.parse_block()
        if body != 0 as u32:
            self.append_child(node, body)
    else:
        // Inline `:` body. A value expression is allowed (`Some(_): 0`), but a STATEMENT
        // (return/if/while/for/let/mut/break/continue/match) is not a value — the same
        // unsupported inline-suite form rejected for if/while (BUG#53). Feeding it to
        // parse_expr desyncs the arm loop into 10+ confusing cascade errors, so detect the
        // statement keyword up front and emit ONE actionable diagnostic, then skip the rest
        // of the physical line so the next arm (or DEDENT) parses cleanly (§8).
        let nb = self.peek()
        if (nb.kind == TK_RETURN or nb.kind == TK_IF or nb.kind == TK_WHILE or
            nb.kind == TK_FOR or nb.kind == TK_LET or nb.kind == TK_MUT or
            nb.kind == TK_BREAK or nb.kind == TK_CONTINUE or nb.kind == TK_MATCH):
            self.errorf(nb, "match arm body must be an indented block; an inline ':' with a statement is not supported -- put the statement(s) on the next line, indented")
            while self.pos < self.tokens.len and self.tokens.data[self.pos].kind != TK_NEWLINE and self.tokens.data[self.pos].kind != TK_DEDENT:
                self.pos = self.pos + 1
            return node
        let expr = self.parse_expr_with_prec(BP_NONE)
        if expr != 0 as u32:
            self.append_child(node, expr)
        self.expect_newline()
    return node

pub fn parse_pattern(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT:
        self.consume()
        let text = self.token_text(tok)
        let len = std.string.len(text)
        if len == 1 and text[0] as u8 == 95 as u8: // '_' ASCII is 95
            @free(text as ptr[u8])
            return self.tree.add_node(NODE_WILDCARD_PAT, self.token_idx(tok))
        if self.check(TK_L_PAREN):
            let node = self.tree.add_node(NODE_VARIANT_PAT, self.token_idx(tok))
            self.set_payload(node, self.pool.intern(text))
            @free(text as ptr[u8])
            self.consume() // '('
            while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
                let prev_pos = self.pos
                let inner = self.parse_pattern()
                if inner != 0 as u32:
                    self.append_child(node, inner)
                if not self.check(TK_R_PAREN):
                    self.expect(TK_COMMA)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        let node = self.tree.add_node(NODE_BINDING_PAT, self.token_idx(tok))
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        return node
    elif (tok.kind == TK_INT_LIT or tok.kind == TK_FLOAT_LIT or tok.kind == TK_STRING_LIT or
          tok.kind == TK_CHAR_LIT or tok.kind == TK_TRUE or tok.kind == TK_FALSE or tok.kind == TK_NIL):
        self.consume()
        return self.tree.add_node(NODE_LITERAL_PAT, self.token_idx(tok))
    elif tok.kind == TK_L_PAREN:
        self.consume()
        let node = self.tree.add_node(NODE_TUPLE_PAT, self.token_idx(tok))
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let inner = self.parse_pattern()
            if inner != 0 as u32:
                self.append_child(node, inner)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
        return node
    else:
        self.errorf(tok, "expected pattern")
        self.consume()
        return 0 as u32

pub fn parse_expr_stmt(mut self: ptr[Parser]) -> u32:
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr == 0 as u32:
        return 0 as u32
    let tok = self.peek_raw()
    if (tok.kind == TK_EQ or tok.kind == TK_PLUS_EQ or tok.kind == TK_MINUS_EQ or
        tok.kind == TK_STAR_EQ or tok.kind == TK_SLASH_EQ or tok.kind == TK_PERCENT_EQ):
        self.consume()
        let node = self.tree.add_node(NODE_ASSIGN_STMT, self.token_idx(tok))
        self.append_child(node, expr)
        let rhs = self.parse_expr_with_prec(BP_NONE)
        if rhs != 0 as u32:
            self.append_child(node, rhs)
        self.expect_newline()
        return node
    self.expect_newline()
    return expr

pub fn parse_block(mut self: ptr[Parser]) -> u32:
    // A suite must be an indented block on the following line. If there is no INDENT
    // here the source used an inline `:` suite (e.g. `if COND: return X`), which is not
    // supported — emit ONE actionable diagnostic and return an empty block so the driver
    // halts (BUG#53) without cascading confusing follow-on errors from a desynced parser.
    if not self.check(TK_INDENT):
        self.errorf(self.peek(), "expected an indented block; inline ':' suites are not supported -- put the statement on the next line, indented")
        return self.tree.add_node(NODE_BLOCK, self.token_idx(self.peek()))
    let tok = self.expect(TK_INDENT)
    let node = self.tree.add_node(NODE_BLOCK, self.token_idx(tok))
    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let stmt = self.parse_stmt()
        if stmt != 0 as u32:
            // RFC 0022 P3: `let (a,b) = e` desugars to a NODE_BLOCK holding a temp +
            // per-binding decls. No other statement form yields a bare NODE_BLOCK here,
            // so splice its (already-linked, 0-terminated) child chain directly into the
            // enclosing statement list — the bindings then live at the SAME lexical level
            // as ordinary locals (the proven flat form), not in a nested block.
            if self.tree.nodes.data[stmt as i64].kind == NODE_BLOCK:
                let fc = self.tree.nodes.data[stmt as i64].first_child
                if fc != 0 as u32:
                    self.append_child(node, fc)
            else:
                self.append_child(node, stmt)
        if self.pos == prev_pos:
            self.pos = self.pos + 1
    self.expect(TK_DEDENT)
    return node

pub fn parse_type_expr(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT or tok.kind == TK_FUTURE or tok.kind == TK_ISOLATED:
        self.consume()
        let node = self.tree.add_node(NODE_TYPE_EXPR, self.token_idx(tok))
        let text = self.token_text(tok)
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        if self.check_raw(TK_L_BRACKET):
            let gen_node = self.tree.add_node(NODE_GENERIC_TYPE, self.token_idx(tok))
            self.append_child(gen_node, node)
            self.consume() // [
            while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
                let prev_pos = self.pos
                let t = self.parse_type_expr()
                if t != 0 as u32:
                    self.append_child(gen_node, t)
                if not self.check(TK_R_BRACKET):
                    self.expect(TK_COMMA)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_BRACKET)
            return gen_node
        return node
    if tok.kind == TK_STAR:
        self.consume()
        let node = self.tree.add_node(NODE_PTR_TYPE, self.token_idx(tok))
        if self.check(TK_MUT):
            self.consume()
            self.set_flags(node, FLAG_IS_MUT as u16)
        let inner = self.parse_type_expr()
        if inner != 0 as u32:
            self.append_child(node, inner)
        return node
    if tok.kind == TK_L_BRACKET:
        self.consume()
        mut node := self.tree.add_node(NODE_SLICE_TYPE, self.token_idx(tok))
        let inner = self.parse_type_expr()
        if inner != 0 as u32:
            self.append_child(node, inner)
        if self.check(TK_SEMICOLON):
            self.consume()
            self.tree.nodes.data[node].kind = NODE_ARRAY_TYPE
            let size_tok = self.expect(TK_INT_LIT)
            let size_node = self.tree.add_node(NODE_INT_LIT, self.token_idx(size_tok))
            self.append_child(node, size_node)
        self.expect(TK_R_BRACKET)
        return node
    if tok.kind == TK_FN:
        self.consume()
        let node = self.tree.add_node(NODE_FUNC_TYPE, self.token_idx(tok))
        self.expect(TK_L_PAREN)
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(node, t)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
        if self.check_raw(TK_ARROW):
            self.consume()
            let ret = self.parse_type_expr()
            if ret != 0 as u32:
                self.append_child(node, ret)
                self.set_flags(node, 1 as u16)
        return node
    if tok.kind == TK_L_PAREN:
        // RFC 0022 P2: tuple TYPE `(T0, T1, ...)`. A bare `(` in type position was
        // always an error before (fn-types use `fn(...)`, never a bare paren), so
        // this only ACCEPTS previously-rejected syntax -> self-host A==B preserved.
        // A `,` makes it a tuple; `(T)` with no comma is a grouped type (returns
        // inner). Trailing comma allowed.
        self.consume() // '('
        let first = self.parse_type_expr()
        if self.check(TK_COMMA):
            let node = self.tree.add_node(NODE_TUPLE_TYPE, self.token_idx(tok))
            if first != 0 as u32:
                self.append_child(node, first)
            while self.check(TK_COMMA):
                self.consume() // ','
                if self.check(TK_R_PAREN):
                    break // trailing comma
                let prev_pos = self.pos
                let t = self.parse_type_expr()
                if t != 0 as u32:
                    self.append_child(node, t)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        self.expect(TK_R_PAREN)
        return first

    self.errorf(tok, "expected type expression")
    return 0 as u32

pub fn parse_generic_params(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_GENERIC_PARAMS, self.token_idx(tok))
    self.expect(TK_L_BRACKET)
    while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let gp = self.parse_generic_param()
        if gp != 0 as u32:
            self.append_child(node, gp)
        if not self.check(TK_R_BRACKET):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_BRACKET)
    return node

pub fn parse_generic_param(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_GENERIC_PARAM, self.token_idx(tok))
    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    if self.check(TK_COLON):
        self.consume()
        let constraint = self.parse_type_expr()
        if constraint != 0 as u32:
            self.append_child(node, constraint)
    return node

pub fn parse_func_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let fn_tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_FUNC_DECL, self.token_idx(fn_tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param_tok = self.peek()
        let param = self.tree.add_node(NODE_PARAM_DECL, self.token_idx(param_tok))
        if self.check(TK_LENT):
            self.consume()
            self.set_flags(param, FLAG_IS_LENT)
        elif self.check(TK_BANG):
            self.consume()
            self.set_flags(param, FLAG_IS_SINK)
        elif self.check(TK_MUT):
            self.consume()
            self.set_flags(param, FLAG_IS_MUT as u16)
        let param_name = self.expect(TK_IDENT)
        let param_text = self.token_text(param_name)
        let is_self = (param_text == "self")
        self.set_payload(param, self.pool.intern(param_text))
        @free(param_text as ptr[u8])
        if is_self and not self.check(TK_COLON) and self.current_struct != 0 as u32:
            // RFC 0002: untyped `self` -> synthesize the enclosing struct type, i.e. the
            // exact node `self: Struct` produces (verified to run identically since struct
            // values are by-address 8-byte pointers, BUG#30). The synthesized NODE_TYPE_EXPR
            // points its token at the STRUCT NAME token so type resolution (node_text_in_tree,
            // which reads token bytes — NOT payload) sees the struct name and resolves it.
            let self_ty = self.tree.add_node(NODE_TYPE_EXPR, self.current_struct_tok)
            self.set_payload(self_ty, self.current_struct)
            self.append_child(param, self_ty)
        else:
            self.expect(TK_COLON)
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(param, t)
        self.append_child(node, param)

        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()

    self.expect(TK_R_PAREN)

    if self.check(TK_ARROW):
        self.consume()
        let ret = self.parse_type_expr()
        if ret != 0 as u32:
            self.append_child(node, ret)

    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)

    return node

pub fn parse_interface_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_INTERFACE)
    let node = self.tree.add_node(NODE_INTERFACE_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_COLON)

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after interface declaration")
        return node
    self.consume() // consume INDENT

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let sig = self.parse_method_sig()
        if sig != 0 as u32:
            self.append_child(node, sig)
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()

    return node

pub fn parse_method_sig(mut self: ptr[Parser]) -> u32:
    mut is_async := false
    if self.check(TK_ASYNC):
        self.consume()
        is_async = true
    let tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_METHOD_SIG, self.token_idx(tok))
    if is_async:
        self.set_flags(node, FLAG_IS_ASYNC as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param = self.parse_param()
        if param != 0 as u32:
            self.append_child(node, param)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)

    if self.check_raw(TK_ARROW):
        self.consume()
        let ret = self.parse_type_expr()
        if ret != 0 as u32:
            self.append_child(node, ret)

    self.expect_newline()
    return node

pub fn parse_struct_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    mut is_packed := false
    if self.check(TK_PACKED):
        self.consume()
        is_packed = true
    let tok = self.expect(TK_STRUCT)
    let node = self.tree.add_node(NODE_STRUCT_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if is_packed:
        self.set_flags(node, 64 as u16) // FLAG_IS_PACKED is 64

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    let struct_name_id = self.pool.intern(name_text)
    self.set_payload(node, struct_name_id)
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_COLON)

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after struct declaration")
        return node
    self.consume() // consume INDENT

    // RFC 0002: methods in this body may use untyped `self` -> the struct type.
    let prev_struct = self.current_struct
    let prev_struct_tok = self.current_struct_tok
    self.current_struct = struct_name_id
    self.current_struct_tok = self.token_idx(name_tok)

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let inner = self.peek()
        if inner.kind == TK_FN:
            let m = self.parse_func_decl(false)
            if m != 0 as u32:
                self.append_child(node, m)
        elif inner.kind == TK_PUB:
            self.consume()
            let next = self.peek()
            if next.kind == TK_FN:
                let m = self.parse_func_decl(true)
                if m != 0 as u32:
                    self.append_child(node, m)
            else:
                let f = self.parse_field_decl(true)
                if f != 0 as u32:
                    self.append_child(node, f)
        else:
            let f = self.parse_field_decl(false)
            if f != 0 as u32:
                self.append_child(node, f)
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()
    self.current_struct = prev_struct           // RFC 0002: restore
    self.current_struct_tok = prev_struct_tok
    return node

pub fn parse_field_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    mut is_mut := false
    if self.check(TK_MUT):
        self.consume()
        is_mut = true
    let tok = self.peek()
    if tok.kind != TK_IDENT:
        self.errorf(tok, "expected field name")
        self.consume()
        return 0 as u32
    self.consume()
    let node = self.tree.add_node(NODE_FIELD_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if is_mut:
        self.set_flags(node, FLAG_IS_MUT as u16)
    let text = self.token_text(tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_COLON)
    let type_node = self.parse_type_expr()
    if type_node != 0 as u32:
        self.append_child(node, type_node)
    self.expect_newline()
    return node

pub fn parse_type_alias_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_TYPE)
    let node = self.tree.add_node(NODE_TYPE_ALIAS_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_EQ)

    let sum_tok = self.peek()
    let sum_node = self.tree.add_node(NODE_SUM_TYPE, self.token_idx(sum_tok))
    let v = self.parse_type_variant()
    if v != 0 as u32:
        self.append_child(sum_node, v)

    while self.check_raw(TK_PIPE):
        self.consume()
        let next_v = self.parse_type_variant()
        if next_v != 0 as u32:
            self.append_child(sum_node, next_v)

    self.append_child(node, sum_node)
    self.expect_newline()
    return node

pub fn parse_type_variant(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind != TK_IDENT:
        return 0 as u32
    self.consume()
    let node = self.tree.add_node(NODE_VARIANT_DECL, self.token_idx(tok))
    let text = self.token_text(tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])

    if self.check_raw(TK_L_PAREN):
        self.consume() // '('
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(node, t)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
    return node

// RFC 0003: `enum Name:` indent-style sugar. Desugars to the SAME AST as a sum
// type `type Name = A | B(T) | ...` (NODE_TYPE_ALIAS_DECL + NODE_SUM_TYPE +
// NODE_VARIANT_DECL), so resolver/typecheck/codegen/match see no new node kinds.
pub fn parse_enum_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_ENUM)
    let node = self.tree.add_node(NODE_TYPE_ALIAS_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_COLON)

    let sum_node = self.tree.add_node(NODE_SUM_TYPE, self.token_idx(name_tok))

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after enum declaration")
        self.append_child(node, sum_node)
        return node
    self.consume() // consume INDENT

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let v = self.parse_type_variant()
        if v != 0 as u32:
            self.append_child(sum_node, v)
        self.expect_newline()
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()

    self.append_child(node, sum_node)
    return node

pub fn parse_program(mut self: ptr[Parser]):
    while not self.check(TK_EOF):
        let prev_pos = self.pos
        let tok = self.peek()
        mut decl := 0 as u32
        if tok.kind == TK_HASH:
            // RFC 0009 P2: #[export] attribute on the following top-level fn.
            self.consume() // '#'
            self.expect(TK_L_BRACKET)
            let attr_tok = self.expect(TK_IDENT)
            let attr_text = self.token_text(attr_tok)
            mut is_export := false
            if attr_text == "export":
                is_export = true
            @free(attr_text as ptr[u8])
            self.expect(TK_R_BRACKET)
            let ntok = self.peek()
            if ntok.kind == TK_PUB:
                self.consume()
                if self.peek().kind == TK_FN:
                    decl = self.parse_func_decl(true)
            elif ntok.kind == TK_FN:
                decl = self.parse_func_decl(false)
            if decl != 0 as u32 and is_export:
                self.set_flags(decl, FLAG_EXPORT)
        elif tok.kind == TK_IMPORT:
            decl = self.parse_import_decl()
        elif tok.kind == TK_PUB:
            self.consume()
            let next = self.peek()
            if next.kind == TK_FN:
                decl = self.parse_func_decl(true)
            elif next.kind == TK_STRUCT or next.kind == TK_PACKED:
                decl = self.parse_struct_decl(true)
            elif next.kind == TK_INTERFACE:
                decl = self.parse_interface_decl(true)
            elif next.kind == TK_TYPE:
                decl = self.parse_type_alias_decl(true)
            elif next.kind == TK_ENUM:
                decl = self.parse_enum_decl(true)
            elif next.kind == TK_CONST:
                decl = self.parse_const_decl(true)
            elif next.kind == TK_EXTERN:
                decl = self.parse_extern_decl(true)
            elif next.kind == TK_LET or next.kind == TK_MUT:
                decl = self.parse_var_decl()
                self.set_flags(decl, FLAG_IS_PUB as u16)
        elif tok.kind == TK_FN:
            decl = self.parse_func_decl(false)
        elif tok.kind == TK_STRUCT or tok.kind == TK_PACKED:
            decl = self.parse_struct_decl(false)
        elif tok.kind == TK_INTERFACE:
            decl = self.parse_interface_decl(false)
        elif tok.kind == TK_TYPE:
            decl = self.parse_type_alias_decl(false)
        elif tok.kind == TK_ENUM:
            decl = self.parse_enum_decl(false)
        elif tok.kind == TK_CONST:
            decl = self.parse_const_decl(false)
        elif tok.kind == TK_EXTERN:
            decl = self.parse_extern_decl(false)
        elif tok.kind == TK_LET or tok.kind == TK_MUT:
            decl = self.parse_var_decl()
        elif tok.kind == TK_IDENT:
            // RFC 0011 P4: contextual `library <dotted.name>` marker at top level. It
            // declares the file a separately-compilable library (→ import-driven `.lib`).
            // No AST node — its only consumers are the driver's source head-scan
            // (source_is_library) and documentation; the parser just accepts + skips it.
            let ident_text = self.token_text(tok)
            mut handled := false
            if ident_text == "library":
                self.consume() // 'library'
                if self.peek().kind == TK_IDENT:
                    self.consume()
                    while self.peek().kind == TK_DOT:
                        self.consume()
                        if self.peek().kind == TK_IDENT:
                            self.consume()
                handled = true
            @free(ident_text as ptr[u8])
            if not handled:
                self.errorf(tok, "expected top level declaration")
                self.consume()
        else:
            self.errorf(tok, "expected top level declaration")
            self.consume()

        if decl != 0 as u32:
            self.append_child(0 as u32, decl)

        if self.pos == prev_pos:
            self.consume()

// RFC 0008: parse `|p0: T0, p1: T1| -> RetType body-expr` -> NODE_CLOSURE_EXPR
// with children [NODE_PARAM_DECL...] , ret-type (NODE_TYPE_EXPR) , body-expr.
// Params reuse parse_param (annotation required); the `-> RetType` is required in
// the MVP (typecheck does not infer function return types). lift_closures() later
// rewrites this node into a NODE_IDENT to a synthesized top-level function.
pub fn parse_closure_expr(mut self: ptr[Parser]) -> u32:
    let pipe_tok = self.expect(TK_PIPE)
    let node = self.tree.add_node(NODE_CLOSURE_EXPR, self.token_idx(pipe_tok))
    while not self.check(TK_PIPE) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let p = self.parse_param()
        if p != 0 as u32:
            self.append_child(node, p)
        if not self.check(TK_PIPE):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_PIPE)
    self.expect(TK_ARROW)
    let ret = self.parse_type_expr()
    if ret != 0 as u32:
        self.append_child(node, ret)
    let body = self.parse_expr_with_prec(BP_NONE)
    if body != 0 as u32:
        self.append_child(node, body)
    return node

// Intern a fresh lambda name "__lam<n>" (n = the closure's node index, unique per
// compilation). No int-to-string helper exists in stage1, so build it by hand.
fn make_lam_name(pool: ptr[InternPool], n: i64) -> u32:
    let buf = @alloc(32 as i64) as ptr[u8]
    buf[0] = 95 as u8   // '_'
    buf[1] = 95 as u8   // '_'
    buf[2] = 108 as u8  // 'l'
    buf[3] = 97 as u8   // 'a'
    buf[4] = 109 as u8  // 'm'
    mut len := 5 as i64
    let digs = @alloc(24 as i64) as ptr[u8]
    mut dn := 0 as i64
    mut v := n
    if v <= 0 as i64:
        digs[0] = 48 as u8
        dn = 1 as i64
    while v > 0 as i64:
        digs[dn] = (48 as i64 + (v % 10 as i64)) as u8
        v = v / 10 as i64
        dn = dn + 1 as i64
    mut i := 0 as i64
    while i < dn:
        buf[len] = digs[dn - 1 as i64 - i]
        len = len + 1 as i64
        i = i + 1 as i64
    let s = alloc_str_from_raw(buf, len)
    let id = pool.intern(s)
    @free(buf)
    @free(digs)
    return id

// Rewrite one NODE_CLOSURE_EXPR (at index ci) into a top-level NODE_FUNC_DECL plus
// a NODE_IDENT reference to it. Zero-capture MVP: the lambda body may only use its
// own params + globals (a captured local would fail to resolve in the lifted fn).
fn lift_one_closure(tree: ptr[AstTree], pool: ptr[InternPool], ci: u32):
    let first = tree.nodes.data[ci as i64].first_child
    if first == NULL_IDX:
        return
    // last child = body, second-to-last = ret-type node; the rest are params.
    mut prevprev := NULL_IDX
    mut prev := NULL_IDX
    mut cur := first
    while cur != NULL_IDX:
        prevprev = prev
        prev = cur
        cur = tree.nodes.data[cur as i64].next_sibling
    let body = prev
    let ret = prevprev
    if body == NULL_IDX or ret == NULL_IDX:
        return
    let name_id = make_lam_name(pool, ci as i64)
    let tok = tree.nodes.data[ci as i64].token_idx
    let fd = tree.add_node(NODE_FUNC_DECL, tok)
    let blk = tree.add_node(NODE_BLOCK, tok)
    let rst = tree.add_node(NODE_RETURN_STMT, tok)
    // return-stmt wraps the body; block wraps the return-stmt.
    tree.nodes.data[body as i64].next_sibling = NULL_IDX
    tree.nodes.data[rst as i64].first_child = body
    tree.nodes.data[rst as i64].next_sibling = NULL_IDX
    tree.nodes.data[blk as i64].first_child = rst
    tree.nodes.data[blk as i64].next_sibling = NULL_IDX
    // func-decl children = existing params->ret chain, then block replaces body.
    tree.nodes.data[fd as i64].payload = name_id
    tree.nodes.data[fd as i64].first_child = first
    tree.nodes.data[ret as i64].next_sibling = blk
    tree.nodes.data[fd as i64].next_sibling = NULL_IDX
    // append func-decl to the program root (node 0).
    mut rc := tree.nodes.data[0].first_child
    if rc == NULL_IDX:
        tree.nodes.data[0].first_child = fd
    else:
        while tree.nodes.data[rc as i64].next_sibling != NULL_IDX:
            rc = tree.nodes.data[rc as i64].next_sibling
        tree.nodes.data[rc as i64].next_sibling = fd
    // Keep the node as NODE_CLOSURE_EXPR but detach its (now-reparented) children
    // and stash the lifted function's NAME in payload. The resolver rewrites this
    // payload to the function's symbol index; air_builder lowers it to OP_FUNC_ADDR.
    // (We deliberately do NOT turn it into a NODE_IDENT: lower_ident re-derives the
    // name from the node's token text, which here is the `|` glyph, not the lambda
    // name — so the sanity check would reject it. A dedicated closure-ref path
    // trusts the resolved payload instead.)
    tree.nodes.data[ci as i64].payload = name_id
    tree.nodes.data[ci as i64].first_child = NULL_IDX

// BUG#73: lift_one_closure only re-parents the lambda BODY into a new
// top-level function -- it does NOT generate an env struct or rewrite
// references to outer-scope variables (RFC 0008 P2 "closures with capture"
// is still Draft/unimplemented, only P1 zero-capture lambda-lifting shipped).
// An identifier in the body that isn't one of the closure's own params
// silently resolves, post-lift, to WHATEVER same-named symbol happens to
// exist anywhere in the program (SymbolTable::resolve_global is an
// unscoped linear scan) -- typically a completely unrelated variable in a
// different function's frame, whose stale register/slot number gets
// reused as if it belonged to the lifted function. Real, reproducible
// wrong-answer bug (e.g. `|x| base + x` capturing an enclosing `base`
// silently computed `x + x`), not a crash, so nothing else in the pipeline
// ever caught it. Reject before lifting instead of miscompiling: any
// identifier in the body that is neither one of the closure's own params
// nor a known top-level global (fn/struct/interface/const/type-alias) is a
// capture attempt.
fn scan_closure_free_vars(tree: ptr[AstTree], pool: ptr[InternPool], node_idx: u32, params: U32Vec, globals: U32Vec) -> i64:
    if node_idx == NULL_IDX:
        return 0 as i64
    let node = tree.nodes.data[node_idx as i64]
    mut count := 0 as i64
    if node.kind == NODE_IDENT:
        let name_id = node.payload
        mut known := false
        mut i := 0 as i64
        while i < params.len:
            if params.data[i] == name_id:
                known = true
                break
            i = i + 1
        if not known:
            i = 0 as i64
            while i < globals.len:
                if globals.data[i] == name_id:
                    known = true
                    break
                i = i + 1
        if not known:
            let name_str = pool.get(name_id)
            ax_printf_local("error: closure captures '%s' from an enclosing scope; only zero-capture closures are currently supported (RFC 0008 P2 not yet implemented)\n", get_str_ptr(name_str) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            safe_free_str(name_str)
            count = count + 1 as i64
    mut child := node.first_child
    while child != NULL_IDX:
        count = count + scan_closure_free_vars(tree, pool, child, params, globals)
        child = tree.nodes.data[child as i64].next_sibling
    return count

fn check_closure_no_capture(tree: ptr[AstTree], pool: ptr[InternPool], ci: u32, globals: U32Vec) -> i64:
    let first = tree.nodes.data[ci as i64].first_child
    if first == NULL_IDX:
        return 0 as i64
    mut params := new_u32_vec()
    mut prev := NULL_IDX
    mut cur := first
    while cur != NULL_IDX:
        if tree.nodes.data[cur as i64].kind == NODE_PARAM_DECL:
            params.push(tree.nodes.data[cur as i64].payload)
        prev = cur
        cur = tree.nodes.data[cur as i64].next_sibling
    let body = prev
    if body == NULL_IDX:
        return 0 as i64
    return scan_closure_free_vars(tree, pool, body, params, globals)

// Lambda-lifting pass: run after parse, before name resolution. Rewrites every
// NODE_CLOSURE_EXPR into a top-level function + reference. Reuses fn-ptr lowering.
pub fn lift_closures(tree: ptr[AstTree], pool: ptr[InternPool]) -> i64:
    let orig_len = tree.nodes.len
    mut globals := new_u32_vec()
    mut gc := tree.nodes.data[0].first_child
    while gc != NULL_IDX:
        let gcn = tree.nodes.data[gc as i64]
        if gcn.kind == NODE_FUNC_DECL or gcn.kind == NODE_STRUCT_DECL or gcn.kind == NODE_INTERFACE_DECL or gcn.kind == NODE_CONST_DECL or gcn.kind == NODE_TYPE_ALIAS_DECL:
            globals.push(gcn.payload)
        gc = gcn.next_sibling

    mut errors := 0 as i64
    mut ci := 1 as i64
    while ci < orig_len:
        if tree.nodes.data[ci].kind == NODE_CLOSURE_EXPR:
            errors = errors + check_closure_no_capture(tree, pool, ci as u32, globals)
            lift_one_closure(tree, pool, ci as u32)
        ci = ci + 1 as i64
    return errors

pub fn parse_param(mut self: ptr[Parser]) -> u32:
    let param_tok = self.peek()
    let param = self.tree.add_node(NODE_PARAM_DECL, self.token_idx(param_tok))
    if self.check(TK_LENT):
        self.consume()
        self.set_flags(param, FLAG_IS_LENT)
    elif self.check(TK_BANG):
        self.consume()
        self.set_flags(param, FLAG_IS_SINK)
    elif self.check(TK_MUT):
        self.consume()
        self.set_flags(param, FLAG_IS_MUT as u16)
    let param_name = self.expect(TK_IDENT)
    let param_text = self.token_text(param_name)
    self.set_payload(param, self.pool.intern(param_text))
    @free(param_text as ptr[u8])
    self.expect(TK_COLON)
    let t = self.parse_type_expr()
    if t != 0 as u32:
        self.append_child(param, t)
    return param

pub fn parse_const_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_CONST)
    let node = self.tree.add_node(NODE_CONST_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    self.expect(TK_COLON)
    let type_node = self.parse_type_expr()
    if type_node != 0 as u32:
        self.append_child(node, type_node)

    self.expect(TK_EQ)
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect_newline()
    return node

pub fn parse_extern_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    self.expect(TK_EXTERN)
    
    // Expect ABI string literal, e.g. "C"
    self.expect(TK_STRING_LIT)

    // RFC 0009: optional `from "lib.dll"` DLL binding. `from` lexes as TK_IDENT
    // (contextual keyword). String-lit token includes both surrounding quotes.
    mut dll_name_id := 0 as u32
    let peeked = self.peek()
    if peeked.kind == TK_IDENT:
        let ptext = self.token_text(peeked)
        if ptext == "from":
            self.consume() // consume 'from'
            let dll_tok = self.expect(TK_STRING_LIT)
            let raw = self.token_text(dll_tok)
            let raw_len = std.string.len(raw)
            if raw_len >= 2:
                let inner_ptr = ((raw as ptr[u8]) as i64 + 1) as ptr[u8]
                let inner = alloc_str_from_raw(inner_ptr, raw_len - 2)
                dll_name_id = self.pool.intern(inner)
                @free(inner as ptr[u8])
            @free(raw as ptr[u8])
        @free(ptext as ptr[u8])

    let fn_tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_FUNC_DECL, self.token_idx(fn_tok))
    self.set_flags(node, FLAG_IS_EXTERN as u16)
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if dll_name_id != 0 as u32:
        self.tree.nodes.data[node].extra_idx = dll_name_id
        self.set_flags(node, FLAG_FROM_DLL)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param = self.parse_param()
        if param != 0 as u32:
            self.append_child(node, param)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)

    if self.check_raw(TK_ARROW):
        self.consume()
        let ret_type = self.parse_type_expr()
        if ret_type != 0 as u32:
            self.append_child(node, ret_type)
    
    self.expect_newline()
    return node

pub fn parse_import_decl(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IMPORT)
    let node = self.tree.add_node(NODE_IMPORT_DECL, self.token_idx(tok))

    let path_tok = self.expect(TK_IDENT)
    let path_text = self.token_text(path_tok)
    mut path_id := self.pool.intern(path_text)
    @free(path_text as ptr[u8])

    while self.check_raw(TK_DOT):
        self.consume()
        let seg_tok = self.expect(TK_IDENT)
        let seg_text = self.token_text(seg_tok)
        let base_str = self.pool.get(path_id)
        
        // Concatenate path segments with '.'
        let len_base = std.string.len(base_str)
        let len_seg = std.string.len(seg_text)
        let total_len = len_base + 1 + len_seg
        mut new_buf := @alloc(total_len + 1) as ptr[u8]
        @memcpy(new_buf, base_str as ptr[u8], len_base)
        new_buf[len_base] = '.' as u8
        @memcpy(((new_buf as i64) + len_base + 1 as i64) as ptr[u8], seg_text as ptr[u8], len_seg)
        new_buf[total_len] = 0 as u8
        
        path_id = self.pool.intern(new_buf as str)
        @free(new_buf)
        @free(seg_text as ptr[u8])

    self.set_payload(node, path_id)

    if self.check_raw(TK_L_BRACE):
        self.consume()
        while not self.check(TK_R_BRACE) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let name_tok = self.expect(TK_IDENT)
            let name_text = self.token_text(name_tok)
            let name_node = self.tree.add_node(NODE_IDENT, self.token_idx(name_tok))
            self.set_payload(name_node, self.pool.intern(name_text))
            @free(name_text as ptr[u8])
            self.append_child(node, name_node)

            if not self.check(TK_R_BRACE):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACE)

    self.expect_newline()
    return node

