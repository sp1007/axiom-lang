// bootstrap/stage1/typecheck.ax
// AXIOM self-hosted Type Table and Type Checker implementation.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64
// extern "C" fn sprintf(buf: ptr[u8], format: ptr[u8], val: f64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64



pub fn strip_quotes(s: str) -> str:
    let len = std.string.len(s)
    // RFC 0024: block string `"""..."""` — strip 3 delimiter chars each side.
    if len >= 6 and s[0] as u8 == '"' as u8 and s[1] as u8 == '"' as u8 and s[2] as u8 == '"' as u8 and s[len - 1] as u8 == '"' as u8 and s[len - 2] as u8 == '"' as u8 and s[len - 3] as u8 == '"' as u8:
        let ptr_start3 = ((s as ptr[u8]) as i64 + 3 as i64) as ptr[u8]
        return alloc_str_from_raw(ptr_start3, len - 6)
    if len >= 2 and s[0] as u8 == '"' as u8 and s[len - 1] as u8 == '"' as u8:
        let ptr_start = ((s as ptr[u8]) as i64 + 1 as i64) as ptr[u8]
        return alloc_str_from_raw(ptr_start, len - 2)
    return s

pub fn format_int(val: i64) -> str:
    if val == 0 as i64:
        let buf = @alloc(2) as ptr[u8]
        buf[0] = '0' as u8
        buf[1] = 0 as u8
        let result = alloc_str_from_raw(buf, 1)
        @free(buf)
        return result
    if val == -9223372036854775808 as i64:
        let s = "-9223372036854775808"
        let len = std.string.len(s)
        let buf = @alloc(len + 1) as ptr[u8]
        @memcpy(buf, s as ptr[u8], len)
        buf[len] = 0 as u8
        let result = alloc_str_from_raw(buf, len)
        @free(buf)
        return result
    mut temp := val
    mut is_neg := false
    if val < 0 as i64:
        is_neg = true
        temp = 0 as i64 - val
    let buf = @alloc(24) as ptr[u8]
    mut len := 0
    while temp > 0 as i64:
        let rem = (temp % 10 as i64) as u8
        buf[len] = ('0' as u8 + rem)
        len = len + 1
        temp = temp / 10 as i64
    if is_neg:
        buf[len] = '-' as u8
        len = len + 1
    mut i := 0
    mut j := len - 1
    while i < j:
        let tmp = buf[i]
        buf[i] = buf[j]
        buf[j] = tmp
        i = i + 1
        j = j - 1
    buf[len] = 0 as u8
    let result = alloc_str_from_raw(buf, len as i64)
    @free(buf)
    return result

pub fn format_float(val: f64) -> str:
    let buf = @alloc(64) as ptr[u8]
    ax_sprintf_local(buf, "%g" as ptr[u8], val)
    let len = strlen(buf)
    let result = alloc_str_from_raw(buf, len)
    @free(buf)
    return result

pub struct TypeChecker:
    tree: ptr[AstTree]
    intern: ptr[InternPool]
    symtable: ptr[SymbolTable]
    types: ptr[TypeTable]
    node_types: ptr[u32]
    node_types_cap: i64
    current_return: u32
    current_match_scrutinee: u32
    // True while type-checking the body of a GENERIC function/method. A generic
    // call that leaves a type param bound to a generic placeholder legitimately
    // DEFERS to monomorphization ONLY inside a generic body; in a CONCRETE body
    // the same situation means the param is genuinely un-inferable and the deferred
    // call is never instantiated -> segfault. This flag lets the defer site reject.
    current_fn_is_generic: bool
    pub diags_count: i64

pub fn new_type_checker(tree: ptr[AstTree], intern: ptr[InternPool], symtable: ptr[SymbolTable], types: ptr[TypeTable]) -> ptr[TypeChecker]:
    let node_count = tree.nodes.len
    mut initial_cap := node_count
    if initial_cap < 16 as i64:
        initial_cap = 16 as i64
    let node_types = @alloc(initial_cap * 4) as ptr[u32]
    mut i := 0 as i64
    while i < initial_cap:
        node_types[i] = 0 as u32
        i = i + 1
    let tc = @alloc(@compiler_intrinsic("size_of")[TypeChecker]()) as ptr[TypeChecker]
    tc.tree = tree
    tc.intern = intern
    tc.symtable = symtable
    tc.types = types
    tc.node_types = node_types
    tc.node_types_cap = initial_cap
    tc.current_return = 0 as u32
    tc.current_match_scrutinee = 0 as u32
    tc.current_fn_is_generic = false
    tc.diags_count = 0 as i64
    return tc

pub fn is_generic(self: ptr[TypeChecker], type_id: u32) -> bool:
    if type_id == TYPE_UNKNOWN:
        return true
    if (type_id as i64) >= self.types.entries.len:
        return false
    let entry = self.types.entries.data[type_id as i64]
    if entry.kind == TYPE_KIND_GENERIC:
        return true
    if entry.kind == TYPE_KIND_POINTER:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_REF:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_SLICE:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_ARRAY:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
        let args = self.get_generic_args(type_id)
        mut idx := 0 as i64
        mut has_gen := false
        while idx < args.len:
            let arg_t = args.data[idx]
            if self.is_generic(arg_t):
                has_gen = true
                break
            idx = idx + 1
        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
        return has_gen
    // A tuple synth-struct `__tupN` has no name-resolvable identity, so its element
    // types are its only signature. A `__tup` whose field is still a generic param
    // (e.g. `(i64, T)` = `__tup{i64, T}` in a generic body) is itself GENERIC — but the
    // generic struct-instantiation / method-dispatch paths only see it as a plain STRUCT
    // and would treat it as concrete, baking a `Vec[generic __tup]` instance and binding
    // `T → __tup{i64,T}` (a param bound to a tuple containing itself). That bogus concrete
    // instance leaves the receiver generic, so a method call on it (`out.push`) is never
    // bound and the backend degrades to an indirect `getfld+call` → SIGSEGV. Recursing
    // into `__tup` fields here makes such a tuple correctly report generic, so those paths
    // DEFER until the element is truly concrete. Scoped to `__tup` (structural, no symbol)
    // so ordinary named structs are unaffected.
    if entry.kind == TYPE_KIND_STRUCT and (entry.extra as i64) < self.types.structs.len:
        let nm = self.intern.get(entry.name_id)
        let is_tup = std.string.starts_with(nm, "__tup")
        safe_free_str(nm)
        if is_tup:
            let sinfo = self.types.structs.data[entry.extra as i64]
            mut fi := 0 as i64
            while fi < sinfo.fields.len:
                if self.is_generic(sinfo.fields.data[fi].type_id):
                    return true
                fi = fi + 1 as i64
    return false

pub fn parse_type_from_name(self: ptr[TypeChecker], name: str) -> u32:
    if std.string.starts_with(name, "ptr_"):
        let rest = std.string.slice(name, 4, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_pointer(inner)
    elif std.string.starts_with(name, "ref_"):
        let rest = std.string.slice(name, 4, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_pointer(inner)
    elif std.string.starts_with(name, "slice_"):
        let rest = std.string.slice(name, 6, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_slice(inner)
    elif std.string.starts_with(name, "arr_"):
        let len_str_start = 4 as i64
        mut len_str_end := len_str_start
        let name_len = std.string.len(name)
        let ptr_name = get_str_ptr(name)
        while len_str_end < name_len and ptr_name[len_str_end] != '_' as u8:
            len_str_end = len_str_end + 1 as i64
        if len_str_end < name_len:
            let len_str = std.string.slice(name, len_str_start, len_str_end)
            mut arr_len := 0 as u32
            mut idx := 0 as i64
            let ptr_len = get_str_ptr(len_str)
            let len_len = std.string.len(len_str)
            while idx < len_len:
                arr_len = arr_len * 10 as u32 + (ptr_len[idx] - 48 as u8) as u32
                idx = idx + 1 as i64
            
            let rest = std.string.slice(name, len_str_end + 1 as i64, name_len)
            let inner = self.parse_type_from_name(rest)
            return self.types.register_array(inner, arr_len)

    if name == "i8":
        return 1 as u32
    elif name == "i16":
        return 2 as u32
    elif name == "i32":
        return 3 as u32
    elif name == "i64":
        return 4 as u32
    elif name == "u8":
        return 5 as u32
    elif name == "u16":
        return 6 as u32
    elif name == "u32" or name == "rune":
        return 7 as u32
    elif name == "u64":
        return 8 as u32
    elif name == "f32":
        return 9 as u32
    elif name == "f64":
        return 10 as u32
    elif name == "bool":
        return 11 as u32
    elif name == "string" or name == "str":
        return 12 as u32
    elif name == "bytes":
        return 22 as u32
    elif name == "char8":
        return 13 as u32
    elif name == "void":
        return 14 as u32
    elif name == "isize":
        return 15 as u32
    elif name == "usize":
        return 16 as u32

    // First, try resolving via SymbolTable
    let name_id = self.intern.intern_string(name)
    let sym_idx = self.symtable.resolve(name_id)
    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[sym_idx]
        if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
            sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
            sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
            if sym.type_id != 0 as u32:
                return sym.type_id

    // TypeTable Lookup
    mut t_idx := 0 as i64
    while t_idx < self.types.entries.len:
        let t_entry = self.types.entries.data[t_idx]
        if t_entry.name_id != 0 as u32:
            let t_name = self.intern.get(t_entry.name_id)
            if t_name == name:
                return t_idx as u32
        t_idx = t_idx + 1 as i64

    return 0 as u32

pub fn get_generic_args(self: ptr[TypeChecker], type_id: u32) -> U32Vec:
    mut out_args := new_u32_vec()
    if (type_id as i64) >= self.types.entries.len:
        return out_args
    let entry = self.types.entries.data[type_id as i64]
    if entry.kind == TYPE_KIND_GENERIC_INST:
        let inst_idx = entry.extra
        let inst_args = &self.types.generic_insts.data[inst_idx as i64]
        mut j := 0 as i64
        while j < inst_args.len:
            out_args.push(inst_args.data[j])
            j = j + 1
        return out_args

    if entry.kind == TYPE_KIND_STRUCT and (entry.extra as i64) < self.types.structs.len:
        let struct_args = &self.types.structs.data[entry.extra as i64].generic_args
        if struct_args.len > 0 as i64:
            mut k := 0 as i64
            while k < struct_args.len:
                out_args.push(struct_args.data[k])
                k = k + 1
            return out_args

    if entry.kind == TYPE_KIND_SUM and (entry.extra as i64) < self.types.sumtypes.len:
        let sum_args = &self.types.sumtypes.data[entry.extra as i64].generic_args
        if sum_args.len > 0 as i64:
            mut m := 0 as i64
            while m < sum_args.len:
                out_args.push(sum_args.data[m])
                m = m + 1
            return out_args

    return self.get_generic_args_from_mangled(type_id)

pub fn get_generic_args_from_mangled(self: ptr[TypeChecker], type_id: u32) -> U32Vec:
    mut out_args := new_u32_vec()
    if (type_id as i64) >= self.types.entries.len:
        return out_args
    let entry = self.types.entries.data[type_id as i64]
    if entry.name_id == 0 as u32:
        return out_args
    let name_str = self.intern.get(entry.name_id)
    let len = std.string.len(name_str)
    
    // Find the first "__" in the mangled name
    mut temp_end := 0 as i64
    if len > 4 as i64 and name_str[0] as u8 == 'a' as u8 and name_str[1] as u8 == 'x' as u8 and name_str[2] as u8 == '_' as u8 and name_str[3] as u8 == '_' as u8:
        temp_end = 4 as i64
    while temp_end < len - 1 as i64:
        if name_str[temp_end] as u8 == '_' as u8 and name_str[temp_end + 1 as i64] as u8 == '_' as u8:
            break
        temp_end = temp_end + 1 as i64
        
    if temp_end >= len - 1 as i64:
        return out_args
        
    mut arg_start := temp_end + 2 as i64
    while arg_start < len:
        mut arg_end := arg_start
        while arg_end < len - 1 as i64:
            if name_str[arg_end] as u8 == '_' as u8 and name_str[arg_end + 1 as i64] as u8 == '_' as u8:
                break
            arg_end = arg_end + 1 as i64
        if arg_end == len - 1 as i64:
            arg_end = len
            
        let arg_len = arg_end - arg_start
        if arg_len > 0 as i64:
            mut arg_name_buf := @alloc(arg_len + 1 as i64) as ptr[u8]
            @memcpy(arg_name_buf, ((get_str_ptr(name_str) as i64) + arg_start) as ptr[u8], arg_len)
            arg_name_buf[arg_len] = 0 as u8
            let arg_name := arg_name_buf as str
            
            let arg_type_id = self.parse_type_from_name(arg_name)
            if arg_type_id != 0 as u32:
                out_args.push(arg_type_id)
                
            @free(arg_name_buf)
        arg_start = arg_end + 2 as i64

    return out_args

// BUG#67: an unqualified generic-sum-type variant constructor call
// (Some(x)/Ok(x)/Err(x)) previously kept the bare TEMPLATE sum type_id for
// its result (T/E still generic placeholders) instead of a concrete
// instantiation. get_generic_args() on that bare template later finds no
// real args and falls to the ambiguous mangled-name fallback (or nothing at
// all here, since the template's name is plain "Option"/"Result"), so a
// later generic call like `.unwrap()` can't recover T and silently defaults
// to i32 (same fallback as BUG#66) -- fine for scalars that happen to fit,
// corrupts anything else (segfaults for a struct payload, since the field
// layout is lost entirely).
//
// Fix: when the constructed sum type is GENERIC, match each payload
// type-expr of the specific variant being called (e.g. the lone "T" in
// `Some(T)`, or "E" in `Err(E)`) against the alias's own ordered generic
// params BY NAME, and register a real GENERIC_INST using the call
// argument's actual inferred type for whichever params we can bind this
// way. Params we can't bind from this call (e.g. E when calling Ok(x) on a
// Result[T,E]) stay TYPE_UNKNOWN -- unresolved, not wrong; this call alone
// cannot know them, same limit as any partial generic inference.
pub fn try_instantiate_variant_call(mut self: ptr[TypeChecker], callee: u32, sum_type_id: u32, expected: u32) -> u32:
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return sum_type_id
    let vsym_idx = self.tree.nodes.data[callee].payload
    if vsym_idx == 0 as u32 or (vsym_idx as i64) >= self.symtable.symbols.len:
        return sum_type_id
    let vsym = self.symtable.symbols.data[vsym_idx as i64]
    if vsym.kind != SYM_VARIANT or vsym.decl_node == 0 as u32:
        return sum_type_id
    let first_call_arg = self.tree.nodes.data[callee].next_sibling
    if first_call_arg == 0 as u32:
        return sum_type_id

    if (sum_type_id as i64) >= self.types.entries.len:
        return sum_type_id
    let entry = self.types.entries.data[sum_type_id as i64]
    if entry.name_id == 0 as u32:
        return sum_type_id
    mut alias_sym_idx := self.symtable.resolve(entry.name_id)
    if alias_sym_idx == 0 as u32:
        alias_sym_idx = self.symtable.resolve_global_fallback(entry.name_id)
    if alias_sym_idx == 0 as u32 or (alias_sym_idx as i64) >= self.symtable.symbols.len:
        return sum_type_id
    let alias_sym = self.symtable.symbols.data[alias_sym_idx as i64]
    if alias_sym.decl_node == 0 as u32:
        return sum_type_id

    mut alias_tree := self.tree
    if (alias_sym_idx as i64) < self.symtable.symbol_trees.len:
        let at = self.symtable.symbol_trees.data[alias_sym_idx as i64]
        if at != null as ptr[AstTree]:
            alias_tree = at
    if (alias_tree.nodes.data[alias_sym.decl_node].flags & FLAG_IS_GENERIC) == 0 as u16:
        return sum_type_id

    // Ordered generic-param NAME ids of the alias, e.g. ["T"] for Option,
    // ["T", "E"] for Result.
    mut gp_name_ids := new_u32_vec()
    mut c := alias_tree.nodes.data[alias_sym.decl_node].first_child
    while c != 0 as u32:
        let cn = alias_tree.nodes.data[c]
        if cn.kind == NODE_GENERIC_PARAMS:
            mut gp := cn.first_child
            while gp != 0 as u32:
                let gp_name = self.node_text_in_tree(alias_tree, gp)
                gp_name_ids.push(self.intern.intern(gp_name))
                safe_free_str(gp_name)
                gp = alias_tree.nodes.data[gp].next_sibling
            break
        c = cn.next_sibling
    if gp_name_ids.len == 0 as i64:
        if gp_name_ids.data != null as ptr[u32]:
            @free(gp_name_ids.data as ptr[u8])
        return sum_type_id

    mut variant_tree := self.tree
    if (vsym_idx as i64) < self.symtable.symbol_trees.len:
        let vt = self.symtable.symbol_trees.data[vsym_idx as i64]
        if vt != null as ptr[AstTree]:
            variant_tree = vt

    mut args := new_u32_vec()
    mut ai := 0 as i64
    while ai < gp_name_ids.len:
        args.push(TYPE_UNKNOWN)
        ai = ai + 1

    // Expected-type coercion hint (tuple-literal payload fix): when the caller
    // supplies a concrete instantiation of this same alias as the expected type
    // (`Some((10,20))` where the context wants `Option[(i64,i64)]`), its generic
    // args are ordered identically to the alias's generic params. Passing the
    // matching arg as the payload's expected-type hint lets the NODE_TUPLE_EXPR
    // coercion (and int/float-literal widening) fire, so `(10,20)` builds a
    // `{i64,i64}` (16B) tuple instead of the default `{i32,i32}` (8B) that then
    // read its second field as garbage. Empty/mismatched expected → no hint,
    // identical to the prior behaviour.
    mut exp_args := self.get_generic_args(expected)

    mut bound_any := false
    mut payload_node := variant_tree.nodes.data[vsym.decl_node].first_child
    mut call_arg := first_call_arg
    while payload_node != 0 as u32 and call_arg != 0 as u32:
        let payload_name = self.node_text_in_tree(variant_tree, payload_node)
        let payload_name_id = self.intern.intern(payload_name)
        safe_free_str(payload_name)
        mut gi := 0 as i64
        while gi < gp_name_ids.len:
            if gp_name_ids.data[gi] == payload_name_id:
                mut exp_hint := TYPE_UNKNOWN
                if gi < exp_args.len and exp_args.data[gi] != TYPE_UNKNOWN and not self.is_generic(exp_args.data[gi]):
                    exp_hint = exp_args.data[gi]
                let concrete = self.infer_node(call_arg, exp_hint)
                if concrete != TYPE_UNKNOWN and not self.is_generic(concrete):
                    args.data[gi] = concrete
                    bound_any = true
                break
            gi = gi + 1
        payload_node = variant_tree.nodes.data[payload_node].next_sibling
        call_arg = self.tree.nodes.data[call_arg].next_sibling

    if exp_args.data != null as ptr[u32]:
        @free(exp_args.data as ptr[u8])
    if gp_name_ids.data != null as ptr[u32]:
        @free(gp_name_ids.data as ptr[u8])

    if not bound_any:
        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
        return sum_type_id

    return self.types.register_generic_inst(entry.name_id, args)

// BUG#74: `GenericStruct(field: v, ...)` constructed with NO explicit type args,
// relying on field-value inference. The struct-sibling of try_instantiate_variant_
// call: infer the concrete type-args from the field-init values, then run the SAME
// monomorphization the explicit `GenericStruct[T,U](...)` annotation path uses
// (finish_generic_instantiation) so the constructed value and any generic function
// that later receives it agree on ONE packed struct layout. Without this the value
// was built with the template's generic (8-byte) field slots while the receiving
// generic function's param monomorphized to a packed concrete struct -- every field
// past the first read at the wrong offset (silently 0/garbage, no crash). Returns
// the template type_id unchanged when the struct is non-generic or nothing binds.
pub fn try_instantiate_struct_ctor(mut self: ptr[TypeChecker], callee: u32, struct_type_id: u32) -> u32:
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return struct_type_id
    let ssym_idx = self.tree.nodes.data[callee].payload
    if ssym_idx == 0 as u32 or (ssym_idx as i64) >= self.symtable.symbols.len:
        return struct_type_id
    let ssym = self.symtable.symbols.data[ssym_idx as i64]
    if ssym.kind != SYM_STRUCT or ssym.decl_node == 0 as u32 or ssym.decl_node == 0xffffffff as u32:
        return struct_type_id
    mut src_tree := self.tree
    if (ssym_idx as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[ssym_idx as i64]
        if t != null as ptr[AstTree]:
            src_tree = t
    if (ssym.decl_node as i64) >= src_tree.nodes.len:
        return struct_type_id
    if (src_tree.nodes.data[ssym.decl_node].flags & FLAG_IS_GENERIC) == 0 as u16:
        return struct_type_id

    // Ordered generic-param name-ids of the struct.
    mut gen_params := new_u32_vec()
    mut c := src_tree.nodes.data[ssym.decl_node].first_child
    while c != 0 as u32:
        let cn = src_tree.nodes.data[c]
        if cn.kind == NODE_GENERIC_PARAMS:
            mut gp := cn.first_child
            while gp != 0 as u32:
                let gp_name = self.node_text_in_tree(src_tree, gp)
                gen_params.push(self.intern.intern(gp_name))
                safe_free_str(gp_name)
                gp = src_tree.nodes.data[gp].next_sibling
            break
        c = cn.next_sibling
    if gen_params.len == 0 as i64:
        if gen_params.data != null as ptr[u32]:
            @free(gen_params.data as ptr[u8])
        return struct_type_id

    mut inferred := new_u32_vec()
    mut gi := 0 as i64
    while gi < gen_params.len:
        inferred.push(TYPE_UNKNOWN)
        gi = gi + 1

    // Walk struct fields (decl order) and call args (positional) in lockstep;
    // named args are assigned positionally by the backend (see BUG#21 in
    // linker.ax), so field N's declared type-expr pairs with call arg N's value.
    mut field_node := src_tree.nodes.data[ssym.decl_node].first_child
    mut call_arg := self.tree.nodes.data[callee].next_sibling
    while field_node != 0 as u32 and call_arg != 0 as u32:
        let fn_node = src_tree.nodes.data[field_node]
        if fn_node.kind == NODE_FIELD_DECL:
            let field_type_node = fn_node.first_child
            mut val_node := call_arg
            if self.tree.nodes.data[call_arg].kind == NODE_NAMED_ARG:
                val_node = self.tree.nodes.data[call_arg].first_child
            if field_type_node != 0 as u32 and val_node != 0 as u32:
                let val_type = self.infer_node(val_node, TYPE_UNKNOWN)
                self.infer_generic_type_args(field_type_node, val_type, gen_params, inferred, src_tree)
            call_arg = self.tree.nodes.data[call_arg].next_sibling
        field_node = fn_node.next_sibling

    mut bound_any := false
    mut bi := 0 as i64
    while bi < inferred.len:
        if inferred.data[bi] != TYPE_UNKNOWN and not self.is_generic(inferred.data[bi]):
            bound_any = true
        bi = bi + 1

    if gen_params.data != null as ptr[u32]:
        @free(gen_params.data as ptr[u8])

    if not bound_any:
        if inferred.data != null as ptr[u32]:
            @free(inferred.data as ptr[u8])
        return struct_type_id

    // Default any param we couldn't bind to i32 (same fallback function-mono uses
    // for unbound params). All fields are supplied at construction, so this only
    // fires for a generic param that appears in no field's type.
    bi = 0
    while bi < inferred.len:
        if inferred.data[bi] == TYPE_UNKNOWN or self.is_generic(inferred.data[bi]):
            inferred.data[bi] = TYPE_I32
        bi = bi + 1

    return self.finish_generic_instantiation(ssym_idx, inferred)

// Diagnostic-only mirror of air_builder.ax's resolve_op_method: scans SYM_FUNC
// symbols whose (mangled) name matches `method_name` (struct methods declared
// INLINE under `struct X: fn eq(self, o): ...` get a dotted mangled name like
// "X.eq", which plain self.symtable.resolve("eq") does NOT find -- this must
// use the SAME substring-match helper air_builder uses at codegen time, or the
// diagnostic and the actual lowering decision can disagree). Returns 0 when no
// method matches, meaning air_builder would ALSO find nothing and fall back to
// the broken native-opcode (pointer) comparison.
pub fn diag_resolve_op_method(self: ptr[TypeChecker], method_name: str, rec_type: u32, rhs_type: u32) -> u32:
    let method_id = self.intern.intern(method_name)
    mut unwrapped := rec_type
    mut e := self.types.entries.data[unwrapped as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        unwrapped = e.extra as u32
        e = self.types.entries.data[unwrapped as i64]
    mut rhs_unwrapped := 0 as u32
    if rhs_type != 0 as u32:
        rhs_unwrapped = rhs_type
        mut re := self.types.entries.data[rhs_unwrapped as i64]
        while re.kind == TYPE_KIND_POINTER or re.kind == TYPE_KIND_REF:
            rhs_unwrapped = re.extra as u32
            re = self.types.entries.data[rhs_unwrapped as i64]
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.intern, sym.name_id, method_id):
            if (sym.type_id as i64) < self.types.entries.len:
                let t_entry = self.types.entries.data[sym.type_id as i64]
                if t_entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[t_entry.extra as i64]
                    if fi.params.len > 0 as i64:
                        mut fp := fi.params.data[0] as u32
                        mut fpe := self.types.entries.data[fp as i64]
                        while fpe.kind == TYPE_KIND_POINTER or fpe.kind == TYPE_KIND_REF:
                            fp = fpe.extra as u32
                            fpe = self.types.entries.data[fp as i64]
                        if fp == unwrapped:
                            mut rhs_ok := true
                            if rhs_unwrapped != 0 as u32:
                                rhs_ok = false
                                if fi.params.len > 1 as i64:
                                    mut sp := fi.params.data[1] as u32
                                    mut spe := self.types.entries.data[sp as i64]
                                    while spe.kind == TYPE_KIND_POINTER or spe.kind == TYPE_KIND_REF:
                                        sp = spe.extra as u32
                                        spe = self.types.entries.data[sp as i64]
                                    if sp == rhs_unwrapped:
                                        rhs_ok = true
                            if rhs_ok:
                                return i as u32
        i = i + 1 as i64
    return 0 as u32

pub fn infer_generic_type_args(self: ptr[TypeChecker], tn_idx: u32, arg_type: u32, gen_params: U32Vec, inferred: U32Vec, src_tree: ptr[AstTree]):
    if tn_idx == 0 as u32 or arg_type == 0 as u32:
        return
    let kind = src_tree.nodes.data[tn_idx].kind
    if kind == NODE_TYPE_EXPR:
        let node_name = self.node_text_in_tree(src_tree, tn_idx)
        let node_name_id = self.intern.intern(node_name)
        safe_free_str(node_name)
        
        mut g_idx := 0 as i64
        while g_idx < gen_params.len:
            if gen_params.data[g_idx] == node_name_id:
                // First-wins, EXCEPT a concrete arg overrides a previously-inferred
                // GENERIC/placeholder binding. A bare `None` (or any template-typed)
                // argument — e.g. arg0 of `pick(None, Some(42))` — binds T to the
                // Option template's OWN generic param; without this override, the
                // later concrete arg (`Some(42)` -> i64) could not correct T, so T
                // stayed generic and the call mis-monomorphized -> silent segfault.
                // A concrete binding is never overridden by a later generic one, and
                // UNKNOWN is still taken by anything.
                if inferred.data[g_idx] == TYPE_UNKNOWN:
                    inferred.data[g_idx] = arg_type
                elif self.is_generic(inferred.data[g_idx]) and not self.is_generic(arg_type):
                    inferred.data[g_idx] = arg_type
                break
            g_idx = g_idx + 1 as i64
    elif kind == NODE_GENERIC_TYPE:
        let base_idx = src_tree.nodes.data[tn_idx].first_child
        if base_idx != 0 as u32:
            let base_node = src_tree.nodes.data[base_idx]
            let base_name = self.node_text_in_tree(src_tree, base_idx)
            let name_id = self.intern.intern(base_name)
            safe_free_str(base_name)
            let text = self.intern.get(name_id)
            let ptr_text = text as ptr[u8]
            mut is_ptr := false
            mut is_slice := false
            if std.string.len(text) == 3 as i64 and ptr_text[0] == 'p' as u8 and ptr_text[1] == 't' as u8 and ptr_text[2] == 'r' as u8:
                is_ptr = true
            elif std.string.len(text) == 5 as i64 and ptr_text[0] == 's' as u8 and ptr_text[1] == 'l' as u8 and ptr_text[2] == 'i' as u8 and ptr_text[3] == 'c' as u8 and ptr_text[4] == 'e' as u8:
                is_slice = true

            if is_ptr:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    mut norm_arg := arg_type
                    mut entry = self.types.entries.data[norm_arg as i64]
                    if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                        let inner_arg_type = entry.extra
                        self.infer_generic_type_args(arg_idx, inner_arg_type, gen_params, inferred, src_tree)
            elif is_slice:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    mut norm_arg := arg_type
                    mut entry = self.types.entries.data[norm_arg as i64]
                    if entry.kind == TYPE_KIND_SLICE:
                        let inner_arg_type = entry.extra
                        self.infer_generic_type_args(arg_idx, inner_arg_type, gen_params, inferred, src_tree)
            else:
                // User-defined generic template (like Array or Map)
                mut norm_arg := arg_type
                mut entry = self.types.entries.data[norm_arg as i64]
                while entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                    norm_arg = entry.extra
                    entry = self.types.entries.data[norm_arg as i64]
                
                mut arg_type_args := self.get_generic_args(norm_arg)
                
                mut param_arg_idx := base_node.next_sibling
                mut a_idx := 0 as i64
                while param_arg_idx != 0 as u32 and a_idx < arg_type_args.len:
                    let concrete_arg_type = arg_type_args.data[a_idx]
                    self.infer_generic_type_args(param_arg_idx, concrete_arg_type, gen_params, inferred, src_tree)
                    param_arg_idx = src_tree.nodes.data[param_arg_idx].next_sibling
                    a_idx = a_idx + 1 as i64
                
                if arg_type_args.data != null as ptr[u32]:
                    @free(arg_type_args.data as ptr[u8])
    elif kind == NODE_PTR_TYPE:
        let inner_node_idx = src_tree.nodes.data[tn_idx].first_child
        if inner_node_idx != 0 as u32:
            mut norm_arg := arg_type
            mut entry = self.types.entries.data[norm_arg as i64]
            if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                let inner_arg_type = entry.extra
                self.infer_generic_type_args(inner_node_idx, inner_arg_type, gen_params, inferred, src_tree)
    elif kind == NODE_SLICE_TYPE:
        let inner_node_idx = src_tree.nodes.data[tn_idx].first_child
        if inner_node_idx != 0 as u32:
            mut norm_arg := arg_type
            mut entry = self.types.entries.data[norm_arg as i64]
            if entry.kind == TYPE_KIND_SLICE:
                let inner_arg_type = entry.extra
                self.infer_generic_type_args(inner_node_idx, inner_arg_type, gen_params, inferred, src_tree)
    elif kind == NODE_FUNC_TYPE:
        // A fn-typed parameter `fn(T) -> U`: infer T/U structurally from the
        // argument's concrete function type (e.g. an inline lambda typed fn(i64)->i64
        // by the NODE_CLOSURE_EXPR branch of infer_node). Without this, U (inferable
        // only from the fn param's return) stays UNKNOWN, is i32-defaulted, and the
        // template may fail to instantiate. NODE_FUNC_TYPE children = param type
        // nodes, then (when flags&1) the return type node last.
        mut fnorm_arg := arg_type
        mut fentry = self.types.entries.data[fnorm_arg as i64]
        while fentry.kind == TYPE_KIND_POINTER or fentry.kind == TYPE_KIND_REF:
            fnorm_arg = fentry.extra
            fentry = self.types.entries.data[fnorm_arg as i64]
        if fentry.kind == TYPE_KIND_FUNC:
            let fi = self.types.funcs.data[fentry.extra as i64]
            let ftnode = src_tree.nodes.data[tn_idx]
            let f_has_ret = (ftnode.flags & 1 as u16) != 0 as u16
            mut f_nchildren := 0 as i64
            mut f_cc := ftnode.first_child
            while f_cc != 0 as u32:
                f_nchildren = f_nchildren + 1 as i64
                f_cc = src_tree.nodes.data[f_cc].next_sibling
            mut f_nparams := f_nchildren
            if f_has_ret:
                f_nparams = f_nchildren - 1 as i64
            mut f_cn := ftnode.first_child
            mut f_pi := 0 as i64
            while f_cn != 0 as u32 and f_pi < f_nparams:
                if f_pi < fi.params.len:
                    self.infer_generic_type_args(f_cn, fi.params.data[f_pi], gen_params, inferred, src_tree)
                f_cn = src_tree.nodes.data[f_cn].next_sibling
                f_pi = f_pi + 1 as i64
            if f_has_ret and f_cn != 0 as u32:
                self.infer_generic_type_args(f_cn, fi.ret, gen_params, inferred, src_tree)

pub fn resolve_method_overload(self: ptr[TypeChecker], sym_idx: u32, rec_type: u32) -> u32:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return 0 as u32
    
    // If the symbol itself doesn't have overloads, return it immediately
    let initial_sym = self.symtable.symbols.data[sym_idx]
    if initial_sym.next_overload == 0 as u32:
        return sym_idx
        
    // Unwrap pointer and reference from receiver type
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        return sym_idx
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    
    // Now walk the overload chain to find a match.
    mut curr_idx := sym_idx
    while curr_idx != 0 as u32:
        if self.is_method_compatible(curr_idx, rec_type):
            return curr_idx
        let sym = self.symtable.symbols.data[curr_idx]
        curr_idx = sym.next_overload
        
    return sym_idx

// BUG#80: free-function call `f(a, ...)` to an OVERLOADED name. The resolver binds the
// callee ident to the overload-chain HEAD (a plain scope lookup returns the FIRST-defined
// symbol of that name) with NO argument-based disambiguation — only method calls (`x.f()`)
// pick an overload, via resolve_method_overload keyed on the receiver type. So a user
// function whose name collides with a stdlib one (e.g. `get`, `push`, `len` — stdlib is
// always linked) bound to the stdlib overload and SILENTLY MISCOMPILED: the head is a
// generic stdlib `get[T]`, so the call took the generic-instantiation path and baked
// `get[T=UserType]` on the wrong signature, returning 0 with no diagnostic (same silent
// accept-then-miscompile class as BUG#73). Mirror the method path for free calls: if the
// head is overloaded, pick the overload whose FIRST parameter type matches the FIRST
// argument (the free-call analogue of a receiver). Conservative — resolve_method_overload
// tests the head FIRST, so a call already bound to a compatible overload is returned
// unchanged; we only switch when the head is INCOMPATIBLE with arg0 and another overload
// in the chain matches, which is strictly a repair of a previously-broken binding.
// Number of declared parameters of a SYM_FUNC, counted from its DECL node in its OWN tree
// (so it is tree-safe and does not depend on the signature having been type-inferred yet).
// Returns -1 when unknown / not a function. Used for arity-based overload disambiguation.
pub fn sym_decl_param_count(self: ptr[TypeChecker], sym_idx: u32) -> i64:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return -1 as i64
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_FUNC or sym.decl_node == 0 as u32 or sym.decl_node == 0xffffffff as u32:
        return -1 as i64
    mut tree := self.tree
    if (sym_idx as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[sym_idx as i64]
        if t != null as ptr[AstTree]:
            tree = t
    if (sym.decl_node as i64) >= tree.nodes.len:
        return -1 as i64
    mut n := 0 as i64
    mut c := tree.nodes.data[sym.decl_node as i64].first_child
    while c != 0 as u32:
        if tree.nodes.data[c as i64].kind == NODE_PARAM_DECL:
            n = n + 1 as i64
        c = tree.nodes.data[c as i64].next_sibling
    return n

// True iff this SYM_FUNC would emit the BARE mangled name `ax_<name>` in the backend
// (x86_resolve_sym_name / cgen), i.e. it has NO struct/sum receiver to disambiguate it.
// Two bare-mangling functions with the same name link-collide (one `ax_<name>` wins),
// silently mis-dispatching a call. Mirrors x86_regs.ax:198-302 so the uniquing pass in
// run_type_checker tags precisely the functions the backend would otherwise merge.
pub fn free_fn_bare_mangles(self: ptr[TypeChecker], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_FUNC:
        return false
    // extern keeps its raw name; MODDUP is already unique; generic templates are
    // monomorphized (instances mangle elsewhere) — none participate in this collision.
    if (sym.flags & SYM_FLAG_EXTERN) != 0 as u16:
        return false
    if (sym.flags & 2048 as u16) != 0 as u16:
        return false
    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
        return false
    // Special names the backend passes through verbatim (never `ax_<name>`).
    let nm = self.intern.get(sym.name_id)
    let special = (nm == "main" or nm == "_AX_main_main_v_v" or nm == "memcpy" or
                   nm == "memset" or nm == "memmove" or nm == "realloc" or
                   nm == "free" or nm == "alloc" or nm == "malloc")
    safe_free_str(nm)
    if special:
        return false
    // A struct/sum FIRST parameter (single pointer unwrap, mirroring the backend, and only
    // when it carries a name) yields `ax_<Struct>_<fn>` — unique per receiver, so NOT bare.
    if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.types.entries.len:
        let f_entry = self.types.entries.data[sym.type_id as i64]
        if f_entry.kind == TYPE_KIND_FUNC:
            let fi = self.types.funcs.data[f_entry.extra as i64]
            if fi.params.len > 0 as i64:
                mut fp := fi.params.data[0]
                let pe = self.types.entries.data[fp as i64]
                if pe.kind == TYPE_KIND_POINTER:
                    fp = pe.extra
                let pe2 = self.types.entries.data[fp as i64]
                if (pe2.kind == TYPE_KIND_STRUCT or pe2.kind == TYPE_KIND_SUM) and pe2.name_id != 0 as u32:
                    return false
    return true

// Gate for a free-call overload candidate `ci` (already known to match the call
// ARITY) given the inferred arg0 type: true iff `ci` is a plausible target.
// Mirrors the accept condition previously inlined in resolve_free_call_overload:
// arg0 unknown (cannot disqualify), a bare-generic first param (`zip[A,B,C]`),
// integer<->integer widening (the find/get/... free-fn-shadow repair), or an
// exact/structured is_method_compatible match. Extracted so the two-pass HOLE#5
// tie-break scores EXACTLY the candidate set it accepts. [[bug-freefn-stdlib-collision-noarg]]
pub fn free_call_gate(self: ptr[TypeChecker], ci: u32, arg0_type: u32) -> bool:
    if arg0_type == TYPE_UNKNOWN:
        return true
    mut ci_first_generic := false
    mut ci_arg0_widen := false
    mut ci_arg0_float := false
    let ci_sym = self.symtable.symbols.data[ci]
    if ci_sym.type_id != 0 as u32 and (ci_sym.type_id as i64) < self.types.entries.len:
        let ce = self.types.entries.data[ci_sym.type_id]
        if ce.kind == TYPE_KIND_FUNC:
            let cfi = self.types.funcs.data[ce.extra]
            if cfi.params.len > 0 as i64 and (cfi.params.data[0] as i64) < self.types.entries.len:
                if self.types.entries.data[cfi.params.data[0]].kind == TYPE_KIND_GENERIC:
                    ci_first_generic = true
                let fp0 = cfi.params.data[0]
                if tc_is_numeric(fp0) and fp0 != TYPE_F32 and fp0 != TYPE_F64 and tc_is_numeric(arg0_type) and arg0_type != TYPE_F32 and arg0_type != TYPE_F64:
                    ci_arg0_widen = true
                // HOLE#6 (float f32<->f64 arg widening): a user free fn with a
                // concrete float first param shadowed by a bundled GENERIC method,
                // called with the OTHER float width (e.g. `fn map(x: f64)` called
                // with an f32 arg). The exact-match gate skipped the user overload
                // (f64 != f32) so the call fell through to the generic Vec.map head
                // -> monomorphized on a float arg treated as a Vec receiver ->
                // SIGSEGV (the residual foreseen at the end of HOLE#4/#5). Accepting
                // it here gates BOTH the user (concrete float param) and the generic
                // head, so the HOLE#5 full-signature tie-break (param_arg_match's
                // float<->float rule) then out-scores the generic and binds the user
                // fn. The actual f32->f64 value convert is emitted at the call site
                // (air_builder coerce_float_arg). [[bug-freefn-stdlib-collision-noarg]]
                if (fp0 == TYPE_F32 or fp0 == TYPE_F64) and (arg0_type == TYPE_F32 or arg0_type == TYPE_F64):
                    ci_arg0_float = true
    if ci_first_generic or ci_arg0_widen or ci_arg0_float:
        return true
    return self.is_method_compatible(ci, arg0_type)

// Per-parameter compatibility for the HOLE#5 full-signature tie-break score. An
// un-inferrable arg (UNKNOWN) is neutral (matches any param, so it never breaks a
// tie the wrong way); otherwise a param matches on exact type id, integer<->integer
// (any width/sign, floats excluded), or float<->float. Non-primitive params only
// match on exact type id (a bare-generic `T` param scores 0 against a concrete arg,
// so a concrete overload out-scores a generic one for a concrete call — the intended
// preference). Only used to rank already-gated same-arity candidates.
pub fn param_arg_match(self: ptr[TypeChecker], pt: u32, at: u32) -> bool:
    if at == TYPE_UNKNOWN:
        return true
    if pt == at:
        return true
    if tc_is_numeric(pt) and pt != TYPE_F32 and pt != TYPE_F64 and tc_is_numeric(at) and at != TYPE_F32 and at != TYPE_F64:
        return true
    if (pt == TYPE_F32 or pt == TYPE_F64) and (at == TYPE_F32 or at == TYPE_F64):
        return true
    return false

pub fn resolve_free_call_overload(mut self: ptr[TypeChecker], sym_idx: u32, first_arg_node: u32, call_argc: i64) -> u32:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return sym_idx
    if self.symtable.symbols.data[sym_idx].next_overload == 0 as u32:
        return sym_idx
    if first_arg_node == 0 as u32:
        // Zero-arg call `f()`. A plain scope lookup binds the callee to the overload-chain
        // HEAD, which for a name colliding with a bundled stdlib symbol is the stdlib
        // overload (stdlib is concatenated first -> defined first -> head). If that head
        // takes parameters (e.g. `run(mut self)`, `close(self)`), the zero-arg call would
        // silently dispatch to the wrong body reading a GARBAGE first arg -> return 0 or
        // SIGSEGV, no diagnostic (same accept-then-miscompile class as BUG#80, which only
        // disambiguated by arg[0] type and thus could not handle a zero-arg / arity
        // mismatch). Repair by ARITY: if the head takes >0 params, switch to a 0-param
        // overload in the chain (the user's own `f()`), if one exists. Only switches when
        // the head arity MISMATCHES the (zero) call arity, so a correctly-bound zero-arg
        // call is returned unchanged (conservative, mirroring the arg0-type path below).
        let head_pc = self.sym_decl_param_count(sym_idx)
        if head_pc <= 0 as i64:
            return sym_idx
        mut ci := self.symtable.symbols.data[sym_idx].next_overload
        while ci != 0 as u32:
            if self.sym_decl_param_count(ci) == 0 as i64:
                return ci
            ci = self.symtable.symbols.data[ci as i64].next_overload
        return sym_idx
    let arg0_type = self.infer_node(first_arg_node, TYPE_UNKNOWN)
    // ARITY + arg0-type disambiguation. A name colliding with a bundled stdlib overload
    // resolves (scope lookup) to the stdlib chain HEAD. If the user's own overload has a
    // DIFFERENT arity but the SAME arg0 type (user `len(str,i32)` vs stdlib `len(str)`),
    // arg0-type alone (BUG#80) picks the stdlib head. Walk the chain and prefer the overload
    // whose parameter count matches the call AND whose arg0 type is compatible. This binds
    // the call to the user's symbol so codegen targets the right (uniquely-mangled) body
    // [[bug-freefn-stdlib-collision-noarg]]. Preserves BUG#80 (equal-arity collisions still
    // disambiguate by arg0 type; a wrong-type head is skipped) and head-first order.
    // Pass 1: count the overloads that match the call ARITY and pass the arg0 gate
    // (free_call_gate: bare-generic first param `zip[A,B,C]`, integer<->integer
    // widening for the find/get/... free-fn-shadow, or is_method_compatible). The
    // gate is the same accept condition used historically; the head-first `first_gated`
    // preserves prior ordering. [[bug-freefn-stdlib-collision-noarg]]
    mut ci := sym_idx
    mut n_gated := 0 as i64
    mut first_gated := 0 as u32
    while ci != 0 as u32:
        if self.sym_decl_param_count(ci) == call_argc and self.free_call_gate(ci, arg0_type):
            n_gated = n_gated + 1 as i64
            if first_gated == 0 as u32:
                first_gated = ci
        ci = self.symtable.symbols.data[ci].next_overload
    // arg0 unknown (cannot score) or a single gated candidate: bind the head-first
    // match exactly as before (the common free-fn-shadow repair, e.g. user `find`
    // over a bundled generic Vec.find).
    if n_gated >= 1 as i64 and (arg0_type == TYPE_UNKNOWN or n_gated == 1 as i64):
        return first_gated
    // HOLE#5: two-or-more candidates tie on arity AND arg0 type — e.g. user
    // `contains(str, i64)` vs the NON-generic bundled `string.contains(str, str)`
    // (both arity 2, both arg0 == str). arg0 alone cannot disambiguate, and the old
    // head-first loop returned the WRONG (stdlib) one, so the call passed (str, i64)
    // to string.contains which read the i64 as a str pointer -> SIGSEGV, no
    // diagnostic (accept-then-miscompile). Break the tie by scoring the FULL
    // parameter list against the actual argument types (param_arg_match: exact |
    // integer<->integer | float<->float; an un-inferrable arg is neutral). Highest
    // score wins; a tie keeps head-first order (best_score starts at -1 so the
    // head-first `first_gated` is the initial best). Only reached for genuinely
    // ambiguous overloaded names, so the extra per-arg inference is rare.
    if n_gated >= 2 as i64:
        mut arg_types := new_u32_vec()
        mut an := first_arg_node
        while an != 0 as u32:
            arg_types.push(self.infer_node(an, TYPE_UNKNOWN))
            an = self.tree.nodes.data[an].next_sibling
        mut best_ci := first_gated
        mut best_score := 0 as i64 - 1 as i64
        ci = sym_idx
        while ci != 0 as u32:
            if self.sym_decl_param_count(ci) == call_argc and self.free_call_gate(ci, arg0_type):
                mut sc := 0 as i64
                let s2 = self.symtable.symbols.data[ci]
                if s2.type_id != 0 as u32 and (s2.type_id as i64) < self.types.entries.len:
                    let e2 = self.types.entries.data[s2.type_id]
                    if e2.kind == TYPE_KIND_FUNC:
                        let f2 = self.types.funcs.data[e2.extra]
                        mut pi := 0 as i64
                        while pi < f2.params.len and pi < arg_types.len:
                            let pv = f2.params.data[pi]
                            let av = arg_types.data[pi]
                            // An EXACT type match outscores a coercion-compatible match, so
                            // an exact overload wins over one needing integer widening or an
                            // f32<->f64 cross-width convert (the standard "exact preferred
                            // over promotion" rule). Without this, adding the float overload
                            // to the gate created a tie that head-first resolved WRONG:
                            // `pick(f32)`+`pick(f64)` called with an f64 literal picked the
                            // (head) f32 overload. An un-inferrable (UNKNOWN) arg stays neutral.
                            if av != TYPE_UNKNOWN and pv == av:
                                sc = sc + 2 as i64
                            elif self.param_arg_match(pv, av):
                                sc = sc + 1 as i64
                            pi = pi + 1 as i64
                if sc > best_score:
                    best_score = sc
                    best_ci = ci
            ci = self.symtable.symbols.data[ci].next_overload
        return best_ci
    if arg0_type == TYPE_UNKNOWN:
        return sym_idx
    let picked = self.resolve_method_overload(sym_idx, arg0_type)
    if picked != sym_idx and picked != 0 as u32 and self.is_method_compatible(picked, arg0_type):
        return picked
    return sym_idx

pub fn match_method_name(sym_name: str, field_name: str) -> bool:
    if sym_name == field_name:
        return true
    // PERF: equivalent to ends_with(sym_name, "." + field_name) but WITHOUT the
    // per-call concat/alloc/free — this runs tens of millions of times across the
    // method-resolution symbol scans (resolve_method_sym / method_ret_type).
    // True iff sym_name is longer than field_name, its last field_name.len bytes
    // equal field_name, and the byte just before them is '.'.
    let sl = std.string.len(sym_name)
    let fl = std.string.len(field_name)
    if sl <= fl:
        return false
    let sp = sym_name as ptr[u8]
    let fp = field_name as ptr[u8]
    if sp[sl - fl - 1 as i64] != 46 as u8:
        return false
    mut k := 0 as i64
    while k < fl:
        if sp[sl - fl + k] != fp[k]:
            return false
        k = k + 1
    return true

pub fn is_sym_generic(self: ptr[TypeChecker], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
    let sym = self.symtable.symbols.data[sym_idx]
    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
        return true
    if sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32:
        mut src_tree := self.tree
        if (sym_idx as i64) < self.symtable.symbol_trees.len:
            let t = self.symtable.symbol_trees.data[sym_idx]
            if t != null as ptr[AstTree]:
                src_tree = t
        if (sym.decl_node as i64) < src_tree.nodes.len:
            if (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16:
                return true
    return false

pub fn is_method_compatible(self: ptr[TypeChecker], sym_idx: u32, rec_type: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
        
    let sym = self.symtable.symbols.data[sym_idx]
    if sym.kind != SYM_FUNC:
        return false
        
    let type_id = sym.type_id
    if type_id == TYPE_UNKNOWN:
        return false
        
    let f_entry = self.types.entries.data[type_id]
    if f_entry.kind != TYPE_KIND_FUNC:
        return false
        
    let fi = self.types.funcs.data[f_entry.extra]
    if fi.params.len == 0:
        return false
        
    mut first_param_type = fi.params.data[0]
    mut unwrapped_param := first_param_type
    while unwrapped_param != TYPE_UNKNOWN:
        let p_entry = self.types.entries.data[unwrapped_param]
        if p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
            unwrapped_param = p_entry.extra
        else:
            break
            
    if unwrapped_param == TYPE_UNKNOWN:
        return false
        
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        return false
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    let param_entry = self.types.entries.data[unwrapped_param]

    if not self.is_sym_generic(sym_idx):
        return unwrapped_param == unwrapped_rec
        
    mut kinds_match := false
    if param_entry.kind == rec_entry.kind:
        kinds_match = true
    else:
        let is_param_structured = (param_entry.kind == TYPE_KIND_STRUCT or param_entry.kind == TYPE_KIND_SUM or param_entry.kind == TYPE_KIND_GENERIC_INST or param_entry.kind == TYPE_KIND_OPTION or param_entry.kind == TYPE_KIND_RESULT)
        let is_rec_structured = (rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT)
        if is_param_structured and is_rec_structured:
            kinds_match = true
            
    if not kinds_match:
        return false
        
    if rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT:
        if param_entry.name_id != 0 as u32 and rec_entry.name_id != 0 as u32:
            let rec_struct_mangled = self.intern.get(rec_entry.name_id)
            let rec_struct_name = extract_base_name(rec_struct_mangled)
            let param_struct_name = self.intern.get(param_entry.name_id)
            let param_base_name = extract_base_name(param_struct_name)
            
            let matched = match_method_name(rec_struct_name, param_base_name)
            
            safe_free_str(rec_struct_mangled)
            safe_free_str(rec_struct_name)
            safe_free_str(param_struct_name)
            safe_free_str(param_base_name)
            return matched
        return param_entry.extra == rec_entry.extra
        
    return true

pub fn resolve_method_sym(self: ptr[TypeChecker], field_name_id: u32, rec_type: u32) -> u32:
    let field_name = self.intern.get(field_name_id)
    mut sym_idx := self.symtable.resolve(field_name_id)
    sym_idx = self.resolve_method_overload(sym_idx, rec_type)
    if sym_idx != 0 as u32 and not self.is_method_compatible(sym_idx, rec_type):
        sym_idx = 0 as u32
    if sym_idx != 0 as u32:
        safe_free_str(field_name)
        return sym_idx
        
    // Fallback search for generic method templates
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
            ax_printf_local("  [TC-DEBUG-RESOLVE-FALLBACK] unwrapped_rec is UNKNOWN for field_name=%s\n", (get_str_ptr(field_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        safe_free_str(field_name)
        return 0 as u32
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    
    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
        let rec_entry_kind = rec_entry.kind
        mut name_str := "0"
        if rec_entry.name_id != 0 as u32:
            name_str = self.intern.get(rec_entry.name_id)
        ax_printf_local("  [TC-DEBUG-RESOLVE-FALLBACK] field_name=%s rec_type=%d rec_kind=%d rec_name=%s name_id=%d\n", (get_str_ptr(field_name)) as i64, rec_type as i64, rec_entry_kind as i64, (get_str_ptr(name_str)) as i64, rec_entry.name_id as i64, 0 as i64, 0 as i64, 0 as i64)
        if rec_entry.name_id != 0 as u32:
            safe_free_str(name_str)

    if (rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT) and rec_entry.name_id != 0 as u32:
        let rec_struct_mangled = self.intern.get(rec_entry.name_id)
        let rec_struct_name = extract_base_name(rec_struct_mangled)
        
        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
            ax_printf_local("    [TC-DEBUG-RESOLVE-FALLBACK] rec_struct_mangled=%s rec_struct_name=%s\n", (get_str_ptr(rec_struct_mangled)) as i64, (get_str_ptr(rec_struct_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        mut idx := 0 as i64
        while idx < self.symtable.symbols.len:
            let sym = self.symtable.symbols.data[idx]
            if sym.kind == SYM_FUNC and (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
                // PERF: zero-alloc hot filter (was intern.get + match_method_name +
                // free per generic SYM_FUNC per call). sym_name is materialized only
                // on the rare debug path below.
                if self.intern.name_matches_method(sym.name_id, field_name):
                    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                        let dbg_name = self.intern.get(sym.name_id)
                        ax_printf_local("      [TC-DEBUG-RESOLVE-FALLBACK] candidate sym_name=%s matches field!\n", (get_str_ptr(dbg_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        safe_free_str(dbg_name)
                    mut t_id := sym.type_id
                    if t_id == TYPE_UNKNOWN and sym.decl_node != 0 as u32:
                        self.pre_infer_func_signature(sym.decl_node)
                        t_id = self.symtable.symbols.data[idx].type_id
                    if t_id != TYPE_UNKNOWN:
                        let f_entry = self.types.entries.data[t_id]
                        if f_entry.kind == TYPE_KIND_FUNC:
                            let fi = self.types.funcs.data[f_entry.extra]
                            if fi.params.len > 0:
                                mut first_param_type = fi.params.data[0]
                                mut unwrapped_param := first_param_type
                                while unwrapped_param != TYPE_UNKNOWN:
                                    let p_entry = self.types.entries.data[unwrapped_param]
                                    if p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
                                        unwrapped_param = p_entry.extra
                                    else:
                                        break
                                
                                if unwrapped_param != TYPE_UNKNOWN:
                                    let param_entry = self.types.entries.data[unwrapped_param]
                                    
                                    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                                        mut param_name_str := "0"
                                        if param_entry.name_id != 0 as u32:
                                            param_name_str = self.intern.get(param_entry.name_id)
                                        ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] param kind=%d name=%s name_id=%d\n", param_entry.kind as i64, (get_str_ptr(param_name_str)) as i64, param_entry.name_id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        if param_entry.name_id != 0 as u32:
                                            safe_free_str(param_name_str)
                                            
                                    if (param_entry.kind == TYPE_KIND_STRUCT or param_entry.kind == TYPE_KIND_SUM or param_entry.kind == TYPE_KIND_GENERIC_INST or param_entry.kind == TYPE_KIND_OPTION or param_entry.kind == TYPE_KIND_RESULT) and param_entry.name_id != 0 as u32:
                                        let param_struct_name = self.intern.get(param_entry.name_id)
                                        let param_base_name = extract_base_name(param_struct_name)
                                        
                                        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                                            ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] param_struct_name=%s param_base_name=%s\n", (get_str_ptr(param_struct_name)) as i64, (get_str_ptr(param_base_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                            let is_matched = match_method_name(rec_struct_name, param_base_name)
                                            ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] match_method_name matches? %d\n", is_matched as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                            
                                        if match_method_name(rec_struct_name, param_base_name):
                                            safe_free_str(rec_struct_mangled)
                                            safe_free_str(rec_struct_name)
                                            safe_free_str(param_struct_name)
                                            safe_free_str(param_base_name)
                                            safe_free_str(field_name)
                                            return idx as u32
                                        safe_free_str(param_base_name)
                                        safe_free_str(param_struct_name)
            idx = idx + 1 as i64
        safe_free_str(rec_struct_mangled)
        safe_free_str(rec_struct_name)
    safe_free_str(field_name)
    return 0 as u32

// BUG#45 case (1): resolve_method_sym only matches GENERIC method templates in
// its fallback, so a plain (non-generic) method's field-expr is left UNTYPED and
// node_types[call] stays 0. That is harmless for scalar returns (the value rides
// RAX/XMM0 and the copy defaults to 8 bytes) but fatal for an aggregate return:
// the `let r = obj.m()` copy then has size 0 and never copies the struct, so the
// result reads back as zero. This helper returns ONLY the RETURN type of the
// matching method (matched by name + receiver type, exactly like air_builder's
// method dispatch) WITHOUT mutating any node/flag/payload — it never changes how
// the method is resolved or called, only the type recorded for the call result.
pub fn method_ret_type(self: ptr[TypeChecker], field_name_id: u32, rec_type: u32) -> u32:
    let field_name = self.intern.get(field_name_id)
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN and (unwrapped_rec as i64) < self.types.entries.len:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
    if unwrapped_rec == TYPE_UNKNOWN:
        safe_free_str(field_name)
        return 0 as u32
    mut result := 0 as u32
    mut idx := 0 as i64
    while idx < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[idx]
        // Only consider methods whose signature is ALREADY inferred. Do NOT call
        // pre_infer_func_signature here: sym.decl_node may index a DIFFERENT
        // module's AST tree, but pre_infer uses self.tree, so forcing it reads out
        // of bounds and crashes the compiler (regression: t_mathx bignum methods).
        // Every index into the type table is bounds-checked for the same reason.
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len:
            // PERF: zero-alloc name match (was intern.get + match_method_name + free
            // per SYM_FUNC per call). sym_name was used only for this test.
            if self.intern.name_matches_method(sym.name_id, field_name):
                let f_entry = self.types.entries.data[sym.type_id]
                if f_entry.kind == TYPE_KIND_FUNC and (f_entry.extra as i64) < self.types.funcs.len:
                    let fi = self.types.funcs.data[f_entry.extra]
                    if fi.params.len > 0:
                        mut fp := fi.params.data[0]
                        while fp != TYPE_UNKNOWN and (fp as i64) < self.types.entries.len:
                            let pe = self.types.entries.data[fp]
                            if pe.kind == TYPE_KIND_POINTER or pe.kind == TYPE_KIND_REF:
                                fp = pe.extra
                            else:
                                break
                        // Numeric UFCS widening: a narrower integer receiver
                        // (i8/i16/i32/u8/u16/u32) matches an i64 first-param free
                        // fn — mirroring the i32->i64 coercion the free-CALL form
                        // already permits (`to_str(x)` works but `x.to_str()` used
                        // to reject). Safe with NO cast because every narrow-int
                        // producer normalizes its register to full 64-bit width
                        // (x86_selector emit_wrap_to_width/emit_load_extend), so the
                        // receiver value already equals `x as i64` — the lowering
                        // passes it directly (air_builder ~1598). NOT extended to
                        // f32->f64: an f32 in an XMM reg is not an f64 (needs a real
                        // cvtss2sd), so that would miscompile without emitting a cast.
                        mut num_widen := false
                        if fp == TYPE_I64 and (unwrapped_rec == TYPE_I8 or unwrapped_rec == TYPE_I16 or unwrapped_rec == TYPE_I32 or unwrapped_rec == TYPE_U8 or unwrapped_rec == TYPE_U16 or unwrapped_rec == TYPE_U32):
                            num_widen = true
                        if fp == unwrapped_rec or num_widen:
                            result = fi.ret
                            break
        idx = idx + 1 as i64
    safe_free_str(field_name)
    return result

// BUG#93(b): self-type-aware method-existence test for the accept-then-miscompile
// reject gate. Returns true iff some SYM_FUNC named `mname` has an already-inferred
// first param whose unwrapped type is a NAMED aggregate (struct/sum/generic-inst/
// option/result) whose BASE name matches the receiver base name `rec_base`. A
// method that exists ONLY on a DIFFERENT type (e.g. `contains` on HashSet, absent
// on HashMap) then does NOT suppress the reject, so `m.contains(k)` is rejected
// cleanly instead of miscompiling to getfld + `call *garbage` (SIGSEGV). Base-name
// (not exact type-id) match is cross-module safe. Only considers symbols with an
// inferred signature — like method_ret_type, it NEVER forces pre_infer_func_
// signature (that reads a foreign module's AST via self.tree and crashes).
pub fn has_method_for_base(self: ptr[TypeChecker], mname: str, rec_base: str) -> bool:
    mut si := 0 as i64
    while si < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[si]
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len and self.intern.name_matches_method(sym.name_id, mname):
            let fe = self.types.entries.data[sym.type_id as i64]
            if fe.kind == TYPE_KIND_FUNC and (fe.extra as i64) < self.types.funcs.len:
                let cfi = self.types.funcs.data[fe.extra as i64]
                if cfi.params.len > 0 as i64:
                    mut pp := cfi.params.data[0]
                    while pp != TYPE_UNKNOWN and (pp as i64) < self.types.entries.len:
                        let ppe = self.types.entries.data[pp as i64]
                        if ppe.kind == TYPE_KIND_POINTER or ppe.kind == TYPE_KIND_REF:
                            pp = ppe.extra
                        else:
                            break
                    if pp != TYPE_UNKNOWN and (pp as i64) < self.types.entries.len:
                        let ppe2 = self.types.entries.data[pp as i64]
                        if (ppe2.kind == TYPE_KIND_STRUCT or ppe2.kind == TYPE_KIND_SUM or ppe2.kind == TYPE_KIND_GENERIC_INST or ppe2.kind == TYPE_KIND_OPTION or ppe2.kind == TYPE_KIND_RESULT) and ppe2.name_id != 0 as u32:
                            let pmangled = self.intern.get(ppe2.name_id)
                            let pbn = extract_base_name(pmangled)
                            let matched = match_method_name(rec_base, pbn)
                            safe_free_str(pmangled)
                            safe_free_str(pbn)
                            if matched:
                                return true
        si = si + 1 as i64
    return false

pub fn free_type_checker(mut self: ptr[TypeChecker]):
    @free(self.node_types as ptr[u8])

pub fn ensure_capacity(mut self: ptr[TypeChecker], cap: i64):
    if cap <= self.node_types_cap:
        return
    let new_ptr = @alloc(cap * 4) as ptr[u32]
    mut i := 0 as i64
    while i < self.node_types_cap:
        new_ptr[i] = self.node_types[i]
        i = i + 1
    while i < cap:
        new_ptr[i] = 0 as u32
        i = i + 1
    @free(self.node_types as ptr[u8])
    self.node_types = new_ptr
    self.node_types_cap = cap

pub fn set_node_type(mut self: ptr[TypeChecker], node_idx: u32, type_id: u32):
    if node_idx == 0xffffffff as u32:
        return
    let idx = node_idx as i64
    if idx >= self.node_types_cap:
        mut new_cap := self.node_types_cap * 2
        if idx >= new_cap:
            new_cap = idx + 100 as i64
        let new_ptr = @alloc(new_cap * 4) as ptr[u32]
        mut i := 0 as i64
        while i < self.node_types_cap:
            new_ptr[i] = self.node_types[i]
            i = i + 1
        while i < new_cap:
            new_ptr[i] = 0 as u32
            i = i + 1
        @free(self.node_types as ptr[u8])
        self.node_types = new_ptr
        self.node_types_cap = new_cap
    self.node_types[idx] = type_id

pub fn parse_comptime_int(s: str) -> i64:
    let len = std.string.len(s)
    if len == 0:
        return 0 as i64
    mut i := 0
    mut sign := 1 as i64
    if s[0] as u8 == '-' as u8:
        sign = -1 as i64
        i = 1
    elif s[0] as u8 == '+' as u8:
        i = 1

    mut base := 10 as i64
    if i + 1 < len and s[i] as u8 == '0' as u8:
        let next_char = s[i + 1] as u8
        if next_char == 'x' as u8 or next_char == 'X' as u8:
            base = 16 as i64
            i = i + 2
        elif next_char == 'o' as u8 or next_char == 'O' as u8:
            base = 8 as i64
            i = i + 2
        elif next_char == 'b' as u8 or next_char == 'B' as u8:
            base = 2 as i64
            i = i + 2

    mut val := 0 as i64
    while i < len:
        let c = s[i] as u8
        // digit-group separator: skip and keep scanning (e.g. 1_000_000)
        if c == '_' as u8:
            i = i + 1
            continue
        mut digit := -1 as i64
        if c >= '0' as u8 and c <= '9' as u8:
            digit = (c - '0' as u8) as i64
        elif c >= 'a' as u8 and c <= 'f' as u8:
            digit = (c - 'a' as u8 + 10 as u8) as i64
        elif c >= 'A' as u8 and c <= 'F' as u8:
            digit = (c - 'A' as u8 + 10 as u8) as i64

        if digit < 0 or digit >= base:
            break

        val = val * base + digit
        i = i + 1

    return val * sign

pub fn node_text_in_tree(self: ptr[TypeChecker], tree: ptr[AstTree], node_idx: u32) -> str:
    if tree == null as ptr[AstTree] or node_idx == 0 as u32 or (node_idx as i64) >= tree.nodes.len:
        return ""
    let node = tree.nodes.data[node_idx]
    let tok_idx = node.token_idx
    if tok_idx as i64 >= tree.tokens.len:
        return ""
    let tok = tree.tokens.data[tok_idx as i64]
    if tok.len == 0 as u16:
        return ""
    let start_ptr = ((tree.src as ptr[u8]) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn node_text(self: ptr[TypeChecker], node_idx: u32) -> str:
    return self.node_text_in_tree(self.tree, node_idx)

pub fn eval_comptime(mut self: ptr[TypeChecker], node_idx: u32) -> ComptimeValue:
    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind
    
    if kind == NODE_INT_LIT:
        let text = self.node_text(node_idx)
        let val = parse_comptime_int(text)
        return ComptimeValue(kind: TYPE_I64, int_val: val, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_FLOAT_LIT:
        let text = self.node_text(node_idx)
        let val = atof(get_str_ptr(text))
        return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: val, bool_val: false, str_val: "")
        
    elif kind == NODE_BOOL_LIT:
        let text = self.node_text(node_idx)
        let is_true = (text == "true")
        return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: is_true, str_val: "")
        
    elif kind == NODE_STRING_LIT:
        let text = self.node_text(node_idx)
        let stripped = strip_quotes(text)
        return ComptimeValue(kind: TYPE_STRING, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: stripped)
        
    elif kind == NODE_COMPTIME:
        let child = node.first_child
        if child != 0 as u32:
            return self.eval_comptime(child)
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_BLOCK:
        mut child := node.first_child
        if child == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        mut last_val = ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        while child != 0 as u32:
            last_val = self.eval_comptime(child)
            child = self.tree.nodes.data[child].next_sibling
        return last_val
        
    elif kind == NODE_RETURN_STMT:
        let child = node.first_child
        if child != 0 as u32:
            return self.eval_comptime(child)
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_UNARY_EXPR:
        let child = node.first_child
        if child == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let val = self.eval_comptime(child)
        let op = self.node_text(node_idx)
        if op == "-":
            if val.kind == TYPE_I64:
                return ComptimeValue(kind: TYPE_I64, int_val: 0 as i64 - val.int_val, float_val: 0.0, bool_val: false, str_val: "")
            elif val.kind == TYPE_F64:
                return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: 0.0 - val.float_val, bool_val: false, str_val: "")
        elif op == "not" or op == "!":
            if val.kind == TYPE_BOOL:
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: not val.bool_val, str_val: "")
        elif op == "~":
            if val.kind == TYPE_I64:
                return ComptimeValue(kind: TYPE_I64, int_val: 0 as i64 - val.int_val - 1 as i64, float_val: 0.0, bool_val: false, str_val: "")
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_BINARY_EXPR:
        let lhs_idx = node.first_child
        if lhs_idx == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        if rhs_idx == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let lhs = self.eval_comptime(lhs_idx)
        let rhs = self.eval_comptime(rhs_idx)
        let op = self.node_text(node_idx)
        
        let is_lhs_num = (lhs.kind == TYPE_I64 or lhs.kind == TYPE_F64)
        let is_rhs_num = (rhs.kind == TYPE_I64 or rhs.kind == TYPE_F64)
        if is_lhs_num and is_rhs_num:
            if lhs.kind == TYPE_F64 or rhs.kind == TYPE_F64:
                mut lf := lhs.float_val
                if lhs.kind == TYPE_I64:
                    lf = lhs.int_val as f64
                mut rf := rhs.float_val
                if rhs.kind == TYPE_I64:
                    rf = rhs.int_val as f64
                if op == "+":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf + rf, bool_val: false, str_val: "")
                elif op == "-":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf - rf, bool_val: false, str_val: "")
                elif op == "*":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf * rf, bool_val: false, str_val: "")
                elif op == "/":
                    if rf == 0.0:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf / rf, bool_val: false, str_val: "")
                elif op == "==":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf == rf, str_val: "")
                elif op == "!=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf != rf, str_val: "")
                elif op == "<":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf < rf, str_val: "")
                elif op == "<=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf <= rf, str_val: "")
                elif op == ">":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf > rf, str_val: "")
                elif op == ">=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf >= rf, str_val: "")
            else:
                let lh = lhs.int_val
                let rh = rhs.int_val
                if op == "+":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh + rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "-":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh - rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "*":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh * rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "/":
                    if rh == 0 as i64:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_I64, int_val: lh / rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "%":
                    if rh == 0 as i64:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_I64, int_val: lh % rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "==":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh == rh, str_val: "")
                elif op == "!=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh != rh, str_val: "")
                elif op == "<":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh < rh, str_val: "")
                elif op == "<=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh <= rh, str_val: "")
                elif op == ">":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh > rh, str_val: "")
                elif op == ">=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh >= rh, str_val: "")
        
        if lhs.kind == TYPE_BOOL and rhs.kind == TYPE_BOOL:
            let lb = lhs.bool_val
            let rb = rhs.bool_val
            if op == "and" or op == "&&":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb and rb, str_val: "")
            elif op == "or" or op == "||":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb or rb, str_val: "")
            elif op == "==":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb == rb, str_val: "")
            elif op == "!=":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb != rb, str_val: "")
                
        if lhs.kind == TYPE_STRING and rhs.kind == TYPE_STRING:
            let ls = lhs.str_val
            let rs = rhs.str_val
            if op == "+":
                return ComptimeValue(kind: TYPE_STRING, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: std.string.concat(ls, rs))
            elif op == "==":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: ls == rs, str_val: "")
            elif op == "!=":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: ls != rs, str_val: "")
                
    return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")

// RFC 0017 / BUG#82: is a module-level global's initializer a compile-time constant
// scalar that the backend can fold into the data image? Phase 1 accepts literal
// constants (and a leading unary +/- on one); absent init (idx 0) folds to zero. Must
// stay in lockstep with air_builder.builder_fold_global_init (which does the fold).
pub fn ax_global_init_is_const(tree: ptr[AstTree], idx: u32) -> bool:
    if idx == 0 as u32:
        return true
    let n = tree.nodes.data[idx as i64]
    if n.kind == NODE_INT_LIT or n.kind == NODE_FLOAT_LIT or n.kind == NODE_BOOL_LIT or n.kind == NODE_CHAR_LIT or n.kind == NODE_NIL_LIT:
        return true
    // A leading unary +/- on a constant, or a cast of a constant (`0 as u64`), is still a
    // compile-time constant — recurse into the operand. Casts are pervasive in real
    // stdlib globals (`mut g: u64 = 0 as u64`).
    if n.kind == NODE_UNARY_EXPR or n.kind == NODE_CAST_EXPR:
        return ax_global_init_is_const(tree, n.first_child)
    return false

// RFC 0017 / BUG#82: validate one module-level `let`/`mut` declaration. Rejects
// (with a diagnostic + diags_count bump so the driver halts before codegen) any global
// that is not a scalar (primitive/pointer, size 1..8) or whose initializer is not a
// compile-time constant. `const` decls are a separate node kind (inlined, not storage)
// and never reach here.
pub fn check_module_global(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx == 0 as u32:
        return
    let type_id = self.symtable.symbols.data[sym_idx].type_id
    let name = self.intern.get(self.symtable.symbols.data[sym_idx].name_id)

    // Separate the initializer from an optional type annotation.
    mut init_expr := 0 as u32
    mut ann_node := 0 as u32
    mut child := self.tree.nodes.data[node_idx].first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_GENERIC_TYPE:
            init_expr = child
        else:
            ann_node = child
        child = cn.next_sibling

    // RFC 0017 P2: an `Option[T]` / `Result[T,E]` annotation is deliberately left
    // UNRESOLVED (type_id 0) by the general NODE_GENERIC_TYPE inference path, because
    // retyping every such annotation to the kind-11/12 pointer-repr entry would shift
    // the RFC 0012 str-box EQ/COPY/MAKE_REF paths and break self-compilation (see the
    // array-element note in infer_node). Resolve it HERE — scoped to a MODULE-LEVEL
    // global declaration only — and pin the symbol's type_id so collect_global and
    // lower_global_read see the pointer-repr type. The compiler's own source has no
    // module-level Option/Result globals, so the self-host fixpoint is unaffected.
    mut type_id2 = type_id
    if type_id2 == 0 as u32 and ann_node != 0 as u32 and self.tree.nodes.data[ann_node].kind == NODE_GENERIC_TYPE:
        let ab = self.tree.nodes.data[ann_node].first_child
        if ab != 0 as u32:
            let abname = self.node_text(ab)
            if abname == "Option":
                let a1 = self.tree.nodes.data[ab].next_sibling
                mut it := TYPE_UNKNOWN
                if a1 != 0 as u32:
                    it = self.infer_node(a1, TYPE_UNKNOWN)
                type_id2 = self.types.register_option(it)
            elif abname == "Result":
                let a1 = self.tree.nodes.data[ab].next_sibling
                mut okt := TYPE_UNKNOWN
                mut ert := TYPE_UNKNOWN
                if a1 != 0 as u32:
                    okt = self.infer_node(a1, TYPE_UNKNOWN)
                    let a2 = self.tree.nodes.data[a1].next_sibling
                    if a2 != 0 as u32:
                        ert = self.infer_node(a2, TYPE_UNKNOWN)
                type_id2 = self.types.register_result(okt, ert)
            safe_free_str(abname)
            if type_id2 != 0 as u32:
                self.symtable.symbols.data[sym_idx].type_id = type_id2

    // A global is supported if it is either a scalar (primitive/pointer/ref of size
    // 1..8, stored inline in `.data`) OR — RFC 0017 P2 — a by-address AGGREGATE:
    // a struct, fixed array, or tuple. Aggregate globals get a zeroed `.data` slot
    // sized to the type; a present initializer is evaluated at program entry (the
    // `main` prologue) and block-copied into that slot (see collect_global /
    // lower_global_read). Pointer-repr sum/Option/Result globals are still deferred
    // (they need the 8-byte box-pointer store path, not a block copy).
    mut supported := false
    if type_id2 != 0 as u32 and (type_id2 as i64) < self.types.entries.len:
        let k = self.types.entries.data[type_id2 as i64].kind
        if k == TYPE_KIND_PRIMITIVE or k == TYPE_KIND_POINTER or k == TYPE_KIND_REF:
            mut gsize := 0 as u32
            mut galign := 0 as u32
            builder_type_size_and_align(self.types, type_id2, &gsize, &galign)
            if gsize >= 1 as u32 and gsize <= 8 as u32:
                supported = true
            elif gsize == 16 as u32:
                // RFC 0017 P2: `str`/`bytes` — a 16-byte INLINE primitive ({ptr,len}).
                // NOT a by-address aggregate: the value's home holds all 16 bytes. The
                // `.data` slot is 16 bytes; init is runtime (both halves stored inline,
                // NOT a block copy from an address). See collect_global / OP_LOAD in the
                // selector (16-byte inline load path, mirroring OP_GET_FIELD for str).
                supported = true
        elif k == TYPE_KIND_STRUCT or k == TYPE_KIND_ARRAY or k == TYPE_KIND_TUPLE:
            supported = true
        elif type_is_pointer_repr(self.types, self.intern, type_id2):
            // RFC 0017 P2: a sum/Option/Result global. Its VALUE is an 8-byte tagged
            // box pointer (entry.size 16 = the heap box, NOT the slot). Stored inline
            // as an 8-byte pointer in `.data`, runtime-initialized at program entry
            // (the box is heap-allocated then its pointer stored). See collect_global /
            // lower_global_read (both route pointer-repr through an 8-byte load/store,
            // NOT a block copy).
            supported = true
    if not supported:
        ax_printf_local("error: module-level global '%s' must be a scalar, struct, fixed-array, tuple, or sum/Option/Result type\n", get_str_ptr(name) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.diags_count = self.diags_count + 1 as i64
        return

    // RFC 0017 P2: non-constant scalar initializers are now supported — they are
    // evaluated at program entry (a prologue in `main`, in source-declaration order)
    // rather than folded into `.data`. Only aggregate globals remain rejected above.
    // `init_expr` is left to be type-checked by the normal declaration traversal.

// --- Missing-return analysis (BUG#53 family) ---------------------------------
// A non-void function that can fall off the end of its body silently returns a
// garbage register (AXIOM has no implicit last-expression return). `stmt_terminates`
// is a CONSERVATIVE structural check: it returns true only when control provably
// leaves the function (or diverges) at this statement. To avoid false positives
// that would reject valid code, loops and trailing call-expressions (which may be
// `panic`/`abort`/noreturn) are treated as terminating -- we accept missing some
// real fall-throughs (false negatives) in exchange for never rejecting valid code.
pub fn tc_last_child(self: ptr[TypeChecker], node_idx: u32) -> u32:
    mut last := 0 as u32
    mut child := self.tree.nodes.data[node_idx].first_child
    while child != 0 as u32:
        last = child
        child = self.tree.nodes.data[child].next_sibling
    return last

pub fn stmt_terminates(self: ptr[TypeChecker], node_idx: u32) -> bool:
    if node_idx == 0 as u32:
        return false
    let kind = self.tree.nodes.data[node_idx].kind
    if kind == NODE_RETURN_STMT:
        return true
    if kind == NODE_BLOCK:
        return self.stmt_terminates(self.tc_last_child(node_idx))
    if kind == NODE_WHILE_STMT or kind == NODE_FOR_STMT:
        // Generous: a loop may run forever or `return` from inside; treating it as
        // terminating avoids false positives on `while true:` dispatch loops.
        return true
    if kind == NODE_CALL_EXPR:
        // Generous: a trailing bare call may be a noreturn `panic`/`abort`/`exit`.
        return true
    if kind == NODE_IF_STMT:
        // children: cond, if-body(block), elif-clause*, else-clause?
        // Terminates iff there IS an else clause and every branch terminates.
        mut has_else := false
        mut all_term := true
        mut seen_body := false
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let ck = self.tree.nodes.data[child].kind
            if ck == NODE_BLOCK:
                if not seen_body:
                    seen_body = true
                    if not self.stmt_terminates(child):
                        all_term = false
            elif ck == NODE_ELIF_CLAUSE:
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            elif ck == NODE_ELSE_CLAUSE:
                has_else = true
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            child = self.tree.nodes.data[child].next_sibling
        return has_else and all_term
    if kind == NODE_MATCH_STMT:
        // children: scrutinee, arm*. Terminates iff every arm terminates AND the
        // match is not a CONFIRMED non-exhaustive one (which can fall through off the
        // end). The FLAG_MATCH_PARTIAL bit is set by the typechecker only when it is
        // certain a variant is uncovered with no catch-all, so an unmarked match is
        // conservatively treated as total.
        if (self.tree.nodes.data[node_idx].flags & FLAG_MATCH_PARTIAL) != 0 as u16:
            return false
        mut any_arm := false
        mut all_term := true
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            if self.tree.nodes.data[child].kind == NODE_MATCH_ARM:
                any_arm = true
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            child = self.tree.nodes.data[child].next_sibling
        return any_arm and all_term
    return false

pub fn tc_func_body(self: ptr[TypeChecker], func_idx: u32) -> u32:
    mut child := self.tree.nodes.data[func_idx].first_child
    while child != 0 as u32:
        if self.tree.nodes.data[child].kind == NODE_BLOCK:
            return child
        child = self.tree.nodes.data[child].next_sibling
    return 0 as u32

// Returns true ONLY when the typechecker is CERTAIN a match does not cover all
// cases: the scrutinee resolves to a sum/Option/Result whose full variant set is
// known, there is NO catch-all (wildcard or bare-binding) arm, and at least one
// variant is left uncovered. Any uncertainty (unknown type, unresolved
// generic-inst base, out-of-range index, non-sum scrutinee) returns false so the
// missing-return terminator analysis treats the match as total and never rejects
// valid code. AXIOM allows non-exhaustive matches to FALL THROUGH, so this is used
// only to decide whether a match is a guaranteed terminator -- it is NOT a
// standalone exhaustiveness error.
pub fn match_is_confidently_partial(self: ptr[TypeChecker], match_idx: u32, scrutinee_type: u32) -> bool:
    if scrutinee_type == TYPE_UNKNOWN or (scrutinee_type as i64) >= self.types.entries.len:
        return false
    let s_entry = self.types.entries.data[scrutinee_type as i64]
    if not (s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST or s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT):
        return false
    // OPTION/RESULT (kind 11/12) are NOT backed by a `sumtypes` entry: their `.extra`
    // is the INNER/ok TYPE id, not a sumtypes index. Feeding it to the sumtypes lookup
    // below reads a garbage `variants` pointer -> crash (surfaces once a match scrutinee
    // is actually typed OPTION, e.g. an element read from `[Option[T];N]`). Their
    // exhaustiveness is not sumtypes-driven, so conservatively report "not confidently
    // partial" (treated as total; never false-rejects a missing return).
    if s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT:
        return false
    mut sum_extra := s_entry.extra
    if s_entry.kind == TYPE_KIND_GENERIC_INST:
        mut resolved := false
        mut idx := 0 as i64
        while idx < self.types.entries.len:
            let e = self.types.entries.data[idx]
            let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
            let s_base = extract_qualified_base_name(self.intern.get(s_entry.name_id))
            if e.kind == TYPE_KIND_SUM and e_base == s_base:
                sum_extra = e.extra
                resolved = true
                break
            idx = idx + 1
        if not resolved:
            return false
    if (sum_extra as i64) >= self.types.sumtypes.len:
        return false
    let sum_info = self.types.sumtypes.data[sum_extra]
    // Pass 1: a wildcard or a TRUE catch-all bare-binding arm covers everything ->
    // total. A bare NODE_BINDING_PAT whose name IS a variant of this sum is a
    // no-payload TAG-match (mirrors air_builder ~2833-2846: `find_variant_info` on
    // the bound name), NOT a catch-all -- so it must NOT short-circuit here, else a
    // non-exhaustive no-payload-enum match (`Red | Green | Blue` matching only Red,
    // Green) is wrongly treated as total and the missing-return terminator check is
    // suppressed -> silent garbage fall-through. (If the binding payload is not yet
    // resolved to a symbol, treat it conservatively as a catch-all == prior behavior.)
    mut child := self.tree.nodes.data[match_idx].first_child
    if child != 0 as u32:
        child = self.tree.nodes.data[child].next_sibling
    while child != 0 as u32:
        if self.tree.nodes.data[child].kind == NODE_MATCH_ARM:
            let pat = self.tree.nodes.data[child].first_child
            if pat != 0 as u32:
                let pk = self.tree.nodes.data[pat].kind
                if pk == NODE_WILDCARD_PAT:
                    return false
                if pk == NODE_BINDING_PAT:
                    if not self.binding_pat_is_variant(pat, sum_info):
                        return false
        child = self.tree.nodes.data[child].next_sibling
    // Pass 2: every declared variant must be covered by a VARIANT_PAT arm OR a bare
    // no-payload variant BINDING_PAT arm (both are tag-matches at lowering time).
    mut vi := 0 as i64
    while vi < sum_info.variants.len:
        let v_name = sum_info.variants.data[vi].name_id
        mut covered := false
        mut c2 := self.tree.nodes.data[match_idx].first_child
        if c2 != 0 as u32:
            c2 = self.tree.nodes.data[c2].next_sibling
        while c2 != 0 as u32:
            if self.tree.nodes.data[c2].kind == NODE_MATCH_ARM:
                let pat = self.tree.nodes.data[c2].first_child
                if pat != 0 as u32:
                    let pkk = self.tree.nodes.data[pat].kind
                    if pkk == NODE_VARIANT_PAT or pkk == NODE_BINDING_PAT:
                        let vsym = self.tree.nodes.data[pat].payload
                        if vsym != 0 as u32 and (vsym as i64) < self.symtable.symbols.len:
                            if self.symtable.symbols.data[vsym].name_id == v_name:
                                covered = true
            c2 = self.tree.nodes.data[c2].next_sibling
        if not covered:
            return true
        vi = vi + 1
    return false

// True if a bare NODE_BINDING_PAT's bound name matches a declared variant of the
// given sum (a no-payload tag-match), false for a genuine catch-all binding or an
// as-yet-unresolved pattern. Mirrors air_builder's find_variant_info-by-name.
pub fn binding_pat_is_variant(self: ptr[TypeChecker], pat: u32, sum_info: SumInfo) -> bool:
    let bsi = self.tree.nodes.data[pat].payload
    if bsi == 0 as u32 or (bsi as i64) >= self.symtable.symbols.len:
        return false
    let bnid = self.symtable.symbols.data[bsi as i64].name_id
    mut vj := 0 as i64
    while vj < sum_info.variants.len:
        if sum_info.variants.data[vj].name_id == bnid:
            return true
        vj = vj + 1
    return false

pub fn run_type_checker(mut self: ptr[TypeChecker]):
    // Phase 0.0: Pre-register all Struct Type IDs (empty) to allow mutual / forward
    // references. MUST run before Phase 0.1 (sum-type pre-inference): a sum variant
    // with a STRUCT payload (`type Shape = Dot(Point) | ...`) infers that payload's
    // type during pre_infer_type_alias, which needs the struct's type_id to already
    // exist. When this ran AFTER the sum pass, such a payload resolved to UNKNOWN, so
    // the match binding was untyped and a `p.field` access could not resolve the
    // field index (it defaulted to 0 — reading the wrong field).
    mut i := 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_STRUCT_DECL:
            let sym_idx = node.payload
            if sym_idx != 0 as u32:
                let sym = self.symtable.symbols.data[sym_idx]
                if sym.type_id == 0 as u32:
                    let struct_type_id = self.types.register_struct(sym.name_id, StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0))
                    self.symtable.symbols.data[sym_idx].type_id = struct_type_id
        elif node.kind == NODE_INTERFACE_DECL:
            // BUG#71 prerequisite: without this, `sym.type_id` for an interface
            // name stays 0/TYPE_UNKNOWN forever (nothing else in typecheck.ax
            // ever touches NODE_INTERFACE_DECL), so a param typed `s: Shape`
            // resolves to TYPE_UNKNOWN rather than something recognizable as
            // "an interface" -- which is what let dynamic-dispatch calls through
            // it silently resolve to an arbitrary same-named method instead of
            // being rejected. Giving interfaces a real (minimal) type_id here is
            // what makes that rejection check able to fire at all.
            let sym_idx = node.payload
            if sym_idx != 0 as u32:
                let sym = self.symtable.symbols.data[sym_idx]
                if sym.type_id == 0 as u32:
                    let iface_type_id = self.types.register_interface(sym.name_id)
                    self.symtable.symbols.data[sym_idx].type_id = iface_type_id
        i = i + 1

    // Phase 0.1: Register all Type Aliases / Sum Types (struct type_ids now exist,
    // so struct-typed variant payloads resolve to the right type).
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_TYPE_ALIAS_DECL:
            self.pre_infer_type_alias(i as u32)
        i = i + 1

    // Phase 1: Register all StructDeclarations
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_STRUCT_DECL:
            self.pre_infer_struct(i as u32)
        i = i + 1

    // Phase 2: Register all function signatures
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node2 = self.tree.nodes.data[i]
        if node2.kind == NODE_FUNC_DECL:
            self.pre_infer_func_signature(i as u32)
        i = i + 1

    // Phase 3: Traversal type inference
    self.infer_node(0 as u32, TYPE_UNKNOWN)

    // Phase 3.5 (mangling uniquing, [[bug-freefn-stdlib-collision-noarg]]): a user free fn
    // whose name collides with a bundled stdlib free fn where BOTH bare-mangle to
    // `ax_<name>` (scalar/str/no receiver) would link-merge and silently mis-dispatch
    // (SIGSEGV / wrong result). The backend already emits a UNIQUE `ax_<name>__m<idx>` for
    // any symbol flagged SYM_FLAG_MODDUP, but the resolver only sets that for CROSS-TREE
    // dups — and the driver concatenates stdlib+user into ONE tree, so same-tree collisions
    // slip through. Tag every bare-mangling function that shares its name with an EARLIER
    // bare-mangling function so each gets a distinct symbol; the FIRST keeps the bare name
    // (existing callers unchanged). Paired with the arity disambiguation in
    // resolve_free_call_overload, the call binds to the user's symbol and targets its unique
    // body. Types are resolved now, so the struct-receiver test is reliable. Precompute the
    // bare-mangle bitmap once (O(n)) so the pairwise scan is plain integer comparisons.
    let nsym = self.symtable.symbols.len
    if nsym > 1 as i64:
        mut bare := @alloc(nsym) as ptr[u8]
        mut bi := 0 as i64
        while bi < nsym:
            if self.free_fn_bare_mangles(bi as u32):
                bare[bi] = 1 as u8
            else:
                bare[bi] = 0 as u8
            bi = bi + 1
        mut mi := 1 as i64
        while mi < nsym:
            if bare[mi] == 1 as u8:
                let nm_id = self.symtable.symbols.data[mi].name_id
                mut mj := 0 as i64
                mut collides := false
                while mj < mi:
                    if bare[mj] == 1 as u8 and self.symtable.symbols.data[mj].name_id == nm_id:
                        collides = true
                        mj = mi
                    mj = mj + 1
                if collides:
                    self.symtable.symbols.data[mi].flags = self.symtable.symbols.data[mi].flags | 2048 as u16
            mi = mi + 1
        @free(bare as ptr[u8])

    // Phase 4 (RFC 0017 / BUG#82): validate module-level global variables. A
    // module-level `let`/`mut` (not `const`) gets real static storage in the backend
    // (OP_GLOBAL_ADDR + a writable data slot). Phase 1 supports only *scalar* globals
    // (primitive/pointer, size <= 8) with a *compile-time-constant* initializer folded
    // into the data image. Reject anything else with a diagnostic instead of silently
    // miscompiling (BUG#53 convention). Types are resolved now (post-inference), so the
    // size check is reliable. Module scope = direct children of the root node.
    mut gchild := self.tree.nodes.data[0].first_child
    while gchild != 0 as u32:
        let gnode = self.tree.nodes.data[gchild]
        if gnode.kind == NODE_VAR_DECL:
            self.check_module_global(gchild)
        gchild = gnode.next_sibling

    // Phase 5 (accept-then-miscompile, BUG#53 class — "forgot to unwrap"): a bare
    // FIELD load `o.field` on a value whose type is Option[T]/Result[T,E] silently read
    // offset 0 of the box/tag (garbage) instead of the payload's field — the user meant
    // `o.unwrap().field` (or a match). Option/Result are SUM types (`Some(T) | None`)
    // with NO user-accessible data fields, so ANY bare field-load on such a value is a
    // mistake. Runs POST-inference (node_types populated + generic returns recovered by
    // the BUG#61 recovery blocks), so the receiver type is reliable even for a chained
    // `v.get(i).field` receiver — the inference-time attempt failed precisely because
    // that chained receiver was still untyped mid-traversal. Method calls (`o.unwrap()`)
    // are field-expr CALLEES: excluded via a callee bitmap. Qualified constructor forms
    // (`Option.Some(x)`) are excluded both as callees and by the bare-type-name guard.
    let nnodes = self.tree.nodes.len
    if nnodes > 0 as i64:
        mut callee_bm := @alloc(nnodes) as ptr[u8]
        mut ci := 0 as i64
        while ci < nnodes:
            callee_bm[ci] = 0 as u8
            ci = ci + 1
        ci = 0 as i64
        while ci < nnodes:
            if self.tree.nodes.data[ci].kind == NODE_CALL_EXPR:
                let cc = self.tree.nodes.data[ci].first_child
                if cc != 0 as u32 and (cc as i64) < nnodes:
                    callee_bm[cc as i64] = 1 as u8
            ci = ci + 1
        mut fi2 := 0 as i64
        while fi2 < nnodes:
            let fnode = self.tree.nodes.data[fi2]
            if fnode.kind == NODE_FIELD_EXPR and callee_bm[fi2] == 0 as u8:
                let frecv = fnode.first_child
                if frecv != 0 as u32 and (frecv as i64) < self.node_types_cap:
                    mut frt := self.node_types[frecv as i64]
                    if frt != TYPE_UNKNOWN and (frt as i64) < self.types.entries.len:
                        mut frue := self.types.entries.data[frt as i64]
                        while frue.kind == TYPE_KIND_POINTER or frue.kind == TYPE_KIND_REF:
                            frt = frue.extra as u32
                            frue = self.types.entries.data[frt as i64]
                        // Detect Option/Result robustly: a concrete Option[Cell] is a
                        // MONOMORPHIZED sum entry named `_AX_std_Option__Cell` (payload
                        // separator `Option__`), NOT the bare TYPE_KIND_OPTION — so match
                        // both the raw kind AND the mangled `Option__`/`Result__` name (the
                        // same forms the `.new()` collection detection uses at ~3628).
                        mut is_opt_res := false
                        if frue.kind == TYPE_KIND_OPTION or frue.kind == TYPE_KIND_RESULT:
                            is_opt_res = true
                        elif (frue.kind == TYPE_KIND_GENERIC_INST or frue.kind == TYPE_KIND_SUM) and frue.name_id != 0 as u32:
                            let frnm = self.intern.get(frue.name_id)
                            if std.string.contains(frnm, "Option__") or std.string.contains(frnm, "Result__"):
                                is_opt_res = true
                            safe_free_str(frnm)
                        if is_opt_res:
                            // Exclude a bare TYPE-NAME receiver (`Option.None`, qualified form):
                            // its first_child ident binds to a type symbol, not a value.
                            mut is_typename := false
                            let rcn = self.tree.nodes.data[frecv as i64]
                            if rcn.kind == NODE_IDENT or rcn.kind == NODE_TYPE_EXPR:
                                let rcsym = rcn.payload
                                if rcsym != 0 as u32 and (rcsym as i64) < self.symtable.symbols.len:
                                    let rck = self.symtable.symbols.data[rcsym as i64].kind
                                    if rck == SYM_STRUCT or rck == SYM_TYPE_ALIAS or rck == SYM_INTERFACE or rck == SYM_BUILTIN_TYPE:
                                        is_typename = true
                            if not is_typename:
                                let ufn = self.intern.get(fnode.payload)
                                ax_printf_local("error: cannot access field '%s' on an Option/Result value; unwrap it first (.unwrap() or match) before accessing the payload\n", get_str_ptr(ufn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                safe_free_str(ufn)
                                self.diags_count = self.diags_count + 1 as i64
            fi2 = fi2 + 1
        @free(callee_bm as ptr[u8])

pub fn get_full_mangled_name(self: ptr[TypeChecker], sym_idx: u32) -> str:
    let sym = self.symtable.symbols.data[sym_idx]
    let sym_name = self.intern.get(sym.name_id)
    
    let lazy_ptr = self.symtable.lazy_resolver as ptr[LazyResolver]
    if lazy_ptr != null as ptr[LazyResolver]:
        let mod = lazy_resolver_find_module_of_symbol(lazy_ptr, sym_idx)
        if mod != null as ptr[ModuleInfo]:
            let mod_name = self.intern.get(mod.name_id)
            let full_name = std.string.concat(mod_name, std.string.concat(".", sym_name))
            safe_free_str(mod_name)
            safe_free_str(sym_name)
            return full_name
            
    return sym_name

pub fn pre_infer_type_alias(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        if sym.type_id == 0 as u32:
            mut sum_node := 0 as u32
            mut child := self.tree.nodes.data[node_idx].first_child
            while child != 0 as u32:
                let child_node = self.tree.nodes.data[child]
                if child_node.kind == NODE_SUM_TYPE:
                    sum_node = child
                    break
                child = child_node.next_sibling
            
            if sum_node != 0 as u32:
                mut variants := new_variant_info_vec()
                mut tag := 0 as u8
                // The names Some/None (Ok/Err) are reserved for the builtin Option
                // (Result) sum: the CONSTRUCTOR always lowers those tokens to the
                // pointer-tagged builtin layout (null / box|1), regardless of any user
                // sum declaring them. A user sum reusing such a name would therefore get
                // a MIXED representation (its other variants tag-at-field-0, the shadowed
                // one builtin) and silently miscompile on match. Reject it (rename the
                // variant); full support would need type-directed construction (RFC).
                let sum_base_nm = extract_qualified_base_name(self.intern.get(sym.name_id))
                let sum_is_builtin = sum_base_nm == "Option" or sum_base_nm == "Result"
                mut v_node := self.tree.nodes.data[sum_node].first_child
                while v_node != 0 as u32:
                    let v_node_struct = self.tree.nodes.data[v_node]
                    let next_sibling = v_node_struct.next_sibling
                    if v_node_struct.kind == NODE_VARIANT_DECL:
                        let v_sym_idx = v_node_struct.payload
                        if v_sym_idx != 0 as u32:
                            let v_sym = self.symtable.symbols.data[v_sym_idx]
                            if not sum_is_builtin:
                                let vnm = self.intern.get(v_sym.name_id)
                                if vnm == "Some" or vnm == "None" or vnm == "Ok" or vnm == "Err":
                                    ax_printf_local("error: sum variant '%s' shadows a builtin Option/Result variant; rename it (Some/None are reserved for Option, Ok/Err for Result)\n", get_str_ptr(vnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    self.diags_count = self.diags_count + 1 as i64
                            
                            mut payload_type := TYPE_UNKNOWN
                            let type_expr_node = v_node_struct.first_child
                            if type_expr_node != 0 as u32:
                                let first_pl_ty = self.infer_node(type_expr_node, TYPE_UNKNOWN)
                                // RFC 0019: desugar a payload into a SYNTHESIZED struct when it is
                                // (a) MULTI-field (`Rect(i64,i64)`), or (b) a SINGLE >8-byte primitive
                                // like `str` — the sum box has a fixed 8-byte payload slot, so a 16-byte
                                // str stored inline overflows/truncates (returned 0). Wrapping makes the
                                // payload an 8-byte struct POINTER that fits, reusing the proven
                                // single-struct-payload path. Scalars (<=8B) and existing aggregate
                                // payloads stay as-is. The synth struct is flagged (flags bit 0) so the
                                // constructor/match know to gather/split its fields.
                                mut do_wrap := self.tree.nodes.data[type_expr_node].next_sibling != 0 as u32
                                if not do_wrap and first_pl_ty != TYPE_UNKNOWN and (first_pl_ty as i64) < self.types.entries.len:
                                    let fe = self.types.entries.data[first_pl_ty as i64]
                                    if fe.kind == TYPE_KIND_PRIMITIVE and fe.size > 8 as u32:
                                        do_wrap = true
                                if do_wrap:
                                    mut synth_fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
                                    mut ptn := type_expr_node
                                    mut fidx := 0 as i64
                                    while ptn != 0 as u32:
                                        let ft = self.infer_node(ptn, TYPE_UNKNOWN)
                                        let fn_str = std.string.concat("_f", format_int(fidx))
                                        let fname_id = self.intern.intern(fn_str)
                                        safe_free_str(fn_str)
                                        (&synth_fields).push(StructField(name_id: fname_id, type_id: ft))
                                        ptn = self.tree.nodes.data[ptn].next_sibling
                                        fidx = fidx + 1 as i64
                                    let sumnm = self.intern.get(sym.name_id)
                                    let vnm = self.intern.get(v_sym.name_id)
                                    let synth_nm = std.string.concat("__mfv_", std.string.concat(sumnm, std.string.concat("_", vnm)))
                                    let synth_nm_id = self.intern.intern(synth_nm)
                                    safe_free_str(synth_nm)
                                    safe_free_str(sumnm)
                                    safe_free_str(vnm)
                                    payload_type = self.types.register_struct(synth_nm_id, synth_fields)
                                    // Flag the synth struct (bit 0) so lowering routes it through the
                                    // gather/split path even for a single field.
                                    if (payload_type as i64) < self.types.entries.len:
                                        self.types.entries.data[payload_type as i64].flags = self.types.entries.data[payload_type as i64].flags | 1 as u16
                                else:
                                    payload_type = first_pl_ty

                            variants.push(VariantInfo(
                                name_id: v_sym.name_id,
                                payload_type: payload_type,
                                tag: tag,
                                padding1: 0 as u8,
                                padding2: 0 as u16,
                            ))
                            tag = tag + 1 as u8
                    v_node = next_sibling
                
                let type_id = self.types.register_sum_type(sym.name_id, variants)
                self.symtable.symbols.data[sym_idx].type_id = type_id
                self.set_node_type(node_idx, type_id)
                
                // Assign sum type TypeID to each variant symbol
                v_node = self.tree.nodes.data[sum_node].first_child
                while v_node != 0 as u32:
                    let v_node_struct = self.tree.nodes.data[v_node]
                    if v_node_struct.kind == NODE_VARIANT_DECL:
                        let v_sym_idx = v_node_struct.payload
                        if v_sym_idx != 0 as u32:
                            self.symtable.symbols.data[v_sym_idx].type_id = type_id
                    v_node = v_node_struct.next_sibling

pub fn pre_infer_struct(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        mut fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind == NODE_FIELD_DECL:
                let f_sym_idx = child_node.payload
                if f_sym_idx != 0 as u32:
                    let f_sym = self.symtable.symbols.data[f_sym_idx]
                    let f_type_node = child_node.first_child
                    mut f_type_id := TYPE_UNKNOWN
                    if f_type_node != 0 as u32:
                        f_type_id = self.infer_node(f_type_node, TYPE_UNKNOWN)
                    self.symtable.symbols.data[f_sym_idx].type_id = f_type_id
                    // A field whose type is the struct ITSELF, by value, gives the struct
                    // infinite size and CRASHES codegen (no diagnostic). Reject (BUG#53):
                    // a recursive field must go through a pointer. `ptr[S]` resolves to a
                    // POINTER type (!= the struct's own type_id), so it is correctly allowed.
                    if sym.type_id != 0 as u32 and f_type_id == sym.type_id:
                        ax_printf_local("error: recursive struct field of its own type has infinite size; use `ptr[...]` for the recursive field\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    fields.push(StructField(name_id: f_sym.name_id, type_id: f_type_id))

            child = next_sibling
        
        let struct_name = self.intern.get(sym.name_id)
        ax_printf_local("[TC-DEBUG] pre_infer_struct name: %s fields_found=%d type_id=%d sym_idx=%d\n", get_str_ptr(struct_name) as i64, fields.len, sym.type_id as i64, sym_idx as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        let type_id = sym.type_id
        if type_id == 0 as u32:
            let struct_type_id = self.types.register_struct(sym.name_id, fields)
            self.symtable.symbols.data[sym_idx].type_id = struct_type_id
            self.set_node_type(node_idx, struct_type_id)
        else:
            let entry = self.types.entries.data[type_id as i64]
            mut struct_extra := entry.extra
            if entry.kind == TYPE_KIND_GENERIC_INST:
                mut idx := 0 as i64
                while idx < self.types.entries.len:
                    let e = self.types.entries.data[idx]
                    let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                    let entry_base = extract_qualified_base_name(self.intern.get(entry.name_id))
                    let name_match = (e_base == entry_base)
                    if e.kind == TYPE_KIND_STRUCT and name_match:
                        struct_extra = e.extra
                        break
                    idx = idx + 1
            let in_bounds = ((struct_extra as i64) < self.types.structs.len)
            ax_printf_local("[TC-DEBUG] pre_infer_struct else: %s struct_extra=%d len=%d in_bounds=%d kind=%d\n", get_str_ptr(struct_name) as i64, struct_extra as i64, self.types.structs.len, in_bounds as i64, entry.kind as i64, 0 as i64, 0 as i64, 0 as i64)
            if (entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST) and (struct_extra as i64) < self.types.structs.len:
                let prev_generic_args = self.types.structs.data[struct_extra as i64].generic_args
                self.types.structs.data[struct_extra as i64] = StructInfo(fields: fields, generic_args: prev_generic_args)
                let check_si = self.types.structs.data[struct_extra as i64]
                ax_printf_local("[TC-DEBUG] post-assign: checked fields_len=%d\n", check_si.fields.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            self.set_node_type(node_idx, type_id)

// Is `k` a type-annotation node kind (a node that `infer_node` resolves to a type)?
// `[T;N]` (NODE_ARRAY_TYPE), `[T]` (NODE_SLICE_TYPE), `*T` (NODE_PTR_TYPE) and
// `fn(..)->..` (NODE_FUNC_TYPE) are genuine type annotations, but earlier code only
// tested NODE_TYPE_EXPR/NODE_GENERIC_TYPE. In a `fn f() -> [T;N]` return position or a
// `let a: [T;N] = ..` annotation those bracket/star/fn forms were dropped -> the return
// type silently became VOID / the let annotation was ignored, so an array literal was
// never coerced to the declared element type (a `[i32;N]` value then flowed into a
// `[i64;N]` slot -> wrong OP_INDEX stride -> silent miscompile). Centralize the test.
pub fn is_type_annotation_node(k: u8) -> bool:
    return k == NODE_TYPE_EXPR or k == NODE_GENERIC_TYPE or k == NODE_ARRAY_TYPE or k == NODE_SLICE_TYPE or k == NODE_PTR_TYPE or k == NODE_FUNC_TYPE or k == NODE_TUPLE_TYPE

// RFC 0022: register the anonymous struct type backing a tuple. Shared by the tuple
// LITERAL (NODE_TUPLE_EXPR) and the tuple TYPE annotation (NODE_TUPLE_TYPE) so both
// produce the SAME struct type with positional fields `_f0.._fN`. `first` is the
// node's first child (element expr or element type-expr respectively).
//
// Tuple types are CANONICALIZED (structural): two tuples with identical element types
// resolve to the same type id, so a tuple literal and a matching `(T0,T1)` annotation
// on a `let`/param/return/global are the SAME type — without this they were distinct
// struct ids and the value crossed a broken copy/coercion boundary that dropped fields
// (second element read as 0). The lookup is guarded to structs whose name begins with
// `__tup`, so it never collides with RFC 0019's `__mfv_` variant-payload synth structs
// (which also use `_f0..` field names). All element type ids are themselves canonical
// (nested tuples canonicalize recursively via infer_node), so ordered type-id equality
// is a sound structural test.
pub fn register_tuple_type(mut self: ptr[TypeChecker], first: u32) -> u32:
    mut elem_types := new_u32_vec()
    mut child := first
    while child != 0 as u32:
        (&elem_types).push(self.infer_node(child, TYPE_UNKNOWN))
        child = self.tree.nodes.data[child].next_sibling

    // Canonical lookup: reuse an existing `__tup` struct with identical field types.
    mut ti := 0 as i64
    while ti < self.types.entries.len:
        let e = self.types.entries.data[ti]
        if e.kind == TYPE_KIND_STRUCT:
            let nm = self.intern.get(e.name_id)
            let is_tup = std.string.starts_with(nm, "__tup")
            safe_free_str(nm)
            if is_tup and (e.extra as i64) < self.types.structs.len:
                let sinfo = self.types.structs.data[e.extra as i64]
                if sinfo.fields.len == elem_types.len:
                    mut all_match := true
                    mut j := 0 as i64
                    while j < elem_types.len:
                        if sinfo.fields.data[j].type_id != elem_types.data[j]:
                            all_match = false
                            break
                        j = j + 1 as i64
                    if all_match:
                        if elem_types.data != null as ptr[u32]:
                            @free(elem_types.data as ptr[u8])
                        return ti as u32
        ti = ti + 1 as i64

    // Not found: register a fresh `__tupN` struct with fields `_f0.._fN`.
    mut synth_fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
    mut fi := 0 as i64
    while fi < elem_types.len:
        let fn_str = std.string.concat("_f", format_int(fi))
        let fname_id = self.intern.intern(fn_str)
        safe_free_str(fn_str)
        (&synth_fields).push(StructField(name_id: fname_id, type_id: elem_types.data[fi]))
        fi = fi + 1 as i64
    let synth_nm = std.string.concat("__tup", format_int(elem_types.len))
    let synth_nm_id = self.intern.intern(synth_nm)
    safe_free_str(synth_nm)
    if elem_types.data != null as ptr[u32]:
        @free(elem_types.data as ptr[u8])
    return self.types.register_struct(synth_nm_id, synth_fields)

pub fn pre_infer_func_signature(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    mut has_existing := false
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        if sym.type_id != 0 as u32:
            let entry = self.types.entries.data[sym.type_id]
            if entry.kind == TYPE_KIND_FUNC:
                has_existing = true
    
    if not has_existing:
        mut param_types := new_u32_vec()
        mut ret_type := TYPE_UNKNOWN
        mut has_ret_expr := false
        
        let node = self.tree.nodes.data[node_idx]
        // Self type (RFC): a `-> Self` return on a free-function method resolves to the
        // type of the `self` (first) parameter. AXIOM methods are free functions with a
        // `self` param, so there is no interface/impl scope binding `Self` here; without
        // this, `Self` stays TYPE_UNKNOWN and a method call ON a Self-returning result
        // (`c.inc().inc()`) mis-dispatches and segfaults.
        mut first_is_self := false
        mut param_count := 0 as i64
        mut child := node.first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind == NODE_PARAM_DECL:
                let p_type = self.infer_node(child, TYPE_UNKNOWN)
                if param_count == 0 as i64 and child_node.payload != 0 as u32 and (child_node.payload as i64) < self.symtable.symbols.len:
                    let pnm = self.intern.get(self.symtable.symbols.data[child_node.payload as i64].name_id)
                    if pnm == "self":
                        first_is_self = true
                    safe_free_str(pnm)
                param_types.push(p_type)
                param_count = param_count + 1 as i64
            elif is_type_annotation_node(child_node.kind):
                mut is_self_ret := false
                if first_is_self and param_types.len > 0:
                    let rtext = self.node_text(child)
                    if rtext == "Self":
                        is_self_ret = true
                    safe_free_str(rtext)
                if is_self_ret:
                    ret_type = param_types.data[0]
                else:
                    ret_type = self.infer_node(child, TYPE_UNKNOWN)
                has_ret_expr = true
            child = next_sibling
            
        if not has_ret_expr:
            mut is_main := false
            if sym_idx != 0 as u32:
                let name_id = self.symtable.symbols.data[sym_idx].name_id
                let text = self.intern.get(name_id)
                if text == "main":
                    is_main = true
            if is_main:
                ret_type = TYPE_I32
            else:
                ret_type = TYPE_VOID
        
        let func_type_id = self.types.register_function(param_types, ret_type)
        if sym_idx != 0 as u32:
            self.symtable.symbols.data[sym_idx].type_id = func_type_id
        self.set_node_type(node_idx, func_type_id)

// RFC 0005: a concrete numeric scalar type (int family or float family). Used to
// decide whether a bare integer literal operand may adopt the other operand's type.
pub fn tc_is_numeric(t: u32) -> bool:
    return t == TYPE_I8 or t == TYPE_I16 or t == TYPE_I32 or t == TYPE_I64 or t == TYPE_U8 or t == TYPE_U16 or t == TYPE_U32 or t == TYPE_U64 or t == TYPE_F32 or t == TYPE_F64 or t == TYPE_ISIZE or t == TYPE_USIZE

// True iff `t` is an Option or Result value. Option[T]/Result[T,E] desugar to a
// SUM (kind 6) whose mangled name base is "Option"/"Result" (e.g.
// `_AX_std_Option__i64`), so that is the PRIMARY case; also accept the dedicated
// OPTION/RESULT kinds (11/12) and a GENERIC_INST/STRUCT with the same base name.
// Base-name matching cleanly EXCLUDES the explicit-generic-call `f[T](..)` result
// mis-inference (a GENERIC_INST named after the fn, e.g. "hash_key", so
// `hash_key[K](k) % cap` — really u64 — is NOT flagged). Used to reject arithmetic
// on an un-unwrapped Option/Result (BUG#53 class: adding two box values = garbage).
pub fn tc_is_opt_res(self: ptr[TypeChecker], t: u32) -> bool:
    if (t as i64) >= self.types.entries.len:
        return false
    let e = self.types.entries.data[t as i64]
    if e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
        return true
    if (e.kind == TYPE_KIND_SUM or e.kind == TYPE_KIND_GENERIC_INST or e.kind == TYPE_KIND_STRUCT) and e.name_id != 0 as u32:
        let mn = self.intern.get(e.name_id)
        let bn = extract_base_name(mn)
        let r = (bn == "Option" or bn == "Result")
        safe_free_str(mn)
        safe_free_str(bn)
        return r
    return false

// Shared generic-instantiation core: given a generic template symbol `sym_idx`
// and a fully-collected `args` vector of concrete type-ids, produce the result
// TypeID for that instantiation. TAKES OWNERSHIP of `args` (either handed to
// register_generic_inst, which stores/frees it, or freed here after the mono
// path). This is the exact logic the explicit `Name[T,U]` annotation path used
// (NODE_GENERIC_TYPE below); it is factored out so the BUG#74 inferred-arg
// struct-constructor path (`Name(field: v, ...)` with no explicit type args) can
// run the IDENTICAL monomorphization -- producing the SAME packed concrete struct
// layout a generic function's param would monomorphize to, which is what keeps
// construction and later field reads on one consistent layout.
pub fn finish_generic_instantiation(mut self: ptr[TypeChecker], sym_idx: u32, args: U32Vec) -> u32:
    mut result_type := TYPE_UNKNOWN
    let sym_name_id = self.symtable.symbols.data[sym_idx as i64].name_id
    mut has_generic_arg := false
    mut a_idx := 0 as i64
    while a_idx < args.len:
        if self.is_generic(args.data[a_idx]):
            has_generic_arg = true
            break
        a_idx = a_idx + 1

    if has_generic_arg:
        result_type = self.types.register_generic_inst(sym_name_id, args)
    else:
        // Check if already instantiated
        mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
        let mangled_name = mono.mangle_name_ov(sym_idx, self.intern.get(sym_name_id), args)
        let mangled_id = self.intern.intern(mangled_name)
        mut existing_sym_idx := self.symtable.resolve(mangled_id)
        if existing_sym_idx == 0 as u32:
            let proxy_sys_idx = self.symtable.resolve_global(mangled_id)
            existing_sym_idx = proxy_sys_idx

        mut inst_sym_idx := 0 as u32
        mut fresh_type_alias_inst := false
        if existing_sym_idx != 0 as u32:
            inst_sym_idx = existing_sym_idx
        else:
            // Instantiate!
            let cloned_root = mono.instantiate_function(sym_idx, args)
            self.tree.append_child(0 as u32, cloned_root)

            // Name resolution on the cloned subtree
            let saved_data = self.symtable.stack.data
            let saved_len = self.symtable.stack.len
            let saved_cap = self.symtable.stack.cap
            mut temp_stack := new_u32_vec()
            temp_stack.push(0 as u32)
            if saved_len > 1:
                temp_stack.push(saved_data[1])
            self.symtable.stack = temp_stack
            mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
            resolver.resolve_node(cloned_root)
            @free(self.symtable.stack.data as ptr[u8])
            self.symtable.stack.data = saved_data
            self.symtable.stack.len = saved_len
            self.symtable.stack.cap = saved_cap

            let payload_sym = self.tree.nodes.data[cloned_root].payload
            if payload_sym != 0 as u32:
                inst_sym_idx = payload_sym
            else:
                mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                if resolved_inst_sym == 0 as u32:
                    resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                inst_sym_idx = resolved_inst_sym

            let cloned_kind = self.tree.nodes.data[cloned_root].kind
            if cloned_kind == NODE_STRUCT_DECL and mono.struct_type_id != 0 as u32:
                self.symtable.symbols.data[inst_sym_idx as i64].type_id = mono.struct_type_id

            // Register type/signature in TypeTable
            if cloned_kind == NODE_STRUCT_DECL:
                self.pre_infer_struct(cloned_root)

                // Pre-infer signatures for all methods of the struct
                mut m_child := self.tree.nodes.data[cloned_root].first_child
                while m_child != 0 as u32:
                    let mc = self.tree.nodes.data[m_child]
                    let next_sibling = mc.next_sibling
                    if mc.kind == NODE_FUNC_DECL:
                        self.pre_infer_func_signature(m_child)
                    m_child = next_sibling

                self.infer_node(cloned_root, TYPE_UNKNOWN)
            elif cloned_kind == NODE_FUNC_DECL:
                self.pre_infer_func_signature(cloned_root)
                self.infer_node(cloned_root, TYPE_UNKNOWN)
            elif cloned_kind == NODE_TYPE_ALIAS_DECL:
                self.pre_infer_type_alias(cloned_root)
                mut m_child := self.tree.nodes.data[cloned_root].first_child
                while m_child != 0 as u32:
                    let mc = self.tree.nodes.data[m_child]
                    let next_sibling = mc.next_sibling
                    if mc.kind == NODE_FUNC_DECL:
                        self.pre_infer_func_signature(m_child)
                    m_child = next_sibling
                self.infer_node(cloned_root, TYPE_UNKNOWN)
                fresh_type_alias_inst = true

        let inst_sym = self.symtable.symbols.data[inst_sym_idx as i64]
        result_type = inst_sym.type_id

        // BUG#67 follow-up: record the concrete args on the monomorphized sum
        // type (e.g. Option[Vec[i64]]) itself, so get_generic_args() on it
        // doesn't have to re-derive them from the clone's mangled name.
        if fresh_type_alias_inst:
            self.types.set_sum_generic_args(result_type, args)

        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
    return result_type

pub fn infer_node(mut self: ptr[TypeChecker], node_idx: u32, expected: u32) -> u32:
    if node_idx == 0 as u32:
        if self.tree.nodes.len == 0 as i64:
            return TYPE_UNKNOWN
        if self.tree.nodes.data[0].kind == 0 as u8: // NODE_INVALID
            return TYPE_UNKNOWN

    let kind = self.tree.nodes.data[node_idx].kind
    let flags = self.tree.nodes.data[node_idx].flags
    mut result_type := TYPE_UNKNOWN
    
    if kind == NODE_PROGRAM or kind == NODE_BLOCK or kind == NODE_UNSAFE_BLOCK or kind == NODE_ARENA_BLOCK:
        // unsafe/arena: recurse into the inner block (their only child) so the
        // body is typechecked (#38.5/#38.6).
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            self.infer_node(child, TYPE_UNKNOWN)
            child = self.tree.nodes.data[child].next_sibling
            
    elif kind == NODE_FUNC_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        mut ret_type := TYPE_UNKNOWN
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            if sym.type_id != 0 as u32:
                let entry = self.types.entries.data[sym.type_id]
                if entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[entry.extra]
                    ret_type = fi.ret
                    result_type = sym.type_id
        
        let prev_ret = self.current_return
        self.current_return = ret_type
        let prev_fn_generic = self.current_fn_is_generic
        self.current_fn_is_generic = (self.tree.nodes.data[node_idx].flags & FLAG_IS_GENERIC) != 0 as u16

        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_PARAM_DECL and child_node.kind != NODE_TYPE_EXPR:
                self.infer_node(child, TYPE_UNKNOWN)
            child = next_sibling

        self.current_return = prev_ret
        self.current_fn_is_generic = prev_fn_generic

        // Missing-return check (BUG#53 family): a non-void function whose body can
        // fall off the end returns a garbage register silently. Diagnose it. Only
        // checked when the return type resolved to a concrete non-void type, so
        // unresolved generics are conservatively skipped (never a false positive).
        if ret_type != TYPE_UNKNOWN and ret_type != TYPE_VOID:
            let body_blk = self.tc_func_body(node_idx)
            if body_blk != 0 as u32:
                if not self.stmt_terminates(body_blk):
                    mut fname := "?"
                    if sym_idx != 0 as u32:
                        let nid = self.symtable.symbols.data[sym_idx].name_id
                        if nid != 0 as u32:
                            fname = self.intern.get(nid)
                    ax_printf_local("error: function '%s' can reach the end of its body without returning a value; add an explicit `return` (AXIOM has no implicit last-expression return)\n", get_str_ptr(fname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_CLOSURE_EXPR:
        // RFC 0008: a lambda-lifted closure reference — its payload is the resolved
        // symbol index of the synthesized top-level function (set by the resolver).
        // That function's signature was already registered by the
        // pre_infer_func_signature pre-pass, so report its concrete fn type here.
        // Without this, an inline lambda argument inferred as UNKNOWN and a generic
        // callee (e.g. `Option.map` / `apply[T,U](x, f: fn(T)->U)`) failed to
        // monomorphize (unresolved external). Pairs with the NODE_FUNC_TYPE branch
        // in infer_generic_type_args, which reads this fn type to resolve T/U.
        let cl_sym = self.tree.nodes.data[node_idx].payload
        if cl_sym != 0 as u32 and (cl_sym as i64) < self.symtable.symbols.len:
            result_type = self.symtable.symbols.data[cl_sym as i64].type_id

    elif kind == NODE_STRUCT_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        if sym_idx != 0 as u32:
            result_type = self.symtable.symbols.data[sym_idx].type_id
            
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_FIELD_DECL:
                self.infer_node(child, TYPE_UNKNOWN)
            child = next_sibling

    elif kind == NODE_TYPE_ALIAS_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        if sym_idx != 0 as u32:
            result_type = self.symtable.symbols.data[sym_idx].type_id
        
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_SUM_TYPE:
                self.infer_node(child, TYPE_UNKNOWN)
            child = next_sibling

    elif kind == NODE_PARAM_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        mut p_type := TYPE_UNKNOWN
        let type_node = self.tree.nodes.data[node_idx].first_child
        if type_node != 0 as u32:
            p_type = self.infer_node(type_node, TYPE_UNKNOWN)
        if sym_idx != 0 as u32:
            self.symtable.symbols.data[sym_idx].type_id = p_type
        result_type = p_type
        
    elif kind == NODE_VAR_DECL or kind == NODE_CONST_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        mut exp_type := TYPE_UNKNOWN
        if sym_idx != 0 as u32:
            exp_type = self.symtable.symbols.data[sym_idx].type_id
            
        mut type_node := 0 as u32
        mut init_expr := 0 as u32
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            if is_type_annotation_node(child_node.kind):
                type_node = child
            else:
                init_expr = child
            child = child_node.next_sibling
            
        if type_node != 0 as u32:
            exp_type = self.infer_node(type_node, TYPE_UNKNOWN)
            if sym_idx != 0 as u32:
                self.symtable.symbols.data[sym_idx].type_id = exp_type
                
        if init_expr != 0 as u32:
            let inferred := self.infer_node(init_expr, exp_type)
            // BUG#53 (m5): an explicit `let x: T = <literal>` whose literal is a
            // string but T is a numeric scalar (or a numeric literal assigned to a
            // str/bytes T) is silently accepted, then miscompiled to garbage (the
            // {ptr,len} str repr reinterpreted as an int, or vice-versa). Reject
            // that genuinely-incompatible pair. Gated on the RHS LITERAL node kind
            // (a string/int/float literal has an unambiguous type) rather than the
            // inferred type, because infer_node is imprecise for some str-returning
            // CALLs (reports i64) and trusting it over-rejected valid compiler
            // source. The language's real literal/width coercions (int-lit -> any
            // int width, float-lit -> f32/f64) stay untouched. See
            // [[bug-malformed-input-robustness-cluster]] (m5).
            if type_node != 0 as u32 and exp_type != TYPE_UNKNOWN:
                let rhs_kind = self.tree.nodes.data[init_expr].kind
                let exp_is_str = exp_type == TYPE_STRING or exp_type == TYPE_BYTES
                let exp_is_num = exp_type >= TYPE_I8 and exp_type <= TYPE_USIZE and exp_type != TYPE_STRING and exp_type != TYPE_VOID
                let rhs_is_strlit = rhs_kind == NODE_STRING_LIT
                let rhs_is_numlit = rhs_kind == NODE_INT_LIT or rhs_kind == NODE_FLOAT_LIT
                if (exp_is_num and rhs_is_strlit) or (exp_is_str and rhs_is_numlit):
                    ax_printf_local("error: type mismatch in `let`: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            if exp_type != TYPE_UNKNOWN:
                result_type = exp_type
            else:
                result_type = inferred
                if sym_idx != 0 as u32:
                    self.symtable.symbols.data[sym_idx].type_id = inferred
        else:
            result_type = exp_type
            
    elif kind == NODE_RETURN_STMT:
        let expr = self.tree.nodes.data[node_idx].first_child
        if expr != 0 as u32:
            let et_ret = self.infer_node(expr, self.current_return)
            // BUG#53 (m5agg): `return <aggregate variable>` from a NUMERIC-returning fn
            // (`return p` where p is a struct, fn is `-> i64`) was silently accepted --
            // the aggregate's address was returned as an int -> garbage for the caller.
            // Reject. Gated on the return expr being a bare NODE_IDENT (a variable, whose
            // declared aggregate type is reliable) so an imprecisely-inferred call result
            // is never mis-rejected. Only fires numeric-return vs aggregate-value; struct
            // -> struct and scalar -> scalar returns are untouched.
            if self.current_return != TYPE_UNKNOWN and self.tree.nodes.data[expr].kind == NODE_IDENT and et_ret != TYPE_UNKNOWN and (et_ret as i64) < self.types.entries.len:
                let ce_num = self.current_return >= TYPE_I8 and self.current_return <= TYPE_USIZE and self.current_return != TYPE_STRING and self.current_return != TYPE_VOID
                let ek = self.types.entries.data[et_ret as i64].kind
                let e_agg = ek == TYPE_KIND_STRUCT or ek == TYPE_KIND_SUM or ek == TYPE_KIND_ARRAY or ek == TYPE_KIND_OPTION or ek == TYPE_KIND_RESULT
                if ce_num and e_agg:
                    ax_printf_local("error: type mismatch in `return`: cannot return an aggregate value from a function with a numeric return type\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // BUG#53 (return-path analog of m5): `return <string literal>` from a
            // numeric-returning fn (or a numeric literal from a str/bytes-returning
            // fn) was silently accepted then miscompiled to garbage. Reject the
            // genuinely-incompatible str<->numeric pair. Gated on the return expr's
            // LITERAL node kind (unambiguous type), NOT the inferred type, because
            // infer is imprecise for str-returning CALLs (same reasoning as m5) --
            // so real coercions and value returns are untouched.
            let rk = self.tree.nodes.data[expr].kind
            let rt = self.current_return
            if rt != TYPE_UNKNOWN:
                let ret_is_str = rt == TYPE_STRING or rt == TYPE_BYTES
                let ret_is_num = rt >= TYPE_I8 and rt <= TYPE_USIZE and rt != TYPE_STRING and rt != TYPE_VOID
                let e_strlit = rk == NODE_STRING_LIT
                let e_numlit = rk == NODE_INT_LIT or rk == NODE_FLOAT_LIT
                if (ret_is_num and e_strlit) or (ret_is_str and e_numlit):
                    ax_printf_local("error: type mismatch in `return`: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_DEFER_STMT:
        // #38.4: typecheck the deferred expression so its node_types are
        // populated for codegen (it runs at scope exit, not here).
        let expr = self.tree.nodes.data[node_idx].first_child
        if expr != 0 as u32:
            self.infer_node(expr, TYPE_UNKNOWN)

    elif kind == NODE_MATCH_STMT:
        let scrutinee = self.tree.nodes.data[node_idx].first_child
        if scrutinee != 0 as u32:
            let scrutinee_type = self.infer_node(scrutinee, TYPE_UNKNOWN)
            let prev_scrutinee = self.current_match_scrutinee
            self.current_match_scrutinee = scrutinee_type
            
            mut arm := self.tree.nodes.data[scrutinee].next_sibling
            mut arm_type := TYPE_UNKNOWN
            while arm != 0 as u32:
                let t = self.infer_node(arm, expected)
                if arm_type == TYPE_UNKNOWN:
                    arm_type = t
                arm = self.tree.nodes.data[arm].next_sibling

            self.current_match_scrutinee = prev_scrutinee
            result_type = arm_type

            // Mark confirmed non-exhaustive matches so the missing-return terminator
            // analysis knows this match can fall through (used only for that check;
            // AXIOM permits non-exhaustive matches to fall through at runtime).
            if self.match_is_confidently_partial(node_idx, scrutinee_type):
                self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | FLAG_MATCH_PARTIAL

    elif kind == NODE_MATCH_ARM:
        let pattern = self.tree.nodes.data[node_idx].first_child
        mut body := 0 as u32
        if pattern != 0 as u32:
            body = self.tree.nodes.data[pattern].next_sibling
            
        let scrutinee_type = self.current_match_scrutinee
        if scrutinee_type != TYPE_UNKNOWN:
            let s_entry = self.types.entries.data[scrutinee_type]
            // A variant pattern (Some/None/Ok/Err/user variant) requires a sum-like
            // scrutinee. On a non-sum (a scalar/struct/pointer, e.g. `match an_i64: Some(v):`)
            // the payload never binds and the arm body reads uninitialized memory -> segfault.
            // Reject (BUG#53). OPTION/RESULT/SUM/GENERIC_INST are the sum-like kinds handled
            // below (a generic-inst may be an Option[T]/user-sum instance). See
            // [[bug-malformed-input-robustness-cluster]] (m4).
            if pattern != 0 as u32 and self.tree.nodes.data[pattern].kind == NODE_VARIANT_PAT:
                if not (s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT or s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST):
                    ax_printf_local("error: cannot match a value of a non-sum type against a variant pattern (Some/None/Ok/Err/...)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            if s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT:
                // OPTION/RESULT (kind 11/12) have NO sumtypes entry -- `.extra` is the
                // inner/ok TYPE id, not a sumtypes index -- so the SUM path below would
                // read a garbage `variants` pointer and crash (surfaces when a match
                // scrutinee is actually typed OPTION, e.g. `match arr[i]` on `[Option;N]`).
                // Resolve the pattern payload DIRECTLY from the entry, mirroring
                // air_builder's kind-11/12 local match lowering: Some(v)/Ok(v) bind the
                // inner/ok type (`.extra`), Err(e) binds the err type (`.name_id`), None
                // binds nothing, and a bare binding binds the whole Option/Result value.
                if pattern != 0 as u32:
                    let pat_node = self.tree.nodes.data[pattern]
                    if pat_node.kind == NODE_VARIANT_PAT:
                        let arg = pat_node.first_child
                        if arg != 0 as u32 and self.tree.nodes.data[arg].kind == NODE_BINDING_PAT:
                            let arg_sym_idx = self.tree.nodes.data[arg].payload
                            mut pl := s_entry.extra
                            if s_entry.kind == TYPE_KIND_RESULT:
                                let v_sym_idx = pat_node.payload
                                if v_sym_idx != 0 as u32 and (v_sym_idx as i64) < self.symtable.symbols.len:
                                    let vnm = self.intern.get(self.symtable.symbols.data[v_sym_idx].name_id)
                                    if vnm == "Err":
                                        pl = s_entry.name_id
                            if arg_sym_idx != 0 as u32:
                                self.symtable.symbols.data[arg_sym_idx].type_id = pl
                                self.set_node_type(arg, pl)
                    elif pat_node.kind == NODE_BINDING_PAT:
                        let b_sym_idx = pat_node.payload
                        if b_sym_idx != 0 as u32:
                            self.symtable.symbols.data[b_sym_idx].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)
            elif s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST:
                mut sum_extra := s_entry.extra
                if s_entry.kind == TYPE_KIND_GENERIC_INST:
                    mut idx := 0 as i64
                    while idx < self.types.entries.len:
                        let e = self.types.entries.data[idx]
                        let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                        let s_base = extract_qualified_base_name(self.intern.get(s_entry.name_id))
                        let name_match = (e_base == s_base)
                        if e.kind == TYPE_KIND_SUM and name_match:
                            sum_extra = e.extra
                            break
                        idx = idx + 1
                let sum_info = self.types.sumtypes.data[sum_extra]
                
                // Let's typecheck the pattern!
                if pattern != 0 as u32:
                    let pat_node = self.tree.nodes.data[pattern]
                    if pat_node.kind == NODE_VARIANT_PAT:
                        let v_sym_idx = pat_node.payload
                        if v_sym_idx != 0 as u32:
                            let v_sym = self.symtable.symbols.data[v_sym_idx]
                            
                            // Find corresponding variant in sum_info
                            mut payload_type := TYPE_UNKNOWN
                            mut found := false
                            mut j := 0 as i64
                            while j < sum_info.variants.len:
                                let v_info = sum_info.variants.data[j]
                                if v_info.name_id == v_sym.name_id:
                                    payload_type = v_info.payload_type
                                    found = true
                                    break
                                j = j + 1
                            
                            // Now assign payload type to binding patterns (which are children of NODE_VARIANT_PAT)
                            let arg = pat_node.first_child
                            // RFC 0019: a synthesized (flagged) payload struct — multi-field OR a
                            // single >8B primitive (str) wrap — binds each pattern var to its FIELD
                            // type, not the wrapper struct itself.
                            mut mf_struct_idx := -1 as i64
                            if arg != 0 as u32 and payload_type != TYPE_UNKNOWN and (payload_type as i64) < self.types.entries.len:
                                let pe = self.types.entries.data[payload_type as i64]
                                if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16:
                                    mf_struct_idx = pe.extra as i64
                            if mf_struct_idx >= 0 as i64:
                                mut ap := arg
                                mut afi := 0 as i64
                                while ap != 0 as u32:
                                    if self.tree.nodes.data[ap].kind == NODE_BINDING_PAT:
                                        let ap_sym = self.tree.nodes.data[ap].payload
                                        mut fld_ty := TYPE_UNKNOWN
                                        if mf_struct_idx < self.types.structs.len and afi < self.types.structs.data[mf_struct_idx].fields.len:
                                            fld_ty = self.types.structs.data[mf_struct_idx].fields.data[afi].type_id
                                        if ap_sym != 0 as u32:
                                            self.symtable.symbols.data[ap_sym].type_id = fld_ty
                                            self.set_node_type(ap, fld_ty)
                                    ap = self.tree.nodes.data[ap].next_sibling
                                    afi = afi + 1 as i64
                            elif arg != 0 as u32 and self.tree.nodes.data[arg].kind == NODE_BINDING_PAT:
                                let arg_sym_idx = self.tree.nodes.data[arg].payload
                                if arg_sym_idx != 0 as u32:
                                    self.symtable.symbols.data[arg_sym_idx].type_id = payload_type
                                    self.set_node_type(arg, payload_type)
                    elif pat_node.kind == NODE_BINDING_PAT:
                        let b_sym_idx = pat_node.payload
                        if b_sym_idx != 0 as u32:
                            self.symtable.symbols.data[b_sym_idx].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)
            else:
                // RFC 0006 (#38.2): C-switch (int/bool/char scrutinee). A bare
                // binding pattern binds the whole value; literal patterns need
                // no typing (they are constants compared against the scrutinee).
                if pattern != 0 as u32:
                    let pat_node_i = self.tree.nodes.data[pattern]
                    if pat_node_i.kind == NODE_BINDING_PAT:
                        let bsi2 = pat_node_i.payload
                        if bsi2 != 0 as u32:
                            self.symtable.symbols.data[bsi2].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)

        if body != 0 as u32:
            result_type = self.infer_node(body, expected)
        
    elif kind == NODE_IF_STMT:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.infer_node(cond, TYPE_BOOL)
            let then_branch = self.tree.nodes.data[cond].next_sibling
            if then_branch != 0 as u32:
                result_type = self.infer_node(then_branch, expected)
                mut sibling := self.tree.nodes.data[then_branch].next_sibling
                while sibling != 0 as u32:
                    self.infer_node(sibling, expected)
                    sibling = self.tree.nodes.data[sibling].next_sibling
                    
    elif kind == NODE_ELIF_CLAUSE:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.infer_node(cond, TYPE_BOOL)
            let body = self.tree.nodes.data[cond].next_sibling
            if body != 0 as u32:
                result_type = self.infer_node(body, expected)
                
    elif kind == NODE_ELSE_CLAUSE:
        let body = self.tree.nodes.data[node_idx].first_child
        if body != 0 as u32:
            result_type = self.infer_node(body, expected)

    elif kind == NODE_IF_EXPR:
        // RFC 0023: children are `cond0, then0, [condi, theni, ...], else` (flat).
        // Conds are the even-indexed children except the final one; the LAST child
        // is always the mandatory else value; odd-indexed children are then-values.
        let first = self.tree.nodes.data[node_idx].first_child
        // Locate the last child (the else value).
        mut last := first
        mut c := first
        while c != 0 as u32:
            last = c
            c = self.tree.nodes.data[c].next_sibling
        // Anchor result type: the caller's expected type if concrete, else infer the
        // else branch to anchor on it. Int literals coerce to the anchor via `expected`.
        mut anchor := expected
        mut else_done := false
        if anchor == TYPE_UNKNOWN and last != 0 as u32:
            anchor = self.infer_node(last, TYPE_UNKNOWN)
            else_done = true
        // Anchor storage width (bytes). A value branch whose storage width differs
        // from the anchor would miscompile the shared result slot (the value diamond
        // writes one fixed-width vreg on every path) -> reject (BUG#53 convention).
        // Width — not exact type_id — is the safety criterion: `if c: Some(x) else:
        // None` has two different type_ids but both are 8-byte pointer-repr and is
        // valid; `if c: 42 else: "no"` (8 vs 16) is the dangerous case caught here.
        mut anchor_size := 0 as u32
        if anchor != TYPE_UNKNOWN and (anchor as i64) < self.types.entries.len:
            mut aalign := 0 as u32
            builder_type_size_and_align(self.types, anchor, &anchor_size, &aalign)
        mut idx := 0 as i64
        c = first
        while c != 0 as u32:
            let nxt = self.tree.nodes.data[c].next_sibling
            mut bt := TYPE_UNKNOWN
            mut is_value := true
            if c == last:
                if else_done:
                    is_value = false
                else:
                    bt = self.infer_node(c, anchor)
            elif idx % 2 as i64 == 0 as i64:
                self.infer_node(c, TYPE_BOOL)
                is_value = false
            else:
                bt = self.infer_node(c, anchor)
            if is_value and bt != TYPE_UNKNOWN and (bt as i64) < self.types.entries.len:
                let bkind = self.types.entries.data[bt as i64].kind
                let akind = self.types.entries.data[anchor as i64].kind
                let b_optres = self.tc_is_opt_res(bt)
                let a_optres = self.tc_is_opt_res(anchor)
                // Box-repr types (Option/Result/user-sum/generic-inst) skip the width
                // check: their box lowering round-trips through the shared result slot
                // (a nullary variant and a payload variant report inconsistent sizes
                // through inference but are the same box value). Only plain
                // primitive/str/struct branches get the width-mismatch reject.
                let b_boxy = b_optres or bkind == TYPE_KIND_SUM or bkind == TYPE_KIND_OPTION or bkind == TYPE_KIND_RESULT or bkind == TYPE_KIND_GENERIC_INST
                let a_boxy = a_optres or akind == TYPE_KIND_SUM or akind == TYPE_KIND_OPTION or akind == TYPE_KIND_RESULT or akind == TYPE_KIND_GENERIC_INST
                if anchor_size != 0 as u32 and not a_boxy and not b_boxy:
                    // Plain primitive/str/struct branches: the shared result slot has a
                    // fixed width, so a branch of a different storage width would
                    // miscompile (`if c: 42 else: "no"` is 8 vs 16). Reject.
                    mut bsize := 0 as u32
                    mut balign := 0 as u32
                    builder_type_size_and_align(self.types, bt, &bsize, &balign)
                    if bsize != 0 as u32 and bsize != anchor_size:
                        ax_printf_local("error: if-expression branches have incompatible types (different storage widths)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
            idx = idx + 1 as i64
            c = nxt
        result_type = anchor

    elif kind == NODE_WHILE_STMT:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.infer_node(cond, TYPE_BOOL)
            let body = self.tree.nodes.data[cond].next_sibling
            if body != 0 as u32:
                self.infer_node(body, TYPE_UNKNOWN)

    elif kind == NODE_FOR_STMT:
        let iter_var = self.tree.nodes.data[node_idx].payload
        let range_expr = self.tree.nodes.data[node_idx].first_child
        // RFC 0018 P1: element type of the loop variable (default i32 for ranges /
        // integer bounds; overwritten to the array element type for `for x in arr`).
        mut for_elem_ty := TYPE_I32
        if range_expr != 0 as u32:
            let iteree_ty = self.infer_node(range_expr, TYPE_UNKNOWN)
            // BUG#87 follow-up: `for x in <collection>` (Vec/HashMap/array/struct) is
            // NOT implemented. lower_for treats any non-range iteree as a numeric limit
            // and the loop variable as a 0-based counter, never fetching elements -- so
            // `for x in vec` compares the counter against the Vec's ADDRESS and loops
            // ~forever (a real hang, no diagnostic). Only integer bounds (`for i in n`)
            // and ranges (`for i in a..b`) are supported. Reject aggregate iteration
            // cleanly instead of hanging (same convention as the BUG#72 slice reject).
            mut for_is_range := false
            if self.tree.nodes.data[range_expr].kind == NODE_BINARY_EXPR:
                let rop = self.node_text(range_expr)
                if rop == "..":
                    for_is_range = true
                safe_free_str(rop)
            // RFC 0018 P1: `for x in <fixed-array>` iterates elements. Bind the loop
            // variable to the array's element type and let air_builder's lower_for
            // desugar it to an index loop. STRUCT/SUM/GENERIC_INST (Vec/HashMap/...)
            // iteration is still unimplemented -> reject cleanly (that is P2), same
            // convention as the BUG#72 slice reject, to avoid the hang/miscompile.
            mut for_is_collection := false
            if not for_is_range and iteree_ty != TYPE_UNKNOWN and (iteree_ty as i64) < self.types.entries.len:
                let ie_kind = self.types.entries.data[iteree_ty].kind
                if iteree_ty == TYPE_BYTES:
                    // RFC 0020 P2: `for b in bytes` yields u8 bytes (byte semantics).
                    for_elem_ty = 5 as u32 // u8
                    for_is_collection = true
                elif iteree_ty == TYPE_STRING:
                    // RFC 0020 P2b: `for c in str` yields UTF-8 codepoints (rune = u32).
                    for_elem_ty = 7 as u32 // rune
                    for_is_collection = true
                elif ie_kind == TYPE_KIND_ARRAY:
                    for_elem_ty = self.types.entries.data[iteree_ty].extra
                    for_is_collection = true
                elif (ie_kind == TYPE_KIND_GENERIC_INST or ie_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.intern.get(self.types.entries.data[iteree_ty].name_id)) == "Vec":
                    // RFC 0018 P2: `for x in vec` where vec: Vec[T]. In a monomorphic
                    // context the Vec is a mono STRUCT (`_AX_std_Vec__i64`); in a generic
                    // context a GENERIC_INST. Its sole generic arg is the element type;
                    // air_builder's lower_for desugars to `vec.data[i]` for `i in 0..vec.len`.
                    let gargs = self.get_generic_args(iteree_ty)
                    if gargs.len >= 1 as i64:
                        for_elem_ty = gargs.data[0]
                        for_is_collection = true
                    else:
                        ax_printf_local("error: cannot determine the element type of this Vec for `for x in vec`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                elif (ie_kind == TYPE_KIND_GENERIC_INST or ie_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.intern.get(self.types.entries.data[iteree_ty].name_id)) == "HashMap":
                    // RFC 0018 P2: `for k in m` where m: HashMap[K,V] iterates the KEYS
                    // (the occupied-slot keys). Bind the loop variable to K (generic arg
                    // 0); air_builder's lower_for walks the table slots, guards on
                    // `occupied[i]`, and binds the var to `keys[i]`.
                    let gargs = self.get_generic_args(iteree_ty)
                    if gargs.len >= 1 as i64:
                        for_elem_ty = gargs.data[0]
                        for_is_collection = true
                    else:
                        ax_printf_local("error: cannot determine the key type of this HashMap for `for k in m`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                elif ie_kind == TYPE_KIND_STRUCT or ie_kind == TYPE_KIND_SUM or ie_kind == TYPE_KIND_GENERIC_INST:
                    ax_printf_local("error: iterating this collection with `for x in <collection>` is not yet supported (only fixed arrays and Vec[T]); use a range `for i in 0..n` or a `while` loop with .len/.get\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // RFC 0018 P1: for a COLLECTION loop, bind the loop variable's type to the
            // element type BEFORE inferring the body, so field/method access on the
            // element (`p.y`) resolves against the element struct (otherwise the field
            // index defaults to 0 and every field reads offset 0 -> silent miscompile).
            // Range/integer loops keep the original post-body assignment below so their
            // body type environment (and codegen) is byte-identical.
            if for_is_collection and iter_var != 0 as u32:
                self.symtable.symbols.data[iter_var].type_id = for_elem_ty
            let body = self.tree.nodes.data[range_expr].next_sibling
            if body != 0 as u32:
                self.infer_node(body, TYPE_UNKNOWN)
        if iter_var != 0 as u32:
            self.symtable.symbols.data[iter_var].type_id = for_elem_ty
        
    elif kind == NODE_BINARY_EXPR:
        let lhs = self.tree.nodes.data[node_idx].first_child
        mut rhs := 0 as u32
        if lhs != 0 as u32:
            rhs = self.tree.nodes.data[lhs].next_sibling
            
        if lhs != 0 as u32 and rhs != 0 as u32:
            let op = flags
            if op == 1 as u16: // comparisons ==, !=, <, >, <=, >=
                let t1 = self.infer_node(lhs, TYPE_UNKNOWN)
                let t2 = self.infer_node(rhs, TYPE_UNKNOWN)
                // RFC 0005: a bare int literal operand adopts the other operand's
                // concrete numeric type so `x < 10` needs no `10 as u32`. Guard on
                // t1 != t2 so already-matching / both-cast operands are untouched
                // (keeps the self-host fixpoint: casted literals are CAST_EXPR nodes).
                let lhs_lit = self.tree.nodes.data[lhs].kind == NODE_INT_LIT
                let rhs_lit = self.tree.nodes.data[rhs].kind == NODE_INT_LIT
                if rhs_lit and not lhs_lit and tc_is_numeric(t1) and t1 != t2:
                    self.infer_node(rhs, t1)
                elif lhs_lit and not rhs_lit and tc_is_numeric(t2) and t1 != t2:
                    self.infer_node(lhs, t2)

                // BUG#53: a comparison mixing a str/bytes operand and a numeric
                // operand (`s == 5`) silently compares the str's {ptr,len} against an
                // int -> meaningless/garbage result. Reject. str==str and numeric
                // comparisons are untouched (only the incompatible mix is caught).
                // Mirrors the arithmetic-binop str<->numeric reject.
                let c_t1_str = t1 == TYPE_STRING or t1 == TYPE_BYTES
                let c_t2_str = t2 == TYPE_STRING or t2 == TYPE_BYTES
                if (c_t1_str and tc_is_numeric(t2)) or (tc_is_numeric(t1) and c_t2_str):
                    let cbt = self.node_text(node_idx)
                    ax_printf_local("error: comparison '%s' between a string and a numeric operand is not allowed\n", get_str_ptr(cbt) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(cbt)
                    self.diags_count = self.diags_count + 1 as i64

                // Diagnostic: RFC 0007 lowers `a <op> b` on a STRUCT/SUM/GENERIC_INST
                // lhs to a method call (a.eq(b)/a.lt(b)/...) ONLY IF a matching
                // overload method is found; otherwise air_builder's lower_binary_expr
                // silently falls through to the native scalar opcode (OP_EQ/OP_ILT/...)
                // comparing the operands' RAW REGISTER VALUES -- which, for an
                // aggregate held by-address, means comparing the two operands'
                // ADDRESSES, not their field contents. Two distinct struct values with
                // identical fields then compare as "not equal" with NO diagnostic at
                // all (silent accept-then-miscompile, same class as BUG#53/#64). Reject
                // it here instead: if lhs is a user-type and no overload for this
                // operator exists, emit an error rather than emitting broken pointer-
                // comparison code.
                if (t1 as i64) < self.types.entries.len:
                    let t1_entry = self.types.entries.data[t1 as i64]
                    if t1_entry.kind == TYPE_KIND_STRUCT or t1_entry.kind == TYPE_KIND_SUM or t1_entry.kind == TYPE_KIND_GENERIC_INST:
                        let op_text = self.node_text(node_idx)
                        mut mname := ""
                        if op_text == "==" or op_text == "!=":
                            mname = "eq"
                        elif op_text == "<":
                            mname = "lt"
                        elif op_text == "<=":
                            mname = "le"
                        elif op_text == ">":
                            mname = "gt"
                        elif op_text == ">=":
                            mname = "ge"
                        safe_free_str(op_text)
                        if mname != "":
                            let msym = self.diag_resolve_op_method(mname, t1, t2)
                            if msym == 0 as u32:
                                let tname = self.intern.get(t1_entry.name_id)
                                ax_printf_local("error: type '%s' does not implement '%s' for this comparison; no operator overload found\n", get_str_ptr(tname) as i64, get_str_ptr(mname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64

                result_type = TYPE_BOOL
            elif op == 2 as u16: // and / or
                self.infer_node(lhs, TYPE_BOOL)
                self.infer_node(rhs, TYPE_BOOL)
                result_type = TYPE_BOOL
            else:
                mut t1 := self.infer_node(lhs, TYPE_UNKNOWN)
                mut t2 := self.infer_node(rhs, TYPE_UNKNOWN)
                // RFC 0005: bidirectional int-literal type inference (see above).
                let lhs_lit = self.tree.nodes.data[lhs].kind == NODE_INT_LIT
                let rhs_lit = self.tree.nodes.data[rhs].kind == NODE_INT_LIT
                if rhs_lit and not lhs_lit and tc_is_numeric(t1) and t1 != t2:
                    t2 = self.infer_node(rhs, t1)
                elif lhs_lit and not rhs_lit and tc_is_numeric(t2) and t1 != t2:
                    t1 = self.infer_node(lhs, t2)
                // RFC 0006 float-literal width inference. A float literal defaults to
                // f64 (NODE_FLOAT_LIT), so `y * 2.0` with `y: f32` produced mixed f32*f64
                // operands: result_type became F64 (below) but `y` is 32-bit, so codegen
                // emitted a 64-bit mulsd over the 32-bit bits -> garbage (miscompiled to
                // 0). Coerce a float-literal operand to the OTHER operand's concrete float
                // width, or (both literals) to an f32 EXPECTED context, mirroring the
                // integer-literal rule above. Same-width and pure-f64 code is unchanged.
                let lhs_flit = self.tree.nodes.data[lhs].kind == NODE_FLOAT_LIT
                let rhs_flit = self.tree.nodes.data[rhs].kind == NODE_FLOAT_LIT
                if rhs_flit and not lhs_flit and (t1 == TYPE_F32 or t1 == TYPE_F64) and t1 != t2:
                    t2 = self.infer_node(rhs, t1)
                elif lhs_flit and not rhs_flit and (t2 == TYPE_F32 or t2 == TYPE_F64) and t1 != t2:
                    t1 = self.infer_node(lhs, t2)
                elif lhs_flit and rhs_flit and expected == TYPE_F32:
                    t1 = self.infer_node(lhs, TYPE_F32)
                    t2 = self.infer_node(rhs, TYPE_F32)
                // BUG#53 class: an arithmetic/bitwise operator on an un-unwrapped
                // Option/Result operand silently lowers to OP_IADD/etc on the box value
                // -> garbage (e.g. `v.get(0) + v.get(1)` forgetting `.unwrap()` adds two
                // Option boxes). Reject it. Restricted to Option/Result (tc_is_opt_res,
                // base-name matched) so numeric operands, str+str (concat), and the
                // `hash_key[K]()%cap` generic-call mis-inference are unaffected; the
                // self-host never does arithmetic on an Option/Result value, so A==B holds.
                if self.tc_is_opt_res(t1) or self.tc_is_opt_res(t2):
                    let bot = self.node_text(node_idx)
                    ax_printf_local("error: operator '%s' is not defined for Option/Result operands (missing .unwrap()?)\n", get_str_ptr(bot) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(bot)
                    self.diags_count = self.diags_count + 1 as i64
                // BUG#53: a binary arithmetic/bitwise op with ONE str/bytes operand and
                // ONE numeric operand (`"hello" + 5`) silently lowered to pointer+int
                // (OP_IADD on the str's {ptr,len}) -> garbage. Reject. str+str stays
                // valid (both str -> concat, handled elsewhere); numeric+numeric is the
                // normal path. Only the genuinely-incompatible str<->numeric mix is
                // caught. See [[bug-malformed-input-robustness-cluster]].
                let t1_str = t1 == TYPE_STRING or t1 == TYPE_BYTES
                let t2_str = t2 == TYPE_STRING or t2 == TYPE_BYTES
                if (t1_str and tc_is_numeric(t2)) or (tc_is_numeric(t1) and t2_str):
                    let bot2 = self.node_text(node_idx)
                    ax_printf_local("error: operator '%s' is not defined between a string and a numeric operand\n", get_str_ptr(bot2) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(bot2)
                    self.diags_count = self.diags_count + 1 as i64
                // numeric promotion simple. RFC 0007: for a user-type lhs (operator
                // overload, lowered to a method call by air_builder) the result is
                // the lhs type — which the final `else` already yields.
                if t1 == TYPE_F64 or t2 == TYPE_F64:
                    result_type = TYPE_F64
                elif t1 == TYPE_F32 or t2 == TYPE_F32:
                    result_type = TYPE_F32
                elif t1 == TYPE_I64 or t2 == TYPE_I64:
                    result_type = TYPE_I64
                else:
                    result_type = t1
                    
    elif kind == NODE_CALL_EXPR:
        let callee = self.tree.nodes.data[node_idx].first_child
        if callee != 0 as u32:
            mut callee_node = self.tree.nodes.data[callee]
            mut is_generic_call := false
            mut template_sym_idx := 0 as u32

            if callee_node.kind == NODE_IDENT:
                // BUG#80: disambiguate an OVERLOADED free-call by the first argument type
                // BEFORE deciding generic-ness / binding the callee, mirroring the method
                // path. Rewrite the tree payload so air_builder lowers the right overload;
                // re-read callee_node afterwards (inferring the arg may realloc nodes,
                // BUG#51). No-op unless the name is overloaded and the head mismatches.
                let ov_first_arg = self.tree.nodes.data[callee].next_sibling
                mut ov_argc := 0 as i64
                mut ov_an := ov_first_arg
                while ov_an != 0 as u32:
                    ov_argc = ov_argc + 1 as i64
                    ov_an = self.tree.nodes.data[ov_an].next_sibling
                let ov_pick = self.resolve_free_call_overload(callee_node.payload, ov_first_arg, ov_argc)
                if ov_pick != callee_node.payload:
                    self.tree.nodes.data[callee].payload = ov_pick
                    callee_node = self.tree.nodes.data[callee]
                let sym_idx = ov_pick
                if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                    let sym = self.symtable.symbols.data[sym_idx]
                    mut src_tree := self.tree
                    if (sym_idx as i64) < self.symtable.symbol_trees.len:
                        let t = self.symtable.symbol_trees.data[sym_idx]
                        if t != null as ptr[AstTree]:
                            src_tree = t
                    if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                        is_generic_call = true
                        template_sym_idx = sym_idx
            elif callee_node.kind == NODE_FIELD_EXPR:
                if (callee_node.flags & 2048 as u16) != 0 as u16:
                    let rec_node = callee_node.first_child
                    if rec_node != 0 as u32:
                        self.infer_node(rec_node, TYPE_UNKNOWN)
                    mut sym_idx := callee_node.payload
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        mut src_tree := self.tree
                        if (sym_idx as i64) < self.symtable.symbol_trees.len:
                            let t = self.symtable.symbol_trees.data[sym_idx]
                            if t != null as ptr[AstTree]:
                                src_tree = t
                        if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                            is_generic_call = true
                            template_sym_idx = sym_idx
                else:
                    let field_name_id = callee_node.payload
                    let rec_node = callee_node.first_child
                    mut rec_type := TYPE_UNKNOWN
                    if rec_node != 0 as u32:
                        if (rec_node as i64) < self.node_types_cap:
                            rec_type = self.node_types[rec_node as i64]
                        if rec_type == TYPE_UNKNOWN:
                            rec_type = self.infer_node(rec_node, TYPE_UNKNOWN)

                    // Diagnostic: dynamic dispatch through an interface-typed
                    // receiver is not implemented -- there is no vtable/fat-
                    // pointer representation (TYPE_KIND_INTERFACE is otherwise
                    // unhandled everywhere in air_builder). Previously this
                    // silently resolved via plain scope lookup to WHATEVER
                    // same-named method happened to be visible (not the actual
                    // receiver's concrete type) and called it with a mismatched
                    // `self` layout -- a real segfault, same accept-then-
                    // miscompile class as BUG#53/64/68/70. Reject clearly.
                    mut rec_unwrapped := rec_type
                    if rec_unwrapped != TYPE_UNKNOWN and (rec_unwrapped as i64) < self.types.entries.len:
                        mut rue := self.types.entries.data[rec_unwrapped as i64]
                        while rue.kind == TYPE_KIND_POINTER or rue.kind == TYPE_KIND_REF:
                            rec_unwrapped = rue.extra as u32
                            rue = self.types.entries.data[rec_unwrapped as i64]
                        if rue.kind == TYPE_KIND_INTERFACE:
                            let fname = self.intern.get(field_name_id)
                            ax_printf_local("error: dynamic dispatch through an interface-typed value is not yet supported ('%s')\n", get_str_ptr(fname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            safe_free_str(fname)
                            self.diags_count = self.diags_count + 1 as i64

                    mut sym_idx := self.resolve_method_sym(field_name_id, rec_type)
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        mut src_tree := self.tree
                        if (sym_idx as i64) < self.symtable.symbol_trees.len:
                            let t = self.symtable.symbol_trees.data[sym_idx]
                            if t != null as ptr[AstTree]:
                                src_tree = t
                        if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                            is_generic_call = true
                            template_sym_idx = sym_idx

                    // Method arity check (accept-then-miscompile, BUG#53 class — the twin
                    // of the free-function arity check in the TYPE_KIND_FUNC branch below):
                    // a concrete (non-generic) method call `recv.m(args...)` with the wrong
                    // number of explicit arguments was silently accepted — extra args were
                    // dropped, missing args read uninitialized registers. A non-generic method
                    // is NOT bound by resolve_method_sym (that only matches generic templates,
                    // BUG#45); it is matched later by name + receiver-type exactly like
                    // `method_ret_type` / air_builder's dispatch. Mirror that match here: a
                    // method's param[0] IS the receiver, so an INSTANCE call `recv.m(a,b)`
                    // expects (declared params - 1) explicit args and a STATIC call
                    // `Type.m(recv,a,b)` — receiver named as a bare type — expects exactly
                    // (declared params). Overload-safe: reject only when method(s) of this
                    // name+receiver EXIST but NONE match the call's arity (mirrors the free-fn
                    // overload philosophy). Gated TIGHTLY to stay self-host-safe: non-generic
                    // only (generic methods like `map`/`unwrap` have unreliable inferred arity
                    // and false-positived the fixpoint), and only a plain user STRUCT/SUM
                    // receiver (excludes Option/Result/Vec builtin + backend-intercepted
                    // methods). Module-qualified calls take the flag-2048 branch above.
                    if not is_generic_call and rec_type != TYPE_UNKNOWN and (rec_type as i64) < self.types.entries.len:
                        mut rec_uw := rec_type
                        mut rue2 := self.types.entries.data[rec_uw as i64]
                        while rue2.kind == TYPE_KIND_POINTER or rue2.kind == TYPE_KIND_REF:
                            rec_uw = rue2.extra as u32
                            rue2 = self.types.entries.data[rec_uw as i64]
                        if rue2.kind == TYPE_KIND_STRUCT or rue2.kind == TYPE_KIND_SUM:
                            // A STATIC call names the receiver as a bare type: the
                            // first_child ident binds to a TYPE symbol, not a value.
                            mut is_static_call := false
                            if rec_node != 0 as u32:
                                let rcn = self.tree.nodes.data[rec_node]
                                if rcn.kind == NODE_IDENT or rcn.kind == NODE_TYPE_EXPR:
                                    let rcsym = rcn.payload
                                    if rcsym != 0 as u32 and (rcsym as i64) < self.symtable.symbols.len:
                                        let rck = self.symtable.symbols.data[rcsym as i64].kind
                                        if rck == SYM_STRUCT or rck == SYM_TYPE_ALIAS or rck == SYM_INTERFACE or rck == SYM_BUILTIN_TYPE:
                                            is_static_call = true
                            mut mact := 0 as i64
                            mut mac := self.tree.nodes.data[callee].next_sibling
                            while mac != 0 as u32:
                                mact = mact + 1 as i64
                                mac = self.tree.nodes.data[mac as i64].next_sibling
                            // Scan for concrete methods matching name + receiver type
                            // (mirrors method_ret_type). found_any: a real method exists;
                            // arity_ok: at least one has the right (self-adjusted) arity.
                            let m_field_name = self.intern.get(field_name_id)
                            mut found_any := false
                            mut arity_ok := false
                            mut msi := 0 as i64
                            while msi < self.symtable.symbols.len:
                                let msym = self.symtable.symbols.data[msi]
                                if msym.kind == SYM_FUNC and msym.type_id != TYPE_UNKNOWN and (msym.type_id as i64) < self.types.entries.len and (msym.flags & SYM_FLAG_GENERIC) == 0 as u16:
                                    if self.intern.name_matches_method(msym.name_id, m_field_name):
                                        let mfe = self.types.entries.data[msym.type_id as i64]
                                        if mfe.kind == TYPE_KIND_FUNC and (mfe.extra as i64) < self.types.funcs.len:
                                            let mfi = self.types.funcs.data[mfe.extra as i64]
                                            if mfi.params.len > 0 as i64:
                                                mut mfp := mfi.params.data[0]
                                                while mfp != TYPE_UNKNOWN and (mfp as i64) < self.types.entries.len:
                                                    let mpe = self.types.entries.data[mfp as i64]
                                                    if mpe.kind == TYPE_KIND_POINTER or mpe.kind == TYPE_KIND_REF:
                                                        mfp = mpe.extra as u32
                                                    else:
                                                        break
                                                if mfp == rec_uw:
                                                    found_any = true
                                                    let mdecl = self.sym_decl_param_count(msi as u32)
                                                    if mdecl >= 1 as i64:
                                                        mut expected_expl := mdecl - 1 as i64
                                                        if is_static_call:
                                                            expected_expl = mdecl
                                                        if mact == expected_expl:
                                                            arity_ok = true
                                msi = msi + 1 as i64
                            if found_any and not arity_ok:
                                ax_printf_local("error: method '%s' called with %d argument(s) but no overload takes that many\n", get_str_ptr(m_field_name) as i64, mact, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(m_field_name)

                    // BUG#93: a namespace-qualified call whose member did not resolve.
                    // On the native build imports are stripped textually, so `std`/
                    // `math`/`string` are never SYM_MODULE and the resolver leaves
                    // `std.math.gcd(...)` / `string.concat(a,b)` as an unresolved
                    // NODE_FIELD_EXPR (flag 2048 unset). air_builder then lowers the
                    // callee to a garbage register and emits `call *reg` -> silent
                    // SIGSEGV. Detect it precisely: walk the receiver chain down to its
                    // ROOT identifier and re-resolve that name. If the root binds to
                    // nothing, the whole chain is an undefined namespace reference, not
                    // a value -- so this is an unresolved module-qualified call, NOT a
                    // value method like `r.unwrap()` (whose root binds to a SYM_VAR/
                    // SYM_PARAM and is spared). Reject cleanly (accept-then-miscompile
                    // class, BUG#53/#68/#88). The compiler's own source has no surviving
                    // `std.X.Y` field-exprs post-strip, so this never trips self-build.
                    if sym_idx == 0 as u32 and rec_node != 0 as u32:
                        mut lroot := rec_node
                        mut lk := self.tree.nodes.data[lroot].kind
                        while lk == NODE_FIELD_EXPR:
                            let nc = self.tree.nodes.data[lroot].first_child
                            if nc == 0 as u32:
                                break
                            lroot = nc
                            lk = self.tree.nodes.data[lroot].kind
                        if lroot != 0 as u32 and self.tree.nodes.data[lroot].kind == NODE_IDENT:
                            let root_spell = self.node_text(lroot)
                            if root_spell != "":
                                // Decide if the root ident is BOUND. `symtable.resolve`
                                // only sees module/global scope here (local scopes are
                                // already popped), so it CANNOT be used to detect a
                                // local/param receiver. Instead use the payload the
                                // resolver stamped on the ident: a bound ident's payload
                                // is its symbol index, and that symbol's name_id equals
                                // the ident spelling's name_id. An UNBOUND namespace ident
                                // keeps its raw name_id as payload, indexing some
                                // unrelated symbol whose name_id will not match. Compare
                                // interned name_ids (u32) -- no dependency on str equality
                                // lowering. This distinguishes a real value receiver
                                // (`r`, `self`, a global) from an undefined namespace
                                // (`std`, `math`, `string`).
                                let spell_name_id = self.intern.intern_string(root_spell)
                                mut root_bound := false
                                let rp = self.tree.nodes.data[lroot].payload
                                if rp != 0 as u32 and (rp as i64) < self.symtable.symbols.len:
                                    if self.symtable.symbols.data[rp].name_id == spell_name_id:
                                        root_bound = true
                                if not root_bound:
                                    let fname = self.intern.get(field_name_id)
                                    ax_printf_local("error: unresolved call to '%s' on undefined namespace '%s' -- module not imported or not bundled on this build\n", get_str_ptr(fname) as i64, get_str_ptr(root_spell) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    safe_free_str(fname)
                                    self.diags_count = self.diags_count + 1 as i64

            if is_generic_call:
                let decl_node = self.symtable.symbols.data[template_sym_idx].decl_node
                
                // Find the correct source AstTree for the generic template
                mut src_tree := self.tree
                if (template_sym_idx as i64) < self.symtable.symbol_trees.len:
                    let t = self.symtable.symbol_trees.data[template_sym_idx]
                    if t != null as ptr[AstTree]:
                        src_tree = t

                // Collect generic parameter name_ids using the correct source tree
                mut gen_params := new_u32_vec()
                mut c := src_tree.nodes.data[decl_node].first_child
                while c != 0 as u32:
                    let cn = src_tree.nodes.data[c]
                    if cn.kind == NODE_GENERIC_PARAMS:
                        mut gp := cn.first_child
                        while gp != 0 as u32:
                            let gp_name = self.node_text_in_tree(src_tree, gp)
                            let gp_name_id = self.intern.intern(gp_name)
                            safe_free_str(gp_name)
                            gen_params.push(gp_name_id)
                            gp = src_tree.nodes.data[gp].next_sibling
                        break
                    c = cn.next_sibling
                
                // Collect argument types
                mut arg_types := new_u32_vec()
                if callee_node.kind == NODE_FIELD_EXPR:
                    let rec_node = callee_node.first_child
                    if rec_node != 0 as u32:
                        let rec_type = self.infer_node(rec_node, TYPE_UNKNOWN)
                        arg_types.push(rec_type)
                
                mut arg_idx := self.tree.nodes.data[callee].next_sibling
                while arg_idx != 0 as u32:
                    let a_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    arg_types.push(a_type)
                    arg_idx = self.tree.nodes.data[arg_idx].next_sibling
                
                // Map generic params to inferred TypeIDs using the correct source tree
                mut inferred := new_u32_vec()
                mut i := 0 as i64
                while i < gen_params.len:
                    inferred.push(TYPE_UNKNOWN)
                    i = i + 1
                
                mut p_idx := 0 as i64
                c = src_tree.nodes.data[decl_node].first_child
                while c != 0 as u32:
                    let cn = src_tree.nodes.data[c]
                    if cn.kind == NODE_PARAM_DECL:
                        let type_node_idx = cn.first_child
                        if type_node_idx != 0 as u32 and p_idx < arg_types.len:
                            self.infer_generic_type_args(type_node_idx, arg_types.data[p_idx], gen_params, inferred, src_tree)
                        p_idx = p_idx + 1
                    c = cn.next_sibling
                
                // BUG#79: a type param left UNKNOWN here would be i32-defaulted
                // below. Whether a generic-looking ARGUMENT should block
                // instantiation depends on this: if every param was resolved
                // concretely (e.g. a Vec[Option[i32]] receiver fully determines
                // T), a generic-looking argument such as `None` must NOT defer.
                mut has_unresolved := false
                i = 0
                while i < inferred.len:
                    if inferred.data[i] == TYPE_UNKNOWN:
                        has_unresolved = true
                    i = i + 1

                i = 0
                while i < inferred.len:
                    if inferred.data[i] == TYPE_UNKNOWN:
                        inferred.data[i] = TYPE_I32
                    i = i + 1

                mut has_generic_arg := false
                // A genuinely generic inferred type param (inside a generic body)
                // means no concrete instance can be produced yet — always defer.
                mut inf_idx := 0 as i64
                while inf_idx < inferred.len:
                    if self.is_generic(inferred.data[inf_idx]):
                        has_generic_arg = true
                        break
                    inf_idx = inf_idx + 1

                // Only when a param was left UNRESOLVED (and thus i32-defaulted)
                // does a generic ARGUMENT signal a generic context we must defer
                // to, rather than bake a wrong i32 instance. When inference is
                // complete, a generic-looking argument like `None` cannot block.
                if has_unresolved:
                    mut a_idx := 0 as i64
                    while a_idx < arg_types.len:
                        if self.is_generic(arg_types.data[a_idx]):
                            has_generic_arg = true
                            break
                        a_idx = a_idx + 1

                if has_generic_arg:
                    // Deferring a generic-typed call is correct ONLY inside a generic
                    // body (it re-instantiates at monomorphization). In a CONCRETE
                    // function the type param is genuinely un-inferable (e.g. only a
                    // bare `None` supplied it), no instance is ever produced, and the
                    // deferred call silently SEGFAULTs. Reject cleanly instead (BUG#53
                    // convention) — the caller must add explicit type arguments
                    // (`f[T](...)`) or annotate the argument. See
                    // [[bug-none-first-generic-inference]] residual cluster (s3/n2).
                    if not self.current_fn_is_generic:
                        ax_printf_local("error: cannot infer generic type parameter for this call in a non-generic context; add explicit type arguments (f[T](...)) or annotate the argument\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    if gen_params.data != null as ptr[u32]:
                        @free(gen_params.data as ptr[u8])
                    if arg_types.data != null as ptr[u32]:
                        @free(arg_types.data as ptr[u8])
                    if inferred.data != null as ptr[u32]:
                        @free(inferred.data as ptr[u8])
                else:
                    // RFC 0022 tuple×generic: a tuple LITERAL passed as a generic
                    // fn/method arg (`Vec[(i64,i64)].push((10,20))`) was inferred with
                    // UNKNOWN during arg_types collection, so its int-literal elements
                    // defaulted to i32 → an 8-byte {i32,i32} stored into a 16-byte element
                    // slot, reading the 2nd field as garbage. Now that `inferred[]` is
                    // final and concrete, re-infer any bare-generic-typed tuple arg with
                    // its monomorphized `__tup` element type as the expected hint: the
                    // NODE_TUPLE_EXPR coercion branch widens the elements and PINS the node
                    // to the `__tup` struct, and the sticky guard preserves it against a
                    // later UNKNOWN re-visit. Mirrors the variant-ctor fix (1aff7ca).
                    mut cp := src_tree.nodes.data[decl_node].first_child
                    // For a method call, param 0 is the receiver `self` (its arg node is
                    // callee.first_child, not in the sibling chain), so skip it; explicit
                    // args start at callee.next_sibling and align with the remaining params.
                    mut ap := self.tree.nodes.data[callee].next_sibling
                    mut skip_self := callee_node.kind == NODE_FIELD_EXPR
                    while cp != 0 as u32:
                        let cpn = src_tree.nodes.data[cp]
                        if cpn.kind == NODE_PARAM_DECL:
                            if skip_self:
                                skip_self = false
                            elif ap != 0 as u32:
                                let arg_n = self.tree.nodes.data[ap]
                                let tnode = cpn.first_child
                                if tnode != 0 as u32 and src_tree.nodes.data[tnode].kind == NODE_TYPE_EXPR:
                                    let tname = self.node_text_in_tree(src_tree, tnode)
                                    let tname_id = self.intern.intern(tname)
                                    safe_free_str(tname)
                                    mut gk := 0 as i64
                                    while gk < gen_params.len:
                                        if gen_params.data[gk] == tname_id:
                                            let et = inferred.data[gk]
                                            // RFC 0022 tuple×generic: a `(a, b)` literal for a
                                            // bare-generic param resolved to a `__tup` struct.
                                            if arg_n.kind == NODE_TUPLE_EXPR and (et as i64) < self.types.entries.len and self.types.entries.data[et as i64].kind == TYPE_KIND_STRUCT:
                                                let enm2 = self.intern.get(self.types.entries.data[et as i64].name_id)
                                                let is_tup2 = std.string.starts_with(enm2, "__tup")
                                                safe_free_str(enm2)
                                                if is_tup2:
                                                    self.infer_node(ap, et)
                                            // f32: a bare-generic param resolved to f32 (e.g.
                                            // `Vec[f32].push(40.0)`, item: T=f32). Re-infer the
                                            // arg with f32 expected so a float literal narrows to
                                            // single instead of storing a DOUBLE into the 4-byte
                                            // f32 element slot -> read back 0 (same class as the
                                            // f32 literal boundary/aggregate bugs). The compiler
                                            // instantiates no generic with f32, so fixpoint-safe.
                                            // [[bug-f32-boundary-abi-open]]
                                            elif et == TYPE_F32:
                                                self.infer_node(ap, et)
                                            break
                                        gk = gk + 1 as i64
                                ap = self.tree.nodes.data[ap].next_sibling
                        cp = cpn.next_sibling
                    mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
                    let mangled_name = mono.mangle_name_ov(template_sym_idx, self.intern.get(self.symtable.symbols.data[template_sym_idx].name_id), inferred)
                    let mangled_id = self.intern.intern(mangled_name)
                    mut existing_sym_idx := self.symtable.resolve(mangled_id)
                    if existing_sym_idx == 0 as u32:
                        existing_sym_idx = self.symtable.resolve_global(mangled_id)
                    
                    mut inst_sym_idx := 0 as u32
                    if existing_sym_idx != 0 as u32:
                        let existing_sym = self.symtable.symbols.data[existing_sym_idx]
                        if existing_sym.type_id != 0 as u32:
                            inst_sym_idx = existing_sym_idx
                    else:
                        let cloned_root = mono.instantiate_function(template_sym_idx, inferred)
                        self.tree.append_child(0 as u32, cloned_root)
                        
                        let saved_data = self.symtable.stack.data
                        let saved_len = self.symtable.stack.len
                        let saved_cap = self.symtable.stack.cap
                        mut temp_stack := new_u32_vec()
                        temp_stack.push(0 as u32)
                        if saved_len > 1:
                            temp_stack.push(saved_data[1])
                        self.symtable.stack = temp_stack
                        mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
                        resolver.resolve_node(cloned_root)
                        @free(self.symtable.stack.data as ptr[u8])
                        self.symtable.stack.data = saved_data
                        self.symtable.stack.len = saved_len
                        self.symtable.stack.cap = saved_cap
                        
                        let payload_sym = self.tree.nodes.data[cloned_root].payload
                        if payload_sym != 0 as u32:
                            inst_sym_idx = payload_sym
                        else:
                            mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                            if resolved_inst_sym == 0 as u32:
                                resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                            inst_sym_idx = resolved_inst_sym
                        
                        self.pre_infer_func_signature(cloned_root)
                        self.infer_node(cloned_root, TYPE_UNKNOWN)
                    
                    self.tree.nodes.data[callee].payload = inst_sym_idx
                    self.tree.nodes.data[callee].flags = self.tree.nodes.data[callee].flags | 2048 as u16
                    
                    if gen_params.data != null as ptr[u32]:
                        @free(gen_params.data as ptr[u8])
                    if arg_types.data != null as ptr[u32]:
                        @free(arg_types.data as ptr[u8])
                    if inferred.data != null as ptr[u32]:
                        @free(inferred.data as ptr[u8])
            
            mut callee_type = self.infer_node(callee, TYPE_UNKNOWN)
            // A monomorphized generic call (callee.flags & 2048, set above) had its
            // payload pointed at the concrete INSTANCE symbol, whose pre-inferred
            // signature carries the concrete return type (f64/i32/struct/...). But
            // infer_node re-resolves the ident to the generic TEMPLATE, whose return is
            // the generic param (ret=0/UNKNOWN) — so result_type below defaulted to int,
            // silently corrupting a FLOAT (or other non-int-repr) return (int matched the
            // default by coincidence, hiding this until now). Prefer the instance's own
            // signature type. See [[bug-generic-fn-float-return-default-int]].
            if (self.tree.nodes.data[callee].flags & 2048 as u16) != 0 as u16:
                let inst_pay = self.tree.nodes.data[callee].payload
                if inst_pay != 0 as u32 and (inst_pay as i64) < self.symtable.symbols.len:
                    let inst_tid = self.symtable.symbols.data[inst_pay as i64].type_id
                    if inst_tid != 0 as u32 and (inst_tid as i64) < self.types.entries.len and self.types.entries.data[inst_tid].kind == TYPE_KIND_FUNC:
                        callee_type = inst_tid
            if callee_type != TYPE_UNKNOWN:
                let entry = self.types.entries.data[callee_type]
                if entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[entry.extra]
                    result_type = fi.ret
                    // Arity check (was silent accept-then-miscompile, BUG#53 class): a
                    // call with the wrong number of arguments compiled clean and
                    // miscompiled -- missing args read uninitialized registers, extra
                    // args were silently dropped. AXIOM has no variadic user functions
                    // or default arguments, so a concrete FUNC callee's arity is exact.
                    // Scoped TIGHTLY to a plain NODE_IDENT free-function callee that is
                    // NOT generic: this is where the args are a clean sibling list with
                    // no implicit receiver. Method / UFCS / generic-method calls
                    // (field-expr callees, e.g. the generic `map`/`ok_or`) are NOT
                    // checked here -- their arg/receiver/partial-signature shape is
                    // unreliable at inference time and would false-positive (broke the
                    // self-host: `'map' expects 1, found 0`). Free-function arity is the
                    // common mistake and is safe to check exactly.
                    if not is_generic_call and self.tree.nodes.data[callee].kind == NODE_IDENT:
                        mut fnm := "function"
                        mut fnm_owned := false
                        let cpay = self.tree.nodes.data[callee].payload
                        if cpay != 0 as u32 and (cpay as i64) < self.symtable.symbols.len:
                            fnm = self.intern.get(self.symtable.symbols.data[cpay as i64].name_id)
                            fnm_owned = true
                        // `compiler_intrinsic` is the one internal VARIADIC intrinsic
                        // (declared 1 param but magic-called `@compiler_intrinsic("op")
                        // [T](...)` with varying arity) -- exclude it. User functions
                        // are never variadic.
                        mut is_intrinsic := false
                        if fnm == "compiler_intrinsic" or fnm == "@compiler_intrinsic" or fnm == "ax_compiler_intrinsic":
                            is_intrinsic = true
                        if not is_intrinsic:
                            mut actual_args := 0 as i64
                            mut ac := self.tree.nodes.data[callee].next_sibling
                            while ac != 0 as u32:
                                actual_args = actual_args + 1 as i64
                                ac = self.tree.nodes.data[ac as i64].next_sibling
                            if actual_args != fi.params.len:
                                ax_printf_local("error: '%s' expects %d argument(s), found %d\n", get_str_ptr(fnm) as i64, fi.params.len, actual_args, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            else:
                                // BUG#53 (arg-path analog of m5): a str/numeric-LITERAL
                                // argument passed where the param is the opposite kind
                                // (`f("hi")` with `f(n:i64)`, or `f(42)` with `f(s:str)`)
                                // was silently accepted then crashed/segfaulted (the
                                // {ptr,len} str repr read as an int, or vice versa).
                                // Reject. Gated on the arg being a str/int/float LITERAL
                                // (unambiguous type) so real coercions & value args are
                                // untouched. See [[bug-malformed-input-robustness-cluster]].
                                mut pchk := 0 as i64
                                mut anode := self.tree.nodes.data[callee].next_sibling
                                while anode != 0 as u32 and pchk < fi.params.len:
                                    let ak = self.tree.nodes.data[anode].kind
                                    let pt = fi.params.data[pchk]
                                    let p_str = pt == TYPE_STRING or pt == TYPE_BYTES
                                    let p_num = pt >= TYPE_I8 and pt <= TYPE_USIZE and pt != TYPE_STRING and pt != TYPE_VOID
                                    let a_strlit = ak == NODE_STRING_LIT
                                    let a_numlit = ak == NODE_INT_LIT or ak == NODE_FLOAT_LIT
                                    if (p_num and a_strlit) or (p_str and a_numlit):
                                        ax_printf_local("error: argument type mismatch in call to '%s': a string and a numeric type are not compatible\n", get_str_ptr(fnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        self.diags_count = self.diags_count + 1 as i64
                                    pchk = pchk + 1 as i64
                                    anode = self.tree.nodes.data[anode as i64].next_sibling
                        if fnm_owned:
                            safe_free_str(fnm)


                elif entry.kind == TYPE_KIND_STRUCT:
                    // BUG#74: if this is a generic struct constructed without
                    // explicit type args, monomorphize it from the field values.
                    result_type = self.try_instantiate_struct_ctor(callee, callee_type)
                elif entry.kind == TYPE_KIND_SUM:
                    result_type = self.try_instantiate_variant_call(callee, callee_type, expected)
                elif entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                    result_type = callee_type
                elif self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR:
                    // Diagnostic (was silent accept-then-miscompile, same class as
                    // BUG#53): `recv.name(...)` where `name` resolved to a genuine
                    // DATA FIELD (a concrete, non-callable type — not FUNC, and not a
                    // STRUCT/SUM/GENERIC_INST/OPTION/RESULT constructor-call), because
                    // no method named `name` exists on recv's type. e.g. `v.len()` on
                    // a Vec, which has a `len: i64` FIELD but no `len()` method (the
                    // correct call is the field `v.len`, no parens). Previously this
                    // left result_type UNKNOWN and air_builder's lower_call_expr fell
                    // back to `getfld` + INDIRECT CALL through the field's scalar
                    // value — segfault or a jump to a garbage address, with no
                    // compile-time signal. Scoped to NODE_FIELD_EXPR callees only, so
                    // qualified constructor calls (`Mod.Struct(...)`, `Enum.Variant(x)`
                    // — also FIELD_EXPR callees, but those resolve to STRUCT/SUM above
                    // and never reach this branch) are unaffected.
                    let fname = self.intern.get(self.tree.nodes.data[callee].payload)
                    ax_printf_local("error: '%s' is a field, not a function; it cannot be called\n", get_str_ptr(fname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(fname)
                    self.diags_count = self.diags_count + 1 as i64
            else:
                // BUG#51: `callee_node` is an ADDRESS into the nodes buffer under the
                // native backend (aggregates are held by-address). Generic
                // instantiation above may have GROWN tree.nodes (realloc + free of
                // the old buffer), leaving `callee_node` dangling — the gcc-built
                // compiler read stale-but-intact pages, the native allocator
                // (VirtualFree) unmaps them → deterministic segfault. Re-read the
                // node fields through the CURRENT buffer here and below.
                if self.tree.nodes.data[callee].kind == NODE_IDENT:
                    let sym_idx = self.tree.nodes.data[callee].payload
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        let name = self.intern.get(sym.name_id)
                        if (name == "syscall0" or name == "syscall1" or name == "syscall2" or
                            name == "syscall3" or name == "syscall4" or name == "syscall5" or
                            name == "syscall6"):
                            result_type = TYPE_I64
                        elif name == "panic":
                            result_type = TYPE_VOID

            // BUG#45 case (1): a non-generic method call whose callee failed to
            // type (resolve_method_sym only matches GENERIC methods) leaves the
            // call UNTYPED. Recover the RETURN type — but ONLY for AGGREGATE
            // returns, the case that is actually broken (an untyped copy of a
            // scalar already works via the register return, so scalar method
            // calls are left exactly as before to keep the blast radius minimal).
            // This sets only the call's result type; it does NOT mutate the
            // field-expr node/flag/payload, so method dispatch is unchanged.
            // (BUG#51: fresh nodes.data reads — see comment above.)
            if result_type == TYPE_UNKNOWN and self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR:
                let rec_node2 = self.tree.nodes.data[callee].first_child
                if rec_node2 != 0 as u32:
                    mut rt := TYPE_UNKNOWN
                    if (rec_node2 as i64) < self.node_types_cap:
                        rt = self.node_types[rec_node2 as i64]
                    if rt == TYPE_UNKNOWN:
                        rt = self.infer_node(rec_node2, TYPE_UNKNOWN)
                    let mret = self.method_ret_type(self.tree.nodes.data[callee].payload, rt)
                    if mret != TYPE_UNKNOWN and mret != 0 as u32 and (mret as i64) < self.types.entries.len:
                        let mk = self.types.entries.data[mret].kind
                        // RFC 0020 P3: `str`/`bytes` are 16-byte {ptr,len} PRIMITIVE
                        // aggregates — a str-returning UFCS method (`s.trim()`,
                        // `s.to_upper()`, ...) needs its return type recovered too, else
                        // the `let t = s.trim()` copy defaults to 8 bytes and drops half
                        // the {ptr,len} pair -> corrupt str/segfault (same failure the
                        // aggregate-return recovery guards against for structs).
                        if mk == TYPE_KIND_STRUCT or mk == TYPE_KIND_SUM or mk == TYPE_KIND_GENERIC_INST or mk == TYPE_KIND_OPTION or mk == TYPE_KIND_RESULT or mret == TYPE_STRING or mret == TYPE_BYTES:
                            result_type = mret

            // BUG#61: a GENERIC function call whose instantiated callee symbol's FUNC
            // signature was not yet inferred when infer_node(callee) ran leaves the
            // call UNTYPED. A later `result.method()` then has an UNKNOWN receiver
            // type, cannot resolve the method, and air_builder falls back to field-
            // access-as-call → segfault (e.g. Vec[T].get(i).unwrap()). Recover the
            // return type from the callee symbol's (freshly inferred) signature.
            // Restricted to STRUCTURED returns — the only case that is broken; scalar/
            // void calls already work untyped — to keep the blast radius minimal
            // (mirrors the BUG#45 method recovery above).
            // Covers both a generic FUNCTION (NODE_IDENT callee) and a generic METHOD
            // (NODE_FIELD_EXPR callee) — instantiation stamps callee.payload with the
            // monomorphised function/method symbol in both cases, so e.g.
            // Vec[T].get(i) (a generic method returning Option[T]) is recovered too.
            if result_type == TYPE_UNKNOWN and (self.tree.nodes.data[callee].kind == NODE_IDENT or self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR):
                let csym = self.tree.nodes.data[callee].payload
                if csym != 0 as u32 and (csym as i64) < self.symtable.symbols.len:
                    mut cft = self.symtable.symbols.data[csym].type_id
                    if cft == TYPE_UNKNOWN:
                        let cdecl = self.symtable.symbols.data[csym].decl_node
                        if cdecl != 0 as u32 and cdecl != 0xffffffff as u32:
                            self.pre_infer_func_signature(cdecl)
                            cft = self.symtable.symbols.data[csym].type_id
                    if cft != TYPE_UNKNOWN and (cft as i64) < self.types.entries.len:
                        let ce = self.types.entries.data[cft]
                        if ce.kind == TYPE_KIND_FUNC:
                            let fret = self.types.funcs.data[ce.extra].ret
                            if fret != TYPE_UNKNOWN and fret != 0 as u32 and (fret as i64) < self.types.entries.len:
                                let fk = self.types.entries.data[fret].kind
                                if fk == TYPE_KIND_STRUCT or fk == TYPE_KIND_SUM or fk == TYPE_KIND_GENERIC_INST or fk == TYPE_KIND_OPTION or fk == TYPE_KIND_RESULT:
                                    result_type = fret

            // Diagnostic (was silent accept-then-miscompile, same class as BUG#53/68/
            // 81/93): `recv.name(...)` where `name` names NO callable at all — neither
            // a data field, an interface method, a real method, nor a free function
            // usable via UFCS (`fn name(self: T, ...)`). infer_node(callee) could not
            // resolve the field name, so `callee_type == TYPE_UNKNOWN` (distinct from
            // the "field, not a function" case above, where the name resolved to a
            // field and callee_type is known) and the method flag 2048 is unset
            // (resolved methods set it at ~3455, generic methods at ~2800). All
            // recovery blocks above left result_type UNKNOWN. Previously air_builder's
            // lower_call_expr, finding no method/UFCS match (loop ~1565), fell through
            // to `lower_expr(callee)` -> `getfld` of a non-existent field (garbage
            // register) -> INDIRECT `call reg` -> SIGSEGV, with no compile-time signal.
            //
            // SAFETY (self-host fixpoint): the receiver's concrete type is NOT reliably
            // resolved at inference time — a cross-module param type (`in_file: File`
            // from std.io) can still read as a placeholder here, so a receiver-type-
            // matched lookup (method_ret_type) would FALSE-POSITIVE on valid UFCS calls
            // like `in_file.read(...)`. Instead use a RECEIVER-AGNOSTIC test: reject
            // only when NO SYM_FUNC anywhere matches `name` as a method name. If any
            // same-named function exists, defer to normal method/UFCS resolution (which
            // completes with full type info in air_builder) — conservative, never
            // breaks a real call. `p.ghost()` (no `ghost` fn anywhere) is rejected;
            // `in_file.read()` (a `read` fn exists) is left alone. Also gated:
            //   - callee_type == UNKNOWN  => excludes field-not-fn + every FUNC/STRUCT/
            //     SUM/constructor call (those have a known callee_type).
            //   - flag 2048 unset         => excludes every RESOLVED method.
            //   - receiver known & not INTERFACE => excludes BUG#93 module-qualified
            //     chains (receiver UNKNOWN) and interface dispatch (own diagnostic).
            if result_type == TYPE_UNKNOWN and callee_type == TYPE_UNKNOWN and self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR and (self.tree.nodes.data[callee].flags & 2048 as u16) == 0 as u16:
                let recv_n = self.tree.nodes.data[callee].first_child
                if recv_n != 0 as u32:
                    mut recv_t := TYPE_UNKNOWN
                    if (recv_n as i64) < self.node_types_cap:
                        recv_t = self.node_types[recv_n as i64]
                    if recv_t == TYPE_UNKNOWN:
                        recv_t = self.infer_node(recv_n, TYPE_UNKNOWN)
                    if recv_t != TYPE_UNKNOWN and (recv_t as i64) < self.types.entries.len:
                        mut ruw := recv_t
                        mut rue3 := self.types.entries.data[ruw as i64]
                        while rue3.kind == TYPE_KIND_POINTER or rue3.kind == TYPE_KIND_REF:
                            ruw = rue3.extra as u32
                            rue3 = self.types.entries.data[ruw as i64]
                        if rue3.kind != TYPE_KIND_INTERFACE:
                            let mname = self.intern.get(self.tree.nodes.data[callee].payload)
                            // Receiver-agnostic: is there ANY function named `mname`
                            // (as a method name)? If so, a real UFCS/method call may
                            // resolve later — do NOT reject.
                            mut name_exists := false
                            if rue3.kind == TYPE_KIND_PRIMITIVE:
                                // RFC 0020 P3 (+ numeric UFCS): a PRIMITIVE receiver — `str`/
                                // `bytes` OR a scalar numeric (`i64`, `f64`, ...) — has NO user
                                // methods; UFCS resolves ONLY to a free fn whose first param IS
                                // that primitive. Use a RECEIVER-SPECIFIC test (not the global
                                // name scan) so `s.push(x)` (push exists for Vec, not str) and
                                // `n.trim()` (trim exists for str, not i64) are rejected cleanly
                                // here instead of reaching air_builder's dispatch loop (which
                                // finds no first-param match, returns 0) and miscompiling via
                                // getfld + indirect call (BUG#53 class).
                                if self.method_ret_type(self.tree.nodes.data[callee].payload, ruw) != 0 as u32:
                                    name_exists = true
                            else:
                                // BUG#93(b): for a RELIABLY-NAMED concrete aggregate
                                // receiver (struct/sum/generic-inst with a real name,
                                // NOT Option/Result), be self-type-aware: only a method
                                // whose self base-type matches the receiver counts.
                                // Otherwise a method existing solely on a DIFFERENT type
                                // (`contains` on HashSet, absent on HashMap) passed the
                                // global name scan → no reject → getfld + call*garbage
                                // SIGSEGV. Option/Result stay on the agnostic scan: their
                                // unwrap/is_some/... are backend-intercepted with no self-
                                // typed free fn, so a self-aware scan would false-reject.
                                // The Option/Result methods are backend-intercepted
                                // (bug90) and can appear on a receiver typed as the
                                // PAYLOAD (e.g. `tok.unwrap()` where tok infers to Token,
                                // not Option[Token]) with no self-typed `unwrap` free fn —
                                // keep them on the agnostic scan or self-host false-rejects.
                                let is_opt_res_m = (mname == "unwrap" or mname == "unwrap_err" or mname == "is_some" or mname == "is_none" or mname == "is_ok" or mname == "is_err")
                                // A receiver DIRECTLY typed Option/Result (kind 11/12)
                                // calling one of these backend-intercepted methods is always
                                // valid: air_builder lowers is_some/unwrap/... locally with no
                                // free-fn symbol, so the name scan below finds nothing and
                                // false-rejects (e.g. `arr[i].is_some()` on `[Option;N]`, where
                                // arr[i] types to a real OPTION). Accept unconditionally.
                                if is_opt_res_m and (rue3.kind == TYPE_KIND_OPTION or rue3.kind == TYPE_KIND_RESULT):
                                    name_exists = true
                                mut self_aware := false
                                mut rec_base := "" as str
                                if (rue3.kind == TYPE_KIND_STRUCT or rue3.kind == TYPE_KIND_SUM or rue3.kind == TYPE_KIND_GENERIC_INST) and not is_opt_res_m:
                                    if rue3.name_id != 0 as u32:
                                        let rmangled = self.intern.get(rue3.name_id)
                                        rec_base = extract_base_name(rmangled)
                                        safe_free_str(rmangled)
                                        if not (rec_base == "Option" or rec_base == "Result"):
                                            self_aware = true
                                if self_aware:
                                    if self.has_method_for_base(mname, rec_base):
                                        name_exists = true
                                else:
                                    mut si := 0 as i64
                                    while si < self.symtable.symbols.len:
                                        let ssym = self.symtable.symbols.data[si]
                                        if ssym.kind == SYM_FUNC and self.intern.name_matches_method(ssym.name_id, mname):
                                            name_exists = true
                                            break
                                        si = si + 1 as i64
                                if rue3.name_id != 0 as u32 and not is_opt_res_m and (rue3.kind == TYPE_KIND_STRUCT or rue3.kind == TYPE_KIND_SUM or rue3.kind == TYPE_KIND_GENERIC_INST):
                                    safe_free_str(rec_base)
                            if not name_exists:
                                // A builtin PRIMITIVE receiver (str/bytes/int/...) has an
                                // empty type name_id, so print a type-less variant rather
                                // than a stray `on type ''` (e.g. `s.bytes()` on a str).
                                let tname = self.intern.get(rue3.name_id)
                                if std.string.len(tname) == 0 as i64:
                                    ax_printf_local("error: no method '%s' on this value\n", get_str_ptr(mname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                else:
                                    ax_printf_local("error: no method '%s' on type '%s'\n", get_str_ptr(mname) as i64, get_str_ptr(tname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                safe_free_str(tname)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(mname)

            // Infer arguments. For a fixed-array PARAMETER of a plain free function, pass
            // the param type as the arg's expected type so a direct `[..]` literal coerces
            // to the declared element type (a bare-int literal otherwise defaults to
            // [i32;N] and mismatches an [i64;N] param). If the arg is STILL a different
            // fixed-array type (e.g. a variable `let x = [1,2,3]` => [i32;3] passed to an
            // [i64;3] param), that is a genuine element/length mismatch that would silently
            // miscompile the callee's OP_INDEX stride -> reject cleanly (BUG#53 convention).
            // Gated to NODE_IDENT, non-generic callees (free functions have no `self`
            // param and concrete param types), so method/generic arg positions are never
            // misaligned; scoped to array<->array so all other args are untouched. Since no
            // bundled code uses fixed-array params, the self-host fixpoint is unaffected.
            // Struct-constructor ARRAY-field coercion: for `S(f: [<int literals>])`, infer
            // the field value with the field's DECLARED array type as the expected type so
            // the inline literal coerces to the field's element type. Otherwise a bare-int
            // literal defaults to [i32;N] and the element `store`s use the i32 stride (4)
            // into an [i64;N] field slot (8) -> the field's memory layout is corrupted
            // (silent miscompile). try_instantiate_struct_ctor already coerces GENERIC-struct
            // field values; NON-generic ctors early-return there, so cover them here via the
            // same fields<->args lockstep walk. Scoped to ARRAY fields only (scalar/ptr/
            // struct field values keep their prior UNKNOWN inference, so an int literal in a
            // scalar field is NOT silently retyped -> self-host fixpoint unaffected).
            mut did_ctor_args := false
            if self.tree.nodes.data[callee].kind == NODE_IDENT and callee_type != TYPE_UNKNOWN and (callee_type as i64) < self.types.entries.len:
                let se = self.types.entries.data[callee_type as i64]
                if se.kind == TYPE_KIND_STRUCT and (se.extra as i64) < self.types.structs.len:
                    // Struct's RESOLVED field types (StructInfo, tree-independent). Named
                    // args are assigned POSITIONALLY by the backend (see BUG#21), so arg N
                    // pairs with field N; match by position here to stay consistent.
                    let si = self.types.structs.data[se.extra as i64]
                    did_ctor_args = true
                    mut carg := self.tree.nodes.data[callee].next_sibling
                    mut fpos := 0 as i64
                    while carg != 0 as u32:
                        mut vnode := carg
                        if self.tree.nodes.data[carg as i64].kind == NODE_NAMED_ARG:
                            vnode = self.tree.nodes.data[carg as i64].first_child
                        mut vexp := TYPE_UNKNOWN
                        if fpos < si.fields.len:
                            let fty = si.fields.data[fpos].type_id
                            if fty != TYPE_UNKNOWN and (fty as i64) < self.types.entries.len:
                                let fk = self.types.entries.data[fty as i64].kind
                                if fk == TYPE_KIND_ARRAY:
                                    vexp = fty
                                elif fty == TYPE_F32:
                                    // An f32 scalar field: pass f32 as expected so a float
                                    // literal (`P(x: 40.0)`) is typed f32 and materialized as
                                    // single (movd, 4B) instead of a DOUBLE (8B) that overflows
                                    // the 4-byte field slot / reads back wrong via single-
                                    // precision loads -> 0 (silent miscompile, same class as the
                                    // f32-boundary literal bug). Scoped to F32 only, so int/i64
                                    // scalar fields keep their prior UNKNOWN inference and the
                                    // self-host fixpoint is unaffected. [[bug-f32-boundary-abi-open]]
                                    vexp = fty
                                elif fk == TYPE_KIND_STRUCT:
                                    // RFC 0022: a TUPLE-typed field — pass its declared type so a
                                    // `(a, b)` literal coerces its elements to the field's element
                                    // types. Without this the literal defaults to {i32,i32} (8B) and
                                    // is stored into an {i64,i64} (16B) field slot, so the second
                                    // element reads garbage. Guarded to `__tup` structs (never a
                                    // named struct field, whose value is a distinct constructor).
                                    let fnm = self.intern.get(self.types.entries.data[fty as i64].name_id)
                                    if std.string.starts_with(fnm, "__tup"):
                                        vexp = fty
                                    safe_free_str(fnm)
                        if vnode != 0 as u32:
                            self.infer_node(vnode, vexp)
                        carg = self.tree.nodes.data[carg as i64].next_sibling
                        fpos = fpos + 1 as i64
            // Infer arguments. For a fixed-array PARAMETER of a plain free function, pass
            // the param type as the arg's expected type so a direct `[..]` literal coerces
            // to the declared element type (a bare-int literal otherwise defaults to
            // [i32;N] and mismatches an [i64;N] param). If the arg is STILL a different
            // fixed-array type (e.g. a variable `let x = [1,2,3]` => [i32;3] passed to an
            // [i64;3] param), that is a genuine element/length mismatch that would silently
            // miscompile the callee's OP_INDEX stride -> reject cleanly (BUG#53 convention).
            // Gated to NODE_IDENT, non-generic callees (free functions have no `self`
            // param and concrete param types), so method/generic arg positions are never
            // misaligned; scoped to array<->array so all other args are untouched. Since no
            // bundled code uses fixed-array params, the self-host fixpoint is unaffected.
            mut fp_data := null as ptr[u32]
            mut fp_len := 0 as i64
            if not did_ctor_args and not is_generic_call and self.tree.nodes.data[callee].kind == NODE_IDENT and callee_type != TYPE_UNKNOWN and (callee_type as i64) < self.types.entries.len:
                let ce = self.types.entries.data[callee_type as i64]
                if ce.kind == TYPE_KIND_FUNC and (ce.extra as i64) < self.types.funcs.len:
                    let fi2 = self.types.funcs.data[ce.extra as i64]
                    fp_data = fi2.params.data
                    fp_len = fi2.params.len
            if not did_ctor_args:
                mut arg := self.tree.nodes.data[callee].next_sibling
                mut apos := 0 as i64
                while arg != 0 as u32:
                    mut pexp := TYPE_UNKNOWN
                    mut param_is_arr := false
                    mut param_is_tup := false
                    if fp_data != null as ptr[u32] and apos < fp_len:
                        let cand = fp_data[apos]
                        if cand != TYPE_UNKNOWN and (cand as i64) < self.types.entries.len:
                            let ck = self.types.entries.data[cand as i64].kind
                            if ck == TYPE_KIND_ARRAY:
                                pexp = cand
                                param_is_arr = true
                            elif cand == TYPE_F32:
                                // An f32 scalar param: pass f32 as expected so a float
                                // literal arg (`takef(40.0)`) is typed f32 and materialized
                                // as single instead of a DOUBLE -> read back wrong at the
                                // f32 param slot -> 0 (same class as the f32-boundary literal
                                // bug). Scoped to F32, so int scalar params keep prior UNKNOWN
                                // inference; fixpoint-safe. [[bug-f32-boundary-abi-open]]
                                pexp = cand
                            elif ck == TYPE_KIND_STRUCT:
                                // RFC 0022 P2: a tuple param — pass its type so a direct
                                // `(a, b)` literal arg coerces its elements to the param's
                                // field types (else int-literal elements default to i32 and
                                // an {i32,i32} value is stored into an {i64,i64} slot).
                                let cnm = self.intern.get(self.types.entries.data[cand as i64].name_id)
                                if std.string.starts_with(cnm, "__tup"):
                                    pexp = cand
                                    param_is_tup = true
                                safe_free_str(cnm)
                    let at = self.infer_node(arg, pexp)
                    if param_is_arr and at != pexp and at != TYPE_UNKNOWN and (at as i64) < self.types.entries.len and self.types.entries.data[at as i64].kind == TYPE_KIND_ARRAY:
                        ax_printf_local("error: array argument type mismatch: this argument is a different fixed-array type than the parameter (different element type or length); annotate the local `let x: [T;N] = ..` or cast the elements to match\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    // RFC 0022 P2 (BUG#53 convention): a tuple ARG whose type still differs
                    // from the tuple PARAM after coercion (e.g. an unannotated `let t=(10,15)`
                    // is {i32,i32} passed to an {i64,i64} param) would silently store the wrong
                    // width -> reject with an actionable message instead of miscompiling.
                    if param_is_tup and at != pexp and at != TYPE_UNKNOWN and (at as i64) < self.types.entries.len and self.types.entries.data[at as i64].kind == TYPE_KIND_STRUCT:
                        let atnm = self.intern.get(self.types.entries.data[at as i64].name_id)
                        let at_is_tup = std.string.starts_with(atnm, "__tup")
                        safe_free_str(atnm)
                        if at_is_tup:
                            ax_printf_local("error: tuple argument type mismatch: this argument's element types differ from the parameter's; annotate the local `let x: (T0, T1) = ..` or pass the tuple literal directly so its elements coerce\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            self.diags_count = self.diags_count + 1 as i64
                    arg = self.tree.nodes.data[arg].next_sibling
                    apos = apos + 1 as i64
                
    elif kind == NODE_IDENT:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        let is_substituted := ((self.tree.nodes.data[node_idx].flags & FLAG_IS_SUBSTITUTED) != 0 as u16)
        mut is_sym := false
        if not is_substituted:
            is_sym = (sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len)
        if is_sym:
            result_type = self.symtable.symbols.data[sym_idx].type_id
        if result_type == TYPE_UNKNOWN:
            mut text := ""
            if is_substituted:
                if sym_idx != 0 as u32:
                    let cand_text = self.intern.get(sym_idx)
                    if (cand_text == "i8" or cand_text == "i16" or cand_text == "i32" or cand_text == "int" or
                        cand_text == "i64" or cand_text == "u8" or cand_text == "u16" or cand_text == "u32" or cand_text == "rune" or
                        cand_text == "u64" or cand_text == "f32" or cand_text == "f64" or cand_text == "bool" or
                        cand_text == "str" or cand_text == "string" or cand_text == "bytes" or cand_text == "char" or cand_text == "void" or
                        cand_text == "isize" or cand_text == "usize"):
                        text = cand_text
                    else:
                        mut resolved_type_id := 0 as u32
                        mut resolved_sym := self.symtable.resolve(sym_idx)
                        if resolved_sym == 0 as u32:
                            resolved_sym = self.symtable.resolve_global_fallback(sym_idx)
                        if resolved_sym != 0 as u32 and (resolved_sym as i64) < self.symtable.symbols.len:
                            mut sym := self.symtable.symbols.data[resolved_sym]
                            if sym.kind == SYM_GENERIC_PARAM:
                                if sym.type_id == 0 as u32:
                                    let gen_type = self.types.register_generic(sym.name_id)
                                    self.symtable.symbols.data[resolved_sym].type_id = gen_type
                                    sym.type_id = gen_type
                            if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
                                sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
                                sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
                                resolved_type_id = sym.type_id
                                if resolved_type_id == 0 as u32:
                                    let full_name = self.get_full_mangled_name(resolved_sym)
                                    resolved_type_id = self.parse_type_from_name(full_name)
                                    safe_free_str(full_name)
                        if resolved_type_id == 0 as u32:
                            resolved_type_id = self.parse_type_from_name(cand_text)
                        result_type = resolved_type_id
                        safe_free_str(cand_text)
            else:
                text = self.node_text(node_idx)
            if text == "i8":
                result_type = 1 as u32
            elif text == "i16":
                result_type = 2 as u32
            elif text == "i32" or text == "int":
                result_type = 3 as u32
            elif text == "i64":
                result_type = 4 as u32
            elif text == "u8":
                result_type = 5 as u32
            elif text == "u16":
                result_type = 6 as u32
            elif text == "u32" or text == "rune":
                result_type = 7 as u32
            elif text == "u64":
                result_type = 8 as u32
            elif text == "f32":
                result_type = 9 as u32
            elif text == "f64":
                result_type = 10 as u32
            elif text == "bool":
                result_type = 11 as u32
            elif text == "str" or text == "string":
                result_type = 12 as u32
            elif text == "bytes":
                result_type = 22 as u32
            elif text == "char":
                result_type = 13 as u32
            elif text == "void":
                result_type = 14 as u32
            elif text == "isize":
                result_type = 15 as u32
            elif text == "usize":
                result_type = 16 as u32
            safe_free_str(text)
        // Fallback for a substituted tuple type param (see NODE_TYPE_EXPR below):
        // `__tupN` has no resolvable symbol; recover the type_id the monomorphizer
        // stashed in extra_idx.
        if result_type == TYPE_UNKNOWN and is_substituted:
            let sub_tid = self.tree.nodes.data[node_idx].extra_idx
            if sub_tid != 0 as u32:
                result_type = sub_tid as u32

        // BUG#53: a bare value-position identifier the resolver could NOT bind (it
        // forced payload to 0) and that did not recover as a builtin type name is an
        // UNDEFINED name. Previously its raw name_id was left as payload, accidentally
        // indexing an unrelated symbol -> silent garbage/0 at runtime. Reject cleanly
        // (bumps diags_count; the driver halts before codegen). Gated on payload==0
        // (only the resolver's unresolved path produces this) AND result_type still
        // UNKNOWN AND not substituted -- a type name used as a value already set
        // result_type above, so it is never hit here. Self-build safe: the compiler's
        // own source has zero unresolved bare idents. See [[bug-undefined-name-accept]].
        if result_type == TYPE_UNKNOWN and not is_substituted and self.tree.nodes.data[node_idx].payload == 0 as u32:
            let uname = self.node_text(node_idx)
            if uname != "":
                ax_printf_local("error: undefined name '%s'\n", get_str_ptr(uname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.diags_count = self.diags_count + 1 as i64
            safe_free_str(uname)

    elif kind == NODE_TYPE_EXPR:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        let is_substituted := ((self.tree.nodes.data[node_idx].flags & FLAG_IS_SUBSTITUTED) != 0 as u16)
        mut is_sym := false
        if not is_substituted:
            is_sym = (sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len)
        if is_sym:
            mut sym := self.symtable.symbols.data[sym_idx]
            if sym.kind == SYM_GENERIC_PARAM:
                if sym.type_id == 0 as u32:
                    let gen_type = self.types.register_generic(sym.name_id)
                    self.symtable.symbols.data[sym_idx].type_id = gen_type
                    sym.type_id = gen_type
            if sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE:
                result_type = sym.type_id
            
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let inner = self.infer_node(child, TYPE_UNKNOWN)
            if result_type == TYPE_UNKNOWN:
                result_type = inner
                 
        if result_type == TYPE_UNKNOWN:
            mut text := ""
            if sym_idx != 0 as u32 and sym_idx <= self.intern.state.count as u32:
                let cand_text = self.intern.get(sym_idx)
                if (cand_text == "i8" or cand_text == "i16" or cand_text == "i32" or cand_text == "int" or
                    cand_text == "i64" or cand_text == "u8" or cand_text == "u16" or cand_text == "u32" or
                    cand_text == "u64" or cand_text == "f32" or cand_text == "f64" or cand_text == "bool" or
                    cand_text == "str" or cand_text == "string" or cand_text == "char" or cand_text == "void" or
                    cand_text == "isize" or cand_text == "usize"):
                    text = cand_text
                else:
                    mut resolved_sym := self.symtable.resolve(sym_idx)
                    if resolved_sym == 0 as u32:
                        resolved_sym = self.symtable.resolve_global_fallback(sym_idx)
                    if resolved_sym != 0 as u32 and (resolved_sym as i64) < self.symtable.symbols.len:
                        mut sym := self.symtable.symbols.data[resolved_sym]
                        if sym.kind == SYM_GENERIC_PARAM:
                            if sym.type_id == 0 as u32:
                                let gen_type = self.types.register_generic(sym.name_id)
                                self.symtable.symbols.data[resolved_sym].type_id = gen_type
                                sym.type_id = gen_type
                        if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
                            sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
                            sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
                            result_type = sym.type_id
                            if result_type == 0 as u32:
                                let full_name = self.get_full_mangled_name(resolved_sym)
                                result_type = self.parse_type_from_name(full_name)
                                safe_free_str(full_name)
                    safe_free_str(cand_text)
            
            if result_type == TYPE_UNKNOWN and text == "":
                if is_sym:
                    text = self.intern.get(self.symtable.symbols.data[sym_idx].name_id)
                else:
                    text = self.node_text(node_idx)
            if text == "i8":
                result_type = 1 as u32
            elif text == "i16":
                result_type = 2 as u32
            elif text == "i32" or text == "int":
                result_type = 3 as u32
            elif text == "i64":
                result_type = 4 as u32
            elif text == "u8":
                result_type = 5 as u32
            elif text == "u16":
                result_type = 6 as u32
            elif text == "u32" or text == "rune":
                result_type = 7 as u32
            elif text == "u64":
                result_type = 8 as u32
            elif text == "f32":
                result_type = 9 as u32
            elif text == "f64":
                result_type = 10 as u32
            elif text == "bool":
                result_type = 11 as u32
            elif text == "str" or text == "string":
                result_type = 12 as u32
            elif text == "bytes":
                result_type = 22 as u32
            elif text == "char":
                result_type = 13 as u32
            elif text == "void":
                result_type = 14 as u32
            elif text == "isize":
                result_type = 15 as u32
            elif text == "usize":
                result_type = 16 as u32
            safe_free_str(text)
        // Fallback for a substituted tuple type param: `__tupN` has no resolvable
        // symbol, so the name-based resolution above yields UNKNOWN. The monomorphizer
        // stashed the exact concrete type_id in extra_idx — recover it directly.
        if result_type == TYPE_UNKNOWN and is_substituted:
            let sub_tid = self.tree.nodes.data[node_idx].extra_idx
            if sub_tid != 0 as u32:
                result_type = sub_tid as u32

    elif kind == NODE_GENERIC_TYPE:
        let base_idx = self.tree.nodes.data[node_idx].first_child
        if base_idx != 0 as u32:
            let base_node = self.tree.nodes.data[base_idx]
            let base_name = self.node_text(base_idx)
            let name_id = self.intern.intern(base_name)
            safe_free_str(base_name)
            // Check if name is ptr
            let text = self.intern.get(name_id)
            let ptr_text = text as ptr[u8]
            mut is_ptr := false
            mut is_slice := false
            if std.string.len(text) == 3 as i64 and ptr_text[0] == 'p' as u8 and ptr_text[1] == 't' as u8 and ptr_text[2] == 'r' as u8:
                is_ptr = true
            elif std.string.len(text) == 5 as i64 and ptr_text[0] == 's' as u8 and ptr_text[1] == 'l' as u8 and ptr_text[2] == 'i' as u8 and ptr_text[3] == 'c' as u8 and ptr_text[4] == 'e' as u8:
                is_slice = true

            if is_ptr:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    let inner = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    result_type = self.types.register_pointer(inner)
            elif is_slice:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    let inner = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    result_type = self.types.register_slice(inner)
            else:
                // User-defined generic template (like Array or Map)
                let sym_idx = base_node.payload
                if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                    let sym = self.symtable.symbols.data[sym_idx as i64]
                    mut src_tree := self.tree
                    if (sym_idx as i64) < self.symtable.symbol_trees.len:
                        let t = self.symtable.symbol_trees.data[sym_idx]
                        if t != null as ptr[AstTree]:
                            src_tree = t
                    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16):
                        // Collect concrete type arguments
                        mut args := new_u32_vec()
                        mut arg_idx := base_node.next_sibling
                        while arg_idx != 0 as u32:
                            let arg_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                            args.push(arg_type)
                            arg_idx = self.tree.nodes.data[arg_idx].next_sibling

                        result_type = self.finish_generic_instantiation(sym_idx, args)
    elif kind == NODE_UNARY_EXPR:
        let operand = self.tree.nodes.data[node_idx].first_child
        if operand != 0 as u32:
            let operand_type = self.infer_node(operand, expected)
            let op = self.node_text(node_idx)
            if op == "&":
                result_type = self.types.register_pointer(operand_type)
            elif op == "not" or op == "!":
                result_type = TYPE_BOOL
            else:
                result_type = operand_type

    elif kind == NODE_DEREF_EXPR:
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let child_type = self.infer_node(child, TYPE_UNKNOWN)
            if child_type != TYPE_UNKNOWN:
                let entry = self.types.entries.data[child_type]
                if entry.kind == TYPE_KIND_POINTER:
                    result_type = entry.extra
                else:
                    result_type = child_type

    elif kind == NODE_INT_LIT:
        if expected == TYPE_I8 or expected == TYPE_I16 or expected == TYPE_I32 or expected == TYPE_I64 or expected == TYPE_U8 or expected == TYPE_U16 or expected == TYPE_U32 or expected == TYPE_U64 or expected == TYPE_F32 or expected == TYPE_F64 or expected == TYPE_ISIZE or expected == TYPE_USIZE:
            result_type = expected
        else:
            result_type = TYPE_I32
            
    elif kind == NODE_FLOAT_LIT:
        // Coerce a float literal to the expected float type, mirroring the integer
        // literal path above. Without this a literal in an f32 context (`let v: f32
        // = 42.0`, an f32 param/return) stayed TYPE_F64, so air_builder materialized
        // it as a DOUBLE (OP_FCONST 64-bit, movq) — consistent for LOCAL use (every
        // op treated it as f64) but WRONG at a function boundary, where the f32 ABI
        // reads XMM0 as single (movss) -> the low 32 bits of the double -> garbage/0
        // (silent miscompile, BUG#53 class). Typing the literal f32 makes air narrow
        // it to single (movd, 32-bit) so the value is genuinely single-precision
        // everywhere. Only f32-expected changes; f64 keeps TYPE_F64 (fixpoint-safe —
        // the compiler source has no f32 literals). [[bug-f32-boundary-abi-open]]
        if expected == TYPE_F32:
            result_type = TYPE_F32
        elif expected == TYPE_UNKNOWN and (node_idx as i64) < self.node_types_cap and self.node_types[node_idx as i64] == TYPE_F32:
            // Sticky guard (mirrors the tuple coercion below): an enclosing context may
            // infer this literal TWICE — once with expected f32 (a generic arg re-inferred
            // to its resolved f32 param type, `Vec[f32].push(40.0)`) and again later with
            // UNKNOWN. Without this, the hint-less re-visit reverts it to f64 and air
            // materializes a DOUBLE again -> the f32 slot reads 0. Keep a prior f32 pin.
            result_type = TYPE_F32
        else:
            result_type = TYPE_F64

    elif kind == NODE_STRING_LIT:
        result_type = TYPE_STRING
        
    elif kind == NODE_BOOL_LIT:
        result_type = TYPE_BOOL
        
    elif kind == NODE_CHAR_LIT:
        result_type = TYPE_CHAR8

    elif kind == NODE_ARRAY_LIT:
        // `[e0, e1, ...]`. Element type comes from the first element (each
        // further element is inferred with that same expected-type hint, so
        // int/float literals coerce like any other typed context); falls
        // back to i32 for an empty literal, mirroring NODE_INT_LIT's default.
        mut expected_elem := TYPE_UNKNOWN
        if expected != TYPE_UNKNOWN and (expected as i64) < self.types.entries.len:
            let exp_entry = self.types.entries.data[expected as i64]
            if exp_entry.kind == TYPE_KIND_ARRAY:
                expected_elem = exp_entry.extra as u32
        mut elem_type := expected_elem
        mut count := 0 as u32
        mut mixed_strnum := false
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let ck = self.tree.nodes.data[child].kind
            let et = self.infer_node(child, elem_type)
            if elem_type == TYPE_UNKNOWN:
                elem_type = et
            else:
                // BUG#53: an array literal mixing string and numeric elements
                // (`[1, 2, "three"]`) was accepted -- a str stuffed into a numeric
                // array (or vice versa) -> garbage. Reject. Literal-gated on the
                // element's node kind (unambiguous), so real element coercions
                // (int-lit -> the array's int width, etc.) are untouched.
                // See [[bug-malformed-input-robustness-cluster]].
                let el_str = elem_type == TYPE_STRING or elem_type == TYPE_BYTES
                let el_num = elem_type >= TYPE_I8 and elem_type <= TYPE_USIZE and elem_type != TYPE_STRING and elem_type != TYPE_VOID
                let c_strlit = ck == NODE_STRING_LIT
                let c_numlit = ck == NODE_INT_LIT or ck == NODE_FLOAT_LIT
                if (el_num and c_strlit) or (el_str and c_numlit):
                    mixed_strnum = true
            count = count + 1 as u32
            child = self.tree.nodes.data[child].next_sibling
        if mixed_strnum:
            ax_printf_local("error: array literal mixes string and numeric elements\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            self.diags_count = self.diags_count + 1 as i64
        if elem_type == TYPE_UNKNOWN:
            elem_type = TYPE_I32
        result_type = self.types.register_array(elem_type, count)

    elif kind == NODE_TUPLE_EXPR:
        // RFC 0022: a tuple literal `(e0, e1, ...)` is an anonymous struct with
        // positional fields `_f0`, `_f1`, ... Lowered/typed via the struct machinery.
        //
        // Element COERCION by an expected tuple type (RFC 0022 P2): when the context
        // supplies an expected tuple type of the same arity (an annotated `let`, a
        // param, a `-> (T..)` return, a tuple global init), infer each element with the
        // matching field type as its hint and adopt that type. Without this, integer
        // literals default to i32, so `let p:(i64,i64)=(10,20)` would store an 8-byte
        // {i32,i32} into a 16-byte {i64,i64} slot and read the second field as garbage.
        let first_child = self.tree.nodes.data[node_idx].first_child
        mut used_expected := false
        // Sticky coercion: an enclosing context may infer this tuple TWICE — once with
        // a concrete expected `__tup` (e.g. the payload of `Some((10,20))` for an
        // `Option[(i64,i64)]` return) and again later with UNKNOWN (a generic arg-type
        // re-visit). Without this guard the second, hint-less visit re-registers the
        // default `{i32,i32}` and — because that write lands last — the element stores
        // narrow to 4 bytes and the 2nd field reads garbage. If a prior visit already
        // pinned this node to a concrete `__tup`, keep it and leave the already-coerced
        // element node-types intact.
        if expected == TYPE_UNKNOWN and (node_idx as i64) < self.node_types_cap:
            let prior = self.node_types[node_idx as i64]
            if prior != TYPE_UNKNOWN and (prior as i64) < self.types.entries.len:
                let pe = self.types.entries.data[prior as i64]
                if pe.kind == TYPE_KIND_STRUCT:
                    let pnm = self.intern.get(pe.name_id)
                    let prior_is_tup = std.string.starts_with(pnm, "__tup")
                    safe_free_str(pnm)
                    if prior_is_tup:
                        result_type = prior
                        used_expected = true
        // Element COERCION by an expected tuple type (RFC 0022 P2): when the context
        // supplies an expected tuple type of the same arity (an annotated `let`, a
        // param, a `-> (T..)` return, a tuple global init), infer each element with the
        // matching field type as its hint and adopt that type. Without this, integer
        // literals default to i32, so `let p:(i64,i64)=(10,20)` would store an 8-byte
        // {i32,i32} into a 16-byte {i64,i64} slot and read the second field as garbage.
        if not used_expected and expected != TYPE_UNKNOWN and (expected as i64) < self.types.entries.len:
            let ee = self.types.entries.data[expected as i64]
            if ee.kind == TYPE_KIND_STRUCT and (ee.extra as i64) < self.types.structs.len:
                let enm = self.intern.get(ee.name_id)
                let exp_is_tup = std.string.starts_with(enm, "__tup")
                safe_free_str(enm)
                let einfo = self.types.structs.data[ee.extra as i64]
                mut nchild := 0 as i64
                mut cc := first_child
                while cc != 0 as u32:
                    nchild = nchild + 1 as i64
                    cc = self.tree.nodes.data[cc].next_sibling
                if exp_is_tup and einfo.fields.len == nchild:
                    mut child2 := first_child
                    mut j2 := 0 as i64
                    while child2 != 0 as u32:
                        self.infer_node(child2, einfo.fields.data[j2].type_id)
                        child2 = self.tree.nodes.data[child2].next_sibling
                        j2 = j2 + 1 as i64
                    result_type = expected
                    used_expected = true
        if not used_expected:
            result_type = self.register_tuple_type(first_child)

    elif kind == NODE_NIL_LIT:
        if expected != TYPE_UNKNOWN:
            result_type = expected
        else:
            result_type = TYPE_UNKNOWN
        
    elif kind == NODE_CAST_EXPR:
        let expr = self.tree.nodes.data[node_idx].first_child
        mut target_type := TYPE_UNKNOWN
        if expr != 0 as u32:
            let target_node = self.tree.nodes.data[expr].next_sibling
            if target_node != 0 as u32:
                target_type = self.infer_node(target_node, TYPE_UNKNOWN)
            self.infer_node(expr, target_type)
        if target_type != TYPE_UNKNOWN:
            self.tree.nodes.data[node_idx].payload = target_type
            result_type = target_type
        else:
            result_type = self.tree.nodes.data[node_idx].payload

    elif kind == NODE_FIELD_EXPR:
        if (self.tree.nodes.data[node_idx].flags & 2048 as u16) != 0 as u16:
            let obj = self.tree.nodes.data[node_idx].first_child
            if obj != 0 as u32:
                self.infer_node(obj, TYPE_UNKNOWN)
            let sym_idx = self.tree.nodes.data[node_idx].payload
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                result_type = self.symtable.symbols.data[sym_idx].type_id
        else:
            let obj = self.tree.nodes.data[node_idx].first_child
            if obj != 0 as u32:
                let field_name_id = self.tree.nodes.data[node_idx].payload
                mut is_builtin_new := false
                if field_name_id != 0 as u32:
                    let field_name = self.intern.get(field_name_id)
                    if field_name == "new":
                        mut base_node_idx := obj
                        let base_kind = self.tree.nodes.data[obj].kind
                        if base_kind == NODE_GENERIC_TYPE or base_kind == NODE_INDEX_EXPR:
                            let first = self.tree.nodes.data[obj].first_child
                            if first != 0 as u32:
                                base_node_idx = first
                        
                        mut obj_name := ""
                        let base_node = self.tree.nodes.data[base_node_idx]
                        if base_node.kind == NODE_IDENT or base_node.kind == NODE_TYPE_EXPR:
                            let payload_val = base_node.payload
                            if payload_val != 0 as u32:
                                if (payload_val as i64) < self.symtable.symbols.len:
                                    obj_name = self.intern.get(self.symtable.symbols.data[payload_val].name_id)
                                else:
                                    obj_name = self.intern.get(payload_val)
                        else:
                            obj_name = self.node_text(base_node_idx)
                        
                        mut is_collection := false
                        if obj_name == "Vec" or std.string.ends_with(obj_name, ".Vec") or std.string.contains(obj_name, ".Vec__") or std.string.contains(obj_name, "__Vec"):
                            is_collection = true
                        elif obj_name == "HashMap" or std.string.ends_with(obj_name, ".HashMap") or std.string.contains(obj_name, ".HashMap__") or std.string.contains(obj_name, "__HashMap"):
                            is_collection = true
                        elif obj_name == "HashSet" or std.string.ends_with(obj_name, ".HashSet") or std.string.contains(obj_name, ".HashSet__") or std.string.contains(obj_name, "__HashSet"):
                            is_collection = true
                        elif obj_name == "Option" or std.string.ends_with(obj_name, ".Option") or std.string.contains(obj_name, ".Option__") or std.string.contains(obj_name, "__Option"):
                            is_collection = true
                        elif obj_name == "Result" or std.string.ends_with(obj_name, ".Result") or std.string.contains(obj_name, ".Result__") or std.string.contains(obj_name, "__Result"):
                            is_collection = true
                        
                        if is_collection:
                            is_builtin_new = true
                            let obj_type_resolved = self.infer_node(obj, TYPE_UNKNOWN)
                            let params_vec = U32Vec(data: null as ptr[u32], len: 0, cap: 0)
                            result_type = self.types.register_function(params_vec, obj_type_resolved)
                            self.set_node_type(node_idx, result_type)
                        
                        safe_free_str(obj_name)
                    safe_free_str(field_name)
                
                if not is_builtin_new:
                    mut obj_type := self.infer_node(obj, TYPE_UNKNOWN)
                    if obj_type != TYPE_UNKNOWN:
                        mut entry = self.types.entries.data[obj_type]
                        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                            obj_type = entry.extra
                            entry = self.types.entries.data[obj_type]
                        if obj_type == TYPE_STRING or obj_type == TYPE_BYTES:
                            // RFC 0020: `bytes` shares str's {ptr,len} layout, so `.ptr`/`.len`
                            // resolve identically (field 0 = ptr[u8], field 1 = i64 byte length).
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            let field_name = self.intern.get(field_name_id)
                            let ptr_field := field_name as ptr[u8]
                            mut is_ptr_field := false
                            mut is_len_field := false
                            if std.string.len(field_name) == 3 as i64 and ptr_field[0] == 'p' as u8 and ptr_field[1] == 't' as u8 and ptr_field[2] == 'r' as u8:
                                is_ptr_field = true
                            elif std.string.len(field_name) == 3 as i64 and ptr_field[0] == 'l' as u8 and ptr_field[1] == 'e' as u8 and ptr_field[2] == 'n' as u8:
                                is_len_field = true

                            if is_ptr_field:
                                result_type = self.types.register_pointer(5 as u32)
                                self.tree.nodes.data[node_idx].extra_idx = 0 as u32
                            elif is_len_field:
                                result_type = 4 as u32
                                self.tree.nodes.data[node_idx].extra_idx = 1 as u32
                            safe_free_str(field_name)
                        elif entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            mut found := false
                            if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
                                mut is_struct := false
                                mut struct_extra := entry.extra
                                if entry.kind == TYPE_KIND_STRUCT:
                                    is_struct = true
                                elif entry.kind == TYPE_KIND_GENERIC_INST:
                                    mut idx := 0 as i64
                                    while idx < self.types.entries.len:
                                        let e = self.types.entries.data[idx]
                                        let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                                        let entry_base = extract_qualified_base_name(self.intern.get(entry.name_id))
                                        let name_match = (e_base == entry_base)
                                        if e.kind == TYPE_KIND_STRUCT and name_match:
                                            struct_extra = e.extra
                                            is_struct = true
                                            break
                                        idx = idx + 1
                                if is_struct:
                                    let struct_info = &self.types.structs.data[struct_extra]
                                    mut j := 0 as i64
                                    while j < struct_info.fields.len:
                                        let f = struct_info.fields.data[j]
                                        if f.name_id == field_name_id:
                                            mut ft := f.type_id
                                            // Monomorphize a generic-param field type via the
                                            // instance's concrete args. Under an INFERRED generic
                                            // construction (`Box(v: 42)`, no explicit `Box[i64]`)
                                            // the receiver is a GENERIC_INST over the TEMPLATE, so
                                            // the field type read straight from the template is the
                                            // bare param placeholder `T` — not `i64`. Contexts that
                                            // impose an expected type (arith/fn-arg) papered over it,
                                            // but a method-form receiver imposes none, so `b.v.to_str()`
                                            // saw type `T` and rejected. Substitution is guarded to
                                            // ONLY remap a genuine TYPE_KIND_GENERIC placeholder that
                                            // matches a template param position (concrete field types
                                            // and monomorphized structs are left untouched — no-op).
                                            if entry.kind == TYPE_KIND_GENERIC_INST and (ft as i64) < self.types.entries.len and self.types.entries.data[ft as i64].kind == TYPE_KIND_GENERIC:
                                                let inst_args = self.get_generic_args(obj_type)
                                                let tmpl_params = &self.types.structs.data[struct_extra].generic_args
                                                if inst_args.len > 0 as i64 and inst_args.len == tmpl_params.len:
                                                    mut pi := 0 as i64
                                                    while pi < tmpl_params.len:
                                                        if tmpl_params.data[pi] == ft:
                                                            ft = inst_args.data[pi]
                                                            break
                                                        pi = pi + 1 as i64
                                                if inst_args.data != null as ptr[u32]:
                                                    @free(inst_args.data as ptr[u8])
                                            result_type = ft
                                            self.tree.nodes.data[node_idx].extra_idx = j as u32
                                            found = true
                                            break
                                        j = j + 1
                            // RFC 0004: qualified variant construction `EnumType.Variant`
                            // (e.g. `Color.Blue`, `Shape.Circle`). The base resolves to a user
                            // sum type; a matching variant NAMES a value of that sum. Bind the
                            // field-expr to the variant SYMBOL (flag 2048) and type it as the
                            // sum. A no-payload variant is a complete value — the lowerer builds
                            // it in `lower_field_expr`; a payload variant is completed by a call
                            // `EnumType.Ctor(x)` — the lowerer builds it in `lower_call_expr`.
                            if not found and entry.kind == TYPE_KIND_SUM:
                                let sum_extra = entry.extra
                                if (sum_extra as i64) < self.types.sumtypes.len:
                                    let vsum_info = self.types.sumtypes.data[sum_extra]
                                    mut vk := 0 as i64
                                    while vk < vsum_info.variants.len:
                                        let vinfo = vsum_info.variants.data[vk]
                                        if vinfo.name_id == field_name_id:
                                            mut vsi := 0 as i64
                                            while vsi < self.symtable.symbols.len:
                                                let cand = self.symtable.symbols.data[vsi]
                                                if cand.kind == SYM_VARIANT and cand.name_id == field_name_id and cand.type_id == obj_type:
                                                    result_type = obj_type
                                                    self.tree.nodes.data[node_idx].payload = vsi as u32
                                                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                                    found = true
                                                    break
                                                vsi = vsi + 1
                                            break
                                        vk = vk + 1
                            // If not found, check if it is a method or global function
                            if not found:
                                mut sym_idx := self.resolve_method_sym(field_name_id, obj_type)
                                if sym_idx != 0 as u32:
                                    let sym = self.symtable.symbols.data[sym_idx]
                                    result_type = sym.type_id
                                    self.tree.nodes.data[node_idx].payload = sym_idx
                                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                else:
                                    // Diagnostic (was silent accept-then-miscompile,
                                    // BUG#53/68/81/93 class): `recv.name` (value load)
                                    // where `name` is neither a field of recv's struct,
                                    // a variant, nor a method/UFCS free fn. air_builder
                                    // then loaded field offset 0 / a garbage address ->
                                    // wrong value or SIGSEGV, no signal (e.g. `c.zzz`
                                    // reads `c.x`). SAFETY: like the undefined-method
                                    // fix, use a RECEIVER-AGNOSTIC test (reject only when
                                    // NO struct anywhere has a field of this name AND no
                                    // SYM_FUNC matches it) so cross-module field-list
                                    // timing never false-positives a valid access.
                                    let mnm = self.intern.get(field_name_id)
                                    mut member_exists := false
                                    mut sfi := 0 as i64
                                    while sfi < self.types.structs.len and not member_exists:
                                        let sinfo = self.types.structs.data[sfi]
                                        mut ffi := 0 as i64
                                        while ffi < sinfo.fields.len:
                                            if sinfo.fields.data[ffi].name_id == field_name_id:
                                                member_exists = true
                                                break
                                            ffi = ffi + 1 as i64
                                        sfi = sfi + 1 as i64
                                    if not member_exists:
                                        mut mi := 0 as i64
                                        while mi < self.symtable.symbols.len:
                                            let msym = self.symtable.symbols.data[mi]
                                            if msym.kind == SYM_FUNC and self.intern.name_matches_method(msym.name_id, mnm):
                                                member_exists = true
                                                break
                                            mi = mi + 1 as i64
                                    // The backend-intercepted Option/Result methods
                                    // (is_some/unwrap/...) have no method symbol, so the
                                    // scans above miss them -> false-reject on an OPTION/
                                    // RESULT-typed receiver (e.g. `arr[i].is_some()` where the
                                    // element types to a real OPTION). air_builder lowers them
                                    // by name; leave result UNKNOWN and let the call proceed.
                                    if not member_exists and (entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT) and (mnm == "unwrap" or mnm == "unwrap_err" or mnm == "is_some" or mnm == "is_none" or mnm == "is_ok" or mnm == "is_err"):
                                        member_exists = true
                                    if not member_exists:
                                        let tnm = self.intern.get(entry.name_id)
                                        ax_printf_local("error: no field or method '%s' on type '%s'\n", get_str_ptr(mnm) as i64, get_str_ptr(tnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        safe_free_str(tnm)
                                        self.diags_count = self.diags_count + 1 as i64
                                    safe_free_str(mnm)
                        elif entry.kind == TYPE_KIND_PRIMITIVE:
                            // Diagnostic (was silent accept-then-miscompile, BUG#53
                            // class): `n.foo` on a primitive scalar (i32/i64/.../bool/
                            // char/f64 -- str/bytes are handled by the `.ptr`/`.len`
                            // branch above). A primitive has no fields, and scalar UFCS
                            // method receivers are unsupported (a `scalar.method()` call
                            // segfaults too). This left result_type UNKNOWN and
                            // air_builder read field offset 0 / a garbage address ->
                            // SIGSEGV, no signal. SAFETY (mirrors the nonexistent-field
                            // fix): receiver-AGNOSTIC -- reject only when the member name
                            // matches NO struct field AND NO SYM_FUNC anywhere. Scanning
                            // struct fields too is essential: a value's type can be
                            // transiently a PRIMITIVE during inference (an operator-
                            // overload result `a + b` reads as its RHS scalar before the
                            // overload return type settles), so a member that is a real
                            // field of SOME struct must not be rejected here -- it is
                            // handled once the correct aggregate type resolves. `n.foo`
                            // (name nowhere) still rejects; `d.v` (v is a field of Num,
                            // d transiently typed i64) does not.
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            let pmn = self.intern.get(field_name_id)
                            mut pexists := false
                            mut psfi := 0 as i64
                            while psfi < self.types.structs.len and not pexists:
                                let psinfo = self.types.structs.data[psfi]
                                mut pffi := 0 as i64
                                while pffi < psinfo.fields.len:
                                    if psinfo.fields.data[pffi].name_id == field_name_id:
                                        pexists = true
                                        break
                                    pffi = pffi + 1 as i64
                                psfi = psfi + 1 as i64
                            mut pmi := 0 as i64
                            while pmi < self.symtable.symbols.len and not pexists:
                                let psym = self.symtable.symbols.data[pmi]
                                if psym.kind == SYM_FUNC and self.intern.name_matches_method(psym.name_id, pmn):
                                    pexists = true
                                    break
                                pmi = pmi + 1 as i64
                            if not pexists:
                                ax_printf_local("error: no member '%s' on a primitive value (primitives have no fields or methods)\n", get_str_ptr(pmn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(pmn)
                    else:
                        let sym_idx = self.symtable.resolve(self.tree.nodes.data[node_idx].payload)
                        if sym_idx != 0 as u32:
                            let sym = self.symtable.symbols.data[sym_idx]
                            result_type = sym.type_id
                    
    elif kind == NODE_INDEX_EXPR:
        let collection = self.tree.nodes.data[node_idx].first_child
        if collection != 0 as u32:
            mut is_generic_inst := false
            mut sym_idx := 0 as u32
            let col_node = self.tree.nodes.data[collection]
            if col_node.kind == NODE_IDENT:
                sym_idx = col_node.payload
            elif col_node.kind == NODE_FIELD_EXPR:
                if (col_node.flags & 2048 as u16) != 0 as u16:
                    sym_idx = col_node.payload
            
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                let sym = self.symtable.symbols.data[sym_idx]
                mut src_tree := self.tree
                if (sym_idx as i64) < self.symtable.symbol_trees.len:
                    let t = self.symtable.symbol_trees.data[sym_idx]
                    if t != null as ptr[AstTree]:
                        src_tree = t
                if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16):
                    is_generic_inst = true
            
            if is_generic_inst:
                let sym = self.symtable.symbols.data[sym_idx]
                mut args := new_u32_vec()
                mut arg_idx := col_node.next_sibling
                while arg_idx != 0 as u32:
                    let arg_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    args.push(arg_type)
                    arg_idx = self.tree.nodes.data[arg_idx].next_sibling
                
                mut has_generic_arg := false
                mut a_idx := 0 as i64
                while a_idx < args.len:
                    if self.is_generic(args.data[a_idx]):
                        has_generic_arg = true
                        break
                    a_idx = a_idx + 1

                if has_generic_arg:
                    result_type = self.types.register_generic_inst(sym.name_id, args)
                    // `f[T]` where `f` is a generic FUNCTION (not a type) and `T` is
                    // an enclosing type param is a function reference with explicit
                    // type args, NOT a type instantiation. Its type is the function's
                    // RETURN type (still symbolic pre-mono), not a generic-inst named
                    // after the fn. Without this override, `make[T]()` inside a generic
                    // body typed the result as GENERIC_INST("make") and `r.push(..)`
                    // failed with "no method 'push' on type 'make'". (register_generic_inst
                    // above already consumed `args`; we only reinterpret result_type.)
                    if sym.kind == SYM_FUNC:
                        mut fnty := sym.type_id
                        if fnty == TYPE_UNKNOWN and sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32:
                            self.pre_infer_func_signature(sym.decl_node)
                            fnty = self.symtable.symbols.data[sym_idx as i64].type_id
                        if fnty != TYPE_UNKNOWN and (fnty as i64) < self.types.entries.len:
                            let fe = self.types.entries.data[fnty as i64]
                            if fe.kind == TYPE_KIND_FUNC:
                                let fret = self.types.funcs.data[fe.extra].ret
                                if fret != TYPE_UNKNOWN and fret != 0 as u32:
                                    result_type = fret
                else:
                    mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
                    let mangled_name = mono.mangle_name_ov(sym_idx, self.intern.get(sym.name_id), args)
                    let mangled_id = self.intern.intern(mangled_name)
                    mut existing_type_id := 0 as u32
                    mut j_tt := 0 as i64
                    while j_tt < self.types.entries.len:
                        if self.types.entries.data[j_tt].name_id == mangled_id:
                            existing_type_id = j_tt as u32
                            break
                        j_tt = j_tt + 1 as i64

                    mut existing_sym_idx := self.symtable.resolve(mangled_id)
                    if existing_sym_idx == 0 as u32:
                        let proxy_sys_idx = self.symtable.resolve_global(mangled_id)
                        existing_sym_idx = proxy_sys_idx
                    
                    mut inst_sym_idx := 0 as u32
                    if existing_type_id != 0 as u32:
                        if existing_sym_idx != 0 as u32:
                            self.symtable.symbols.data[existing_sym_idx as i64].type_id = existing_type_id
                            inst_sym_idx = existing_sym_idx
                        else:
                            let new_sym = self.symtable.define(mangled_id, SYM_TYPE_ALIAS, 0 as u16, 0 as u32)
                            self.symtable.symbols.data[new_sym as i64].type_id = existing_type_id
                            inst_sym_idx = new_sym
                    elif existing_sym_idx != 0 as u32:
                        let existing_sym = self.symtable.symbols.data[existing_sym_idx]
                        if existing_sym.type_id != 0 as u32:
                            inst_sym_idx = existing_sym_idx
                    else:
                        let cloned_root = mono.instantiate_function(sym_idx, args)
                        self.tree.append_child(0 as u32, cloned_root)
                        
                        let saved_data = self.symtable.stack.data
                        let saved_len = self.symtable.stack.len
                        let saved_cap = self.symtable.stack.cap
                        mut temp_stack := new_u32_vec()
                        temp_stack.push(0 as u32)
                        if saved_len > 1:
                            temp_stack.push(saved_data[1])
                        self.symtable.stack = temp_stack
                        mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
                        resolver.resolve_node(cloned_root)
                        @free(self.symtable.stack.data as ptr[u8])
                        self.symtable.stack.data = saved_data
                        self.symtable.stack.len = saved_len
                        self.symtable.stack.cap = saved_cap
                        
                        let payload_sym = self.tree.nodes.data[cloned_root].payload
                        if payload_sym != 0 as u32:
                            inst_sym_idx = payload_sym
                        else:
                            mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                            if resolved_inst_sym == 0 as u32:
                                resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                            inst_sym_idx = resolved_inst_sym
                        
                        let cloned_kind = self.tree.nodes.data[cloned_root].kind
                        if cloned_kind == NODE_STRUCT_DECL and mono.struct_type_id != 0 as u32:
                            self.symtable.symbols.data[inst_sym_idx as i64].type_id = mono.struct_type_id
                        
                        if cloned_kind == NODE_STRUCT_DECL:
                            self.pre_infer_struct(cloned_root)
                            mut m_child := self.tree.nodes.data[cloned_root].first_child
                            while m_child != 0 as u32:
                                let mc = self.tree.nodes.data[m_child]
                                let next_sibling = mc.next_sibling
                                if mc.kind == NODE_FUNC_DECL:
                                    self.pre_infer_func_signature(m_child)
                                m_child = next_sibling
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                        elif cloned_kind == NODE_FUNC_DECL:
                            self.pre_infer_func_signature(cloned_root)
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                        elif cloned_kind == NODE_TYPE_ALIAS_DECL:
                            self.pre_infer_type_alias(cloned_root)
                            mut m_child := self.tree.nodes.data[cloned_root].first_child
                            while m_child != 0 as u32:
                                let mc = self.tree.nodes.data[m_child]
                                let next_sibling = mc.next_sibling
                                if mc.kind == NODE_FUNC_DECL:
                                    self.pre_infer_func_signature(m_child)
                                m_child = next_sibling
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                    
                    let inst_sym = self.symtable.symbols.data[inst_sym_idx]
                    result_type = inst_sym.type_id
                    
                    self.tree.nodes.data[node_idx].payload = inst_sym_idx
                    
                    if args.data != null as ptr[u32]:
                        @free(args.data as ptr[u8])
            else:
                let col_type = self.infer_node(collection, TYPE_UNKNOWN)
                let idx = self.tree.nodes.data[collection].next_sibling
                // RFC 0020 P3: `s[a..b]` on a str/bytes is a SUBSTRING slice.
                // `..` (TK_DOT_DOT) parses into a plain NODE_BINARY_EXPR (parser.ax's
                // parse_led treats it like +/-/etc; no dedicated range node exists) and
                // NODE_FOR_STMT is otherwise the only place that gives it meaning (loop
                // bounds). For a str/bytes base we now ACCEPT it: air_builder lowers it
                // to `std.string.slice(s, a, b)` (byte-indexed, Rust model, bounds-safe)
                // and the result is a fresh view of the SAME base type. For any other
                // base (BUG#72) it stays a hard reject -- used as a raw element offset it
                // is a real, reproducible segfault with no diagnostic.
                mut is_range_slice := false
                if idx != 0 as u32:
                    let idx_node = self.tree.nodes.data[idx]
                    if idx_node.kind == NODE_BINARY_EXPR:
                        let idx_op_text = self.node_text(idx)
                        if idx_op_text == "..":
                            if col_type == TYPE_STRING or col_type == TYPE_BYTES:
                                is_range_slice = true
                            else:
                                ax_printf_local("error: range-slicing ('a[x..y]') is not yet supported for this type; index must be a single value\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                        safe_free_str(idx_op_text)
                    self.infer_node(idx, TYPE_UNKNOWN)
                if is_range_slice:
                    result_type = col_type // str[a..b] -> str, bytes[a..b] -> bytes
                elif col_type != TYPE_UNKNOWN:
                    let c_entry = self.types.entries.data[col_type]
                    if c_entry.kind == TYPE_KIND_POINTER or c_entry.kind == TYPE_KIND_SLICE or c_entry.kind == TYPE_KIND_ARRAY:
                        result_type = c_entry.extra
                    elif col_type == TYPE_STRING or col_type == TYPE_BYTES:
                        result_type = 5 as u32 // str/bytes index -> u8 byte
                    elif c_entry.kind == TYPE_KIND_STRUCT or c_entry.kind == TYPE_KIND_GENERIC_INST:
                        // RFC 0021: `v[i]` on a `Vec[T]` evaluates to the element type T
                        // (== `vec.data[i]`; air_builder's lower_index_expr loads the
                        // `data` field before OP_INDEX). Previously this fell through
                        // UNKNOWN and OP_INDEX read the `{data,len,cap}` HEADER (`c[1]`
                        // returned the length; wide elements segfaulted) -- a silent
                        // miscompile (BUG#53 class, first closed by a reject in d94aa8e).
                        // Scoped to a Vec base name so ordinary pointer/array `.data[i]`
                        // indexing is untouched and the self-host fixpoint is A==B (the
                        // compiler never subscripts a Vec). Element type resolved the
                        // same way the for-in-vec binding does (get_generic_args[0]).
                        let cnm = self.intern.get(c_entry.name_id)
                        let cbase = extract_base_type_name(cnm)
                        if cbase == "Vec":
                            let vargs = self.get_generic_args(col_type)
                            if vargs.len >= 1 as i64:
                                result_type = vargs.data[0]
                            else:
                                ax_printf_local("error: cannot determine the element type of this Vec for `v[i]`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                        safe_free_str(cbase)
                        safe_free_str(cnm)
                    elif c_entry.kind == TYPE_KIND_PRIMITIVE and col_type != TYPE_STRING and col_type != TYPE_BYTES and col_type != TYPE_VOID and self.tree.nodes.data[collection].kind == NODE_IDENT:
                        // BUG#53: indexing a scalar VARIABLE (`x[0]` where x is i64/f64/
                        // bool/...) is not indexable -- air_builder emits OP_INDEX on the
                        // scalar value -> segfault (no diagnostic). Reject. GATED on the
                        // collection being a bare NODE_IDENT (a variable, whose declared
                        // type is reliable): infer_node imprecisely reports i64 for some
                        // str/array-returning CALLs (same trap as m2/m5), so a call
                        // collection is NOT trustworthy here and must not be rejected.
                        // Only arrays, Vec, str/bytes, pointers are indexable; the
                        // compiler's own source never subscripts a bare scalar var, so
                        // self-build is safe. See [[bug-malformed-input-robustness-cluster]].
                        ax_printf_local("error: cannot index a value of a non-indexable scalar type (only arrays, Vec, str/bytes, and pointers are indexable)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_COMPTIME:
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let child_type = self.infer_node(child, expected)
            if child_type == TYPE_UNKNOWN:
                result_type = TYPE_UNKNOWN
            else:
                let val = self.eval_comptime(child)
                mut lit_kind := NODE_INT_LIT
                mut val_str := ""
                mut tok_kind := TK_INT_LIT
                
                if val.kind == TYPE_BOOL:
                    lit_kind = NODE_BOOL_LIT
                    if val.bool_val:
                        val_str = "true"
                        tok_kind = TK_TRUE
                    else:
                        val_str = "false"
                        tok_kind = TK_FALSE
                elif val.kind == TYPE_STRING:
                    lit_kind = NODE_STRING_LIT
                    val_str = std.string.concat("\"", std.string.concat(val.str_val, "\""))
                    tok_kind = TK_STRING_LIT
                elif val.kind == TYPE_F64:
                    lit_kind = NODE_FLOAT_LIT
                    val_str = format_float(val.float_val)
                    tok_kind = TK_FLOAT_LIT
                else:
                    lit_kind = NODE_INT_LIT
                    val_str = format_int(val.int_val)
                    tok_kind = TK_INT_LIT
                
                let new_offset = std.string.len(self.tree.src) as u32
                self.tree.src = std.string.concat(self.tree.src, val_str)
                
                let new_tok_idx = self.tree.tokens.len as u32
                self.tree.tokens.push(Token(
                    kind: tok_kind,
                    padding: 0 as u8,
                    len: std.string.len(val_str) as u16,
                    offset: new_offset,
                ))
                
                // Mutate the AST node in-place
                self.tree.nodes.data[node_idx].kind = lit_kind
                self.tree.nodes.data[node_idx].token_idx = new_tok_idx
                self.tree.nodes.data[node_idx].first_child = NULL_IDX
                self.tree.nodes.data[node_idx].payload = val.kind
                
                result_type = val.kind
        else:
            result_type = TYPE_VOID

    elif kind == NODE_PTR_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
        result_type = self.types.register_pointer(inner_type)

    elif kind == NODE_SLICE_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
        result_type = self.types.register_slice(inner_type)

    elif kind == NODE_TUPLE_TYPE:
        // RFC 0022 P2: a tuple TYPE annotation resolves to the same anonymous struct
        // (fields _f0.._fN) as a tuple literal, so annotations, params, returns, and
        // globals interoperate with tuple literals through identical struct layout.
        result_type = self.register_tuple_type(self.tree.nodes.data[node_idx].first_child)

    elif kind == NODE_ARRAY_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
            // Builtin Option/Result are not user generic templates, so a
            // NODE_GENERIC_TYPE element leaves inner_type UNKNOWN -> the array element
            // falls back to a scalar and the 8-byte box pointer that the constructor
            // stores (pointer-repr, register_option/result kind 11/12, size 16) is
            // truncated on OP_STORE/OP_INDEX -> match/read segfaults. Resolve the real
            // pointer-repr aggregate HERE so both the store stride and OP_INDEX load
            // agree. Scoped to fixed-array ELEMENT position only: the compiler's own
            // source uses no `[Option;N]`/`[Result;N]` arrays, so the self-host fixpoint
            // is unaffected -- retyping Option/Result globally (annotations/ctors) instead
            // shifts every EQ/COPY/MAKE_REF path (RFC 0012) and breaks self-compilation.
            if inner_type == TYPE_UNKNOWN and self.tree.nodes.data[inner_node].kind == NODE_GENERIC_TYPE:
                let ib = self.tree.nodes.data[inner_node].first_child
                if ib != 0 as u32:
                    let ibname = self.node_text(ib)
                    if ibname == "Option":
                        let a1 = self.tree.nodes.data[ib].next_sibling
                        mut it := TYPE_UNKNOWN
                        if a1 != 0 as u32:
                            it = self.infer_node(a1, TYPE_UNKNOWN)
                        inner_type = self.types.register_option(it)
                    elif ibname == "Result":
                        let a1 = self.tree.nodes.data[ib].next_sibling
                        mut okt := TYPE_UNKNOWN
                        mut ert := TYPE_UNKNOWN
                        if a1 != 0 as u32:
                            okt = self.infer_node(a1, TYPE_UNKNOWN)
                            let a2 = self.tree.nodes.data[a1].next_sibling
                            if a2 != 0 as u32:
                                ert = self.infer_node(a2, TYPE_UNKNOWN)
                        inner_type = self.types.register_result(okt, ert)
                    safe_free_str(ibname)
        mut length := 1 as u32
        if inner_node != 0 as u32:
            let size_node = self.tree.nodes.data[inner_node].next_sibling
            if size_node != 0 as u32 and self.tree.nodes.data[size_node].kind == NODE_INT_LIT:
                let text = self.node_text(size_node)
                length = parse_comptime_int(text) as u32
                @free(text as ptr[u8])
        result_type = self.types.register_array(inner_type, length)

    elif kind == NODE_FUNC_TYPE:
        mut param_types := new_u32_vec()
        mut ret_type := TYPE_VOID
        let has_ret = (self.tree.nodes.data[node_idx].flags & 1 as u16 != 0 as u16)
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next = child_node.next_sibling
            if has_ret and next == 0 as u32:
                ret_type = self.infer_node(child, TYPE_UNKNOWN)
            else:
                let p_type = self.infer_node(child, TYPE_UNKNOWN)
                param_types.push(p_type)
            child = next
        result_type = self.types.register_function(param_types, ret_type)

    elif kind == NODE_ASSIGN_STMT:
        // children: [lhs, rhs]. An assignment must thread the lvalue's type down to the
        // RHS as `expected`, exactly like the VAR_DECL *init* path does — otherwise the
        // RHS is inferred with UNKNOWN and any expected-type coercion is skipped:
        //   `g = (30,12)` for `g:(i64,i64)` -> {i32,i32} 8B into a 16B slot (loses .1);
        //   `a = [10,15,17]` for `a:[i64;3]` -> i32 elems at 4B stride into an i64 array;
        //   `o = Some((30,12))` for `o:Option[(i64,i64)]` -> the variant-ctor payload
        //   tuple stays {i32,i32} (1aff7ca coercion needs the expected Option threaded).
        // NODE_ASSIGN_STMT had no infer_node branch and fell to the default traversal
        // (rhs = UNKNOWN). Mirror VAR_DECL: infer the LHS, then infer the RHS with the
        // lvalue type as expected. Frontend ACCEPT-only; the A==B fixpoint gate confirms
        // this does not change the self-host codegen.
        let lhs_a = self.tree.nodes.data[node_idx].first_child
        if lhs_a != 0 as u32:
            let lhs_ty = self.infer_node(lhs_a, TYPE_UNKNOWN)
            let rhs_a = self.tree.nodes.data[lhs_a].next_sibling
            if rhs_a != 0 as u32:
                self.infer_node(rhs_a, lhs_ty)
                // BUG#53 (assignment-path analog of m5): `x = <string literal>` where
                // x is numeric (or a numeric literal into a str/bytes lvalue) was
                // silently accepted then miscompiled to garbage. Reject the
                // str<->numeric pair. Literal-gated (RHS node kind), so real coercions
                // and value assignments are untouched. See
                // [[bug-malformed-input-robustness-cluster]].
                if lhs_ty != TYPE_UNKNOWN:
                    let ak = self.tree.nodes.data[rhs_a].kind
                    let l_str = lhs_ty == TYPE_STRING or lhs_ty == TYPE_BYTES
                    let l_num = lhs_ty >= TYPE_I8 and lhs_ty <= TYPE_USIZE and lhs_ty != TYPE_STRING and lhs_ty != TYPE_VOID
                    let a_strlit = ak == NODE_STRING_LIT
                    let a_numlit = ak == NODE_INT_LIT or ak == NODE_FLOAT_LIT
                    if (l_num and a_strlit) or (l_str and a_numlit):
                        ax_printf_local("error: type mismatch in assignment: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64

    else:
        // Default traversal
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            self.infer_node(child, TYPE_UNKNOWN)
            child = self.tree.nodes.data[child].next_sibling
            
    self.set_node_type(node_idx, result_type)
    return result_type

pub fn debug_find_and_print_is_ok(self: ptr[TypeChecker], node_idx: u32):
    if node_idx == 0 as u32:
        return
    let node = self.tree.nodes.data[node_idx]
    if node.kind == NODE_FIELD_EXPR:
        let name = self.intern.get(node.payload)
        ax_printf_local("  [TC-DEBUG-IS-OK] Found field node_idx=%d | name=%s flags=%d payload=%d\n", node_idx as i64, (get_str_ptr(name)) as i64, node.flags as i64, node.payload as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut child := node.first_child
    while child != 0 as u32:
        self.debug_find_and_print_is_ok(child)
        child = self.tree.nodes.data[child].next_sibling
