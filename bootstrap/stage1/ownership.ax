// bootstrap/stage1/ownership.ax
// OwnershipChecker checks single ownership, moves, and mutability.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32
// Process exit goes through print_helpers.ax::ax_exit_process (ExitProcess/SYS_EXIT),
// not libc `exit` — see knowledge/audit-libc-dependencies-2026-08-05.md step 2.

pub struct OwnershipChecker:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub errors: u32
    // RFC 0014 P1: true iff the program declares ANY `<Type>.drop(self)` method.
    // Computed once in check(); when false, the per-site copy-of-drop scan is
    // skipped entirely (the common case — no drop types => zero overhead, inert).
    pub has_drop_types: bool

pub fn new_ownership_checker(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[OwnershipChecker]:
    let oc = @alloc(@compiler_intrinsic("size_of")[OwnershipChecker]()) as ptr[OwnershipChecker]
    oc.tree = tree
    oc.pool = pool
    oc.symtable = symtable
    oc.typetable = typetable
    oc.errors = 0 as u32
    oc.has_drop_types = false
    return oc

pub fn check(mut self: ptr[OwnershipChecker]):
    // RFC 0014 P1: detect once whether any `<Type>.drop(self)` method exists.
    // Only then does check_drop_copy run its per-site scan (see type_has_drop).
    self.has_drop_types = self.scan_has_drop()
    self.check_node(0 as u32)
    if self.errors > 0 as u32:
        ax_puts_local("Ownership check failed.")
        ax_exit_process(1)

pub fn check_node(mut self: ptr[OwnershipChecker], node_idx: u32):
    // RFC 0015 P1 (BUG#69): this pass is now ACTIVE as a mutability-only checker.
    // The guard previously also returned on `node_idx == 0`, but node 0 is the real
    // NODE_PROGRAM root (ast.ax::new_ast_tree) -- so the whole pass was a no-op.
    // Only 0xffffffff is a genuine sentinel; recursive descents already filter
    // `!= 0` at every call site before recursing, so the root is the only place the
    // old `== 0` clause mattered, and dropping it is what turns the pass on.
    //
    // MOVE-checking is intentionally NOT enabled: AXIOM aggregates have alias/copy
    // semantics (RFC 0010), not move semantics, so `check_move` is a no-op (see its
    // body) and the E4001 path below never fires. Only the E4002 immutable-assign
    // check is live. Escape analysis + CTGC free remain deferred (RFC 0015 P2/P3).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_VAR_DECL:
        let init_idx = node.first_child
        if init_idx != 0 as u32:
            self.check_node(init_idx)
            self.check_move(init_idx)
            self.check_drop_copy(node_idx, init_idx)

    elif kind == NODE_ASSIGN_STMT:
        let lhs_idx = node.first_child
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        self.check_node(lhs_idx)
        self.check_node(rhs_idx)

        if lhs_idx != 0 as u32:
            let lhs_kind = self.tree.nodes.data[lhs_idx].kind
            if lhs_kind == NODE_IDENT:
                let sym_idx = self.tree.nodes.data[lhs_idx].payload
                if sym_idx != 0 as u32:
                    let sym = self.symtable.symbols.data[sym_idx]
                    if (sym.flags & SYM_FLAG_MUT) == 0 as u16:
                        let tok = self.tree.tokens.data[node.token_idx]
                        ax_printf_local("error[E4002]: cannot assign to immutable variable at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.errors = self.errors + 1 as u32

            self.check_move(rhs_idx)
            self.check_drop_copy(node_idx, rhs_idx)

    elif kind == NODE_IDENT:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            if (sym.flags & SYM_FLAG_MOVED) != 0 as u16:
                let tok = self.tree.tokens.data[node.token_idx]
                ax_printf_local("error[E4001]: use of moved value at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.errors = self.errors + 1 as u32

    elif kind == NODE_CALL_EXPR:
        mut arg_idx := node.first_child
        if arg_idx != 0 as u32:
            self.check_node(arg_idx)
            arg_idx = self.tree.nodes.data[arg_idx].next_sibling
            while arg_idx != 0 as u32:
                self.check_node(arg_idx)
                self.check_move(arg_idx)
                arg_idx = self.tree.nodes.data[arg_idx].next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.check_node(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn check_move(mut self: ptr[OwnershipChecker], node_idx: u32):
    // RFC 0015 P1 (BUG#69): intentionally a NO-OP. AXIOM aggregates are copy/alias
    // values (RFC 0010), not move-only, so binding/passing one does NOT consume it.
    // The previous body marked every struct/sum/option/result/generic-inst use as
    // SYM_FLAG_MOVED, which -- once the pass actually ran -- flagged ~258 valid
    // read-only reuses across the stdlib + compiler as `E4001 use of moved value`.
    // Real move semantics would need a language-level RFC (RFC 0015 §4.1); until
    // then this stays inert and only the E4002 mutability check is enforced.
    return

// RFC 0014 P1 (drop-glue double-free guard): unwrap ptr/ref layers of a type.
// Mirrors air_builder.ax::op_unwrap_type but reads this pass's own typetable.
fn ownership_unwrap_type(self: ptr[OwnershipChecker], t: u32) -> u32:
    mut u := t
    mut e := self.typetable.entries.data[u as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        u = e.extra as u32
        e = self.typetable.entries.data[u as i64]
    return u

// RFC 0014 P1: one-time scan — does ANY `<Type>.drop(self)` method exist in the
// program? Calls air_builder.ax::method_name_rank_raw_bytes, the SINGLE method-name
// rule, exactly as resolve_drop_method does (an inline `fn drop(self)` carries a
// dotted mangled name resolve_method_sym misses). This pass used to call a separate
// wrapper that was never converted when the rule became rank-based, so the two
// copies drifted: ownership still honoured the retired loose byte-window and
// reported "has drop" for a type declaring only `pre_drop`, rejecting a legal
// `let b = a` with E4003. One rule, one caller shape: `rank != 0` is exactly the
// condition under which resolve_drop_method returns a non-zero symbol.
fn scan_has_drop(self: ptr[OwnershipChecker]) -> bool:
    let method_id = self.pool.intern("drop")
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and method_name_rank_raw_bytes(self.pool, sym.name_id, method_id) != 0 as i64:
            let t_entry = self.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len == 1 as i64:
                    return true
        i = i + 1 as i64
    return false

// RFC 0014 P1: is `rec_type` a VALUE aggregate whose type declares `drop(self)`?
// A pointer/ref receiver is NOT a value copy (copying `ptr[T]` copies the pointer,
// and pointer-typed locals are never CTGC-freed) -> only flag direct value types.
// The drop method's self param may be `self`(value) OR `ptr[T]`, so unwrap the param
// and compare to the value receiver type. Same single rule as scan_has_drop above.
fn type_has_drop(self: ptr[OwnershipChecker], rec_type: u32) -> bool:
    if rec_type == 0 as u32 or (rec_type as i64) >= self.typetable.entries.len:
        return false
    let re = self.typetable.entries.data[rec_type as i64]
    if re.kind == TYPE_KIND_POINTER or re.kind == TYPE_KIND_REF:
        return false
    let method_id = self.pool.intern("drop")
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and method_name_rank_raw_bytes(self.pool, sym.name_id, method_id) != 0 as i64:
            let t_entry = self.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len == 1 as i64:
                    let fp = self.ownership_unwrap_type(fi.params.data[0] as u32)
                    if fp == rec_type:
                        return true
        i = i + 1 as i64
    return false

// RFC 0014 P1: reject an implicit copy-by-value of a `drop`-typed value.
// `let b = a` / `mut b := a` / `b = a` where `a` is a NAMED variable whose type
// declares `drop(self)` would alias the resource-owning fields into TWO live
// locals -> a double-drop (or, masked by escape analysis, a silently-skipped
// drop). AXIOM has no explicit move, so — like Rust's `Drop` types not being
// `Copy` — such copies are forbidden and must be restructured (construct in place,
// pass by `ptr[T]`, or free explicitly). Narrow by design: only a bare IDENT rhs
// of a non-pointer drop type. Inert unless the program declares a drop method.
fn check_drop_copy(mut self: ptr[OwnershipChecker], stmt_idx: u32, rhs_idx: u32):
    if not self.has_drop_types:
        return
    if rhs_idx == 0 as u32 or rhs_idx == 0xffffffff as u32:
        return
    let rnode = self.tree.nodes.data[rhs_idx]
    if rnode.kind != NODE_IDENT:
        return
    let sym_idx = rnode.payload
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
        return
    if self.type_has_drop(sym.type_id):
        let tok = self.tree.tokens.data[self.tree.nodes.data[stmt_idx as i64].token_idx]
        ax_printf_local("error[E4003]: cannot copy a value whose type has a `drop` method (would double-drop) at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.errors = self.errors + 1 as u32
