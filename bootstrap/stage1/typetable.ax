// bootstrap/stage1/typetable.ax
// AXIOM self-hosted Type Table representation.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64
// extern "C" fn sprintf(buf: ptr[u8], format: ptr[u8], val: f64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64

// Predefined TypeID constants matching types/typeid.go exactly
pub const TYPE_UNKNOWN: u32 = 0
pub const TYPE_I8: u32 = 1
pub const TYPE_I16: u32 = 2
pub const TYPE_I32: u32 = 3
pub const TYPE_I64: u32 = 4
pub const TYPE_U8: u32 = 5
pub const TYPE_U16: u32 = 6
pub const TYPE_U32: u32 = 7
pub const TYPE_U64: u32 = 8
pub const TYPE_F32: u32 = 9
pub const TYPE_F64: u32 = 10
pub const TYPE_BOOL: u32 = 11
pub const TYPE_STRING: u32 = 12
pub const TYPE_CHAR8: u32 = 13
pub const TYPE_VOID: u32 = 14
pub const TYPE_ISIZE: u32 = 15
pub const TYPE_USIZE: u32 = 16

pub const TYPE_ORD: u32 = 17
pub const TYPE_EQ: u32 = 18
pub const TYPE_HASH: u32 = 19
pub const TYPE_DISPLAY: u32 = 20
pub const TYPE_ACTOR_REF: u32 = 21
pub const TYPE_BYTES: u32 = 22 // RFC 0020: raw byte buffer; same {ptr,len} 16B repr as str, distinct type (byte iteration/semantics)

pub struct ComptimeValue:
    kind: u32
    int_val: i64
    float_val: f64
    bool_val: bool
    str_val: str

// TypeKind enum matching compiler/types/types.go Kind constants exactly
pub const TYPE_KIND_PRIMITIVE: u8 = 0
pub const TYPE_KIND_STRUCT: u8 = 1
pub const TYPE_KIND_FUNC: u8 = 2
pub const TYPE_KIND_ARRAY: u8 = 3
pub const TYPE_KIND_SLICE: u8 = 4
pub const TYPE_KIND_TUPLE: u8 = 5
pub const TYPE_KIND_SUM: u8 = 6
pub const TYPE_KIND_GENERIC: u8 = 7
pub const TYPE_KIND_GENERIC_INST: u8 = 8
pub const TYPE_KIND_POINTER: u8 = 9
pub const TYPE_KIND_REF: u8 = 10
pub const TYPE_KIND_OPTION: u8 = 11
pub const TYPE_KIND_RESULT: u8 = 12
pub const TYPE_KIND_INTERFACE: u8 = 13

pub struct TypeEntry:
    kind: u8
    padding: u8
    flags: u16
    name_id: u32
    size: u32
    align: u32
    extra: u32 // Index into structs or funcs lists

pub struct StructField:
    name_id: u32
    type_id: u32

pub struct StructFieldVec:
    data: ptr[StructField]
    len: i64
    cap: i64

pub fn push(self: ptr[StructFieldVec], sf: StructField):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[StructField]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[StructField]
        if self.data != null as ptr[StructField]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = sf
    self.len = self.len + 1

pub struct StructInfo:
    fields: StructFieldVec
    generic_args: U32Vec

pub struct StructInfoVec:
    data: ptr[StructInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[StructInfoVec], si: StructInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[StructInfo]() as i64)) as ptr[StructInfo]
        if self.data != null as ptr[StructInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[StructInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = si
    self.len = self.len + 1

pub struct VariantInfo:
    name_id: u32
    payload_type: u32
    tag: u8
    padding1: u8
    padding2: u16

pub struct VariantInfoVec:
    data: ptr[VariantInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[VariantInfoVec], vi: VariantInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[VariantInfo]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[VariantInfo]
        if self.data != null as ptr[VariantInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = vi
    self.len = self.len + 1

pub struct SumInfo:
    variants: VariantInfoVec
    generic_args: U32Vec

pub struct SumInfoVec:
    data: ptr[SumInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[SumInfoVec], si: SumInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[SumInfo]() as i64)) as ptr[SumInfo]
        if self.data != null as ptr[SumInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[SumInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = si
    self.len = self.len + 1

pub struct FuncInfo:
    params: U32Vec
    ret: u32
    dummy: u32

pub struct FuncInfoVec:
    data: ptr[FuncInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[FuncInfoVec], fi: FuncInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[FuncInfo]() as i64)) as ptr[FuncInfo]
        if self.data != null as ptr[FuncInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[FuncInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = fi
    self.len = self.len + 1

pub struct TypeEntryVec:
    data: ptr[TypeEntry]
    len: i64
    cap: i64

pub fn push(self: ptr[TypeEntryVec], te: TypeEntry) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[TypeEntry]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[TypeEntry]
        if self.data != null as ptr[TypeEntry]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = te
    self.len = self.len + 1
    return idx

pub fn new_sum_info_vec() -> SumInfoVec:
    return SumInfoVec(data: null as ptr[SumInfo], len: 0, cap: 0)

pub fn new_variant_info_vec() -> VariantInfoVec:
    return VariantInfoVec(data: null as ptr[VariantInfo], len: 0, cap: 0)

pub struct U32VecVec:
    pub data: ptr[U32Vec]
    pub len: i64
    pub cap: i64

pub fn new_u32_vec_vec() -> U32VecVec:
    return U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)

pub fn push(self: ptr[U32VecVec], val: U32Vec) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[U32Vec]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[U32Vec]
        if self.data != null as ptr[U32Vec]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub struct TypeTable:
    pub entries: TypeEntryVec
    pub structs: StructInfoVec
    pub funcs: FuncInfoVec
    pub sumtypes: SumInfoVec
    pub generic_insts: U32VecVec
    // RFC 0029: per-interface ordered method-name list (vtable slot layout). A
    // TYPE_KIND_INTERFACE entry's `extra` field holds (iface_methods index + 1); 0 = none.
    pub iface_methods: U32VecVec
    // RFC 0029: per-interface DECLARED method signatures, index-aligned with
    // `iface_methods` (same outer index, same slot order). Element = a TYPE_KIND_FUNC
    // type id whose params include `self` at index 0 (0 = signature not resolved).
    // Dynamic dispatch has no concrete callee symbol, so this is the ONLY place the
    // declared parameter types of `iface.m(args)` are available to the backend — which
    // needs them to coerce arguments exactly as a static call does (coerce_float_arg).
    pub iface_method_sigs: U32VecVec

pub fn new_type_table() -> ptr[TypeTable]:
    // size_of (not a hardcoded byte count) so adding a field can't desync the alloc.
    let tt = @alloc(@compiler_intrinsic("size_of")[TypeTable]()) as ptr[TypeTable]
    tt.entries = TypeEntryVec(data: null as ptr[TypeEntry], len: 0, cap: 0)
    tt.structs = StructInfoVec(data: null as ptr[StructInfo], len: 0, cap: 0)
    tt.funcs = FuncInfoVec(data: null as ptr[FuncInfo], len: 0, cap: 0)
    tt.sumtypes = SumInfoVec(data: null as ptr[SumInfo], len: 0, cap: 0)
    tt.generic_insts = U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)
    tt.iface_methods = U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)
    tt.iface_method_sigs = U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)

    // 0: Unknown sentinel
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 0 as u32, align: 0 as u32, extra: 0 as u32))
    
    // 1-16: Primitives
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // i8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 2 as u32, align: 2 as u32, extra: 0 as u32)) // i16
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // i32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // i64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // u8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 2 as u32, align: 2 as u32, extra: 0 as u32)) // u16
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // u32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // u64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // f32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // f64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // bool
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32)) // string
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // char8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 0 as u32, align: 0 as u32, extra: 0 as u32)) // void
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // isize
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // usize

    // 17-20: Built-in interfaces
    mut i := 0
    while i < 4:
        (&tt.entries).push(TypeEntry(kind: TYPE_KIND_INTERFACE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32))
        i = i + 1

    // 21: ActorRef
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_STRUCT, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32))

    // 22: bytes (RFC 0020) — raw byte buffer, same 16-byte {ptr,len} repr as str.
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32))

    return tt

// Forward-declaration for a genuinely SELF-RECURSIVE non-generic sum
// (`type Tree = Leaf(i64) | Node(Tree,Tree)`): reserve the sum's type_id (empty variants) so a
// variant field that is a BARE reference to the sum being defined resolves to THIS id, then
// populate once the fields are resolved. Only used when a bare self-ref field is present (the
// caller gates on it), so non-recursive sums and generic/mono-clone recursive sums (whose
// self-refs are `Tree[..]` generic_inst) keep the plain register_sum_type path unchanged. See
// [[bug-recursive-nongeneric-multifield-sum]]. Pair with set_sum_variants.
pub fn reserve_sum_type(self: ptr[TypeTable], name_id: u32) -> u32:
    let s_idx = self.sumtypes.len as u32
    (&self.sumtypes).push(SumInfo(variants: new_variant_info_vec(), generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SUM,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: s_idx,
    ))

// Fill in the variants of a sum reserved by reserve_sum_type. The empty placeholder vec is
// dropped (len 0, null buffer — nothing to free).
pub fn set_sum_variants(self: ptr[TypeTable], type_id: u32, variants: VariantInfoVec):
    if (type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[type_id as i64]
    if entry.kind != TYPE_KIND_SUM:
        return
    self.sumtypes.data[entry.extra as i64].variants = variants

pub fn register_sum_type(self: ptr[TypeTable], name_id: u32, variants: VariantInfoVec) -> u32:
    let s_idx = self.sumtypes.len as u32
    (&self.sumtypes).push(SumInfo(variants: variants, generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    // RFC 0004: a user sum value is an 8-byte by-address pointer to a heap box
    // laid out as [tag: i64 @0][payload: 8B @8] = 16 bytes (kind 6 is aggregate,
    // so the VALUE stays an 8-byte pointer; the 16 is the box allocation size).
    // v1 supports a single <=8-byte payload slot; str/multi-field payloads TODO.
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SUM,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: s_idx,
    ))

// RFC 0012: Option[T] / Result[T,E] as a real type entry. Like a user sum
// (kind 6) the VALUE is an 8-byte by-address tagged box pointer, and the 16 is
// the box allocation size (holds up to a 16-byte str payload). Being kind 11/12
// (aggregate) it is passed/returned as an 8-byte pointer exactly like a sum, so
// the stdlib ABI (self: Option[..] read via `(&self)[0]`) is unchanged; the only
// gain is that the register type is NO LONGER `str` (12), so EQ/COPY/MAKE_REF on
// the box stop taking the string-by-address deref path and `match` can dispatch.
// Option dedups on (kind, extra=inner). Result dedups on (kind, extra=ok, name_id=err).
pub fn register_option(self: ptr[TypeTable], inner_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_OPTION and entry.extra == inner_id:
            return i as u32
        i = i + 1
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_OPTION,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 16 as u32,
        align: 8 as u32,
        extra: inner_id,
    ))

pub fn register_result(self: ptr[TypeTable], ok_id: u32, err_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_RESULT and entry.extra == ok_id and entry.name_id == err_id:
            return i as u32
        i = i + 1
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_RESULT,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: err_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: ok_id,
    ))

pub fn register_struct(self: ptr[TypeTable], name_id: u32, fields: StructFieldVec) -> u32:
    let s_idx = self.structs.len as u32
    (&self.structs).push(StructInfo(fields: fields, generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_STRUCT,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: s_idx,
    ))

// RFC 0013: record the concrete type-args of a monomorphized generic struct so
// get_generic_args() never has to re-derive them by parsing the mangled name
// (ambiguous for nested generics like MV[MV[i32]], see BUG#65). Deep-copies
// `args` since the caller (mono.instantiate_function) does not own/outlive it.
pub fn set_struct_generic_args(self: ptr[TypeTable], struct_type_id: u32, args: U32Vec):
    if (struct_type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[struct_type_id as i64]
    if entry.kind != TYPE_KIND_STRUCT:
        return
    let s_idx = entry.extra as i64
    if s_idx >= self.structs.len:
        return
    mut copied := U32Vec(data: null as ptr[u32], len: 0, cap: 0)
    if args.len > 0 as i64:
        let buf = @alloc(args.len * 4 as i64) as ptr[u32]
        @memcpy(buf as ptr[u8], args.data as ptr[u8], args.len * 4 as i64)
        copied.data = buf
        copied.len = args.len
        copied.cap = args.len
    self.structs.data[s_idx].generic_args = copied

// BUG#67 follow-up: same idea as set_struct_generic_args, but for a
// monomorphized generic SUM TYPE (e.g. a concrete Option[Vec[i64]] clone
// produced when typechecking a `-> Option[V]` return-type annotation with V
// substituted). Without this, get_generic_args() falls back to parsing the
// clone's mangled name, which is ambiguous for a nested generic payload
// (e.g. Vec[i64] itself mangled as "...__i64") -- same architectural gap as
// BUG#65, manifesting for sum types instead of structs.
pub fn set_sum_generic_args(self: ptr[TypeTable], sum_type_id: u32, args: U32Vec):
    if (sum_type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[sum_type_id as i64]
    if entry.kind != TYPE_KIND_SUM:
        return
    let s_idx = entry.extra as i64
    if s_idx >= self.sumtypes.len:
        return
    mut copied := U32Vec(data: null as ptr[u32], len: 0, cap: 0)
    if args.len > 0 as i64:
        let buf = @alloc(args.len * 4 as i64) as ptr[u32]
        @memcpy(buf as ptr[u8], args.data as ptr[u8], args.len * 4 as i64)
        copied.data = buf
        copied.len = args.len
        copied.cap = args.len
    self.sumtypes.data[s_idx].generic_args = copied

pub fn register_function(self: ptr[TypeTable], params: U32Vec, ret: u32) -> u32:
    let f_idx = self.funcs.len as u32
    (&self.funcs).push(FuncInfo(params: params, ret: ret, dummy: 0 as u32))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_FUNC,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 8 as u32,
        align: 8 as u32,
        extra: f_idx,
    ))

pub fn register_pointer(self: ptr[TypeTable], inner_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_POINTER and entry.extra == inner_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_POINTER,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 8 as u32,
        align: 8 as u32,
        extra: inner_id,
    ))

pub fn register_slice(self: ptr[TypeTable], elem_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_SLICE and entry.extra == elem_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SLICE,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 24 as u32,
        align: 8 as u32,
        extra: elem_id,
    ))

pub fn register_array(self: ptr[TypeTable], elem_id: u32, length: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_ARRAY and entry.extra == elem_id and entry.name_id == length:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_ARRAY,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: length,
        size: 0 as u32,
        align: 0 as u32,
        extra: elem_id,
    ))

// Minimal interface type registration: just enough for a distinct, stable
// type_id so receiver-type checks (e.g. rejecting unimplemented dynamic
// dispatch through an interface value, see BUG#71) can recognize it. No
// method-signature side table -- interfaces carry no runtime representation
// (no vtable/fat pointer) yet, so there is nothing else to store here.
pub fn register_interface(self: ptr[TypeTable], name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_INTERFACE and entry.name_id == name_id:
            return i as u32
        i = i + 1

    // RFC 0029: an interface VALUE is an 8-byte pointer to a heap box {data, m0..m(N-1)}
    // (the inline per-value vtable). size 8/align 8 → it passes/returns/stores as a plain
    // 8-byte pointer (scalar ABI); the box's field layout lives in a separate synthesized
    // struct type (ensure_iface_box_type). Was 0/0 (BUG#71 minimal reject era).
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_INTERFACE,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 8 as u32,
        align: 8 as u32,
        extra: 0 as u32,
    ))

// RFC 0029 step 1: attach an interface's ordered method-name list (its vtable slot
// layout) to its type entry. `extra` stores (iface_methods index + 1) so that 0 keeps
// meaning "no method list" (built-in interface placeholders leave extra=0). Idempotent-ish:
// only call once per interface, at first registration (guarded by sym.type_id==0 caller-side).
pub fn register_interface_methods(self: ptr[TypeTable], iface_type_id: u32, methods: U32Vec):
    if iface_type_id == 0 as u32 or (iface_type_id as i64) >= self.entries.len:
        return
    let idx = self.iface_methods.len as u32
    (&self.iface_methods).push(methods)
    // Keep `iface_method_sigs` index-aligned with `iface_methods` (one entry per
    // interface, pushed together) so a single `extra` index addresses both. The
    // signature list starts EMPTY: parameter types are resolved later, once struct
    // types exist (typecheck Phase 2.5 -> set_interface_method_sigs).
    (&self.iface_method_sigs).push(U32Vec(data: null as ptr[u32], len: 0, cap: 0))
    self.entries.data[iface_type_id as i64].extra = idx + 1 as u32

// RFC 0029: record the resolved DECLARED signatures of an interface's methods. `sigs`
// is slot-aligned with `interface_method_list` (element = a TYPE_KIND_FUNC type id, or
// 0 when the signature could not be resolved).
pub fn set_interface_method_sigs(self: ptr[TypeTable], iface_type_id: u32, sigs: U32Vec):
    if iface_type_id == 0 as u32 or (iface_type_id as i64) >= self.entries.len:
        return
    let ex = self.entries.data[iface_type_id as i64].extra
    if ex == 0 as u32 or ((ex - 1 as u32) as i64) >= self.iface_method_sigs.len:
        return
    self.iface_method_sigs.data[(ex - 1 as u32) as i64] = sigs

// RFC 0029: the declared FUNC type of the interface method occupying `slot` (0 when
// unknown). Used by dynamic dispatch to obtain the parameter types a static call reads
// off the resolved callee symbol.
pub fn interface_method_sig_type(self: ptr[TypeTable], iface_type_id: u32, slot: i64) -> u32:
    if iface_type_id != 0 as u32 and (iface_type_id as i64) < self.entries.len:
        let ex = self.entries.data[iface_type_id as i64].extra
        if ex != 0 as u32 and ((ex - 1 as u32) as i64) < self.iface_method_sigs.len:
            let sigs = self.iface_method_sigs.data[(ex - 1 as u32) as i64]
            if slot >= 0 as i64 and slot < sigs.len:
                return sigs.data[slot]
    return 0 as u32

// RFC 0029: return the ordered method-name list for an interface type (or an empty list
// if none was registered). Slot index = position in this list.
pub fn interface_method_list(self: ptr[TypeTable], iface_type_id: u32) -> U32Vec:
    if iface_type_id != 0 as u32 and (iface_type_id as i64) < self.entries.len:
        let ex = self.entries.data[iface_type_id as i64].extra
        if ex != 0 as u32 and ((ex - 1 as u32) as i64) < self.iface_methods.len:
            return self.iface_methods.data[(ex - 1 as u32) as i64]
    return U32Vec(data: null as ptr[u32], len: 0, cap: 0)

pub fn register_generic_inst(self: ptr[TypeTable], name_id: u32, args: U32Vec) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_GENERIC_INST and entry.name_id == name_id:
            let inst_idx = entry.extra
            let inst_args = &self.generic_insts.data[inst_idx]
            if inst_args.len == args.len:
                mut args_match := true
                mut j := 0 as i64
                while j < args.len:
                    if inst_args.data[j] != args.data[j]:
                        args_match = false
                        break
                    j = j + 1
                if args_match:
                    if args.data != null as ptr[u32]:
                        @free(args.data as ptr[u8])
                    return i as u32
        i = i + 1
    
    let inst_idx = (&self.generic_insts).push(args)
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_GENERIC_INST,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: inst_idx,
    ))

pub fn register_generic(self: ptr[TypeTable], name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_GENERIC and entry.name_id == name_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_GENERIC,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: 0 as u32,
    ))

pub fn free_typetable(self: ptr[TypeTable]):
    mut i := 0 as i64
    while i < self.structs.len:
        let s = self.structs.data[i]
        if s.fields.data != null as ptr[StructField]:
            @free(s.fields.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.funcs.len:
        let f = self.funcs.data[i]
        if f.params.data != null as ptr[u32]:
            @free(f.params.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.sumtypes.len:
        let s = self.sumtypes.data[i]
        if s.variants.data != null as ptr[VariantInfo]:
            @free(s.variants.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.generic_insts.len:
        let g = self.generic_insts.data[i]
        if g.data != null as ptr[u32]:
            @free(g.data as ptr[u8])
        i = i + 1
    if self.generic_insts.data != null as ptr[U32Vec]:
        @free(self.generic_insts.data as ptr[u8])
    if self.sumtypes.data != null as ptr[SumInfo]:
        @free(self.sumtypes.data as ptr[u8])
    if self.entries.data != null as ptr[TypeEntry]:
        @free(self.entries.data as ptr[u8])
    if self.structs.data != null as ptr[StructInfo]:
        @free(self.structs.data as ptr[u8])
    if self.funcs.data != null as ptr[FuncInfo]:
        @free(self.funcs.data as ptr[u8])
    @free(self as ptr[u8])
