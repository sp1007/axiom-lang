// bootstrap/stage1/x86_regalloc.ax
// Liveness Analysis and Graph-Coloring Register Allocation for x86-64 in self-hosted AXIOM.

import std.string

pub struct LiveInterval:
    pub vreg: u32
    pub start: i32
    pub end: i32

pub struct LiveIntervalVec:
    pub data: ptr[LiveInterval]
    pub len: i64
    pub cap: i64

pub fn new_live_interval_vec() -> LiveIntervalVec:
    return LiveIntervalVec(data: null as ptr[LiveInterval], len: 0, cap: 0)

pub fn push(mut self: LiveIntervalVec, iv: LiveInterval) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[LiveInterval]
        if self.data != null as ptr[LiveInterval]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = iv
    self.len = self.len + 1
    return idx

pub fn is_two_operand_read(op: u16) -> bool:
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR or op == MACH_NEG or op == MACH_NOT:
        return true
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE:
        return true
    return false

pub fn compute_liveness(insts: ptr[MachInst], insts_len: i64) -> LiveIntervalVec:
    mut max_vreg := 0 as u32
    mut i := 0 as i64
    while i < insts_len:
        let inst = &insts[i]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        i = i + 1

    let map_size = (max_vreg + 1 as u32) as i64
    let interval_map = @alloc(map_size * 8) as ptr[ptr[LiveInterval]]
    @memset(interval_map as ptr[u8], 0 as u8, map_size * 8)

    i = 0 as i64
    while i < insts_len:
        let inst = &insts[i]

        if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
            let v = inst.dst.vreg
            if interval_map[v] == null as ptr[LiveInterval]:
                let iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = i as i32
                mut is_param := false
                if inst.op == MACH_MOV and inst.src1.kind == OPND_PHYS:
                    let phys = inst.src1.phys
                    if phys == REG_RCX or phys == REG_RDX or phys == REG_R8 or phys == REG_R9 or phys == REG_RDI or phys == REG_RSI:
                        is_param = true
                if is_param:
                    iv.end = (insts_len - 1) as i32
                else:
                    iv.end = i as i32
                interval_map[v] = iv

        if inst.src1.kind == OPND_VREG and inst.src1.vreg != 0 as u32:
            let v = inst.src1.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if inst.src2.kind == OPND_VREG and inst.src2.vreg != 0 as u32:
            let v = inst.src2.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if is_two_operand_read(inst.op):
            if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                let v = inst.dst.vreg
                mut iv = interval_map[v]
                if iv == null as ptr[LiveInterval]:
                    iv = @alloc(12) as ptr[LiveInterval]
                    iv.vreg = v
                    iv.start = 0 as i32
                    iv.end = i as i32
                    interval_map[v] = iv
                elif (i as i32) > iv.end:
                    iv.end = i as i32
        i = i + 1

    // Collect active vregs into a compact list — avoids scanning sparse gaps
    // in the back-edge extension loop below.
    let active_vregs = @alloc(map_size * 4) as ptr[u32]
    mut active_count := 0 as i64
    mut av := 0 as i64
    while av < map_size:
        if interval_map[av] != null as ptr[LiveInterval]:
            active_vregs[active_count] = av as u32
            active_count = active_count + 1
        av = av + 1

    mut max_label := 0 as u32
    mut label_scan := 0 as i64
    while label_scan < insts_len:
        if insts[label_scan].op == MACH_LABEL:
            if insts[label_scan].dst.label > max_label:
                max_label = insts[label_scan].dst.label
        label_scan = label_scan + 1

    let label_to_idx_size = (max_label + 1 as u32) as i64
    let label_to_idx = @alloc(label_to_idx_size * 8) as ptr[i64]
    mut fill_l := 0 as i64
    while fill_l < label_to_idx_size:
        label_to_idx[fill_l] = -1 as i64
        fill_l = fill_l + 1

    label_scan = 0
    while label_scan < insts_len:
        if insts[label_scan].op == MACH_LABEL:
            let l_id = insts[label_scan].dst.label
            label_to_idx[l_id as i64] = label_scan
        label_scan = label_scan + 1

    mut be_i := 0 as i64
    while be_i < insts_len:
        let be_inst = &insts[be_i]
        if be_inst.op == MACH_JMP or be_inst.op == MACH_JCC:
            if be_inst.dst.kind == OPND_LABEL:
                let target_label = be_inst.dst.label
                let target_idx = label_to_idx[target_label as i64]
                if target_idx != -1 as i64 and target_idx < be_i:
                    // Back-edge: only scan actual active vregs, not the full map.
                    mut v_scan := 0 as i64
                    while v_scan < active_count:
                        let vr = active_vregs[v_scan] as i64
                        let iv = interval_map[vr]
                        if iv != null as ptr[LiveInterval]:
                            if iv.start <= target_idx as i32 and iv.end >= target_idx as i32:
                                if iv.end < be_i as i32:
                                    iv.end = be_i as i32
                        v_scan = v_scan + 1
        be_i = be_i + 1
    @free(label_to_idx as ptr[u8])
    @free(active_vregs as ptr[u8])

    mut result := new_live_interval_vec()
    mut v := 0 as i64
    while v < map_size:
        let iv = interval_map[v]
        if iv != null as ptr[LiveInterval]:
            result.push(iv[0])
            @free(iv as ptr[u8])
        v = v + 1
    @free(interval_map as ptr[u8])

    // Counting sort on start positions — O(n + insts_len) vs O(n^2) insertion sort.
    // start values are always in [0, insts_len), so insts_len is the range bound.
    if result.len > 1 as i64 and insts_len > 0 as i64:
        let count_arr = @alloc(insts_len * 4) as ptr[i32]
        @memset(count_arr as ptr[void], 0 as u8, insts_len * 4)
        mut ci := 0 as i64
        while ci < result.len:
            let s = result.data[ci].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] + 1
            ci = ci + 1
        mut pi := 1 as i64
        while pi < insts_len:
            count_arr[pi] = count_arr[pi] + count_arr[pi - 1 as i64]
            pi = pi + 1
        let sorted_buf = @alloc(result.len * 12) as ptr[LiveInterval]
        mut ri := result.len - 1 as i64
        while ri >= 0 as i64:
            let s = result.data[ri].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] - 1
                sorted_buf[count_arr[s as i64]] = result.data[ri]
            ri = ri - 1 as i64
        @memcpy(result.data as ptr[u8], sorted_buf as ptr[u8], result.len * 12)
        @free(sorted_buf as ptr[u8])
        @free(count_arr as ptr[u8])

    return result

pub struct RegAllocation:
    pub vreg: u32
    pub phys: u8
    pub spilled: bool
    pub spill_idx: i32

pub struct RegAllocResult:
    pub allocs: ptr[RegAllocation]
    pub max_vreg: u32
    pub spill_count: i32
    // BUG#18: with exactly {ptr@0, u32@8, i32@12} this struct is 16 bytes and the
    // native backend returns it by value via the str-like RAX:RDX path (which
    // assumes a {ptr, i64} layout), so reads of max_vreg/spill_count come back
    // wrong (max_vreg read returned the `allocs` pointer value -> giant loop
    // bound -> allocs[] OOB segfault). Pad to >16 bytes so it is returned
    // by-address (sret), the heavily-tested aggregate path (cf. LiveIntervalVec).
    pub pad0: i64

pub fn get_allocatable_gprs(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(12) as ptr[u8]
    arr[0] = REG_RAX
    arr[1] = REG_RCX
    arr[2] = REG_RDX
    arr[3] = REG_RBX
    arr[4] = REG_RSI
    arr[5] = REG_RDI
    arr[6] = REG_R8
    arr[7] = REG_R9
    arr[8] = REG_R12
    arr[9] = REG_R13
    arr[10] = REG_R14
    arr[11] = REG_R15
    out_len[0] = 12
    return arr

pub fn reg_is_caller_saved(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    else:
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_RSI or r == REG_RDI or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    return false

pub fn reg_is_parameter_reg(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9:
            return true
    else:
        if r == REG_RDI or r == REG_RSI or r == REG_RDX or r == REG_RCX or r == REG_R8 or r == REG_R9:
            return true
    return false


pub fn graph_coloring_alloc(intervals: LiveIntervalVec, avail_regs: ptr[u8], avail_regs_len: i64, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    if intervals.len == 0 or avail_regs_len == 0:
        return RegAllocResult(allocs: null as ptr[RegAllocation], max_vreg: 0 as u32, spill_count: 0 as i32, pad0: 0 as i64)

    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    let param_idx_of_vreg = @alloc(graph_size * 4) as ptr[i32]
    mut param_vi := 0 as i64
    while param_vi < graph_size:
        param_idx_of_vreg[param_vi] = -1 as i32
        param_vi = param_vi + 1

    mut inst_idx := 0 as i64
    while inst_idx < insts_len:
        let inst = insts[inst_idx]
        if inst.op == MACH_MOV and inst.dst.kind == OPND_VREG and inst.src1.kind == OPND_PHYS:
            let phys = inst.src1.phys
            mut p_idx := -1 as i32
            if abi == "win64":
                if phys == REG_RCX:
                    p_idx = 0 as i32
                elif phys == REG_RDX:
                    p_idx = 1 as i32
                elif phys == REG_R8:
                    p_idx = 2 as i32
                elif phys == REG_R9:
                    p_idx = 3 as i32
            else:
                if phys == REG_RDI:
                    p_idx = 0 as i32
                elif phys == REG_RSI:
                    p_idx = 1 as i32
                elif phys == REG_RDX:
                    p_idx = 2 as i32
                elif phys == REG_RCX:
                    p_idx = 3 as i32
                elif phys == REG_R8:
                    p_idx = 4 as i32
                elif phys == REG_R9:
                    p_idx = 5 as i32
            
            if p_idx != -1 as i32:
                let vr = inst.dst.vreg
                if vr < max_vreg + 1 as u32:
                    param_idx_of_vreg[vr as i64] = p_idx
        inst_idx = inst_idx + 1

    // Determine for each virtual register if its live interval spans any call instruction
    let spans_call = @alloc(graph_size) as ptr[bool]
    @memset(spans_call as ptr[u8], 0 as u8, graph_size)

    let forbid_rax_rdx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rax_rdx as ptr[u8], 0 as u8, graph_size)

    let forbid_rcx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rcx as ptr[u8], 0 as u8, graph_size)

    let is_arg_vreg = @alloc(graph_size) as ptr[bool]
    @memset(is_arg_vreg as ptr[u8], 0 as u8, graph_size)

    let address_taken = @alloc(graph_size) as ptr[bool]
    @memset(address_taken as ptr[u8], 0 as u8, graph_size)

    mut scan_idx := 0 as i64
    while scan_idx < insts_len:
        let inst = &insts[scan_idx]
        if inst.op == MACH_IDIV and inst.src1.kind == OPND_VREG:
            let v = inst.src1.vreg
            if v < graph_size as u32:
                forbid_rax_rdx[v] = true
        
        if (inst.op == MACH_SHL or inst.op == MACH_SAR or inst.op == MACH_SHR) and inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            if v < graph_size as u32:
                forbid_rcx[v] = true
        
        // Tag virtual registers that are loaded into parameter registers for calls/syscalls
        if inst.op == MACH_MOV or inst.op == MACH_STORE:
            if inst.dst.kind == OPND_PHYS:
                if reg_is_parameter_reg(abi, inst.dst.phys):
                    if inst.src1.kind == OPND_VREG:
                        let v = inst.src1.vreg
                        if v < graph_size as u32:
                            is_arg_vreg[v] = true
        elif inst.op == MACH_LEA:
            if inst.src1.kind == OPND_VREG:
                let v = inst.src1.vreg
                if v < graph_size as u32:
                    address_taken[v] = true
        scan_idx = scan_idx + 1

    // Precompute call instruction positions once so each interval check is O(log m)
    // instead of the naive O(m) inner scan per interval.
    let call_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut call_count := 0 as i64
    mut ci_scan := 0 as i64
    while ci_scan < insts_len:
        let op2 = insts[ci_scan].op
        if op2 == MACH_CALL or op2 == MACH_CALL_INDIRECT:
            call_pos[call_count] = ci_scan as i32
            call_count = call_count + 1
        ci_scan = ci_scan + 1

    mut iv_idx := 0 as i64
    while iv_idx < intervals.len:
        let vreg = intervals.data[iv_idx].vreg
        let istart = intervals.data[iv_idx].start
        let iend = intervals.data[iv_idx].end
        if call_count > 0 as i64:
            mut lo := 0 as i64
            mut hi := call_count - 1 as i64
            while lo <= hi:
                let mid = (lo + hi) / 2 as i64
                let cp = call_pos[mid]
                if cp <= istart:
                    lo = mid + 1 as i64
                elif cp >= iend:
                    hi = mid - 1 as i64
                else:
                    spans_call[vreg] = true
                    break
        iv_idx = iv_idx + 1
    @free(call_pos as ptr[u8])

    // MACH_IDIV clobbers RAX and RDX (the `cqo; idiv` sequence). Any vreg whose
    // live range SPANS an idiv — not just the dividend (handled above) — must not
    // be assigned RAX/RDX, otherwise the division silently destroys it. This bit
    // the reverse-loop counter `i` (held in RDX) across `len / 2`: `cqo` wiped RDX
    // → infinite loop; and any function doing `/`/`%` with a live RDX/RAX value
    // (incl. the parser → stage3 token misread). Mirror the spans_call logic.
    let idiv_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut idiv_count := 0 as i64
    mut di_scan := 0 as i64
    while di_scan < insts_len:
        if insts[di_scan].op == MACH_IDIV:
            idiv_pos[idiv_count] = di_scan as i32
            idiv_count = idiv_count + 1
        di_scan = di_scan + 1

    if idiv_count > 0 as i64:
        mut iv2 := 0 as i64
        while iv2 < intervals.len:
            let vreg2 = intervals.data[iv2].vreg
            let istart2 = intervals.data[iv2].start
            let iend2 = intervals.data[iv2].end
            mut lo2 := 0 as i64
            mut hi2 := idiv_count - 1 as i64
            while lo2 <= hi2:
                let mid2 = (lo2 + hi2) / 2 as i64
                let dp = idiv_pos[mid2]
                if dp <= istart2:
                    lo2 = mid2 + 1 as i64
                elif dp >= iend2:
                    hi2 = mid2 - 1 as i64
                else:
                    if vreg2 < graph_size as u32:
                        forbid_rax_rdx[vreg2] = true
                    break
            iv2 = iv2 + 1
    @free(idiv_pos as ptr[u8])

    // For very large functions, the O(n^2) interference graph overflows memory.
    // Fall back to spill-all: every vreg gets a stack slot.
    // Correct but conservative; the emitter already handles spills.
    // insts_len > 5000 catches huge selector functions (~10K mach insts) that
    // would OOM even with a modest interval count.
    let REGALLOC_GRAPH_LIMIT: i64 = 50000
    let REGALLOC_INSTS_LIMIT: i64 = 5000
    if intervals.len > REGALLOC_GRAPH_LIMIT or insts_len > REGALLOC_INSTS_LIMIT:
        let allocs_s = @alloc(graph_size * 12) as ptr[RegAllocation]
        @memset(allocs_s as ptr[u8], 0 as u8, graph_size * 12)
        let seen_s = @alloc(graph_size) as ptr[bool]
        @memset(seen_s as ptr[u8], 0 as u8, graph_size)
        mut spill_count_s := 0 as i32
        mut siv := 0 as i64
        while siv < intervals.len:
            let sv := intervals.data[siv].vreg
            if not seen_s[sv]:
                seen_s[sv] = true
                allocs_s[sv] = RegAllocation(vreg: sv, phys: REG_NONE, spilled: true, spill_idx: spill_count_s)
                // 16-byte (str/16-byte struct) values occupy TWO 8-byte stack
                // slots. The graph-coloring path reserves 2; this spill-all
                // fallback (used for large functions) MUST do the same, else
                // each spilled 16-byte value clobbers the next vreg's slot.
                if regalloc_is_16byte(sv, fn_ptr, table, symbols):
                    spill_count_s = spill_count_s + 2
                else:
                    spill_count_s = spill_count_s + 1
            siv = siv + 1
        @free(seen_s as ptr[u8])
        @free(param_idx_of_vreg as ptr[u8])
        @free(spans_call as ptr[u8])
        @free(forbid_rax_rdx as ptr[u8])
        @free(forbid_rcx as ptr[u8])
        @free(is_arg_vreg as ptr[u8])
        @free(address_taken as ptr[u8])
        return RegAllocResult(allocs: allocs_s, max_vreg: max_vreg, spill_count: spill_count_s, pad0: 0 as i64)

    let adj = @alloc(graph_size * 24) as ptr[U32Vec]
    mut vi := 0 as i64
    while vi < graph_size:
        adj[vi] = new_u32_vec()
        vi = vi + 1

    mut i := 0 as i64
    while i < intervals.len:
        let iv1 = &intervals.data[i]
        mut j := i + 1
        while j < intervals.len:
            let iv2 = &intervals.data[j]
            if iv2.start > iv1.end:
                break
            if iv1.vreg != iv2.vreg:
                adj[iv1.vreg].push(iv2.vreg)
                adj[iv2.vreg].push(iv1.vreg)
            j = j + 1
        i = i + 1

    let degrees = @alloc(graph_size * 4) as ptr[i32]
    mut di := 0 as i64
    while di < graph_size:
        degrees[di] = adj[di].len as i32
        di = di + 1

    let removed = @alloc(graph_size) as ptr[bool]
    @memset(removed as ptr[u8], 0 as u8, graph_size)

    mut stack := new_u32_vec()
    let K = avail_regs_len as i32
    mut simplified_count := 0 as i64
    let target_count = intervals.len

    mut simplify_worklist := new_u32_vec()
    
    let in_worklist = @alloc(graph_size) as ptr[bool]
    @memset(in_worklist as ptr[u8], 0 as u8, graph_size)

    mut init_i := 0 as i64
    while init_i < intervals.len:
        let vreg = intervals.data[init_i].vreg
        if degrees[vreg] < K:
            simplify_worklist.push(vreg)
            in_worklist[vreg] = true
        init_i = init_i + 1

    while simplified_count < target_count:
        if simplify_worklist.len > 0:
            let node = simplify_worklist.pop()
            if not removed[node]:
                stack.push(node)
                removed[node] = true
                simplified_count = simplified_count + 1
                
                mut n_idx := 0 as i64
                while n_idx < adj[node].len:
                    let neighbor = adj[node].data[n_idx]
                    if not removed[neighbor]:
                        degrees[neighbor] = degrees[neighbor] - 1
                        if degrees[neighbor] < K and not in_worklist[neighbor]:
                            simplify_worklist.push(neighbor)
                            in_worklist[neighbor] = true
                    n_idx = n_idx + 1
        else:
            mut spill_candidate := 0 as u32
            mut max_degree := -1 as i32
            mut has_candidate := false

            mut iv_idx := 0 as i64
            while iv_idx < intervals.len:
                let vreg = intervals.data[iv_idx].vreg
                if not removed[vreg]:
                    if degrees[vreg] > max_degree:
                        max_degree = degrees[vreg]
                        spill_candidate = vreg
                        has_candidate = true
                iv_idx = iv_idx + 1

            if not has_candidate:
                break

            stack.push(spill_candidate)
            removed[spill_candidate] = true
            simplified_count = simplified_count + 1

            mut n_idx := 0 as i64
            while n_idx < adj[spill_candidate].len:
                let neighbor = adj[spill_candidate].data[n_idx]
                if not removed[neighbor]:
                    degrees[neighbor] = degrees[neighbor] - 1
                    if degrees[neighbor] < K and not in_worklist[neighbor]:
                        simplify_worklist.push(neighbor)
                        in_worklist[neighbor] = true
                n_idx = n_idx + 1


    let assigned_colors = @alloc(graph_size) as ptr[u8]
    @memset(assigned_colors, REG_NONE, graph_size)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)
    mut spill_count := 0 as i32

    mut st_idx := stack.len - 1
    while st_idx >= 0:
        let vreg = stack.data[st_idx]
        let forbidden = @alloc(256) as ptr[bool]
        @memset(forbidden as ptr[u8], 0 as u8, 256)

        let p_idx = param_idx_of_vreg[vreg as i64]
        if p_idx != -1 as i32:
            mut j := (p_idx + 1) as i64
            while j < 6 as i64:
                let r = abi_int_arg_reg(abi, j)
                if r != REG_NONE:
                    forbidden[r as i64] = true
                j = j + 1

        mut n_idx := 0 as i64
        while n_idx < adj[vreg].len:
            let neighbor = adj[vreg].data[n_idx]
            let color = assigned_colors[neighbor]
            if color != REG_NONE:
                forbidden[color] = true
            n_idx = n_idx + 1

        if spans_call[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_caller_saved(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if is_arg_vreg[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_parameter_reg(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if forbid_rax_rdx[vreg]:
            forbidden[REG_RAX as i64] = true
            forbidden[REG_RDX as i64] = true

        if forbid_rcx[vreg]:
            forbidden[REG_RCX as i64] = true

        mut colored := false
        mut c_idx := 0 as i64
        while c_idx < avail_regs_len:
            let color = avail_regs[c_idx]
            if not forbidden[color]:
                assigned_colors[vreg] = color
                allocs[vreg] = RegAllocation(vreg: vreg, phys: color, spilled: false, spill_idx: 0 as i32)
                colored = true
                break
            c_idx = c_idx + 1

        @free(forbidden as ptr[u8])

        if regalloc_is_16byte(vreg, fn_ptr, table, symbols):
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 2
            assigned_colors[vreg] = REG_NONE
        elif address_taken[vreg]:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE
        elif not colored:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE

        st_idx = st_idx - 1

    @free(removed as ptr[u8])
    @free(degrees as ptr[u8])
    @free(assigned_colors)
    @free(spans_call as ptr[u8])
    @free(forbid_rax_rdx as ptr[u8])
    @free(forbid_rcx as ptr[u8])
    @free(is_arg_vreg as ptr[u8])
    @free(param_idx_of_vreg as ptr[u8])
    @free(address_taken as ptr[u8])
    @free(in_worklist as ptr[u8])
    if simplify_worklist.data != null as ptr[u32]:
        @free(simplify_worklist.data as ptr[u8])
    if stack.data != null as ptr[u32]:
        @free(stack.data as ptr[u8])

    mut f_idx := 0 as i64
    while f_idx < graph_size:
        if adj[f_idx].data != null as ptr[u32]:
            @free(adj[f_idx].data as ptr[u8])
        f_idx = f_idx + 1
    @free(adj as ptr[u8])

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_count, pad0: 0 as i64)

pub fn get_used_callee_saved(abi: str, allocs: ptr[RegAllocation], max_vreg: u32, out_len: ptr[i64]) -> ptr[u8]:
    let used = @alloc(16) as ptr[bool]
    @memset(used as ptr[u8], 0 as u8, 16)

    // BUG#17: `max_vreg as i64` (u32->i64 zero-extend) is mis-compiled by the
    // native backend, leaving garbage in the upper 32 bits -> garbage-large
    // bound -> allocs[] OOB. Mask to a clean u32 so the loop stays in range.
    let mv_bound = (max_vreg as i64) & (4294967295 as i64)
    mut i := 0 as i64
    while i <= mv_bound:
        let phys = allocs[i].phys
        if phys != REG_NONE:
            if abi == "win64":
                if reg_is_win64_callee_saved(phys):
                    used[phys] = true
            else:
                if reg_is_sysv_callee_saved(phys):
                    used[phys] = true
        i = i + 1

    mut count := 0 as i64
    mut r := 0 as i64
    while r < 16:
        if used[r]:
            count = count + 1
        r = r + 1

    let result = @alloc(count) as ptr[u8]
    mut idx := 0 as i64
    r = 0
    while r < 16:
        if used[r]:
            result[idx] = r as u8
            idx = idx + 1
        r = r + 1

    @free(used as ptr[u8])
    out_len[0] = count
    return result

pub struct StackFrame:
    pub callee_saved: ptr[u8]
    pub callee_saved_len: i64
    pub spill_slots: i32
    pub local_bytes: i32
    pub align_padding: i32
    pub total_size: i32

pub fn compute_frame(callee_saved: ptr[u8], callee_saved_len: i64, spill_count: i32, local_bytes: i32, abi: str) -> StackFrame:
    mut needed := spill_count * 8 + local_bytes
    if abi == "win64":
        needed = needed + 32
    let pushed_bytes = (callee_saved_len + 2) * 8

    mut total := needed
    mut padding := 0 as i32
    if (pushed_bytes + total as i64) % 16 != 0:
        padding = (16 as i64 - (pushed_bytes + total as i64) % 16) as i32
        total = total + padding

    return StackFrame(
        callee_saved: callee_saved,
        callee_saved_len: callee_saved_len,
        spill_slots: spill_count,
        local_bytes: local_bytes,
        align_padding: padding,
        total_size: total
    )

pub fn emit_prologue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := 0 as i64
    while i < frame.callee_saved_len:
        let reg = frame.callee_saved[i]
        out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i + 1

    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub fn emit_epilogue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := frame.callee_saved_len - 1
    while i >= 0:
        let reg = frame.callee_saved[i]
        out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i - 1

    out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub const DST_UNUSED: u8 = 0
pub const DST_WRITE_ONLY: u8 = 1
pub const DST_READ_WRITE: u8 = 2
pub const DST_READ_ONLY: u8 = 3

pub fn get_dst_behavior(op: u16) -> u8:
    if op == MACH_MOV or op == MACH_MOV_IMM or op == MACH_XOR_ZERO or op == MACH_SETCC or op == MACH_MOVZX_B or op == MACH_POP or op == MACH_LOAD or op == MACH_LEA:
        return DST_WRITE_ONLY
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_NEG or op == MACH_NOT or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR:
        return DST_READ_WRITE
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE:
        return DST_READ_ONLY
    return DST_UNUSED

pub fn insert_spill_code(insts: ptr[MachInst], insts_len: i64, allocs: ptr[RegAllocation], frame: ptr[StackFrame], fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> MachInstVec:
    mut result := new_mach_inst_vec()

    // if insts_len > 300 as i64:
    //     ax_printf_local("[Debug] insert_spill_code for function sym_id=%d, len=%d:\n", fn_ptr.sym_id as i64, insts_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //     mut max_v := 0 as u32
    //     mut j := 0 as i64
    //     while j < insts_len:
    //         let inst = insts[j]
    //         ax_printf_local("  inst %d: op=%d, dst.kind=%d, dst.vreg=%d, src1.kind=%d, src1.vreg=%d\n", j, inst.op as i64, inst.dst.kind as i64, inst.dst.vreg as i64, inst.src1.kind as i64, inst.src1.vreg as i64, 0 as i64, 0 as i64)
    //         if inst.dst.kind == 1 as u8 and inst.dst.vreg > max_v:
    //             max_v = inst.dst.vreg
    //         if inst.src1.kind == 1 as u8 and inst.src1.vreg > max_v:
    //             max_v = inst.src1.vreg
    //         if inst.src2.kind == 1 as u8 and inst.src2.vreg > max_v:
    //             max_v = inst.src2.vreg
    //         j = j + 1
    // 
    //     mut k := 0 as i32
    //     while k <= max_v as i32:
    //         let alloc = allocs[k]
    //         if alloc.spilled:
    //             let is_16 = regalloc_is_16byte(k as u32, fn_ptr, table, symbols)
    //             ax_printf_local("  vreg %d: spilled=true, spill_idx=%d, is_16=%d\n", k as i64, alloc.spill_idx as i64, is_16 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //         k = k + 1

    mut i := 0 as i64
    while i < insts_len:
        mut inst := insts[i]

        if inst.src1.kind == OPND_VREG:
            let v = inst.src1.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16 = regalloc_is_16byte(v, fn_ptr, table, symbols)
                mut add_mult := 1 as i64
                if is_16:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if inst.op == MACH_LEA and inst.src2.kind == OPND_IMM:
                    // GET_FIELD on a pointer / by-ref struct base (the only LEA whose
                    // src2 is an IMM disp): the spilled vreg's SLOT holds a pointer
                    // VALUE (a heap address), not inline data. We want value(src1)+disp,
                    // so LOAD the pointer from the slot into a scratch register and keep
                    // the field disp. Rewriting to RBP+slot+disp (the home-address path
                    // below) would point at this frame's stack slot instead of the heap
                    // object — silently losing through-pointer field mutation.
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif inst.op == MACH_LEA:
                    // LEA of a spilled vreg with no disp means "address of the value"
                    // (&self / MAKE_REF / 16-byte value address): rewrite to RBP + slot
                    // offset. Loading the value and taking lea (reg) would yield the
                    // value itself, not its address.
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                    inst.src2 = MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)
                elif is_16:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg(fn_ptr, v):
                    // RFC 0006: a spilled FLOAT operand must be reloaded into an
                    // XMM scratch via movsd (MACH_LOAD with xmm dst). Reloading
                    // into a GP scratch (R10) would leave the value in the wrong
                    // register file — float encoders (addsd/cvttsd2si/…) encode
                    // the operand as XMM, and R10's hw-index aliases XMM10, so the
                    // CPU would read garbage. XMM0/XMM1 are scratch (not in the
                    // allocatable XMM8-15 set).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        if inst.src2.kind == OPND_VREG:
            let v = inst.src2.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16_s2 = regalloc_is_16byte(v, fn_ptr, table, symbols)
                mut add_mult := 1 as i64
                if is_16_s2:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if is_16_s2:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg(fn_ptr, v):
                    // RFC 0006: spilled FLOAT src2 → XMM1 scratch via movsd (see src1).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        mut dst_spilled := false
        mut dst_alloc = RegAllocation(vreg: 0 as u32, phys: 0 as u8, spilled: false, spill_idx: 0 as i32)
        if inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                dst_spilled = true
                dst_alloc = alloc

        if dst_spilled:
            let behavior = get_dst_behavior(inst.op)
            let is_16_dst = regalloc_is_16byte(dst_alloc.vreg, fn_ptr, table, symbols)
            mut add_mult := 1 as i64
            if is_16_dst:
                add_mult = 2 as i64
            let offset = -((frame.callee_saved_len + add_mult + dst_alloc.spill_idx as i64) * 8)

            if behavior == DST_READ_ONLY:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
            elif behavior == DST_READ_WRITE:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            elif behavior == DST_WRITE_ONLY:
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            else:
                result.push(inst)
        else:
            result.push(inst)

        i = i + 1
    return result

pub fn is_float_vreg(fn_ptr: ptr[AirFunc], vreg: u32) -> bool:
    if vreg == 0 as u32:
        return false
    mut i := 0 as i64
    while i < fn_ptr.insts.len:
        let inst = &fn_ptr.insts.data[i]
        if inst.dest == vreg:
            let t_id = inst.type_id
            return t_id == 9 as u32 or t_id == 10 as u32
        i = i + 1
    return false

pub fn get_allocatable_xmms(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(8) as ptr[u8]
    arr[0] = REG_XMM8
    arr[1] = REG_XMM9
    arr[2] = REG_XMM10
    arr[3] = REG_XMM11
    arr[4] = REG_XMM12
    arr[5] = REG_XMM13
    arr[6] = REG_XMM14
    arr[7] = REG_XMM15
    out_len[0] = 8
    return arr

pub fn allocate_registers_orchestrator(intervals: LiveIntervalVec, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    mut gpr_intervals := new_live_interval_vec()
    mut xmm_intervals := new_live_interval_vec()

    mut i := 0 as i64
    while i < intervals.len:
        let iv = intervals.data[i]
        if is_float_vreg(fn_ptr, iv.vreg):
            xmm_intervals.push(iv)
        else:
            gpr_intervals.push(iv)
        i = i + 1

    mut gpr_len := 0 as i64
    let avail_gprs = get_allocatable_gprs(&gpr_len)

    mut xmm_len := 0 as i64
    let avail_xmms = get_allocatable_xmms(&xmm_len)

    let gpr_alloc = graph_coloring_alloc(gpr_intervals, avail_gprs, gpr_len, insts, insts_len, abi, fn_ptr, table, symbols)
    let xmm_alloc = graph_coloring_alloc(xmm_intervals, avail_xmms, xmm_len, insts, insts_len, abi, fn_ptr, table, symbols)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)

    mut v := 0 as i64
    while v < graph_size:
        allocs[v] = RegAllocation(vreg: v as u32, phys: REG_NONE, spilled: false, spill_idx: 0 as i32)
        v = v + 1

    if gpr_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: `gpr_alloc.max_vreg as i64` is mis-compiled by the native
        // backend (u32 struct-field zero-extend reads the adjacent spill_count
        // into the upper 32 bits -> garbage-large bound -> allocs[] OOB scan ->
        // segfault). gpr_alloc.allocs is sized graph_size (== max_vreg+1, same
        // insts) with indices 0..graph_size-1 all initialized, so bound by the
        // clean local graph_size instead of the corrupt field read.
        mut idx := 0 as i64
        while idx < graph_size:
            let al = gpr_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                allocs[al.vreg] = al
            idx = idx + 1
        @free(gpr_alloc.allocs as ptr[u8])

    if xmm_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: same garbage-bound issue as the gpr loop above; bound by the
        // clean local graph_size (xmm_alloc.allocs is also sized graph_size).
        mut idx := 0 as i64
        while idx < graph_size:
            mut al := xmm_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                if al.spilled:
                    al.spill_idx = al.spill_idx + gpr_alloc.spill_count
                allocs[al.vreg] = al
            idx = idx + 1
        @free(xmm_alloc.allocs as ptr[u8])

    let spill_total = gpr_alloc.spill_count + xmm_alloc.spill_count

    if gpr_intervals.data != null as ptr[LiveInterval]:
        @free(gpr_intervals.data as ptr[u8])
    if xmm_intervals.data != null as ptr[LiveInterval]:
        @free(xmm_intervals.data as ptr[u8])
    @free(avail_gprs)
    @free(avail_xmms)

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_total, pad0: 0 as i64)
