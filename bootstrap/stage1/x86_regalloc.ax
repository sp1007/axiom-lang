// bootstrap/stage1/x86_regalloc.ax
// Liveness Analysis and Graph-Coloring Register Allocation for x86-64 in self-hosted AXIOM.

import std.string

pub struct LiveInterval:
    pub vreg: u32
    pub start: i32
    pub end: i32

pub struct LiveIntervalVec:
    pub data: ptr[LiveInterval]
    pub len: i64
    pub cap: i64

pub fn new_live_interval_vec() -> LiveIntervalVec:
    return LiveIntervalVec(data: null as ptr[LiveInterval], len: 0, cap: 0)

pub fn push(mut self: LiveIntervalVec, iv: LiveInterval) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[LiveInterval]
        if self.data != null as ptr[LiveInterval]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = iv
    self.len = self.len + 1
    return idx

pub fn is_two_operand_read(op: u16) -> bool:
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR or op == MACH_NEG or op == MACH_NOT:
        return true
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE:
        return true
    // BUG#41: comisd (MACH_FCMP) READS its dst operand (the lhs float). Without
    // this, the lhs's live interval is not extended to the compare, so it looks
    // dead right after its FCONST and the rhs's FCONST can be allocated the SAME
    // XMM -> comisd compares a value against itself -> every strict float compare
    // is false. At -O0 a laundering COPY masked it; at -O1 copy-prop removes it.
    if op == MACH_FCMP:
        return true
    // BUG#42: the float RMW ops lower to `op dst, src` (addsd/subsd/mulsd/divsd)
    // which READ dst. Same liveness hazard as FCMP -- without marking dst a read,
    // a chained result (e.g. `(a+b)*0.5`) is considered dead at the second op and
    // its XMM is reused, corrupting the value. Treat dst as a use, like MACH_*.
    if op == MACH_FADD or op == MACH_FSUB or op == MACH_FMUL or op == MACH_FDIV:
        return true
    return false

// RFC 0016 P2': does this opcode WRITE (overwrite) its dst vreg? Used to build the
// per-block def-set for CFG-aware liveness. CRITICAL SAFETY RULE: an opcode that
// only *reads* its dst (CMP/TEST/STORE/FCMP) must NOT be treated as a def — marking
// it a def would kill the value backward across the block and shrink its live range
// (miscompile). When unsure, return false: failing to record a def only keeps a
// value live longer (conservative, extra spills at worst), never wrong.
// Count trailing zeros of a non-zero u64 (position of the lowest set bit).
pub fn ctz_u64(x: u64) -> i64:
    if x == 0 as u64:
        return 64 as i64
    mut n := 0 as i64
    mut v := x
    while (v & (1 as u64)) == 0 as u64:
        v = v >> (1 as u64)
        n = n + 1 as i64
    return n

pub fn inst_defs_dst(op: u16) -> bool:
    if op == MACH_MOV or op == MACH_MOV_IMM or op == MACH_XOR_ZERO:
        return true
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_NEG or op == MACH_NOT:
        return true
    if op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR:
        return true
    if op == MACH_SETCC or op == MACH_MOVZX_B or op == MACH_LEA or op == MACH_LOAD or op == MACH_POP:
        return true
    if op == MACH_IDIV or op == MACH_DIV:
        return true
    if op == MACH_FADD or op == MACH_FSUB or op == MACH_FMUL or op == MACH_FDIV:
        return true
    if op == MACH_ITOF or op == MACH_FTOI or op == MACH_MOVDQ or op == MACH_MOVQD:
        return true
    if op == MACH_CVTSS2SD or op == MACH_CVTSD2SS:
        return true
    return false

pub fn compute_liveness(insts: ptr[MachInst], insts_len: i64) -> LiveIntervalVec:
    mut max_vreg := 0 as u32
    mut i := 0 as i64
    while i < insts_len:
        let inst = &insts[i]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        i = i + 1

    let map_size = (max_vreg + 1 as u32) as i64
    let interval_map = @alloc(map_size * 8) as ptr[ptr[LiveInterval]]
    @memset(interval_map as ptr[u8], 0 as u8, map_size * 8)

    i = 0 as i64
    while i < insts_len:
        let inst = &insts[i]

        if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
            let v = inst.dst.vreg
            if interval_map[v] == null as ptr[LiveInterval]:
                let iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = i as i32
                // M6 perf: a param snapshot (`MOV pv <- PHYS(arg reg)`) used to be pinned
                // live to the LAST instruction of the function. That predates the CFG-aware
                // dataflow below (RFC 0016 P2'), which already extends any vreg live across a
                // back-edge — including a param re-entered by RFC 0026 tail-self-recursion,
                // whose snapshot sits before .L_b_0 — to the linear hull of every block where
                // it is live. With the pin, EVERY param interfered with EVERY later value and
                // spanned every call, so it was forced into a callee-saved register and its
                // copy chain (`snap<-rcx; local<-snap`) could never be coalesced by the
                // move_partner bias: fib paid a push/pop of %rbx on all ~331M calls to hold a
                // value that is dead two instructions in. Ending the interval at the def and
                // letting the dataflow grow it is strictly more precise, never shorter than
                // real liveness (step 7 only grows intervals).
                iv.end = i as i32
                interval_map[v] = iv

        if inst.src1.kind == OPND_VREG and inst.src1.vreg != 0 as u32:
            let v = inst.src1.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if inst.src2.kind == OPND_VREG and inst.src2.vreg != 0 as u32:
            let v = inst.src2.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if is_two_operand_read(inst.op):
            if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                let v = inst.dst.vreg
                mut iv = interval_map[v]
                if iv == null as ptr[LiveInterval]:
                    iv = @alloc(12) as ptr[LiveInterval]
                    iv.vreg = v
                    iv.start = 0 as i32
                    iv.end = i as i32
                    interval_map[v] = iv
                elif (i as i32) > iv.end:
                    iv.end = i as i32
        i = i + 1

    // ===== CFG-aware liveness extension (RFC 0016 P2') =====
    // The base [first_def, last_use] intervals above are computed in *linear
    // instruction-array order*. That is only correct when the physical order is a
    // CFG topological order — which it is NOT once a lowering emits blocks out of
    // control-flow order (the if/else merge block, and future mid-expression
    // short-circuit blocks). The old back-edge hack only patched linearly-backward
    // jumps (loops) and could not see forward-reordered blocks, and it was not a
    // real dataflow so it also mis-handled some loop-carried values (t_math under
    // RPO). Here we build the basic-block CFG, solve live-in/live-out by backward
    // dataflow, then extend each vreg's contiguous interval to cover the linear
    // hull of every block where it is live. Extension only *grows* intervals, so it
    // can never shrink a real live range: at worst it is conservative (more
    // interference / spills), never a miscompile.
    if insts_len > 0 as i64:
        // --- 1. block boundaries: a block starts at index 0, at every LABEL, and
        //        at the instruction right after any JMP/JCC/RET terminator. ---
        let is_start = @alloc(insts_len) as ptr[bool]
        @memset(is_start as ptr[u8], 0 as u8, insts_len)
        is_start[0] = true
        mut si := 0 as i64
        while si < insts_len:
            let sop = insts[si].op
            if sop == MACH_LABEL:
                is_start[si] = true
            if sop == MACH_JMP or sop == MACH_JCC or sop == MACH_RET:
                if si + 1 as i64 < insts_len:
                    is_start[si + 1 as i64] = true
            si = si + 1

        // --- 2. assign block ids + lo/hi linear bounds ---
        let block_of = @alloc(insts_len * 4) as ptr[i32]
        mut nb := 0 as i64
        si = 0
        while si < insts_len:
            if is_start[si] and si > 0 as i64:
                nb = nb + 1
            block_of[si] = nb as i32
            si = si + 1
        let num_blocks = nb + 1 as i64

        let block_lo = @alloc(num_blocks * 8) as ptr[i64]
        let block_hi = @alloc(num_blocks * 8) as ptr[i64]
        mut bfill := 0 as i64
        while bfill < num_blocks:
            block_lo[bfill] = -1 as i64
            bfill = bfill + 1
        si = 0
        while si < insts_len:
            let b = block_of[si] as i64
            if block_lo[b] < 0 as i64:
                block_lo[b] = si
            block_hi[b] = si
            si = si + 1

        // --- 3. label -> block id ---
        mut max_label := 0 as u32
        si = 0
        while si < insts_len:
            if insts[si].op == MACH_LABEL:
                if insts[si].dst.label > max_label:
                    max_label = insts[si].dst.label
            si = si + 1
        let l2b_size = (max_label + 1 as u32) as i64
        let label_to_block = @alloc(l2b_size * 8) as ptr[i64]
        mut lf := 0 as i64
        while lf < l2b_size:
            label_to_block[lf] = -1 as i64
            lf = lf + 1
        si = 0
        while si < insts_len:
            if insts[si].op == MACH_LABEL:
                label_to_block[insts[si].dst.label as i64] = block_of[si] as i64
            si = si + 1

        // --- 4. successors (up to 2): JMP->target, JCC->target+fallthrough,
        //        RET->none, else fallthrough. Unknown targets fall through
        //        (conservative). ---
        let succ0 = @alloc(num_blocks * 8) as ptr[i64]
        let succ1 = @alloc(num_blocks * 8) as ptr[i64]
        mut sb := 0 as i64
        while sb < num_blocks:
            succ0[sb] = -1 as i64
            succ1[sb] = -1 as i64
            let last = &insts[block_hi[sb]]
            mut handled := false
            if last.op == MACH_JMP and last.dst.kind == OPND_LABEL:
                succ0[sb] = label_to_block[last.dst.label as i64]
                handled = true
            elif last.op == MACH_JCC and last.dst.kind == OPND_LABEL:
                succ0[sb] = label_to_block[last.dst.label as i64]
                if sb + 1 as i64 < num_blocks:
                    succ1[sb] = sb + 1 as i64
                handled = true
            elif last.op == MACH_RET:
                handled = true
            if not handled:
                if sb + 1 as i64 < num_blocks:
                    succ0[sb] = sb + 1 as i64
            sb = sb + 1

        // --- 5. per-block def/use bitsets (bit index = vreg id) ---
        let nwords = ((max_vreg as i64) + 64 as i64) / 64 as i64
        let use_set = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let def_set = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let live_in = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let live_out = @alloc(num_blocks * nwords * 8) as ptr[u64]
        @memset(use_set as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(def_set as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(live_in as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(live_out as ptr[u8], 0 as u8, num_blocks * nwords * 8)

        mut b2 := 0 as i64
        while b2 < num_blocks:
            let base_w = b2 * nwords
            mut ii := block_lo[b2]
            while ii <= block_hi[b2]:
                let inst = &insts[ii]
                // reads: src1, src2, and dst when the op reads dst too. A read is
                // an upward-exposed use only if not yet defined earlier in the block.
                if inst.src1.kind == OPND_VREG and inst.src1.vreg != 0 as u32:
                    let v = inst.src1.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                if inst.src2.kind == OPND_VREG and inst.src2.vreg != 0 as u32:
                    let v = inst.src2.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                if is_two_operand_read(inst.op) and inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                    let v = inst.dst.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                // def: only opcodes that actually overwrite dst.
                if inst_defs_dst(inst.op) and inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                    let v = inst.dst.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    def_set[w] = def_set[w] | mask
                ii = ii + 1
            b2 = b2 + 1

        // --- 6. backward dataflow fixpoint ---
        //   live_out[b] = U live_in[succ]
        //   live_in[b]  = use[b] U (live_out[b] - def[b])
        mut changed := true
        while changed:
            changed = false
            mut bb := num_blocks - 1 as i64
            while bb >= 0 as i64:
                let base_w = bb * nwords
                let s0 = succ0[bb]
                let s1 = succ1[bb]
                mut w := 0 as i64
                while w < nwords:
                    mut lo_word := 0 as u64
                    if s0 >= 0 as i64:
                        lo_word = lo_word | live_in[s0 * nwords + w]
                    if s1 >= 0 as i64:
                        lo_word = lo_word | live_in[s1 * nwords + w]
                    live_out[base_w + w] = lo_word
                    let new_li = use_set[base_w + w] | (lo_word & (~def_set[base_w + w]))
                    if new_li != live_in[base_w + w]:
                        live_in[base_w + w] = new_li
                        changed = true
                    w = w + 1
                bb = bb - 1 as i64

        // --- 7. extend intervals to the linear hull of live blocks ---
        //   live_in[b]  -> the vreg is live at b's entry: cover down to block_lo[b]
        //   live_out[b] -> the vreg is live at b's exit:  cover up to block_hi[b]
        mut b3 := 0 as i64
        while b3 < num_blocks:
            let base_w = b3 * nwords
            let lo = block_lo[b3] as i32
            let hi = block_hi[b3] as i32
            mut w := 0 as i64
            while w < nwords:
                mut liw := live_in[base_w + w]
                while liw != 0 as u64:
                    let tz = ctz_u64(liw)
                    let v = (w * 64 as i64) + tz
                    let iv = interval_map[v]
                    if iv != null as ptr[LiveInterval]:
                        if lo < iv.start:
                            iv.start = lo
                    liw = liw & (liw - 1 as u64)
                mut low := live_out[base_w + w]
                while low != 0 as u64:
                    let tz = ctz_u64(low)
                    let v = (w * 64 as i64) + tz
                    let iv = interval_map[v]
                    if iv != null as ptr[LiveInterval]:
                        if hi > iv.end:
                            iv.end = hi
                    low = low & (low - 1 as u64)
                w = w + 1
            b3 = b3 + 1

        @free(is_start as ptr[u8])
        @free(block_of as ptr[u8])
        @free(block_lo as ptr[u8])
        @free(block_hi as ptr[u8])
        @free(label_to_block as ptr[u8])
        @free(succ0 as ptr[u8])
        @free(succ1 as ptr[u8])
        @free(use_set as ptr[u8])
        @free(def_set as ptr[u8])
        @free(live_in as ptr[u8])
        @free(live_out as ptr[u8])

    mut result := new_live_interval_vec()
    mut v := 0 as i64
    while v < map_size:
        let iv = interval_map[v]
        if iv != null as ptr[LiveInterval]:
            result.push(iv[0])
            @free(iv as ptr[u8])
        v = v + 1
    @free(interval_map as ptr[u8])

    // Counting sort on start positions — O(n + insts_len) vs O(n^2) insertion sort.
    // start values are always in [0, insts_len), so insts_len is the range bound.
    if result.len > 1 as i64 and insts_len > 0 as i64:
        let count_arr = @alloc(insts_len * 4) as ptr[i32]
        @memset(count_arr as ptr[void], 0 as u8, insts_len * 4)
        mut ci := 0 as i64
        while ci < result.len:
            let s = result.data[ci].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] + 1
            ci = ci + 1
        mut pi := 1 as i64
        while pi < insts_len:
            count_arr[pi] = count_arr[pi] + count_arr[pi - 1 as i64]
            pi = pi + 1
        let sorted_buf = @alloc(result.len * 12) as ptr[LiveInterval]
        mut ri := result.len - 1 as i64
        while ri >= 0 as i64:
            let s = result.data[ri].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] - 1
                sorted_buf[count_arr[s as i64]] = result.data[ri]
            ri = ri - 1 as i64
        @memcpy(result.data as ptr[u8], sorted_buf as ptr[u8], result.len * 12)
        @free(sorted_buf as ptr[u8])
        @free(count_arr as ptr[u8])

    return result

pub struct RegAllocation:
    pub vreg: u32
    pub phys: u8
    pub spilled: bool
    pub spill_idx: i32

pub struct RegAllocResult:
    pub allocs: ptr[RegAllocation]
    pub max_vreg: u32
    pub spill_count: i32
    // BUG#18: with exactly {ptr@0, u32@8, i32@12} this struct is 16 bytes and the
    // native backend returns it by value via the str-like RAX:RDX path (which
    // assumes a {ptr, i64} layout), so reads of max_vreg/spill_count come back
    // wrong (max_vreg read returned the `allocs` pointer value -> giant loop
    // bound -> allocs[] OOB segfault). Pad to >16 bytes so it is returned
    // by-address (sret), the heavily-tested aggregate path (cf. LiveIntervalVec).
    pub pad0: i64

// NOTE (M6 perf, 2026-07-24e): a per-ABI "volatile GPRs first" reorder was tried here to
// shrink prologues (fewer callee-saved pushes). MEASURED NEUTRAL — fib's prologue was
// unchanged and the self-host driver was byte-identical in size. Reason: fib's callee-saved
// registers hold values LIVE ACROSS A CALL, which forbid volatiles (graph_coloring_alloc:867)
// and therefore MUST be callee-saved regardless of the preference order; the reorder only
// reaches non-call-spanning values, which weren't the bottleneck. The real fib cost is
// structural (redundant copies + greedy-colouring quality + values kept live across calls),
// not the register preference order. Kept the original order; see [[m6-perf-baseline]].
pub fn get_allocatable_gprs(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(12) as ptr[u8]
    arr[0] = REG_RAX
    arr[1] = REG_RCX
    arr[2] = REG_RDX
    arr[3] = REG_RBX
    arr[4] = REG_RSI
    arr[5] = REG_RDI
    arr[6] = REG_R8
    arr[7] = REG_R9
    arr[8] = REG_R12
    arr[9] = REG_R13
    arr[10] = REG_R14
    arr[11] = REG_R15
    out_len[0] = 12
    return arr

pub fn reg_is_caller_saved(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    else:
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_RSI or r == REG_RDI or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    return false

pub fn reg_is_parameter_reg(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9:
            return true
    else:
        if r == REG_RDI or r == REG_RSI or r == REG_RDX or r == REG_RCX or r == REG_R8 or r == REG_R9:
            return true
    return false


pub fn graph_coloring_alloc(intervals: LiveIntervalVec, avail_regs: ptr[u8], avail_regs_len: i64, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    if intervals.len == 0 or avail_regs_len == 0:
        return RegAllocResult(allocs: null as ptr[RegAllocation], max_vreg: 0 as u32, spill_count: 0 as i32, pad0: 0 as i64)

    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    // PERF: one def-index for the whole allocation; feeds regalloc_is_16byte_cached
    // in both the spill-all fallback (per interval) and the coloring phase, turning
    // their O(vregs × insts) 16-byte checks into O(vregs). Freed on every return.
    let r16_def_idx = build_vreg_def_idx(fn_ptr, graph_size)

    let param_idx_of_vreg = @alloc(graph_size * 4) as ptr[i32]
    mut param_vi := 0 as i64
    while param_vi < graph_size:
        param_idx_of_vreg[param_vi] = -1 as i32
        param_vi = param_vi + 1

    mut inst_idx := 0 as i64
    while inst_idx < insts_len:
        let inst = insts[inst_idx]
        if inst.op == MACH_MOV and inst.dst.kind == OPND_VREG and inst.src1.kind == OPND_PHYS:
            let phys = inst.src1.phys
            mut p_idx := -1 as i32
            if abi == "win64":
                if phys == REG_RCX:
                    p_idx = 0 as i32
                elif phys == REG_RDX:
                    p_idx = 1 as i32
                elif phys == REG_R8:
                    p_idx = 2 as i32
                elif phys == REG_R9:
                    p_idx = 3 as i32
            else:
                if phys == REG_RDI:
                    p_idx = 0 as i32
                elif phys == REG_RSI:
                    p_idx = 1 as i32
                elif phys == REG_RDX:
                    p_idx = 2 as i32
                elif phys == REG_RCX:
                    p_idx = 3 as i32
                elif phys == REG_R8:
                    p_idx = 4 as i32
                elif phys == REG_R9:
                    p_idx = 5 as i32
            
            if p_idx != -1 as i32:
                let vr = inst.dst.vreg
                if vr < max_vreg + 1 as u32:
                    param_idx_of_vreg[vr as i64] = p_idx
        inst_idx = inst_idx + 1

    // Determine for each virtual register if its live interval spans any call instruction
    let spans_call = @alloc(graph_size) as ptr[bool]
    @memset(spans_call as ptr[u8], 0 as u8, graph_size)

    let forbid_rax_rdx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rax_rdx as ptr[u8], 0 as u8, graph_size)

    let forbid_rcx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rcx as ptr[u8], 0 as u8, graph_size)

    let is_arg_vreg = @alloc(graph_size) as ptr[bool]
    @memset(is_arg_vreg as ptr[u8], 0 as u8, graph_size)

    let address_taken = @alloc(graph_size) as ptr[bool]
    @memset(address_taken as ptr[u8], 0 as u8, graph_size)

    // MOVE COALESCING (biased coloring): for each vreg, record ONE move partner —
    // the other vreg of a `MOV vdst, vsrc` it appears in. During color selection we
    // try to give a vreg the same physical register its partner already got, so the
    // MOV becomes a self-move (`mov r,r`) the emitter peephole then deletes. This
    // removes the redundant param/snapshot copy chains (`snap<-rcx; pvreg<-snap`)
    // that otherwise inflate register pressure and force extra callee-saved pushes.
    // SAFETY: the bias only ever picks a color that is NOT forbidden (interference,
    // spans_call, arg-reg, div/shift constraints all already recorded there) and that
    // is a member of this pass's avail_regs (so a cross-class movq gpr<->xmm partner
    // can never mis-bias). First move wins; a vreg in no vreg-to-vreg MOV stays -1.
    let move_partner = @alloc(graph_size * 4) as ptr[i32]
    mut mp_init := 0 as i64
    while mp_init < graph_size:
        move_partner[mp_init] = -1 as i32
        mp_init = mp_init + 1

    mut scan_idx := 0 as i64
    while scan_idx < insts_len:
        let inst = &insts[scan_idx]
        if (inst.op == MACH_IDIV or inst.op == MACH_DIV) and inst.src1.kind == OPND_VREG:
            // RFC 0006: the (unsigned) DIV divisor, like IDIV's, must avoid
            // rax/rdx — those are the implicit dividend/remainder and the
            // sequence zeroes rdx, which would clobber a divisor placed there.
            let v = inst.src1.vreg
            if v < graph_size as u32:
                forbid_rax_rdx[v] = true
        
        if (inst.op == MACH_SHL or inst.op == MACH_SAR or inst.op == MACH_SHR) and inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            if v < graph_size as u32:
                forbid_rcx[v] = true
        
        // Tag virtual registers that are loaded into parameter registers for calls/syscalls
        if inst.op == MACH_MOV or inst.op == MACH_STORE:
            if inst.dst.kind == OPND_PHYS:
                if reg_is_parameter_reg(abi, inst.dst.phys):
                    if inst.src1.kind == OPND_VREG:
                        let v = inst.src1.vreg
                        if v < graph_size as u32:
                            is_arg_vreg[v] = true
        elif inst.op == MACH_LEA:
            if inst.src1.kind == OPND_VREG:
                let v = inst.src1.vreg
                if v < graph_size as u32:
                    address_taken[v] = true
        if inst.op == MACH_MOV and inst.dst.kind == OPND_VREG and inst.src1.kind == OPND_VREG:
            let vd = inst.dst.vreg
            let vs = inst.src1.vreg
            if vd != vs and vd < graph_size as u32 and vs < graph_size as u32:
                if move_partner[vd as i64] == -1 as i32:
                    move_partner[vd as i64] = vs as i32
                if move_partner[vs as i64] == -1 as i32:
                    move_partner[vs as i64] = vd as i32
        scan_idx = scan_idx + 1

    // Precompute call instruction positions once so each interval check is O(log m)
    // instead of the naive O(m) inner scan per interval.
    let call_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut call_count := 0 as i64
    mut ci_scan := 0 as i64
    while ci_scan < insts_len:
        let op2 = insts[ci_scan].op
        if op2 == MACH_CALL or op2 == MACH_CALL_INDIRECT:
            call_pos[call_count] = ci_scan as i32
            call_count = call_count + 1
        ci_scan = ci_scan + 1

    mut iv_idx := 0 as i64
    while iv_idx < intervals.len:
        let vreg = intervals.data[iv_idx].vreg
        let istart = intervals.data[iv_idx].start
        let iend = intervals.data[iv_idx].end
        if call_count > 0 as i64:
            mut lo := 0 as i64
            mut hi := call_count - 1 as i64
            while lo <= hi:
                let mid = (lo + hi) / 2 as i64
                let cp = call_pos[mid]
                if cp <= istart:
                    lo = mid + 1 as i64
                elif cp >= iend:
                    hi = mid - 1 as i64
                else:
                    spans_call[vreg] = true
                    break
        iv_idx = iv_idx + 1
    @free(call_pos as ptr[u8])

    // MACH_IDIV / MACH_DIV clobber RAX and RDX (the `cqo; idiv` and `mov rdx,0;
    // div` sequences). Any vreg whose live range SPANS a division — not just the
    // dividend/divisor (handled above) — must not be assigned RAX/RDX, otherwise
    // the division silently destroys it. This bit the reverse-loop counter `i`
    // (held in RDX) across `len / 2`: `cqo` wiped RDX → infinite loop; and any
    // function doing `/`/`%` with a live RDX/RAX value (incl. the parser → stage3
    // token misread). BUG#47: the UNSIGNED path emits MACH_DIV (not MACH_IDIV),
    // so this span pass must scan BOTH — otherwise an unsigned `%`/`/` in a loop
    // wipes a loop-carried value sitting in RDX (e.g. the dividend `n` across a
    // trial-division primality loop). Mirror the spans_call logic.
    let idiv_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut idiv_count := 0 as i64
    mut di_scan := 0 as i64
    while di_scan < insts_len:
        // MACH_DIVCLOBBER marks a div/mod-by-pow2 strength-reduced sequence that
        // clobbers RAX+RDX (see x86_selector.ax); treat it exactly like IDIV/DIV so
        // any vreg whose live range spans it is denied RAX/RDX.
        if insts[di_scan].op == MACH_IDIV or insts[di_scan].op == MACH_DIV or insts[di_scan].op == MACH_DIVCLOBBER:
            idiv_pos[idiv_count] = di_scan as i32
            idiv_count = idiv_count + 1
        di_scan = di_scan + 1

    if idiv_count > 0 as i64:
        mut iv2 := 0 as i64
        while iv2 < intervals.len:
            let vreg2 = intervals.data[iv2].vreg
            let istart2 = intervals.data[iv2].start
            let iend2 = intervals.data[iv2].end
            mut lo2 := 0 as i64
            mut hi2 := idiv_count - 1 as i64
            while lo2 <= hi2:
                let mid2 = (lo2 + hi2) / 2 as i64
                let dp = idiv_pos[mid2]
                if dp <= istart2:
                    lo2 = mid2 + 1 as i64
                elif dp >= iend2:
                    hi2 = mid2 - 1 as i64
                else:
                    if vreg2 < graph_size as u32:
                        forbid_rax_rdx[vreg2] = true
                    break
            iv2 = iv2 + 1
    @free(idiv_pos as ptr[u8])

    // A VARIABLE-COUNT shift clobbers RCX. x86 can only shift by an immediate or by
    // CL, so `MACH_SHL/SAR/SHR` whose count operand is NOT an immediate is emitted as
    // the `_cl` form (x86_emitter.ax:326-342) preceded by `MOV PHYS(rcx) <- count`.
    // That mov destroys whatever else was living in RCX. The `forbid_rcx` scan above
    // only protects the shift's own DESTINATION vreg, which is not the value at risk:
    // any vreg whose live range merely SPANS the shift can be sitting in RCX and is
    // silently corrupted. Mirror the IDIV/RAX-RDX span rule above and deny RCX to every
    // interval that strictly contains a variable shift. (Immediate-count shifts —
    // `sar $1,%rax`, incl. the div/mod-by-pow2 strength reduction — never touch RCX and
    // must NOT be included, or every shift-heavy function loses a register for nothing.)
    // LATENT until parameter liveness became precise: params used to be pinned live to
    // the end of their function, so they always spanned a call and were forced into
    // callee-saved registers, never RCX. With precise intervals a pointer param landed
    // in RCX across `n >> 1` and the callee wrote through a corrupted pointer (t_fft
    // SIGSEGV) — the bug was always here, the pin was accidentally hiding it.
    let vshift_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut vshift_count := 0 as i64
    mut vs_scan := 0 as i64
    while vs_scan < insts_len:
        let vop = insts[vs_scan].op
        if vop == MACH_SHL or vop == MACH_SAR or vop == MACH_SHR:
            if insts[vs_scan].src1.kind != OPND_IMM:
                vshift_pos[vshift_count] = vs_scan as i32
                vshift_count = vshift_count + 1
        vs_scan = vs_scan + 1

    if vshift_count > 0 as i64:
        mut iv3 := 0 as i64
        while iv3 < intervals.len:
            let vreg3 = intervals.data[iv3].vreg
            let istart3 = intervals.data[iv3].start
            let iend3 = intervals.data[iv3].end
            mut lo3 := 0 as i64
            mut hi3 := vshift_count - 1 as i64
            while lo3 <= hi3:
                let mid3 = (lo3 + hi3) / 2 as i64
                let sp = vshift_pos[mid3]
                if sp <= istart3:
                    lo3 = mid3 + 1 as i64
                elif sp >= iend3:
                    hi3 = mid3 - 1 as i64
                else:
                    if vreg3 < graph_size as u32:
                        forbid_rcx[vreg3] = true
                    break
            iv3 = iv3 + 1
    @free(vshift_pos as ptr[u8])

    // For very large functions, the O(n^2) interference graph overflows memory.
    // Fall back to spill-all: every vreg gets a stack slot.
    // Correct but conservative; the emitter already handles spills.
    // insts_len > 5000 catches huge selector functions (~10K mach insts) that
    // would OOM even with a modest interval count.
    let REGALLOC_GRAPH_LIMIT: i64 = 50000
    let REGALLOC_INSTS_LIMIT: i64 = 5000
    if intervals.len > REGALLOC_GRAPH_LIMIT or insts_len > REGALLOC_INSTS_LIMIT:
        let allocs_s = @alloc(graph_size * 12) as ptr[RegAllocation]
        @memset(allocs_s as ptr[u8], 0 as u8, graph_size * 12)
        let seen_s = @alloc(graph_size) as ptr[bool]
        @memset(seen_s as ptr[u8], 0 as u8, graph_size)
        mut spill_count_s := 0 as i32
        mut siv := 0 as i64
        while siv < intervals.len:
            let sv := intervals.data[siv].vreg
            if not seen_s[sv]:
                seen_s[sv] = true
                allocs_s[sv] = RegAllocation(vreg: sv, phys: REG_NONE, spilled: true, spill_idx: spill_count_s)
                // 16-byte (str/16-byte struct) values occupy TWO 8-byte stack
                // slots. The graph-coloring path reserves 2; this spill-all
                // fallback (used for large functions) MUST do the same, else
                // each spilled 16-byte value clobbers the next vreg's slot.
                if regalloc_is_16byte_cached(sv, fn_ptr, table, symbols, r16_def_idx, graph_size):
                    spill_count_s = spill_count_s + 2
                else:
                    spill_count_s = spill_count_s + 1
            siv = siv + 1
        @free(seen_s as ptr[u8])
        @free(param_idx_of_vreg as ptr[u8])
        @free(spans_call as ptr[u8])
        @free(forbid_rax_rdx as ptr[u8])
        @free(forbid_rcx as ptr[u8])
        @free(is_arg_vreg as ptr[u8])
        @free(address_taken as ptr[u8])
        @free(move_partner as ptr[u8])
        @free(r16_def_idx as ptr[u8])
        return RegAllocResult(allocs: allocs_s, max_vreg: max_vreg, spill_count: spill_count_s, pad0: 0 as i64)

    let adj = @alloc(graph_size * 24) as ptr[U32Vec]
    mut vi := 0 as i64
    while vi < graph_size:
        adj[vi] = new_u32_vec()
        vi = vi + 1

    mut i := 0 as i64
    while i < intervals.len:
        let iv1 = &intervals.data[i]
        mut j := i + 1
        while j < intervals.len:
            let iv2 = &intervals.data[j]
            if iv2.start > iv1.end:
                break
            if iv1.vreg != iv2.vreg:
                // MOVE COALESCING: a copy pair `d <- s` whose live ranges only TOUCH
                // at the copy point (s dies exactly where d begins) is not a real
                // conflict — the same register can hold s then d, making the copy a
                // self-move. The interval model would otherwise flag boundary contact
                // (iv2.start == iv1.end) as interference and forbid the shared color.
                // Drop the edge ONLY for a recorded move partner AND only when the
                // ranges are boundary-disjoint (no true overlap), so genuinely
                // simultaneously-live values still interfere. move_partner is
                // first-move-wins (conservative): a non-matching partner keeps the edge.
                mut coalesce_skip := false
                if move_partner[iv1.vreg as i64] == iv2.vreg as i32 or move_partner[iv2.vreg as i64] == iv1.vreg as i32:
                    if iv1.end <= iv2.start or iv2.end <= iv1.start:
                        coalesce_skip = true
                if not coalesce_skip:
                    adj[iv1.vreg].push(iv2.vreg)
                    adj[iv2.vreg].push(iv1.vreg)
            j = j + 1
        i = i + 1

    let degrees = @alloc(graph_size * 4) as ptr[i32]
    mut di := 0 as i64
    while di < graph_size:
        degrees[di] = adj[di].len as i32
        di = di + 1

    let removed = @alloc(graph_size) as ptr[bool]
    @memset(removed as ptr[u8], 0 as u8, graph_size)

    mut stack := new_u32_vec()
    let K = avail_regs_len as i32
    mut simplified_count := 0 as i64
    let target_count = intervals.len

    mut simplify_worklist := new_u32_vec()
    
    let in_worklist = @alloc(graph_size) as ptr[bool]
    @memset(in_worklist as ptr[u8], 0 as u8, graph_size)

    mut init_i := 0 as i64
    while init_i < intervals.len:
        let vreg = intervals.data[init_i].vreg
        if degrees[vreg] < K:
            simplify_worklist.push(vreg)
            in_worklist[vreg] = true
        init_i = init_i + 1

    while simplified_count < target_count:
        if simplify_worklist.len > 0:
            let node = simplify_worklist.pop()
            if not removed[node]:
                stack.push(node)
                removed[node] = true
                simplified_count = simplified_count + 1
                
                mut n_idx := 0 as i64
                while n_idx < adj[node].len:
                    let neighbor = adj[node].data[n_idx]
                    if not removed[neighbor]:
                        degrees[neighbor] = degrees[neighbor] - 1
                        if degrees[neighbor] < K and not in_worklist[neighbor]:
                            simplify_worklist.push(neighbor)
                            in_worklist[neighbor] = true
                    n_idx = n_idx + 1
        else:
            mut spill_candidate := 0 as u32
            mut max_degree := -1 as i32
            mut has_candidate := false

            mut iv_idx := 0 as i64
            while iv_idx < intervals.len:
                let vreg = intervals.data[iv_idx].vreg
                if not removed[vreg]:
                    if degrees[vreg] > max_degree:
                        max_degree = degrees[vreg]
                        spill_candidate = vreg
                        has_candidate = true
                iv_idx = iv_idx + 1

            if not has_candidate:
                break

            stack.push(spill_candidate)
            removed[spill_candidate] = true
            simplified_count = simplified_count + 1

            mut n_idx := 0 as i64
            while n_idx < adj[spill_candidate].len:
                let neighbor = adj[spill_candidate].data[n_idx]
                if not removed[neighbor]:
                    degrees[neighbor] = degrees[neighbor] - 1
                    if degrees[neighbor] < K and not in_worklist[neighbor]:
                        simplify_worklist.push(neighbor)
                        in_worklist[neighbor] = true
                n_idx = n_idx + 1


    let assigned_colors = @alloc(graph_size) as ptr[u8]
    @memset(assigned_colors, REG_NONE, graph_size)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)
    mut spill_count := 0 as i32

    mut st_idx := stack.len - 1
    while st_idx >= 0:
        let vreg = stack.data[st_idx]
        let forbidden = @alloc(256) as ptr[bool]
        @memset(forbidden as ptr[u8], 0 as u8, 256)

        let p_idx = param_idx_of_vreg[vreg as i64]
        if p_idx != -1 as i32:
            mut j := (p_idx + 1) as i64
            while j < 6 as i64:
                let r = abi_int_arg_reg(abi, j)
                if r != REG_NONE:
                    forbidden[r as i64] = true
                j = j + 1

        mut n_idx := 0 as i64
        while n_idx < adj[vreg].len:
            let neighbor = adj[vreg].data[n_idx]
            let color = assigned_colors[neighbor]
            if color != REG_NONE:
                forbidden[color] = true
            n_idx = n_idx + 1

        if spans_call[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_caller_saved(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if is_arg_vreg[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_parameter_reg(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if forbid_rax_rdx[vreg]:
            forbidden[REG_RAX as i64] = true
            forbidden[REG_RDX as i64] = true

        if forbid_rcx[vreg]:
            forbidden[REG_RCX as i64] = true

        mut colored := false
        // COALESCE BIAS: if this vreg's move partner is already colored with a legal
        // (non-forbidden, this-class) register, take it so the copy becomes a self-move.
        let mp = move_partner[vreg as i64]
        if mp != -1 as i32 and (mp as i64) < graph_size:
            let pcolor = assigned_colors[mp as i64]
            if pcolor != REG_NONE and not forbidden[pcolor as i64]:
                mut in_avail := false
                mut ai := 0 as i64
                while ai < avail_regs_len:
                    if avail_regs[ai] == pcolor:
                        in_avail = true
                        break
                    ai = ai + 1
                if in_avail:
                    assigned_colors[vreg] = pcolor
                    allocs[vreg] = RegAllocation(vreg: vreg, phys: pcolor, spilled: false, spill_idx: 0 as i32)
                    colored = true
        mut c_idx := 0 as i64
        while not colored and c_idx < avail_regs_len:
            let color = avail_regs[c_idx]
            if not forbidden[color]:
                assigned_colors[vreg] = color
                allocs[vreg] = RegAllocation(vreg: vreg, phys: color, spilled: false, spill_idx: 0 as i32)
                colored = true
                break
            c_idx = c_idx + 1

        @free(forbidden as ptr[u8])

        if regalloc_is_16byte_cached(vreg, fn_ptr, table, symbols, r16_def_idx, graph_size):
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 2
            assigned_colors[vreg] = REG_NONE
        elif address_taken[vreg]:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE
        elif not colored:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE

        st_idx = st_idx - 1

    @free(removed as ptr[u8])
    @free(degrees as ptr[u8])
    @free(assigned_colors)
    @free(spans_call as ptr[u8])
    @free(forbid_rax_rdx as ptr[u8])
    @free(forbid_rcx as ptr[u8])
    @free(is_arg_vreg as ptr[u8])
    @free(param_idx_of_vreg as ptr[u8])
    @free(address_taken as ptr[u8])
    @free(move_partner as ptr[u8])
    @free(r16_def_idx as ptr[u8])
    @free(in_worklist as ptr[u8])
    if simplify_worklist.data != null as ptr[u32]:
        @free(simplify_worklist.data as ptr[u8])
    if stack.data != null as ptr[u32]:
        @free(stack.data as ptr[u8])

    mut f_idx := 0 as i64
    while f_idx < graph_size:
        if adj[f_idx].data != null as ptr[u32]:
            @free(adj[f_idx].data as ptr[u8])
        f_idx = f_idx + 1
    @free(adj as ptr[u8])

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_count, pad0: 0 as i64)

pub fn get_used_callee_saved(abi: str, allocs: ptr[RegAllocation], max_vreg: u32, out_len: ptr[i64]) -> ptr[u8]:
    // Covers GPR phys 0-15 AND XMM phys 16-31. BUG#44: callee-saved XMM (win64
    // XMM6-15) used for float vregs must be saved/restored across calls just like
    // callee-saved GPRs. They are returned AFTER the GPRs so the prologue pushes
    // GPRs first then movsd-saves XMMs; both occupy 8 bytes per slot, so every
    // frame offset that keys off callee_saved_len (spills, str-lit, pushed_bytes)
    // stays correct with no other change.
    let used = @alloc(32) as ptr[bool]
    @memset(used as ptr[u8], 0 as u8, 32)

    // BUG#17: `max_vreg as i64` (u32->i64 zero-extend) is mis-compiled by the
    // native backend, leaving garbage in the upper 32 bits -> garbage-large
    // bound -> allocs[] OOB. Mask to a clean u32 so the loop stays in range.
    let mv_bound = (max_vreg as i64) & (4294967295 as i64)
    mut i := 0 as i64
    while i <= mv_bound:
        let phys = allocs[i].phys
        if phys != REG_NONE:
            if abi == "win64":
                if reg_is_win64_callee_saved(phys):
                    used[phys] = true
                if reg_is_xmm(phys) and phys >= REG_XMM6:
                    used[phys] = true
            else:
                if reg_is_sysv_callee_saved(phys):
                    used[phys] = true
        i = i + 1

    mut count := 0 as i64
    mut r := 0 as i64
    while r < 32:
        if used[r]:
            count = count + 1
        r = r + 1

    let result = @alloc(count) as ptr[u8]
    mut idx := 0 as i64
    r = 0
    while r < 32:
        if used[r]:
            result[idx] = r as u8
            idx = idx + 1
        r = r + 1

    @free(used as ptr[u8])
    out_len[0] = count
    return result

pub struct StackFrame:
    pub callee_saved: ptr[u8]
    pub callee_saved_len: i64
    pub spill_slots: i32
    pub local_bytes: i32
    pub align_padding: i32
    pub total_size: i32

pub fn compute_frame(callee_saved: ptr[u8], callee_saved_len: i64, spill_count: i32, local_bytes: i32, abi: str) -> StackFrame:
    mut needed := spill_count * 8 + local_bytes
    if abi == "win64":
        needed = needed + 32
    let pushed_bytes = (callee_saved_len + 2) * 8

    mut total := needed
    mut padding := 0 as i32
    if (pushed_bytes + total as i64) % 16 != 0:
        padding = (16 as i64 - (pushed_bytes + total as i64) % 16) as i32
        total = total + padding

    return StackFrame(
        callee_saved: callee_saved,
        callee_saved_len: callee_saved_len,
        spill_slots: spill_count,
        local_bytes: local_bytes,
        align_padding: padding,
        total_size: total
    )

pub fn emit_prologue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := 0 as i64
    while i < frame.callee_saved_len:
        let reg = frame.callee_saved[i]
        if reg_is_xmm(reg):
            // BUG#44: callee-saved XMM -> reserve a slot and movsd-save it. The
            // slot is at rbp-(i+1)*8 (contiguous below the GPR pushes), matching
            // what `sub rsp,8` just reserved; using rbp-relative movsd reuses the
            // working spill encoding (avoids the rsp-base SIB edge case).
            out_insts.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
            let xoff = 0 as i64 - (i + 1) * 8
            out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: xoff)))
        else:
            out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i + 1

    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub fn emit_epilogue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := frame.callee_saved_len - 1
    while i >= 0:
        let reg = frame.callee_saved[i]
        if reg_is_xmm(reg):
            // BUG#44: restore callee-saved XMM (movsd back) then release its slot.
            let xoff = 0 as i64 - (i + 1) * 8
            out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: xoff)))
            out_insts.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i - 1

    out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub const DST_UNUSED: u8 = 0
pub const DST_WRITE_ONLY: u8 = 1
pub const DST_READ_WRITE: u8 = 2
pub const DST_READ_ONLY: u8 = 3

pub fn get_dst_behavior(op: u16) -> u8:
    if op == MACH_MOV or op == MACH_MOV_IMM or op == MACH_XOR_ZERO or op == MACH_SETCC or op == MACH_MOVZX_B or op == MACH_POP or op == MACH_LOAD or op == MACH_LEA:
        return DST_WRITE_ONLY
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_NEG or op == MACH_NOT or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR:
        return DST_READ_WRITE
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE:
        return DST_READ_ONLY
    return DST_UNUSED

pub fn insert_spill_code(insts: ptr[MachInst], insts_len: i64, allocs: ptr[RegAllocation], frame: ptr[StackFrame], fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> MachInstVec:
    mut result := new_mach_inst_vec()

    // PERF: the per-spilled-operand 16-byte/float checks below linear-scan
    // fn_ptr.insts; on mega-functions (select_inst: ~13k spilled uses) that is
    // O(uses × insts). Build one def-index (sized to the max vreg actually
    // referenced by the mach insts) and query the cached forms. Freed before return.
    mut sp_maxv := 0 as u32
    mut sp_si := 0 as i64
    while sp_si < insts_len:
        let mi = &insts[sp_si]
        if mi.dst.kind == OPND_VREG and mi.dst.vreg > sp_maxv:
            sp_maxv = mi.dst.vreg
        if mi.src1.kind == OPND_VREG and mi.src1.vreg > sp_maxv:
            sp_maxv = mi.src1.vreg
        if mi.src2.kind == OPND_VREG and mi.src2.vreg > sp_maxv:
            sp_maxv = mi.src2.vreg
        sp_si = sp_si + 1
    let sp_def_size = (sp_maxv as i64) + 1 as i64
    let sp_def_idx = build_vreg_def_idx(fn_ptr, sp_def_size)

    // if insts_len > 300 as i64:
    //     ax_printf_local("[Debug] insert_spill_code for function sym_id=%d, len=%d:\n", fn_ptr.sym_id as i64, insts_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //     mut max_v := 0 as u32
    //     mut j := 0 as i64
    //     while j < insts_len:
    //         let inst = insts[j]
    //         ax_printf_local("  inst %d: op=%d, dst.kind=%d, dst.vreg=%d, src1.kind=%d, src1.vreg=%d\n", j, inst.op as i64, inst.dst.kind as i64, inst.dst.vreg as i64, inst.src1.kind as i64, inst.src1.vreg as i64, 0 as i64, 0 as i64)
    //         if inst.dst.kind == 1 as u8 and inst.dst.vreg > max_v:
    //             max_v = inst.dst.vreg
    //         if inst.src1.kind == 1 as u8 and inst.src1.vreg > max_v:
    //             max_v = inst.src1.vreg
    //         if inst.src2.kind == 1 as u8 and inst.src2.vreg > max_v:
    //             max_v = inst.src2.vreg
    //         j = j + 1
    // 
    //     mut k := 0 as i32
    //     while k <= max_v as i32:
    //         let alloc = allocs[k]
    //         if alloc.spilled:
    //             let is_16 = regalloc_is_16byte(k as u32, fn_ptr, table, symbols)
    //             ax_printf_local("  vreg %d: spilled=true, spill_idx=%d, is_16=%d\n", k as i64, alloc.spill_idx as i64, is_16 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //         k = k + 1

    mut i := 0 as i64
    while i < insts_len:
        mut inst := insts[i]

        if inst.src1.kind == OPND_VREG:
            let v = inst.src1.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16 = regalloc_is_16byte_cached(v, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
                mut add_mult := 1 as i64
                if is_16:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if inst.op == MACH_LEA and inst.src2.kind == OPND_IMM:
                    // GET_FIELD on a pointer / by-ref struct base (the only LEA whose
                    // src2 is an IMM disp): the spilled vreg's SLOT holds a pointer
                    // VALUE (a heap address), not inline data. We want value(src1)+disp,
                    // so LOAD the pointer from the slot into a scratch register and keep
                    // the field disp. Rewriting to RBP+slot+disp (the home-address path
                    // below) would point at this frame's stack slot instead of the heap
                    // object — silently losing through-pointer field mutation.
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif inst.op == MACH_LEA:
                    // LEA of a spilled vreg with no disp means "address of the value"
                    // (&self / MAKE_REF / 16-byte value address): rewrite to RBP + slot
                    // offset. Loading the value and taking lea (reg) would yield the
                    // value itself, not its address.
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                    inst.src2 = MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)
                elif is_16:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg_cached(fn_ptr, v, table, symbols, sp_def_idx, sp_def_size):
                    // RFC 0006: a spilled FLOAT operand must be reloaded into an
                    // XMM scratch via movsd (MACH_LOAD with xmm dst). Reloading
                    // into a GP scratch (R10) would leave the value in the wrong
                    // register file — float encoders (addsd/cvttsd2si/…) encode
                    // the operand as XMM, and R10's hw-index aliases XMM10, so the
                    // CPU would read garbage. XMM0/XMM1 are scratch (not in the
                    // allocatable XMM8-15 set).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        if inst.src2.kind == OPND_VREG:
            let v = inst.src2.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16_s2 = regalloc_is_16byte_cached(v, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
                mut add_mult := 1 as i64
                if is_16_s2:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if is_16_s2:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg_cached(fn_ptr, v, table, symbols, sp_def_idx, sp_def_size):
                    // RFC 0006: spilled FLOAT src2 → XMM1 scratch via movsd (see src1).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        mut dst_spilled := false
        mut dst_alloc = RegAllocation(vreg: 0 as u32, phys: 0 as u8, spilled: false, spill_idx: 0 as i32)
        if inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                dst_spilled = true
                dst_alloc = alloc

        if dst_spilled:
            let behavior = get_dst_behavior(inst.op)
            let is_16_dst = regalloc_is_16byte_cached(dst_alloc.vreg, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
            mut add_mult := 1 as i64
            if is_16_dst:
                add_mult = 2 as i64
            let offset = -((frame.callee_saved_len + add_mult + dst_alloc.spill_idx as i64) * 8)

            if behavior == DST_READ_ONLY:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
            elif behavior == DST_READ_WRITE:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            elif behavior == DST_WRITE_ONLY:
                inst.dst = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            else:
                result.push(inst)
        else:
            result.push(inst)

        i = i + 1
    @free(sp_def_idx as ptr[u8])
    return result

pub fn is_float_vreg(fn_ptr: ptr[AirFunc], vreg: u32, table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> bool:
    if vreg == 0 as u32:
        return false
    // A float-typed PARAMETER is passed in an XMM arg register; its type lives
    // in fn_ptr.params, not in a defining instruction.
    if vreg >= 1 as u32 and vreg <= fn_ptr.params.len as u32:
        let pt = fn_ptr.params.data[vreg as i64 - 1 as i64] as u32
        return pt == 9 as u32 or pt == 10 as u32
    mut i := 0 as i64
    while i < fn_ptr.insts.len:
        let inst = &fn_ptr.insts.data[i]
        if inst.dest == vreg:
            // BUG#48: OP_CALL overloads type_id — for a DIRECT call (src1==0) it
            // holds the callee SYMBOL INDEX, not the result type. Resolve the
            // callee's return type instead. Without this, a float-returning
            // call's result vreg is classified as integer, allocated a GPR, and
            // every addsd/mulsd that consumes it encodes the operand by
            // hardware index into the WRONG register file (e.g. rsi index 6 ->
            // xmm6) → silent garbage. Mirrors get_register_type / regalloc_is_16byte.
            if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
                let sym_idx = inst.type_id as u32
                if symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < symbols.symbols.len:
                    let sym = &symbols.symbols.data[sym_idx as i64]
                    if sym.kind == SYM_FUNC:
                        let fn_type_id = sym.type_id as u32
                        if fn_type_id != 0 as u32 and (fn_type_id as i64) < table.entries.len:
                            let entry = &table.entries.data[fn_type_id as i64]
                            if entry.kind == TYPE_KIND_FUNC:
                                let fi = &table.funcs.data[entry.extra as i64]
                                let rt = fi.ret
                                return rt == 9 as u32 or rt == 10 as u32
                return false
            let t_id = inst.type_id
            return t_id == 9 as u32 or t_id == 10 as u32
        i = i + 1
    return false

// PERF: is_float_vreg / regalloc_is_16byte each LINEAR-scan fn_ptr.insts for the
// defining instruction of a vreg. Called once per interval in the orchestrator
// split loop and once per spilled operand-use in insert_spill_code, that is
// O(vregs × insts) — quadratic on mega-functions (select_inst: ~2s of codegen).
// This builds, in one O(insts) pass, def_idx[vreg] = the index of the FIRST inst
// whose dest == vreg (matching is_float_vreg's first-match semantics), or -1.
// The cached wrappers then reuse the EXACT same per-inst classification logic via
// an O(1) lookup — no logic duplication, so classification is byte-identical.
pub fn build_vreg_def_idx(fn_ptr: ptr[AirFunc], size: i64) -> ptr[i32]:
    let arr = @alloc(size * 4) as ptr[i32]
    mut k := 0 as i64
    while k < size:
        arr[k] = -1 as i32
        k = k + 1
    mut i := 0 as i64
    while i < fn_ptr.insts.len:
        let d = fn_ptr.insts.data[i].dest as i64
        if d >= 0 as i64 and d < size and arr[d] == -1 as i32:
            arr[d] = i as i32
        i = i + 1
    return arr

// Cached form of is_float_vreg. `def_idx` must be sized `def_size` (>= vreg+1 for
// any vreg queried); a vreg beyond it (e.g. a selection scratch above max AIR
// dest) is never an AIR dest → not float, same as the linear-scan fallthrough.
pub fn is_float_vreg_cached(fn_ptr: ptr[AirFunc], vreg: u32, table: ptr[TypeTable], symbols: ptr[SymbolTable], def_idx: ptr[i32], def_size: i64) -> bool:
    if vreg == 0 as u32:
        return false
    if vreg >= 1 as u32 and vreg <= fn_ptr.params.len as u32:
        let pt = fn_ptr.params.data[vreg as i64 - 1 as i64] as u32
        return pt == 9 as u32 or pt == 10 as u32
    if (vreg as i64) >= def_size:
        return false
    let di = def_idx[vreg as i64]
    if di < 0 as i32:
        return false
    let inst = &fn_ptr.insts.data[di as i64]
    if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
        let sym_idx = inst.type_id as u32
        if symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < symbols.symbols.len:
            let sym = &symbols.symbols.data[sym_idx as i64]
            if sym.kind == SYM_FUNC:
                let fn_type_id = sym.type_id as u32
                if fn_type_id != 0 as u32 and (fn_type_id as i64) < table.entries.len:
                    let entry = &table.entries.data[fn_type_id as i64]
                    if entry.kind == TYPE_KIND_FUNC:
                        let fi = &table.funcs.data[entry.extra as i64]
                        let rt = fi.ret
                        return rt == 9 as u32 or rt == 10 as u32
        return false
    let t_id = inst.type_id
    return t_id == 9 as u32 or t_id == 10 as u32

pub fn get_allocatable_xmms(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(8) as ptr[u8]
    arr[0] = REG_XMM8
    arr[1] = REG_XMM9
    arr[2] = REG_XMM10
    arr[3] = REG_XMM11
    arr[4] = REG_XMM12
    arr[5] = REG_XMM13
    arr[6] = REG_XMM14
    arr[7] = REG_XMM15
    out_len[0] = 8
    return arr

pub fn allocate_registers_orchestrator(intervals: LiveIntervalVec, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    mut gpr_intervals := new_live_interval_vec()
    mut xmm_intervals := new_live_interval_vec()

    // PERF: memoize the float/GPR classification. Formerly is_float_vreg (a linear
    // scan of fn_ptr.insts) per interval → O(intervals × insts), ~2s on select_inst.
    let def_idx = build_vreg_def_idx(fn_ptr, graph_size)
    mut i := 0 as i64
    while i < intervals.len:
        let iv = intervals.data[i]
        if is_float_vreg_cached(fn_ptr, iv.vreg, table, symbols, def_idx, graph_size):
            xmm_intervals.push(iv)
        else:
            gpr_intervals.push(iv)
        i = i + 1
    @free(def_idx as ptr[u8])

    mut gpr_len := 0 as i64
    let avail_gprs = get_allocatable_gprs(&gpr_len)

    mut xmm_len := 0 as i64
    let avail_xmms = get_allocatable_xmms(&xmm_len)

    let gpr_alloc = graph_coloring_alloc(gpr_intervals, avail_gprs, gpr_len, insts, insts_len, abi, fn_ptr, table, symbols)
    let xmm_alloc = graph_coloring_alloc(xmm_intervals, avail_xmms, xmm_len, insts, insts_len, abi, fn_ptr, table, symbols)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)

    mut v := 0 as i64
    while v < graph_size:
        allocs[v] = RegAllocation(vreg: v as u32, phys: REG_NONE, spilled: false, spill_idx: 0 as i32)
        v = v + 1

    if gpr_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: `gpr_alloc.max_vreg as i64` is mis-compiled by the native
        // backend (u32 struct-field zero-extend reads the adjacent spill_count
        // into the upper 32 bits -> garbage-large bound -> allocs[] OOB scan ->
        // segfault). gpr_alloc.allocs is sized graph_size (== max_vreg+1, same
        // insts) with indices 0..graph_size-1 all initialized, so bound by the
        // clean local graph_size instead of the corrupt field read.
        mut idx := 0 as i64
        while idx < graph_size:
            let al = gpr_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                allocs[al.vreg] = al
            idx = idx + 1
        @free(gpr_alloc.allocs as ptr[u8])

    if xmm_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: same garbage-bound issue as the gpr loop above; bound by the
        // clean local graph_size (xmm_alloc.allocs is also sized graph_size).
        mut idx := 0 as i64
        while idx < graph_size:
            mut al := xmm_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                if al.spilled:
                    al.spill_idx = al.spill_idx + gpr_alloc.spill_count
                allocs[al.vreg] = al
            idx = idx + 1
        @free(xmm_alloc.allocs as ptr[u8])

    let spill_total = gpr_alloc.spill_count + xmm_alloc.spill_count

    if gpr_intervals.data != null as ptr[LiveInterval]:
        @free(gpr_intervals.data as ptr[u8])
    if xmm_intervals.data != null as ptr[LiveInterval]:
        @free(xmm_intervals.data as ptr[u8])
    @free(avail_gprs)
    @free(avail_xmms)

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_total, pad0: 0 as i64)
