// bootstrap/stage1/x86_coff.ax
// PE/COFF Object File Writer for x86-64 Windows targets in self-hosted AXIOM.

import std.string

pub const IMAGE_REL_AMD64_ADDR64: u16 = 1
pub const IMAGE_REL_AMD64_REL32:  u16 = 4

pub const IMAGE_SYM_CLASS_EXTERNAL: u8 = 2
pub const IMAGE_SYM_CLASS_STATIC:   u8 = 3

pub struct COFFReloc:
    pub virt_addr: u32
    pub sym_table_idx: u32
    pub reloc_type: u16

pub struct COFFRelocVec:
    pub data: ptr[COFFReloc]
    pub len: i64
    pub cap: i64

pub fn new_coff_reloc_vec() -> COFFRelocVec:
    return COFFRelocVec(data: null as ptr[COFFReloc], len: 0, cap: 0)

pub fn push_coff_reloc(mut self: ptr[COFFRelocVec], r: COFFReloc):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[COFFReloc]
        if self.data != null as ptr[COFFReloc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = r
    self.len = self.len + 1

pub struct COFFSymbol:
    pub name_str: str
    pub value: u32
    pub section_num: i16
    pub sym_type: u16
    pub storage_class: u8
    pub num_aux: u8

pub struct COFFSymbolVec:
    pub data: ptr[COFFSymbol]
    pub len: i64
    pub cap: i64

pub fn new_coff_symbol_vec() -> COFFSymbolVec:
    return COFFSymbolVec(data: null as ptr[COFFSymbol], len: 0, cap: 0)

pub fn push_coff_symbol(mut self: ptr[COFFSymbolVec], s: COFFSymbol) -> i32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 32) as ptr[COFFSymbol]
        if self.data != null as ptr[COFFSymbol]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 32)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as i32
    self.data[self.len] = s
    self.len = self.len + 1
    return idx

extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fwrite(buffer: ptr[void], size: i64, count: i64, stream: ptr[void]) -> i64
extern "C" fn fclose(stream: ptr[void]) -> i32

pub fn coff_serialize(code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[COFFRelocVec], symbols: ptr[COFFSymbolVec], out_bytes: ptr[ByteVec]):
    // 1. Build string table
    mut strtab := new_byte_vec()
    push_u32_le(&strtab, 4 as u32) // length placeholder
    
    let string_offsets = @alloc(symbols.len * 4) as ptr[u32]
    mut si := 0 as i64
    while si < symbols.len:
        let name = symbols.data[si].name_str
        let name_len = std.string.len(name)
        if name_len > 8:
            string_offsets[si] = strtab.len as u32
            push_bytes(&strtab, name as ptr[u8], name_len)
            push_byte(&strtab, 0 as u8)
        else:
            string_offsets[si] = 0 as u32
        si = si + 1
        
    // Patch string table length
    if strtab.len > 4 as i64:
        let total_len = strtab.len as u32
        strtab.data[0] = (total_len & 0xFF as u32) as u8
        strtab.data[1] = ((total_len >> 8 as u32) & 0xFF as u32) as u8
        strtab.data[2] = ((total_len >> 16 as u32) & 0xFF as u32) as u8
        strtab.data[3] = ((total_len >> 24 as u32) & 0xFF as u32) as u8
        
    // 2. Lay out COFF components
    let text_size = code.len
    let rdata_size = rdata.len
    // RFC 0017 / BUG#82: an optional writable .data section (section 3) holds module-level
    // globals. Emitted ONLY when non-empty, so a program with no globals produces a
    // byte-identical 2-section object (fixpoint-preserving).
    let data_size = data.len
    let has_data = data_size > 0 as i64
    // RFC 0030 P3: an optional .bss (section 4) reserving zero-initialized global storage.
    // It occupies NO file bytes — SizeOfRawData 0, PointerToRawData 0 — and declares its
    // extent through VirtualSize, which the image loader zero-fills. Emitted only when the
    // emitter routed globals into it, so objects without one stay byte-identical.
    let has_bss = bss_size > 0 as i64
    mut num_sections := 2 as i64
    if has_data:
        num_sections = 3 as i64
    if has_bss:
        num_sections = num_sections + 1 as i64
    let text_raw_ptr = 20 as i64 + num_sections * 40 as i64 // FileHeader(20) + N*SectionHeader(40)
    let rdata_raw_ptr = text_raw_ptr + text_size
    let data_raw_ptr = rdata_raw_ptr + rdata_size
    let relocs_offset = data_raw_ptr + data_size
    let symbol_table_offset = relocs_offset + relocs.len * 10 as i64

    // 3. Write COFF File Header (20 bytes)
    push_u16_le(out_bytes, 0x8664 as u16) // AMD64
    push_u16_le(out_bytes, num_sections as u16) // .text, .rdata [, .data]
    push_u32_le(out_bytes, 0 as u32)      // TimeDateStamp
    push_u32_le(out_bytes, symbol_table_offset as u32)
    push_u32_le(out_bytes, symbols.len as u32)
    push_u16_le(out_bytes, 0 as u16)      // SizeOfOptionalHeader = 0
    push_u16_le(out_bytes, 0 as u16)      // Characteristics = 0
    
    // 4. Write Section Header 1 (.text) (40 bytes)
    push_byte(out_bytes, '.' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 'e' as u8)
    push_byte(out_bytes, 'x' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_u32_le(out_bytes, 0 as u32) // VirtualSize
    push_u32_le(out_bytes, 0 as u32) // VirtualAddress
    push_u32_le(out_bytes, text_size as u32)
    push_u32_le(out_bytes, text_raw_ptr as u32)
    push_u32_le(out_bytes, relocs_offset as u32)
    push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
    push_u16_le(out_bytes, relocs.len as u16)
    push_u16_le(out_bytes, 0 as u16) // NumLineNums
    // CODE | EXECUTE | READ (0x60000020)
    push_u32_le(out_bytes, 0x00000020 as u32 | 0x20000000 as u32 | 0x40000000 as u32)
    
    // 4. Write Section Header 2 (.rdata) (40 bytes)
    push_byte(out_bytes, '.' as u8)
    push_byte(out_bytes, 'r' as u8)
    push_byte(out_bytes, 'd' as u8)
    push_byte(out_bytes, 'a' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 'a' as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_u32_le(out_bytes, 0 as u32) // VirtualSize
    push_u32_le(out_bytes, 0 as u32) // VirtualAddress
    push_u32_le(out_bytes, rdata_size as u32)
    push_u32_le(out_bytes, rdata_raw_ptr as u32)
    push_u32_le(out_bytes, 0 as u32) // RelocsPtr
    push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
    push_u16_le(out_bytes, 0 as u16) // NumRelocs
    push_u16_le(out_bytes, 0 as u16) // NumLineNums
    // INITIALIZED_DATA | READ (0x40000040)
    push_u32_le(out_bytes, 0x00000040 as u32 | 0x40000000 as u32)

    // 4c. Write Section Header 3 (.data) — RFC 0017: writable global storage (only when
    // globals exist). INITIALIZED_DATA | READ | WRITE (0xC0000040).
    if has_data:
        push_byte(out_bytes, '.' as u8)
        push_byte(out_bytes, 'd' as u8)
        push_byte(out_bytes, 'a' as u8)
        push_byte(out_bytes, 't' as u8)
        push_byte(out_bytes, 'a' as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_u32_le(out_bytes, 0 as u32) // VirtualSize
        push_u32_le(out_bytes, 0 as u32) // VirtualAddress
        push_u32_le(out_bytes, data_size as u32)
        push_u32_le(out_bytes, data_raw_ptr as u32)
        push_u32_le(out_bytes, 0 as u32) // RelocsPtr
        push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
        push_u16_le(out_bytes, 0 as u16) // NumRelocs
        push_u16_le(out_bytes, 0 as u16) // NumLineNums
        push_u32_le(out_bytes, 0x00000040 as u32 | 0x40000000 as u32 | 0x80000000 as u32) // INIT_DATA|READ|WRITE

    // 4d. Write Section Header 4 (.bss) — RFC 0030: zero-initialized global storage.
    // SizeOfRawData and PointerToRawData are 0 (no file bytes); VirtualSize carries the
    // extent. UNINITIALIZED_DATA | READ | WRITE (0xC0000080).
    if has_bss:
        push_byte(out_bytes, '.' as u8)
        push_byte(out_bytes, 'b' as u8)
        push_byte(out_bytes, 's' as u8)
        push_byte(out_bytes, 's' as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_u32_le(out_bytes, bss_size as u32) // VirtualSize = the reserved extent
        push_u32_le(out_bytes, 0 as u32) // VirtualAddress
        push_u32_le(out_bytes, 0 as u32) // SizeOfRawData = 0 (occupies no file bytes)
        push_u32_le(out_bytes, 0 as u32) // PointerToRawData = 0
        push_u32_le(out_bytes, 0 as u32) // RelocsPtr
        push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
        push_u16_le(out_bytes, 0 as u16) // NumRelocs
        push_u16_le(out_bytes, 0 as u16) // NumLineNums
        push_u32_le(out_bytes, 0x00000080 as u32 | 0x40000000 as u32 | 0x80000000 as u32) // UNINIT_DATA|READ|WRITE

    // 5. Write raw section data
    push_bytes(out_bytes, code.data, text_size)
    push_bytes(out_bytes, rdata.data, rdata_size)
    if has_data:
        push_bytes(out_bytes, data.data, data_size)

    
    // 6. Write Relocation Table
    mut ri := 0 as i64
    while ri < relocs.len:
        let r = relocs.data[ri]
        push_u32_le(out_bytes, r.virt_addr)
        push_u32_le(out_bytes, r.sym_table_idx)
        push_u16_le(out_bytes, r.reloc_type)
        ri = ri + 1
        
    // 7. Write Symbol Table
    si = 0
    while si < symbols.len:
        let sym = &symbols.data[si]
        let name_len = std.string.len(sym.name_str)
        if name_len <= 8:
            let name_ptr = sym.name_str as ptr[u8]
            let pad8 = @alloc(8) as ptr[u8]
            @memset(pad8 as ptr[void], 0 as u8, 8)
            @memcpy(pad8, name_ptr, name_len)
            push_bytes(out_bytes, pad8, 8)
            @free(pad8)
        else:
            let offset = string_offsets[si]
            push_u32_le(out_bytes, 0 as u32)
            push_u32_le(out_bytes, offset)
            
        push_u32_le(out_bytes, sym.value)
        push_u16_le(out_bytes, sym.section_num as u16)
        push_u16_le(out_bytes, sym.sym_type)
        push_byte(out_bytes, sym.storage_class)
        push_byte(out_bytes, sym.num_aux)
        si = si + 1
        
    // 8. Write String Table
    push_bytes(out_bytes, strtab.data, strtab.len)
    
    // Free resources
    @free(string_offsets as ptr[u8])
    if strtab.data != null as ptr[u8]:
        @free(strtab.data)

pub fn coff_write_object_file(filename: str, code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[COFFRelocVec], symbols: ptr[COFFSymbolVec]) -> bool:
    mut out_bytes := new_byte_vec()
    coff_serialize(code, rdata, data, bss_size, relocs, symbols, &out_bytes)
    
    let filename_nt = x86_str_to_null_terminated(filename)
    let file = fopen(filename_nt as ptr[void], get_str_ptr("wb"))
    @free(filename_nt)
    if file == null as ptr[void]:
        if out_bytes.data != null as ptr[u8]:
            @free(out_bytes.data)
        return false
        
    fwrite(out_bytes.data as ptr[void], 1, out_bytes.len, file)
    fclose(file)
    
    if out_bytes.data != null as ptr[u8]:
        @free(out_bytes.data)
    return true

pub struct CompiledFuncInfo:
    pub name: str
    pub offset: u32
    pub size: u32
    pub is_global: bool
    pub relocs: RelocationVec

pub struct CompiledFuncInfoVec:
    pub data: ptr[CompiledFuncInfo]
    pub len: i64
    pub cap: i64

pub fn new_compiled_func_info_vec() -> CompiledFuncInfoVec:
    return CompiledFuncInfoVec(data: null as ptr[CompiledFuncInfo], len: 0, cap: 0)

pub fn push_compiled_func_info(mut self: ptr[CompiledFuncInfoVec], info: CompiledFuncInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 56) as ptr[CompiledFuncInfo]
        if self.data != null as ptr[CompiledFuncInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 56)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = info
    self.len = self.len + 1

pub fn resolve_binary_sym_name(sym_idx: i64, current_fn_name: str, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable]) -> str:
    if sym_idx == -30 as i64:
        return "ax_str_slice"
    let base: i64 = 3758096384
    if sym_idx >= base:
        let str_id = sym_idx - base
        let sym_name_buf = @alloc(64) as ptr[u8]
        let prefix = "Linfo.string." as ptr[u8]
        mut idx := 0 as i64
        while idx < 13:
            sym_name_buf[idx] = prefix[idx]
            idx = idx + 1
        mut val := str_id as i64
        if val == 0 as i64:
            sym_name_buf[idx] = '0' as u8
            idx = idx + 1
        else:
            mut temp_buf := @alloc(32) as ptr[u8]
            mut temp_len := 0
            while val > 0 as i64:
                temp_buf[temp_len] = ('0' as u8 + (val % 10 as i64) as u8)
                temp_len = temp_len + 1
                val = val / 10 as i64
            mut k := 0
            while k < temp_len:
                sym_name_buf[idx] = temp_buf[temp_len - 1 - k]
                idx = idx + 1
                k = k + 1
            @free(temp_buf)
        sym_name_buf[idx] = 0 as u8
        let res = alloc_str_from_raw(sym_name_buf, strlen(sym_name_buf))
        @free(sym_name_buf)
        return res
    if sym_idx == -1 as i64:
        return "ax_alloc"

    if sym_idx == -2 as i64:
        return "ax_free"
    if sym_idx == -3 as i64:
        return "ax_actor_spawn"
    if sym_idx == -4 as i64:
        return "ax___ax_runtime_init"
    if sym_idx == -5 as i64:
        return "ax___ax_runtime_shutdown"
    if sym_idx == -8 as i64:
        return "abort"
    if sym_idx == -20 as i64:
        return "ExitProcess"
    if sym_idx == -21 as i64:
        return "strlen"
    if sym_idx == -22 as i64:
        return "ax_str_eq"
    if sym_idx == -10 as i64:
        return "ax_println_str"
    if sym_idx == -11 as i64:
        return "ax_println_i64"
    if sym_idx == -12 as i64:
        return "ax_println_f64"
    if sym_idx == -13 as i64:
        return "ax_println_bool"
    if sym_idx == -14 as i64:
        return "ax_print_str"
    if sym_idx == -15 as i64:
        return "ax_print_i64"
    if sym_idx == -16 as i64:
        return "ax_print_f64"
    if sym_idx == -17 as i64:
        return "ax_print_bool"
    if sym_idx <= 0 as i64:
        return current_fn_name
    let name = x86_resolve_sym_name(sym_idx as u32, symbols, pool, table)
    if name == "alloc":
        return "ax_alloc"
    if name == "free":
        return "ax_free"
    if name == "std.string.len" or name == "ax_std.string.len":
        return "ax_str_len"
    // std.string.{concat,replace,slice} are NOT redirected to the C-runtime DLL
    // symbols: those use the C/Win64 ABI (str args by-ref, 16-byte struct return
    // via a hidden sret pointer) which is incompatible with AXIOM's value ABI
    // (str args by pointer, result in RAX:RDX). Each falls through to its
    // value-ABI in-program body in std/string.ax.
    //
    // BUG#29 (self-host fixpoint blocker): the str-RETURNING redirects (replace,
    // slice) were miscompiled by the stage1-built backend. The exact class is the
    // hidden-sret return-pointer setup of a C-ABI call that returns a 16-byte str:
    // stage1's native backend miscompiles the emitter for that sret setup, so
    // stage2 emitted ax_str_replace / ax_str_slice calls with a corrupt sret/ptr
    // -> OOM (bad len) / segfault (bad ptr) when stage3 ran. (len->i64 and
    // eq->bool have NO sret and stayed correct, which is why stage2 itself ran;
    // only the calls stage2 EMITTED into stage3 were broken.) concat was already
    // value-ABI for the same reason. Fix: do not redirect replace or slice; use
    // the value-ABI in-program functions. NB: the `-30` path in
    // resolve_binary_sym_name and the ax_block_size alias below still reference
    // ax_str_slice — those are separate machinery, not the std.string.slice call.
    return name




// RFC 0031 (dead function elimination) — REPORT-ONLY reachability over the AIR call graph.
// Follows the `-ctgc-free-report` precedent (RFC 0015 P3): measure the set first, emit
// nothing differently, and only activate once the numbers are understood. Output is
// byte-identical with the flag on.
//
// Edges, per the AIR encoding:
//   * direct call    — OP_CALL with src1 == 0 carries the callee symbol in type_id
//   * indirect edge  — OP_FUNC_ADDR carries the target symbol in src1
// An OP_CALL with src1 != 0 is a call THROUGH a register; its target was necessarily
// materialised by some OP_FUNC_ADDR, which is why taking every funcaddr as a root-ish edge
// is what keeps fn pointers, lambdas and RFC 0029 vtables alive.
//
// NOT visible here, and the reason activation needs more than this pass: OP_FREE/OP_DESTROY
// lower to a MACH_CALL with the magic callee index -2 rather than a symbol, so `ax_free` has
// no edge at all. The linker's runtime-ABI allow-list (linker.ax ~L635) is the other root
// source. Both must be seeded before anything is actually pruned.
fn dfe_report(mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable]):
    let nsym = symbols.symbols.len
    if nsym <= 0 as i64:
        return
    let reach = @alloc(nsym) as ptr[bool]
    @memset(reach as ptr[void], 0 as u8, nsym)

    // Seed the roots. Three kinds. Only the first is discovered by walking the
    // call graph; the other two are precisely the functions the graph CANNOT see,
    // which is why getting them wrong is a miscompile rather than a size loss.
    //
    //   1. the entry point — everything an executable needs hangs off it;
    //
    //   2. every #[export]-ed function (RFC 0009 P2, symbols.export_syms). For a
    //      --shared / --staticlib build the exports ARE the roots: nothing calls
    //      them from inside the module, so a walk from main alone prunes the whole
    //      public surface of the library. Matched on the intern name-id AND on the
    //      resolved name, because export_syms stores plain name-ids while the
    //      emitted symbol may be mangled — comparing only one of the two silently
    //      matches nothing, which is how this root first shipped reporting zero;
    //
    //   3. bundled functions whose name collides with a runtime ABI symbol
    //      (std/runtime.ax defines ax_str_len, ax_str_concat, ax_panic, ...).
    //      These are reached by NAME, not by a call edge: x86_resolve_callee_name
    //      rewrites AXIOM `free` to "ax_free" and `std.string.len` to "ax_str_len",
    //      and the magic negative callee indices (-1, -2, -10..-22) resolve to the
    //      same names. The linker then binds by name. A bundled definition
    //      answering to one of those names therefore has callers that leave no
    //      trace whatsoever in the AIR graph.
    //
    // (3) was found by measurement, not by reading: this pass shipped with an
    // audit counter asserting no bundled function shadows an ABI name, and the
    // first run reported ten of them. The allow-list is READ from linker.ax rather
    // than restated here so the two cannot drift apart.
    mut total_funcs := 0 as i64
    mut root_exports := 0 as i64
    mut root_abi := 0 as i64
    mut fi := 0 as i64
    while fi < mod.funcs.len:
        let f = &mod.funcs.data[fi]
        if not f.is_extern:
            total_funcs = total_funcs + 1 as i64
            let nm = x86_resolve_sym_name(f.sym_id, symbols, pool, table)
            mut is_root := (nm == "main" or nm == "_AX_main_main_v_v")
            if not is_root:
                mut ek := 0 as i64
                while ek < symbols.export_syms.len:
                    let eid = symbols.export_syms.data[ek]
                    if eid == f.name or pool.get(eid) == nm:
                        is_root = true
                        root_exports = root_exports + 1 as i64
                        ek = symbols.export_syms.len
                    else:
                        ek = ek + 1
            if not is_root and is_valid_runtime_dll_symbol(nm):
                is_root = true
                root_abi = root_abi + 1 as i64
            if is_root:
                if (f.sym_id as i64) < nsym:
                    reach[f.sym_id as i64] = true
        fi = fi + 1

    // Fixpoint: re-scan until a full pass adds nothing.
    mut changed := true
    while changed:
        changed = false
        mut gi := 0 as i64
        while gi < mod.funcs.len:
            let g = &mod.funcs.data[gi]
            if not g.is_extern and (g.sym_id as i64) < nsym and reach[g.sym_id as i64]:
                mut ii := 0 as i64
                while ii < g.insts.len:
                    let inst = g.insts.data[ii]
                    mut tgt := 0 as u32
                    if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
                        tgt = inst.type_id
                    elif inst.opcode == OP_FUNC_ADDR:
                        tgt = inst.src1
                    if tgt != 0 as u32 and (tgt as i64) < nsym:
                        if not reach[tgt as i64]:
                            reach[tgt as i64] = true
                            changed = true
                    ii = ii + 1
            gi = gi + 1

    mut reach_funcs := 0 as i64
    mut hi := 0 as i64
    while hi < mod.funcs.len:
        let h = &mod.funcs.data[hi]
        if not h.is_extern and (h.sym_id as i64) < nsym and reach[h.sym_id as i64]:
            reach_funcs = reach_funcs + 1 as i64
        hi = hi + 1

    ax_printf_local("[dfe] reachable %d / %d functions (roots: entry + %d export + %d abi)\n",
        reach_funcs, total_funcs, root_exports, root_abi, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    @free(reach as ptr[u8])

pub fn compile_native_binary(output_obj_file: str, mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], format_ptr: ptr[u8], self_link: bool, dfe_rep: bool) -> bool:
    let is_elf64 = (format_ptr[0] == 'e' as u8)
    mut abi := "win64"
    if is_elf64:
        abi = "sysv"
        
    mut all_code := new_byte_vec()
    mut func_infos := new_compiled_func_info_vec()
    
    mut coff_syms := new_coff_symbol_vec()
    mut elf_syms := new_elf64_sym_vec()

    mut rdata_buf := new_byte_vec()
    mut str_keys := new_u32_vec()
    mut str_offsets := new_u32_vec()

    // O(1) dedup via boolean seen-array indexed by intern-pool ID.
    // Replaces the O(n) linear search that made the scan O(n^2) overall.
    let str_seen_size = pool.state.count + 2 as i64
    let str_seen = @alloc(str_seen_size) as ptr[bool]
    @memset(str_seen as ptr[void], 0 as u8, str_seen_size)

    // Scan for all string literals across all functions
    mut scan_fi := 0 as i64
    while scan_fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[scan_fi]
        if not fn_ptr.is_extern:
            mut inst_i := 0 as i64
            while inst_i < fn_ptr.insts.len:
                let inst = &fn_ptr.insts.data[inst_i]
                let t_id = inst.type_id as u32
                mut is_str := (t_id == 12 as u32)
                if t_id < table.entries.len as u32:
                    if table.entries.data[t_id].size == 16 as u32:
                        is_str = true
                if inst.opcode == OP_ICONST and is_str:
                    let str_id = inst.src1
                    let str_id_i = str_id as i64
                    mut found := true
                    if str_id_i < str_seen_size:
                        if not str_seen[str_id_i]:
                            str_seen[str_id_i] = true
                            found = false
                    if not found:
                        let offset = rdata_buf.len as u32
                        str_keys.push(str_id)
                        str_offsets.push(offset)
                        let raw_text = pool.get(str_id)
                        let text = unescape_string_literal(raw_text)
                        let len = std.string.len(text)
                        push_bytes(&rdata_buf, text as ptr[u8], len)
                        push_byte(&rdata_buf, 0 as u8)
                        @free(text as ptr[u8])
                inst_i = inst_i + 1
        scan_fi = scan_fi + 1
    @free(str_seen as ptr[u8])

    // Register all unique string symbols in COFF / ELF symbol table
    mut str_i := 0 as i64
    while str_i < str_keys.len:
        let str_id = str_keys.data[str_i]
        let offset = str_offsets.data[str_i]
        let sym_name_buf = @alloc(64) as ptr[u8]
        let prefix = "Linfo.string." as ptr[u8]
        mut idx := 0 as i64
        while idx < 13:
            sym_name_buf[idx] = prefix[idx]
            idx = idx + 1
        mut val := str_id as i64
        if val == 0 as i64:
            sym_name_buf[idx] = '0' as u8
            idx = idx + 1
        else:
            mut temp_buf := @alloc(32) as ptr[u8]
            mut temp_len := 0
            while val > 0 as i64:
                temp_buf[temp_len] = ('0' as u8 + (val % 10 as i64) as u8)
                temp_len = temp_len + 1
                val = val / 10 as i64
            mut k := 0
            while k < temp_len:
                sym_name_buf[idx] = temp_buf[temp_len - 1 - k]
                idx = idx + 1
                k = k + 1
            @free(temp_buf)
        sym_name_buf[idx] = 0 as u8
        let temp_str = alloc_str_from_raw(sym_name_buf, strlen(sym_name_buf))
        let sym_name = pool.intern(temp_str)
        let sym_name_str = pool.get(sym_name)
        @free(temp_str as ptr[u8])
        if is_elf64:
            push_elf64_sym(&elf_syms, ELF64Sym(name_str: sym_name_str, value: offset as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: 2 as u16))
        else:
            push_coff_symbol(&coff_syms, COFFSymbol(name_str: sym_name_str, value: offset, section_num: 2 as i16, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        @free(sym_name_buf)
        str_i = str_i + 1

    
    mut fi := 0 as i64
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if fn_ptr.is_extern:
            let name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: name, value: 0 as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: 0 as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: name, value: 0 as u32, section_num: 0 as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
        fi = fi + 1
        
    if dfe_rep:
        dfe_report(mod, symbols, pool, table)

    fi = 0
    mut func_done_count := 0 as i64
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if not fn_ptr.is_extern:
            let fn_name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)

            if func_done_count % 10 as i64 == 0 as i64:
                ax_printf_local("[codegen] func %d / %d | bytes=%d\n",
                    func_done_count, mod.funcs.len, all_code.len as i64,
                    0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                fflush(null as ptr[void])

            let mach_insts = select_all(fn_ptr, abi, table, symbols, pool)
            let intervals = compute_liveness(mach_insts.data, mach_insts.len)
            let alloc_res = allocate_registers_orchestrator(intervals, mach_insts.data, mach_insts.len, abi, fn_ptr, table, symbols)

            mut num_str_lits := 0 as i32
            mut loop_i := 0 as i64
            while loop_i < mach_insts.len:
                let inst = mach_insts.data[loop_i]
                if inst.op == MACH_MOV_IMM and inst.src1.vreg == 2 as u32:
                    num_str_lits = num_str_lits + 1
                loop_i = loop_i + 1

            mut local_bytes := 0 as i32
            if num_str_lits > 0:
                local_bytes = 16 + num_str_lits * 16

            mut cs_len := 0 as i64
            let cs_regs = get_used_callee_saved(abi, alloc_res.allocs, alloc_res.max_vreg, &cs_len)
            let frame = compute_frame(cs_regs, cs_len, alloc_res.spill_count, local_bytes, abi)
            
            let final_insts = insert_spill_code(mach_insts.data, mach_insts.len, alloc_res.allocs, &frame, fn_ptr, table, symbols)
            mut emitter := new_mach_emitter()

            let is_windows = not is_elf64
            mut str_lit_counter := 0 as i32
            emit_function_binary(&emitter, fn_name, final_insts.data, final_insts.len, alloc_res.allocs, &frame, is_windows, pool, &str_lit_counter, self_link)
            
            let current_offset = all_code.len as u32
            push_bytes(&all_code, emitter.code.data, emitter.code.len)
            
            push_compiled_func_info(&func_infos, CompiledFuncInfo(
                name: fn_name,
                offset: current_offset,
                size: emitter.code.len as u32,
                is_global: true,
                relocs: emitter.relocs
            ))
            
            @free(cs_regs)
            @free(alloc_res.allocs)
            if intervals.data != null as ptr[LiveInterval]:
                @free(intervals.data as ptr[u8])
            if mach_insts.data != null as ptr[MachInst]:
                @free(mach_insts.data as ptr[u8])
            if final_insts.data != null as ptr[MachInst]:
                @free(final_insts.data as ptr[u8])
                
            if emitter.code.data != null as ptr[u8]:
                @free(emitter.code.data)
            if emitter.labels.keys != null as ptr[u32]:
                @free(emitter.labels.keys as ptr[u8])
            if emitter.labels.values != null as ptr[i64]:
                @free(emitter.labels.values as ptr[u8])
            if emitter.fixups.data != null as ptr[Fixup]:
                @free(emitter.fixups.data as ptr[u8])
            func_done_count = func_done_count + 1

        fi = fi + 1

    // Append identity variant constructors for sum types (Ok, Err, Some, None)
    let ok_offset = all_code.len as u32
    // mov rax, rcx -> 48 89 c8
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    // ret -> c3
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Ok",
        offset: ok_offset,
        size: 4 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_Err legacy stub: pointer-layout Err tag — mov rax, rcx; or rax, 1; ret.
    // (Normal Err(...) calls are lowered inline by air_builder; this only covers
    // any stray direct call so the tag bit is still observable by is_err.)
    let err_offset = all_code.len as u32
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x83 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0x01 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Err",
        offset: err_offset,
        size: 8 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    let some_offset = all_code.len as u32
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Some",
        offset: some_offset,
        size: 4 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_None: pointer-layout None is the null pointer — xor eax, eax; ret.
    let none_offset = all_code.len as u32
    push_byte(&all_code, 0x31 as u8)
    push_byte(&all_code, 0xC0 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_None",
        offset: none_offset,
        size: 3 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_sum_layout_is_pointer: the native backend implements the pointer-layout
    // sum representation (boxed payload, tag bit 0 on Err), matching the C
    // backend built with -DAXIOM_SUMLAYOUT_POINTER. Defining it locally returns
    // TRUE deterministically instead of importing from ax_runtime.dll (which was
    // built without the define and returns FALSE) — mov eax, 1; ret.
    let sum_layout_offset = all_code.len as u32
    push_byte(&all_code, 0xB8 as u8)
    push_byte(&all_code, 0x01 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_sum_layout_is_pointer",
        offset: sum_layout_offset,
        size: 6 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // Append ax_block_size alias jumping to ax_str_slice
    let block_size_offset = all_code.len as u32
    // jmp near relative -> E9 00 00 00 00
    push_byte(&all_code, 0xE9 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)

    mut block_size_relocs := new_relocation_vec()
    push_reloc(&block_size_relocs, Relocation(
        offset: 1 as i64,
        kind: 0 as u8, // RELOC_PC32
        padding1: 0 as u8,
        padding2: 0 as u16,
        sym_name: 4294967266 as u32, // -30 as i64 represented as u32
        addend: -4 as i64
    ))
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_block_size",
        offset: block_size_offset,
        size: 5 as u32,
        is_global: true,
        relocs: block_size_relocs
    ))
        
    let text_sec_idx = 1 as i32
    mut i := 0 as i64
    while i < func_infos.len:
        let info = &func_infos.data[i]
        if is_elf64:
            push_elf64_sym(&elf_syms, ELF64Sym(name_str: info.name, value: info.offset as u64, size: info.size as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: text_sec_idx as u16))
        else:
            push_coff_symbol(&coff_syms, COFFSymbol(name_str: info.name, value: info.offset, section_num: text_sec_idx as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
        i = i + 1
        
    // RFC 0017 / BUG#82: emit module-level global storage into a writable .data section
    // (COFF section 3 / ELF section header index 3 — the layouts agree by design). Each global's constant-folded init
    // bytes go into `data_buf` at a naturally-aligned offset; a defined data symbol
    // (named via the same x86_resolve_sym_name the OP_GLOBAL_ADDR reloc resolves through)
    // is registered here, BEFORE the sym-map pre-pass, so the reloc binds to it.
    mut data_buf := new_byte_vec()
    // RFC 0030 P3: a global whose image bytes are all zero (`init_lo == 0` — an
    // uninitialized declaration, a runtime-initialized aggregate, or a folded constant that
    // happens to be 0) carries no information in the file. Route those to a `.bss` section
    // that reserves address space without occupying bytes.
    //
    // Gated on a 4096-byte total so that small programs keep producing a byte-identical
    // 3-section object — that is what keeps the fixpoint argument trivial, and it avoids
    // paying a section header to save a handful of bytes.
    //
    // COFF only for now; the ELF path still emits every global into `.data` (P4). Splitting
    // per format keeps a red gate attributable to one emitter.
    mut bss_total := 0 as i64
    mut init_globals := 0 as i64
    mut gz := 0 as i64
    while gz < mod.globals.len:
        let gzg = mod.globals.data[gz]
        if gzg.init_lo == 0 as i64:
            mut zsz := gzg.size as i64
            if zsz < 1 as i64:
                zsz = 1 as i64
            bss_total = bss_total + zsz
        else:
            init_globals = init_globals + 1 as i64
        gz = gz + 1
    let use_bss = bss_total >= 4096 as i64
    mut bss_size := 0 as i64
    // COFF symbols name their section by 1-based INDEX, and `.data` is emitted only when
    // it has content. So when every global is zero-initialized there IS no `.data` and
    // `.bss` lands at index 3, not 4. Deciding the number here — from whether any global
    // will stay in `.data` — keeps the symbols consistent with the section table in both
    // shapes; hardcoding 4 silently mislabels every symbol in the all-zero-globals case.
    mut bss_secnum := 3 as i16
    if use_bss and init_globals > 0 as i64:
        bss_secnum = 4 as i16
    // RFC 0030 P4: the ELF object uses a FIXED 8-section layout with `.bss` appended at
    // index 7 (indices 4-6 are referenced by hardcoded sh_link values, so it cannot be
    // inserted after `.data`). The COFF number above is positional; the ELF one is not.
    if is_elf64:
        bss_secnum = 7 as i16
    mut gi := 0 as i64
    while gi < mod.globals.len:
        let g = mod.globals.data[gi]
        mut gsize := g.size as i64
        if gsize < 1 as i64:
            gsize = 1 as i64
        // Align to the global's natural ALIGNMENT, not to its SIZE. The original
        // `data_buf.len % gsize` padded up to a multiple of the whole object, which for a
        // large global rounds the section up to a second full copy of it: a `[i64; 200000]`
        // (1.6 MB) preceded by any other global padded `.data` to 1.6 MB and then wrote
        // 1.6 MB more, so the section — and the linked executable — carried 3.2 MB for
        // 1.6 MB of storage. Alignment never needs to exceed 16 bytes on x86-64.
        mut gsz32 := 0 as u32
        mut galign32 := 0 as u32
        type_size_and_align(table, g.type_id, &gsz32, &galign32)
        mut galign := galign32 as i64
        if galign < 1 as i64:
            galign = 1 as i64
        if galign > 16 as i64:
            galign = 16 as i64
        let gname = x86_resolve_sym_name(g.sym_id, symbols, pool, table)
        if use_bss and g.init_lo == 0 as i64:
            // .bss (COFF section 4): reserve aligned address space, emit no bytes.
            while (bss_size % galign) != 0 as i64:
                bss_size = bss_size + 1 as i64
            let boff = bss_size as u32
            bss_size = bss_size + gsize
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: gname, value: boff as u64, size: gsize as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: bss_secnum as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: gname, value: boff, section_num: bss_secnum, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        else:
            while (data_buf.len % galign) != 0 as i64:
                push_byte(&data_buf, 0 as u8)
            let goff = data_buf.len as u32
            mut b := 0 as i64
            while b < gsize:
                push_byte(&data_buf, ((g.init_lo >> (b * 8 as i64)) & 0xFF as i64) as u8)
                b = b + 1
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: gname, value: goff as u64, size: gsize as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: 3 as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: gname, value: goff, section_num: 3 as i16, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        gi = gi + 1

    ax_printf_local("[codegen] all funcs done: %d bytes code, building reloc table...\n",
        all_code.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])

    mut coff_relocs := new_coff_reloc_vec()
    mut elf_relocs := new_relocation_vec()

    // Build O(1) symbol name→index map using intern pool IDs.
    // The previous O(n) linear search per relocation made this O(n^2) total.
    let sym_map_size = pool.state.count + 65536 as i64
    let coff_sym_map = @alloc(sym_map_size * 4) as ptr[i32]
    @memset(coff_sym_map as ptr[void], 0xff as u8, sym_map_size * 4)
    let elf_sym_map = @alloc(sym_map_size * 4) as ptr[i32]
    @memset(elf_sym_map as ptr[void], 0xff as u8, sym_map_size * 4)

    mut pre_i := 0 as i64
    while pre_i < coff_syms.len:
        let sn = coff_syms.data[pre_i].name_str
        let sid = pool.intern_string(sn)
        if (sid as i64) < sym_map_size:
            coff_sym_map[sid as i64] = pre_i as i32
        pre_i = pre_i + 1

    pre_i = 0 as i64
    while pre_i < elf_syms.len:
        let sn = elf_syms.data[pre_i].name_str
        let sid = pool.intern_string(sn)
        if (sid as i64) < sym_map_size:
            // ELF .symtab has a NULL entry at index 0, so elf_syms[i] lands at symtab
            // index i+1. Relocations carry SYMTAB indices — store the +1 form (the
            // on-demand path below already does). Storing the raw i made every reloc
            // to a defined symbol resolve one symbol off (latent: never exercised).
            elf_sym_map[sid as i64] = pre_i as i32 + 1 as i32
        pre_i = pre_i + 1

    mut total_relocs := 0 as i64
    i = 0
    while i < func_infos.len:
        let info = &func_infos.data[i]
        let func_offset = info.offset

        mut r_i := 0 as i64
        while r_i < info.relocs.len:
            let r = info.relocs.data[r_i]
            mut sym_idx := r.sym_name as i64
            let limit: i64 = 4026531840
            if sym_idx > limit:
                sym_idx = sym_idx - (1 as i64 << 32)
            let target_name = resolve_binary_sym_name(sym_idx, info.name, symbols, pool, table)
            total_relocs = total_relocs + 1

            let target_id = pool.intern_string(target_name)
            mut target_sym_idx := -1 as i32
            if (target_id as i64) < sym_map_size:
                if is_elf64:
                    target_sym_idx = elf_sym_map[target_id as i64]
                else:
                    target_sym_idx = coff_sym_map[target_id as i64]

            if is_elf64:
                if target_sym_idx == -1 as i32:
                    let new_idx = elf_syms.len as i32 + 1 as i32
                    push_elf64_sym(&elf_syms, ELF64Sym(name_str: target_name, value: 0 as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: 0 as u16))
                    target_sym_idx = new_idx
                    if (target_id as i64) < sym_map_size:
                        elf_sym_map[target_id as i64] = new_idx
            else:
                if target_sym_idx == -1 as i32:
                    let new_idx = coff_syms.len as i32
                    push_coff_symbol(&coff_syms, COFFSymbol(name_str: target_name, value: 0 as u32, section_num: 0 as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
                    target_sym_idx = new_idx
                    if (target_id as i64) < sym_map_size:
                        coff_sym_map[target_id as i64] = new_idx
                    
            let reloc_offset = func_offset + r.offset as u32
            if is_elf64:
                push_reloc(&elf_relocs, Relocation(offset: reloc_offset as i64, kind: r.kind, padding1: 0 as u8, padding2: 0 as u16, sym_name: target_sym_idx as u32, addend: r.addend))
            else:
                mut reloc_type := IMAGE_REL_AMD64_REL32
                if r.kind == RELOC_ABS64:
                    reloc_type = IMAGE_REL_AMD64_ADDR64
                    let val = r.addend
                    all_code.data[reloc_offset as i64 + 0] = (val & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 1] = ((val >> 8 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 2] = ((val >> 16 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 3] = ((val >> 24 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 4] = ((val >> 32 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 5] = ((val >> 40 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 6] = ((val >> 48 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 7] = ((val >> 56 as i64) & 0xFF as i64) as u8
                else:
                    mut val := (r.addend + 4) as i32
                    all_code.data[reloc_offset as i64 + 0] = (val & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 1] = ((val >> 8 as i32) & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 2] = ((val >> 16 as i32) & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 3] = ((val >> 24 as i32) & 0xFF as i32) as u8
                push_coff_reloc(&coff_relocs, COFFReloc(virt_addr: reloc_offset, sym_table_idx: target_sym_idx as u32, reloc_type: reloc_type))
                
            r_i = r_i + 1
        i = i + 1

    ax_printf_local("[codegen] reloc table done: %d relocs, %d syms, writing object...\n",
        total_relocs, coff_syms.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    @free(coff_sym_map as ptr[u8])
    @free(elf_sym_map as ptr[u8])

    mut success := false
    if is_elf64:
        success = elf64_write_object_file(output_obj_file, &all_code, &rdata_buf, &data_buf, bss_size, &elf_relocs, &elf_syms)
    else:
        success = coff_write_object_file(output_obj_file, &all_code, &rdata_buf, &data_buf, bss_size, &coff_relocs, &coff_syms)

    if all_code.data != null as ptr[u8]:
        @free(all_code.data)
    if rdata_buf.data != null as ptr[u8]:
        @free(rdata_buf.data)
    if data_buf.data != null as ptr[u8]:
        @free(data_buf.data)
    if str_keys.data != null as ptr[u32]:
        @free(str_keys.data as ptr[u8])
    if str_offsets.data != null as ptr[u32]:
        @free(str_offsets.data as ptr[u8])
        
    i = 0
    while i < func_infos.len:
        let info = &func_infos.data[i]
        if info.relocs.data != null as ptr[Relocation]:
            @free(info.relocs.data as ptr[u8])
        i = i + 1
    if func_infos.data != null as ptr[CompiledFuncInfo]:
        @free(func_infos.data as ptr[u8])
        
    if coff_syms.data != null as ptr[COFFSymbol]:
        @free(coff_syms.data as ptr[u8])
    if coff_relocs.data != null as ptr[COFFReloc]:
        @free(coff_relocs.data as ptr[u8])
        
    if elf_syms.data != null as ptr[ELF64Sym]:
        @free(elf_syms.data as ptr[u8])
    if elf_relocs.data != null as ptr[Relocation]:
        @free(elf_relocs.data as ptr[u8])
        
    return success

