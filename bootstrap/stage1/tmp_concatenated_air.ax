pub const NODE_CONTINUE_STMT: u8 = 68

// RFC 0022: tuple literal expression `(e0, e1, ...)`. Children are the element
// expressions (positional). Lowered as an anonymous struct with fields _f0.._fN.
pub const NODE_TUPLE_EXPR: u8 = 69

// RFC 0022 P2: tuple TYPE annotation `(T0, T1, ...)`. Children are the element
// type-expr nodes. Resolves to the same anonymous struct type as a tuple literal.
pub const NODE_TUPLE_TYPE: u8 = 70

// RFC 0023: if-EXPRESSION `if C0: V0 elif C1: V1 else: VE`. Children are a flat
// list `cond0, then0, [cond1, then1, ...], else_expr` (each an expression). The
// trailing child is the mandatory else value. Distinct from NODE_IF_STMT (which
// holds blocks + an optional else). Typecheck unifies branch types; AIR lowers to
// a value-producing diamond.
pub const NODE_IF_EXPR: u8 = 71


// Flags constants (matching compiler/ast/node.go exactly)
pub const FLAG_IS_PUB: u16 = 1
pub const FLAG_IS_MUT: u16 = 2
pub const FLAG_IS_ASYNC: u16 = 4
pub const FLAG_IS_EXTERN: u16 = 8
pub const FLAG_IS_SINK: u16 = 16
pub const FLAG_IS_LENT: u16 = 32
pub const FLAG_IS_PACKED: u64 = 64
pub const FLAG_ESCAPES_TO_HEAP: u16 = 128
pub const FLAG_USES_ARENA: u16 = 256
pub const FLAG_IS_GENERIC: u16 = 512
pub const FLAG_IS_MOVED: u16 = 1024
pub const FLAG_IS_SUBSTITUTED: u16 = 2048
pub const FLAG_IS_RESOLVED: u16 = 4096
pub const FLAG_FROM_DLL: u16 = 8192 // RFC 0009: extern "C" from "x.dll" â€” dll_name_id stored in AstNode.extra_idx
pub const FLAG_EXPORT: u16 = 16384 // RFC 0009 P2: #[export] â€” emit into PE export table (--shared)
pub const FLAG_MATCH_PARTIAL: u16 = 32768 // NODE_MATCH_STMT the typechecker CONFIRMED non-exhaustive (uncovered sum variant, no catch-all); read by missing-return terminator analysis

pub const NULL_IDX: u32 = 0

// Flat AST node. Exactly 24 bytes.
pub struct AstNode:
    kind: u8
    padding: u8
    flags: u16
    token_idx: u32
    first_child: u32
    next_sibling: u32
    payload: u32
    extra_idx: u32

// Custom monomorphic node vector to avoid generic monomorphization dependency
pub struct NodeVec:
    data: ptr[AstNode]
    len: i64
    cap: i64

pub fn new_node_vec() -> NodeVec:
    return NodeVec(data: null as ptr[AstNode], len: 0, cap: 0)

pub fn push(mut self: NodeVec, node: AstNode) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[AstNode] // Node size is 24 bytes
        if self.data != null as ptr[AstNode]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = node
    self.len = self.len + 1
    return idx

// AstTree holds the parsed compilation unit.
pub struct AstTree:
    nodes: NodeVec
    extras: IntVec // Custom monomorphic IntVec used from lexer.ax
    src: str
    tokens: TokenVec
    // The tree's ORIGINAL src buffer as handed to new_ast_tree. clone_subtree_from
    // grows `src` by re-concatenating cloned token text; every concat leaks the prior
    // buffer, and for a 2 MB self-host source that leaked ~7.7 GB of ~2 MB buffers.
    // We now free each spent intermediate concat buffer, but must never free THIS one
    // (its provenance is the caller's â€” possibly not heap-owned), so it is kept here
    // to guard the free.
    orig_src: str

pub fn new_ast_tree(src: str, tokens: TokenVec) -> ptr[AstTree]:
    mut nodes := new_node_vec()
    // Append root program node at index 0
    nodes.push(AstNode(
        kind: NODE_PROGRAM,
        padding: 0 as u8,
        flags: 0 as u16,
        token_idx: 0 as u32,
        first_child: NULL_IDX,
        next_sibling: NULL_IDX,
        payload: 0 as u32,
        extra_idx: 0 as u32,
    ))
    let tree = @alloc(@compiler_intrinsic("size_of")[AstTree]()) as ptr[AstTree]
    tree.nodes = nodes
    tree.extras = new_int_vec()
    tree.src = src
    tree.orig_src = src
    tree.tokens = tokens
    return tree

pub fn add_node(mut self: ptr[AstTree], kind: u8, token_idx: u32) -> u32:
    return self.nodes.push(AstNode(
        kind: kind,
        padding: 0 as u8,
        flags: 0 as u16,
        token_idx: token_idx,
        first_child: NULL_IDX,
        next_sibling: NULL_IDX,
        payload: 0 as u32,
        extra_idx: 0 as u32,
    ))

pub fn add_extra(mut self: ptr[AstTree], val: i32) -> u32:
    let idx = self.extras.len as u32
    self.extras.push(val)
    return idx

pub fn clone_subtree(mut self: ptr[AstTree], node_idx: u32) -> u32:
    if node_idx == 0 as u32 or node_idx == 0xffffffff as u32:
        return 0 as u32

    let orig_node = self.nodes.data[node_idx as i64]
    let orig_kind = orig_node.kind
    let orig_flags = orig_node.flags
    let orig_token_idx = orig_node.token_idx
    let orig_first_child = orig_node.first_child
    let orig_payload = orig_node.payload
    let orig_extra_idx = orig_node.extra_idx

    let new_idx = self.add_node(orig_kind, orig_token_idx)
    self.nodes.data[new_idx].flags = orig_flags
    self.nodes.data[new_idx].payload = orig_payload
    self.nodes.data[new_idx].extra_idx = orig_extra_idx

    // Recursively clone children safely
    mut child_idx := orig_first_child
    mut prev_cloned_child := 0 as u32
    while child_idx != 0 as u32:
        let next_child = self.nodes.data[child_idx as i64].next_sibling
        let cloned_child = self.clone_subtree(child_idx)
        if prev_cloned_child == 0 as u32:
            self.nodes.data[new_idx].first_child = cloned_child
        else:
            self.nodes.data[prev_cloned_child].next_sibling = cloned_child
        prev_cloned_child = cloned_child
        child_idx = next_child

    return new_idx

fn ast_alloc_str_from_raw(data: ptr[u8], len: i64) -> str:
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, data, len)
    buf[len] = 0 as u8
    return buf as str

pub fn clone_subtree_from(mut self: ptr[AstTree], src_tree: ptr[AstTree], node_idx: u32) -> u32:
    if node_idx == 0 as u32 or node_idx == 0xffffffff as u32:
        return 0 as u32

    let orig_node = src_tree.nodes.data[node_idx as i64]
    let orig_kind = orig_node.kind
    let orig_flags = orig_node.flags
    let orig_token_idx = orig_node.token_idx
    let orig_first_child = orig_node.first_child
    let orig_payload = orig_node.payload
    let orig_extra_idx = orig_node.extra_idx
    
    mut new_token_idx := 0 as u32
    if orig_token_idx != 0 as u32 and orig_token_idx != 0xffffffff as u32 and (orig_token_idx as i64) < src_tree.tokens.len:
        let tok_src = src_tree.tokens.data[orig_token_idx as i64]
        if tok_src.len > 0 as u16:
            let start_ptr = ((get_str_ptr(src_tree.src)) as i64 + tok_src.offset as i64) as ptr[u8]
            let tok_text = ast_alloc_str_from_raw(start_ptr, tok_src.len as i64)
            let old_src = self.src
            let new_offset = std.string.len(old_src)
            self.src = std.string.concat(old_src, tok_text)
            @free(get_str_ptr(tok_text))
            // Free the spent intermediate src buffer. `concat` copied its full contents
            // into the new self.src, so every offset still resolves; nothing else holds a
            // pointer into it. Guard: never free the tree's ORIGINAL src (caller-owned,
            // possibly not heap). Without this the per-token re-concat leaked one ~2 MB
            // buffer per cloned token (~7.7 GB across a self-host monomorphization run).
            if get_str_ptr(old_src) != get_str_ptr(self.orig_src):
                @free(get_str_ptr(old_src))
            
            new_token_idx = self.tokens.len as u32
            self.tokens.push(Token(
                kind: tok_src.kind,
                padding: 0 as u8,
                len: tok_src.len,
                offset: new_offset as u32,
            ))

    let new_idx = self.add_node(orig_kind, new_token_idx)
    self.nodes.data[new_idx].flags = orig_flags
    self.nodes.data[new_idx].payload = orig_payload
    self.nodes.data[new_idx].extra_idx = orig_extra_idx

    // Recursively clone children safely
    mut child_idx := orig_first_child
    mut prev_cloned_child := 0 as u32
    while child_idx != 0 as u32:
        let next_child = src_tree.nodes.data[child_idx as i64].next_sibling
        let cloned_child = self.clone_subtree_from(src_tree, child_idx)
        if prev_cloned_child == 0 as u32:
            self.nodes.data[new_idx].first_child = cloned_child
        else:
            self.nodes.data[prev_cloned_child].next_sibling = cloned_child
        prev_cloned_child = cloned_child
        child_idx = next_child

    return new_idx

pub fn append_child(mut self: ptr[AstTree], parent: u32, child: u32):
    if self.nodes.data[parent].first_child == NULL_IDX:
        self.nodes.data[parent].first_child = child
        return
    mut cur := self.nodes.data[parent].first_child
    while self.nodes.data[cur].next_sibling != NULL_IDX:
        cur = self.nodes.data[cur].next_sibling
    self.nodes.data[cur].next_sibling = child

// bootstrap/stage1/intern.ax
// Heap-shared Intern Pool representation for reference-copying safety.

extern "C" fn fflush(stream: ptr[void]) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64


pub struct InternEntry:
    hash: u32
    padding: u32
    start: u32
    len: u32
    id: u32
    dummy: u32

pub fn fnv1a(s: str) -> u32:
    mut h := 2166136261 as u32
    let length = std.string.len(s)
    mut i := 0
    while i < length:
        h = h ^ (s[i] as u32)
        h = h * 16777619 as u32
        i = i + 1
    // BUG#16: native backend does u32 multiply with 64-bit imul, leaving garbage
    // in the upper 32 bits. The hash is later COMPARED (entry.hash == h) in 64-bit,
    // so garbage upper bits cause false-negatives -> duplicate interns -> wrong
    // name_ids -> resolver crash. Mask to a clean u32 so equality compares hold.
    return h & 4294967295 as u32

pub struct InternState:
    pub arena_len: i64
    pub arena_cap: i64
    pub table_size: i64
    pub count: i64

pub struct InternPool:
    arena: ptr[u8]
    table: ptr[InternEntry]
    ids: ptr[InternEntry]
    state: InternState

pub fn new_intern_pool() -> ptr[InternPool]:
    let table_size = 512 as i64
    let table = @alloc(table_size * 24) as ptr[InternEntry] // InternEntry size is 24 bytes
    mut i := 0
    while i < table_size:
        table[i] = InternEntry(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1
    let ids = @alloc(256 * 24) as ptr[InternEntry]
    
    let state = InternState(
        arena_len: 0,
        arena_cap: 0,
        table_size: table_size,
        count: 0,
    )


    let pool = @alloc(56) as ptr[InternPool]
    pool.arena = null as ptr[u8]
    pool.table = table
    pool.ids = ids
    pool.state = state

    return pool

fn alloc_str_from_raw(data: ptr[u8], len: i64) -> str:
    // Raw copy to string representation
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, data, len)
    buf[len] = 0 as u8
    return buf as str

pub fn get_str(self: ptr[InternPool], id: u32) -> str:
    if id == 0 as u32 or id > self.state.count as u32:
        return ""
    let entry = self.ids[id as i64 - 1]
    let start_ptr = (self.arena as i64 + entry.start as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, entry.len as i64)

pub fn get(self: ptr[InternPool], id: u32) -> str:
    return self.get_str(id)

// PERF: test whether the interned name `id` matches method `field_name` in the
// sense of match_method_name (name == field_name, OR name ends with "."+field),
// reading the arena bytes DIRECTLY â€” no alloc_str_from_raw copy. get_str() would
// heap-allocate a str on every call; the method-resolution scans do this per
// SYM_FUNC per method-access node (tens of millions of alloc/free during a
// self-build). The arena is stable for the pool's lifetime, so borrowing is safe.
pub fn name_matches_method(self: ptr[InternPool], id: u32, field_name: str) -> bool:
    if id == 0 as u32 or id > self.state.count as u32:
        return false
    let entry = self.ids[id as i64 - 1]
    let sp = (self.arena as i64 + entry.start as i64) as ptr[u8]
    let sl = entry.len as i64
    let fp = field_name as ptr[u8]
    let fl = std.string.len(field_name)
    if sl == fl:
        mut k := 0 as i64
        while k < fl:
            if sp[k] != fp[k]:
                return false
            k = k + 1
        return true
    if sl <= fl:
        return false
    // ends with "." + field_name
    if sp[sl - fl - 1 as i64] != 46 as u8:
        return false
    mut k2 := 0 as i64
    while k2 < fl:
        if sp[sl - fl + k2] != fp[k2]:
            return false
        k2 = k2 + 1
    return true

pub fn intern(mut self: ptr[InternPool], s: str) -> u32:
    let length = std.string.len(s)
    if length == 0:
        return 0 as u32

    let h = fnv1a(s)
    let mask = self.state.table_size - 1
    mut idx = (h as i64) & mask

    while true:
        let entry = self.table[idx]
        if entry.id == 0 as u32:
            // Insert slot
            return self.insert_at(idx, s, h)
        if entry.hash == h and entry.len as i64 == length:
            // Check if string matches exactly
            mut is_match := true
            mut i := 0
            while i < length:
                if self.arena[entry.start as i64 + i] != s[i] as u8:
                    is_match = false
                    break
                i = i + 1
            if is_match:
                return entry.id
        idx = (idx + 1) & mask

    return 0 as u32

pub fn intern_string(mut self: ptr[InternPool], s: str) -> u32:
    return self.intern(s)

fn insert_at(mut self: ptr[InternPool], slot: i64, s: str, h: u32) -> u32:
    let length = std.string.len(s)
    
    // Check if we need to resize ids table
    if self.state.count > 0 and self.state.count % 256 == 0:
        let new_ids = @alloc((self.state.count + 256) * 24) as ptr[InternEntry]
        @memcpy(new_ids as ptr[u8], self.ids as ptr[u8], self.state.count * 24)
        self.ids = new_ids

    // Resize arena if needed
    if self.state.arena_len + length >= self.state.arena_cap:
        mut new_cap := 1024 as i64
        if self.state.arena_cap != 0:
            new_cap = self.state.arena_cap * 2
        if new_cap < self.state.arena_len + length:
            new_cap = self.state.arena_len + length + 1024
        let new_arena = @alloc(new_cap) as ptr[u8]
        if self.arena != null as ptr[u8]:
            @memcpy(new_arena, self.arena, self.state.arena_len)
        self.arena = new_arena
        self.state.arena_cap = new_cap

    let start = self.state.arena_len
    mut i := 0
    while i < length:
        self.arena[start + i] = s[i] as u8
        i = i + 1
    self.state.arena_len = self.state.arena_len + length

    let new_id = (self.state.count + 1) as u32
    let entry = InternEntry(
        hash: h,
        padding: 0 as u32,
        start: start as u32,
        len: length as u32,
        id: new_id,
        dummy: 0 as u32,
    )

    self.table[slot] = entry
    self.ids[self.state.count] = entry
    self.state.count = self.state.count + 1

    // If load factor exceeds 70%, we grow the hash table
    if (self.state.count * 100) / self.state.table_size > 70:
        self.grow_table()

    return new_id

fn grow_table(mut self: ptr[InternPool]):
    let old_size = self.state.table_size
    let new_size = old_size * 2
    let new_table = @alloc(new_size * 24) as ptr[InternEntry]
    mut i := 0
    while i < new_size:
        new_table[i] = InternEntry(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1

    let mask = new_size - 1
    i = 0
    while i < old_size:
        let entry = self.table[i]
        if entry.id != 0 as u32:
            mut idx = (entry.hash as i64) & mask
            while new_table[idx].id != 0 as u32:
                idx = (idx + 1) & mask
            new_table[idx] = entry
        i = i + 1

    self.table = new_table
    self.state.table_size = new_size

pub fn free_pool(mut self: ptr[InternPool]):
    if self.arena != null as ptr[u8]:
        @free(self.arena)
    if self.table != null as ptr[InternEntry]:
        @free(self.table as ptr[u8])
    if self.ids != null as ptr[InternEntry]:
        @free(self.ids as ptr[u8])
    @free(self as ptr[u8])
// bootstrap/stage1/parser.ax
// AXIOM Recursive Descent + Pratt parser written in AXIOM itself.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

// Pratt binding power constants
pub const BP_NONE: i32 = 0
pub const BP_OR: i32 = 10
pub const BP_AND: i32 = 20
pub const BP_NOT: i32 = 30
pub const BP_CMP: i32 = 40
pub const BP_BIT_OR: i32 = 50
pub const BP_BIT_XOR: i32 = 60
pub const BP_BIT_AND: i32 = 70
pub const BP_SHIFT: i32 = 80
pub const BP_ADD: i32 = 90
pub const BP_MUL: i32 = 100
pub const BP_POWER: i32 = 110
pub const BP_AS: i32 = 115
pub const BP_UNARY: i32 = 120
pub const BP_POSTFIX: i32 = 130

pub struct Parser:
    tokens: TokenVec
    pos: i64
    tree: ptr[AstTree]
    pool: ptr[InternPool]
    src: str
    diags_count: i64
    current_struct: u32       // RFC 0002: intern id of struct being parsed (0 = none); for untyped `self`
    current_struct_tok: u32   // RFC 0002: token idx of that struct's name (for synthesized self type node)

pub fn new_parser(tokens: TokenVec, src: str, pool: ptr[InternPool]) -> ptr[Parser]:
    let parser = @alloc(512) as ptr[Parser]
    parser[0] = Parser(
        tokens: tokens,
        pos: 0,
        tree: new_ast_tree(src, tokens),
        pool: pool,
        src: src,
        diags_count: 0,
        current_struct: 0 as u32,
        current_struct_tok: 0 as u32,
    )
    return parser

pub fn peek(mut self: ptr[Parser]) -> Token:
    // Skip bare NEWLINEs
    while self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_NEWLINE:
        self.pos = self.pos + 1
    if self.pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[self.pos]

pub fn peek_raw(self: ptr[Parser]) -> Token:
    if self.pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[self.pos]

pub fn peek_at(self: ptr[Parser], offset: i64) -> Token:
    mut pos := self.pos + offset
    while pos < self.tokens.len and self.tokens.data[pos].kind == TK_NEWLINE:
        pos = pos + 1
    if pos >= self.tokens.len:
        return Token(kind: TK_EOF, padding: 0 as u8, len: 0 as u16, offset: 0 as u32)
    return self.tokens.data[pos]

pub fn consume(mut self: ptr[Parser]) -> Token:
    let tok = self.peek()
    if self.pos < self.tokens.len:
        self.pos = self.pos + 1
    return tok

pub fn check(mut self: ptr[Parser], kind: u8) -> bool:
    return self.peek().kind == kind

pub fn check_raw(self: ptr[Parser], kind: u8) -> bool:
    return self.peek_raw().kind == kind

// Does the bracketed argument starting at the current position spell an ARRAY TYPE
// (`[T; N]`) rather than an index expression? Used by the `[` led to accept an explicit
// array type ARGUMENT (`Box[[i32; 3]](v: ..)`), which is legal in type position but was a
// parse error in expression position.
//
// The discriminator is a `;` at bracket depth 1: an array TYPE always has one, an array
// LITERAL never can (its elements are comma-separated), so `x[[1,2][0]]` keeps parsing as
// an expression. Bounded scan so a malformed program cannot walk the whole token stream.
pub fn is_array_type_arg(self: ptr[Parser]) -> bool:
    if self.peek_at(0 as i64).kind != TK_L_BRACKET:
        return false
    mut depth := 0 as i64
    mut i := 0 as i64
    while i < 64 as i64:
        let k = self.peek_at(i).kind
        if k == TK_EOF:
            return false
        if k == TK_L_BRACKET:
            depth = depth + 1 as i64
        elif k == TK_R_BRACKET:
            depth = depth - 1 as i64
            if depth <= 0 as i64:
                return false
        elif k == TK_SEMICOLON and depth == 1 as i64:
            return true
        i = i + 1 as i64
    return false

pub fn errorf(mut self: ptr[Parser], tok: Token, msg: str):
    self.diags_count = self.diags_count + 1
    // Simple diagnostic printing
    ax_printf_local("error: %s at offset %d\n", (msg as ptr[u8]) as i64, tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

pub fn expect(mut self: ptr[Parser], kind: u8) -> Token:
    let tok = self.peek()
    if tok.kind != kind:
        ax_printf_local("[DEBUG-EXPECT-FAIL] expected=%d got=%d offset=%d\n", kind as i64, tok.kind as i64, tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_printf_local("[DEBUG-SURROUNDING] self.pos=%d tokens.len=%d\n", self.pos as i64, self.tokens.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        mut idx := self.pos - 5 as i64
        if idx < 0 as i64:
            idx = 0 as i64
        while idx < self.pos + 5 as i64 and idx < self.tokens.len:
            let t = self.tokens.data[idx]
            ax_printf_local("  tokens[%d]: kind=%d offset=%d\n", idx as i64, t.kind as i64, t.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            idx = idx + 1
        self.errorf(tok, "unexpected token")
        return tok
    return self.consume()

pub fn expect_newline(mut self: ptr[Parser]):
    // A `;` separates multiple statements on one physical line and is equivalent to a
    // newline terminator (e.g. `putchar(x); fflush(null)`). Consume it so the next
    // statement parses cleanly â€” previously this raised a spurious "expected newline"
    // diagnostic even though codegen recovered (BUG#53 companion; Â§8: no false errors).
    if self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_SEMICOLON:
        self.pos = self.pos + 1
        return
    if self.pos < self.tokens.len and self.tokens.data[self.pos].kind == TK_NEWLINE:
        self.pos = self.pos + 1
        return
    let raw = self.peek_raw()
    if raw.kind != TK_EOF and raw.kind != TK_DEDENT:
        self.errorf(raw, "expected newline")

pub fn token_idx(self: ptr[Parser], tok: Token) -> u32:
    mut lo := 0 as i64
    mut hi := self.tokens.len
    while lo < hi:
        let mid = (lo + hi) / 2
        if self.tokens.data[mid].offset < tok.offset:
            lo = mid + 1
        else:
            hi = mid
    if lo < self.tokens.len:
        return lo as u32
    return 0 as u32

pub fn token_text(self: ptr[Parser], tok: Token) -> str:
    if tok.len == 0 as u16:
        return ""
    let start_ptr = ((self.src as ptr[u8]) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn append_child(mut self: ptr[Parser], parent: u32, child: u32):
    if self.tree.nodes.data[parent].first_child == NULL_IDX:
        self.tree.nodes.data[parent].first_child = child
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while self.tree.nodes.data[cur].next_sibling != NULL_IDX:
        cur = self.tree.nodes.data[cur].next_sibling
    self.tree.nodes.data[cur].next_sibling = child

pub fn set_payload(mut self: ptr[Parser], node: u32, payload: u32):
    self.tree.nodes.data[node].payload = payload

pub fn set_flags(mut self: ptr[Parser], node: u32, flags: u16):
    self.tree.nodes.data[node].flags = self.tree.nodes.data[node].flags | flags

fn left_binding_power(kind: u8) -> i32:
    if kind == TK_OR:
        return BP_OR
    if kind == TK_AND:
        return BP_AND
    if kind == TK_EQ_EQ or kind == TK_BANG_EQ or kind == TK_LT or kind == TK_GT or kind == TK_LT_EQ or kind == TK_GT_EQ:
        return BP_CMP
    if kind == TK_PIPE:
        return BP_BIT_OR
    if kind == TK_CARET:
        return BP_BIT_XOR
    if kind == TK_AMP:
        return BP_BIT_AND
    if kind == TK_LT_LT or kind == TK_GT_GT:
        return BP_SHIFT
    if kind == TK_PLUS or kind == TK_MINUS:
        return BP_ADD
    if kind == TK_STAR or kind == TK_SLASH or kind == TK_PERCENT:
        return BP_MUL
    if kind == TK_STAR_STAR:
        return BP_POWER
    if kind == TK_AS:
        return BP_AS
    if kind == TK_DOT_DOT:
        return 35 // range
    if kind == TK_DOT or kind == TK_DOT_STAR or kind == TK_L_BRACKET or kind == TK_L_PAREN:
        return BP_POSTFIX
    return BP_NONE

pub fn parse_expr_with_prec(mut self: ptr[Parser], min_bp: i32) -> u32:
    mut left := self.parse_nud()
    if left == 0 as u32:
        return 0 as u32
    while true:
        let tok = self.peek_raw()
        let bp = left_binding_power(tok.kind)
        if bp <= min_bp:
            break
        left = self.parse_led(left, tok, bp)
        if left == 0 as u32:
            break
    // Diagnostic recovery: a `{` immediately after a complete primary is never
    // valid in expression position -- struct literals use call syntax
    // `Type(field: value)`, and blocks are indentation-based (no brace blocks).
    // Without this, a Rust/Go-style `Point{x: 1, y: 2}` detonates into a ~10-
    // error cascade ("expected newline" + "expected expression nud" per token).
    // Emit ONE targeted diagnostic and skip the balanced brace block to recover.
    // Fixpoint-safe: the compiler's own sources never place `{` after an
    // expression, so this branch never fires during self-compilation (A==B).
    if left != 0 as u32:
        if self.peek_raw().kind == TK_L_BRACE:
            let brace_tok = self.peek_raw()
            self.errorf(brace_tok, "struct literals use parentheses, not braces: write `Type(field: value, ...)`")
            self.consume() // '{'
            mut depth := 1 as i32
            while depth > 0 as i32 and not self.check_raw(TK_EOF):
                let t = self.peek_raw()
                if t.kind == TK_L_BRACE:
                    depth = depth + 1 as i32
                elif t.kind == TK_R_BRACE:
                    depth = depth - 1 as i32
                self.consume()
    return left

pub fn parse_nud(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT:
        self.consume()
        let node = self.tree.add_node(NODE_IDENT, self.token_idx(tok))
        let text = self.token_text(tok)
        let name_id = self.pool.intern(text)
        @free(text as ptr[u8])
        self.set_payload(node, name_id)
        return node
    if tok.kind == TK_INT_LIT:
        self.consume()
        return self.tree.add_node(NODE_INT_LIT, self.token_idx(tok))
    if tok.kind == TK_FLOAT_LIT:
        self.consume()
        return self.tree.add_node(NODE_FLOAT_LIT, self.token_idx(tok))
    if tok.kind == TK_STRING_LIT:
        self.consume()
        return self.tree.add_node(NODE_STRING_LIT, self.token_idx(tok))
    if tok.kind == TK_CHAR_LIT:
        self.consume()
        return self.tree.add_node(NODE_CHAR_LIT, self.token_idx(tok))
    if tok.kind == TK_TRUE or tok.kind == TK_FALSE:
        self.consume()
        return self.tree.add_node(NODE_BOOL_LIT, self.token_idx(tok))
    if tok.kind == TK_NIL:
        self.consume()
        return self.tree.add_node(NODE_NIL_LIT, self.token_idx(tok))
    // RFC 0008: closure/lambda `|params| -> RetType body-expr`. A leading `|` in
    // NUD (prefix) position is unambiguous (infix bitwise-or is a LED, and sum
    // types never begin an expression). MVP: params + return type are annotated
    // (no inference); body is a single expression. Lifted to a top-level function
    // by lift_closures() before name resolution, then reuses fn-ptr lowering.
    if tok.kind == TK_PIPE:
        return self.parse_closure_expr()
    if tok.kind == TK_MINUS or tok.kind == TK_TILDE or tok.kind == TK_AMP:
        self.consume()
        let node = self.tree.add_node(NODE_UNARY_EXPR, self.token_idx(tok))
        let operand = self.parse_expr_with_prec(BP_UNARY)
        if operand != 0 as u32:
            self.append_child(node, operand)
        return node
    if tok.kind == TK_NOT:
        self.consume()
        let node = self.tree.add_node(NODE_UNARY_EXPR, self.token_idx(tok))
        let operand = self.parse_expr_with_prec(BP_NOT)
        if operand != 0 as u32:
            self.append_child(node, operand)
        return node
    if tok.kind == TK_L_PAREN:
        self.consume() // '('
        let inner = self.parse_expr_with_prec(BP_NONE)
        // RFC 0022: a `,` here promotes the group to a TUPLE literal. `(e)` (no
        // comma) stays a grouping expression (unchanged). `(e,)` is a 1-tuple;
        // `(a, b, ...)` an N-tuple; a trailing comma before `)` is allowed. A
        // comma in this prefix position was previously a hard parse error, so
        // this only accepts new syntax and cannot affect existing programs
        // (self-host A==B preserved, cf. the array-literal NUD).
        if self.check(TK_COMMA):
            let node = self.tree.add_node(NODE_TUPLE_EXPR, self.token_idx(tok))
            if inner != 0 as u32:
                self.append_child(node, inner)
            while self.check(TK_COMMA):
                self.consume() // ','
                if self.check(TK_R_PAREN):
                    break // trailing comma
                let prev_pos = self.pos
                let e = self.parse_expr_with_prec(BP_NONE)
                if e != 0 as u32:
                    self.append_child(node, e)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        self.expect(TK_R_PAREN)
        return inner
    if tok.kind == TK_L_BRACKET:
        // Array literal `[e0, e1, ...]`. Unambiguous in NUD (primary) position:
        // `[` here can only start a NEW expression (postfix indexing `a[i]` is
        // handled as a LED on an already-parsed primary, not here) -- this
        // combination was previously always a parse error ("expected
        // expression nud"), so no existing valid syntax is affected.
        self.consume() // '['
        let node = self.tree.add_node(NODE_ARRAY_LIT, self.token_idx(tok))
        while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(node, expr)
            if not self.check(TK_R_BRACKET):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACKET)
        return node
    if tok.kind == TK_SPAWN:
        self.consume()
        let node = self.tree.add_node(NODE_SPAWN_EXPR, self.token_idx(tok))
        let expr = self.parse_expr_with_prec(BP_UNARY)
        if expr != 0 as u32:
            self.append_child(node, expr)
        return node
    if tok.kind == TK_AWAIT:
        self.consume()
        let node = self.tree.add_node(NODE_AWAIT_EXPR, self.token_idx(tok))
        let expr = self.parse_expr_with_prec(BP_UNARY)
        if expr != 0 as u32:
            self.append_child(node, expr)
        return node
    if tok.kind == TK_HASH:
        let hash_tok = self.consume()
        let run_tok = self.expect(TK_IDENT)
        let run_text = self.token_text(run_tok)
        mut is_run := false
        if std.string.len(run_text) > 0:
            if run_text == "run":
                is_run = true
            @free(run_text as ptr[u8])

        if is_run:
            let comptime_node = self.tree.add_node(NODE_COMPTIME, self.token_idx(hash_tok))
            if self.check(TK_L_BRACE):
                self.consume() // '{'
                let block_node = self.tree.add_node(NODE_BLOCK, self.token_idx(run_tok))
                while not self.check(TK_R_BRACE) and not self.check(TK_EOF):
                    let prev_pos = self.pos
                    let stmt = self.parse_stmt()
                    if stmt != 0 as u32:
                        self.append_child(block_node, stmt)
                    if self.pos == prev_pos:
                        self.consume()
                self.expect(TK_R_BRACE)
                self.append_child(comptime_node, block_node)
            elif self.check(TK_COLON):
                self.consume() // ':'
                let block_node = self.parse_block()
                if block_node != 0 as u32:
                    self.append_child(comptime_node, block_node)
            else:
                let expr_node = self.parse_expr_with_prec(BP_NONE)
                if expr_node != 0 as u32:
                    self.append_child(comptime_node, expr_node)
            return comptime_node
        else:
            return self.tree.add_node(NODE_ERROR, self.token_idx(hash_tok))

    // RFC 0023: if-EXPRESSION `if C0: V0 (elif Ci: Vi)* else: VE` in prefix
    // (expression) position. Statement-`if` is dispatched separately in parse_stmt
    // and is unaffected. Each branch body is a single inline expression (NOT a
    // block); `else` is mandatory (an expression must produce a value). Children:
    // flat `cond0, then0, [condi, theni, ...], else_expr`.
    if tok.kind == TK_IF:
        self.consume() // 'if'
        let node = self.tree.add_node(NODE_IF_EXPR, self.token_idx(tok))
        let c0 = self.parse_expr_with_prec(BP_NONE)
        if c0 != 0 as u32:
            self.append_child(node, c0)
        self.expect(TK_COLON)
        let v0 = self.parse_expr_with_prec(BP_NONE)
        if v0 != 0 as u32:
            self.append_child(node, v0)
        while self.check(TK_ELIF):
            self.consume() // 'elif'
            let ci = self.parse_expr_with_prec(BP_NONE)
            if ci != 0 as u32:
                self.append_child(node, ci)
            self.expect(TK_COLON)
            let vi = self.parse_expr_with_prec(BP_NONE)
            if vi != 0 as u32:
                self.append_child(node, vi)
        if not self.check(TK_ELSE):
            let p = self.peek()
            self.errorf(p, "if-expression requires an else branch (it must produce a value)")
            return node
        self.consume() // 'else'
        self.expect(TK_COLON)
        let ve = self.parse_expr_with_prec(BP_NONE)
        if ve != 0 as u32:
            self.append_child(node, ve)
        return node

    self.errorf(tok, "expected expression nud")
    self.consume()
    return 0 as u32

pub fn parse_led(mut self: ptr[Parser], left: u32, op_tok: Token, bp: i32) -> u32:
    self.consume() // consume operator
    if (op_tok.kind == TK_OR or op_tok.kind == TK_AND or
        op_tok.kind == TK_EQ_EQ or op_tok.kind == TK_BANG_EQ or
        op_tok.kind == TK_LT or op_tok.kind == TK_GT or op_tok.kind == TK_LT_EQ or op_tok.kind == TK_GT_EQ or
        op_tok.kind == TK_PIPE or op_tok.kind == TK_CARET or op_tok.kind == TK_AMP or
        op_tok.kind == TK_LT_LT or op_tok.kind == TK_GT_GT or
        op_tok.kind == TK_PLUS or op_tok.kind == TK_MINUS or
        op_tok.kind == TK_STAR or op_tok.kind == TK_SLASH or op_tok.kind == TK_PERCENT or
        op_tok.kind == TK_DOT_DOT):
        let node = self.tree.add_node(NODE_BINARY_EXPR, self.token_idx(op_tok))
        mut flags := 0 as u16
        if (op_tok.kind == TK_EQ_EQ or op_tok.kind == TK_BANG_EQ or
            op_tok.kind == TK_LT or op_tok.kind == TK_GT or
            op_tok.kind == TK_LT_EQ or op_tok.kind == TK_GT_EQ):
            flags = 1 as u16
        elif op_tok.kind == TK_AND or op_tok.kind == TK_OR:
            flags = 2 as u16
        if flags != 0 as u16:
            self.set_flags(node, flags)
        self.append_child(node, left)
        let right = self.parse_expr_with_prec(bp)
        if right != 0 as u32:
            self.append_child(node, right)
        return node
    if op_tok.kind == TK_STAR_STAR:
        let node = self.tree.add_node(NODE_BINARY_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        let right = self.parse_expr_with_prec(bp - 1)
        if right != 0 as u32:
            self.append_child(node, right)
        return node
    if op_tok.kind == TK_DOT:
        let tok = self.peek()
        // RFC 0022: `t.0` / `t.1` â€” an INT_LIT selector is tuple field access.
        // Rewrite it to the synth field name `_f<N>` so it resolves against the
        // tuple's anonymous struct fields via ordinary name-based resolution.
        // `t.0` was previously a hard parse error, so this only adds syntax.
        if self.check(TK_INT_LIT):
            let field_tok = self.consume()
            let itext = self.token_text(field_tok)
            let fname = std.string.concat("_f", itext)
            @free(itext as ptr[u8])
            let node = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
            self.append_child(node, left)
            self.set_payload(node, self.pool.intern(fname))
            @free(fname as ptr[u8])
            let field_name = self.tree.add_node(NODE_IDENT, self.token_idx(field_tok))
            self.append_child(node, field_name)
            return node
        // RFC 0022 P4: chained tuple field access `t.0.1`. The lexer tokenizes the
        // `0.1` run as a FLOAT literal, so a float in field-selector position is really
        // two indices `.0` then `.1`. Split on the dot into nested tuple field accesses
        // `t._f0._f1`. Previously a hard parse error (expect IDENT on a float), so this
        // only ACCEPTS new syntax. A float with no `.` (e.g. `1e5`) can't be a chained
        // index and falls through to the normal identifier-expected error.
        if self.check(TK_FLOAT_LIT):
            let ftok = self.peek()
            let ftext = self.token_text(ftok)
            let flen = std.string.len(ftext)
            mut dot := 0 as i64 - 1 as i64
            mut si := 0 as i64
            while si < flen:
                if ftext[si] as u8 == 46 as u8: // '.'
                    dot = si
                    break
                si = si + 1 as i64
            if dot >= 0 as i64:
                self.consume() // the float selector
                let lstr = std.string.slice(ftext, 0 as i64, dot)
                let rstr = std.string.slice(ftext, dot + 1 as i64, flen)
                @free(ftext as ptr[u8])
                let lname = std.string.concat("_f", lstr)
                safe_free_str(lstr)
                let rname = std.string.concat("_f", rstr)
                safe_free_str(rstr)
                let inner = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
                self.append_child(inner, left)
                self.set_payload(inner, self.pool.intern(lname))
                @free(lname as ptr[u8])
                let lid = self.tree.add_node(NODE_IDENT, self.token_idx(ftok))
                self.append_child(inner, lid)
                let outer = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
                self.append_child(outer, inner)
                self.set_payload(outer, self.pool.intern(rname))
                @free(rname as ptr[u8])
                let rid = self.tree.add_node(NODE_IDENT, self.token_idx(ftok))
                self.append_child(outer, rid)
                return outer
            @free(ftext as ptr[u8])
        let field_tok = self.expect(TK_IDENT)
        let node = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(tok))
        self.append_child(node, left)
        let text = self.token_text(field_tok)
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        let field_name = self.tree.add_node(NODE_IDENT, self.token_idx(field_tok))
        self.append_child(node, field_name)
        return node
    if op_tok.kind == TK_DOT_STAR:
        let node = self.tree.add_node(NODE_DEREF_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        return node
    if op_tok.kind == TK_L_BRACKET:
        let node = self.tree.add_node(NODE_INDEX_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
            let prev_pos = self.pos
            // A bracketed argument here is a generic type argument spelled as an ARRAY
            // TYPE (`Box[[i32; 3]](v: ..)`), not an index expression. The same spelling
            // in TYPE position (`let b: Box[[i32;3]]`) already worked, so without this
            // the two positions disagreed and the ctor form was a parse error.
            // `is_array_type_arg` requires a `;` at bracket depth 1, which no array
            // LITERAL can contain, so `x[[1,2][0]]` still parses as an expression.
            mut idx := 0 as u32
            if self.is_array_type_arg():
                idx = self.parse_type_expr()
            else:
                idx = self.parse_expr_with_prec(BP_NONE)
            if idx != 0 as u32:
                self.append_child(node, idx)
            if not self.check(TK_R_BRACKET):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACKET)
        return node
    if op_tok.kind == TK_L_PAREN:
        return self.parse_call_args(left, op_tok)
    if op_tok.kind == TK_AS:
        let node = self.tree.add_node(NODE_CAST_EXPR, self.token_idx(op_tok))
        self.append_child(node, left)
        let type_node = self.parse_type_expr()
        if type_node != 0 as u32:
            self.append_child(node, type_node)
        return node

    return left

pub fn parse_call_args(mut self: ptr[Parser], callee: u32, lparen: Token) -> u32:
    let node = self.tree.add_node(NODE_CALL_EXPR, self.token_idx(lparen))
    self.append_child(node, callee)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        if self.check(TK_IDENT) and self.peek_at(1 as i64).kind == TK_COLON:
            let arg_node = self.tree.add_node(NODE_NAMED_ARG, self.token_idx(self.peek()))
            let name_tok = self.consume()
            self.consume() // :
            let text = self.token_text(name_tok)
            let name_id = self.pool.intern(text)
            @free(text as ptr[u8])
            self.set_payload(arg_node, name_id)
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(arg_node, expr)
            self.append_child(node, arg_node)
        else:
            let expr = self.parse_expr_with_prec(BP_NONE)
            if expr != 0 as u32:
                self.append_child(node, expr)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)
    return node

pub fn parse_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_LET or tok.kind == TK_MUT:
        return self.parse_var_decl()
    if tok.kind == TK_RETURN:
        return self.parse_return_stmt()
    if tok.kind == TK_IF:
        return self.parse_if_stmt()
    if tok.kind == TK_WHILE:
        return self.parse_while_loop()
    if tok.kind == TK_FOR:
        return self.parse_for_loop()
    if tok.kind == TK_MATCH:
        return self.parse_match_stmt()
    if tok.kind == TK_BREAK:
        return self.parse_break_stmt()
    if tok.kind == TK_CONTINUE:
        return self.parse_continue_stmt()
    if tok.kind == TK_UNSAFE:
        return self.parse_unsafe_block()
    if tok.kind == TK_IN:
        return self.parse_arena_block()
    if tok.kind == TK_DEFER:
        return self.parse_defer_stmt()

    return self.parse_expr_stmt()

// RFC 0006 (#38.4): `defer Expr NEWLINE`. The expression is recorded (not run)
// and executed at scope exit, LIFO. See air_builder.lower_defer / flush_defers.
pub fn parse_defer_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_DEFER)
    let node = self.tree.add_node(NODE_DEFER_STMT, self.token_idx(tok))
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect_newline()
    return node

// RFC 0006 (#38.5/#38.6): `unsafe:` and `in [arena]:` blocks. Both are parsed
// and their body lowered transparently (codegen no-op wrapper) â€” unsafe disables
// generational checks (not yet enforced) and arena routes allocations (routing
// deferred); for now both just execute their inner block.
pub fn parse_unsafe_block(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_UNSAFE)
    let node = self.tree.add_node(NODE_UNSAFE_BLOCK, self.token_idx(tok))
    self.expect(TK_COLON)
    let block = self.parse_block()
    if block != 0 as u32:
        self.append_child(node, block)
    return node

pub fn parse_arena_block(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IN)
    let node = self.tree.add_node(NODE_ARENA_BLOCK, self.token_idx(tok))
    self.expect(TK_L_BRACKET)
    let name = self.expect(TK_IDENT)
    let text = self.token_text(name)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_R_BRACKET)
    self.expect(TK_COLON)
    let block = self.parse_block()
    if block != 0 as u32:
        self.append_child(node, block)
    return node

pub fn parse_break_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_BREAK)
    let node = self.tree.add_node(NODE_BREAK_STMT, self.token_idx(tok))
    self.expect_newline()
    return node

pub fn parse_continue_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_CONTINUE)
    let node = self.tree.add_node(NODE_CONTINUE_STMT, self.token_idx(tok))
    self.expect_newline()
    return node

pub fn parse_var_decl(mut self: ptr[Parser]) -> u32:
    let tok = self.consume() // let/mut
    // RFC 0022 P3: tuple destructuring `let (a, b, ...) = EXPR`. A `(` right after
    // `let`/`mut` (where a binding NAME is otherwise required) is unambiguous.
    if self.check(TK_L_PAREN):
        return self.parse_tuple_destructure(tok)
    let node = self.tree.add_node(NODE_VAR_DECL, self.token_idx(tok))
    if tok.kind == TK_MUT:
        self.set_flags(node, FLAG_IS_MUT as u16)
    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    if self.check(TK_COLON):
        self.consume() // ':'
        let t = self.parse_type_expr()
        if t != 0 as u32:
            self.append_child(node, t)
    // The initializer `=`/`:=` is always on the SAME physical line as the declaration.
    // Probe with check_raw (non-skipping): `check` calls the newline-skipping `peek`,
    // which â€” on a declaration with NO initializer (`mut g: i64`) â€” would consume the
    // terminating newline while looking for `=`, leaving `expect_newline` staring at the
    // NEXT statement ("expected newline" desync). A raw probe leaves the newline intact
    // so a no-initializer decl terminates cleanly (module globals then default to a
    // zeroed `.data` slot; see collect_global).
    if self.check_raw(TK_EQ) or self.check_raw(TK_COLON_EQ):
        self.consume()
        let val = self.parse_expr_with_prec(BP_NONE)
        if val != 0 as u32:
            self.append_child(node, val)
    self.expect_newline()
    return node

// RFC 0022 P3: desugar `let (a, b, ...) = EXPR` into a scope-transparent block:
//   { let __td<n> = EXPR ; let a = __td<n>._f0 ; let b = __td<n>._f1 ; ... }
// A bare NODE_BLOCK does not push a scope in the resolver, so the bindings land in
// the ENCLOSING scope (visible after the destructure). The temp evaluates EXPR once;
// each binding reads one tuple field through the ordinary tuple field-access path
// (`_f<i>`). `_` bindings are skipped. Nested patterns are deferred (P3+): bindings
// must be plain names or `_`.
// RFC 0022 P3/P5: interned name for a destructuring temp, made unique by the AST
// node index it is attached to (node indices are strictly increasing). The `__td`
// PREFIX IS LOAD-BEARING: air_builder's lower_ident trusts an already-resolved
// payload for `__td`-prefixed symbols instead of re-deriving the name from the
// token (a synthesized ident has a placeholder token).
pub fn fresh_td_name(mut self: ptr[Parser], node_idx: u32) -> u32:
    let uniq = std.string.to_str(node_idx as i64)
    let tmp_str = std.string.concat("__td", uniq)
    safe_free_str(uniq)
    let id = self.pool.intern(tmp_str)
    safe_free_str(tmp_str)
    return id

// RFC 0022 P3/P5: give `bind` the initializer `<base_name>._f<idx>` â€” one tuple
// field read through the ordinary tuple field-access path.
pub fn attach_tuple_field_init(mut self: ptr[Parser], bind: u32, base_name: u32, idx: i64, kw_tok: Token):
    let obj = self.tree.add_node(NODE_IDENT, self.token_idx(kw_tok))
    self.set_payload(obj, base_name)
    let fld = self.tree.add_node(NODE_FIELD_EXPR, self.token_idx(kw_tok))
    self.append_child(fld, obj)
    let istr = std.string.to_str(idx)
    let fstr = std.string.concat("_f", istr)
    safe_free_str(istr)
    self.set_payload(fld, self.pool.intern(fstr))
    safe_free_str(fstr)
    let fid = self.tree.add_node(NODE_IDENT, self.token_idx(kw_tok))
    self.append_child(fld, fid)
    self.append_child(bind, fld)

// RFC 0022 P5: emit one binding per member of a parenthesized destructuring
// pattern, reading each member out of `base_name`. The opening `(` must ALREADY be
// consumed; this consumes through the matching `)`.
//
// A member is a NAME (bind it), `_` (skip), or a NESTED `(...)` pattern â€” the P5
// addition. Nesting is handled by binding a fresh `__td` temp to `base._f<i>` and
// RECURSING into it, so `let ((a, b), c) = e` flattens to
//   __td1 = e ; __td2 = __td1._f0 ; a = __td2._f0 ; b = __td2._f1 ; c = __td1._f1
// with no new node kinds and no typecheck/lowering changes â€” the nested temp is an
// ordinary tuple-typed local. Depth is bounded only by recursion.
pub fn emit_destructure_members(mut self: ptr[Parser], block: u32, base_name: u32, kw_tok: Token, is_mut: bool):
    mut i := 0 as i64
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let nt = self.peek()
        if nt.kind == TK_L_PAREN:
            self.consume() // '(' of the nested pattern
            let sub_bind = self.tree.add_node(NODE_VAR_DECL, self.token_idx(kw_tok))
            let sub_name = self.fresh_td_name(sub_bind)
            self.set_payload(sub_bind, sub_name)
            self.attach_tuple_field_init(sub_bind, base_name, i, kw_tok)
            self.append_child(block, sub_bind)
            self.emit_destructure_members(block, sub_name, kw_tok, is_mut)
        elif nt.kind == TK_IDENT:
            self.consume()
            let ntext = self.token_text(nt)
            let is_wild = std.string.len(ntext) == 1 as i64 and ntext[0] == 95 as u8 // '_'
            if not is_wild:
                let nm = self.pool.intern(ntext)
                let bind = self.tree.add_node(NODE_VAR_DECL, self.token_idx(kw_tok))
                if is_mut:
                    self.set_flags(bind, FLAG_IS_MUT as u16)
                self.set_payload(bind, nm)
                self.attach_tuple_field_init(bind, base_name, i, kw_tok)
                self.append_child(block, bind)
            @free(ntext as ptr[u8])
        else:
            self.errorf(nt, "tuple destructuring binding must be a name, `_`, or a nested `(...)` pattern")
            self.consume()
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
        i = i + 1 as i64
    self.expect(TK_R_PAREN)

pub fn parse_tuple_destructure(mut self: ptr[Parser], kw_tok: Token) -> u32:
    let is_mut = (kw_tok.kind == TK_MUT)
    // The block must exist BEFORE the pattern is parsed: parsing and emission are
    // interleaved so a nested pattern can append its temp as it is recognised.
    let block = self.tree.add_node(NODE_BLOCK, self.token_idx(kw_tok))
    let tmp_name_id = self.fresh_td_name(block)
    let tmp_decl = self.tree.add_node(NODE_VAR_DECL, self.token_idx(kw_tok))
    self.set_payload(tmp_decl, tmp_name_id)
    self.append_child(block, tmp_decl)

    self.consume() // '('
    self.emit_destructure_members(block, tmp_name_id, kw_tok, is_mut)
    if self.check_raw(TK_EQ) or self.check_raw(TK_COLON_EQ):
        self.consume()
    else:
        self.errorf(self.peek(), "tuple destructuring requires an initializer `= EXPR`")
    let init = self.parse_expr_with_prec(BP_NONE)
    self.expect_newline()
    // The temp's initializer is attached LAST (it is only parsed now) but the temp
    // decl is still the block's FIRST statement, so EXPR is evaluated exactly once,
    // before any binding reads it.
    if init != 0 as u32:
        self.append_child(tmp_decl, init)
    return block

pub fn parse_return_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_RETURN)
    let node = self.tree.add_node(NODE_RETURN_STMT, self.token_idx(tok))
    let raw = self.peek_raw()
    if raw.kind != TK_NEWLINE and raw.kind != TK_DEDENT and raw.kind != TK_EOF:
        let val = self.parse_expr_with_prec(BP_NONE)
        if val != 0 as u32:
            self.append_child(node, val)
    self.expect_newline()
    return node

pub fn parse_if_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IF)
    let node = self.tree.add_node(NODE_IF_STMT, self.token_idx(tok))
    let cond = self.parse_expr_with_prec(BP_NONE)
    if cond != 0 as u32:
        self.append_child(node, cond)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)

    while self.check(TK_ELIF):
        let elif_tok = self.consume()
        let elif_node = self.tree.add_node(NODE_ELIF_CLAUSE, self.token_idx(elif_tok))
        let elif_cond = self.parse_expr_with_prec(BP_NONE)
        if elif_cond != 0 as u32:
            self.append_child(elif_node, elif_cond)
        self.expect(TK_COLON)
        let elif_body = self.parse_block()
        if elif_body != 0 as u32:
            self.append_child(elif_node, elif_body)
        self.append_child(node, elif_node)

    if self.check(TK_ELSE):
        let else_tok = self.consume()
        let else_node = self.tree.add_node(NODE_ELSE_CLAUSE, self.token_idx(else_tok))
        self.expect(TK_COLON)
        let else_body = self.parse_block()
        if else_body != 0 as u32:
            self.append_child(else_node, else_body)
        self.append_child(node, else_node)

    return node

pub fn parse_while_loop(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_WHILE)
    let node = self.tree.add_node(NODE_WHILE_STMT, self.token_idx(tok))
    let cond = self.parse_expr_with_prec(BP_NONE)
    if cond != 0 as u32:
        self.append_child(node, cond)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)
    return node

pub fn parse_for_loop(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_FOR)
    let node = self.tree.add_node(NODE_FOR_STMT, self.token_idx(tok))
    // RFC 0022 P5: destructuring loop variable `for (a, b) in v`. A `(` where a
    // loop-variable NAME is otherwise required is unambiguous (same tell as the
    // `let (a, b) = e` form). The loop variable becomes a `__td` temp and the
    // bindings are prepended to the body, so this reuses the P3/P5 desugar wholesale
    // and needs no change to for-loop lowering. Pairs directly with the container
    // APIs that yield tuples: `for (i, x) in v.enumerate()`, `.zip(..)`,
    // `std.string.char_indices(s)`.
    if self.check(TK_L_PAREN):
        // The wrapper block must exist before the pattern is parsed (parse and emit
        // are interleaved), so the per-iteration bindings land ahead of the body.
        let wrapper = self.tree.add_node(NODE_BLOCK, self.token_idx(tok))
        let tmp_name_id = self.fresh_td_name(wrapper)
        self.set_payload(node, tmp_name_id)
        self.consume() // '('
        self.emit_destructure_members(wrapper, tmp_name_id, tok, false)
        self.expect(TK_IN)
        let d_iter = self.parse_expr_with_prec(BP_NONE)
        if d_iter != 0 as u32:
            self.append_child(node, d_iter)
        self.expect(TK_COLON)
        let d_body = self.parse_block()
        if d_body != 0 as u32:
            self.append_child(wrapper, d_body)
        self.append_child(node, wrapper)
        return node
    let var_tok = self.expect(TK_IDENT)
    let text = self.token_text(var_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_IN)
    let iter = self.parse_expr_with_prec(BP_NONE)
    if iter != 0 as u32:
        self.append_child(node, iter)
    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)
    return node

pub fn parse_match_stmt(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_MATCH)
    let node = self.tree.add_node(NODE_MATCH_STMT, self.token_idx(tok))
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect(TK_COLON)
    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after match")
        return node
    self.consume() // consume INDENT
    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let arm = self.parse_match_arm()
        if arm != 0 as u32:
            self.append_child(node, arm)
        if self.pos == prev_pos:
            self.pos = self.pos + 1
    if self.check(TK_DEDENT):
        self.consume()
    return node

pub fn parse_match_arm(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_MATCH_ARM, self.token_idx(tok))
    let pat = self.parse_pattern()
    if pat != 0 as u32:
        self.append_child(node, pat)
    self.expect(TK_COLON)
    if self.check(TK_INDENT):
        let body = self.parse_block()
        if body != 0 as u32:
            self.append_child(node, body)
    else:
        // Inline `:` body. A value expression is allowed (`Some(_): 0`), but a STATEMENT
        // (return/if/while/for/let/mut/break/continue/match) is not a value â€” the same
        // unsupported inline-suite form rejected for if/while (BUG#53). Feeding it to
        // parse_expr desyncs the arm loop into 10+ confusing cascade errors, so detect the
        // statement keyword up front and emit ONE actionable diagnostic, then skip the rest
        // of the physical line so the next arm (or DEDENT) parses cleanly (Â§8).
        let nb = self.peek()
        if (nb.kind == TK_RETURN or nb.kind == TK_IF or nb.kind == TK_WHILE or
            nb.kind == TK_FOR or nb.kind == TK_LET or nb.kind == TK_MUT or
            nb.kind == TK_BREAK or nb.kind == TK_CONTINUE or nb.kind == TK_MATCH):
            self.errorf(nb, "match arm body must be an indented block; an inline ':' with a statement is not supported -- put the statement(s) on the next line, indented")
            while self.pos < self.tokens.len and self.tokens.data[self.pos].kind != TK_NEWLINE and self.tokens.data[self.pos].kind != TK_DEDENT:
                self.pos = self.pos + 1
            return node
        let expr = self.parse_expr_with_prec(BP_NONE)
        if expr != 0 as u32:
            self.append_child(node, expr)
        self.expect_newline()
    return node

pub fn parse_pattern(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT:
        self.consume()
        let text = self.token_text(tok)
        let len = std.string.len(text)
        if len == 1 and text[0] as u8 == 95 as u8: // '_' ASCII is 95
            @free(text as ptr[u8])
            return self.tree.add_node(NODE_WILDCARD_PAT, self.token_idx(tok))
        if self.check(TK_L_PAREN):
            let node = self.tree.add_node(NODE_VARIANT_PAT, self.token_idx(tok))
            self.set_payload(node, self.pool.intern(text))
            @free(text as ptr[u8])
            self.consume() // '('
            while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
                let prev_pos = self.pos
                let inner = self.parse_pattern()
                if inner != 0 as u32:
                    self.append_child(node, inner)
                if not self.check(TK_R_PAREN):
                    self.expect(TK_COMMA)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        let node = self.tree.add_node(NODE_BINDING_PAT, self.token_idx(tok))
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        return node
    elif (tok.kind == TK_INT_LIT or tok.kind == TK_FLOAT_LIT or tok.kind == TK_STRING_LIT or
          tok.kind == TK_CHAR_LIT or tok.kind == TK_TRUE or tok.kind == TK_FALSE or tok.kind == TK_NIL):
        self.consume()
        return self.tree.add_node(NODE_LITERAL_PAT, self.token_idx(tok))
    elif tok.kind == TK_MINUS:
        // Negative numeric literal pattern (`match n: -5: ...`). The lexer emits `-` as a
        // separate TK_MINUS token; parse_pattern must fold it into the following numeric
        // literal. There is no spare u16 flag bit for "negative", so the sign is carried in
        // the node PAYLOAD (payload==1 => negate the token value at lowering); NODE_LITERAL_PAT
        // otherwise leaves payload unused. Only INT/FLOAT literals may be negated.
        let nxt = self.peek_at(1 as i64)
        if nxt.kind == TK_INT_LIT or nxt.kind == TK_FLOAT_LIT:
            self.consume() // '-'
            let lit = self.peek()
            self.consume() // the numeric literal
            let node = self.tree.add_node(NODE_LITERAL_PAT, self.token_idx(lit))
            self.set_payload(node, 1 as u32)
            return node
        else:
            self.errorf(tok, "expected pattern")
            self.consume()
            return 0 as u32
    elif tok.kind == TK_L_PAREN:
        self.consume()
        let node = self.tree.add_node(NODE_TUPLE_PAT, self.token_idx(tok))
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let inner = self.parse_pattern()
            if inner != 0 as u32:
                self.append_child(node, inner)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
        return node
    else:
        self.errorf(tok, "expected pattern")
        self.consume()
        return 0 as u32

pub fn parse_expr_stmt(mut self: ptr[Parser]) -> u32:
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr == 0 as u32:
        return 0 as u32
    let tok = self.peek_raw()
    if (tok.kind == TK_EQ or tok.kind == TK_PLUS_EQ or tok.kind == TK_MINUS_EQ or
        tok.kind == TK_STAR_EQ or tok.kind == TK_SLASH_EQ or tok.kind == TK_PERCENT_EQ):
        self.consume()
        let node = self.tree.add_node(NODE_ASSIGN_STMT, self.token_idx(tok))
        self.append_child(node, expr)
        let rhs = self.parse_expr_with_prec(BP_NONE)
        if rhs != 0 as u32:
            self.append_child(node, rhs)
        self.expect_newline()
        return node
    self.expect_newline()
    return expr

pub fn parse_block(mut self: ptr[Parser]) -> u32:
    // A suite must be an indented block on the following line. If there is no INDENT
    // here the source used an inline `:` suite (e.g. `if COND: return X`), which is not
    // supported â€” emit ONE actionable diagnostic and return an empty block so the driver
    // halts (BUG#53) without cascading confusing follow-on errors from a desynced parser.
    if not self.check(TK_INDENT):
        self.errorf(self.peek(), "expected an indented block; inline ':' suites are not supported -- put the statement on the next line, indented")
        return self.tree.add_node(NODE_BLOCK, self.token_idx(self.peek()))
    let tok = self.expect(TK_INDENT)
    let node = self.tree.add_node(NODE_BLOCK, self.token_idx(tok))
    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let stmt = self.parse_stmt()
        if stmt != 0 as u32:
            // RFC 0022 P3: `let (a,b) = e` desugars to a NODE_BLOCK holding a temp +
            // per-binding decls. No other statement form yields a bare NODE_BLOCK here,
            // so splice its (already-linked, 0-terminated) child chain directly into the
            // enclosing statement list â€” the bindings then live at the SAME lexical level
            // as ordinary locals (the proven flat form), not in a nested block.
            if self.tree.nodes.data[stmt as i64].kind == NODE_BLOCK:
                let fc = self.tree.nodes.data[stmt as i64].first_child
                if fc != 0 as u32:
                    self.append_child(node, fc)
            else:
                self.append_child(node, stmt)
        if self.pos == prev_pos:
            self.pos = self.pos + 1
    self.expect(TK_DEDENT)
    return node

pub fn parse_type_expr(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind == TK_IDENT or tok.kind == TK_FUTURE or tok.kind == TK_ISOLATED:
        self.consume()
        let node = self.tree.add_node(NODE_TYPE_EXPR, self.token_idx(tok))
        let text = self.token_text(tok)
        self.set_payload(node, self.pool.intern(text))
        @free(text as ptr[u8])
        if self.check_raw(TK_L_BRACKET):
            let gen_node = self.tree.add_node(NODE_GENERIC_TYPE, self.token_idx(tok))
            self.append_child(gen_node, node)
            self.consume() // [
            while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
                let prev_pos = self.pos
                let t = self.parse_type_expr()
                if t != 0 as u32:
                    self.append_child(gen_node, t)
                if not self.check(TK_R_BRACKET):
                    self.expect(TK_COMMA)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_BRACKET)
            return gen_node
        return node
    if tok.kind == TK_STAR:
        self.consume()
        let node = self.tree.add_node(NODE_PTR_TYPE, self.token_idx(tok))
        if self.check(TK_MUT):
            self.consume()
            self.set_flags(node, FLAG_IS_MUT as u16)
        let inner = self.parse_type_expr()
        if inner != 0 as u32:
            self.append_child(node, inner)
        return node
    if tok.kind == TK_L_BRACKET:
        self.consume()
        mut node := self.tree.add_node(NODE_SLICE_TYPE, self.token_idx(tok))
        let inner = self.parse_type_expr()
        if inner != 0 as u32:
            self.append_child(node, inner)
        if self.check(TK_SEMICOLON):
            self.consume()
            self.tree.nodes.data[node].kind = NODE_ARRAY_TYPE
            let size_tok = self.expect(TK_INT_LIT)
            let size_node = self.tree.add_node(NODE_INT_LIT, self.token_idx(size_tok))
            self.append_child(node, size_node)
        self.expect(TK_R_BRACKET)
        return node
    if tok.kind == TK_FN:
        self.consume()
        let node = self.tree.add_node(NODE_FUNC_TYPE, self.token_idx(tok))
        self.expect(TK_L_PAREN)
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(node, t)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
        if self.check_raw(TK_ARROW):
            self.consume()
            let ret = self.parse_type_expr()
            if ret != 0 as u32:
                self.append_child(node, ret)
                self.set_flags(node, 1 as u16)
        return node
    if tok.kind == TK_L_PAREN:
        // RFC 0022 P2: tuple TYPE `(T0, T1, ...)`. A bare `(` in type position was
        // always an error before (fn-types use `fn(...)`, never a bare paren), so
        // this only ACCEPTS previously-rejected syntax -> self-host A==B preserved.
        // A `,` makes it a tuple; `(T)` with no comma is a grouped type (returns
        // inner). Trailing comma allowed.
        self.consume() // '('
        let first = self.parse_type_expr()
        if self.check(TK_COMMA):
            let node = self.tree.add_node(NODE_TUPLE_TYPE, self.token_idx(tok))
            if first != 0 as u32:
                self.append_child(node, first)
            while self.check(TK_COMMA):
                self.consume() // ','
                if self.check(TK_R_PAREN):
                    break // trailing comma
                let prev_pos = self.pos
                let t = self.parse_type_expr()
                if t != 0 as u32:
                    self.append_child(node, t)
                if self.pos == prev_pos:
                    self.consume()
            self.expect(TK_R_PAREN)
            return node
        self.expect(TK_R_PAREN)
        return first

    self.errorf(tok, "expected type expression")
    return 0 as u32

pub fn parse_generic_params(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_GENERIC_PARAMS, self.token_idx(tok))
    self.expect(TK_L_BRACKET)
    while not self.check(TK_R_BRACKET) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let gp = self.parse_generic_param()
        if gp != 0 as u32:
            self.append_child(node, gp)
        if not self.check(TK_R_BRACKET):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_BRACKET)
    return node

pub fn parse_generic_param(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    let node = self.tree.add_node(NODE_GENERIC_PARAM, self.token_idx(tok))
    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    if self.check(TK_COLON):
        self.consume()
        let constraint = self.parse_type_expr()
        if constraint != 0 as u32:
            self.append_child(node, constraint)
    return node

pub fn parse_func_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let fn_tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_FUNC_DECL, self.token_idx(fn_tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param_tok = self.peek()
        let param = self.tree.add_node(NODE_PARAM_DECL, self.token_idx(param_tok))
        if self.check(TK_LENT):
            self.consume()
            self.set_flags(param, FLAG_IS_LENT)
        elif self.check(TK_BANG):
            self.consume()
            self.set_flags(param, FLAG_IS_SINK)
        elif self.check(TK_MUT):
            self.consume()
            self.set_flags(param, FLAG_IS_MUT as u16)
        let param_name = self.expect(TK_IDENT)
        let param_text = self.token_text(param_name)
        let is_self = (param_text == "self")
        self.set_payload(param, self.pool.intern(param_text))
        @free(param_text as ptr[u8])
        if is_self and not self.check(TK_COLON) and self.current_struct != 0 as u32:
            // RFC 0002: untyped `self` -> synthesize the enclosing struct type, i.e. the
            // exact node `self: Struct` produces (verified to run identically since struct
            // values are by-address 8-byte pointers, BUG#30). The synthesized NODE_TYPE_EXPR
            // points its token at the STRUCT NAME token so type resolution (node_text_in_tree,
            // which reads token bytes â€” NOT payload) sees the struct name and resolves it.
            let self_ty = self.tree.add_node(NODE_TYPE_EXPR, self.current_struct_tok)
            self.set_payload(self_ty, self.current_struct)
            self.append_child(param, self_ty)
        else:
            self.expect(TK_COLON)
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(param, t)
        self.append_child(node, param)

        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()

    self.expect(TK_R_PAREN)

    if self.check(TK_ARROW):
        self.consume()
        let ret = self.parse_type_expr()
        if ret != 0 as u32:
            self.append_child(node, ret)

    self.expect(TK_COLON)
    let body = self.parse_block()
    if body != 0 as u32:
        self.append_child(node, body)

    return node

pub fn parse_interface_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_INTERFACE)
    let node = self.tree.add_node(NODE_INTERFACE_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_COLON)

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after interface declaration")
        return node
    self.consume() // consume INDENT

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let sig = self.parse_method_sig()
        if sig != 0 as u32:
            self.append_child(node, sig)
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()

    return node

pub fn parse_method_sig(mut self: ptr[Parser]) -> u32:
    mut is_async := false
    if self.check(TK_ASYNC):
        self.consume()
        is_async = true
    let tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_METHOD_SIG, self.token_idx(tok))
    if is_async:
        self.set_flags(node, FLAG_IS_ASYNC as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param = self.parse_param()
        if param != 0 as u32:
            self.append_child(node, param)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)

    if self.check_raw(TK_ARROW):
        self.consume()
        let ret = self.parse_type_expr()
        if ret != 0 as u32:
            self.append_child(node, ret)

    self.expect_newline()
    return node

// A generic struct's INLINE method mentions the struct's type params (`self: ptr[Box[T]]`,
// or `-> T`) but `parse_func_decl` gives it no generic params of its own, so it is a
// NON-generic function that mono never instantiates for `Box[i64]` -> `b.get()` calls the
// un-monomorphized template body with a wrong layout -> SIGSEGV. Give the method a CLONE of
// the struct's generic params as its FIRST child (before params, exactly where parse_func_decl
// puts them) + mark it generic, making it structurally identical to the working free-function
// form `fn get[T](self: ptr[Box[T]])`. Only when the method declares no generics of its own
// (FLAG_IS_GENERIC clear) so a method's own `[U]` is never double-bound. [[bug-generic-struct-inline-method]]
pub fn inherit_struct_generics(mut self: ptr[Parser], m: u32, struct_gp: u32):
    if struct_gp == 0 as u32 or m == 0 as u32:
        return
    if (self.tree.nodes.data[m].flags & (FLAG_IS_GENERIC as u16)) != 0 as u16:
        return
    let cloned = self.tree.clone_subtree(struct_gp)
    if cloned == 0 as u32:
        return
    self.tree.nodes.data[cloned].next_sibling = self.tree.nodes.data[m].first_child
    self.tree.nodes.data[m].first_child = cloned
    self.tree.nodes.data[m].flags = self.tree.nodes.data[m].flags | (FLAG_IS_GENERIC as u16)

pub fn parse_struct_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    mut is_packed := false
    if self.check(TK_PACKED):
        self.consume()
        is_packed = true
    let tok = self.expect(TK_STRUCT)
    let node = self.tree.add_node(NODE_STRUCT_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if is_packed:
        self.set_flags(node, 64 as u16) // FLAG_IS_PACKED is 64

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    let struct_name_id = self.pool.intern(name_text)
    self.set_payload(node, struct_name_id)
    @free(name_text as ptr[u8])

    mut struct_gp := 0 as u32
    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)
            struct_gp = gp

    self.expect(TK_COLON)

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after struct declaration")
        return node
    self.consume() // consume INDENT

    // RFC 0002: methods in this body may use untyped `self` -> the struct type.
    let prev_struct = self.current_struct
    let prev_struct_tok = self.current_struct_tok
    self.current_struct = struct_name_id
    self.current_struct_tok = self.token_idx(name_tok)

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let inner = self.peek()
        if inner.kind == TK_FN:
            let m = self.parse_func_decl(false)
            if m != 0 as u32:
                self.inherit_struct_generics(m, struct_gp)
                self.append_child(node, m)
        elif inner.kind == TK_PUB:
            self.consume()
            let next = self.peek()
            if next.kind == TK_FN:
                let m = self.parse_func_decl(true)
                if m != 0 as u32:
                    self.inherit_struct_generics(m, struct_gp)
                    self.append_child(node, m)
            else:
                let f = self.parse_field_decl(true)
                if f != 0 as u32:
                    self.append_child(node, f)
        else:
            let f = self.parse_field_decl(false)
            if f != 0 as u32:
                self.append_child(node, f)
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()
    self.current_struct = prev_struct           // RFC 0002: restore
    self.current_struct_tok = prev_struct_tok
    return node

pub fn parse_field_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    mut is_mut := false
    if self.check(TK_MUT):
        self.consume()
        is_mut = true
    let tok = self.peek()
    if tok.kind != TK_IDENT:
        self.errorf(tok, "expected field name")
        self.consume()
        return 0 as u32
    self.consume()
    let node = self.tree.add_node(NODE_FIELD_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if is_mut:
        self.set_flags(node, FLAG_IS_MUT as u16)
    let text = self.token_text(tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])
    self.expect(TK_COLON)
    let type_node = self.parse_type_expr()
    if type_node != 0 as u32:
        self.append_child(node, type_node)
    self.expect_newline()
    return node

pub fn parse_type_alias_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_TYPE)
    let node = self.tree.add_node(NODE_TYPE_ALIAS_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_EQ)

    let sum_tok = self.peek()
    let sum_node = self.tree.add_node(NODE_SUM_TYPE, self.token_idx(sum_tok))
    let v = self.parse_type_variant()
    if v != 0 as u32:
        self.append_child(sum_node, v)

    while self.check_raw(TK_PIPE):
        self.consume()
        let next_v = self.parse_type_variant()
        if next_v != 0 as u32:
            self.append_child(sum_node, next_v)

    self.append_child(node, sum_node)
    self.expect_newline()
    return node

pub fn parse_type_variant(mut self: ptr[Parser]) -> u32:
    let tok = self.peek()
    if tok.kind != TK_IDENT:
        return 0 as u32
    self.consume()
    let node = self.tree.add_node(NODE_VARIANT_DECL, self.token_idx(tok))
    let text = self.token_text(tok)
    self.set_payload(node, self.pool.intern(text))
    @free(text as ptr[u8])

    if self.check_raw(TK_L_PAREN):
        self.consume() // '('
        while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let t = self.parse_type_expr()
            if t != 0 as u32:
                self.append_child(node, t)
            if not self.check(TK_R_PAREN):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_PAREN)
    return node

// RFC 0003: `enum Name:` indent-style sugar. Desugars to the SAME AST as a sum
// type `type Name = A | B(T) | ...` (NODE_TYPE_ALIAS_DECL + NODE_SUM_TYPE +
// NODE_VARIANT_DECL), so resolver/typecheck/codegen/match see no new node kinds.
pub fn parse_enum_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_ENUM)
    let node = self.tree.add_node(NODE_TYPE_ALIAS_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_COLON)

    let sum_node = self.tree.add_node(NODE_SUM_TYPE, self.token_idx(name_tok))

    if not self.check(TK_INDENT):
        let p = self.peek()
        self.errorf(p, "expected INDENT after enum declaration")
        self.append_child(node, sum_node)
        return node
    self.consume() // consume INDENT

    while not self.check(TK_DEDENT) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let v = self.parse_type_variant()
        if v != 0 as u32:
            self.append_child(sum_node, v)
        self.expect_newline()
        if self.pos == prev_pos:
            self.consume()

    if self.check(TK_DEDENT):
        self.consume()

    self.append_child(node, sum_node)
    return node

pub fn parse_program(mut self: ptr[Parser]):
    while not self.check(TK_EOF):
        let prev_pos = self.pos
        let tok = self.peek()
        mut decl := 0 as u32
        if tok.kind == TK_HASH:
            // RFC 0009 P2: #[export] attribute on the following top-level fn.
            self.consume() // '#'
            self.expect(TK_L_BRACKET)
            let attr_tok = self.expect(TK_IDENT)
            let attr_text = self.token_text(attr_tok)
            mut is_export := false
            if attr_text == "export":
                is_export = true
            @free(attr_text as ptr[u8])
            self.expect(TK_R_BRACKET)
            let ntok = self.peek()
            if ntok.kind == TK_PUB:
                self.consume()
                if self.peek().kind == TK_FN:
                    decl = self.parse_func_decl(true)
            elif ntok.kind == TK_FN:
                decl = self.parse_func_decl(false)
            if decl != 0 as u32 and is_export:
                self.set_flags(decl, FLAG_EXPORT)
        elif tok.kind == TK_IMPORT:
            decl = self.parse_import_decl()
        elif tok.kind == TK_PUB:
            self.consume()
            let next = self.peek()
            if next.kind == TK_FN:
                decl = self.parse_func_decl(true)
            elif next.kind == TK_ASYNC:
                // RFC 0033 Â§3.1: `pub async fn`.
                self.consume() // 'async'
                if self.peek().kind == TK_FN:
                    decl = self.parse_func_decl(true)
                    if decl != 0 as u32:
                        self.set_flags(decl, FLAG_IS_ASYNC as u16)
            elif next.kind == TK_STRUCT or next.kind == TK_PACKED:
                decl = self.parse_struct_decl(true)
            elif next.kind == TK_INTERFACE:
                decl = self.parse_interface_decl(true)
            elif next.kind == TK_TYPE:
                decl = self.parse_type_alias_decl(true)
            elif next.kind == TK_ENUM:
                decl = self.parse_enum_decl(true)
            elif next.kind == TK_CONST:
                decl = self.parse_const_decl(true)
            elif next.kind == TK_EXTERN:
                decl = self.parse_extern_decl(true)
            elif next.kind == TK_LET or next.kind == TK_MUT:
                decl = self.parse_var_decl()
                self.set_flags(decl, FLAG_IS_PUB as u16)
        elif tok.kind == TK_ASYNC:
            // RFC 0033 Â§3.1: top-level `async fn` / `async pub fn`. In v1 `async` is a
            // forward-compat marker (FLAG_IS_ASYNC) with no runtime difference; the body
            // is a normal function. `pub async fn` is handled in the TK_PUB branch above.
            self.consume() // 'async'
            let anext = self.peek()
            if anext.kind == TK_PUB:
                self.consume()
                if self.peek().kind == TK_FN:
                    decl = self.parse_func_decl(true)
            elif anext.kind == TK_FN:
                decl = self.parse_func_decl(false)
            if decl != 0 as u32:
                self.set_flags(decl, FLAG_IS_ASYNC as u16)
        elif tok.kind == TK_FN:
            decl = self.parse_func_decl(false)
        elif tok.kind == TK_STRUCT or tok.kind == TK_PACKED:
            decl = self.parse_struct_decl(false)
        elif tok.kind == TK_INTERFACE:
            decl = self.parse_interface_decl(false)
        elif tok.kind == TK_TYPE:
            decl = self.parse_type_alias_decl(false)
        elif tok.kind == TK_ENUM:
            decl = self.parse_enum_decl(false)
        elif tok.kind == TK_CONST:
            decl = self.parse_const_decl(false)
        elif tok.kind == TK_EXTERN:
            decl = self.parse_extern_decl(false)
        elif tok.kind == TK_LET or tok.kind == TK_MUT:
            decl = self.parse_var_decl()
        elif tok.kind == TK_IDENT:
            // RFC 0011 P4: contextual `library <dotted.name>` marker at top level. It
            // declares the file a separately-compilable library (â†’ import-driven `.lib`).
            // No AST node â€” its only consumers are the driver's source head-scan
            // (source_is_library) and documentation; the parser just accepts + skips it.
            let ident_text = self.token_text(tok)
            mut handled := false
            if ident_text == "library":
                self.consume() // 'library'
                if self.peek().kind == TK_IDENT:
                    self.consume()
                    while self.peek().kind == TK_DOT:
                        self.consume()
                        if self.peek().kind == TK_IDENT:
                            self.consume()
                handled = true
            @free(ident_text as ptr[u8])
            if not handled:
                self.errorf(tok, "expected top level declaration")
                self.consume()
        else:
            self.errorf(tok, "expected top level declaration")
            self.consume()

        if decl != 0 as u32:
            self.append_child(0 as u32, decl)

        if self.pos == prev_pos:
            self.consume()

// RFC 0008: parse `|p0: T0, p1: T1| -> RetType body-expr` -> NODE_CLOSURE_EXPR
// with children [NODE_PARAM_DECL...] , ret-type (NODE_TYPE_EXPR) , body-expr.
// Params reuse parse_param (annotation required); the `-> RetType` is required in
// the MVP (typecheck does not infer function return types). lift_closures() later
// rewrites this node into a NODE_IDENT to a synthesized top-level function.
pub fn parse_closure_expr(mut self: ptr[Parser]) -> u32:
    let pipe_tok = self.expect(TK_PIPE)
    let node = self.tree.add_node(NODE_CLOSURE_EXPR, self.token_idx(pipe_tok))
    while not self.check(TK_PIPE) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let p = self.parse_param()
        if p != 0 as u32:
            self.append_child(node, p)
        if not self.check(TK_PIPE):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_PIPE)
    self.expect(TK_ARROW)
    let ret = self.parse_type_expr()
    if ret != 0 as u32:
        self.append_child(node, ret)
    let body = self.parse_expr_with_prec(BP_NONE)
    if body != 0 as u32:
        self.append_child(node, body)
    return node

// Intern a fresh lambda name "__lam<n>" (n = the closure's node index, unique per
// compilation). No int-to-string helper exists in stage1, so build it by hand.
fn make_lam_name(pool: ptr[InternPool], n: i64) -> u32:
    let buf = @alloc(32 as i64) as ptr[u8]
    buf[0] = 95 as u8   // '_'
    buf[1] = 95 as u8   // '_'
    buf[2] = 108 as u8  // 'l'
    buf[3] = 97 as u8   // 'a'
    buf[4] = 109 as u8  // 'm'
    mut len := 5 as i64
    let digs = @alloc(24 as i64) as ptr[u8]
    mut dn := 0 as i64
    mut v := n
    if v <= 0 as i64:
        digs[0] = 48 as u8
        dn = 1 as i64
    while v > 0 as i64:
        digs[dn] = (48 as i64 + (v % 10 as i64)) as u8
        v = v / 10 as i64
        dn = dn + 1 as i64
    mut i := 0 as i64
    while i < dn:
        buf[len] = digs[dn - 1 as i64 - i]
        len = len + 1 as i64
        i = i + 1 as i64
    let s = alloc_str_from_raw(buf, len)
    let id = pool.intern(s)
    @free(buf)
    @free(digs)
    return id

// Rewrite one NODE_CLOSURE_EXPR (at index ci) into a top-level NODE_FUNC_DECL plus
// a NODE_IDENT reference to it. Zero-capture MVP: the lambda body may only use its
// own params + globals (a captured local would fail to resolve in the lifted fn).
fn lift_one_closure(tree: ptr[AstTree], pool: ptr[InternPool], ci: u32):
    let first = tree.nodes.data[ci as i64].first_child
    if first == NULL_IDX:
        return
    // last child = body, second-to-last = ret-type node; the rest are params.
    mut prevprev := NULL_IDX
    mut prev := NULL_IDX
    mut cur := first
    while cur != NULL_IDX:
        prevprev = prev
        prev = cur
        cur = tree.nodes.data[cur as i64].next_sibling
    let body = prev
    let ret = prevprev
    if body == NULL_IDX or ret == NULL_IDX:
        return
    let name_id = make_lam_name(pool, ci as i64)
    let tok = tree.nodes.data[ci as i64].token_idx
    let fd = tree.add_node(NODE_FUNC_DECL, tok)
    let blk = tree.add_node(NODE_BLOCK, tok)
    let rst = tree.add_node(NODE_RETURN_STMT, tok)
    // return-stmt wraps the body; block wraps the return-stmt.
    tree.nodes.data[body as i64].next_sibling = NULL_IDX
    tree.nodes.data[rst as i64].first_child = body
    tree.nodes.data[rst as i64].next_sibling = NULL_IDX
    tree.nodes.data[blk as i64].first_child = rst
    tree.nodes.data[blk as i64].next_sibling = NULL_IDX
    // func-decl children = existing params->ret chain, then block replaces body.
    tree.nodes.data[fd as i64].payload = name_id
    tree.nodes.data[fd as i64].first_child = first
    tree.nodes.data[ret as i64].next_sibling = blk
    tree.nodes.data[fd as i64].next_sibling = NULL_IDX
    // append func-decl to the program root (node 0).
    mut rc := tree.nodes.data[0].first_child
    if rc == NULL_IDX:
        tree.nodes.data[0].first_child = fd
    else:
        while tree.nodes.data[rc as i64].next_sibling != NULL_IDX:
            rc = tree.nodes.data[rc as i64].next_sibling
        tree.nodes.data[rc as i64].next_sibling = fd
    // Keep the node as NODE_CLOSURE_EXPR but detach its (now-reparented) children
    // and stash the lifted function's NAME in payload. The resolver rewrites this
    // payload to the function's symbol index; air_builder lowers it to OP_FUNC_ADDR.
    // (We deliberately do NOT turn it into a NODE_IDENT: lower_ident re-derives the
    // name from the node's token text, which here is the `|` glyph, not the lambda
    // name â€” so the sanity check would reject it. A dedicated closure-ref path
    // trusts the resolved payload instead.)
    tree.nodes.data[ci as i64].payload = name_id
    tree.nodes.data[ci as i64].first_child = NULL_IDX

// BUG#73: lift_one_closure only re-parents the lambda BODY into a new
// top-level function -- it does NOT generate an env struct or rewrite
// references to outer-scope variables (RFC 0008 P2 "closures with capture"
// is still Draft/unimplemented, only P1 zero-capture lambda-lifting shipped).
// An identifier in the body that isn't one of the closure's own params
// silently resolves, post-lift, to WHATEVER same-named symbol happens to
// exist anywhere in the program (SymbolTable::resolve_global is an
// unscoped linear scan) -- typically a completely unrelated variable in a
// different function's frame, whose stale register/slot number gets
// reused as if it belonged to the lifted function. Real, reproducible
// wrong-answer bug (e.g. `|x| base + x` capturing an enclosing `base`
// silently computed `x + x`), not a crash, so nothing else in the pipeline
// ever caught it. Reject before lifting instead of miscompiling: any
// identifier in the body that is neither one of the closure's own params
// nor a known top-level global (fn/struct/interface/const/type-alias) is a
// capture attempt.
fn scan_closure_free_vars(tree: ptr[AstTree], pool: ptr[InternPool], node_idx: u32, params: U32Vec, globals: U32Vec) -> i64:
    if node_idx == NULL_IDX:
        return 0 as i64
    let node = tree.nodes.data[node_idx as i64]
    mut count := 0 as i64
    // A NODE_IDENT with payload 0 is a structural placeholder, not a variable
    // reference: e.g. the field-name child of a NODE_FIELD_EXPR (`p.y`) carries
    // the field name in the FIELD_EXPR's own payload and leaves this child's
    // payload unset. Scanning it would spuriously report "closure captures ''"
    // and reject any `param.field` / `param.method()` inside a lambda body.
    if node.kind == NODE_IDENT and node.payload != 0 as u32:
        let name_id = node.payload
        mut known := false
        mut i := 0 as i64
        while i < params.len:
            if params.data[i] == name_id:
                known = true
                break
            i = i + 1
        if not known:
            i = 0 as i64
            while i < globals.len:
                if globals.data[i] == name_id:
                    known = true
                    break
                i = i + 1
        if not known:
            let name_str = pool.get(name_id)
            ax_printf_local("error: closure captures '%s' from an enclosing scope; only zero-capture closures are currently supported (RFC 0008 P2 not yet implemented)\n", get_str_ptr(name_str) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            safe_free_str(name_str)
            count = count + 1 as i64
    mut child := node.first_child
    while child != NULL_IDX:
        count = count + scan_closure_free_vars(tree, pool, child, params, globals)
        child = tree.nodes.data[child as i64].next_sibling
    return count

fn check_closure_no_capture(tree: ptr[AstTree], pool: ptr[InternPool], ci: u32, globals: U32Vec) -> i64:
    let first = tree.nodes.data[ci as i64].first_child
    if first == NULL_IDX:
        return 0 as i64
    mut params := new_u32_vec()
    mut prev := NULL_IDX
    mut cur := first
    while cur != NULL_IDX:
        if tree.nodes.data[cur as i64].kind == NODE_PARAM_DECL:
            params.push(tree.nodes.data[cur as i64].payload)
        prev = cur
        cur = tree.nodes.data[cur as i64].next_sibling
    let body = prev
    if body == NULL_IDX:
        return 0 as i64
    return scan_closure_free_vars(tree, pool, body, params, globals)

// Lambda-lifting pass: run after parse, before name resolution. Rewrites every
// NODE_CLOSURE_EXPR into a top-level function + reference. Reuses fn-ptr lowering.
pub fn lift_closures(tree: ptr[AstTree], pool: ptr[InternPool]) -> i64:
    let orig_len = tree.nodes.len
    mut globals := new_u32_vec()
    mut gc := tree.nodes.data[0].first_child
    while gc != NULL_IDX:
        let gcn = tree.nodes.data[gc as i64]
        if gcn.kind == NODE_FUNC_DECL or gcn.kind == NODE_STRUCT_DECL or gcn.kind == NODE_INTERFACE_DECL or gcn.kind == NODE_CONST_DECL or gcn.kind == NODE_TYPE_ALIAS_DECL:
            globals.push(gcn.payload)
        gc = gcn.next_sibling

    // Variant constructors are globals too, not captures: the builtin
    // Some/None/Ok/Err plus every user-defined sum variant (NODE_VARIANT_DECL,
    // wherever it sits under a type-alias/enum decl). Without these, a closure
    // body like `|x| Some(x+1)` wrongly tripped the zero-capture check.
    globals.push(pool.intern("Some"))
    globals.push(pool.intern("None"))
    globals.push(pool.intern("Ok"))
    globals.push(pool.intern("Err"))
    mut vscan := 1 as i64
    while vscan < orig_len:
        if tree.nodes.data[vscan].kind == NODE_VARIANT_DECL:
            globals.push(tree.nodes.data[vscan].payload)
        vscan = vscan + 1 as i64

    mut errors := 0 as i64
    mut ci := 1 as i64
    while ci < orig_len:
        if tree.nodes.data[ci].kind == NODE_CLOSURE_EXPR:
            errors = errors + check_closure_no_capture(tree, pool, ci as u32, globals)
            lift_one_closure(tree, pool, ci as u32)
        ci = ci + 1 as i64
    return errors

pub fn parse_param(mut self: ptr[Parser]) -> u32:
    let param_tok = self.peek()
    let param = self.tree.add_node(NODE_PARAM_DECL, self.token_idx(param_tok))
    if self.check(TK_LENT):
        self.consume()
        self.set_flags(param, FLAG_IS_LENT)
    elif self.check(TK_BANG):
        self.consume()
        self.set_flags(param, FLAG_IS_SINK)
    elif self.check(TK_MUT):
        self.consume()
        self.set_flags(param, FLAG_IS_MUT as u16)
    let param_name = self.expect(TK_IDENT)
    let param_text = self.token_text(param_name)
    self.set_payload(param, self.pool.intern(param_text))
    @free(param_text as ptr[u8])
    self.expect(TK_COLON)
    let t = self.parse_type_expr()
    if t != 0 as u32:
        self.append_child(param, t)
    return param

pub fn parse_const_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    let tok = self.expect(TK_CONST)
    let node = self.tree.add_node(NODE_CONST_DECL, self.token_idx(tok))
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    self.expect(TK_COLON)
    let type_node = self.parse_type_expr()
    if type_node != 0 as u32:
        self.append_child(node, type_node)

    self.expect(TK_EQ)
    let expr = self.parse_expr_with_prec(BP_NONE)
    if expr != 0 as u32:
        self.append_child(node, expr)
    self.expect_newline()
    return node

pub fn parse_extern_decl(mut self: ptr[Parser], is_pub: bool) -> u32:
    self.expect(TK_EXTERN)
    
    // Expect ABI string literal, e.g. "C"
    self.expect(TK_STRING_LIT)

    // RFC 0009: optional `from "lib.dll"` DLL binding. `from` lexes as TK_IDENT
    // (contextual keyword). String-lit token includes both surrounding quotes.
    mut dll_name_id := 0 as u32
    let peeked = self.peek()
    if peeked.kind == TK_IDENT:
        let ptext = self.token_text(peeked)
        if ptext == "from":
            self.consume() // consume 'from'
            let dll_tok = self.expect(TK_STRING_LIT)
            let raw = self.token_text(dll_tok)
            let raw_len = std.string.len(raw)
            if raw_len >= 2:
                let inner_ptr = ((raw as ptr[u8]) as i64 + 1) as ptr[u8]
                let inner = alloc_str_from_raw(inner_ptr, raw_len - 2)
                dll_name_id = self.pool.intern(inner)
                @free(inner as ptr[u8])
            @free(raw as ptr[u8])
        @free(ptext as ptr[u8])

    let fn_tok = self.expect(TK_FN)
    let node = self.tree.add_node(NODE_FUNC_DECL, self.token_idx(fn_tok))
    self.set_flags(node, FLAG_IS_EXTERN as u16)
    if is_pub:
        self.set_flags(node, FLAG_IS_PUB as u16)
    if dll_name_id != 0 as u32:
        self.tree.nodes.data[node].extra_idx = dll_name_id
        self.set_flags(node, FLAG_FROM_DLL)

    let name_tok = self.expect(TK_IDENT)
    let name_text = self.token_text(name_tok)
    self.set_payload(node, self.pool.intern(name_text))
    @free(name_text as ptr[u8])

    if self.check(TK_L_BRACKET):
        self.set_flags(node, FLAG_IS_GENERIC as u16)
        let gp = self.parse_generic_params()
        if gp != 0 as u32:
            self.append_child(node, gp)

    self.expect(TK_L_PAREN)
    while not self.check(TK_R_PAREN) and not self.check(TK_EOF):
        let prev_pos = self.pos
        let param = self.parse_param()
        if param != 0 as u32:
            self.append_child(node, param)
        if not self.check(TK_R_PAREN):
            self.expect(TK_COMMA)
        if self.pos == prev_pos:
            self.consume()
    self.expect(TK_R_PAREN)

    if self.check_raw(TK_ARROW):
        self.consume()
        let ret_type = self.parse_type_expr()
        if ret_type != 0 as u32:
            self.append_child(node, ret_type)
    
    self.expect_newline()
    return node

pub fn parse_import_decl(mut self: ptr[Parser]) -> u32:
    let tok = self.expect(TK_IMPORT)
    let node = self.tree.add_node(NODE_IMPORT_DECL, self.token_idx(tok))

    let path_tok = self.expect(TK_IDENT)
    let path_text = self.token_text(path_tok)
    mut path_id := self.pool.intern(path_text)
    @free(path_text as ptr[u8])

    while self.check_raw(TK_DOT):
        self.consume()
        let seg_tok = self.expect(TK_IDENT)
        let seg_text = self.token_text(seg_tok)
        let base_str = self.pool.get(path_id)
        
        // Concatenate path segments with '.'
        let len_base = std.string.len(base_str)
        let len_seg = std.string.len(seg_text)
        let total_len = len_base + 1 + len_seg
        mut new_buf := @alloc(total_len + 1) as ptr[u8]
        @memcpy(new_buf, base_str as ptr[u8], len_base)
        new_buf[len_base] = '.' as u8
        @memcpy(((new_buf as i64) + len_base + 1 as i64) as ptr[u8], seg_text as ptr[u8], len_seg)
        new_buf[total_len] = 0 as u8
        
        path_id = self.pool.intern(new_buf as str)
        @free(new_buf)
        @free(seg_text as ptr[u8])

    self.set_payload(node, path_id)

    if self.check_raw(TK_L_BRACE):
        self.consume()
        while not self.check(TK_R_BRACE) and not self.check(TK_EOF):
            let prev_pos = self.pos
            let name_tok = self.expect(TK_IDENT)
            let name_text = self.token_text(name_tok)
            let name_node = self.tree.add_node(NODE_IDENT, self.token_idx(name_tok))
            self.set_payload(name_node, self.pool.intern(name_text))
            @free(name_text as ptr[u8])
            self.append_child(node, name_node)

            if not self.check(TK_R_BRACE):
                self.expect(TK_COMMA)
            if self.pos == prev_pos:
                self.consume()
        self.expect(TK_R_BRACE)

    self.expect_newline()
    return node

// bootstrap/stage1/resolver.ax
// Name resolution pass and Symbol Table implementation for self-hosted compiler.


extern "C" fn fflush(stream: ptr[void]) -> i32

// SymKind constants
pub const SYM_VAR: u8 = 0
pub const SYM_FUNC: u8 = 1
pub const SYM_STRUCT: u8 = 2
pub const SYM_INTERFACE: u8 = 3
pub const SYM_TYPE_ALIAS: u8 = 4
pub const SYM_VARIANT: u8 = 5
pub const SYM_PARAM: u8 = 6
pub const SYM_FIELD: u8 = 7
pub const SYM_GENERIC_PARAM: u8 = 8
pub const SYM_MODULE: u8 = 9
pub const SYM_BUILTIN_TYPE: u8 = 10
pub const SYM_ENUM_VARIANT: u8 = 11
pub const SYM_CONST: u8 = 12

// Module loading status constants
pub const MODULE_UNLOADED: u8 = 0
pub const MODULE_LOADING: u8 = 1
pub const MODULE_LOADED: u8 = 2

// SymFlags constants
pub const SYM_FLAG_PUB: u16 = 1
pub const SYM_FLAG_MUT: u16 = 2
pub const SYM_FLAG_EXTERN: u16 = 4
pub const SYM_FLAG_SINK: u16 = 8
pub const SYM_FLAG_LENT: u16 = 16
pub const SYM_FLAG_ASYNC: u16 = 32
pub const SYM_FLAG_PURE: u16 = 64
pub const SYM_FLAG_MOVED: u16 = 128
pub const SYM_FLAG_USED: u16 = 256
pub const SYM_FLAG_COMPTIME: u16 = 512
pub const SYM_FLAG_GENERIC: u16 = 1024
// BUG#50: same-named fn from a DIFFERENT module tree chained as overload;
// manglers must emit a distinct symbol name ("__m<sym_idx>" suffix).
pub const SYM_FLAG_MODDUP: u16 = 2048
// RFC 0015 P2: set by EscapeAnalyser on a local symbol that escapes its function
// (returned, passed to a call, or stored into a longer-lived aggregate). Kept in
// the SYM-flag space at 4096 to avoid the historical 128 collision with
// SYM_FLAG_MOVED (which ownership.ax reads -> would re-trigger the E4001 flood).
// Consumed by CTGC (RFC 0015 P3) to decide which locals are safe to free; no
// consumer is wired yet, so setting it is behaviourally inert (fixpoint A==B).
pub const SYM_FLAG_ESCAPES: u16 = 4096
// RFC 0035 P2: this symbol's `name_id` is ALREADY the module-qualified emitted base
// (`libpa_helper`), so the mangler must emit `ax_<name_id>` verbatim and apply no further
// decoration. Set on the body-less symbols registered from a `.lib` interface
// (`register_module_from_lib`), which is how an importing compilation computes the same
// name the library emitted for itself â€” from the module name in the import, with no shared
// table and no table index. The early return also keeps a library function whose first
// parameter is a struct from picking up the `ax_<Struct>_<fn>` method decoration on the
// importing side only, which would silently disagree with the definition.
pub const SYM_FLAG_MODQUAL: u16 = 8192

// ScopeKind constants
pub const SCOPE_GLOBAL: u8 = 0
pub const SCOPE_FUNCTION: u8 = 1
pub const SCOPE_BLOCK: u8 = 2
pub const SCOPE_CLOSURE: u8 = 3
pub const SCOPE_LOOP: u8 = 4

// Flat Symbol Representation
pub struct Symbol:
    name_id: u32
    kind: u8
    padding: u8
    flags: u16
    type_id: u32
    decl_node: u32
    scope_id: u32
    next_overload: u32

// Scope Entry for hash table
pub struct ScopeEntry:
    name_id: u32
    symbol_idx: u32

// Scope representation using open addressing hash map
pub struct Scope:
    kind: u8
    padding1: u8
    padding2: u16
    parent_id: u32
    depth: u32
    entries: ptr[ScopeEntry]
    count: u32
    capacity: u32

pub fn init_scope(mut self: ptr[Scope], kind: u8, parent_id: u32, depth: u32, capacity: u32):
    self.kind = kind
    self.parent_id = parent_id
    self.depth = depth
    self.capacity = capacity
    self.count = 0 as u32
    self.entries = @alloc(capacity as i64 * 8) as ptr[ScopeEntry] // ScopeEntry is 8 bytes
    // Zero initialize
    mut i := 0 as i64
    while i < capacity as i64:
        self.entries[i] = ScopeEntry(name_id: 0 as u32, symbol_idx: 0 as u32)
        i = i + 1

fn hash_fnv1a(v: u32) -> u32:
    mut hash := 2166136261 as u32
    hash = hash ^ (v & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 8 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 16 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 24 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    return hash

pub fn scope_put(mut self: ptr[Scope], name_id: u32, symbol_idx: u32):
    if self.count * 4 as u32 > self.capacity * 3 as u32:
        self.scope_grow()
    let is_new = self.scope_insert(name_id, symbol_idx)
    if is_new:
        self.count = self.count + 1 as u32

fn scope_insert(self: ptr[Scope], name_id: u32, symbol_idx: u32) -> bool:
    let mask = self.capacity - 1 as u32
    mut idx = hash_fnv1a(name_id) & mask
    while true:
        if self.entries[idx].name_id == name_id:
            self.entries[idx].symbol_idx = symbol_idx
            return false
        if self.entries[idx].name_id == 0 as u32:
            self.entries[idx].name_id = name_id
            self.entries[idx].symbol_idx = symbol_idx
            return true
        idx = (idx + 1 as u32) & mask

pub fn scope_get(self: ptr[Scope], name_id: u32) -> ScopeEntry:
    if self.capacity == 0 as u32:
        return ScopeEntry(name_id: 0 as u32, symbol_idx: 0 as u32)
    let mask = self.capacity - 1 as u32
    mut idx = hash_fnv1a(name_id) & mask
    let start_idx = idx
    while true:
        let entry = self.entries[idx]
        if entry.name_id == 0 as u32:
            return ScopeEntry(name_id: 0 as u32, symbol_idx: 0 as u32)
        if entry.name_id == name_id:
            return entry
        idx = (idx + 1 as u32) & mask
        if idx == start_idx:
            break
    return ScopeEntry(name_id: 0 as u32, symbol_idx: 0 as u32)

fn scope_grow(mut self: ptr[Scope]):
    let old_entries = self.entries
    let old_capacity = self.capacity
    let new_cap = old_capacity * 2 as u32
    self.capacity = new_cap
    self.entries = @alloc(new_cap as i64 * 8) as ptr[ScopeEntry]
    mut i := 0 as i64
    while i < new_cap as i64:
        self.entries[i] = ScopeEntry(name_id: 0 as u32, symbol_idx: 0 as u32)
        i = i + 1

    i = 0 as i64
    while i < old_capacity as i64:
        let entry = old_entries[i]
        if entry.name_id != 0 as u32:
            self.scope_insert(entry.name_id, entry.symbol_idx)
        i = i + 1
    @free(old_entries as ptr[u8])

// Monomorphic vectors for symbol table
pub struct SymbolVec:
    data: ptr[Symbol]
    len: i64
    cap: i64

pub fn new_symbol_vec() -> SymbolVec:
    return SymbolVec(data: null as ptr[Symbol], len: 0, cap: 0)

pub fn push(mut self: ptr[SymbolVec], sym: Symbol) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        // Stride comes from size_of(Symbol), NOT a literal. It was `24` in both places
        // with a "Symbol is 24 bytes" comment â€” a magic number that silently becomes
        // wrong the moment a field is added to Symbol, under-allocating this buffer and
        // corrupting the heap on the very next push. This repo has already paid for that
        // pattern once, in the allocator, where the segment slab size was spelled 196608
        // in three places and the real cap in a fourth. Same fix: derive it.
        // (Surfaced while prototyping an extra Symbol field for RFC 0035 P2. That
        // particular field was reverted â€” see the RFC â€” but the footgun is real for any
        // future field, so the derivation stays.)
        let sym_size = @compiler_intrinsic("size_of")[Symbol]() as i64
        let new_data = @alloc(new_cap * sym_size) as ptr[Symbol]
        if self.data != null as ptr[Symbol]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * sym_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = sym
    self.len = self.len + 1
    return idx

pub struct ScopeVec:
    data: ptr[Scope]
    len: i64
    cap: i64

pub fn new_scope_vec() -> ScopeVec:
    return ScopeVec(data: null as ptr[Scope], len: 0, cap: 0)

pub fn push(mut self: ptr[ScopeVec], scope: Scope) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 32) as ptr[Scope] // Scope is 32 bytes
        if self.data != null as ptr[Scope]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 32)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = scope
    self.len = self.len + 1
    return idx

pub struct U32Vec:
    pub data: ptr[u32]
    pub len: i64
    pub cap: i64

pub fn new_u32_vec() -> U32Vec:
    return U32Vec(data: null as ptr[u32], len: 0, cap: 0)

pub fn push(mut self: ptr[U32Vec], val: u32) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 4) as ptr[u32] // u32 is 4 bytes
        if self.data != null as ptr[u32]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 4)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub fn pop(mut self: ptr[U32Vec]) -> u32:
    if self.len == 0:
        return 0 as u32
    self.len = self.len - 1
    return self.data[self.len]

pub fn append_unique(mut self: ptr[U32Vec], val: u32) -> u32:
    mut i := 0 as i64
    while i < self.len:
        if self.data[i] == val:
            return i as u32
        i = i + 1
    return self.push(val)

pub fn sort(mut self: ptr[U32Vec]):
    if self.len <= 1:
        return
    mut gap := self.len / 2
    while gap > 0:
        mut i := gap
        while i < self.len:
            let temp = self.data[i]
            mut j := i
            while j >= gap:
                if self.data[j - gap] > temp:
                    self.data[j] = self.data[j - gap]
                    j = j - gap
                else:
                    break
            self.data[j] = temp
            i = i + 1
        gap = gap / 2


pub fn deduplicate(mut self: ptr[U32Vec]):
    if self.len <= 1:
        return
    mut write_idx := 1 as i64
    mut read_idx := 1 as i64
    while read_idx < self.len:
        if self.data[read_idx] != self.data[write_idx - 1]:
            self.data[write_idx] = self.data[read_idx]
            write_idx = write_idx + 1
        read_idx = read_idx + 1
    self.len = write_idx


pub struct ModuleExport:
    name_id: u32
    symbol_idx: u32

pub struct ModuleExportVec:
    pub data: ptr[ModuleExport]
    pub len: i64
    pub cap: i64

pub fn new_module_export_vec() -> ModuleExportVec:
    return ModuleExportVec(data: null as ptr[ModuleExport], len: 0, cap: 0)

pub fn push(mut self: ptr[ModuleExportVec], val: ModuleExport) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[ModuleExport] // ModuleExport is 8 bytes
        if self.data != null as ptr[ModuleExport]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub struct ModuleInfo:
    name_id: u32
    status: u8
    padding1: u8
    padding2: u16
    exports: ModuleExportVec
    ast_tree: ptr[AstTree]
    file_path: str
    node_types: ptr[void]
    src_buffer: ptr[void]
    tokens_data: ptr[void]
    src_leak: str
    tokens_leak: TokenVec

pub struct ModuleInfoPtrVec:
    pub data: ptr[ptr[ModuleInfo]]
    pub len: i64
    pub cap: i64

pub fn new_module_info_ptr_vec() -> ModuleInfoPtrVec:
    return ModuleInfoPtrVec(data: null as ptr[ptr[ModuleInfo]], len: 0, cap: 0)

pub fn push(mut self: ptr[ModuleInfoPtrVec], val: ptr[ModuleInfo]) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[ptr[ModuleInfo]] // pointer is 8 bytes
        if self.data != null as ptr[ptr[ModuleInfo]]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub struct LazyResolver:
    modules: ModuleInfoPtrVec
    symtable: ptr[SymbolTable]
    typetable: ptr[void]
    intern: ptr[void]
    // RFC 0011 P4 inc3c: when true, `import x` resolves against a precompiled `x.lib`
    // (register from its interface, link the archive) instead of the module source.
    // Opt-in (`--auto-lib`) â€” see main_air ensure_import_libs; default keeps source path.
    pub auto_lib: bool

pub fn new_lazy_resolver(symtable: ptr[SymbolTable], intern: ptr[void]) -> ptr[LazyResolver]:
    let lr = @alloc(@compiler_intrinsic("size_of")[LazyResolver]()) as ptr[LazyResolver]
    lr.modules = new_module_info_ptr_vec()
    lr.symtable = symtable
    lr.typetable = null as ptr[void]
    lr.intern = intern
    lr.auto_lib = false
    return lr

pub struct AstTreePtrVec:
    pub data: ptr[ptr[AstTree]]
    pub len: i64
    pub cap: i64

pub fn new_ast_tree_ptr_vec() -> AstTreePtrVec:
    return AstTreePtrVec(data: null as ptr[ptr[AstTree]], len: 0, cap: 0)

pub fn push(mut self: ptr[AstTreePtrVec], val: ptr[AstTree]) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[ptr[AstTree]]
        if self.data != null as ptr[ptr[AstTree]]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub struct SymbolTable:
    symbols: SymbolVec
    scopes: ScopeVec
    stack: U32Vec
    lazy_resolver: ptr[void]
    pub current_tree: ptr[AstTree]
    pub symbol_trees: AstTreePtrVec
    pub intern: ptr[void]
    // RFC 0009: FFI dynamic-linking. Parallel arrays: extern fn name_id -> dll name_id.
    pub dll_bind_syms: U32Vec
    pub dll_bind_dlls: U32Vec
    // RFC 0009 P2: name_ids of #[export] functions (for PE export table).
    pub export_syms: U32Vec
    // RFC 0035 P2: the canonical name of the COMPILATION UNIT, when that unit is being
    // built as a library (`--staticlib`); empty for an ordinary program build. It is the
    // qualifier `x86_resolve_sym_name` prepends to the unit's OWN public functions, so two
    // libraries that both define `helper` emit distinct symbols. Deliberately a property of
    // the unit and not of each symbol: AXIOM's native path has no module nesting at compile
    // time (each `axc build` is ONE flat unit), which is why the earlier per-symbol
    // `module_id` + resolution cursor was always zero and had to be reverted.
    pub unit_qualifier: str

pub fn new_symbol_table(mut intern: ptr[InternPool]) -> ptr[SymbolTable]:
    let st = @alloc(@compiler_intrinsic("size_of")[SymbolTable]()) as ptr[SymbolTable]
    st.symbols = new_symbol_vec()
    st.scopes = new_scope_vec()
    st.stack = new_u32_vec()
    st.lazy_resolver = null as ptr[void]
    st.current_tree = null as ptr[AstTree]
    st.symbol_trees = new_ast_tree_ptr_vec()
    st.intern = intern as ptr[void]
    st.dll_bind_syms = new_u32_vec()
    st.dll_bind_dlls = new_u32_vec()
    st.export_syms = new_u32_vec()
    st.unit_qualifier = ""  // RFC 0035 P2: set by the driver only for --staticlib builds

    // Prepopulate global scope
    mut global_scope := Scope(kind: SCOPE_GLOBAL, padding1: 0 as u8, padding2: 0 as u16, parent_id: 0 as u32, depth: 0 as u32, entries: null as ptr[ScopeEntry], count: 0, capacity: 0)
    let p_global = &global_scope
    p_global.init_scope(SCOPE_GLOBAL, 0 as u32, 0 as u32, 64 as u32)
    st.scopes.push(global_scope)
    st.stack.push(0 as u32)

    // Define builtins
    st.define_builtin("i8", 1, intern)
    st.define_builtin("i16", 2, intern)
    st.define_builtin("i32", 3, intern)
    st.define_builtin("i64", 4, intern)
    st.define_builtin("u8", 5, intern)
    st.define_builtin("u16", 6, intern)
    st.define_builtin("u32", 7, intern)
    st.define_builtin("rune", 7, intern) // RFC 0020: Unicode scalar value (alias of u32)
    st.define_builtin("u64", 8, intern)
    st.define_builtin("f32", 9, intern)
    st.define_builtin("f64", 10, intern)
    st.define_builtin("bool", 11, intern)
    st.define_builtin("string", 12, intern)
    st.define_builtin("char8", 13, intern)
    st.define_builtin("void", 14, intern)
    st.define_builtin("isize", 15, intern)
    st.define_builtin("usize", 16, intern)
    st.define_builtin("ActorRef", 21, intern)
    st.define_builtin("str", 12, intern)
    st.define_builtin("bytes", 22, intern) // RFC 0020: raw byte buffer (distinct from str)
    st.define_builtin("ptr", 0, intern)
    st.define_builtin("null", 0, intern)
    st.define_builtin("alloc", 0, intern)
    st.define_builtin("free", 0, intern)
    st.define_builtin("memcpy", 0, intern)
    st.define_builtin("memset", 0, intern)
    st.define_builtin("print", 0, intern)
    st.define_builtin("println", 0, intern)
    st.define_builtin("compiler_intrinsic", 0, intern)
    st.define_builtin("assert", 0, intern)
    st.define_builtin("panic", 0, intern)
    st.define_builtin("syscall0", 0, intern)
    st.define_builtin("syscall1", 0, intern)
    st.define_builtin("syscall2", 0, intern)
    st.define_builtin("syscall3", 0, intern)
    st.define_builtin("syscall4", 0, intern)
    st.define_builtin("syscall5", 0, intern)
    st.define_builtin("syscall6", 0, intern)
    st.define_builtin("Result", 0, intern)
    st.define_builtin("Option", 0, intern)
    st.define_builtin("Vec", 0, intern)

    return st

pub fn define_builtin(mut self: ptr[SymbolTable], name: str, type_id: u32, mut intern: ptr[InternPool]):
    let name_id = intern.intern_string(name)
    let sym_idx = self.symbols.len as u32
    (&self.symbols).push(Symbol(
        name_id: name_id,
        kind: SYM_BUILTIN_TYPE,
        padding: 0 as u8,
        flags: SYM_FLAG_PUB,
        type_id: type_id,
        decl_node: 0 as u32,
        scope_id: 0 as u32,
        next_overload: 0 as u32,
    ))
    (&self.symbol_trees).push(null as ptr[AstTree])
    let scope = &self.scopes.data[0]
    scope.scope_put(name_id, sym_idx)

pub fn push_scope(mut self: ptr[SymbolTable], kind: u8) -> u32:
    let parent_id = self.current_scope()
    let depth = self.current_depth() + 1 as u32
    mut new_scope := Scope(kind: kind, padding1: 0 as u8, padding2: 0 as u16, parent_id: parent_id, depth: depth, entries: null as ptr[ScopeEntry], count: 0, capacity: 0)
    (&new_scope).init_scope(kind, parent_id, depth, 16 as u32)
    let idx = (&self.scopes).push(new_scope)
    (&self.stack).push(idx)
    return idx

pub fn pop_scope(mut self: ptr[SymbolTable]):
    (&self.stack).pop()

pub fn current_scope(self: ptr[SymbolTable]) -> u32:
    return self.stack.data[self.stack.len - 1]

pub fn current_depth(self: ptr[SymbolTable]) -> u32:
    return (self.stack.len - 1) as u32

pub fn define(mut self: ptr[SymbolTable], name_id: u32, kind: u8, flags: u16, decl_node: u32) -> u32:
    let scope_idx = self.current_scope()
    // Check duplicate in current scope
    let scope = &self.scopes.data[scope_idx]
    let prev = scope.scope_get(name_id)
    if prev.name_id != 0 as u32:
        if self.symbols.data[prev.symbol_idx].kind == SYM_BUILTIN_TYPE:
            let sym_idx = self.symbols.len as u32
            (&self.symbols).push(Symbol(
                name_id: name_id,
                kind: kind,
                padding: 0 as u8,
                flags: flags,
                type_id: 0 as u32,
                decl_node: decl_node,
                scope_id: scope_idx,
                next_overload: 0 as u32,
            ))
            (&self.symbol_trees).push(self.current_tree)
            let scope3 = &self.scopes.data[scope_idx]
            scope3.scope_put(name_id, sym_idx)
            
            // Prelude support
            let pool = self.intern as ptr[InternPool]
            let name_str = pool.get(name_id)
            if name_str == "Result" or name_str == "Option" or name_str == "Vec" or name_str == "Ok" or name_str == "Err" or name_str == "Some" or name_str == "None":
                let global_scope = &self.scopes.data[0]
                global_scope.scope_put(name_id, sym_idx)
            safe_free_str(name_str)
            
            return sym_idx
        // printf("  [COLLISION] prev.name_id=%d, prev.symbol_idx=%d\n", prev.name_id as i64, prev.symbol_idx as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        // Support function overloading
        if self.symbols.data[prev.symbol_idx].kind == SYM_FUNC and kind == SYM_FUNC:
            mut curr_idx := prev.symbol_idx
            while true:
                // BUG#50: decl_node is a node INDEX local to each module's AST.
                // Two modules with same-shaped trees (e.g. both define `close`)
                // get equal indices, so dedup MUST also match the owning tree,
                // else module B's fn aliases module A's symbol ("first import wins").
                if self.symbols.data[curr_idx].decl_node == decl_node and self.symbol_trees.data[curr_idx] == self.current_tree:
                    return curr_idx
                if self.symbols.data[curr_idx].next_overload == 0 as u32:
                    break
                curr_idx = self.symbols.data[curr_idx].next_overload
            let sym_idx = self.symbols.len as u32
            // BUG#50: if the chain head lives in another module's tree, this is a
            // cross-module same-name fn, not a real overload set member of that
            // module. Tag it so codegen emits a unique symbol name.
            mut dup_flags := flags
            if self.symbol_trees.data[prev.symbol_idx] != self.current_tree:
                dup_flags = dup_flags | SYM_FLAG_MODDUP
            (&self.symbols).push(Symbol(
                name_id: name_id,
                kind: kind,
                padding: 0 as u8,
                flags: dup_flags,
                type_id: 0 as u32,
                decl_node: decl_node,
                scope_id: scope_idx,
                next_overload: 0 as u32,
            ))
            (&self.symbol_trees).push(self.current_tree)
            self.symbols.data[curr_idx].next_overload = sym_idx
            return sym_idx
        return prev.symbol_idx // Already defined, return previous
    let sym_idx = self.symbols.len as u32
    (&self.symbols).push(Symbol(
        name_id: name_id,
        kind: kind,
        padding: 0 as u8,
        flags: flags,
        type_id: 0 as u32,
        decl_node: decl_node,
        scope_id: scope_idx,
        next_overload: 0 as u32,
    ))
    (&self.symbol_trees).push(self.current_tree)
    let scope2 = &self.scopes.data[scope_idx]
    scope2.scope_put(name_id, sym_idx)

    // Prelude support
    let pool = self.intern as ptr[InternPool]
    let name_str = pool.get(name_id)
    if name_str == "Result" or name_str == "Option" or name_str == "Vec" or name_str == "Ok" or name_str == "Err" or name_str == "Some" or name_str == "None":
        let global_scope = &self.scopes.data[0]
        global_scope.scope_put(name_id, sym_idx)
    safe_free_str(name_str)
    
    return sym_idx

pub fn resolve(self: ptr[SymbolTable], name_id: u32) -> u32:
    mut i := self.stack.len - 1
    while i >= 0:
        let scope_idx = self.stack.data[i]
        let scope = &self.scopes.data[scope_idx]
        let entry = scope.scope_get(name_id)
        if entry.name_id != 0 as u32:
            return entry.symbol_idx
        i = i - 1
    return 0 as u32

pub fn resolve_type(self: ptr[SymbolTable], name_id: u32) -> u32:
    mut i := self.stack.len - 1
    while i >= 0:
        let scope_idx = self.stack.data[i]
        let scope = &self.scopes.data[scope_idx]
        let entry = scope.scope_get(name_id)
        if entry.name_id != 0 as u32:
            let sym_idx = entry.symbol_idx
            let sym = self.symbols.data[sym_idx]
            if sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE:
                return sym_idx
        i = i - 1
    return 0 as u32

pub fn resolve_global(self: ptr[SymbolTable], name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.symbols.len:
        let sym = self.symbols.data[i]
        if sym.name_id == name_id:
            return i as u32
        i = i + 1
    return 0 as u32

pub fn resolve_global_fallback(self: ptr[SymbolTable], name_id: u32) -> u32:
    mut sym_idx := self.resolve_global(name_id)
    if sym_idx != 0 as u32:
        return sym_idx
        
    let pool = self.intern as ptr[InternPool]
    let name_str = pool.get(name_id)
    let suffix = std.string.concat(".", name_str)
    
    let global_scope = &self.scopes.data[0]
    mut idx := 0 as i64
    while idx < global_scope.capacity as i64:
        let entry = global_scope.entries[idx]
        if entry.name_id != 0 as u32:
            let entry_name = pool.get(entry.name_id)
            if std.string.ends_with(entry_name, suffix):
                sym_idx = entry.symbol_idx
                safe_free_str(entry_name)
                break
            safe_free_str(entry_name)
        idx = idx + 1 as i64
        
    safe_free_str(name_str)
    safe_free_str(suffix)
    return sym_idx


pub struct NameResolver:
    tree: ptr[AstTree]
    intern: ptr[InternPool]
    symtable: ptr[SymbolTable]
    lazy: ptr[LazyResolver]

pub fn new_name_resolver(tree: ptr[AstTree], intern: ptr[InternPool], symtable: ptr[SymbolTable]) -> ptr[NameResolver]:
    let nr = @alloc(@compiler_intrinsic("size_of")[NameResolver]()) as ptr[NameResolver]
    nr.tree = tree
    nr.intern = intern
    nr.symtable = symtable
    nr.lazy = symtable.lazy_resolver as ptr[LazyResolver]
    symtable.current_tree = tree
    return nr

pub fn pre_define_top_levels(mut self: ptr[NameResolver]):
    if self.tree.nodes.len == 0:
        return
    let root = &self.tree.nodes.data[0]
    mut child := root.first_child
    while child != 0 as u32:
        let child_node = &self.tree.nodes.data[child]
        let kind = child_node.kind
        let flags = child_node.flags
        if kind == NODE_FUNC_DECL:
            let name_id = child_node.payload
            mut sym_flags := 0 as u16
            if (flags & FLAG_IS_PUB) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_PUB
            if (flags & FLAG_IS_EXTERN) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_EXTERN
            if (flags & FLAG_IS_ASYNC) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_ASYNC
            if (flags & FLAG_IS_GENERIC) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_GENERIC
            self.symtable.define(name_id, SYM_FUNC, sym_flags, child)
            // RFC 0009: record extern "C" from "x.dll" bindings (dll_name_id in extra_idx)
            if (flags & FLAG_FROM_DLL) != 0 as u16:
                self.symtable.dll_bind_syms.push(name_id)
                self.symtable.dll_bind_dlls.push(child_node.extra_idx)
            // RFC 0009 P2: record #[export] functions for the PE export table
            if (flags & FLAG_EXPORT) != 0 as u16:
                self.symtable.export_syms.push(name_id)
        elif kind == NODE_STRUCT_DECL:
            let name_id = child_node.payload
            mut sym_flags := 0 as u16
            if (flags & FLAG_IS_PUB) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_PUB
            if (flags & FLAG_IS_GENERIC) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_GENERIC
            self.symtable.define(name_id, SYM_STRUCT, sym_flags, child)
        elif kind == NODE_INTERFACE_DECL:
            let name_id = child_node.payload
            mut sym_flags := 0 as u16
            if (flags & FLAG_IS_PUB) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_PUB
            self.symtable.define(name_id, SYM_INTERFACE, sym_flags, child)
        elif kind == NODE_CONST_DECL:
            let name_id = child_node.payload
            mut sym_flags := 0 as u16
            if (flags & FLAG_IS_PUB) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_PUB
            self.symtable.define(name_id, SYM_CONST, sym_flags, child)
        elif kind == NODE_TYPE_ALIAS_DECL:
            let name_id = child_node.payload
            mut sym_flags := 0 as u16
            if (flags & FLAG_IS_PUB) != 0 as u16:
                sym_flags = sym_flags | SYM_FLAG_PUB
            self.symtable.define(name_id, SYM_TYPE_ALIAS, sym_flags, child)
        child = child_node.next_sibling

pub fn resolve(mut self: ptr[NameResolver]):
    if self.tree.nodes.len == 0:
        return
    self.symtable.current_tree = self.tree
    self.pre_define_top_levels()
    self.resolve_node(0 as u32)

pub fn resolve_children(mut self: ptr[NameResolver], node_idx: u32):
    let node = self.tree.nodes.data[node_idx]
    mut child := node.first_child
    while child != 0 as u32:
        let next_sibling = self.tree.nodes.data[child].next_sibling
        self.resolve_node(child)
        child = next_sibling

pub fn resolve_node(mut self: ptr[NameResolver], node_idx: u32):
    let kind = self.tree.nodes.data[node_idx].kind
    let flags = self.tree.nodes.data[node_idx].flags
    let first_child = self.tree.nodes.data[node_idx].first_child
    let next_sibling = self.tree.nodes.data[node_idx].next_sibling
    let payload = self.tree.nodes.data[node_idx].payload


    if kind == NODE_PROGRAM:
        self.resolve_children(node_idx)

    elif kind == NODE_IMPORT_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        mut sym_idx := 0 as u32
        
        if self.lazy != null as ptr[LazyResolver]:
            let mod_name = self.intern.get(name_id)
            mut file_path := ""
            if std.string.starts_with(mod_name, "std."):
                let rel_path = std.string.replace(mod_name, ".", "/")
                file_path = std.string.concat(rel_path, ".ax")
                // @free(get_str_ptr(rel_path))
            else:
                file_path = std.string.concat(mod_name, ".ax")
            
            sym_idx = self.lazy.lazy_resolver_register_import(name_id, file_path, node_idx)
            let _ = self.lazy.lazy_resolver_preload_module(name_id)
            // @free(get_str_ptr(mod_name))
        else:
            sym_idx = self.symtable.define(name_id, SYM_MODULE, 0 as u16, node_idx)
            
            let name = self.intern.get(name_id)
            if name == "std.string":
                let len_name = self.intern.intern_string("std.string.len")
                self.symtable.define(len_name, SYM_FUNC, 0 as u16, node_idx)
                let slice_name = self.intern.intern_string("std.string.slice")
                self.symtable.define(slice_name, SYM_FUNC, 0 as u16, node_idx)
                let concat_name = self.intern.intern_string("std.string.concat")
                self.symtable.define(concat_name, SYM_FUNC, 0 as u16, node_idx)
                let replace_name = self.intern.intern_string("std.string.replace")
                self.symtable.define(replace_name, SYM_FUNC, 0 as u16, node_idx)
            elif name == "std.os":
                let args_name = self.intern.intern_string("std.os.args")
                self.symtable.define(args_name, SYM_FUNC, 0 as u16, node_idx)
                let env_name = self.intern.intern_string("std.os.env")
                self.symtable.define(env_name, SYM_FUNC, 0 as u16, node_idx)
            // @free(get_str_ptr(name))
            
        self.tree.nodes.data[node_idx].payload = sym_idx

    elif kind == NODE_FIELD_EXPR:
        let lhs_idx = self.tree.nodes.data[node_idx].first_child
        if lhs_idx != 0 as u32:
            let lhs_node = self.tree.nodes.data[lhs_idx]
            mut is_module_import := false
            
            if lhs_node.kind == NODE_IDENT:
                let lhs_name = self.intern.get(lhs_node.payload)
                let rhs_name = self.intern.get(self.tree.nodes.data[node_idx].payload)
                let full_name = std.string.concat(lhs_name, std.string.concat(".", rhs_name))
                let full_name_id = self.intern.intern_string(full_name)
                
                if self.lazy != null as ptr[LazyResolver]:
                    let lhs_sym_idx = self.symtable.resolve(lhs_node.payload)
                    if lhs_sym_idx != 0 as u32:
                        let lhs_sym = self.symtable.symbols.data[lhs_sym_idx]
                        if lhs_sym.kind == SYM_MODULE:
                            let rhs_name_id = self.tree.nodes.data[node_idx].payload
                            let resolved_idx = self.lazy.lazy_resolver_resolve_field(lhs_sym.name_id, rhs_name_id)
                            if resolved_idx != 0 as u32:
                                self.tree.nodes.data[node_idx].payload = resolved_idx
                                self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                self.symtable.symbols.data[resolved_idx].flags = self.symtable.symbols.data[resolved_idx].flags | SYM_FLAG_USED
                                is_module_import = true
                
                if not is_module_import:
                    let sym_idx = self.symtable.resolve(full_name_id)
                    if sym_idx != 0 as u32:
                        let sym = self.symtable.symbols.data[sym_idx]
                        if sym.kind == SYM_MODULE:
                            self.tree.nodes.data[node_idx].payload = sym_idx
                            self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                            is_module_import = true
                // @free(get_str_ptr(full_name))
                // @free(get_str_ptr(lhs_name))
                // @free(get_str_ptr(rhs_name))
                        
            if not is_module_import:
                self.resolve_node(lhs_idx)
                let updated_lhs_node = self.tree.nodes.data[lhs_idx]
                if updated_lhs_node.kind == NODE_IDENT or updated_lhs_node.kind == NODE_FIELD_EXPR:
                    let sym_idx = updated_lhs_node.payload
                    if sym_idx != 0 as u32:
                        let sym = self.symtable.symbols.data[sym_idx]
                        if sym.kind == SYM_MODULE:
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            
                            mut resolved_idx := 0 as u32
                            if self.lazy != null as ptr[LazyResolver]:
                                resolved_idx = self.lazy.lazy_resolver_resolve_field(sym.name_id, field_name_id)
                                
                            if resolved_idx == 0 as u32:
                                let field_name = self.intern.get(field_name_id)
                                let module_name = self.intern.get(sym.name_id)
                                let full_name = std.string.concat(module_name, std.string.concat(".", field_name))
                                let full_name_id = self.intern.intern_string(full_name)
                                resolved_idx = self.symtable.resolve(full_name_id)
                                // @free(get_str_ptr(full_name))
                                // @free(get_str_ptr(field_name))
                                // @free(get_str_ptr(module_name))
                                
                            if resolved_idx != 0 as u32:
                                self.tree.nodes.data[node_idx].payload = resolved_idx
                                self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                self.symtable.symbols.data[resolved_idx].flags = self.symtable.symbols.data[resolved_idx].flags | SYM_FLAG_USED

    elif kind == NODE_FUNC_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        mut sym_flags := 0 as u16
        if (flags & FLAG_IS_PUB) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_PUB
        if (flags & FLAG_IS_EXTERN) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_EXTERN
        if (flags & FLAG_IS_ASYNC) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_ASYNC
        if (flags & FLAG_IS_GENERIC) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_GENERIC

        let sym_idx = self.symtable.define(name_id, SYM_FUNC, sym_flags, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx

        self.symtable.push_scope(SCOPE_FUNCTION)
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_PARAM_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        // RFC 0015 P1 (BUG#69): a `mut` parameter must carry SYM_FLAG_MUT, exactly
        // like a `mut` local (NODE_VAR_DECL below). The parser records `mut` on the
        // param node (FLAG_IS_MUT, parser.ax parse_param), but this was dropped here,
        // so assigning to a mut param (`fn f(mut x: i64): x = 0`) tripped the newly-
        // activated E4002 immutable-assign check. SYM_FLAG_MUT is read ONLY by the
        // ownership checker, so this has no codegen effect.
        mut sym_flags := 0 as u16
        if (flags & FLAG_IS_MUT) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_MUT
        let sym_idx = self.symtable.define(name_id, SYM_PARAM, sym_flags, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.resolve_children(node_idx)

    elif kind == NODE_STRUCT_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_STRUCT, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.symtable.push_scope(SCOPE_BLOCK)
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_FIELD_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_FIELD, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.resolve_children(node_idx)

    elif kind == NODE_INTERFACE_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_INTERFACE, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.symtable.push_scope(SCOPE_BLOCK)
        let self_name_id = self.intern.intern_string("Self")
        self.symtable.define(self_name_id, SYM_TYPE_ALIAS, 0 as u16, node_idx)
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_METHOD_SIG:
        self.symtable.push_scope(SCOPE_FUNCTION)
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_VAR_DECL:
        self.resolve_children(node_idx)
        let name_id = self.tree.nodes.data[node_idx].payload
        mut sym_flags := 0 as u16
        if (flags & FLAG_IS_MUT) != 0 as u16:
            sym_flags = sym_flags | SYM_FLAG_MUT
        let sym_idx = self.symtable.define(name_id, SYM_VAR, sym_flags, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx

    elif kind == NODE_CONST_DECL:
        self.resolve_children(node_idx)
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_CONST, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx

    elif kind == NODE_TYPE_ALIAS_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_TYPE_ALIAS, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.symtable.push_scope(SCOPE_BLOCK)
        self.resolve_children(node_idx)
        
        let curr_scope_idx = self.symtable.current_scope()
        self.symtable.pop_scope()
        let parent_scope_idx = 0 as u32
        
        // Elevate variant symbols to parent scope
        let curr_scope = self.symtable.scopes.data[curr_scope_idx]
        mut i := 0 as i64
        while i < curr_scope.capacity as i64:
            let entry = curr_scope.entries[i]
            if entry.name_id != 0 as u32:
                let sym = self.symtable.symbols.data[entry.symbol_idx]
                if sym.kind == SYM_VARIANT:
                    let parent_entry = (&self.symtable.scopes.data[parent_scope_idx]).scope_get(entry.name_id)
                    mut skip_elevate := false
                    if parent_entry.name_id != 0 as u32:
                        let existing_sym = self.symtable.symbols.data[parent_entry.symbol_idx]
                        if existing_sym.kind == SYM_VARIANT:
                            skip_elevate = true
                    if not skip_elevate:
                        (&self.symtable.scopes.data[parent_scope_idx]).scope_put(entry.name_id, entry.symbol_idx)
            i = i + 1


    elif kind == NODE_VARIANT_DECL:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_VARIANT, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.resolve_children(node_idx)

    elif kind == NODE_IF_STMT or kind == NODE_ELIF_CLAUSE or kind == NODE_ELSE_CLAUSE or kind == NODE_MATCH_ARM or kind == NODE_ARENA_BLOCK or kind == NODE_UNSAFE_BLOCK or kind == NODE_WHILE_STMT:
        self.symtable.push_scope(SCOPE_BLOCK)
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_FOR_STMT:
        self.symtable.push_scope(SCOPE_LOOP)
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_VAR, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.resolve_children(node_idx)
        self.symtable.pop_scope()

    elif kind == NODE_CLOSURE_EXPR:
        // RFC 0008: lambda-lifting (lift_closures, pre-resolve) already turned the
        // lambda body into a top-level function and left the interned function NAME
        // in this node's payload. Resolve it to that function's symbol, like an
        // identifier; air_builder then lowers this node to OP_FUNC_ADDR.
        let cl_name_id = self.tree.nodes.data[node_idx].payload
        let cl_sym = self.symtable.resolve(cl_name_id)
        if cl_sym != 0 as u32:
            self.tree.nodes.data[node_idx].payload = cl_sym
            self.symtable.symbols.data[cl_sym].flags = self.symtable.symbols.data[cl_sym].flags | SYM_FLAG_USED

    elif kind == NODE_IDENT:
        if (self.tree.nodes.data[node_idx].flags & 4096 as u16) == 0 as u16:
            let name_id = self.tree.nodes.data[node_idx].payload
            let name = self.intern.get(name_id)
            if name != "break" and name != "continue":
                let sym_idx = self.symtable.resolve(name_id)
                if sym_idx != 0 as u32:
                    self.tree.nodes.data[node_idx].payload = sym_idx
                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags & (65535 as u16 ^ FLAG_IS_SUBSTITUTED)
                    self.symtable.symbols.data[sym_idx].flags = self.symtable.symbols.data[sym_idx].flags | SYM_FLAG_USED
                else:
                    // Undefined name: the resolver found no binding for this bare
                    // value-position identifier. Force payload to 0 (a definitive "no
                    // symbol") so the typechecker can REJECT it -- previously the raw
                    // name_id was left as payload, accidentally indexing an unrelated
                    // symbol -> silent garbage/0 at runtime (BUG#53 class). The
                    // compiler's own source has ZERO unresolved bare idents (verified
                    // by trace), so this is self-build-safe. Builtin TYPE names used in
                    // value position still recover their type in typecheck via node_text.
                    self.tree.nodes.data[node_idx].payload = 0 as u32
        self.resolve_children(node_idx)
        // @free(get_str_ptr(name))

    elif kind == NODE_TYPE_EXPR:
        if (self.tree.nodes.data[node_idx].flags & 4096 as u16) == 0 as u16:
            if self.tree.nodes.data[node_idx].payload != 0 as u32:
                let name_id = self.tree.nodes.data[node_idx].payload
                let sym_idx = self.symtable.resolve_type(name_id)
                if sym_idx != 0 as u32:
                    self.tree.nodes.data[node_idx].payload = sym_idx
                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags & (65535 as u16 ^ FLAG_IS_SUBSTITUTED)
                    self.symtable.symbols.data[sym_idx].flags = self.symtable.symbols.data[sym_idx].flags | SYM_FLAG_USED
        self.resolve_children(node_idx)

    elif kind == NODE_BINDING_PAT:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_VAR, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx

    elif kind == NODE_VARIANT_PAT:
        if (self.tree.nodes.data[node_idx].flags & 4096 as u16) == 0 as u16:
            let name_id = self.tree.nodes.data[node_idx].payload
            let sym_idx = self.symtable.resolve(name_id)
            if sym_idx != 0 as u32:
                self.tree.nodes.data[node_idx].payload = sym_idx
                self.symtable.symbols.data[sym_idx].flags = self.symtable.symbols.data[sym_idx].flags | SYM_FLAG_USED
        self.resolve_children(node_idx)

    elif kind == NODE_GENERIC_PARAM:
        let name_id = self.tree.nodes.data[node_idx].payload
        let sym_idx = self.symtable.define(name_id, SYM_GENERIC_PARAM, 0 as u16, node_idx)
        self.tree.nodes.data[node_idx].payload = sym_idx
        self.resolve_children(node_idx)

    else:
        self.resolve_children(node_idx)

extern "C" fn ax_ax_driver_load_module(mod: ptr[void], st: ptr[SymbolTable], tt: ptr[void]) -> i32

pub fn lazy_resolver_register_import(mut self: ptr[LazyResolver], name_id: u32, file_path: str, decl_node: u32) -> u32:
    mut i := 0 as i64
    while i < self.modules.len:
        let mod = self.modules.data[i]
        if mod.name_id == name_id:
            let sym_idx = self.symtable.resolve(name_id)
            return sym_idx
        i = i + 1

    let sym_idx = self.symtable.define(name_id, SYM_MODULE, 0 as u16, decl_node)
    
    let mod = @alloc(@compiler_intrinsic("size_of")[ModuleInfo]()) as ptr[ModuleInfo]
    mod.name_id = name_id
    mod.status = MODULE_UNLOADED
    mod.file_path = file_path
    mod.exports = new_module_export_vec()
    mod.ast_tree = null as ptr[AstTree]
    mod.node_types = null as ptr[void]
    mod.src_buffer = null as ptr[void]
    mod.tokens_data = null as ptr[void]
    (&self.modules).push(mod)

    return sym_idx

pub fn lazy_resolver_resolve_field(mut self: ptr[LazyResolver], module_name_id: u32, field_name_id: u32) -> u32:
    mut mod := null as ptr[ModuleInfo]
    mut i := 0 as i64
    while i < self.modules.len:
        let m = self.modules.data[i]
        if m.name_id == module_name_id:
            mod = m
            break
        i = i + 1

    if mod == null as ptr[ModuleInfo]:
        return 0 as u32

    if mod.status == MODULE_UNLOADED:
        mod.status = MODULE_LOADING
        let saved_data = self.symtable.stack.data
        let saved_len = self.symtable.stack.len
        let saved_cap = self.symtable.stack.cap
        
        mut temp_stack := new_u32_vec()
        temp_stack.push(0 as u32)
        self.symtable.stack = temp_stack
        
        let err_code = ax_ax_driver_load_module(mod as ptr[void], self.symtable, self.typetable)
        
        @free(self.symtable.stack.data as ptr[u8])
        self.symtable.stack.data = saved_data
        self.symtable.stack.len = saved_len
        self.symtable.stack.cap = saved_cap
        
        if err_code != 0:
            mod.status = MODULE_UNLOADED
            return 0 as u32
        mod.status = MODULE_LOADED

    i = 0
    while i < mod.exports.len:
        let exp = &mod.exports.data[i]
        if exp.name_id == field_name_id:
            return exp.symbol_idx
        i = i + 1

    return 0 as u32

pub fn lazy_resolver_find_module_of_symbol(self: ptr[LazyResolver], sym_idx: u32) -> ptr[ModuleInfo]:
    if self == null as ptr[LazyResolver]:
        return null as ptr[ModuleInfo]
    mut i := 0 as i64
    while i < self.modules.len:
        let mod = self.modules.data[i]
        if mod != null as ptr[ModuleInfo]:
            if mod.exports.data != null as ptr[ModuleExport]:
                mut j := 0 as i64
                while j < mod.exports.len:
                    let exp = mod.exports.data[j]
                    if exp.symbol_idx == sym_idx:
                        return mod
                    j = j + 1 as i64
        i = i + 1 as i64
    return null as ptr[ModuleInfo]

pub fn lazy_resolver_preload_module(mut self: ptr[LazyResolver], name_id: u32) -> bool:
    mut mod := null as ptr[ModuleInfo]
    mut i := 0 as i64
    while i < self.modules.len:
        let m = self.modules.data[i]
        if m.name_id == name_id:
            mod = m
            break
        i = i + 1

    if mod == null as ptr[ModuleInfo]:
        return false

    if mod.status == MODULE_UNLOADED:
        mod.status = MODULE_LOADING
        let saved_data = self.symtable.stack.data
        let saved_len = self.symtable.stack.len
        let saved_cap = self.symtable.stack.cap
        
        mut temp_stack := new_u32_vec()
        temp_stack.push(0 as u32)
        self.symtable.stack = temp_stack
        
        let err_code = ax_ax_driver_load_module(mod as ptr[void], self.symtable, self.typetable)
        
        @free(self.symtable.stack.data as ptr[u8])
        self.symtable.stack.data = saved_data
        self.symtable.stack.len = saved_len
        self.symtable.stack.cap = saved_cap
        
        if err_code != 0:
            mod.status = MODULE_UNLOADED
            return false
        mod.status = MODULE_LOADED

    return true

pub fn free_symtable(mut self: ptr[SymbolTable]):
    mut i := 0 as i64
    while i < self.scopes.len:
        let scope = &self.scopes.data[i]
        if scope.entries != null as ptr[ScopeEntry]:
            @free(scope.entries as ptr[u8])
        i = i + 1
    if self.symbols.data != null as ptr[Symbol]:
        @free(self.symbols.data as ptr[u8])
    if self.scopes.data != null as ptr[Scope]:
        @free(self.scopes.data as ptr[u8])
    if self.stack.data != null as ptr[u32]:
        @free(self.stack.data as ptr[u8])

pub fn free_lazy_resolver(mut self: ptr[LazyResolver]):
    if self == null as ptr[LazyResolver]:
        return
    mut i := 0 as i64
    while i < self.modules.len:
        let mod = self.modules.data[i]
        if mod != null as ptr[ModuleInfo]:
            if mod.exports.data != null as ptr[ModuleExport]:
                @free(mod.exports.data as ptr[u8])
            if mod.node_types != null as ptr[void]:
                @free(mod.node_types as ptr[u8])
            if mod.src_buffer != null as ptr[void]:
                @free(mod.src_buffer as ptr[u8])
            if mod.tokens_data != null as ptr[void]:
                @free(mod.tokens_data as ptr[u8])
            if mod.ast_tree != null as ptr[AstTree]:
                if mod.ast_tree.nodes.data != null as ptr[AstNode]:
                    @free(mod.ast_tree.nodes.data as ptr[u8])
                if mod.ast_tree.extras.data != null as ptr[i32]:
                    @free(mod.ast_tree.extras.data as ptr[u8])
                @free(mod.ast_tree as ptr[u8])
            @free(mod as ptr[u8])
        i = i + 1
    if self.modules.data != null as ptr[ptr[ModuleInfo]]:
        @free(self.modules.data as ptr[u8])
    @free(self as ptr[u8])
// bootstrap/stage1/typetable.ax
// AXIOM self-hosted Type Table representation.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64
// extern "C" fn sprintf(buf: ptr[u8], format: ptr[u8], val: f64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64
extern "C" fn fflush(stream: ptr[void]) -> i32

// Predefined TypeID constants matching types/typeid.go exactly
pub const TYPE_UNKNOWN: u32 = 0
pub const TYPE_I8: u32 = 1
pub const TYPE_I16: u32 = 2
pub const TYPE_I32: u32 = 3
pub const TYPE_I64: u32 = 4
pub const TYPE_U8: u32 = 5
pub const TYPE_U16: u32 = 6
pub const TYPE_U32: u32 = 7
pub const TYPE_U64: u32 = 8
pub const TYPE_F32: u32 = 9
pub const TYPE_F64: u32 = 10
pub const TYPE_BOOL: u32 = 11
pub const TYPE_STRING: u32 = 12
pub const TYPE_CHAR8: u32 = 13
pub const TYPE_VOID: u32 = 14
pub const TYPE_ISIZE: u32 = 15
pub const TYPE_USIZE: u32 = 16

pub const TYPE_ORD: u32 = 17
pub const TYPE_EQ: u32 = 18
pub const TYPE_HASH: u32 = 19
pub const TYPE_DISPLAY: u32 = 20
pub const TYPE_ACTOR_REF: u32 = 21
pub const TYPE_BYTES: u32 = 22 // RFC 0020: raw byte buffer; same {ptr,len} 16B repr as str, distinct type (byte iteration/semantics)

pub struct ComptimeValue:
    kind: u32
    int_val: i64
    float_val: f64
    bool_val: bool
    str_val: str

// TypeKind enum matching compiler/types/types.go Kind constants exactly
pub const TYPE_KIND_PRIMITIVE: u8 = 0
pub const TYPE_KIND_STRUCT: u8 = 1
pub const TYPE_KIND_FUNC: u8 = 2
pub const TYPE_KIND_ARRAY: u8 = 3
pub const TYPE_KIND_SLICE: u8 = 4
pub const TYPE_KIND_TUPLE: u8 = 5
pub const TYPE_KIND_SUM: u8 = 6
pub const TYPE_KIND_GENERIC: u8 = 7
pub const TYPE_KIND_GENERIC_INST: u8 = 8
pub const TYPE_KIND_POINTER: u8 = 9
pub const TYPE_KIND_REF: u8 = 10
pub const TYPE_KIND_OPTION: u8 = 11
pub const TYPE_KIND_RESULT: u8 = 12
pub const TYPE_KIND_INTERFACE: u8 = 13

pub struct TypeEntry:
    kind: u8
    padding: u8
    flags: u16
    name_id: u32
    size: u32
    align: u32
    extra: u32 // Index into structs or funcs lists

pub struct StructField:
    name_id: u32
    type_id: u32

pub struct StructFieldVec:
    data: ptr[StructField]
    len: i64
    cap: i64

pub fn push(self: ptr[StructFieldVec], sf: StructField):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[StructField]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[StructField]
        if self.data != null as ptr[StructField]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = sf
    self.len = self.len + 1

pub struct StructInfo:
    fields: StructFieldVec
    generic_args: U32Vec

pub struct StructInfoVec:
    data: ptr[StructInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[StructInfoVec], si: StructInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[StructInfo]() as i64)) as ptr[StructInfo]
        if self.data != null as ptr[StructInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[StructInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = si
    self.len = self.len + 1

pub struct VariantInfo:
    name_id: u32
    payload_type: u32
    tag: u8
    padding1: u8
    padding2: u16

pub struct VariantInfoVec:
    data: ptr[VariantInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[VariantInfoVec], vi: VariantInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[VariantInfo]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[VariantInfo]
        if self.data != null as ptr[VariantInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = vi
    self.len = self.len + 1

pub struct SumInfo:
    variants: VariantInfoVec
    generic_args: U32Vec

pub struct SumInfoVec:
    data: ptr[SumInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[SumInfoVec], si: SumInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[SumInfo]() as i64)) as ptr[SumInfo]
        if self.data != null as ptr[SumInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[SumInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = si
    self.len = self.len + 1

pub struct FuncInfo:
    params: U32Vec
    ret: u32
    dummy: u32

pub struct FuncInfoVec:
    data: ptr[FuncInfo]
    len: i64
    cap: i64

pub fn push(self: ptr[FuncInfoVec], fi: FuncInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[FuncInfo]() as i64)) as ptr[FuncInfo]
        if self.data != null as ptr[FuncInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[FuncInfo]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = fi
    self.len = self.len + 1

pub struct TypeEntryVec:
    data: ptr[TypeEntry]
    len: i64
    cap: i64

pub fn push(self: ptr[TypeEntryVec], te: TypeEntry) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[TypeEntry]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[TypeEntry]
        if self.data != null as ptr[TypeEntry]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = te
    self.len = self.len + 1
    return idx

pub fn new_sum_info_vec() -> SumInfoVec:
    return SumInfoVec(data: null as ptr[SumInfo], len: 0, cap: 0)

pub fn new_variant_info_vec() -> VariantInfoVec:
    return VariantInfoVec(data: null as ptr[VariantInfo], len: 0, cap: 0)

pub struct U32VecVec:
    pub data: ptr[U32Vec]
    pub len: i64
    pub cap: i64

pub fn new_u32_vec_vec() -> U32VecVec:
    return U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)

pub fn push(self: ptr[U32VecVec], val: U32Vec) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[U32Vec]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[U32Vec]
        if self.data != null as ptr[U32Vec]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = val
    self.len = self.len + 1
    return idx

pub struct TypeTable:
    pub entries: TypeEntryVec
    pub structs: StructInfoVec
    pub funcs: FuncInfoVec
    pub sumtypes: SumInfoVec
    pub generic_insts: U32VecVec
    // RFC 0029: per-interface ordered method-name list (vtable slot layout). A
    // TYPE_KIND_INTERFACE entry's `extra` field holds (iface_methods index + 1); 0 = none.
    pub iface_methods: U32VecVec

pub fn new_type_table() -> ptr[TypeTable]:
    // size_of (not a hardcoded byte count) so adding a field can't desync the alloc.
    let tt = @alloc(@compiler_intrinsic("size_of")[TypeTable]()) as ptr[TypeTable]
    tt.entries = TypeEntryVec(data: null as ptr[TypeEntry], len: 0, cap: 0)
    tt.structs = StructInfoVec(data: null as ptr[StructInfo], len: 0, cap: 0)
    tt.funcs = FuncInfoVec(data: null as ptr[FuncInfo], len: 0, cap: 0)
    tt.sumtypes = SumInfoVec(data: null as ptr[SumInfo], len: 0, cap: 0)
    tt.generic_insts = U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)
    tt.iface_methods = U32VecVec(data: null as ptr[U32Vec], len: 0, cap: 0)
    
    // 0: Unknown sentinel
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 0 as u32, align: 0 as u32, extra: 0 as u32))
    
    // 1-16: Primitives
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // i8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 2 as u32, align: 2 as u32, extra: 0 as u32)) // i16
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // i32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // i64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // u8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 2 as u32, align: 2 as u32, extra: 0 as u32)) // u16
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // u32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // u64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 4 as u32, align: 4 as u32, extra: 0 as u32)) // f32
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // f64
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // bool
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32)) // string
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 1 as u32, align: 1 as u32, extra: 0 as u32)) // char8
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 0 as u32, align: 0 as u32, extra: 0 as u32)) // void
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // isize
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32)) // usize

    // 17-20: Built-in interfaces
    mut i := 0
    while i < 4:
        (&tt.entries).push(TypeEntry(kind: TYPE_KIND_INTERFACE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32))
        i = i + 1

    // 21: ActorRef
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_STRUCT, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 8 as u32, align: 8 as u32, extra: 0 as u32))

    // 22: bytes (RFC 0020) â€” raw byte buffer, same 16-byte {ptr,len} repr as str.
    (&tt.entries).push(TypeEntry(kind: TYPE_KIND_PRIMITIVE, padding: 0 as u8, flags: 0 as u16, name_id: 0 as u32, size: 16 as u32, align: 8 as u32, extra: 0 as u32))

    return tt

// Forward-declaration for a genuinely SELF-RECURSIVE non-generic sum
// (`type Tree = Leaf(i64) | Node(Tree,Tree)`): reserve the sum's type_id (empty variants) so a
// variant field that is a BARE reference to the sum being defined resolves to THIS id, then
// populate once the fields are resolved. Only used when a bare self-ref field is present (the
// caller gates on it), so non-recursive sums and generic/mono-clone recursive sums (whose
// self-refs are `Tree[..]` generic_inst) keep the plain register_sum_type path unchanged. See
// [[bug-recursive-nongeneric-multifield-sum]]. Pair with set_sum_variants.
pub fn reserve_sum_type(self: ptr[TypeTable], name_id: u32) -> u32:
    let s_idx = self.sumtypes.len as u32
    (&self.sumtypes).push(SumInfo(variants: new_variant_info_vec(), generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SUM,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: s_idx,
    ))

// Fill in the variants of a sum reserved by reserve_sum_type. The empty placeholder vec is
// dropped (len 0, null buffer â€” nothing to free).
pub fn set_sum_variants(self: ptr[TypeTable], type_id: u32, variants: VariantInfoVec):
    if (type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[type_id as i64]
    if entry.kind != TYPE_KIND_SUM:
        return
    self.sumtypes.data[entry.extra as i64].variants = variants

pub fn register_sum_type(self: ptr[TypeTable], name_id: u32, variants: VariantInfoVec) -> u32:
    let s_idx = self.sumtypes.len as u32
    (&self.sumtypes).push(SumInfo(variants: variants, generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    // RFC 0004: a user sum value is an 8-byte by-address pointer to a heap box
    // laid out as [tag: i64 @0][payload: 8B @8] = 16 bytes (kind 6 is aggregate,
    // so the VALUE stays an 8-byte pointer; the 16 is the box allocation size).
    // v1 supports a single <=8-byte payload slot; str/multi-field payloads TODO.
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SUM,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: s_idx,
    ))

// RFC 0012: Option[T] / Result[T,E] as a real type entry. Like a user sum
// (kind 6) the VALUE is an 8-byte by-address tagged box pointer, and the 16 is
// the box allocation size (holds up to a 16-byte str payload). Being kind 11/12
// (aggregate) it is passed/returned as an 8-byte pointer exactly like a sum, so
// the stdlib ABI (self: Option[..] read via `(&self)[0]`) is unchanged; the only
// gain is that the register type is NO LONGER `str` (12), so EQ/COPY/MAKE_REF on
// the box stop taking the string-by-address deref path and `match` can dispatch.
// Option dedups on (kind, extra=inner). Result dedups on (kind, extra=ok, name_id=err).
pub fn register_option(self: ptr[TypeTable], inner_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_OPTION and entry.extra == inner_id:
            return i as u32
        i = i + 1
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_OPTION,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 16 as u32,
        align: 8 as u32,
        extra: inner_id,
    ))

pub fn register_result(self: ptr[TypeTable], ok_id: u32, err_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_RESULT and entry.extra == ok_id and entry.name_id == err_id:
            return i as u32
        i = i + 1
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_RESULT,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: err_id,
        size: 16 as u32,
        align: 8 as u32,
        extra: ok_id,
    ))

pub fn register_struct(self: ptr[TypeTable], name_id: u32, fields: StructFieldVec) -> u32:
    let s_idx = self.structs.len as u32
    (&self.structs).push(StructInfo(fields: fields, generic_args: U32Vec(data: null as ptr[u32], len: 0, cap: 0)))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_STRUCT,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: s_idx,
    ))

// RFC 0013: record the concrete type-args of a monomorphized generic struct so
// get_generic_args() never has to re-derive them by parsing the mangled name
// (ambiguous for nested generics like MV[MV[i32]], see BUG#65). Deep-copies
// `args` since the caller (mono.instantiate_function) does not own/outlive it.
pub fn set_struct_generic_args(self: ptr[TypeTable], struct_type_id: u32, args: U32Vec):
    if (struct_type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[struct_type_id as i64]
    if entry.kind != TYPE_KIND_STRUCT:
        return
    let s_idx = entry.extra as i64
    if s_idx >= self.structs.len:
        return
    mut copied := U32Vec(data: null as ptr[u32], len: 0, cap: 0)
    if args.len > 0 as i64:
        let buf = @alloc(args.len * 4 as i64) as ptr[u32]
        @memcpy(buf as ptr[u8], args.data as ptr[u8], args.len * 4 as i64)
        copied.data = buf
        copied.len = args.len
        copied.cap = args.len
    self.structs.data[s_idx].generic_args = copied

// BUG#67 follow-up: same idea as set_struct_generic_args, but for a
// monomorphized generic SUM TYPE (e.g. a concrete Option[Vec[i64]] clone
// produced when typechecking a `-> Option[V]` return-type annotation with V
// substituted). Without this, get_generic_args() falls back to parsing the
// clone's mangled name, which is ambiguous for a nested generic payload
// (e.g. Vec[i64] itself mangled as "...__i64") -- same architectural gap as
// BUG#65, manifesting for sum types instead of structs.
pub fn set_sum_generic_args(self: ptr[TypeTable], sum_type_id: u32, args: U32Vec):
    if (sum_type_id as i64) >= self.entries.len:
        return
    let entry = self.entries.data[sum_type_id as i64]
    if entry.kind != TYPE_KIND_SUM:
        return
    let s_idx = entry.extra as i64
    if s_idx >= self.sumtypes.len:
        return
    mut copied := U32Vec(data: null as ptr[u32], len: 0, cap: 0)
    if args.len > 0 as i64:
        let buf = @alloc(args.len * 4 as i64) as ptr[u32]
        @memcpy(buf as ptr[u8], args.data as ptr[u8], args.len * 4 as i64)
        copied.data = buf
        copied.len = args.len
        copied.cap = args.len
    self.sumtypes.data[s_idx].generic_args = copied

pub fn register_function(self: ptr[TypeTable], params: U32Vec, ret: u32) -> u32:
    let f_idx = self.funcs.len as u32
    (&self.funcs).push(FuncInfo(params: params, ret: ret, dummy: 0 as u32))
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_FUNC,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 8 as u32,
        align: 8 as u32,
        extra: f_idx,
    ))

pub fn register_pointer(self: ptr[TypeTable], inner_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_POINTER and entry.extra == inner_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_POINTER,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 8 as u32,
        align: 8 as u32,
        extra: inner_id,
    ))

pub fn register_slice(self: ptr[TypeTable], elem_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_SLICE and entry.extra == elem_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_SLICE,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: 0 as u32,
        size: 24 as u32,
        align: 8 as u32,
        extra: elem_id,
    ))

pub fn register_array(self: ptr[TypeTable], elem_id: u32, length: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_ARRAY and entry.extra == elem_id and entry.name_id == length:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_ARRAY,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: length,
        size: 0 as u32,
        align: 0 as u32,
        extra: elem_id,
    ))

// Minimal interface type registration: just enough for a distinct, stable
// type_id so receiver-type checks (e.g. rejecting unimplemented dynamic
// dispatch through an interface value, see BUG#71) can recognize it. No
// method-signature side table -- interfaces carry no runtime representation
// (no vtable/fat pointer) yet, so there is nothing else to store here.
pub fn register_interface(self: ptr[TypeTable], name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_INTERFACE and entry.name_id == name_id:
            return i as u32
        i = i + 1

    // RFC 0029: an interface VALUE is an 8-byte pointer to a heap box {data, m0..m(N-1)}
    // (the inline per-value vtable). size 8/align 8 â†’ it passes/returns/stores as a plain
    // 8-byte pointer (scalar ABI); the box's field layout lives in a separate synthesized
    // struct type (ensure_iface_box_type). Was 0/0 (BUG#71 minimal reject era).
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_INTERFACE,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 8 as u32,
        align: 8 as u32,
        extra: 0 as u32,
    ))

// RFC 0029 step 1: attach an interface's ordered method-name list (its vtable slot
// layout) to its type entry. `extra` stores (iface_methods index + 1) so that 0 keeps
// meaning "no method list" (built-in interface placeholders leave extra=0). Idempotent-ish:
// only call once per interface, at first registration (guarded by sym.type_id==0 caller-side).
pub fn register_interface_methods(self: ptr[TypeTable], iface_type_id: u32, methods: U32Vec):
    if iface_type_id == 0 as u32 or (iface_type_id as i64) >= self.entries.len:
        return
    let idx = self.iface_methods.len as u32
    (&self.iface_methods).push(methods)
    self.entries.data[iface_type_id as i64].extra = idx + 1 as u32

// RFC 0029: return the ordered method-name list for an interface type (or an empty list
// if none was registered). Slot index = position in this list.
pub fn interface_method_list(self: ptr[TypeTable], iface_type_id: u32) -> U32Vec:
    if iface_type_id != 0 as u32 and (iface_type_id as i64) < self.entries.len:
        let ex = self.entries.data[iface_type_id as i64].extra
        if ex != 0 as u32 and ((ex - 1 as u32) as i64) < self.iface_methods.len:
            return self.iface_methods.data[(ex - 1 as u32) as i64]
    return U32Vec(data: null as ptr[u32], len: 0, cap: 0)

pub fn register_generic_inst(self: ptr[TypeTable], name_id: u32, args: U32Vec) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_GENERIC_INST and entry.name_id == name_id:
            let inst_idx = entry.extra
            let inst_args = &self.generic_insts.data[inst_idx]
            if inst_args.len == args.len:
                mut args_match := true
                mut j := 0 as i64
                while j < args.len:
                    if inst_args.data[j] != args.data[j]:
                        args_match = false
                        break
                    j = j + 1
                if args_match:
                    if args.data != null as ptr[u32]:
                        @free(args.data as ptr[u8])
                    return i as u32
        i = i + 1
    
    let inst_idx = (&self.generic_insts).push(args)
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_GENERIC_INST,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: inst_idx,
    ))

pub fn register_generic(self: ptr[TypeTable], name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.entries.len:
        let entry = self.entries.data[i]
        if entry.kind == TYPE_KIND_GENERIC and entry.name_id == name_id:
            return i as u32
        i = i + 1
    
    return (&self.entries).push(TypeEntry(
        kind: TYPE_KIND_GENERIC,
        padding: 0 as u8,
        flags: 0 as u16,
        name_id: name_id,
        size: 0 as u32,
        align: 0 as u32,
        extra: 0 as u32,
    ))

pub fn free_typetable(self: ptr[TypeTable]):
    mut i := 0 as i64
    while i < self.structs.len:
        let s = self.structs.data[i]
        if s.fields.data != null as ptr[StructField]:
            @free(s.fields.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.funcs.len:
        let f = self.funcs.data[i]
        if f.params.data != null as ptr[u32]:
            @free(f.params.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.sumtypes.len:
        let s = self.sumtypes.data[i]
        if s.variants.data != null as ptr[VariantInfo]:
            @free(s.variants.data as ptr[u8])
        i = i + 1
    i = 0 as i64
    while i < self.generic_insts.len:
        let g = self.generic_insts.data[i]
        if g.data != null as ptr[u32]:
            @free(g.data as ptr[u8])
        i = i + 1
    if self.generic_insts.data != null as ptr[U32Vec]:
        @free(self.generic_insts.data as ptr[u8])
    if self.sumtypes.data != null as ptr[SumInfo]:
        @free(self.sumtypes.data as ptr[u8])
    if self.entries.data != null as ptr[TypeEntry]:
        @free(self.entries.data as ptr[u8])
    if self.structs.data != null as ptr[StructInfo]:
        @free(self.structs.data as ptr[u8])
    if self.funcs.data != null as ptr[FuncInfo]:
        @free(self.funcs.data as ptr[u8])
    @free(self as ptr[u8])
// bootstrap/stage1/mono.ax
// Monomorphizer specializes generic structs and functions at compile-time.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct TypeSubst:
    pub name_id: u32
    pub type_id: u32

pub struct TypeSubstVec:
    pub data: ptr[TypeSubst]
    pub len: i64
    pub cap: i64

pub fn new_type_subst_vec() -> TypeSubstVec:
    return TypeSubstVec(data: null as ptr[TypeSubst], len: 0, cap: 0)

pub fn push(mut self: TypeSubstVec, subst: TypeSubst):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[TypeSubst] // size of TypeSubst is 8 bytes
        if self.data != null as ptr[TypeSubst]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = subst
    self.len = self.len + 1 as i64

pub fn lookup_subst(self: TypeSubstVec, name_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.len:
        if self.data[i].name_id == name_id:
            return self.data[i].type_id
        i = i + 1 as i64
    return 0 as u32 // TYPE_UNKNOWN

pub struct Monomorphizer:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub struct_type_id: u32

pub fn new_monomorphizer(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[Monomorphizer]:
    let mm = @alloc(@compiler_intrinsic("size_of")[Monomorphizer]()) as ptr[Monomorphizer]
    mm.tree = tree
    mm.pool = pool
    mm.symtable = symtable
    mm.typetable = typetable
    mm.struct_type_id = 0 as u32
    return mm

pub fn node_text(self: ptr[Monomorphizer], tree: ptr[AstTree], node_idx: u32) -> str:
    let node = tree.nodes.data[node_idx]
    let tok_idx = node.token_idx
    if tok_idx as i64 >= tree.tokens.len:
        return ""
    let tok = tree.tokens.data[tok_idx as i64]
    if tok.len == 0 as u16:
        return ""
    let start_ptr = ((tree.src as ptr[u8]) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn substitute_type_params(mut self: ptr[Monomorphizer], node_idx: u32, orig_node_idx: u32, src_tree: ptr[AstTree], subst: TypeSubstVec):
    if node_idx == 0 as u32 or node_idx == 0xffffffff as u32 or orig_node_idx == 0 as u32 or orig_node_idx == 0xffffffff as u32:
        return

    mut node := &self.tree.nodes.data[node_idx]
    node.flags = node.flags & (~2048 as u16)
    let orig_node = src_tree.nodes.data[orig_node_idx]
    let kind = node.kind

    if (kind == NODE_IDENT or kind == NODE_PARAM_DECL or kind == NODE_FIELD_DECL or
        kind == NODE_FUNC_DECL or kind == NODE_STRUCT_DECL or kind == NODE_TYPE_ALIAS_DECL or
        kind == NODE_VARIANT_DECL or kind == NODE_TYPE_EXPR or kind == NODE_VAR_DECL or
        kind == NODE_CONST_DECL or kind == NODE_BINDING_PAT or kind == NODE_VARIANT_PAT or
        kind == NODE_INTERFACE_DECL or kind == NODE_IMPORT_DECL or kind == NODE_FOR_STMT):
        
        mut has_sym_payload := false
        if (kind == NODE_FUNC_DECL or kind == NODE_PARAM_DECL or kind == NODE_STRUCT_DECL or
            kind == NODE_FIELD_DECL or kind == NODE_INTERFACE_DECL or kind == NODE_VAR_DECL or
            kind == NODE_CONST_DECL or kind == NODE_IMPORT_DECL or kind == NODE_TYPE_ALIAS_DECL or
            kind == NODE_VARIANT_DECL or kind == NODE_FOR_STMT or kind == NODE_IDENT or
            kind == NODE_BINDING_PAT or kind == NODE_VARIANT_PAT):
            has_sym_payload = true
            
        mut name_id := 0 as u32
        if has_sym_payload:
            let orig_sym_idx = orig_node.payload
            if orig_sym_idx != 0 as u32 and (orig_sym_idx as i64) < self.symtable.symbols.len:
                let sym = self.symtable.symbols.data[orig_sym_idx as i64]
                name_id = sym.name_id

        if name_id == 0 as u32:
            let text = self.node_text(src_tree, orig_node_idx)
            name_id = self.pool.intern(text)
            @free(get_str_ptr(text))

        if name_id != 0 as u32:
            if kind == NODE_IDENT or kind == NODE_TYPE_EXPR or kind == NODE_BINDING_PAT or kind == NODE_VARIANT_PAT:
                let type_id = lookup_subst(subst, name_id)
                if type_id != 0 as u32:
                    if (type_id as i64) < self.typetable.entries.len:
                        let entry = self.typetable.entries.data[type_id]
                        mut target_name_id := entry.name_id
                        // An ARRAY type has no name: `register_array` OVERLOADS `name_id`
                        // to hold the array LENGTH (`name_id: length, extra: elem_id`).
                        // So `entry.name_id` here is a length, and using it as an intern id
                        // substitutes a meaningless name that resolves to nothing â€” which
                        // is why `Option[[i32;3]]` monomorphized with an EMPTY variant
                        // payload_type. Treat it like the `__tup` case: unnameable, recover
                        // it from the stashed type_id below.
                        mut unnameable := entry.kind == TYPE_KIND_ARRAY
                        if unnameable:
                            target_name_id = 0 as u32
                        if target_name_id == 0 as u32:
                            if type_id == 1 as u32:
                                target_name_id = self.pool.intern("i8")
                            elif type_id == 2 as u32:
                                target_name_id = self.pool.intern("i16")
                            elif type_id == 3 as u32:
                                target_name_id = self.pool.intern("i32")
                            elif type_id == 4 as u32:
                                target_name_id = self.pool.intern("i64")
                            elif type_id == 5 as u32:
                                target_name_id = self.pool.intern("u8")
                            elif type_id == 6 as u32:
                                target_name_id = self.pool.intern("u16")
                            elif type_id == 7 as u32:
                                target_name_id = self.pool.intern("u32")
                            elif type_id == 8 as u32:
                                target_name_id = self.pool.intern("u64")
                            elif type_id == 9 as u32:
                                target_name_id = self.pool.intern("f32")
                            elif type_id == 10 as u32:
                                target_name_id = self.pool.intern("f64")
                            elif type_id == 11 as u32:
                                target_name_id = self.pool.intern("bool")
                            elif type_id == 12 as u32:
                                target_name_id = self.pool.intern("string")
                            elif type_id == 13 as u32:
                                target_name_id = self.pool.intern("char8")
                            elif type_id == 14 as u32:
                                target_name_id = self.pool.intern("void")
                            elif type_id == 15 as u32:
                                target_name_id = self.pool.intern("isize")
                            elif type_id == 16 as u32:
                                target_name_id = self.pool.intern("usize")
                            else:
                                // No name and not a builtin primitive: a STRUCTURAL type
                                // such as `[i32; 3]`. "type_val" is a placeholder that
                                // resolves to nothing, so this substitution can only be
                                // recovered from the stashed type_id below.
                                target_name_id = self.pool.intern("type_val")
                                unnameable = true
                        node.payload = target_name_id
                        if kind == NODE_TYPE_EXPR or kind == NODE_IDENT:
                            node.flags = node.flags | FLAG_IS_SUBSTITUTED
                            // Tuple synth-structs (`__tupN`) are registered in the type
                            // table but have NO resolvable symbol, and every N-tuple
                            // shares the name `__tupN` regardless of element types. So the
                            // name-based substitution above (payload = name_id) cannot be
                            // resolved back to the exact type by the type-checker (it maps
                            // to UNKNOWN â†’ a scalar `t0` param â†’ wrong field offsets, e.g.
                            // `.1` reads `.0`). Stash the EXACT concrete type_id in
                            // extra_idx so the resolver can recover it directly. Guarded to
                            // `__tup` so every other (name-resolvable) substitution is
                            // byte-identical to before.
                            let sub_nm = self.pool.get(entry.name_id)
                            // ...and the same applies to any type that has NO name at all:
                            // a structural `[i32; 3]` array type argument fell through to
                            // the "type_val" placeholder above, so `Option[[i32;3]]`
                            // monomorphized with an EMPTY variant payload_type. The pattern
                            // var then went untyped, `pl_type` defaulted to i64 and
                            // OP_INDEX read the array at stride 8 â€” `arr[0]+arr[1]+arr[2]`
                            // returned 8 instead of 48. (`[i64;3]` was correct only because
                            // 8 happens to be i64's size.) The consumer side already
                            // recovers extra_idx generically, keyed on the name having
                            // failed to resolve, so only this producer guard was missing.
                            if std.string.starts_with(sub_nm, "__tup") or unnameable:
                                node.extra_idx = type_id
                else:
                    mut is_local := false
                    mut is_global_sym := false
                    let orig_sym_idx = orig_node.payload
                    if orig_sym_idx != 0 as u32 and (orig_sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[orig_sym_idx as i64]
                        if sym.name_id == name_id:
                            if sym.kind == 0 as u8 or sym.kind == 6 as u8 or sym.kind == 8 as u8:
                                is_local = true
                            else:
                                is_global_sym = true
                    if is_local:
                        node.payload = name_id
                    else:
                        node.payload = orig_node.payload
                        if is_global_sym:
                            node.flags = node.flags | 4096 as u16
            else:
                node.payload = name_id
    elif kind == NODE_FIELD_EXPR:
        // BUG#63: a resolved method/variant field-expr in the template carries the
        // resolved SYMBOL in payload with flag 2048 set (typecheck sets both when it
        // dispatches `recv.method`). substitute_type_params clears flag 2048 (line 75)
        // but used to copy the stale symbol payload verbatim â€” leaving the clone with
        // (payload = template method symbol, flag 2048 CLEARED). The clone's typecheck
        // then MISREADS that symbol id as a field NAME id, resolve_method_sym fails, and
        // the method call silently degrades to a plain `getfld` + indirect call â†’ segfault
        // (a generic method invoked on a generic-typed value inside a generic body, e.g.
        // Vec/HashMap internals). The clone's receiver type is CONCRETE (vs the template's
        // generic type), so it must RE-RESOLVE the method fresh: reset the payload to the
        // field NAME id. Modules (SYM_MODULE) keep their payload â€” the name resolver
        // re-fixes module field-exprs on the clone; only method/variant dispatch is reset.
        mut fe_payload := orig_node.payload
        if (orig_node.flags & 2048 as u16) != 0 as u16 and orig_node.payload != 0 as u32 and (orig_node.payload as i64) < self.symtable.symbols.len:
            let rsym = self.symtable.symbols.data[orig_node.payload as i64]
            if rsym.kind == 1 as u8 or rsym.kind == 5 as u8:  // SYM_FUNC / SYM_VARIANT
                fe_payload = rsym.name_id
        node.payload = fe_payload
    elif (kind == NODE_INT_LIT or kind == NODE_FLOAT_LIT or kind == NODE_STRING_LIT or
          kind == NODE_CHAR_LIT or kind == NODE_BOOL_LIT or kind == NODE_NIL_LIT):
        node.payload = orig_node.payload
    else:
        node.payload = 0 as u32

    // Walk children in parallel
    mut child := node.first_child
    mut orig_child := orig_node.first_child
    while child != 0 as u32 and orig_child != 0 as u32:
        self.substitute_type_params(child, orig_child, src_tree, subst)
        child = self.tree.nodes.data[child].next_sibling
        orig_child = src_tree.nodes.data[orig_child].next_sibling

pub fn remove_generic_params_child(mut self: ptr[Monomorphizer], node_idx: u32):
    mut node := &self.tree.nodes.data[node_idx]
    mut prev := 0 as u32
    mut curr := node.first_child

    while curr != 0 as u32:
        if self.tree.nodes.data[curr].kind == NODE_GENERIC_PARAMS:
            let next = self.tree.nodes.data[curr].next_sibling
            if prev == 0 as u32:
                node.first_child = next
            else:
                self.tree.nodes.data[prev].next_sibling = next
            break
        prev = curr
        curr = self.tree.nodes.data[curr].next_sibling

pub fn u32_to_str(val: u32) -> str:
    if val == 0 as u32:
        return "0"
    mut temp_val := val
    mut len := 0 as i64
    mut temp := val
    while temp > 0 as u32:
        len = len + 1 as i64
        temp = temp / 10 as u32
    mut buf := @alloc(len + 1 as i64) as ptr[u8]
    buf[len] = 0 as u8
    mut idx := len - 1 as i64
    while temp_val > 0 as u32:
        let digit = temp_val % 10 as u32
        buf[idx] = (digit + 48 as u32) as u8
        temp_val = temp_val / 10 as u32
        idx = idx - 1 as i64
    return buf as str

pub fn get_type_name_recursive(self: ptr[Monomorphizer], type_id: u32) -> str:
    if (type_id as i64) >= self.typetable.entries.len:
        return "unknown"
    let entry = self.typetable.entries.data[type_id]
    // `TypeEntry.name_id` does NOT always hold a name. `register_array` stores the array
    // LENGTH there and `register_result` stores the ERR TYPE ID, so reading it as an intern
    // id yields an unrelated string â€” and, worse, the SAME string for every array of that
    // length. `[i32; 2]` and `[i64; 2]` both mangled to `Box__T` (intern id 2 happened to be
    // the generic param name), so two instantiations differing only in element type SHARED
    // one monomorphized struct: the second reused the first's layout and its elements were
    // stored at the wrong stride, or a scalar-element and a struct-element array merged and
    // the aggregate-vs-scalar disagreement segfaulted.
    // The structural branches further down already build correct names (`arr_<len>_<elem>`);
    // they were simply unreachable because this early return fired first. Third instance of
    // this footgun â€” see the audit in knowledge/bug-array-typearg-mono-payload.
    mut name_is_real := true
    if entry.kind == 3 as u8 or entry.kind == 12 as u8: // ARRAY (length) / RESULT (err type)
        name_is_real = false
    if entry.name_id != 0 as u32 and name_is_real:
        // Tuple synth-structs all share the bare name `__tupN` regardless of their
        // element types, so two distinct tuple type arguments (e.g. (i32,i32) vs
        // (i64,i64)) would mangle to the SAME instance name and the second generic
        // call would wrongly reuse the first instance. Encode the element types so
        // each distinct tuple shape gets a distinct mangled name.
        let tnm = self.pool.get(entry.name_id)
        if entry.kind == 1 as u8 and std.string.starts_with(tnm, "__tup") and (entry.extra as i64) < self.typetable.structs.len:
            let sinfo = self.typetable.structs.data[entry.extra as i64]
            mut acc := std.string.concat("", tnm)
            mut fi := 0 as i64
            while fi < sinfo.fields.len:
                acc = std.string.concat(acc, "_")
                acc = std.string.concat(acc, self.get_type_name_recursive(sinfo.fields.data[fi].type_id))
                fi = fi + 1 as i64
            return acc
        return tnm

    // Prepopulated primitive types fallback
    if type_id == 0 as u32:
        return "unknown"
    elif type_id == 1 as u32:
        return "i8"
    elif type_id == 2 as u32:
        return "i16"
    elif type_id == 3 as u32:
        return "i32"
    elif type_id == 4 as u32:
        return "i64"
    elif type_id == 5 as u32:
        return "u8"
    elif type_id == 6 as u32:
        return "u16"
    elif type_id == 7 as u32:
        return "u32"
    elif type_id == 8 as u32:
        return "u64"
    elif type_id == 9 as u32:
        return "f32"
    elif type_id == 10 as u32:
        return "f64"
    elif type_id == 11 as u32:
        return "bool"
    elif type_id == 12 as u32:
        return "string"
    elif type_id == 13 as u32:
        return "char8"
    elif type_id == 14 as u32:
        return "void"
    elif type_id == 15 as u32:
        return "isize"
    elif type_id == 16 as u32:
        return "usize"

    let kind = entry.kind
    if kind == 9 as u8: // TYPE_KIND_POINTER
        let inner_name = self.get_type_name_recursive(entry.extra)
        return std.string.concat("ptr_", inner_name)
    elif kind == 10 as u8: // TYPE_KIND_REF
        let inner_name = self.get_type_name_recursive(entry.extra)
        return std.string.concat("ref_", inner_name)
    elif kind == 4 as u8: // TYPE_KIND_SLICE
        let inner_name = self.get_type_name_recursive(entry.extra)
        return std.string.concat("slice_", inner_name)
    elif kind == 3 as u8: // TYPE_KIND_ARRAY
        let inner_name = self.get_type_name_recursive(entry.extra)
        let len_str = u32_to_str(entry.name_id)
        let first = std.string.concat("arr_", len_str)
        let second = std.string.concat(first, "_")
        return std.string.concat(second, inner_name)
    elif kind == 12 as u8: // TYPE_KIND_RESULT â€” name_id is the ERR type, extra the OK type
        let ok_name = self.get_type_name_recursive(entry.extra)
        let err_name = self.get_type_name_recursive(entry.name_id)
        let r_first = std.string.concat("res_", ok_name)
        let r_second = std.string.concat(r_first, "_")
        return std.string.concat(r_second, err_name)
    elif kind == 11 as u8: // TYPE_KIND_OPTION â€” unnamed; without this every Option
        // type argument mangled to the shared fallback "type" below, merging
        // `Option[i64]` and `Option[str]` instantiations into one.
        let opt_inner = self.get_type_name_recursive(entry.extra)
        return std.string.concat("opt_", opt_inner)
    elif kind == 2 as u8: // TYPE_KIND_FUNC
        if (entry.extra as i64) < self.typetable.funcs.len:
            let f_info = self.typetable.funcs.data[entry.extra]
            mut res_str := "func_"
            res_str = std.string.concat(res_str, self.get_type_name_recursive(f_info.ret))
            res_str = std.string.concat(res_str, "_args")
            mut p_idx := 0 as i64
            while p_idx < f_info.params.len:
                let p_name = self.get_type_name_recursive(f_info.params.data[p_idx])
                res_str = std.string.concat(res_str, "_")
                res_str = std.string.concat(res_str, p_name)
                p_idx = p_idx + 1 as i64
            return res_str

    return "type"

pub fn mangle_name(self: ptr[Monomorphizer], orig_name: str, args: U32Vec) -> str:
    mut mangled := ""
    if std.string.starts_with(orig_name, "_AX_"):
        mangled = std.string.concat("", orig_name)
    else:
        mangled = std.string.concat("_AX_std_", orig_name)

    mut idx := 0 as i64
    while idx < args.len:
        let arg_type = args.data[idx]
        let name_str = self.get_type_name_recursive(arg_type)
        mangled = std.string.concat(mangled, "__")
        mangled = std.string.concat(mangled, name_str)
        idx = idx + 1 as i64
    return mangled

// BUG#61b: distinct generic FUNC templates sharing one name (overloads, e.g.
// get[T](Vec[T], i64) -> Option[T] vs get[T](MutexGuard[T]) -> T) mangled to the
// SAME instance name for equal type args (_AX_std_get__i32), so the second
// overload's call site silently REUSED the first overload's instantiation â€”
// wrong signature, wrong return type â€” and native method dispatch on that result
// segfaulted (Vec[T].get(i).unwrap()). Discriminate the instance name with a
// stable, source-derived tag: the base identifier of the template's FIRST param
// type (the receiver for methods) â€” or of the return type for zero-param
// templates â€” plus the declared param count. The tag is APPENDED so
// air_builder's `_AX_std_<method>__` prefix matching still sees the method name.
// Structs cannot be overloaded: non-FUNC templates get an empty tag (struct
// instance names like Vec__i32 are matched by base name across the compiler).
pub fn overload_tag(self: ptr[Monomorphizer], template_sym_id: u32) -> str:
    if template_sym_id == 0 as u32 or (template_sym_id as i64) >= self.symtable.symbols.len:
        return ""
    let tsym = self.symtable.symbols.data[template_sym_id]
    let decl = tsym.decl_node
    if decl == 0 as u32 or decl == 0xffffffff as u32:
        return ""
    mut src_tree := self.tree
    if (template_sym_id as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[template_sym_id]
        if t != null as ptr[AstTree]:
            src_tree = t
    if (decl as i64) >= src_tree.nodes.len:
        return ""
    if src_tree.nodes.data[decl].kind != NODE_FUNC_DECL:
        return ""
    mut first_param_type := 0 as u32
    mut ret_type_node := 0 as u32
    mut param_count := 0 as u32
    mut c := src_tree.nodes.data[decl].first_child
    while c != 0 as u32:
        let cn = src_tree.nodes.data[c]
        if cn.kind == NODE_PARAM_DECL:
            if first_param_type == 0 as u32:
                first_param_type = cn.first_child
            param_count = param_count + 1 as u32
        elif cn.kind == NODE_TYPE_EXPR or cn.kind == NODE_GENERIC_TYPE:
            if ret_type_node == 0 as u32:
                ret_type_node = c
        c = cn.next_sibling
    mut base_node := first_param_type
    if base_node == 0 as u32:
        base_node = ret_type_node
    // NOTE: intermediates below are not freed â€” u32_to_str(0) and node_text can
    // return string LITERALS, and freeing a literal is fatal. mangle_name leaks
    // its concat intermediates the same way.
    let count_str = u32_to_str(param_count)
    mut tag := std.string.concat("__o", count_str)
    if base_node != 0 as u32:
        // node_text of a type node yields its base identifier token (for
        // NODE_GENERIC_TYPE like Vec[T] the token is the base ident `Vec`).
        let base = self.node_text(src_tree, base_node)
        tag = std.string.concat(tag, base)
    return tag

// mangle_name + overload_tag. Every site that computes an instance name for a
// generic template (lookup or instantiation) must use THIS so lookups and
// registrations agree on one name per template.
pub fn mangle_name_ov(self: ptr[Monomorphizer], template_sym_id: u32, orig_name: str, args: U32Vec) -> str:
    let base = self.mangle_name(orig_name, args)
    let tag = self.overload_tag(template_sym_id)
    if std.string.len(tag) == 0:
        return base
    return std.string.concat(base, tag)

pub fn instantiate_function(mut self: ptr[Monomorphizer], template_sym_id: u32, args: U32Vec) -> u32:
    if (template_sym_id as i64) >= self.symtable.symbols.len:
        return 0 as u32
    
    let orig_sym = self.symtable.symbols.data[template_sym_id]
    let node_idx = orig_sym.decl_node
    if node_idx == 0 as u32:
        return 0 as u32

    // Find the correct source AstTree for the generic template
    mut src_tree := self.tree
    if (template_sym_id as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[template_sym_id]
        if t != null as ptr[AstTree]:
            src_tree = t

    // 1. Clone generic AST subtree from the correct source tree
    let cloned_root = self.tree.clone_subtree_from(src_tree, node_idx)

    let orig_name = self.pool.get(orig_sym.name_id)
    let mangled = self.mangle_name_ov(template_sym_id, orig_name, args)
    let mangled_id = self.pool.intern(mangled)

    mut struct_type_id := 0 as u32
    let cloned_kind = self.tree.nodes.data[cloned_root].kind
    if cloned_kind == NODE_STRUCT_DECL:
        struct_type_id = self.typetable.register_struct(mangled_id, StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0))
        self.typetable.set_struct_generic_args(struct_type_id, args)
    self.struct_type_id = struct_type_id

    // 2. Build type substitution map from original params using source tree
    mut subst := TypeSubstVec(data: null as ptr[TypeSubst], len: 0, cap: 0)
    if cloned_kind == NODE_STRUCT_DECL:
        subst.push(TypeSubst(name_id: orig_sym.name_id, type_id: struct_type_id))

    mut curr := src_tree.nodes.data[node_idx].first_child
    while curr != 0 as u32:
        if src_tree.nodes.data[curr].kind == NODE_GENERIC_PARAMS:
            mut gp := src_tree.nodes.data[curr].first_child
            mut idx := 0 as i64
            while gp != 0 as u32 and idx < args.len:
                mut gp_name_id := src_tree.nodes.data[gp].payload
                if src_tree == self.tree:
                    if gp_name_id != 0 as u32 and (gp_name_id as i64) < self.symtable.symbols.len:
                        gp_name_id = self.symtable.symbols.data[gp_name_id].name_id
                else:
                    let text = self.node_text(src_tree, gp)
                    gp_name_id = self.pool.intern(text)
                    @free(get_str_ptr(text))
                subst.push(TypeSubst(name_id: gp_name_id, type_id: args.data[idx]))
                gp = src_tree.nodes.data[gp].next_sibling
                idx = idx + 1 as i64
            break
        curr = src_tree.nodes.data[curr].next_sibling

    // 3. Substitute type parameters in cloned AST
    self.substitute_type_params(cloned_root, node_idx, src_tree, subst)

    // 4. Remove generic flag and generic parameters node
    self.tree.nodes.data[cloned_root].flags = self.tree.nodes.data[cloned_root].flags & (~FLAG_IS_GENERIC)
    self.remove_generic_params_child(cloned_root)

    // 5. Mangle name and update payload to mangled name_id
    self.tree.nodes.data[cloned_root].payload = mangled_id

    @free(subst.data as ptr[u8])
    return cloned_root
// bootstrap/stage1/typecheck.ax
// AXIOM self-hosted Type Table and Type Checker implementation.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64
// extern "C" fn sprintf(buf: ptr[u8], format: ptr[u8], val: f64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64



pub fn strip_quotes(s: str) -> str:
    let len = std.string.len(s)
    // RFC 0024: block string `"""..."""` â€” strip 3 delimiter chars each side.
    if len >= 6 and s[0] as u8 == '"' as u8 and s[1] as u8 == '"' as u8 and s[2] as u8 == '"' as u8 and s[len - 1] as u8 == '"' as u8 and s[len - 2] as u8 == '"' as u8 and s[len - 3] as u8 == '"' as u8:
        let ptr_start3 = ((s as ptr[u8]) as i64 + 3 as i64) as ptr[u8]
        return alloc_str_from_raw(ptr_start3, len - 6)
    if len >= 2 and s[0] as u8 == '"' as u8 and s[len - 1] as u8 == '"' as u8:
        let ptr_start = ((s as ptr[u8]) as i64 + 1 as i64) as ptr[u8]
        return alloc_str_from_raw(ptr_start, len - 2)
    return s

pub fn format_int(val: i64) -> str:
    if val == 0 as i64:
        let buf = @alloc(2) as ptr[u8]
        buf[0] = '0' as u8
        buf[1] = 0 as u8
        let result = alloc_str_from_raw(buf, 1)
        @free(buf)
        return result
    if val == -9223372036854775808 as i64:
        let s = "-9223372036854775808"
        let len = std.string.len(s)
        let buf = @alloc(len + 1) as ptr[u8]
        @memcpy(buf, s as ptr[u8], len)
        buf[len] = 0 as u8
        let result = alloc_str_from_raw(buf, len)
        @free(buf)
        return result
    mut temp := val
    mut is_neg := false
    if val < 0 as i64:
        is_neg = true
        temp = 0 as i64 - val
    let buf = @alloc(24) as ptr[u8]
    mut len := 0
    while temp > 0 as i64:
        let rem = (temp % 10 as i64) as u8
        buf[len] = ('0' as u8 + rem)
        len = len + 1
        temp = temp / 10 as i64
    if is_neg:
        buf[len] = '-' as u8
        len = len + 1
    mut i := 0
    mut j := len - 1
    while i < j:
        let tmp = buf[i]
        buf[i] = buf[j]
        buf[j] = tmp
        i = i + 1
        j = j - 1
    buf[len] = 0 as u8
    let result = alloc_str_from_raw(buf, len as i64)
    @free(buf)
    return result

pub fn format_float(val: f64) -> str:
    let buf = @alloc(64) as ptr[u8]
    ax_sprintf_local(buf, "%g" as ptr[u8], val)
    let len = strlen(buf)
    let result = alloc_str_from_raw(buf, len)
    @free(buf)
    return result

pub struct TypeChecker:
    tree: ptr[AstTree]
    intern: ptr[InternPool]
    symtable: ptr[SymbolTable]
    types: ptr[TypeTable]
    node_types: ptr[u32]
    node_types_cap: i64
    current_return: u32
    current_match_scrutinee: u32
    // True while type-checking the body of a GENERIC function/method. A generic
    // call that leaves a type param bound to a generic placeholder legitimately
    // DEFERS to monomorphization ONLY inside a generic body; in a CONCRETE body
    // the same situation means the param is genuinely un-inferable and the deferred
    // call is never instantiated -> segfault. This flag lets the defer site reject.
    current_fn_is_generic: bool
    pub diags_count: i64

pub fn new_type_checker(tree: ptr[AstTree], intern: ptr[InternPool], symtable: ptr[SymbolTable], types: ptr[TypeTable]) -> ptr[TypeChecker]:
    let node_count = tree.nodes.len
    mut initial_cap := node_count
    if initial_cap < 16 as i64:
        initial_cap = 16 as i64
    let node_types = @alloc(initial_cap * 4) as ptr[u32]
    mut i := 0 as i64
    while i < initial_cap:
        node_types[i] = 0 as u32
        i = i + 1
    let tc = @alloc(@compiler_intrinsic("size_of")[TypeChecker]()) as ptr[TypeChecker]
    tc.tree = tree
    tc.intern = intern
    tc.symtable = symtable
    tc.types = types
    tc.node_types = node_types
    tc.node_types_cap = initial_cap
    tc.current_return = 0 as u32
    tc.current_match_scrutinee = 0 as u32
    tc.current_fn_is_generic = false
    tc.diags_count = 0 as i64
    return tc

pub fn is_generic(self: ptr[TypeChecker], type_id: u32) -> bool:
    if type_id == TYPE_UNKNOWN:
        return true
    if (type_id as i64) >= self.types.entries.len:
        return false
    let entry = self.types.entries.data[type_id as i64]
    if entry.kind == TYPE_KIND_GENERIC:
        return true
    if entry.kind == TYPE_KIND_POINTER:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_REF:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_SLICE:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_ARRAY:
        return self.is_generic(entry.extra)
    if entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
        let args = self.get_generic_args(type_id)
        mut idx := 0 as i64
        mut has_gen := false
        while idx < args.len:
            let arg_t = args.data[idx]
            if self.is_generic(arg_t):
                has_gen = true
                break
            idx = idx + 1
        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
        return has_gen
    // A tuple synth-struct `__tupN` has no name-resolvable identity, so its element
    // types are its only signature. A `__tup` whose field is still a generic param
    // (e.g. `(i64, T)` = `__tup{i64, T}` in a generic body) is itself GENERIC â€” but the
    // generic struct-instantiation / method-dispatch paths only see it as a plain STRUCT
    // and would treat it as concrete, baking a `Vec[generic __tup]` instance and binding
    // `T â†’ __tup{i64,T}` (a param bound to a tuple containing itself). That bogus concrete
    // instance leaves the receiver generic, so a method call on it (`out.push`) is never
    // bound and the backend degrades to an indirect `getfld+call` â†’ SIGSEGV. Recursing
    // into `__tup` fields here makes such a tuple correctly report generic, so those paths
    // DEFER until the element is truly concrete. Scoped to `__tup` (structural, no symbol)
    // so ordinary named structs are unaffected.
    if entry.kind == TYPE_KIND_STRUCT and (entry.extra as i64) < self.types.structs.len:
        let nm = self.intern.get(entry.name_id)
        let is_tup = std.string.starts_with(nm, "__tup")
        safe_free_str(nm)
        if is_tup:
            let sinfo = self.types.structs.data[entry.extra as i64]
            mut fi := 0 as i64
            while fi < sinfo.fields.len:
                if self.is_generic(sinfo.fields.data[fi].type_id):
                    return true
                fi = fi + 1 as i64
    return false

pub fn parse_type_from_name(self: ptr[TypeChecker], name: str) -> u32:
    if std.string.starts_with(name, "ptr_"):
        let rest = std.string.slice(name, 4, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_pointer(inner)
    elif std.string.starts_with(name, "ref_"):
        let rest = std.string.slice(name, 4, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_pointer(inner)
    elif std.string.starts_with(name, "slice_"):
        let rest = std.string.slice(name, 6, std.string.len(name))
        let inner = self.parse_type_from_name(rest)
        return self.types.register_slice(inner)
    elif std.string.starts_with(name, "arr_"):
        let len_str_start = 4 as i64
        mut len_str_end := len_str_start
        let name_len = std.string.len(name)
        let ptr_name = get_str_ptr(name)
        while len_str_end < name_len and ptr_name[len_str_end] != '_' as u8:
            len_str_end = len_str_end + 1 as i64
        if len_str_end < name_len:
            let len_str = std.string.slice(name, len_str_start, len_str_end)
            mut arr_len := 0 as u32
            mut idx := 0 as i64
            let ptr_len = get_str_ptr(len_str)
            let len_len = std.string.len(len_str)
            while idx < len_len:
                arr_len = arr_len * 10 as u32 + (ptr_len[idx] - 48 as u8) as u32
                idx = idx + 1 as i64
            
            let rest = std.string.slice(name, len_str_end + 1 as i64, name_len)
            let inner = self.parse_type_from_name(rest)
            return self.types.register_array(inner, arr_len)

    if name == "i8":
        return 1 as u32
    elif name == "i16":
        return 2 as u32
    elif name == "i32":
        return 3 as u32
    elif name == "i64":
        return 4 as u32
    elif name == "u8":
        return 5 as u32
    elif name == "u16":
        return 6 as u32
    elif name == "u32" or name == "rune":
        return 7 as u32
    elif name == "u64":
        return 8 as u32
    elif name == "f32":
        return 9 as u32
    elif name == "f64":
        return 10 as u32
    elif name == "bool":
        return 11 as u32
    elif name == "string" or name == "str":
        return 12 as u32
    elif name == "bytes":
        return 22 as u32
    elif name == "char8":
        return 13 as u32
    elif name == "void":
        return 14 as u32
    elif name == "isize":
        return 15 as u32
    elif name == "usize":
        return 16 as u32

    // First, try resolving via SymbolTable
    let name_id = self.intern.intern_string(name)
    let sym_idx = self.symtable.resolve(name_id)
    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[sym_idx]
        if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
            sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
            sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
            if sym.type_id != 0 as u32:
                return sym.type_id

    // TypeTable Lookup
    mut t_idx := 0 as i64
    while t_idx < self.types.entries.len:
        let t_entry = self.types.entries.data[t_idx]
        if t_entry.name_id != 0 as u32:
            let t_name = self.intern.get(t_entry.name_id)
            if t_name == name:
                return t_idx as u32
        t_idx = t_idx + 1 as i64

    return 0 as u32

pub fn get_generic_args(self: ptr[TypeChecker], type_id: u32) -> U32Vec:
    mut out_args := new_u32_vec()
    if (type_id as i64) >= self.types.entries.len:
        return out_args
    let entry = self.types.entries.data[type_id as i64]
    if entry.kind == TYPE_KIND_GENERIC_INST:
        let inst_idx = entry.extra
        let inst_args = &self.types.generic_insts.data[inst_idx as i64]
        mut j := 0 as i64
        while j < inst_args.len:
            out_args.push(inst_args.data[j])
            j = j + 1
        return out_args

    if entry.kind == TYPE_KIND_STRUCT and (entry.extra as i64) < self.types.structs.len:
        let struct_args = &self.types.structs.data[entry.extra as i64].generic_args
        if struct_args.len > 0 as i64:
            mut k := 0 as i64
            while k < struct_args.len:
                out_args.push(struct_args.data[k])
                k = k + 1
            return out_args

    if entry.kind == TYPE_KIND_SUM and (entry.extra as i64) < self.types.sumtypes.len:
        let sum_args = &self.types.sumtypes.data[entry.extra as i64].generic_args
        if sum_args.len > 0 as i64:
            mut m := 0 as i64
            while m < sum_args.len:
                out_args.push(sum_args.data[m])
                m = m + 1
            return out_args

    return self.get_generic_args_from_mangled(type_id)

pub fn get_generic_args_from_mangled(self: ptr[TypeChecker], type_id: u32) -> U32Vec:
    mut out_args := new_u32_vec()
    if (type_id as i64) >= self.types.entries.len:
        return out_args
    let entry = self.types.entries.data[type_id as i64]
    if entry.name_id == 0 as u32:
        return out_args
    let name_str = self.intern.get(entry.name_id)
    let len = std.string.len(name_str)
    
    // Find the first "__" in the mangled name
    mut temp_end := 0 as i64
    if len > 4 as i64 and name_str[0] as u8 == 'a' as u8 and name_str[1] as u8 == 'x' as u8 and name_str[2] as u8 == '_' as u8 and name_str[3] as u8 == '_' as u8:
        temp_end = 4 as i64
    while temp_end < len - 1 as i64:
        if name_str[temp_end] as u8 == '_' as u8 and name_str[temp_end + 1 as i64] as u8 == '_' as u8:
            break
        temp_end = temp_end + 1 as i64
        
    if temp_end >= len - 1 as i64:
        return out_args
        
    mut arg_start := temp_end + 2 as i64
    while arg_start < len:
        mut arg_end := arg_start
        while arg_end < len - 1 as i64:
            if name_str[arg_end] as u8 == '_' as u8 and name_str[arg_end + 1 as i64] as u8 == '_' as u8:
                break
            arg_end = arg_end + 1 as i64
        if arg_end == len - 1 as i64:
            arg_end = len
            
        let arg_len = arg_end - arg_start
        if arg_len > 0 as i64:
            mut arg_name_buf := @alloc(arg_len + 1 as i64) as ptr[u8]
            @memcpy(arg_name_buf, ((get_str_ptr(name_str) as i64) + arg_start) as ptr[u8], arg_len)
            arg_name_buf[arg_len] = 0 as u8
            let arg_name := arg_name_buf as str
            
            let arg_type_id = self.parse_type_from_name(arg_name)
            if arg_type_id != 0 as u32:
                out_args.push(arg_type_id)
                
            @free(arg_name_buf)
        arg_start = arg_end + 2 as i64

    return out_args

// BUG#67: an unqualified generic-sum-type variant constructor call
// (Some(x)/Ok(x)/Err(x)) previously kept the bare TEMPLATE sum type_id for
// its result (T/E still generic placeholders) instead of a concrete
// instantiation. get_generic_args() on that bare template later finds no
// real args and falls to the ambiguous mangled-name fallback (or nothing at
// all here, since the template's name is plain "Option"/"Result"), so a
// later generic call like `.unwrap()` can't recover T and silently defaults
// to i32 (same fallback as BUG#66) -- fine for scalars that happen to fit,
// corrupts anything else (segfaults for a struct payload, since the field
// layout is lost entirely).
//
// Fix: when the constructed sum type is GENERIC, match each payload
// type-expr of the specific variant being called (e.g. the lone "T" in
// `Some(T)`, or "E" in `Err(E)`) against the alias's own ordered generic
// params BY NAME, and register a real GENERIC_INST using the call
// argument's actual inferred type for whichever params we can bind this
// way. Params we can't bind from this call (e.g. E when calling Ok(x) on a
// Result[T,E]) stay TYPE_UNKNOWN -- unresolved, not wrong; this call alone
// cannot know them, same limit as any partial generic inference.
pub fn try_instantiate_variant_call(mut self: ptr[TypeChecker], callee: u32, sum_type_id: u32, expected: u32) -> u32:
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return sum_type_id
    let vsym_idx = self.tree.nodes.data[callee].payload
    if vsym_idx == 0 as u32 or (vsym_idx as i64) >= self.symtable.symbols.len:
        return sum_type_id
    let vsym = self.symtable.symbols.data[vsym_idx as i64]
    if vsym.kind != SYM_VARIANT or vsym.decl_node == 0 as u32:
        return sum_type_id
    let first_call_arg = self.tree.nodes.data[callee].next_sibling
    if first_call_arg == 0 as u32:
        return sum_type_id

    if (sum_type_id as i64) >= self.types.entries.len:
        return sum_type_id
    let entry = self.types.entries.data[sum_type_id as i64]
    if entry.name_id == 0 as u32:
        return sum_type_id
    mut alias_sym_idx := self.symtable.resolve(entry.name_id)
    if alias_sym_idx == 0 as u32:
        alias_sym_idx = self.symtable.resolve_global_fallback(entry.name_id)
    if alias_sym_idx == 0 as u32 or (alias_sym_idx as i64) >= self.symtable.symbols.len:
        return sum_type_id
    let alias_sym = self.symtable.symbols.data[alias_sym_idx as i64]
    if alias_sym.decl_node == 0 as u32:
        return sum_type_id

    mut alias_tree := self.tree
    if (alias_sym_idx as i64) < self.symtable.symbol_trees.len:
        let at = self.symtable.symbol_trees.data[alias_sym_idx as i64]
        if at != null as ptr[AstTree]:
            alias_tree = at
    if (alias_tree.nodes.data[alias_sym.decl_node].flags & FLAG_IS_GENERIC) == 0 as u16:
        return sum_type_id

    // Ordered generic-param NAME ids of the alias, e.g. ["T"] for Option,
    // ["T", "E"] for Result.
    mut gp_name_ids := new_u32_vec()
    mut c := alias_tree.nodes.data[alias_sym.decl_node].first_child
    while c != 0 as u32:
        let cn = alias_tree.nodes.data[c]
        if cn.kind == NODE_GENERIC_PARAMS:
            mut gp := cn.first_child
            while gp != 0 as u32:
                let gp_name = self.node_text_in_tree(alias_tree, gp)
                gp_name_ids.push(self.intern.intern(gp_name))
                safe_free_str(gp_name)
                gp = alias_tree.nodes.data[gp].next_sibling
            break
        c = cn.next_sibling
    if gp_name_ids.len == 0 as i64:
        if gp_name_ids.data != null as ptr[u32]:
            @free(gp_name_ids.data as ptr[u8])
        return sum_type_id

    mut variant_tree := self.tree
    if (vsym_idx as i64) < self.symtable.symbol_trees.len:
        let vt = self.symtable.symbol_trees.data[vsym_idx as i64]
        if vt != null as ptr[AstTree]:
            variant_tree = vt

    mut args := new_u32_vec()
    mut ai := 0 as i64
    while ai < gp_name_ids.len:
        args.push(TYPE_UNKNOWN)
        ai = ai + 1

    // Expected-type coercion hint (tuple-literal payload fix): when the caller
    // supplies a concrete instantiation of this same alias as the expected type
    // (`Some((10,20))` where the context wants `Option[(i64,i64)]`), its generic
    // args are ordered identically to the alias's generic params. Passing the
    // matching arg as the payload's expected-type hint lets the NODE_TUPLE_EXPR
    // coercion (and int/float-literal widening) fire, so `(10,20)` builds a
    // `{i64,i64}` (16B) tuple instead of the default `{i32,i32}` (8B) that then
    // read its second field as garbage. Empty/mismatched expected â†’ no hint,
    // identical to the prior behaviour.
    mut exp_args := self.get_generic_args(expected)

    // When `expected` is a CONCRETE monomorphized SUM (kind 6) rather than a GENERIC_INST,
    // get_generic_args often returns EMPTY -- a Vec-element sum's generic_args is never
    // populated and the mangled-name fallback can't recover a nested tuple payload. Recover
    // the payload coercion hint DIRECTLY from the matching variant's concrete payload_type in
    // the sum, so `Vec[Option[(i64,i64)]].push(Some((20,22)))` widens its inner tuple. Only
    // used as a fallback when exp_args yields nothing for a param, and only for a SINGLE-payload
    // variant (its payload_type is the actual type; a multi-field RFC 0019 variant carries a
    // flagged synth struct, left to the exp_args path). The __tup coercion self-guards, so this
    // is inert unless the arg is genuinely an under-widened aggregate literal.
    mut concrete_variant_payload := TYPE_UNKNOWN
    if expected != TYPE_UNKNOWN and (expected as i64) < self.types.entries.len:
        let xe = self.types.entries.data[expected as i64]
        if xe.kind == TYPE_KIND_SUM and (xe.extra as i64) < self.types.sumtypes.len:
            let xsi = self.types.sumtypes.data[xe.extra as i64]
            mut vvi := 0 as i64
            while vvi < xsi.variants.len:
                if xsi.variants.data[vvi as i64].name_id == vsym.name_id:
                    let cp = xsi.variants.data[vvi as i64].payload_type
                    if cp != TYPE_UNKNOWN and (cp as i64) < self.types.entries.len:
                        // Exclude a flagged (RFC 0019 multi-field / str-wrap) synth struct.
                        if not (self.types.entries.data[cp as i64].kind == TYPE_KIND_STRUCT and (self.types.entries.data[cp as i64].flags & 1 as u16) != 0 as u16):
                            concrete_variant_payload = cp
                    break
                vvi = vvi + 1

    mut bound_any := false
    mut payload_node := variant_tree.nodes.data[vsym.decl_node].first_child
    mut call_arg := first_call_arg
    while payload_node != 0 as u32 and call_arg != 0 as u32:
        let payload_name = self.node_text_in_tree(variant_tree, payload_node)
        let payload_name_id = self.intern.intern(payload_name)
        safe_free_str(payload_name)
        mut gi := 0 as i64
        while gi < gp_name_ids.len:
            if gp_name_ids.data[gi] == payload_name_id:
                // Prefer concrete_variant_payload (the matching variant's payload_type read
                // DIRECTLY from the concrete monomorphized sum) over exp_args: for a nested
                // tuple payload the mangled-name-derived exp_args can be INCOMPLETE/mis-ordered
                // (Result[(i64,i64),i64] parses to just [i64], so exp_args[0] wrongly gives i64
                // for the Ok(T) param and drops the tuple). cvp is authoritative for the
                // single-payload variant being constructed. Fall back to exp_args only when cvp
                // is unavailable (generic-inst expected, or a multi-field synth-struct payload).
                mut exp_hint := TYPE_UNKNOWN
                if concrete_variant_payload != TYPE_UNKNOWN and not self.is_generic(concrete_variant_payload):
                    exp_hint = concrete_variant_payload
                elif gi < exp_args.len and exp_args.data[gi] != TYPE_UNKNOWN and not self.is_generic(exp_args.data[gi]):
                    exp_hint = exp_args.data[gi]
                let concrete = self.infer_node(call_arg, exp_hint)
                if concrete != TYPE_UNKNOWN and not self.is_generic(concrete):
                    mut binding := concrete
                    // RFC 0029: when the declared payload is an INTERFACE the concrete
                    // struct payload conforms to (`let o: Option[Shape] = Some(Sq(..))`),
                    // bind the type param to the INTERFACE, not the concrete struct, so the
                    // ctor node types as Option[I]/Result[I]. air_builder reads that and boxes
                    // the payload into an interface value; without it `o.unwrap().area()`
                    // dispatches through a raw struct pointer -> SIGSEGV. Gated on conformance
                    // so any non-conforming / non-interface case keeps the concrete binding.
                    if exp_hint != TYPE_UNKNOWN and (exp_hint as i64) < self.types.entries.len and self.types.entries.data[exp_hint as i64].kind == TYPE_KIND_INTERFACE and (concrete as i64) < self.types.entries.len and self.types.entries.data[concrete as i64].kind == TYPE_KIND_STRUCT:
                        if self.interface_missing_method(concrete, exp_hint) == 0 as u32:
                            binding = exp_hint
                    args.data[gi] = binding
                    bound_any = true
                break
            gi = gi + 1
        payload_node = variant_tree.nodes.data[payload_node].next_sibling
        call_arg = self.tree.nodes.data[call_arg].next_sibling

    if exp_args.data != null as ptr[u32]:
        @free(exp_args.data as ptr[u8])
    if gp_name_ids.data != null as ptr[u32]:
        @free(gp_name_ids.data as ptr[u8])

    if not bound_any:
        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
        return sum_type_id

    return self.types.register_generic_inst(entry.name_id, args)

// A NON-generic user sum's variant constructor never received an expected type for its
// payload argument. `try_instantiate_variant_call` above threads a hint only INSIDE its
// generic-parameter binding loop, so for `type Shape = Pair((i64, i64))` the constructor
// `Pair((3, 40))` inferred its tuple literal with no expectation at all â€” and a bare int
// literal defaults to i32. That built an 8-byte {i32,i32} value for a 16-byte payload
// slot, so the match arm read field 1 past the end (`t.0 + t.1` returned 3, not 43).
// Declaring the payload `(i32, i32)` made the widths agree and the same program worked,
// which is what identified this as a width-coercion gap rather than a lowering bug.
//
// Re-infer the argument with the variant's DECLARED payload type so the literal's
// elements coerce â€” the same expected-type threading already done for struct-ctor fields
// (6132b15) and function params (f509506). Inert unless the arg is an under-widened
// aggregate literal: the coercion self-guards when the types already agree.
//
// Excluded: a flagged RFC 0019 synth struct (multi-field variant / str wrap), whose N
// call args map to N struct FIELDS and are handled as fields, not as one payload value;
// and a generic payload param, which the generic path above already binds.
pub fn coerce_variant_ctor_payload(mut self: ptr[TypeChecker], callee: u32, sum_type_id: u32):
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return
    let vsym_idx = self.tree.nodes.data[callee].payload
    if vsym_idx == 0 as u32 or (vsym_idx as i64) >= self.symtable.symbols.len:
        return
    let vsym = self.symtable.symbols.data[vsym_idx as i64]
    if vsym.kind != SYM_VARIANT:
        return
    let arg = self.tree.nodes.data[callee].next_sibling
    if arg == 0 as u32:
        return
    // A single payload argument only; multiple args are per-field (RFC 0019).
    if self.tree.nodes.data[arg].next_sibling != 0 as u32:
        return
    if (sum_type_id as i64) >= self.types.entries.len:
        return
    let se = self.types.entries.data[sum_type_id as i64]
    if se.kind != TYPE_KIND_SUM or (se.extra as i64) >= self.types.sumtypes.len:
        return
    let si = self.types.sumtypes.data[se.extra as i64]
    mut vi := 0 as i64
    while vi < si.variants.len:
        if si.variants.data[vi as i64].name_id == vsym.name_id:
            let pt = si.variants.data[vi as i64].payload_type
            if pt != TYPE_UNKNOWN and (pt as i64) < self.types.entries.len:
                let pe = self.types.entries.data[pt as i64]
                mut is_flagged := false
                if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16:
                    is_flagged = true
                if not is_flagged and not self.is_generic(pt):
                    let recoerced = self.infer_node(arg, pt)
            break
        vi = vi + 1

// A variant constructor's argument count was never checked. Every mismatch was accepted
// and produced garbage or a crash:
//   P(i64, i64)   built as P(3)        -> field 1 never written  (returned 3)
//   P(i64, i64)   built as P(3, 40, 5) -> extra arg silently dropped
//   P((i64,i64))  built as P(3, 40)    -> SIGSEGV
//   P(i64)        built as P(3, 40)    -> extra arg silently dropped
//   P(i64, i64)   built as P((3, 40))  -> garbage (127)
// All BUG#53 class. The expected count comes from the payload's SHAPE: a FLAGGED
// RFC 0019 synth struct (`__mfv_â€¦`, a multi-field variant or the >8B primitive wrap)
// takes one argument per FIELD; any other payload â€” including an UNFLAGGED `__tupâ€¦`
// tuple â€” is a single value taking exactly one argument; a payload-less variant takes
// none. That distinction is exactly the one the match-pattern arity check relies on.
pub fn check_variant_ctor_arity(mut self: ptr[TypeChecker], callee: u32, sum_type_id: u32):
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return
    let vsym_idx = self.tree.nodes.data[callee].payload
    if vsym_idx == 0 as u32 or (vsym_idx as i64) >= self.symtable.symbols.len:
        return
    let vsym = self.symtable.symbols.data[vsym_idx as i64]
    if vsym.kind != SYM_VARIANT:
        return
    if (sum_type_id as i64) >= self.types.entries.len:
        return
    let se = self.types.entries.data[sum_type_id as i64]
    if se.kind != TYPE_KIND_SUM or (se.extra as i64) >= self.types.sumtypes.len:
        return
    let si = self.types.sumtypes.data[se.extra as i64]
    mut found := false
    mut want := 0 as i64
    mut vi := 0 as i64
    while vi < si.variants.len:
        if si.variants.data[vi as i64].name_id == vsym.name_id:
            found = true
            let pt = si.variants.data[vi as i64].payload_type
            if pt != TYPE_UNKNOWN and (pt as i64) < self.types.entries.len:
                want = 1 as i64
                let pe = self.types.entries.data[pt as i64]
                if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16 and (pe.extra as i64) < self.types.structs.len:
                    want = self.types.structs.data[pe.extra as i64].fields.len
            break
        vi = vi + 1
    if not found:
        return
    mut got := 0 as i64
    mut a := self.tree.nodes.data[callee].next_sibling
    while a != 0 as u32:
        got = got + 1 as i64
        a = self.tree.nodes.data[a].next_sibling
    if got != want:
        ax_printf_local("error: variant constructor takes %d value(s) but %d were given\n", want, got, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.diags_count = self.diags_count + 1 as i64

// Substitute a template variant's generic payload param against the concrete
// type-args carried by a GENERIC_INST match scrutinee. An UNANNOTATED
// `let x = Some((a,b))` types as a GENERIC_INST (`Option[(i64,i64)]`) rather than a
// monomorphized SUM, so the match arm reads the TEMPLATE sum's `Some` payload -- the
// generic param `T` -- and binds the pattern var to a generic single-slot type. Every
// `.N` field access on such a var then collapses to offset 0 (all fields read field 0),
// a silent miscompile. This maps the generic payload param back to the concrete arg the
// generic-inst carries (by matching the param NAME against the alias's ordered generic
// params, exactly as try_instantiate_variant_call binds them). Returns `payload_type`
// unchanged when it is not a generic param, the scrutinee is not a generic-inst, or the
// param cannot be mapped -- so it is inert on the already-correct concrete-SUM path.
fn subst_variant_payload_type(mut self: ptr[TypeChecker], scrutinee_type: u32, payload_type: u32) -> u32:
    if payload_type == TYPE_UNKNOWN or not self.is_generic(payload_type):
        return payload_type
    if (scrutinee_type as i64) >= self.types.entries.len or (payload_type as i64) >= self.types.entries.len:
        return payload_type
    let s_entry = self.types.entries.data[scrutinee_type as i64]
    if s_entry.kind != TYPE_KIND_GENERIC_INST or s_entry.name_id == 0 as u32:
        return payload_type
    let pe = self.types.entries.data[payload_type as i64]
    if pe.kind != TYPE_KIND_GENERIC or pe.name_id == 0 as u32:
        return payload_type
    mut alias_sym_idx := self.symtable.resolve(s_entry.name_id)
    if alias_sym_idx == 0 as u32:
        alias_sym_idx = self.symtable.resolve_global_fallback(s_entry.name_id)
    if alias_sym_idx == 0 as u32 or (alias_sym_idx as i64) >= self.symtable.symbols.len:
        return payload_type
    let alias_sym = self.symtable.symbols.data[alias_sym_idx as i64]
    if alias_sym.decl_node == 0 as u32:
        return payload_type
    mut alias_tree := self.tree
    if (alias_sym_idx as i64) < self.symtable.symbol_trees.len:
        let at = self.symtable.symbol_trees.data[alias_sym_idx as i64]
        if at != null as ptr[AstTree]:
            alias_tree = at
    // Ordinal of this payload param among the alias's ordered generic params.
    mut ordinal := -1 as i64
    mut pos := 0 as i64
    mut c := alias_tree.nodes.data[alias_sym.decl_node].first_child
    while c != 0 as u32:
        let cn = alias_tree.nodes.data[c]
        if cn.kind == NODE_GENERIC_PARAMS:
            mut gp := cn.first_child
            while gp != 0 as u32:
                let gp_name = self.node_text_in_tree(alias_tree, gp)
                let gp_id = self.intern.intern(gp_name)
                safe_free_str(gp_name)
                if gp_id == pe.name_id:
                    ordinal = pos
                    break
                pos = pos + 1 as i64
                gp = alias_tree.nodes.data[gp].next_sibling
            break
        c = cn.next_sibling
    if ordinal < 0 as i64:
        return payload_type
    mut inst_args := self.get_generic_args(scrutinee_type)
    mut result := payload_type
    if ordinal < inst_args.len:
        let cand = inst_args.data[ordinal]
        if cand != TYPE_UNKNOWN and not self.is_generic(cand):
            result = cand
    if inst_args.data != null as ptr[u32]:
        @free(inst_args.data as ptr[u8])
    return result

// BUG#74: `GenericStruct(field: v, ...)` constructed with NO explicit type args,
// relying on field-value inference. The struct-sibling of try_instantiate_variant_
// call: infer the concrete type-args from the field-init values, then run the SAME
// monomorphization the explicit `GenericStruct[T,U](...)` annotation path uses
// (finish_generic_instantiation) so the constructed value and any generic function
// that later receives it agree on ONE packed struct layout. Without this the value
// was built with the template's generic (8-byte) field slots while the receiving
// generic function's param monomorphized to a packed concrete struct -- every field
// past the first read at the wrong offset (silently 0/garbage, no crash). Returns
// the template type_id unchanged when the struct is non-generic or nothing binds.
// BUG#53: reject an `if`/`while`/`elif` condition whose type is a string/bytes or an
// aggregate (struct/sum/Option/Result/array). Such a value is never a meaningful
// boolean -- `if opt` (forgot `.is_some()`/match), `if s` (a str), `if v` (a Vec) --
// and silently lowers to a truthy test on the {ptr,len}/box, a real accept-then-
// miscompile. Scalars (int/bool/float/char/pointer) are LEFT allowed: the compiler's
// own source uses truthy `if <i64>` conditions (11 sites), so only the non-scalar
// aggregate/str cases are caught -> self-build-safe. See
// [[bug-malformed-input-robustness-cluster]] (non-bool-condition note).
pub fn check_cond_type(mut self: ptr[TypeChecker], ct: u32):
    if ct == TYPE_UNKNOWN or (ct as i64) >= self.types.entries.len:
        return
    let is_str = ct == TYPE_STRING or ct == TYPE_BYTES
    let k = self.types.entries.data[ct as i64].kind
    let is_agg = k == TYPE_KIND_STRUCT or k == TYPE_KIND_SUM or k == TYPE_KIND_OPTION or k == TYPE_KIND_RESULT or k == TYPE_KIND_ARRAY
    if is_str or is_agg:
        ax_printf_local("error: condition must be a boolean or scalar; a string/aggregate/Option value is not a valid condition (forgot a comparison or .is_some()?)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.diags_count = self.diags_count + 1 as i64

// BUG#53 (m3): reject a struct constructor argument whose str/numeric LITERAL kind
// mismatches the declared field type (`P(x: "hi")` where `P.x: i64`) -- was accepted
// then miscompiled to garbage. Walk fields (decl order) and ctor args (positional,
// matching try_instantiate_struct_ctor's model) in lockstep; for each, if the field is
// numeric and the arg is a string literal (or field str/bytes and arg a numeric
// literal), reject. Literal-gated so real coercions & value args are untouched. Gated
// to SAME-TREE structs so the field type-expr node is a valid self.tree index to infer.
pub fn check_ctor_field_str_num(mut self: ptr[TypeChecker], callee: u32):
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return
    let ssym_idx = self.tree.nodes.data[callee].payload
    if ssym_idx == 0 as u32 or (ssym_idx as i64) >= self.symtable.symbols.len:
        return
    let ssym = self.symtable.symbols.data[ssym_idx as i64]
    if ssym.kind != SYM_STRUCT or ssym.decl_node == 0 as u32 or ssym.decl_node == 0xffffffff as u32:
        return
    if (ssym_idx as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[ssym_idx as i64]
        if t != null as ptr[AstTree] and t != self.tree:
            return
    if (ssym.decl_node as i64) >= self.tree.nodes.len:
        return
    mut field_node := self.tree.nodes.data[ssym.decl_node].first_child
    mut call_arg := self.tree.nodes.data[callee].next_sibling
    while field_node != 0 as u32 and call_arg != 0 as u32:
        let fn_node = self.tree.nodes.data[field_node]
        if fn_node.kind == NODE_FIELD_DECL:
            let field_type_node = fn_node.first_child
            mut val_node := call_arg
            if self.tree.nodes.data[call_arg].kind == NODE_NAMED_ARG:
                val_node = self.tree.nodes.data[call_arg].first_child
            if field_type_node != 0 as u32 and val_node != 0 as u32:
                let ftype = self.infer_node(field_type_node, TYPE_UNKNOWN)
                let vk = self.tree.nodes.data[val_node].kind
                let f_str = ftype == TYPE_STRING or ftype == TYPE_BYTES
                let f_num = ftype >= TYPE_I8 and ftype <= TYPE_USIZE and ftype != TYPE_STRING and ftype != TYPE_VOID
                let v_strlit = vk == NODE_STRING_LIT
                let v_numlit = vk == NODE_INT_LIT or vk == NODE_FLOAT_LIT
                if (f_num and v_strlit) or (f_str and v_numlit):
                    ax_printf_local("error: struct field initializer type mismatch: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
                // RFC 0029: an interface-typed field must be initialized with a struct that
                // implements it (else dispatch through the field calls a null vtable slot).
                self.check_iface_conformance(ftype, val_node)
            call_arg = self.tree.nodes.data[call_arg].next_sibling
        field_node = fn_node.next_sibling

// Is `cand` an already-monomorphized instantiation of the generic struct template named
// `base`? Instance types are registered under the mangled name `_AX_std_<base>__<args>`
// (mono.ax mangle_name), and the `__` separator keeps `Box` from matching `Boxer`.
// Used to recognize the target type a ctor call is being coerced INTO.
pub fn struct_is_instance_of(self: ptr[TypeChecker], cand: u32, base: str) -> bool:
    if cand == TYPE_UNKNOWN or (cand as i64) >= self.types.entries.len:
        return false
    let ce = self.types.entries.data[cand as i64]
    if ce.kind != TYPE_KIND_STRUCT or ce.name_id == 0 as u32:
        return false
    let cname = self.intern.get(ce.name_id)
    let pre1 = std.string.concat("_AX_std_", base)
    let prefix = std.string.concat(pre1, "__")
    let hit = std.string.starts_with(cname, prefix)
    safe_free_str(cname)
    safe_free_str(pre1)
    safe_free_str(prefix)
    return hit

pub fn try_instantiate_struct_ctor(mut self: ptr[TypeChecker], callee: u32, struct_type_id: u32, expected: u32) -> u32:
    if self.tree.nodes.data[callee].kind != NODE_IDENT:
        return struct_type_id
    let ssym_idx = self.tree.nodes.data[callee].payload
    if ssym_idx == 0 as u32 or (ssym_idx as i64) >= self.symtable.symbols.len:
        return struct_type_id
    let ssym = self.symtable.symbols.data[ssym_idx as i64]
    if ssym.kind != SYM_STRUCT or ssym.decl_node == 0 as u32 or ssym.decl_node == 0xffffffff as u32:
        return struct_type_id
    mut src_tree := self.tree
    if (ssym_idx as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[ssym_idx as i64]
        if t != null as ptr[AstTree]:
            src_tree = t
    if (ssym.decl_node as i64) >= src_tree.nodes.len:
        return struct_type_id
    if (src_tree.nodes.data[ssym.decl_node].flags & FLAG_IS_GENERIC) == 0 as u16:
        return struct_type_id

    // Ordered generic-param name-ids of the struct.
    mut gen_params := new_u32_vec()
    mut c := src_tree.nodes.data[ssym.decl_node].first_child
    while c != 0 as u32:
        let cn = src_tree.nodes.data[c]
        if cn.kind == NODE_GENERIC_PARAMS:
            mut gp := cn.first_child
            while gp != 0 as u32:
                let gp_name = self.node_text_in_tree(src_tree, gp)
                gen_params.push(self.intern.intern(gp_name))
                safe_free_str(gp_name)
                gp = src_tree.nodes.data[gp].next_sibling
            break
        c = cn.next_sibling
    if gen_params.len == 0 as i64:
        if gen_params.data != null as ptr[u32]:
            @free(gen_params.data as ptr[u8])
        return struct_type_id

    mut inferred := new_u32_vec()
    mut gi := 0 as i64
    while gi < gen_params.len:
        inferred.push(TYPE_UNKNOWN)
        gi = gi + 1

    // When the context already names the instantiation (`let b: Box[[i64;2]] = Box(v: [5,6])`
    // or an explicit `Box[[i64;2]](v: ..)`), bind the type params from ITS field types rather
    // than from the values. A bare int-literal array defaults to `[i32; N]`, so inferring from
    // the value alone instantiated `Box[[i32;2]]` and stored 4-byte elements into what the
    // annotated local reads with the `[i64;2]` stride â€” silently wrong elements. Passing the
    // expected field type down ALSO coerces the literal, so store and load agree.
    // Scoped to a monomorphized instance of THIS template; anything else (including a plain
    // `mut b := Box(v: ..)` with no annotation) keeps the previous UNKNOWN inference.
    mut exp_fields_extra := 0xffffffff as u32
    let base_name = self.intern.get(ssym.name_id)
    if self.struct_is_instance_of(expected, base_name):
        let exp_extra = self.types.entries.data[expected as i64].extra
        if (exp_extra as i64) < self.types.structs.len:
            exp_fields_extra = exp_extra
    safe_free_str(base_name)

    // Walk struct fields (decl order) and call args (positional) in lockstep;
    // named args are assigned positionally by the backend (see BUG#21 in
    // linker.ax), so field N's declared type-expr pairs with call arg N's value.
    mut field_node := src_tree.nodes.data[ssym.decl_node].first_child
    mut call_arg := self.tree.nodes.data[callee].next_sibling
    mut fpos := 0 as i64
    while field_node != 0 as u32 and call_arg != 0 as u32:
        let fn_node = src_tree.nodes.data[field_node]
        if fn_node.kind == NODE_FIELD_DECL:
            let field_type_node = fn_node.first_child
            mut val_node := call_arg
            if self.tree.nodes.data[call_arg].kind == NODE_NAMED_ARG:
                val_node = self.tree.nodes.data[call_arg].first_child
            if field_type_node != 0 as u32 and val_node != 0 as u32:
                mut vexp := TYPE_UNKNOWN
                if exp_fields_extra != 0xffffffff as u32:
                    let exp_si = self.types.structs.data[exp_fields_extra as i64]
                    if fpos < exp_si.fields.len:
                        vexp = exp_si.fields.data[fpos].type_id
                let val_type = self.infer_node(val_node, vexp)
                self.infer_generic_type_args(field_type_node, val_type, gen_params, inferred, src_tree)
            call_arg = self.tree.nodes.data[call_arg].next_sibling
            fpos = fpos + 1 as i64
        field_node = fn_node.next_sibling

    mut bound_any := false
    mut bi := 0 as i64
    while bi < inferred.len:
        if inferred.data[bi] != TYPE_UNKNOWN and not self.is_generic(inferred.data[bi]):
            bound_any = true
        bi = bi + 1

    if gen_params.data != null as ptr[u32]:
        @free(gen_params.data as ptr[u8])

    if not bound_any:
        if inferred.data != null as ptr[u32]:
            @free(inferred.data as ptr[u8])
        return struct_type_id

    // Default any param we couldn't bind to i32 (same fallback function-mono uses
    // for unbound params). All fields are supplied at construction, so this only
    // fires for a generic param that appears in no field's type.
    bi = 0
    while bi < inferred.len:
        if inferred.data[bi] == TYPE_UNKNOWN or self.is_generic(inferred.data[bi]):
            inferred.data[bi] = TYPE_I32
        bi = bi + 1

    return self.finish_generic_instantiation(ssym_idx, inferred)

// Diagnostic-only mirror of air_builder.ax's resolve_op_method: scans SYM_FUNC
// symbols whose (mangled) name matches `method_name` (struct methods declared
// INLINE under `struct X: fn eq(self, o): ...` get a dotted mangled name like
// "X.eq", which plain self.symtable.resolve("eq") does NOT find -- this must
// use the SAME substring-match helper air_builder uses at codegen time, or the
// diagnostic and the actual lowering decision can disagree). Returns 0 when no
// method matches, meaning air_builder would ALSO find nothing and fall back to
// the broken native-opcode (pointer) comparison.
pub fn diag_resolve_op_method(self: ptr[TypeChecker], method_name: str, rec_type: u32, rhs_type: u32) -> u32:
    let method_id = self.intern.intern(method_name)
    mut unwrapped := rec_type
    mut e := self.types.entries.data[unwrapped as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        unwrapped = e.extra as u32
        e = self.types.entries.data[unwrapped as i64]
    mut rhs_unwrapped := 0 as u32
    if rhs_type != 0 as u32:
        rhs_unwrapped = rhs_type
        mut re := self.types.entries.data[rhs_unwrapped as i64]
        while re.kind == TYPE_KIND_POINTER or re.kind == TYPE_KIND_REF:
            rhs_unwrapped = re.extra as u32
            re = self.types.entries.data[rhs_unwrapped as i64]
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.intern, sym.name_id, method_id):
            if (sym.type_id as i64) < self.types.entries.len:
                let t_entry = self.types.entries.data[sym.type_id as i64]
                if t_entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[t_entry.extra as i64]
                    if fi.params.len > 0 as i64:
                        mut fp := fi.params.data[0] as u32
                        mut fpe := self.types.entries.data[fp as i64]
                        while fpe.kind == TYPE_KIND_POINTER or fpe.kind == TYPE_KIND_REF:
                            fp = fpe.extra as u32
                            fpe = self.types.entries.data[fp as i64]
                        if fp == unwrapped:
                            mut rhs_ok := true
                            if rhs_unwrapped != 0 as u32:
                                rhs_ok = false
                                if fi.params.len > 1 as i64:
                                    mut sp := fi.params.data[1] as u32
                                    mut spe := self.types.entries.data[sp as i64]
                                    while spe.kind == TYPE_KIND_POINTER or spe.kind == TYPE_KIND_REF:
                                        sp = spe.extra as u32
                                        spe = self.types.entries.data[sp as i64]
                                    if sp == rhs_unwrapped:
                                        rhs_ok = true
                            if rhs_ok:
                                return i as u32
        i = i + 1 as i64
    return 0 as u32

pub fn infer_generic_type_args(self: ptr[TypeChecker], tn_idx: u32, arg_type: u32, gen_params: U32Vec, inferred: U32Vec, src_tree: ptr[AstTree]):
    if tn_idx == 0 as u32 or arg_type == 0 as u32:
        return
    let kind = src_tree.nodes.data[tn_idx].kind
    if kind == NODE_TYPE_EXPR:
        let node_name = self.node_text_in_tree(src_tree, tn_idx)
        let node_name_id = self.intern.intern(node_name)
        safe_free_str(node_name)
        
        mut g_idx := 0 as i64
        while g_idx < gen_params.len:
            if gen_params.data[g_idx] == node_name_id:
                // First-wins, EXCEPT a concrete arg overrides a previously-inferred
                // GENERIC/placeholder binding. A bare `None` (or any template-typed)
                // argument â€” e.g. arg0 of `pick(None, Some(42))` â€” binds T to the
                // Option template's OWN generic param; without this override, the
                // later concrete arg (`Some(42)` -> i64) could not correct T, so T
                // stayed generic and the call mis-monomorphized -> silent segfault.
                // A concrete binding is never overridden by a later generic one, and
                // UNKNOWN is still taken by anything.
                if inferred.data[g_idx] == TYPE_UNKNOWN:
                    inferred.data[g_idx] = arg_type
                elif self.is_generic(inferred.data[g_idx]) and not self.is_generic(arg_type):
                    inferred.data[g_idx] = arg_type
                break
            g_idx = g_idx + 1 as i64
    elif kind == NODE_GENERIC_TYPE:
        let base_idx = src_tree.nodes.data[tn_idx].first_child
        if base_idx != 0 as u32:
            let base_node = src_tree.nodes.data[base_idx]
            let base_name = self.node_text_in_tree(src_tree, base_idx)
            let name_id = self.intern.intern(base_name)
            safe_free_str(base_name)
            let text = self.intern.get(name_id)
            let ptr_text = text as ptr[u8]
            mut is_ptr := false
            mut is_slice := false
            if std.string.len(text) == 3 as i64 and ptr_text[0] == 'p' as u8 and ptr_text[1] == 't' as u8 and ptr_text[2] == 'r' as u8:
                is_ptr = true
            elif std.string.len(text) == 5 as i64 and ptr_text[0] == 's' as u8 and ptr_text[1] == 'l' as u8 and ptr_text[2] == 'i' as u8 and ptr_text[3] == 'c' as u8 and ptr_text[4] == 'e' as u8:
                is_slice = true

            if is_ptr:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    mut norm_arg := arg_type
                    mut entry = self.types.entries.data[norm_arg as i64]
                    if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                        let inner_arg_type = entry.extra
                        self.infer_generic_type_args(arg_idx, inner_arg_type, gen_params, inferred, src_tree)
                    else:
                        // AUTO-REF: a value arg passed to a `ptr[..]` param (UFCS `h.m()` or
                        // `m(h)` where `h: Hold[i64]` binds a `self: ptr[Hold[T]]`). The arg IS
                        // the pointee, so match the inner param type against the arg DIRECTLY â€”
                        // else T is never inferred from the nested `Hold[T]` and defaults to i32,
                        // mis-monomorphizing the whole instance ([[bug-generic-struct-inline-method]]).
                        self.infer_generic_type_args(arg_idx, arg_type, gen_params, inferred, src_tree)
            elif is_slice:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    mut norm_arg := arg_type
                    mut entry = self.types.entries.data[norm_arg as i64]
                    if entry.kind == TYPE_KIND_SLICE:
                        let inner_arg_type = entry.extra
                        self.infer_generic_type_args(arg_idx, inner_arg_type, gen_params, inferred, src_tree)
            else:
                // User-defined generic template (like Array or Map)
                mut norm_arg := arg_type
                mut entry = self.types.entries.data[norm_arg as i64]
                while entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                    norm_arg = entry.extra
                    entry = self.types.entries.data[norm_arg as i64]
                
                mut arg_type_args := self.get_generic_args(norm_arg)
                
                mut param_arg_idx := base_node.next_sibling
                mut a_idx := 0 as i64
                while param_arg_idx != 0 as u32 and a_idx < arg_type_args.len:
                    let concrete_arg_type = arg_type_args.data[a_idx]
                    self.infer_generic_type_args(param_arg_idx, concrete_arg_type, gen_params, inferred, src_tree)
                    param_arg_idx = src_tree.nodes.data[param_arg_idx].next_sibling
                    a_idx = a_idx + 1 as i64
                
                if arg_type_args.data != null as ptr[u32]:
                    @free(arg_type_args.data as ptr[u8])
    elif kind == NODE_PTR_TYPE:
        let inner_node_idx = src_tree.nodes.data[tn_idx].first_child
        if inner_node_idx != 0 as u32:
            mut norm_arg := arg_type
            mut entry = self.types.entries.data[norm_arg as i64]
            if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                let inner_arg_type = entry.extra
                self.infer_generic_type_args(inner_node_idx, inner_arg_type, gen_params, inferred, src_tree)
            else:
                // AUTO-REF: value arg to a `ptr[..]` param (see the NODE_GENERIC_TYPE `is_ptr`
                // branch above). Match the inner param against the arg directly so a nested
                // `ptr[Hold[T]]` still infers T. [[bug-generic-struct-inline-method]]
                self.infer_generic_type_args(inner_node_idx, arg_type, gen_params, inferred, src_tree)
    elif kind == NODE_SLICE_TYPE:
        let inner_node_idx = src_tree.nodes.data[tn_idx].first_child
        if inner_node_idx != 0 as u32:
            mut norm_arg := arg_type
            mut entry = self.types.entries.data[norm_arg as i64]
            if entry.kind == TYPE_KIND_SLICE:
                let inner_arg_type = entry.extra
                self.infer_generic_type_args(inner_node_idx, inner_arg_type, gen_params, inferred, src_tree)
    elif kind == NODE_FUNC_TYPE:
        // A fn-typed parameter `fn(T) -> U`: infer T/U structurally from the
        // argument's concrete function type (e.g. an inline lambda typed fn(i64)->i64
        // by the NODE_CLOSURE_EXPR branch of infer_node). Without this, U (inferable
        // only from the fn param's return) stays UNKNOWN, is i32-defaulted, and the
        // template may fail to instantiate. NODE_FUNC_TYPE children = param type
        // nodes, then (when flags&1) the return type node last.
        mut fnorm_arg := arg_type
        mut fentry = self.types.entries.data[fnorm_arg as i64]
        while fentry.kind == TYPE_KIND_POINTER or fentry.kind == TYPE_KIND_REF:
            fnorm_arg = fentry.extra
            fentry = self.types.entries.data[fnorm_arg as i64]
        if fentry.kind == TYPE_KIND_FUNC:
            let fi = self.types.funcs.data[fentry.extra as i64]
            let ftnode = src_tree.nodes.data[tn_idx]
            let f_has_ret = (ftnode.flags & 1 as u16) != 0 as u16
            mut f_nchildren := 0 as i64
            mut f_cc := ftnode.first_child
            while f_cc != 0 as u32:
                f_nchildren = f_nchildren + 1 as i64
                f_cc = src_tree.nodes.data[f_cc].next_sibling
            mut f_nparams := f_nchildren
            if f_has_ret:
                f_nparams = f_nchildren - 1 as i64
            mut f_cn := ftnode.first_child
            mut f_pi := 0 as i64
            while f_cn != 0 as u32 and f_pi < f_nparams:
                if f_pi < fi.params.len:
                    self.infer_generic_type_args(f_cn, fi.params.data[f_pi], gen_params, inferred, src_tree)
                f_cn = src_tree.nodes.data[f_cn].next_sibling
                f_pi = f_pi + 1 as i64
            if f_has_ret and f_cn != 0 as u32:
                self.infer_generic_type_args(f_cn, fi.ret, gen_params, inferred, src_tree)
    elif kind == NODE_ARRAY_TYPE:
        // `[T; N]` param: infer T from the argument array's ELEMENT type. first_child is
        // the element type node (next_sibling is the size literal). Mirrors the slice
        // branch; without it a T inside `[T;N]` never binds and mono defaults it to i32
        // (silent truncation/miscompile). [[bug-generic-struct-inline-method]]
        let a_el_node = src_tree.nodes.data[tn_idx].first_child
        if a_el_node != 0 as u32:
            mut a_norm := arg_type
            mut a_entry = self.types.entries.data[a_norm as i64]
            while a_entry.kind == TYPE_KIND_POINTER or a_entry.kind == TYPE_KIND_REF:
                a_norm = a_entry.extra
                a_entry = self.types.entries.data[a_norm as i64]
            if a_entry.kind == TYPE_KIND_ARRAY:
                self.infer_generic_type_args(a_el_node, a_entry.extra, gen_params, inferred, src_tree)
    elif kind == NODE_TUPLE_TYPE:
        // `(T0, T1, ..)` param: a tuple ARG is a canonical `__tupN` STRUCT (fields
        // _f0.._fN, see register_tuple_type). Match each param element type node against
        // the corresponding field type so a T in ANY tuple slot binds (else i32-default).
        // [[bug-generic-struct-inline-method]]
        mut tp_norm := arg_type
        mut tp_entry = self.types.entries.data[tp_norm as i64]
        while tp_entry.kind == TYPE_KIND_POINTER or tp_entry.kind == TYPE_KIND_REF:
            tp_norm = tp_entry.extra
            tp_entry = self.types.entries.data[tp_norm as i64]
        if tp_entry.kind == TYPE_KIND_STRUCT and (tp_entry.extra as i64) < self.types.structs.len:
            let tp_si = self.types.structs.data[tp_entry.extra as i64]
            mut tp_el := src_tree.nodes.data[tn_idx].first_child
            mut tp_fi := 0 as i64
            while tp_el != 0 as u32 and tp_fi < tp_si.fields.len:
                self.infer_generic_type_args(tp_el, tp_si.fields.data[tp_fi].type_id, gen_params, inferred, src_tree)
                tp_el = src_tree.nodes.data[tp_el].next_sibling
                tp_fi = tp_fi + 1 as i64

pub fn resolve_method_overload(self: ptr[TypeChecker], sym_idx: u32, rec_type: u32) -> u32:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return 0 as u32
    
    // If the symbol itself doesn't have overloads, return it immediately
    let initial_sym = self.symtable.symbols.data[sym_idx]
    if initial_sym.next_overload == 0 as u32:
        return sym_idx
        
    // Unwrap pointer and reference from receiver type
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        return sym_idx
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    
    // Now walk the overload chain to find a match.
    mut curr_idx := sym_idx
    while curr_idx != 0 as u32:
        if self.is_method_compatible(curr_idx, rec_type):
            return curr_idx
        let sym = self.symtable.symbols.data[curr_idx]
        curr_idx = sym.next_overload
        
    return sym_idx

// BUG#80: free-function call `f(a, ...)` to an OVERLOADED name. The resolver binds the
// callee ident to the overload-chain HEAD (a plain scope lookup returns the FIRST-defined
// symbol of that name) with NO argument-based disambiguation â€” only method calls (`x.f()`)
// pick an overload, via resolve_method_overload keyed on the receiver type. So a user
// function whose name collides with a stdlib one (e.g. `get`, `push`, `len` â€” stdlib is
// always linked) bound to the stdlib overload and SILENTLY MISCOMPILED: the head is a
// generic stdlib `get[T]`, so the call took the generic-instantiation path and baked
// `get[T=UserType]` on the wrong signature, returning 0 with no diagnostic (same silent
// accept-then-miscompile class as BUG#73). Mirror the method path for free calls: if the
// head is overloaded, pick the overload whose FIRST parameter type matches the FIRST
// argument (the free-call analogue of a receiver). Conservative â€” resolve_method_overload
// tests the head FIRST, so a call already bound to a compatible overload is returned
// unchanged; we only switch when the head is INCOMPATIBLE with arg0 and another overload
// in the chain matches, which is strictly a repair of a previously-broken binding.
// Number of declared parameters of a SYM_FUNC, counted from its DECL node in its OWN tree
// (so it is tree-safe and does not depend on the signature having been type-inferred yet).
// Returns -1 when unknown / not a function. Used for arity-based overload disambiguation.
pub fn sym_decl_param_count(self: ptr[TypeChecker], sym_idx: u32) -> i64:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return -1 as i64
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_FUNC or sym.decl_node == 0 as u32 or sym.decl_node == 0xffffffff as u32:
        return -1 as i64
    mut tree := self.tree
    if (sym_idx as i64) < self.symtable.symbol_trees.len:
        let t = self.symtable.symbol_trees.data[sym_idx as i64]
        if t != null as ptr[AstTree]:
            tree = t
    if (sym.decl_node as i64) >= tree.nodes.len:
        return -1 as i64
    mut n := 0 as i64
    mut c := tree.nodes.data[sym.decl_node as i64].first_child
    while c != 0 as u32:
        if tree.nodes.data[c as i64].kind == NODE_PARAM_DECL:
            n = n + 1 as i64
        c = tree.nodes.data[c as i64].next_sibling
    return n

// True iff this SYM_FUNC would emit the BARE mangled name `ax_<name>` in the backend
// (x86_resolve_sym_name / cgen), i.e. it has NO struct/sum receiver to disambiguate it.
// Two bare-mangling functions with the same name link-collide (one `ax_<name>` wins),
// silently mis-dispatching a call. Mirrors x86_regs.ax:198-302 so the uniquing pass in
// run_type_checker tags precisely the functions the backend would otherwise merge.
pub fn free_fn_bare_mangles(self: ptr[TypeChecker], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_FUNC:
        return false
    // extern keeps its raw name; MODDUP is already unique; generic templates are
    // monomorphized (instances mangle elsewhere) â€” none participate in this collision.
    if (sym.flags & SYM_FLAG_EXTERN) != 0 as u16:
        return false
    if (sym.flags & 2048 as u16) != 0 as u16:
        return false
    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
        return false
    // Special names the backend passes through verbatim (never `ax_<name>`).
    let nm = self.intern.get(sym.name_id)
    let special = (nm == "main" or nm == "_AX_main_main_v_v" or nm == "memcpy" or
                   nm == "memset" or nm == "memmove" or nm == "realloc" or
                   nm == "free" or nm == "alloc" or nm == "malloc")
    safe_free_str(nm)
    if special:
        return false
    // A struct/sum FIRST parameter (single pointer unwrap, mirroring the backend, and only
    // when it carries a name) yields `ax_<Struct>_<fn>` â€” unique per receiver, so NOT bare.
    if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.types.entries.len:
        let f_entry = self.types.entries.data[sym.type_id as i64]
        if f_entry.kind == TYPE_KIND_FUNC:
            let fi = self.types.funcs.data[f_entry.extra as i64]
            if fi.params.len > 0 as i64:
                mut fp := fi.params.data[0]
                let pe = self.types.entries.data[fp as i64]
                if pe.kind == TYPE_KIND_POINTER:
                    fp = pe.extra
                let pe2 = self.types.entries.data[fp as i64]
                if (pe2.kind == TYPE_KIND_STRUCT or pe2.kind == TYPE_KIND_SUM) and pe2.name_id != 0 as u32:
                    return false
    return true

// Gate for a free-call overload candidate `ci` (already known to match the call
// ARITY) given the inferred arg0 type: true iff `ci` is a plausible target.
// Mirrors the accept condition previously inlined in resolve_free_call_overload:
// arg0 unknown (cannot disqualify), a bare-generic first param (`zip[A,B,C]`),
// integer<->integer widening (the find/get/... free-fn-shadow repair), or an
// exact/structured is_method_compatible match. Extracted so the two-pass HOLE#5
// tie-break scores EXACTLY the candidate set it accepts. [[bug-freefn-stdlib-collision-noarg]]
pub fn free_call_gate(self: ptr[TypeChecker], ci: u32, arg0_type: u32) -> bool:
    if arg0_type == TYPE_UNKNOWN:
        return true
    mut ci_first_generic := false
    mut ci_arg0_widen := false
    mut ci_arg0_float := false
    mut ci_arg0_iface := false
    let ci_sym = self.symtable.symbols.data[ci]
    if ci_sym.type_id != 0 as u32 and (ci_sym.type_id as i64) < self.types.entries.len:
        let ce = self.types.entries.data[ci_sym.type_id]
        if ce.kind == TYPE_KIND_FUNC:
            let cfi = self.types.funcs.data[ce.extra]
            if cfi.params.len > 0 as i64 and (cfi.params.data[0] as i64) < self.types.entries.len:
                if self.types.entries.data[cfi.params.data[0]].kind == TYPE_KIND_GENERIC:
                    ci_first_generic = true
                let fp0 = cfi.params.data[0]
                if tc_is_numeric(fp0) and fp0 != TYPE_F32 and fp0 != TYPE_F64 and tc_is_numeric(arg0_type) and arg0_type != TYPE_F32 and arg0_type != TYPE_F64:
                    ci_arg0_widen = true
                // HOLE#6 (float f32<->f64 arg widening): a user free fn with a
                // concrete float first param shadowed by a bundled GENERIC method,
                // called with the OTHER float width (e.g. `fn map(x: f64)` called
                // with an f32 arg). The exact-match gate skipped the user overload
                // (f64 != f32) so the call fell through to the generic Vec.map head
                // -> monomorphized on a float arg treated as a Vec receiver ->
                // SIGSEGV (the residual foreseen at the end of HOLE#4/#5). Accepting
                // it here gates BOTH the user (concrete float param) and the generic
                // head, so the HOLE#5 full-signature tie-break (param_arg_match's
                // float<->float rule) then out-scores the generic and binds the user
                // fn. The actual f32->f64 value convert is emitted at the call site
                // (air_builder coerce_float_arg). [[bug-freefn-stdlib-collision-noarg]]
                if (fp0 == TYPE_F32 or fp0 == TYPE_F64) and (arg0_type == TYPE_F32 or arg0_type == TYPE_F64):
                    ci_arg0_float = true
                // HOLE#7: a user free fn whose first param is an INTERFACE, called with a
                // struct that IMPLEMENTS it. arg0_type is inferred from the ARGUMENT
                // expression, so `get(Sq(s: 6))` yields the concrete struct Sq while the
                // parameter is the interface Shape; is_method_compatible does not know Sq
                // implements Shape, so the user's own function was gated OUT. With no
                // candidate gated in at all (measured: n_gated == 0), resolve_free_call_overload
                // fell through to `return sym_idx` -- the chain HEAD, which for a name
                // colliding with a bundled stdlib symbol IS the stdlib overload, and there
                // with the WRONG arity. `fn get(sh: Shape)` returned 0 and `fn len(sh: Shape)`
                // returned 8 (the interface value's size, read by len(s: str)), with no
                // diagnostic. Same accept-then-miscompile class as HOLE#4/#5/#6.
                // Coercion is real and already implemented -- air_builder's
                // coerce_struct_to_interface boxes the struct at the call site, exactly as it
                // does for `let sh: Shape = sq`, which always worked.
                if (fp0 as i64) < self.types.entries.len and self.types.entries.data[fp0].kind == TYPE_KIND_INTERFACE:
                    if arg0_type != TYPE_UNKNOWN and (arg0_type as i64) < self.types.entries.len:
                        if self.types.entries.data[arg0_type].kind == TYPE_KIND_STRUCT:
                            if self.interface_missing_method(arg0_type, fp0) == 0 as u32:
                                ci_arg0_iface = true
    if ci_first_generic or ci_arg0_widen or ci_arg0_float or ci_arg0_iface:
        return true
    return self.is_method_compatible(ci, arg0_type)

// Per-parameter compatibility for the HOLE#5 full-signature tie-break score. An
// un-inferrable arg (UNKNOWN) is neutral (matches any param, so it never breaks a
// tie the wrong way); otherwise a param matches on exact type id, integer<->integer
// (any width/sign, floats excluded), or float<->float. Non-primitive params only
// match on exact type id (a bare-generic `T` param scores 0 against a concrete arg,
// so a concrete overload out-scores a generic one for a concrete call â€” the intended
// preference). Only used to rank already-gated same-arity candidates.
pub fn param_arg_match(self: ptr[TypeChecker], pt: u32, at: u32) -> bool:
    if at == TYPE_UNKNOWN:
        return true
    if pt == at:
        return true
    if tc_is_numeric(pt) and pt != TYPE_F32 and pt != TYPE_F64 and tc_is_numeric(at) and at != TYPE_F32 and at != TYPE_F64:
        return true
    if (pt == TYPE_F32 or pt == TYPE_F64) and (at == TYPE_F32 or at == TYPE_F64):
        return true
    return false

pub fn resolve_free_call_overload(mut self: ptr[TypeChecker], sym_idx: u32, first_arg_node: u32, call_argc: i64) -> u32:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return sym_idx
    if self.symtable.symbols.data[sym_idx].next_overload == 0 as u32:
        return sym_idx
    if first_arg_node == 0 as u32:
        // Zero-arg call `f()`. A plain scope lookup binds the callee to the overload-chain
        // HEAD, which for a name colliding with a bundled stdlib symbol is the stdlib
        // overload (stdlib is concatenated first -> defined first -> head). If that head
        // takes parameters (e.g. `run(mut self)`, `close(self)`), the zero-arg call would
        // silently dispatch to the wrong body reading a GARBAGE first arg -> return 0 or
        // SIGSEGV, no diagnostic (same accept-then-miscompile class as BUG#80, which only
        // disambiguated by arg[0] type and thus could not handle a zero-arg / arity
        // mismatch). Repair by ARITY: if the head takes >0 params, switch to a 0-param
        // overload in the chain (the user's own `f()`), if one exists. Only switches when
        // the head arity MISMATCHES the (zero) call arity, so a correctly-bound zero-arg
        // call is returned unchanged (conservative, mirroring the arg0-type path below).
        let head_pc = self.sym_decl_param_count(sym_idx)
        if head_pc <= 0 as i64:
            return sym_idx
        mut ci := self.symtable.symbols.data[sym_idx].next_overload
        while ci != 0 as u32:
            if self.sym_decl_param_count(ci) == 0 as i64:
                return ci
            ci = self.symtable.symbols.data[ci as i64].next_overload
        return sym_idx
    let arg0_type = self.infer_node(first_arg_node, TYPE_UNKNOWN)
    // ARITY + arg0-type disambiguation. A name colliding with a bundled stdlib overload
    // resolves (scope lookup) to the stdlib chain HEAD. If the user's own overload has a
    // DIFFERENT arity but the SAME arg0 type (user `len(str,i32)` vs stdlib `len(str)`),
    // arg0-type alone (BUG#80) picks the stdlib head. Walk the chain and prefer the overload
    // whose parameter count matches the call AND whose arg0 type is compatible. This binds
    // the call to the user's symbol so codegen targets the right (uniquely-mangled) body
    // [[bug-freefn-stdlib-collision-noarg]]. Preserves BUG#80 (equal-arity collisions still
    // disambiguate by arg0 type; a wrong-type head is skipped) and head-first order.
    // Pass 1: count the overloads that match the call ARITY and pass the arg0 gate
    // (free_call_gate: bare-generic first param `zip[A,B,C]`, integer<->integer
    // widening for the find/get/... free-fn-shadow, or is_method_compatible). The
    // gate is the same accept condition used historically; the head-first `first_gated`
    // preserves prior ordering. [[bug-freefn-stdlib-collision-noarg]]
    mut ci := sym_idx
    mut n_gated := 0 as i64
    mut first_gated := 0 as u32
    while ci != 0 as u32:
        if self.sym_decl_param_count(ci) == call_argc and self.free_call_gate(ci, arg0_type):
            n_gated = n_gated + 1 as i64
            if first_gated == 0 as u32:
                first_gated = ci
        ci = self.symtable.symbols.data[ci].next_overload
    // arg0 unknown (cannot score) or a single gated candidate: bind the head-first
    // match exactly as before (the common free-fn-shadow repair, e.g. user `find`
    // over a bundled generic Vec.find).
    if n_gated >= 1 as i64 and (arg0_type == TYPE_UNKNOWN or n_gated == 1 as i64):
        return first_gated
    // HOLE#5: two-or-more candidates tie on arity AND arg0 type â€” e.g. user
    // `contains(str, i64)` vs the NON-generic bundled `string.contains(str, str)`
    // (both arity 2, both arg0 == str). arg0 alone cannot disambiguate, and the old
    // head-first loop returned the WRONG (stdlib) one, so the call passed (str, i64)
    // to string.contains which read the i64 as a str pointer -> SIGSEGV, no
    // diagnostic (accept-then-miscompile). Break the tie by scoring the FULL
    // parameter list against the actual argument types (param_arg_match: exact |
    // integer<->integer | float<->float; an un-inferrable arg is neutral). Highest
    // score wins; a tie keeps head-first order (best_score starts at -1 so the
    // head-first `first_gated` is the initial best). Only reached for genuinely
    // ambiguous overloaded names, so the extra per-arg inference is rare.
    if n_gated >= 2 as i64:
        mut arg_types := new_u32_vec()
        mut an := first_arg_node
        while an != 0 as u32:
            arg_types.push(self.infer_node(an, TYPE_UNKNOWN))
            an = self.tree.nodes.data[an].next_sibling
        mut best_ci := first_gated
        mut best_score := 0 as i64 - 1 as i64
        ci = sym_idx
        while ci != 0 as u32:
            if self.sym_decl_param_count(ci) == call_argc and self.free_call_gate(ci, arg0_type):
                mut sc := 0 as i64
                let s2 = self.symtable.symbols.data[ci]
                if s2.type_id != 0 as u32 and (s2.type_id as i64) < self.types.entries.len:
                    let e2 = self.types.entries.data[s2.type_id]
                    if e2.kind == TYPE_KIND_FUNC:
                        let f2 = self.types.funcs.data[e2.extra]
                        mut pi := 0 as i64
                        while pi < f2.params.len and pi < arg_types.len:
                            let pv = f2.params.data[pi]
                            let av = arg_types.data[pi]
                            // An EXACT type match outscores a coercion-compatible match, so
                            // an exact overload wins over one needing integer widening or an
                            // f32<->f64 cross-width convert (the standard "exact preferred
                            // over promotion" rule). Without this, adding the float overload
                            // to the gate created a tie that head-first resolved WRONG:
                            // `pick(f32)`+`pick(f64)` called with an f64 literal picked the
                            // (head) f32 overload. An un-inferrable (UNKNOWN) arg stays neutral.
                            if av != TYPE_UNKNOWN and pv == av:
                                sc = sc + 2 as i64
                            elif self.param_arg_match(pv, av):
                                sc = sc + 1 as i64
                            pi = pi + 1 as i64
                if sc > best_score:
                    best_score = sc
                    best_ci = ci
            ci = self.symtable.symbols.data[ci].next_overload
        return best_ci
    if arg0_type == TYPE_UNKNOWN:
        return sym_idx
    let picked = self.resolve_method_overload(sym_idx, arg0_type)
    if picked != sym_idx and picked != 0 as u32 and self.is_method_compatible(picked, arg0_type):
        return picked
    return sym_idx

pub fn match_method_name(sym_name: str, field_name: str) -> bool:
    if sym_name == field_name:
        return true
    // PERF: equivalent to ends_with(sym_name, "." + field_name) but WITHOUT the
    // per-call concat/alloc/free â€” this runs tens of millions of times across the
    // method-resolution symbol scans (resolve_method_sym / method_ret_type).
    // True iff sym_name is longer than field_name, its last field_name.len bytes
    // equal field_name, and the byte just before them is '.'.
    let sl = std.string.len(sym_name)
    let fl = std.string.len(field_name)
    if sl <= fl:
        return false
    let sp = sym_name as ptr[u8]
    let fp = field_name as ptr[u8]
    if sp[sl - fl - 1 as i64] != 46 as u8:
        return false
    mut k := 0 as i64
    while k < fl:
        if sp[sl - fl + k] != fp[k]:
            return false
        k = k + 1
    return true

pub fn is_sym_generic(self: ptr[TypeChecker], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
    let sym = self.symtable.symbols.data[sym_idx]
    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
        return true
    if sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32:
        mut src_tree := self.tree
        if (sym_idx as i64) < self.symtable.symbol_trees.len:
            let t = self.symtable.symbol_trees.data[sym_idx]
            if t != null as ptr[AstTree]:
                src_tree = t
        if (sym.decl_node as i64) < src_tree.nodes.len:
            if (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16:
                return true
    return false

pub fn is_method_compatible(self: ptr[TypeChecker], sym_idx: u32, rec_type: u32) -> bool:
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return false
        
    let sym = self.symtable.symbols.data[sym_idx]
    if sym.kind != SYM_FUNC:
        return false
        
    let type_id = sym.type_id
    if type_id == TYPE_UNKNOWN:
        return false
        
    let f_entry = self.types.entries.data[type_id]
    if f_entry.kind != TYPE_KIND_FUNC:
        return false
        
    let fi = self.types.funcs.data[f_entry.extra]
    if fi.params.len == 0:
        return false
        
    mut first_param_type = fi.params.data[0]
    mut unwrapped_param := first_param_type
    while unwrapped_param != TYPE_UNKNOWN:
        let p_entry = self.types.entries.data[unwrapped_param]
        if p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
            unwrapped_param = p_entry.extra
        else:
            break
            
    if unwrapped_param == TYPE_UNKNOWN:
        return false
        
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        return false
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    let param_entry = self.types.entries.data[unwrapped_param]

    if not self.is_sym_generic(sym_idx):
        return unwrapped_param == unwrapped_rec
        
    mut kinds_match := false
    if param_entry.kind == rec_entry.kind:
        kinds_match = true
    else:
        let is_param_structured = (param_entry.kind == TYPE_KIND_STRUCT or param_entry.kind == TYPE_KIND_SUM or param_entry.kind == TYPE_KIND_GENERIC_INST or param_entry.kind == TYPE_KIND_OPTION or param_entry.kind == TYPE_KIND_RESULT)
        let is_rec_structured = (rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT)
        if is_param_structured and is_rec_structured:
            kinds_match = true
            
    if not kinds_match:
        return false
        
    if rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT:
        if param_entry.name_id != 0 as u32 and rec_entry.name_id != 0 as u32:
            let rec_struct_mangled = self.intern.get(rec_entry.name_id)
            let rec_struct_name = extract_base_name(rec_struct_mangled)
            let param_struct_name = self.intern.get(param_entry.name_id)
            let param_base_name = extract_base_name(param_struct_name)
            
            let matched = match_method_name(rec_struct_name, param_base_name)
            
            safe_free_str(rec_struct_mangled)
            safe_free_str(rec_struct_name)
            safe_free_str(param_struct_name)
            safe_free_str(param_base_name)
            return matched
        return param_entry.extra == rec_entry.extra
        
    return true

pub fn resolve_method_sym(self: ptr[TypeChecker], field_name_id: u32, rec_type: u32) -> u32:
    let field_name = self.intern.get(field_name_id)
    mut sym_idx := self.symtable.resolve(field_name_id)
    sym_idx = self.resolve_method_overload(sym_idx, rec_type)
    if sym_idx != 0 as u32 and not self.is_method_compatible(sym_idx, rec_type):
        sym_idx = 0 as u32
    if sym_idx != 0 as u32:
        safe_free_str(field_name)
        return sym_idx
        
    // Fallback search for generic method templates
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
            
    if unwrapped_rec == TYPE_UNKNOWN:
        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
            ax_printf_local("  [TC-DEBUG-RESOLVE-FALLBACK] unwrapped_rec is UNKNOWN for field_name=%s\n", (get_str_ptr(field_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        safe_free_str(field_name)
        return 0 as u32
        
    let rec_entry = self.types.entries.data[unwrapped_rec]
    
    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
        let rec_entry_kind = rec_entry.kind
        mut name_str := "0"
        if rec_entry.name_id != 0 as u32:
            name_str = self.intern.get(rec_entry.name_id)
        ax_printf_local("  [TC-DEBUG-RESOLVE-FALLBACK] field_name=%s rec_type=%d rec_kind=%d rec_name=%s name_id=%d\n", (get_str_ptr(field_name)) as i64, rec_type as i64, rec_entry_kind as i64, (get_str_ptr(name_str)) as i64, rec_entry.name_id as i64, 0 as i64, 0 as i64, 0 as i64)
        if rec_entry.name_id != 0 as u32:
            safe_free_str(name_str)

    if (rec_entry.kind == TYPE_KIND_STRUCT or rec_entry.kind == TYPE_KIND_SUM or rec_entry.kind == TYPE_KIND_GENERIC_INST or rec_entry.kind == TYPE_KIND_OPTION or rec_entry.kind == TYPE_KIND_RESULT) and rec_entry.name_id != 0 as u32:
        let rec_struct_mangled = self.intern.get(rec_entry.name_id)
        let rec_struct_name = extract_base_name(rec_struct_mangled)
        
        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
            ax_printf_local("    [TC-DEBUG-RESOLVE-FALLBACK] rec_struct_mangled=%s rec_struct_name=%s\n", (get_str_ptr(rec_struct_mangled)) as i64, (get_str_ptr(rec_struct_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        mut idx := 0 as i64
        while idx < self.symtable.symbols.len:
            let sym = self.symtable.symbols.data[idx]
            if sym.kind == SYM_FUNC and (sym.flags & SYM_FLAG_GENERIC) != 0 as u16:
                // PERF: zero-alloc hot filter (was intern.get + match_method_name +
                // free per generic SYM_FUNC per call). sym_name is materialized only
                // on the rare debug path below.
                if self.intern.name_matches_method(sym.name_id, field_name):
                    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                        let dbg_name = self.intern.get(sym.name_id)
                        ax_printf_local("      [TC-DEBUG-RESOLVE-FALLBACK] candidate sym_name=%s matches field!\n", (get_str_ptr(dbg_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        safe_free_str(dbg_name)
                    mut t_id := sym.type_id
                    if t_id == TYPE_UNKNOWN and sym.decl_node != 0 as u32:
                        self.pre_infer_func_signature(sym.decl_node)
                        t_id = self.symtable.symbols.data[idx].type_id
                    if t_id != TYPE_UNKNOWN:
                        let f_entry = self.types.entries.data[t_id]
                        if f_entry.kind == TYPE_KIND_FUNC:
                            let fi = self.types.funcs.data[f_entry.extra]
                            if fi.params.len > 0:
                                mut first_param_type = fi.params.data[0]
                                mut unwrapped_param := first_param_type
                                while unwrapped_param != TYPE_UNKNOWN:
                                    let p_entry = self.types.entries.data[unwrapped_param]
                                    if p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
                                        unwrapped_param = p_entry.extra
                                    else:
                                        break
                                
                                if unwrapped_param != TYPE_UNKNOWN:
                                    let param_entry = self.types.entries.data[unwrapped_param]
                                    
                                    if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                                        mut param_name_str := "0"
                                        if param_entry.name_id != 0 as u32:
                                            param_name_str = self.intern.get(param_entry.name_id)
                                        ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] param kind=%d name=%s name_id=%d\n", param_entry.kind as i64, (get_str_ptr(param_name_str)) as i64, param_entry.name_id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        if param_entry.name_id != 0 as u32:
                                            safe_free_str(param_name_str)
                                            
                                    if (param_entry.kind == TYPE_KIND_STRUCT or param_entry.kind == TYPE_KIND_SUM or param_entry.kind == TYPE_KIND_GENERIC_INST or param_entry.kind == TYPE_KIND_OPTION or param_entry.kind == TYPE_KIND_RESULT) and param_entry.name_id != 0 as u32:
                                        let param_struct_name = self.intern.get(param_entry.name_id)
                                        let param_base_name = extract_base_name(param_struct_name)
                                        
                                        if field_name == "is_ok" or field_name == "unwrap" or field_name == "unwrap_err" or field_name == "is_err":
                                            ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] param_struct_name=%s param_base_name=%s\n", (get_str_ptr(param_struct_name)) as i64, (get_str_ptr(param_base_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                            let is_matched = match_method_name(rec_struct_name, param_base_name)
                                            ax_printf_local("        [TC-DEBUG-RESOLVE-FALLBACK] match_method_name matches? %d\n", is_matched as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                            
                                        if match_method_name(rec_struct_name, param_base_name):
                                            safe_free_str(rec_struct_mangled)
                                            safe_free_str(rec_struct_name)
                                            safe_free_str(param_struct_name)
                                            safe_free_str(param_base_name)
                                            safe_free_str(field_name)
                                            return idx as u32
                                        safe_free_str(param_base_name)
                                        safe_free_str(param_struct_name)
            idx = idx + 1 as i64
        safe_free_str(rec_struct_mangled)
        safe_free_str(rec_struct_name)
    safe_free_str(field_name)
    return 0 as u32

// BUG#45 case (1): resolve_method_sym only matches GENERIC method templates in
// its fallback, so a plain (non-generic) method's field-expr is left UNTYPED and
// node_types[call] stays 0. That is harmless for scalar returns (the value rides
// RAX/XMM0 and the copy defaults to 8 bytes) but fatal for an aggregate return:
// the `let r = obj.m()` copy then has size 0 and never copies the struct, so the
// result reads back as zero. This helper returns ONLY the RETURN type of the
// matching method (matched by name + receiver type, exactly like air_builder's
// method dispatch) WITHOUT mutating any node/flag/payload â€” it never changes how
// the method is resolved or called, only the type recorded for the call result.
// RFC 0029: the DECLARED return type of interface `iface_type`'s method `method_name_id`,
// read from the interface's NODE_INTERFACE_DECL (found by matching name_id). Dynamic dispatch
// resolves the call's result type from the interface contract, not a concrete impl (which is
// unknown at the dispatch site). Returns 0 if not found.
pub fn interface_method_ret_type(mut self: ptr[TypeChecker], iface_type: u32, method_name_id: u32) -> u32:
    if (iface_type as i64) >= self.types.entries.len:
        return 0 as u32
    let iname = self.types.entries.data[iface_type as i64].name_id
    if iname == 0 as u32:
        return 0 as u32
    mut di := 0 as i64
    while di < self.tree.nodes.len:
        let dn = self.tree.nodes.data[di]
        if dn.kind == NODE_INTERFACE_DECL and dn.payload == iname:
            mut ch := dn.first_child
            while ch != 0 as u32:
                let cn = self.tree.nodes.data[ch as i64]
                if cn.kind == NODE_METHOD_SIG and cn.payload == method_name_id:
                    mut mc := cn.first_child
                    mut ret := 0 as u32
                    while mc != 0 as u32:
                        let mcn = self.tree.nodes.data[mc as i64]
                        if is_type_annotation_node(mcn.kind):
                            ret = self.infer_node(mc, TYPE_UNKNOWN)
                        mc = mcn.next_sibling
                    return ret
                ch = cn.next_sibling
        di = di + 1 as i64
    return 0 as u32

// RFC 0029: does concrete struct `struct_type` have a method named `method_name_id`
// (a SYM_FUNC whose param[0] is that struct type)? Mirrors air_builder's
// find_struct_method_sym â€” used for structural interface conformance.
pub fn struct_has_method(self: ptr[TypeChecker], struct_type: u32, method_name_id: u32) -> bool:
    let mname = self.intern.get(method_name_id)
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len:
            if self.intern.name_matches_method(sym.name_id, mname):
                let fe = self.types.entries.data[sym.type_id]
                if fe.kind == TYPE_KIND_FUNC and (fe.extra as i64) < self.types.funcs.len:
                    let fi = self.types.funcs.data[fe.extra]
                    if fi.params.len > 0:
                        mut fp := fi.params.data[0]
                        while fp != TYPE_UNKNOWN and (fp as i64) < self.types.entries.len:
                            let pe = self.types.entries.data[fp]
                            if pe.kind == TYPE_KIND_POINTER or pe.kind == TYPE_KIND_REF:
                                fp = pe.extra
                            else:
                                break
                        if fp == struct_type:
                            safe_free_str(mname)
                            return true
        i = i + 1 as i64
    safe_free_str(mname)
    return false

// RFC 0029: the name_id of the FIRST interface method that `struct_type` does NOT
// implement (0 if it conforms). Used to reject a non-conforming struct at the T->I
// coercion site (else air_builder builds a vtable slot from a 0 method-symbol and
// dispatch calls through a null pointer â€” accept-then-miscompile, BUG#53 class).
pub fn interface_missing_method(self: ptr[TypeChecker], struct_type: u32, iface_type: u32) -> u32:
    let methods = self.types.interface_method_list(iface_type)
    mut k := 0 as i64
    while k < methods.len:
        if not self.struct_has_method(struct_type, methods.data[k]):
            return methods.data[k]
        k = k + 1 as i64
    return 0 as u32

// RFC 0029 signature conformance: read an interface method's declared NON-self param
// count and return type from the interface decl AST (NODE_METHOD_SIG children). Mirrors
// interface_method_ret_type's walk (self.tree, NODE_INTERFACE_DECL matched by name; params
// are NODE_PARAM_DECL, the return is the sole type-annotation child). Returns false when the
// interface decl or the method sig is NOT in self.tree (a cross-tree / imported interface) so
// callers conservatively SKIP the signature check rather than risk a false reject on a decl
// they cannot see. `out_nparams` excludes the `self` receiver.
pub fn interface_method_sig(mut self: ptr[TypeChecker], iface_type: u32, method_name_id: u32, out_nparams: ptr[i64], out_ret: ptr[u32]) -> bool:
    out_nparams[0] = -1 as i64
    out_ret[0] = 0 as u32
    if (iface_type as i64) >= self.types.entries.len:
        return false
    mut di := 0 as i64
    while di < self.tree.nodes.len:
        let dn = self.tree.nodes.data[di]
        // The resolver rewrites NODE_INTERFACE_DECL.payload from the interned name to the
        // SYMBOL INDEX (see the Phase-0 registration walk), so match the decl via its
        // symbol's type_id, not by name. Staying in self.tree keeps infer_node (which reads
        // self.tree) consistent; a cross-tree imported interface simply is not found here and
        // the caller conservatively skips the signature check.
        mut decl_matches := false
        if dn.kind == NODE_INTERFACE_DECL:
            let isym_idx = dn.payload
            if isym_idx != 0 as u32 and (isym_idx as i64) < self.symtable.symbols.len:
                if self.symtable.symbols.data[isym_idx as i64].type_id == iface_type:
                    decl_matches = true
        if decl_matches:
            mut ch := dn.first_child
            while ch != 0 as u32:
                let cn = self.tree.nodes.data[ch as i64]
                if cn.kind == NODE_METHOD_SIG and cn.payload == method_name_id:
                    mut nparams := 0 as i64
                    mut ret := 0 as u32
                    mut mc := cn.first_child
                    while mc != 0 as u32:
                        let mcn = self.tree.nodes.data[mc as i64]
                        if mcn.kind == NODE_PARAM_DECL:
                            nparams = nparams + 1 as i64
                        elif is_type_annotation_node(mcn.kind):
                            ret = self.infer_node(mc, TYPE_UNKNOWN)
                        mc = mcn.next_sibling
                    if nparams > 0 as i64:
                        nparams = nparams - 1 as i64   // drop the `self` receiver
                    out_nparams[0] = nparams
                    out_ret[0] = ret
                    return true
                ch = cn.next_sibling
        di = di + 1 as i64
    return false

// RFC 0029 signature conformance: the concrete struct method's NON-self param count and
// return type. Mirrors struct_has_method's symbol walk (SYM_FUNC whose unwrapped param[0]
// is the struct type). Returns false when the struct has no such method.
pub fn struct_method_sig(self: ptr[TypeChecker], struct_type: u32, method_name_id: u32, out_nparams: ptr[i64], out_ret: ptr[u32]) -> bool:
    out_nparams[0] = -1 as i64
    out_ret[0] = 0 as u32
    let mname = self.intern.get(method_name_id)
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len:
            if self.intern.name_matches_method(sym.name_id, mname):
                let fe = self.types.entries.data[sym.type_id]
                if fe.kind == TYPE_KIND_FUNC and (fe.extra as i64) < self.types.funcs.len:
                    let fi = self.types.funcs.data[fe.extra]
                    if fi.params.len > 0:
                        mut fp := fi.params.data[0]
                        while fp != TYPE_UNKNOWN and (fp as i64) < self.types.entries.len:
                            let pe = self.types.entries.data[fp]
                            if pe.kind == TYPE_KIND_POINTER or pe.kind == TYPE_KIND_REF:
                                fp = pe.extra
                            else:
                                break
                        if fp == struct_type:
                            out_nparams[0] = fi.params.len - 1 as i64
                            out_ret[0] = fi.ret
                            safe_free_str(mname)
                            return true
        i = i + 1 as i64
    safe_free_str(mname)
    return false

// RFC 0029 signature conformance: the name-id of the FIRST interface method the struct
// implements by NAME but with a MISMATCHED signature (0 if every present method matches).
// Complements interface_missing_method (name-presence): a same-named method with the wrong
// arity (F3 dropped arg / F3b garbage extra) or return type (F2) is otherwise accepted and
// dispatched through the mismatched slot. Deliberately conservative â€” it only rejects on a
// difference it can PROVE: a param-count mismatch (needs no type resolution), or a return
// type that differs when BOTH sides resolved to a concrete, non-generic type that is not a
// `Self` position. Anything it cannot resolve (cross-tree iface, Self/generic return) is
// skipped, never rejected, so it cannot false-reject correct code.
pub fn interface_signature_mismatch(mut self: ptr[TypeChecker], struct_type: u32, iface_type: u32) -> u32:
    let methods = self.types.interface_method_list(iface_type)
    mut k := 0 as i64
    while k < methods.len:
        let m = methods.data[k]
        mut inp := -1 as i64
        mut iret := 0 as u32
        let have_iface = self.interface_method_sig(iface_type, m, &inp, &iret)
        mut snp := -1 as i64
        mut sret := 0 as u32
        let have_struct = self.struct_method_sig(struct_type, m, &snp, &sret)
        if have_iface and have_struct:
            // Param-count mismatch (F3/F3b): provable without resolving any type.
            if inp >= 0 as i64 and snp >= 0 as i64 and inp != snp:
                return m
            // Return-type mismatch (F2): only when both resolve to a concrete, non-generic
            // type and neither is a `Self` position (iface returns `Self` -> the interface
            // type; the struct impl returns the concrete struct â€” correct conformance).
            if iret != 0 as u32 and sret != 0 as u32 and iret != sret:
                if not self.is_generic(iret) and not self.is_generic(sret):
                    if iret != iface_type and sret != struct_type:
                        return m
        k = k + 1 as i64
    return 0 as u32

// RFC 0029: at any T->I coercion site (let / return / struct-field-init / assignment; the
// call-arg site has its own inline check) a concrete struct flowing into an interface slot
// must structurally IMPLEMENT it. Otherwise air_builder builds a vtable slot from a 0
// method-symbol and dispatch calls through a null pointer â€” an accept-then-miscompile
// (BUG#53 class). Emits a diagnostic if `src_node`'s type is a struct that does not
// implement interface `target_type`; a no-op for every non-(struct->interface) pair.
pub fn check_iface_conformance(mut self: ptr[TypeChecker], target_type: u32, src_node: u32):
    if target_type == TYPE_UNKNOWN or (target_type as i64) >= self.types.entries.len:
        return
    if self.types.entries.data[target_type as i64].kind != TYPE_KIND_INTERFACE:
        return
    if src_node == 0 as u32:
        return
    mut at := TYPE_UNKNOWN
    if (src_node as i64) < self.node_types_cap:
        at = self.node_types[src_node as i64]
    if at == TYPE_UNKNOWN:
        at = self.infer_node(src_node, TYPE_UNKNOWN)
    if at == TYPE_UNKNOWN or (at as i64) >= self.types.entries.len:
        return
    if self.types.entries.data[at as i64].kind != TYPE_KIND_STRUCT:
        return
    let missing = self.interface_missing_method(at, target_type)
    if missing != 0 as u32:
        let mn = self.intern.get(missing)
        ax_printf_local("error: type does not implement interface method '%s' required by the interface type\n", get_str_ptr(mn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        safe_free_str(mn)
        self.diags_count = self.diags_count + 1 as i64
    else:
        // RFC 0029: name-presence is necessary but not sufficient â€” a same-named method
        // with the wrong arity or return type miscompiles through the vtable slot (drops
        // an arg / reads garbage / flows a wrong return type). Reject that too.
        let sigbad = self.interface_signature_mismatch(at, target_type)
        if sigbad != 0 as u32:
            let smn = self.intern.get(sigbad)
            ax_printf_local("error: method '%s' does not match the signature required by the interface (parameter count or return type differs)\n", get_str_ptr(smn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            safe_free_str(smn)
            self.diags_count = self.diags_count + 1 as i64

pub fn method_ret_type(self: ptr[TypeChecker], field_name_id: u32, rec_type: u32) -> u32:
    let field_name = self.intern.get(field_name_id)
    mut unwrapped_rec := rec_type
    while unwrapped_rec != TYPE_UNKNOWN and (unwrapped_rec as i64) < self.types.entries.len:
        let entry = self.types.entries.data[unwrapped_rec]
        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
            unwrapped_rec = entry.extra
        else:
            break
    if unwrapped_rec == TYPE_UNKNOWN:
        safe_free_str(field_name)
        return 0 as u32
    mut result := 0 as u32
    mut idx := 0 as i64
    while idx < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[idx]
        // Only consider methods whose signature is ALREADY inferred. Do NOT call
        // pre_infer_func_signature here: sym.decl_node may index a DIFFERENT
        // module's AST tree, but pre_infer uses self.tree, so forcing it reads out
        // of bounds and crashes the compiler (regression: t_mathx bignum methods).
        // Every index into the type table is bounds-checked for the same reason.
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len:
            // PERF: zero-alloc name match (was intern.get + match_method_name + free
            // per SYM_FUNC per call). sym_name was used only for this test.
            if self.intern.name_matches_method(sym.name_id, field_name):
                let f_entry = self.types.entries.data[sym.type_id]
                if f_entry.kind == TYPE_KIND_FUNC and (f_entry.extra as i64) < self.types.funcs.len:
                    let fi = self.types.funcs.data[f_entry.extra]
                    if fi.params.len > 0:
                        mut fp := fi.params.data[0]
                        while fp != TYPE_UNKNOWN and (fp as i64) < self.types.entries.len:
                            let pe = self.types.entries.data[fp]
                            if pe.kind == TYPE_KIND_POINTER or pe.kind == TYPE_KIND_REF:
                                fp = pe.extra
                            else:
                                break
                        // Numeric UFCS widening: a narrower integer receiver
                        // (i8/i16/i32/u8/u16/u32) matches an i64 first-param free
                        // fn â€” mirroring the i32->i64 coercion the free-CALL form
                        // already permits (`to_str(x)` works but `x.to_str()` used
                        // to reject). Safe with NO cast because every narrow-int
                        // producer normalizes its register to full 64-bit width
                        // (x86_selector emit_wrap_to_width/emit_load_extend), so the
                        // receiver value already equals `x as i64` â€” the lowering
                        // passes it directly (air_builder ~1598). NOT extended to
                        // f32->f64: an f32 in an XMM reg is not an f64 (needs a real
                        // cvtss2sd), so that would miscompile without emitting a cast.
                        mut num_widen := false
                        if fp == TYPE_I64 and (unwrapped_rec == TYPE_I8 or unwrapped_rec == TYPE_I16 or unwrapped_rec == TYPE_I32 or unwrapped_rec == TYPE_U8 or unwrapped_rec == TYPE_U16 or unwrapped_rec == TYPE_U32):
                            num_widen = true
                        if fp == unwrapped_rec or num_widen:
                            result = fi.ret
                            break
        idx = idx + 1 as i64
    safe_free_str(field_name)
    return result

// BUG#93(b): self-type-aware method-existence test for the accept-then-miscompile
// reject gate. Returns true iff some SYM_FUNC named `mname` has an already-inferred
// first param whose unwrapped type is a NAMED aggregate (struct/sum/generic-inst/
// option/result) whose BASE name matches the receiver base name `rec_base`. A
// method that exists ONLY on a DIFFERENT type (e.g. `contains` on HashSet, absent
// on HashMap) then does NOT suppress the reject, so `m.contains(k)` is rejected
// cleanly instead of miscompiling to getfld + `call *garbage` (SIGSEGV). Base-name
// (not exact type-id) match is cross-module safe. Only considers symbols with an
// inferred signature â€” like method_ret_type, it NEVER forces pre_infer_func_
// signature (that reads a foreign module's AST via self.tree and crashes).
pub fn has_method_for_base(self: ptr[TypeChecker], mname: str, rec_base: str) -> bool:
    mut si := 0 as i64
    while si < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[si]
        if sym.kind == SYM_FUNC and sym.type_id != TYPE_UNKNOWN and (sym.type_id as i64) < self.types.entries.len and self.intern.name_matches_method(sym.name_id, mname):
            let fe = self.types.entries.data[sym.type_id as i64]
            if fe.kind == TYPE_KIND_FUNC and (fe.extra as i64) < self.types.funcs.len:
                let cfi = self.types.funcs.data[fe.extra as i64]
                if cfi.params.len > 0 as i64:
                    mut pp := cfi.params.data[0]
                    while pp != TYPE_UNKNOWN and (pp as i64) < self.types.entries.len:
                        let ppe = self.types.entries.data[pp as i64]
                        if ppe.kind == TYPE_KIND_POINTER or ppe.kind == TYPE_KIND_REF:
                            pp = ppe.extra
                        else:
                            break
                    if pp != TYPE_UNKNOWN and (pp as i64) < self.types.entries.len:
                        let ppe2 = self.types.entries.data[pp as i64]
                        if (ppe2.kind == TYPE_KIND_STRUCT or ppe2.kind == TYPE_KIND_SUM or ppe2.kind == TYPE_KIND_GENERIC_INST or ppe2.kind == TYPE_KIND_OPTION or ppe2.kind == TYPE_KIND_RESULT) and ppe2.name_id != 0 as u32:
                            let pmangled = self.intern.get(ppe2.name_id)
                            let pbn = extract_base_name(pmangled)
                            let matched = match_method_name(rec_base, pbn)
                            safe_free_str(pmangled)
                            safe_free_str(pbn)
                            if matched:
                                return true
        si = si + 1 as i64
    return false

pub fn free_type_checker(mut self: ptr[TypeChecker]):
    @free(self.node_types as ptr[u8])

pub fn ensure_capacity(mut self: ptr[TypeChecker], cap: i64):
    if cap <= self.node_types_cap:
        return
    let new_ptr = @alloc(cap * 4) as ptr[u32]
    mut i := 0 as i64
    while i < self.node_types_cap:
        new_ptr[i] = self.node_types[i]
        i = i + 1
    while i < cap:
        new_ptr[i] = 0 as u32
        i = i + 1
    @free(self.node_types as ptr[u8])
    self.node_types = new_ptr
    self.node_types_cap = cap

pub fn set_node_type(mut self: ptr[TypeChecker], node_idx: u32, type_id: u32):
    if node_idx == 0xffffffff as u32:
        return
    let idx = node_idx as i64
    if idx >= self.node_types_cap:
        mut new_cap := self.node_types_cap * 2
        if idx >= new_cap:
            new_cap = idx + 100 as i64
        let new_ptr = @alloc(new_cap * 4) as ptr[u32]
        mut i := 0 as i64
        while i < self.node_types_cap:
            new_ptr[i] = self.node_types[i]
            i = i + 1
        while i < new_cap:
            new_ptr[i] = 0 as u32
            i = i + 1
        @free(self.node_types as ptr[u8])
        self.node_types = new_ptr
        self.node_types_cap = new_cap
    self.node_types[idx] = type_id

pub fn parse_comptime_int(s: str) -> i64:
    let len = std.string.len(s)
    if len == 0:
        return 0 as i64
    mut i := 0
    mut sign := 1 as i64
    if s[0] as u8 == '-' as u8:
        sign = -1 as i64
        i = 1
    elif s[0] as u8 == '+' as u8:
        i = 1

    mut base := 10 as i64
    if i + 1 < len and s[i] as u8 == '0' as u8:
        let next_char = s[i + 1] as u8
        if next_char == 'x' as u8 or next_char == 'X' as u8:
            base = 16 as i64
            i = i + 2
        elif next_char == 'o' as u8 or next_char == 'O' as u8:
            base = 8 as i64
            i = i + 2
        elif next_char == 'b' as u8 or next_char == 'B' as u8:
            base = 2 as i64
            i = i + 2

    mut val := 0 as i64
    while i < len:
        let c = s[i] as u8
        // digit-group separator: skip and keep scanning (e.g. 1_000_000)
        if c == '_' as u8:
            i = i + 1
            continue
        mut digit := -1 as i64
        if c >= '0' as u8 and c <= '9' as u8:
            digit = (c - '0' as u8) as i64
        elif c >= 'a' as u8 and c <= 'f' as u8:
            digit = (c - 'a' as u8 + 10 as u8) as i64
        elif c >= 'A' as u8 and c <= 'F' as u8:
            digit = (c - 'A' as u8 + 10 as u8) as i64

        if digit < 0 or digit >= base:
            break

        val = val * base + digit
        i = i + 1

    return val * sign

pub fn node_text_in_tree(self: ptr[TypeChecker], tree: ptr[AstTree], node_idx: u32) -> str:
    if tree == null as ptr[AstTree] or node_idx == 0 as u32 or (node_idx as i64) >= tree.nodes.len:
        return ""
    let node = tree.nodes.data[node_idx]
    let tok_idx = node.token_idx
    if tok_idx as i64 >= tree.tokens.len:
        return ""
    let tok = tree.tokens.data[tok_idx as i64]
    if tok.len == 0 as u16:
        return ""
    let start_ptr = ((tree.src as ptr[u8]) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn node_text(self: ptr[TypeChecker], node_idx: u32) -> str:
    return self.node_text_in_tree(self.tree, node_idx)

pub fn eval_comptime(mut self: ptr[TypeChecker], node_idx: u32) -> ComptimeValue:
    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind
    
    if kind == NODE_INT_LIT:
        let text = self.node_text(node_idx)
        let val = parse_comptime_int(text)
        return ComptimeValue(kind: TYPE_I64, int_val: val, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_FLOAT_LIT:
        let text = self.node_text(node_idx)
        let val = atof(get_str_ptr(text))
        return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: val, bool_val: false, str_val: "")
        
    elif kind == NODE_BOOL_LIT:
        let text = self.node_text(node_idx)
        let is_true = (text == "true")
        return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: is_true, str_val: "")
        
    elif kind == NODE_STRING_LIT:
        let text = self.node_text(node_idx)
        let stripped = strip_quotes(text)
        return ComptimeValue(kind: TYPE_STRING, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: stripped)
        
    elif kind == NODE_COMPTIME:
        let child = node.first_child
        if child != 0 as u32:
            return self.eval_comptime(child)
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_BLOCK:
        mut child := node.first_child
        if child == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        mut last_val = ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        while child != 0 as u32:
            last_val = self.eval_comptime(child)
            child = self.tree.nodes.data[child].next_sibling
        return last_val
        
    elif kind == NODE_RETURN_STMT:
        let child = node.first_child
        if child != 0 as u32:
            return self.eval_comptime(child)
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_UNARY_EXPR:
        let child = node.first_child
        if child == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let val = self.eval_comptime(child)
        let op = self.node_text(node_idx)
        if op == "-":
            if val.kind == TYPE_I64:
                return ComptimeValue(kind: TYPE_I64, int_val: 0 as i64 - val.int_val, float_val: 0.0, bool_val: false, str_val: "")
            elif val.kind == TYPE_F64:
                return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: 0.0 - val.float_val, bool_val: false, str_val: "")
        elif op == "not" or op == "!":
            if val.kind == TYPE_BOOL:
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: not val.bool_val, str_val: "")
        elif op == "~":
            if val.kind == TYPE_I64:
                return ComptimeValue(kind: TYPE_I64, int_val: 0 as i64 - val.int_val - 1 as i64, float_val: 0.0, bool_val: false, str_val: "")
        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        
    elif kind == NODE_BINARY_EXPR:
        let lhs_idx = node.first_child
        if lhs_idx == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        if rhs_idx == 0 as u32:
            return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
        let lhs = self.eval_comptime(lhs_idx)
        let rhs = self.eval_comptime(rhs_idx)
        let op = self.node_text(node_idx)
        
        let is_lhs_num = (lhs.kind == TYPE_I64 or lhs.kind == TYPE_F64)
        let is_rhs_num = (rhs.kind == TYPE_I64 or rhs.kind == TYPE_F64)
        if is_lhs_num and is_rhs_num:
            if lhs.kind == TYPE_F64 or rhs.kind == TYPE_F64:
                mut lf := lhs.float_val
                if lhs.kind == TYPE_I64:
                    lf = lhs.int_val as f64
                mut rf := rhs.float_val
                if rhs.kind == TYPE_I64:
                    rf = rhs.int_val as f64
                if op == "+":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf + rf, bool_val: false, str_val: "")
                elif op == "-":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf - rf, bool_val: false, str_val: "")
                elif op == "*":
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf * rf, bool_val: false, str_val: "")
                elif op == "/":
                    if rf == 0.0:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_F64, int_val: 0 as i64, float_val: lf / rf, bool_val: false, str_val: "")
                elif op == "==":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf == rf, str_val: "")
                elif op == "!=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf != rf, str_val: "")
                elif op == "<":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf < rf, str_val: "")
                elif op == "<=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf <= rf, str_val: "")
                elif op == ">":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf > rf, str_val: "")
                elif op == ">=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lf >= rf, str_val: "")
            else:
                let lh = lhs.int_val
                let rh = rhs.int_val
                if op == "+":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh + rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "-":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh - rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "*":
                    return ComptimeValue(kind: TYPE_I64, int_val: lh * rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "/":
                    if rh == 0 as i64:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_I64, int_val: lh / rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "%":
                    if rh == 0 as i64:
                        return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")
                    return ComptimeValue(kind: TYPE_I64, int_val: lh % rh, float_val: 0.0, bool_val: false, str_val: "")
                elif op == "==":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh == rh, str_val: "")
                elif op == "!=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh != rh, str_val: "")
                elif op == "<":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh < rh, str_val: "")
                elif op == "<=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh <= rh, str_val: "")
                elif op == ">":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh > rh, str_val: "")
                elif op == ">=":
                    return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lh >= rh, str_val: "")
        
        if lhs.kind == TYPE_BOOL and rhs.kind == TYPE_BOOL:
            let lb = lhs.bool_val
            let rb = rhs.bool_val
            if op == "and" or op == "&&":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb and rb, str_val: "")
            elif op == "or" or op == "||":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb or rb, str_val: "")
            elif op == "==":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb == rb, str_val: "")
            elif op == "!=":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: lb != rb, str_val: "")
                
        if lhs.kind == TYPE_STRING and rhs.kind == TYPE_STRING:
            let ls = lhs.str_val
            let rs = rhs.str_val
            if op == "+":
                return ComptimeValue(kind: TYPE_STRING, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: std.string.concat(ls, rs))
            elif op == "==":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: ls == rs, str_val: "")
            elif op == "!=":
                return ComptimeValue(kind: TYPE_BOOL, int_val: 0 as i64, float_val: 0.0, bool_val: ls != rs, str_val: "")
                
    return ComptimeValue(kind: TYPE_VOID, int_val: 0 as i64, float_val: 0.0, bool_val: false, str_val: "")

// RFC 0017 / BUG#82: is a module-level global's initializer a compile-time constant
// scalar that the backend can fold into the data image? Phase 1 accepts literal
// constants (and a leading unary +/- on one); absent init (idx 0) folds to zero. Must
// stay in lockstep with air_builder.builder_fold_global_init (which does the fold).
pub fn ax_global_init_is_const(tree: ptr[AstTree], idx: u32) -> bool:
    if idx == 0 as u32:
        return true
    let n = tree.nodes.data[idx as i64]
    if n.kind == NODE_INT_LIT or n.kind == NODE_FLOAT_LIT or n.kind == NODE_BOOL_LIT or n.kind == NODE_CHAR_LIT or n.kind == NODE_NIL_LIT:
        return true
    // A leading unary +/- on a constant, or a cast of a constant (`0 as u64`), is still a
    // compile-time constant â€” recurse into the operand. Casts are pervasive in real
    // stdlib globals (`mut g: u64 = 0 as u64`).
    if n.kind == NODE_UNARY_EXPR or n.kind == NODE_CAST_EXPR:
        return ax_global_init_is_const(tree, n.first_child)
    return false

// RFC 0017 / BUG#82: validate one module-level `let`/`mut` declaration. Rejects
// (with a diagnostic + diags_count bump so the driver halts before codegen) any global
// that is not a scalar (primitive/pointer, size 1..8) or whose initializer is not a
// compile-time constant. `const` decls are a separate node kind (inlined, not storage)
// and never reach here.
pub fn check_module_global(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx == 0 as u32:
        return
    let type_id = self.symtable.symbols.data[sym_idx].type_id
    let name = self.intern.get(self.symtable.symbols.data[sym_idx].name_id)

    // Separate the initializer from an optional type annotation.
    mut init_expr := 0 as u32
    mut ann_node := 0 as u32
    mut child := self.tree.nodes.data[node_idx].first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_GENERIC_TYPE:
            init_expr = child
        else:
            ann_node = child
        child = cn.next_sibling

    // RFC 0017 P2: an `Option[T]` / `Result[T,E]` annotation is deliberately left
    // UNRESOLVED (type_id 0) by the general NODE_GENERIC_TYPE inference path, because
    // retyping every such annotation to the kind-11/12 pointer-repr entry would shift
    // the RFC 0012 str-box EQ/COPY/MAKE_REF paths and break self-compilation (see the
    // array-element note in infer_node). Resolve it HERE â€” scoped to a MODULE-LEVEL
    // global declaration only â€” and pin the symbol's type_id so collect_global and
    // lower_global_read see the pointer-repr type. The compiler's own source has no
    // module-level Option/Result globals, so the self-host fixpoint is unaffected.
    mut type_id2 = type_id
    if type_id2 == 0 as u32 and ann_node != 0 as u32 and self.tree.nodes.data[ann_node].kind == NODE_GENERIC_TYPE:
        let ab = self.tree.nodes.data[ann_node].first_child
        if ab != 0 as u32:
            let abname = self.node_text(ab)
            if abname == "Option":
                let a1 = self.tree.nodes.data[ab].next_sibling
                mut it := TYPE_UNKNOWN
                if a1 != 0 as u32:
                    it = self.infer_node(a1, TYPE_UNKNOWN)
                type_id2 = self.types.register_option(it)
            elif abname == "Result":
                let a1 = self.tree.nodes.data[ab].next_sibling
                mut okt := TYPE_UNKNOWN
                mut ert := TYPE_UNKNOWN
                if a1 != 0 as u32:
                    okt = self.infer_node(a1, TYPE_UNKNOWN)
                    let a2 = self.tree.nodes.data[a1].next_sibling
                    if a2 != 0 as u32:
                        ert = self.infer_node(a2, TYPE_UNKNOWN)
                type_id2 = self.types.register_result(okt, ert)
            safe_free_str(abname)
            if type_id2 != 0 as u32:
                self.symtable.symbols.data[sym_idx].type_id = type_id2

    // A global is supported if it is either a scalar (primitive/pointer/ref of size
    // 1..8, stored inline in `.data`) OR â€” RFC 0017 P2 â€” a by-address AGGREGATE:
    // a struct, fixed array, or tuple. Aggregate globals get a zeroed `.data` slot
    // sized to the type; a present initializer is evaluated at program entry (the
    // `main` prologue) and block-copied into that slot (see collect_global /
    // lower_global_read). Pointer-repr sum/Option/Result globals are still deferred
    // (they need the 8-byte box-pointer store path, not a block copy).
    mut supported := false
    if type_id2 != 0 as u32 and (type_id2 as i64) < self.types.entries.len:
        let k = self.types.entries.data[type_id2 as i64].kind
        if k == TYPE_KIND_PRIMITIVE or k == TYPE_KIND_POINTER or k == TYPE_KIND_REF:
            mut gsize := 0 as u32
            mut galign := 0 as u32
            builder_type_size_and_align(self.types, type_id2, &gsize, &galign)
            if gsize >= 1 as u32 and gsize <= 8 as u32:
                supported = true
            elif gsize == 16 as u32:
                // RFC 0017 P2: `str`/`bytes` â€” a 16-byte INLINE primitive ({ptr,len}).
                // NOT a by-address aggregate: the value's home holds all 16 bytes. The
                // `.data` slot is 16 bytes; init is runtime (both halves stored inline,
                // NOT a block copy from an address). See collect_global / OP_LOAD in the
                // selector (16-byte inline load path, mirroring OP_GET_FIELD for str).
                supported = true
        elif k == TYPE_KIND_STRUCT or k == TYPE_KIND_ARRAY or k == TYPE_KIND_TUPLE:
            supported = true
        elif k == TYPE_KIND_INTERFACE:
            // RFC 0017 + RFC 0029: an INTERFACE global. An interface value is an 8-byte
            // pointer to its heap vtable box ({data, m0..mN}, built at the T->I coercion),
            // so it needs no new storage strategy at all â€” it is an 8-byte slot in `.data`,
            // runtime-initialized at program entry like any non-const scalar. The coercion
            // and conformance checks already run at the assignment/initializer site, so a
            // global is just another value site for them.
            supported = true
        elif type_is_pointer_repr(self.types, self.intern, type_id2):
            // RFC 0017 P2: a sum/Option/Result global. Its VALUE is an 8-byte tagged
            // box pointer (entry.size 16 = the heap box, NOT the slot). Stored inline
            // as an 8-byte pointer in `.data`, runtime-initialized at program entry
            // (the box is heap-allocated then its pointer stored). See collect_global /
            // lower_global_read (both route pointer-repr through an 8-byte load/store,
            // NOT a block copy).
            supported = true
    if not supported:
        ax_printf_local("error: module-level global '%s' must be a scalar, struct, fixed-array, tuple, or sum/Option/Result type\n", get_str_ptr(name) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.diags_count = self.diags_count + 1 as i64
        return

    // RFC 0017 P2: non-constant scalar initializers are now supported â€” they are
    // evaluated at program entry (a prologue in `main`, in source-declaration order)
    // rather than folded into `.data`. Only aggregate globals remain rejected above.
    // `init_expr` is left to be type-checked by the normal declaration traversal.

// --- Missing-return analysis (BUG#53 family) ---------------------------------
// A non-void function that can fall off the end of its body silently returns a
// garbage register (AXIOM has no implicit last-expression return). `stmt_terminates`
// is a CONSERVATIVE structural check: it returns true only when control provably
// leaves the function (or diverges) at this statement. To avoid false positives
// that would reject valid code, loops and trailing call-expressions (which may be
// `panic`/`abort`/noreturn) are treated as terminating -- we accept missing some
// real fall-throughs (false negatives) in exchange for never rejecting valid code.
pub fn tc_last_child(self: ptr[TypeChecker], node_idx: u32) -> u32:
    mut last := 0 as u32
    mut child := self.tree.nodes.data[node_idx].first_child
    while child != 0 as u32:
        last = child
        child = self.tree.nodes.data[child].next_sibling
    return last

pub fn stmt_terminates(self: ptr[TypeChecker], node_idx: u32) -> bool:
    if node_idx == 0 as u32:
        return false
    let kind = self.tree.nodes.data[node_idx].kind
    if kind == NODE_RETURN_STMT:
        return true
    if kind == NODE_BLOCK:
        return self.stmt_terminates(self.tc_last_child(node_idx))
    if kind == NODE_WHILE_STMT or kind == NODE_FOR_STMT:
        // Generous: a loop may run forever or `return` from inside; treating it as
        // terminating avoids false positives on `while true:` dispatch loops.
        return true
    if kind == NODE_CALL_EXPR:
        // Generous: a trailing bare call may be a noreturn `panic`/`abort`/`exit`.
        return true
    if kind == NODE_IF_STMT:
        // children: cond, if-body(block), elif-clause*, else-clause?
        // Terminates iff there IS an else clause and every branch terminates.
        mut has_else := false
        mut all_term := true
        mut seen_body := false
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let ck = self.tree.nodes.data[child].kind
            if ck == NODE_BLOCK:
                if not seen_body:
                    seen_body = true
                    if not self.stmt_terminates(child):
                        all_term = false
            elif ck == NODE_ELIF_CLAUSE:
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            elif ck == NODE_ELSE_CLAUSE:
                has_else = true
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            child = self.tree.nodes.data[child].next_sibling
        return has_else and all_term
    if kind == NODE_MATCH_STMT:
        // children: scrutinee, arm*. Terminates iff every arm terminates AND the
        // match is not a CONFIRMED non-exhaustive one (which can fall through off the
        // end). The FLAG_MATCH_PARTIAL bit is set by the typechecker only when it is
        // certain a variant is uncovered with no catch-all, so an unmarked match is
        // conservatively treated as total.
        if (self.tree.nodes.data[node_idx].flags & FLAG_MATCH_PARTIAL) != 0 as u16:
            return false
        mut any_arm := false
        mut all_term := true
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            if self.tree.nodes.data[child].kind == NODE_MATCH_ARM:
                any_arm = true
                if not self.stmt_terminates(self.tc_last_child(child)):
                    all_term = false
            child = self.tree.nodes.data[child].next_sibling
        return any_arm and all_term
    return false

// A `defer Expr` is registered STATICALLY at lowering time (air_builder self.defers, in
// textual order) and flushed at function exit. That is correct ONLY for an unconditional,
// straight-line defer that executes exactly once per call. Inside an `if`/`while`/`for`/
// `match` body the static model MISCOMPILES: the defer runs even when its branch is not
// taken (confirmed: a `defer` under `if false:` still ran), and runs only ONCE regardless
// of loop iteration count. Until a dynamic (per-execution) defer model exists (would need
// an RFC + a runtime defer stack), REJECT a `defer` nested in control flow rather than
// silently miscompile (BUG#53 accept-then-miscompile convention). Recursion stops at a
// nested NODE_FUNC_DECL so each function's defers are judged in their own scope. `defer` is
// unused in the compiler/std sources, so this reject is self-build-safe (A==B).
pub fn check_defer_placement(mut self: ptr[TypeChecker], node_idx: u32, in_cf: bool):
    if node_idx == 0 as u32:
        return
    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind
    if kind == NODE_FUNC_DECL:
        return
    if kind == NODE_DEFER_STMT:
        if in_cf:
            ax_printf_local("error: `defer` inside a loop or conditional is not supported (static registration would run it when the branch is not taken, or only once in a loop); move it to the function body's top level\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            self.diags_count = self.diags_count + 1 as i64
        return
    mut child_cf := in_cf
    if kind == NODE_IF_STMT or kind == NODE_WHILE_STMT or kind == NODE_FOR_STMT or kind == NODE_MATCH_STMT:
        child_cf = true
    mut c := node.first_child
    while c != 0 as u32:
        let nxt = self.tree.nodes.data[c].next_sibling
        self.check_defer_placement(c, child_cf)
        c = nxt

pub fn tc_func_body(self: ptr[TypeChecker], func_idx: u32) -> u32:
    mut child := self.tree.nodes.data[func_idx].first_child
    while child != 0 as u32:
        if self.tree.nodes.data[child].kind == NODE_BLOCK:
            return child
        child = self.tree.nodes.data[child].next_sibling
    return 0 as u32

// Returns true ONLY when the typechecker is CERTAIN a match does not cover all
// cases: the scrutinee resolves to a sum/Option/Result whose full variant set is
// known, there is NO catch-all (wildcard or bare-binding) arm, and at least one
// variant is left uncovered. Any uncertainty (unknown type, unresolved
// generic-inst base, out-of-range index, non-sum scrutinee) returns false so the
// missing-return terminator analysis treats the match as total and never rejects
// valid code. AXIOM allows non-exhaustive matches to FALL THROUGH, so this is used
// only to decide whether a match is a guaranteed terminator -- it is NOT a
// standalone exhaustiveness error.
pub fn match_is_confidently_partial(self: ptr[TypeChecker], match_idx: u32, scrutinee_type: u32) -> bool:
    if scrutinee_type == TYPE_UNKNOWN or (scrutinee_type as i64) >= self.types.entries.len:
        return false
    let s_entry = self.types.entries.data[scrutinee_type as i64]
    if not (s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST or s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT):
        return false
    // OPTION/RESULT (kind 11/12) are NOT backed by a `sumtypes` entry: their `.extra`
    // is the INNER/ok TYPE id, not a sumtypes index. Feeding it to the sumtypes lookup
    // below reads a garbage `variants` pointer -> crash (surfaces once a match scrutinee
    // is actually typed OPTION, e.g. an element read from `[Option[T];N]`). Their
    // exhaustiveness is not sumtypes-driven, so conservatively report "not confidently
    // partial" (treated as total; never false-rejects a missing return).
    if s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT:
        return false
    mut sum_extra := s_entry.extra
    if s_entry.kind == TYPE_KIND_GENERIC_INST:
        mut resolved := false
        mut idx := 0 as i64
        while idx < self.types.entries.len:
            let e = self.types.entries.data[idx]
            let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
            let s_base = extract_qualified_base_name(self.intern.get(s_entry.name_id))
            if e.kind == TYPE_KIND_SUM and e_base == s_base:
                sum_extra = e.extra
                resolved = true
                break
            idx = idx + 1
        if not resolved:
            return false
    if (sum_extra as i64) >= self.types.sumtypes.len:
        return false
    let sum_info = self.types.sumtypes.data[sum_extra]
    // Pass 1: a wildcard or a TRUE catch-all bare-binding arm covers everything ->
    // total. A bare NODE_BINDING_PAT whose name IS a variant of this sum is a
    // no-payload TAG-match (mirrors air_builder ~2833-2846: `find_variant_info` on
    // the bound name), NOT a catch-all -- so it must NOT short-circuit here, else a
    // non-exhaustive no-payload-enum match (`Red | Green | Blue` matching only Red,
    // Green) is wrongly treated as total and the missing-return terminator check is
    // suppressed -> silent garbage fall-through. (If the binding payload is not yet
    // resolved to a symbol, treat it conservatively as a catch-all == prior behavior.)
    mut child := self.tree.nodes.data[match_idx].first_child
    if child != 0 as u32:
        child = self.tree.nodes.data[child].next_sibling
    while child != 0 as u32:
        if self.tree.nodes.data[child].kind == NODE_MATCH_ARM:
            let pat = self.tree.nodes.data[child].first_child
            if pat != 0 as u32:
                let pk = self.tree.nodes.data[pat].kind
                if pk == NODE_WILDCARD_PAT:
                    return false
                if pk == NODE_BINDING_PAT:
                    if not self.binding_pat_is_variant(pat, sum_info):
                        return false
        child = self.tree.nodes.data[child].next_sibling
    // Pass 2: every declared variant must be covered by a VARIANT_PAT arm OR a bare
    // no-payload variant BINDING_PAT arm (both are tag-matches at lowering time).
    mut vi := 0 as i64
    while vi < sum_info.variants.len:
        let v_name = sum_info.variants.data[vi].name_id
        mut covered := false
        mut c2 := self.tree.nodes.data[match_idx].first_child
        if c2 != 0 as u32:
            c2 = self.tree.nodes.data[c2].next_sibling
        while c2 != 0 as u32:
            if self.tree.nodes.data[c2].kind == NODE_MATCH_ARM:
                let pat = self.tree.nodes.data[c2].first_child
                if pat != 0 as u32:
                    let pkk = self.tree.nodes.data[pat].kind
                    if pkk == NODE_VARIANT_PAT or pkk == NODE_BINDING_PAT:
                        let vsym = self.tree.nodes.data[pat].payload
                        if vsym != 0 as u32 and (vsym as i64) < self.symtable.symbols.len:
                            if self.symtable.symbols.data[vsym].name_id == v_name:
                                covered = true
            c2 = self.tree.nodes.data[c2].next_sibling
        if not covered:
            return true
        vi = vi + 1
    return false

// True if a bare NODE_BINDING_PAT's bound name matches a declared variant of the
// given sum (a no-payload tag-match), false for a genuine catch-all binding or an
// as-yet-unresolved pattern. Mirrors air_builder's find_variant_info-by-name.
pub fn binding_pat_is_variant(self: ptr[TypeChecker], pat: u32, sum_info: SumInfo) -> bool:
    let bsi = self.tree.nodes.data[pat].payload
    if bsi == 0 as u32 or (bsi as i64) >= self.symtable.symbols.len:
        return false
    let bnid = self.symtable.symbols.data[bsi as i64].name_id
    mut vj := 0 as i64
    while vj < sum_info.variants.len:
        if sum_info.variants.data[vj].name_id == bnid:
            return true
        vj = vj + 1
    return false

pub fn run_type_checker(mut self: ptr[TypeChecker]):
    // Phase 0.0: Pre-register all Struct Type IDs (empty) to allow mutual / forward
    // references. MUST run before Phase 0.1 (sum-type pre-inference): a sum variant
    // with a STRUCT payload (`type Shape = Dot(Point) | ...`) infers that payload's
    // type during pre_infer_type_alias, which needs the struct's type_id to already
    // exist. When this ran AFTER the sum pass, such a payload resolved to UNKNOWN, so
    // the match binding was untyped and a `p.field` access could not resolve the
    // field index (it defaulted to 0 â€” reading the wrong field).
    mut i := 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_STRUCT_DECL:
            let sym_idx = node.payload
            if sym_idx != 0 as u32:
                let sym = self.symtable.symbols.data[sym_idx]
                if sym.type_id == 0 as u32:
                    let struct_type_id = self.types.register_struct(sym.name_id, StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0))
                    self.symtable.symbols.data[sym_idx].type_id = struct_type_id
        elif node.kind == NODE_INTERFACE_DECL:
            // BUG#71 prerequisite: without this, `sym.type_id` for an interface
            // name stays 0/TYPE_UNKNOWN forever (nothing else in typecheck.ax
            // ever touches NODE_INTERFACE_DECL), so a param typed `s: Shape`
            // resolves to TYPE_UNKNOWN rather than something recognizable as
            // "an interface" -- which is what let dynamic-dispatch calls through
            // it silently resolve to an arbitrary same-named method instead of
            // being rejected. Giving interfaces a real (minimal) type_id here is
            // what makes that rejection check able to fire at all.
            let sym_idx = node.payload
            if sym_idx != 0 as u32:
                let sym = self.symtable.symbols.data[sym_idx]
                if sym.type_id == 0 as u32:
                    let iface_type_id = self.types.register_interface(sym.name_id)
                    self.symtable.symbols.data[sym_idx].type_id = iface_type_id
                    // RFC 0029 step 1: record the ordered method-name list (vtable slot
                    // layout). Walk NODE_METHOD_SIG children in declaration order; the
                    // slot index of each method is its position here. Inert for now â€”
                    // nothing consumes iface_methods until impl-matching/dispatch land.
                    mut ifm := new_u32_vec()
                    mut mch := node.first_child
                    while mch != 0 as u32:
                        let mcn = self.tree.nodes.data[mch]
                        if mcn.kind == NODE_METHOD_SIG:
                            (&ifm).push(mcn.payload)
                        mch = mcn.next_sibling
                    self.types.register_interface_methods(iface_type_id, ifm)
        i = i + 1

    // Phase 0.1: Register all Type Aliases / Sum Types (struct type_ids now exist,
    // so struct-typed variant payloads resolve to the right type).
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_TYPE_ALIAS_DECL:
            self.pre_infer_type_alias(i as u32)
        i = i + 1

    // Phase 1: Register all StructDeclarations
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node = self.tree.nodes.data[i]
        if node.kind == NODE_STRUCT_DECL:
            self.pre_infer_struct(i as u32)
        i = i + 1

    // Phase 2: Register all function signatures
    i = 0 as i64
    while i < self.tree.nodes.len:
        let node2 = self.tree.nodes.data[i]
        if node2.kind == NODE_FUNC_DECL:
            self.pre_infer_func_signature(i as u32)
        i = i + 1

    // Phase 3: Traversal type inference
    self.infer_node(0 as u32, TYPE_UNKNOWN)

    // Phase 3.5 (mangling uniquing, [[bug-freefn-stdlib-collision-noarg]]): a user free fn
    // whose name collides with a bundled stdlib free fn where BOTH bare-mangle to
    // `ax_<name>` (scalar/str/no receiver) would link-merge and silently mis-dispatch
    // (SIGSEGV / wrong result). The backend already emits a UNIQUE `ax_<name>__m<idx>` for
    // any symbol flagged SYM_FLAG_MODDUP, but the resolver only sets that for CROSS-TREE
    // dups â€” and the driver concatenates stdlib+user into ONE tree, so same-tree collisions
    // slip through. Tag every bare-mangling function that shares its name with an EARLIER
    // bare-mangling function so each gets a distinct symbol; the FIRST keeps the bare name
    // (existing callers unchanged). Paired with the arity disambiguation in
    // resolve_free_call_overload, the call binds to the user's symbol and targets its unique
    // body. Types are resolved now, so the struct-receiver test is reliable. Precompute the
    // bare-mangle bitmap once (O(n)) so the pairwise scan is plain integer comparisons.
    let nsym = self.symtable.symbols.len
    if nsym > 1 as i64:
        mut bare := @alloc(nsym) as ptr[u8]
        mut bi := 0 as i64
        while bi < nsym:
            if self.free_fn_bare_mangles(bi as u32):
                bare[bi] = 1 as u8
            else:
                bare[bi] = 0 as u8
            bi = bi + 1
        mut mi := 1 as i64
        while mi < nsym:
            if bare[mi] == 1 as u8:
                let nm_id = self.symtable.symbols.data[mi].name_id
                mut mj := 0 as i64
                mut collides := false
                while mj < mi:
                    if bare[mj] == 1 as u8 and self.symtable.symbols.data[mj].name_id == nm_id:
                        collides = true
                        mj = mi
                    mj = mj + 1
                if collides:
                    self.symtable.symbols.data[mi].flags = self.symtable.symbols.data[mi].flags | 2048 as u16
            mi = mi + 1
        @free(bare as ptr[u8])

    // Phase 4 (RFC 0017 / BUG#82): validate module-level global variables. A
    // module-level `let`/`mut` (not `const`) gets real static storage in the backend
    // (OP_GLOBAL_ADDR + a writable data slot). Phase 1 supports only *scalar* globals
    // (primitive/pointer, size <= 8) with a *compile-time-constant* initializer folded
    // into the data image. Reject anything else with a diagnostic instead of silently
    // miscompiling (BUG#53 convention). Types are resolved now (post-inference), so the
    // size check is reliable. Module scope = direct children of the root node.
    mut gchild := self.tree.nodes.data[0].first_child
    while gchild != 0 as u32:
        let gnode = self.tree.nodes.data[gchild]
        if gnode.kind == NODE_VAR_DECL:
            self.check_module_global(gchild)
        gchild = gnode.next_sibling

    // Phase 5 (accept-then-miscompile, BUG#53 class â€” "forgot to unwrap"): a bare
    // FIELD load `o.field` on a value whose type is Option[T]/Result[T,E] silently read
    // offset 0 of the box/tag (garbage) instead of the payload's field â€” the user meant
    // `o.unwrap().field` (or a match). Option/Result are SUM types (`Some(T) | None`)
    // with NO user-accessible data fields, so ANY bare field-load on such a value is a
    // mistake. Runs POST-inference (node_types populated + generic returns recovered by
    // the BUG#61 recovery blocks), so the receiver type is reliable even for a chained
    // `v.get(i).field` receiver â€” the inference-time attempt failed precisely because
    // that chained receiver was still untyped mid-traversal. Method calls (`o.unwrap()`)
    // are field-expr CALLEES: excluded via a callee bitmap. Qualified constructor forms
    // (`Option.Some(x)`) are excluded both as callees and by the bare-type-name guard.
    let nnodes = self.tree.nodes.len
    if nnodes > 0 as i64:
        mut callee_bm := @alloc(nnodes) as ptr[u8]
        mut ci := 0 as i64
        while ci < nnodes:
            callee_bm[ci] = 0 as u8
            ci = ci + 1
        ci = 0 as i64
        while ci < nnodes:
            if self.tree.nodes.data[ci].kind == NODE_CALL_EXPR:
                let cc = self.tree.nodes.data[ci].first_child
                if cc != 0 as u32 and (cc as i64) < nnodes:
                    callee_bm[cc as i64] = 1 as u8
            ci = ci + 1
        mut fi2 := 0 as i64
        while fi2 < nnodes:
            let fnode = self.tree.nodes.data[fi2]
            if fnode.kind == NODE_FIELD_EXPR and callee_bm[fi2] == 0 as u8:
                let frecv = fnode.first_child
                if frecv != 0 as u32 and (frecv as i64) < self.node_types_cap:
                    mut frt := self.node_types[frecv as i64]
                    if frt != TYPE_UNKNOWN and (frt as i64) < self.types.entries.len:
                        mut frue := self.types.entries.data[frt as i64]
                        while frue.kind == TYPE_KIND_POINTER or frue.kind == TYPE_KIND_REF:
                            frt = frue.extra as u32
                            frue = self.types.entries.data[frt as i64]
                        // Detect Option/Result robustly: a concrete Option[Cell] is a
                        // MONOMORPHIZED sum entry named `_AX_std_Option__Cell` (payload
                        // separator `Option__`), NOT the bare TYPE_KIND_OPTION â€” so match
                        // both the raw kind AND the mangled `Option__`/`Result__` name (the
                        // same forms the `.new()` collection detection uses at ~3628).
                        mut is_opt_res := false
                        if frue.kind == TYPE_KIND_OPTION or frue.kind == TYPE_KIND_RESULT:
                            is_opt_res = true
                        elif (frue.kind == TYPE_KIND_GENERIC_INST or frue.kind == TYPE_KIND_SUM) and frue.name_id != 0 as u32:
                            let frnm = self.intern.get(frue.name_id)
                            if std.string.contains(frnm, "Option__") or std.string.contains(frnm, "Result__"):
                                is_opt_res = true
                            safe_free_str(frnm)
                        if is_opt_res:
                            // Exclude a bare TYPE-NAME receiver (`Option.None`, qualified form):
                            // its first_child ident binds to a type symbol, not a value.
                            mut is_typename := false
                            let rcn = self.tree.nodes.data[frecv as i64]
                            if rcn.kind == NODE_IDENT or rcn.kind == NODE_TYPE_EXPR:
                                let rcsym = rcn.payload
                                if rcsym != 0 as u32 and (rcsym as i64) < self.symtable.symbols.len:
                                    let rck = self.symtable.symbols.data[rcsym as i64].kind
                                    if rck == SYM_STRUCT or rck == SYM_TYPE_ALIAS or rck == SYM_INTERFACE or rck == SYM_BUILTIN_TYPE:
                                        is_typename = true
                            if not is_typename:
                                let ufn = self.intern.get(fnode.payload)
                                ax_printf_local("error: cannot access field '%s' on an Option/Result value; unwrap it first (.unwrap() or match) before accessing the payload\n", get_str_ptr(ufn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                safe_free_str(ufn)
                                self.diags_count = self.diags_count + 1 as i64
            fi2 = fi2 + 1
        @free(callee_bm as ptr[u8])

pub fn get_full_mangled_name(self: ptr[TypeChecker], sym_idx: u32) -> str:
    let sym = self.symtable.symbols.data[sym_idx]
    let sym_name = self.intern.get(sym.name_id)
    
    let lazy_ptr = self.symtable.lazy_resolver as ptr[LazyResolver]
    if lazy_ptr != null as ptr[LazyResolver]:
        let mod = lazy_resolver_find_module_of_symbol(lazy_ptr, sym_idx)
        if mod != null as ptr[ModuleInfo]:
            let mod_name = self.intern.get(mod.name_id)
            let full_name = std.string.concat(mod_name, std.string.concat(".", sym_name))
            safe_free_str(mod_name)
            safe_free_str(sym_name)
            return full_name
            
    return sym_name

// True when `name` is a bare builtin/primitive type name (i32, string, bool, â€¦).
// Used to reject `type ID = i32 | string` â€” a union whose "variants" are primitive
// TYPES rather than named constructors (see pre_infer_type_alias).
fn is_primitive_type_name(name: str) -> bool:
    return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "int" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "rune" or name == "f32" or name == "f64" or name == "bool" or name == "string" or name == "str" or name == "bytes" or name == "char8" or name == "void" or name == "isize" or name == "usize"

pub fn pre_infer_type_alias(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        if sym.type_id == 0 as u32:
            mut sum_node := 0 as u32
            mut child := self.tree.nodes.data[node_idx].first_child
            while child != 0 as u32:
                let child_node = self.tree.nodes.data[child]
                if child_node.kind == NODE_SUM_TYPE:
                    sum_node = child
                    break
                child = child_node.next_sibling
            
            if sum_node != 0 as u32:
                mut variants := new_variant_info_vec()
                mut tag := 0 as u8
                // The names Some/None (Ok/Err) are reserved for the builtin Option
                // (Result) sum: the CONSTRUCTOR always lowers those tokens to the
                // pointer-tagged builtin layout (null / box|1), regardless of any user
                // sum declaring them. A user sum reusing such a name would therefore get
                // a MIXED representation (its other variants tag-at-field-0, the shadowed
                // one builtin) and silently miscompile on match. Reject it (rename the
                // variant); full support would need type-directed construction (RFC).
                let sum_base_nm = extract_qualified_base_name(self.intern.get(sym.name_id))
                let sum_is_builtin = sum_base_nm == "Option" or sum_base_nm == "Result"
                // Count variants up front: a bare-primitive "variant" is only the
                // union-of-primitives BUG when the alias is a genuine MULTI-variant union
                // (`type ID = i32 | string`). A SINGLE-variant `type UserId = i64` is a
                // transparent primitive type ALIAS (like `type CPtr = ptr[u8]`) â€” it
                // assigns/reads fine and must NOT be rejected. See is_primitive_type_name use.
                mut variant_count := 0 as i64
                mut vc_node := self.tree.nodes.data[sum_node].first_child
                while vc_node != 0 as u32:
                    if self.tree.nodes.data[vc_node].kind == NODE_VARIANT_DECL:
                        variant_count = variant_count + 1 as i64
                    vc_node = self.tree.nodes.data[vc_node].next_sibling
                // Detect a genuinely SELF-RECURSIVE non-generic sum: a variant field that is a BARE
                // reference (NODE_TYPE_EXPR, payload == this sum's own symbol) to the sum being
                // defined â€” e.g. `Node(Tree, Tree)`. A generic template / mono clone references
                // itself as `Tree[T]`/`Tree[i64]` (NODE_GENERIC_TYPE, resolved via the generic_inst
                // path â€” bug92), so the kind check excludes them; a non-recursive sum has no such
                // field. Only when found do we forward-declare the sum's type_id (below) so the bare
                // self-ref resolves instead of yielding TYPE_UNKNOWN and mistyping the match binder.
                // [[bug-recursive-nongeneric-multifield-sum]].
                mut has_bare_self_ref := false
                mut sr_v := self.tree.nodes.data[sum_node].first_child
                while sr_v != 0 as u32:
                    let sr_vn = self.tree.nodes.data[sr_v]
                    if sr_vn.kind == NODE_VARIANT_DECL:
                        mut sr_f := sr_vn.first_child
                        while sr_f != 0 as u32:
                            let sr_fn = self.tree.nodes.data[sr_f]
                            if sr_fn.kind == NODE_TYPE_EXPR and sr_fn.payload == sym_idx:
                                has_bare_self_ref = true
                            sr_f = sr_fn.next_sibling
                    sr_v = sr_vn.next_sibling
                mut reserved_sum_id := 0 as u32
                if has_bare_self_ref:
                    reserved_sum_id = self.types.reserve_sum_type(sym.name_id)
                    self.symtable.symbols.data[sym_idx].type_id = reserved_sum_id
                mut v_node := self.tree.nodes.data[sum_node].first_child
                while v_node != 0 as u32:
                    let v_node_struct = self.tree.nodes.data[v_node]
                    let next_sibling = v_node_struct.next_sibling
                    if v_node_struct.kind == NODE_VARIANT_DECL:
                        let v_sym_idx = v_node_struct.payload
                        if v_sym_idx != 0 as u32:
                            let v_sym = self.symtable.symbols.data[v_sym_idx]
                            if not sum_is_builtin:
                                let vnm = self.intern.get(v_sym.name_id)
                                if vnm == "Some" or vnm == "None" or vnm == "Ok" or vnm == "Err":
                                    ax_printf_local("error: sum variant '%s' shadows a builtin Option/Result variant; rename it (Some/None are reserved for Option, Ok/Err for Result)\n", get_str_ptr(vnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    self.diags_count = self.diags_count + 1 as i64
                                // A "variant" whose NAME is a bare primitive/builtin type
                                // (`type ID = i32 | string`) is an aspirational union-of-primitives,
                                // NOT a named constructor. It has no payload box, yet a match
                                // pattern `i32(v)` binds a payload â†’ deref of garbage â†’ SIGSEGV
                                // (accept-then-crash, BUG#53 class). Reject at the DECLARATION:
                                // this distinguishes it cleanly from valid payload-less constructors
                                // (`Nil`/`Empty`) and from Option/Result, and never fires on compiler
                                // source (zero prim-named variants). Full union-of-primitives support
                                // (tag + inline value, no box) is a larger RFC-gated feature.
                                if variant_count > 1 as i64 and is_primitive_type_name(vnm):
                                    ax_printf_local("error: sum type variant '%s' is a bare primitive type; a union of primitive types is not supported â€” use a named constructor (e.g. `IntId(i32)`) instead\n", get_str_ptr(vnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    self.diags_count = self.diags_count + 1 as i64
                            
                            mut payload_type := TYPE_UNKNOWN
                            let type_expr_node = v_node_struct.first_child
                            if type_expr_node != 0 as u32:
                                let first_pl_ty = self.infer_node(type_expr_node, TYPE_UNKNOWN)
                                // RFC 0019: desugar a payload into a SYNTHESIZED struct when it is
                                // (a) MULTI-field (`Rect(i64,i64)`), or (b) a SINGLE >8-byte primitive
                                // like `str` â€” the sum box has a fixed 8-byte payload slot, so a 16-byte
                                // str stored inline overflows/truncates (returned 0). Wrapping makes the
                                // payload an 8-byte struct POINTER that fits, reusing the proven
                                // single-struct-payload path. Scalars (<=8B) and existing aggregate
                                // payloads stay as-is. The synth struct is flagged (flags bit 0) so the
                                // constructor/match know to gather/split its fields.
                                mut do_wrap := self.tree.nodes.data[type_expr_node].next_sibling != 0 as u32
                                if not do_wrap and first_pl_ty != TYPE_UNKNOWN and (first_pl_ty as i64) < self.types.entries.len:
                                    let fe = self.types.entries.data[first_pl_ty as i64]
                                    if fe.kind == TYPE_KIND_PRIMITIVE and fe.size > 8 as u32:
                                        do_wrap = true
                                if do_wrap:
                                    mut synth_fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
                                    mut ptn := type_expr_node
                                    mut fidx := 0 as i64
                                    while ptn != 0 as u32:
                                        let ft = self.infer_node(ptn, TYPE_UNKNOWN)
                                        let fn_str = std.string.concat("_f", format_int(fidx))
                                        let fname_id = self.intern.intern(fn_str)
                                        safe_free_str(fn_str)
                                        (&synth_fields).push(StructField(name_id: fname_id, type_id: ft))
                                        ptn = self.tree.nodes.data[ptn].next_sibling
                                        fidx = fidx + 1 as i64
                                    let sumnm = self.intern.get(sym.name_id)
                                    let vnm = self.intern.get(v_sym.name_id)
                                    let synth_nm = std.string.concat("__mfv_", std.string.concat(sumnm, std.string.concat("_", vnm)))
                                    let synth_nm_id = self.intern.intern(synth_nm)
                                    safe_free_str(synth_nm)
                                    safe_free_str(sumnm)
                                    safe_free_str(vnm)
                                    payload_type = self.types.register_struct(synth_nm_id, synth_fields)
                                    // Flag the synth struct (bit 0) so lowering routes it through the
                                    // gather/split path even for a single field.
                                    if (payload_type as i64) < self.types.entries.len:
                                        self.types.entries.data[payload_type as i64].flags = self.types.entries.data[payload_type as i64].flags | 1 as u16
                                else:
                                    payload_type = first_pl_ty

                            variants.push(VariantInfo(
                                name_id: v_sym.name_id,
                                payload_type: payload_type,
                                tag: tag,
                                padding1: 0 as u8,
                                padding2: 0 as u16,
                            ))
                            tag = tag + 1 as u8
                    v_node = next_sibling
                
                // Self-recursive (bare self-ref): populate the sum reserved above (no 2nd entry).
                // Otherwise register normally â€” byte-identical to the pre-fix path.
                mut type_id := 0 as u32
                if has_bare_self_ref:
                    self.types.set_sum_variants(reserved_sum_id, variants)
                    type_id = reserved_sum_id
                else:
                    type_id = self.types.register_sum_type(sym.name_id, variants)
                self.symtable.symbols.data[sym_idx].type_id = type_id
                self.set_node_type(node_idx, type_id)
                
                // Assign sum type TypeID to each variant symbol
                v_node = self.tree.nodes.data[sum_node].first_child
                while v_node != 0 as u32:
                    let v_node_struct = self.tree.nodes.data[v_node]
                    if v_node_struct.kind == NODE_VARIANT_DECL:
                        let v_sym_idx = v_node_struct.payload
                        if v_sym_idx != 0 as u32:
                            self.symtable.symbols.data[v_sym_idx].type_id = type_id
                    v_node = v_node_struct.next_sibling

pub fn pre_infer_struct(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        mut fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind == NODE_FIELD_DECL:
                let f_sym_idx = child_node.payload
                if f_sym_idx != 0 as u32:
                    let f_sym = self.symtable.symbols.data[f_sym_idx]
                    let f_type_node = child_node.first_child
                    mut f_type_id := TYPE_UNKNOWN
                    if f_type_node != 0 as u32:
                        f_type_id = self.infer_node(f_type_node, TYPE_UNKNOWN)
                    self.symtable.symbols.data[f_sym_idx].type_id = f_type_id
                    // A field whose type is the struct ITSELF, by value, gives the struct
                    // infinite size and CRASHES codegen (no diagnostic). Reject (BUG#53):
                    // a recursive field must go through a pointer. `ptr[S]` resolves to a
                    // POINTER type (!= the struct's own type_id), so it is correctly allowed.
                    if sym.type_id != 0 as u32 and f_type_id == sym.type_id:
                        ax_printf_local("error: recursive struct field of its own type has infinite size; use `ptr[...]` for the recursive field\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    fields.push(StructField(name_id: f_sym.name_id, type_id: f_type_id))

            child = next_sibling
        
        let struct_name = self.intern.get(sym.name_id)
        ax_printf_local("[TC-DEBUG] pre_infer_struct name: %s fields_found=%d type_id=%d sym_idx=%d\n", get_str_ptr(struct_name) as i64, fields.len, sym.type_id as i64, sym_idx as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        let type_id = sym.type_id
        if type_id == 0 as u32:
            let struct_type_id = self.types.register_struct(sym.name_id, fields)
            self.symtable.symbols.data[sym_idx].type_id = struct_type_id
            self.set_node_type(node_idx, struct_type_id)
        else:
            let entry = self.types.entries.data[type_id as i64]
            mut struct_extra := entry.extra
            if entry.kind == TYPE_KIND_GENERIC_INST:
                mut idx := 0 as i64
                while idx < self.types.entries.len:
                    let e = self.types.entries.data[idx]
                    let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                    let entry_base = extract_qualified_base_name(self.intern.get(entry.name_id))
                    let name_match = (e_base == entry_base)
                    if e.kind == TYPE_KIND_STRUCT and name_match:
                        struct_extra = e.extra
                        break
                    idx = idx + 1
            let in_bounds = ((struct_extra as i64) < self.types.structs.len)
            ax_printf_local("[TC-DEBUG] pre_infer_struct else: %s struct_extra=%d len=%d in_bounds=%d kind=%d\n", get_str_ptr(struct_name) as i64, struct_extra as i64, self.types.structs.len, in_bounds as i64, entry.kind as i64, 0 as i64, 0 as i64, 0 as i64)
            if (entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST) and (struct_extra as i64) < self.types.structs.len:
                let prev_generic_args = self.types.structs.data[struct_extra as i64].generic_args
                self.types.structs.data[struct_extra as i64] = StructInfo(fields: fields, generic_args: prev_generic_args)
                let check_si = self.types.structs.data[struct_extra as i64]
                ax_printf_local("[TC-DEBUG] post-assign: checked fields_len=%d\n", check_si.fields.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            self.set_node_type(node_idx, type_id)

// Is `k` a type-annotation node kind (a node that `infer_node` resolves to a type)?
// `[T;N]` (NODE_ARRAY_TYPE), `[T]` (NODE_SLICE_TYPE), `*T` (NODE_PTR_TYPE) and
// `fn(..)->..` (NODE_FUNC_TYPE) are genuine type annotations, but earlier code only
// tested NODE_TYPE_EXPR/NODE_GENERIC_TYPE. In a `fn f() -> [T;N]` return position or a
// `let a: [T;N] = ..` annotation those bracket/star/fn forms were dropped -> the return
// type silently became VOID / the let annotation was ignored, so an array literal was
// never coerced to the declared element type (a `[i32;N]` value then flowed into a
// `[i64;N]` slot -> wrong OP_INDEX stride -> silent miscompile). Centralize the test.
pub fn is_type_annotation_node(k: u8) -> bool:
    return k == NODE_TYPE_EXPR or k == NODE_GENERIC_TYPE or k == NODE_ARRAY_TYPE or k == NODE_SLICE_TYPE or k == NODE_PTR_TYPE or k == NODE_FUNC_TYPE or k == NODE_TUPLE_TYPE

// RFC 0022: register the anonymous struct type backing a tuple. Shared by the tuple
// LITERAL (NODE_TUPLE_EXPR) and the tuple TYPE annotation (NODE_TUPLE_TYPE) so both
// produce the SAME struct type with positional fields `_f0.._fN`. `first` is the
// node's first child (element expr or element type-expr respectively).
//
// Tuple types are CANONICALIZED (structural): two tuples with identical element types
// resolve to the same type id, so a tuple literal and a matching `(T0,T1)` annotation
// on a `let`/param/return/global are the SAME type â€” without this they were distinct
// struct ids and the value crossed a broken copy/coercion boundary that dropped fields
// (second element read as 0). The lookup is guarded to structs whose name begins with
// `__tup`, so it never collides with RFC 0019's `__mfv_` variant-payload synth structs
// (which also use `_f0..` field names). All element type ids are themselves canonical
// (nested tuples canonicalize recursively via infer_node), so ordered type-id equality
// is a sound structural test.
pub fn register_tuple_type(mut self: ptr[TypeChecker], first: u32) -> u32:
    mut elem_types := new_u32_vec()
    mut child := first
    while child != 0 as u32:
        (&elem_types).push(self.infer_node(child, TYPE_UNKNOWN))
        child = self.tree.nodes.data[child].next_sibling

    // Canonical lookup: reuse an existing `__tup` struct with identical field types.
    mut ti := 0 as i64
    while ti < self.types.entries.len:
        let e = self.types.entries.data[ti]
        if e.kind == TYPE_KIND_STRUCT:
            let nm = self.intern.get(e.name_id)
            let is_tup = std.string.starts_with(nm, "__tup")
            safe_free_str(nm)
            if is_tup and (e.extra as i64) < self.types.structs.len:
                let sinfo = self.types.structs.data[e.extra as i64]
                if sinfo.fields.len == elem_types.len:
                    mut all_match := true
                    mut j := 0 as i64
                    while j < elem_types.len:
                        if sinfo.fields.data[j].type_id != elem_types.data[j]:
                            all_match = false
                            break
                        j = j + 1 as i64
                    if all_match:
                        if elem_types.data != null as ptr[u32]:
                            @free(elem_types.data as ptr[u8])
                        return ti as u32
        ti = ti + 1 as i64

    // Not found: register a fresh `__tupN` struct with fields `_f0.._fN`.
    mut synth_fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
    mut fi := 0 as i64
    while fi < elem_types.len:
        let fn_str = std.string.concat("_f", format_int(fi))
        let fname_id = self.intern.intern(fn_str)
        safe_free_str(fn_str)
        (&synth_fields).push(StructField(name_id: fname_id, type_id: elem_types.data[fi]))
        fi = fi + 1 as i64
    let synth_nm = std.string.concat("__tup", format_int(elem_types.len))
    let synth_nm_id = self.intern.intern(synth_nm)
    safe_free_str(synth_nm)
    if elem_types.data != null as ptr[u32]:
        @free(elem_types.data as ptr[u8])
    return self.types.register_struct(synth_nm_id, synth_fields)

pub fn pre_infer_func_signature(mut self: ptr[TypeChecker], node_idx: u32):
    let sym_idx = self.tree.nodes.data[node_idx].payload
    mut has_existing := false
    if sym_idx != 0 as u32:
        let sym = self.symtable.symbols.data[sym_idx]
        if sym.type_id != 0 as u32:
            let entry = self.types.entries.data[sym.type_id]
            if entry.kind == TYPE_KIND_FUNC:
                has_existing = true
    
    if not has_existing:
        mut param_types := new_u32_vec()
        mut ret_type := TYPE_UNKNOWN
        mut has_ret_expr := false
        
        let node = self.tree.nodes.data[node_idx]
        // Self type (RFC): a `-> Self` return on a free-function method resolves to the
        // type of the `self` (first) parameter. AXIOM methods are free functions with a
        // `self` param, so there is no interface/impl scope binding `Self` here; without
        // this, `Self` stays TYPE_UNKNOWN and a method call ON a Self-returning result
        // (`c.inc().inc()`) mis-dispatches and segfaults.
        mut first_is_self := false
        mut param_count := 0 as i64
        mut child := node.first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind == NODE_PARAM_DECL:
                let p_type = self.infer_node(child, TYPE_UNKNOWN)
                if param_count == 0 as i64 and child_node.payload != 0 as u32 and (child_node.payload as i64) < self.symtable.symbols.len:
                    let pnm = self.intern.get(self.symtable.symbols.data[child_node.payload as i64].name_id)
                    if pnm == "self":
                        first_is_self = true
                    safe_free_str(pnm)
                param_types.push(p_type)
                param_count = param_count + 1 as i64
            elif is_type_annotation_node(child_node.kind):
                mut is_self_ret := false
                if first_is_self and param_types.len > 0:
                    let rtext = self.node_text(child)
                    if rtext == "Self":
                        is_self_ret = true
                    safe_free_str(rtext)
                if is_self_ret:
                    ret_type = param_types.data[0]
                else:
                    ret_type = self.infer_node(child, TYPE_UNKNOWN)
                has_ret_expr = true
            child = next_sibling
            
        if not has_ret_expr:
            mut is_main := false
            if sym_idx != 0 as u32:
                let name_id = self.symtable.symbols.data[sym_idx].name_id
                let text = self.intern.get(name_id)
                if text == "main":
                    is_main = true
            if is_main:
                ret_type = TYPE_I32
            else:
                ret_type = TYPE_VOID
        
        let func_type_id = self.types.register_function(param_types, ret_type)
        if sym_idx != 0 as u32:
            self.symtable.symbols.data[sym_idx].type_id = func_type_id
        self.set_node_type(node_idx, func_type_id)

// RFC 0005: a concrete numeric scalar type (int family or float family). Used to
// decide whether a bare integer literal operand may adopt the other operand's type.
pub fn tc_is_numeric(t: u32) -> bool:
    return t == TYPE_I8 or t == TYPE_I16 or t == TYPE_I32 or t == TYPE_I64 or t == TYPE_U8 or t == TYPE_U16 or t == TYPE_U32 or t == TYPE_U64 or t == TYPE_F32 or t == TYPE_F64 or t == TYPE_ISIZE or t == TYPE_USIZE

// A float-literal binop operand, possibly wrapped in a unary minus (`-2.5`). Both count as
// "float literals" for width coercion: re-inferring a unary-neg node with an expected type
// propagates it to the inner FLOAT_LIT (NODE_UNARY_EXPR infers its operand with `expected`),
// so the negated literal adopts the other operand's f32/f64 width too. Without matching the
// negated form, `c == -2.5` / `y * -2.0` (c/y: f32) stayed f32-vs-f64 mixed-precision.
// [[bug-f32-compare-float-literal]]
pub fn node_is_float_litish(self: ptr[TypeChecker], n: u32) -> bool:
    let k = self.tree.nodes.data[n].kind
    if k == NODE_FLOAT_LIT:
        return true
    if k == NODE_UNARY_EXPR:
        let ch = self.tree.nodes.data[n].first_child
        if ch != 0 as u32 and self.tree.nodes.data[ch].kind == NODE_FLOAT_LIT:
            return true
    return false

// True iff `t` is an Option or Result value. Option[T]/Result[T,E] desugar to a
// SUM (kind 6) whose mangled name base is "Option"/"Result" (e.g.
// `_AX_std_Option__i64`), so that is the PRIMARY case; also accept the dedicated
// OPTION/RESULT kinds (11/12) and a GENERIC_INST/STRUCT with the same base name.
// Base-name matching cleanly EXCLUDES the explicit-generic-call `f[T](..)` result
// mis-inference (a GENERIC_INST named after the fn, e.g. "hash_key", so
// `hash_key[K](k) % cap` â€” really u64 â€” is NOT flagged). Used to reject arithmetic
// on an un-unwrapped Option/Result (BUG#53 class: adding two box values = garbage).
pub fn tc_is_opt_res(self: ptr[TypeChecker], t: u32) -> bool:
    if (t as i64) >= self.types.entries.len:
        return false
    let e = self.types.entries.data[t as i64]
    if e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
        return true
    if (e.kind == TYPE_KIND_SUM or e.kind == TYPE_KIND_GENERIC_INST or e.kind == TYPE_KIND_STRUCT) and e.name_id != 0 as u32:
        let mn = self.intern.get(e.name_id)
        let bn = extract_base_name(mn)
        let r = (bn == "Option" or bn == "Result")
        safe_free_str(mn)
        safe_free_str(bn)
        return r
    return false

// Shared generic-instantiation core: given a generic template symbol `sym_idx`
// and a fully-collected `args` vector of concrete type-ids, produce the result
// TypeID for that instantiation. TAKES OWNERSHIP of `args` (either handed to
// register_generic_inst, which stores/frees it, or freed here after the mono
// path). This is the exact logic the explicit `Name[T,U]` annotation path used
// (NODE_GENERIC_TYPE below); it is factored out so the BUG#74 inferred-arg
// struct-constructor path (`Name(field: v, ...)` with no explicit type args) can
// run the IDENTICAL monomorphization -- producing the SAME packed concrete struct
// layout a generic function's param would monomorphize to, which is what keeps
// construction and later field reads on one consistent layout.
pub fn finish_generic_instantiation(mut self: ptr[TypeChecker], sym_idx: u32, args: U32Vec) -> u32:
    mut result_type := TYPE_UNKNOWN
    let sym_name_id = self.symtable.symbols.data[sym_idx as i64].name_id
    mut has_generic_arg := false
    mut a_idx := 0 as i64
    while a_idx < args.len:
        if self.is_generic(args.data[a_idx]):
            has_generic_arg = true
            break
        a_idx = a_idx + 1

    if has_generic_arg:
        result_type = self.types.register_generic_inst(sym_name_id, args)
    else:
        // Check if already instantiated
        mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
        let mangled_name = mono.mangle_name_ov(sym_idx, self.intern.get(sym_name_id), args)
        let mangled_id = self.intern.intern(mangled_name)
        mut existing_sym_idx := self.symtable.resolve(mangled_id)
        if existing_sym_idx == 0 as u32:
            let proxy_sys_idx = self.symtable.resolve_global(mangled_id)
            existing_sym_idx = proxy_sys_idx

        mut inst_sym_idx := 0 as u32
        mut fresh_type_alias_inst := false
        if existing_sym_idx != 0 as u32:
            inst_sym_idx = existing_sym_idx
        else:
            // Instantiate!
            let cloned_root = mono.instantiate_function(sym_idx, args)
            self.tree.append_child(0 as u32, cloned_root)

            // Name resolution on the cloned subtree
            let saved_data = self.symtable.stack.data
            let saved_len = self.symtable.stack.len
            let saved_cap = self.symtable.stack.cap
            mut temp_stack := new_u32_vec()
            temp_stack.push(0 as u32)
            if saved_len > 1:
                temp_stack.push(saved_data[1])
            self.symtable.stack = temp_stack
            mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
            resolver.resolve_node(cloned_root)
            @free(self.symtable.stack.data as ptr[u8])
            self.symtable.stack.data = saved_data
            self.symtable.stack.len = saved_len
            self.symtable.stack.cap = saved_cap

            let payload_sym = self.tree.nodes.data[cloned_root].payload
            if payload_sym != 0 as u32:
                inst_sym_idx = payload_sym
            else:
                mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                if resolved_inst_sym == 0 as u32:
                    resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                inst_sym_idx = resolved_inst_sym

            let cloned_kind = self.tree.nodes.data[cloned_root].kind
            if cloned_kind == NODE_STRUCT_DECL and mono.struct_type_id != 0 as u32:
                self.symtable.symbols.data[inst_sym_idx as i64].type_id = mono.struct_type_id

            // Register type/signature in TypeTable
            if cloned_kind == NODE_STRUCT_DECL:
                self.pre_infer_struct(cloned_root)

                // Pre-infer signatures for all methods of the struct
                mut m_child := self.tree.nodes.data[cloned_root].first_child
                while m_child != 0 as u32:
                    let mc = self.tree.nodes.data[m_child]
                    let next_sibling = mc.next_sibling
                    if mc.kind == NODE_FUNC_DECL:
                        self.pre_infer_func_signature(m_child)
                    m_child = next_sibling

                self.infer_node(cloned_root, TYPE_UNKNOWN)
            elif cloned_kind == NODE_FUNC_DECL:
                self.pre_infer_func_signature(cloned_root)
                self.infer_node(cloned_root, TYPE_UNKNOWN)
            elif cloned_kind == NODE_TYPE_ALIAS_DECL:
                self.pre_infer_type_alias(cloned_root)
                mut m_child := self.tree.nodes.data[cloned_root].first_child
                while m_child != 0 as u32:
                    let mc = self.tree.nodes.data[m_child]
                    let next_sibling = mc.next_sibling
                    if mc.kind == NODE_FUNC_DECL:
                        self.pre_infer_func_signature(m_child)
                    m_child = next_sibling
                self.infer_node(cloned_root, TYPE_UNKNOWN)
                fresh_type_alias_inst = true

        let inst_sym = self.symtable.symbols.data[inst_sym_idx as i64]
        result_type = inst_sym.type_id

        // BUG#67 follow-up: record the concrete args on the monomorphized sum
        // type (e.g. Option[Vec[i64]]) itself, so get_generic_args() on it
        // doesn't have to re-derive them from the clone's mangled name.
        if fresh_type_alias_inst:
            self.types.set_sum_generic_args(result_type, args)

        if args.data != null as ptr[u32]:
            @free(args.data as ptr[u8])
    return result_type

// BUG#53 convention helper: the PAYLOAD size of an Option/Result type, or 0 when it
// cannot be determined safely.
//
// Comparing option-like types by type_id is WRONG for this purpose â€” the same
// `Option[i64]` is registered under several distinct type_ids across a program, so an
// id-inequality reject over-rejects massively (this is exactly why the pp_var reject
// was held back when it was first attempted). The payload SIZE is the property that
// actually decides whether the value's bits fit the slot, so compare that instead.
//
// Returns 0 (= "don't judge") for anything not a concrete Option/Result, and for a
// GENERIC payload, so an unresolved type parameter can never drive a diagnostic.
pub fn optlike_payload_size(mut self: ptr[TypeChecker], t: u32) -> u32:
    if t == TYPE_UNKNOWN or (t as i64) >= self.types.entries.len:
        return 0 as u32
    let e = self.types.entries.data[t as i64]
    // SCOPE GATE â€” Option/Result ONLY, by base name.
    //
    // The SUM branch below measures VARIANT PAYLOAD size; the GENERIC_INST branch measures
    // TYPE ARGUMENT size. Those are the same quantity only for Option/Result, whose single
    // payload IS the type argument. For a user sum they diverge badly: `Tree[T] =
    // Node(T, Tree[T], Tree[T])` has a 24-byte synth-struct payload but an 8-byte type arg,
    // so comparing one form against the other reported a bogus mismatch and over-rejected
    // the t_gentree oracle. Restricting to Option/Result makes both branches measure the
    // same thing, and leaves every user sum unjudged.
    let tnm = self.intern.get(e.name_id)
    let tbase = extract_qualified_base_name(tnm)
    let is_optlike_name = std.string.starts_with(tbase, "Option") or std.string.starts_with(tbase, "Result")
    safe_free_str(tbase)
    safe_free_str(tnm)
    if not is_optlike_name:
        return 0 as u32
    if e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
        // For these kinds `.extra` IS the inner/ok type id.
        let pl = e.extra
        if pl == TYPE_UNKNOWN or (pl as i64) >= self.types.entries.len:
            return 0 as u32
        if self.types.entries.data[pl as i64].kind == TYPE_KIND_GENERIC:
            return 0 as u32
        mut sz := 0 as u32
        mut al := 0 as u32
        builder_type_size_and_align(self.types, pl, &sz, &al)
        return sz
    if e.kind == TYPE_KIND_SUM:
        // For a SUM `.extra` is a sumtypes INDEX. The slot must hold the widest variant, so
        // the payload width is the MAX over variants. A payload-less variant (None) counts
        // as 0; a GENERIC payload makes the whole answer unjudgeable.
        let sx = e.extra
        if (sx as i64) >= self.types.sumtypes.len:
            return 0 as u32
        let vs = self.types.sumtypes.data[sx as i64].variants
        mut maxsz := 0 as u32
        mut vi := 0 as i64
        while vi < vs.len:
            let pt = vs.data[vi].payload_type
            if pt != TYPE_UNKNOWN and (pt as i64) < self.types.entries.len:
                if self.types.entries.data[pt as i64].kind == TYPE_KIND_GENERIC:
                    return 0 as u32
                mut vsz := 0 as u32
                mut val := 0 as u32
                builder_type_size_and_align(self.types, pt, &vsz, &val)
                if vsz > maxsz:
                    maxsz = vsz
            vi = vi + 1 as i64
        return maxsz
    if e.kind == TYPE_KIND_GENERIC_INST:
        // An UNMONOMORPHIZED `Option[X]` instance â€” the shape an unannotated local like
        // `let x = Some((3, 40))` actually carries (the param side is a real SUM, the local
        // side is a generic-inst, which is why both branches are needed). Its `.extra` is a
        // generic_insts index, NOT a sumtypes index, so the payload comes from the type
        // ARGS: the slot must hold the widest of them (1 arg for Option, 2 for Result).
        mut ga = self.get_generic_args(t)
        mut gmax := 0 as u32
        mut gi := 0 as i64
        mut bail := false
        while gi < ga.len:
            let at2 = ga.data[gi]
            if at2 == TYPE_UNKNOWN or (at2 as i64) >= self.types.entries.len:
                bail = true
            elif self.types.entries.data[at2 as i64].kind == TYPE_KIND_GENERIC:
                bail = true
            else:
                mut gsz := 0 as u32
                mut gal := 0 as u32
                builder_type_size_and_align(self.types, at2, &gsz, &gal)
                if gsz > gmax:
                    gmax = gsz
            gi = gi + 1 as i64
        if ga.data != null as ptr[u32]:
            @free(ga.data as ptr[u8])
        if bail or ga.len == 0 as i64:
            return 0 as u32
        return gmax
    return 0 as u32

pub fn infer_node(mut self: ptr[TypeChecker], node_idx: u32, expected: u32) -> u32:
    if node_idx == 0 as u32:
        if self.tree.nodes.len == 0 as i64:
            return TYPE_UNKNOWN
        if self.tree.nodes.data[0].kind == 0 as u8: // NODE_INVALID
            return TYPE_UNKNOWN

    let kind = self.tree.nodes.data[node_idx].kind
    let flags = self.tree.nodes.data[node_idx].flags
    mut result_type := TYPE_UNKNOWN
    
    if kind == NODE_PROGRAM or kind == NODE_BLOCK or kind == NODE_UNSAFE_BLOCK or kind == NODE_ARENA_BLOCK:
        // unsafe/arena: recurse into the inner block (their only child) so the
        // body is typechecked (#38.5/#38.6).
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            self.infer_node(child, TYPE_UNKNOWN)
            child = self.tree.nodes.data[child].next_sibling
            
    elif kind == NODE_FUNC_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        // Silent-miscompile guard: fn-vs-TYPE name collision.
        // `SymbolTable.define` (resolver.ax ~L574) keeps ONE namespace per scope and
        // only merges FUNC-with-FUNC into an overload chain; on any OTHER cross-kind
        // clash it returns the EXISTING symbol. A top-level `fn worker` therefore
        // ALIASES the bundled `struct worker` (std/scheduler.ax, bundled into every
        // program), so this decl's payload is the STRUCT's symbol, every `worker(..)`
        // call links elsewhere, and the user function is never called â€” a wrong answer
        // with no diagnostic at all. Detect it exactly: a FUNC_DECL whose resolved
        // symbol is not a function. Reject rather than mis-link; proper per-module
        // symbol namespacing is the cross-library-collision RFC (task #2).
        if sym_idx != 0 as u32:
            let clash = self.symtable.symbols.data[sym_idx]
            if clash.kind == SYM_STRUCT or clash.kind == SYM_INTERFACE or clash.kind == SYM_TYPE_ALIAS or clash.kind == SYM_VARIANT:
                mut cname := "?"
                if clash.name_id != 0 as u32:
                    cname = self.intern.get(clash.name_id)
                ax_printf_local("error: function '%s' has the same name as a type already in scope (a bundled stdlib type or an earlier declaration); calls would link to the type's symbol instead of this function - rename the function\n", get_str_ptr(cname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.diags_count = self.diags_count + 1 as i64
        mut ret_type := TYPE_UNKNOWN
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            if sym.type_id != 0 as u32:
                let entry = self.types.entries.data[sym.type_id]
                if entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[entry.extra]
                    ret_type = fi.ret
                    result_type = sym.type_id
        
        let prev_ret = self.current_return
        self.current_return = ret_type
        let prev_fn_generic = self.current_fn_is_generic
        self.current_fn_is_generic = (self.tree.nodes.data[node_idx].flags & FLAG_IS_GENERIC) != 0 as u16

        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_PARAM_DECL and child_node.kind != NODE_TYPE_EXPR:
                self.infer_node(child, TYPE_UNKNOWN)
                // #38.4: reject a `defer` nested in control flow (static registration is
                // only sound for an unconditional top-level defer). This body statement is
                // at the function's top level (in_cf=false); the walk flags nested defers.
                self.check_defer_placement(child, false)
            child = next_sibling

        self.current_return = prev_ret
        self.current_fn_is_generic = prev_fn_generic

        // Missing-return check (BUG#53 family): a non-void function whose body can
        // fall off the end returns a garbage register silently. Diagnose it. Only
        // checked when the return type resolved to a concrete non-void type, so
        // unresolved generics are conservatively skipped (never a false positive).
        if ret_type != TYPE_UNKNOWN and ret_type != TYPE_VOID:
            let body_blk = self.tc_func_body(node_idx)
            if body_blk != 0 as u32:
                if not self.stmt_terminates(body_blk):
                    mut fname := "?"
                    if sym_idx != 0 as u32:
                        let nid = self.symtable.symbols.data[sym_idx].name_id
                        if nid != 0 as u32:
                            fname = self.intern.get(nid)
                    ax_printf_local("error: function '%s' can reach the end of its body without returning a value; add an explicit `return` (AXIOM has no implicit last-expression return)\n", get_str_ptr(fname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_CLOSURE_EXPR:
        // RFC 0008: a lambda-lifted closure reference â€” its payload is the resolved
        // symbol index of the synthesized top-level function (set by the resolver).
        // That function's signature was already registered by the
        // pre_infer_func_signature pre-pass, so report its concrete fn type here.
        // Without this, an inline lambda argument inferred as UNKNOWN and a generic
        // callee (e.g. `Option.map` / `apply[T,U](x, f: fn(T)->U)`) failed to
        // monomorphize (unresolved external). Pairs with the NODE_FUNC_TYPE branch
        // in infer_generic_type_args, which reads this fn type to resolve T/U.
        let cl_sym = self.tree.nodes.data[node_idx].payload
        if cl_sym != 0 as u32 and (cl_sym as i64) < self.symtable.symbols.len:
            result_type = self.symtable.symbols.data[cl_sym as i64].type_id

    elif kind == NODE_STRUCT_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        // Mirror of the fn-vs-type guard in NODE_FUNC_DECL above: the same
        // `define` fall-through aliases a user STRUCT to an existing FUNCTION of
        // that name (e.g. `struct concat` vs the bundled std/string.ax `concat`).
        // That direction does not silently miscompile - the ctor call resolves to
        // the function - but it produces a baffling diagnostic about the FUNCTION's
        // arity for what is plainly a struct construction. Name the real problem.
        if sym_idx != 0 as u32:
            let sclash = self.symtable.symbols.data[sym_idx]
            if sclash.kind == SYM_FUNC:
                mut sname := "?"
                if sclash.name_id != 0 as u32:
                    sname = self.intern.get(sclash.name_id)
                ax_printf_local("error: type '%s' has the same name as a function already in scope (a bundled stdlib function or an earlier declaration); constructing it would resolve to that function instead - rename the type\n", get_str_ptr(sname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.diags_count = self.diags_count + 1 as i64
        if sym_idx != 0 as u32:
            result_type = self.symtable.symbols.data[sym_idx].type_id

        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_FIELD_DECL:
                self.infer_node(child, TYPE_UNKNOWN)
            child = next_sibling

    elif kind == NODE_TYPE_ALIAS_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        if sym_idx != 0 as u32:
            result_type = self.symtable.symbols.data[sym_idx].type_id
        
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next_sibling = child_node.next_sibling
            if child_node.kind != NODE_SUM_TYPE:
                self.infer_node(child, TYPE_UNKNOWN)
            child = next_sibling

    elif kind == NODE_PARAM_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        mut p_type := TYPE_UNKNOWN
        let type_node = self.tree.nodes.data[node_idx].first_child
        if type_node != 0 as u32:
            p_type = self.infer_node(type_node, TYPE_UNKNOWN)
        if sym_idx != 0 as u32:
            self.symtable.symbols.data[sym_idx].type_id = p_type
        result_type = p_type
        
    elif kind == NODE_VAR_DECL or kind == NODE_CONST_DECL:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        mut exp_type := TYPE_UNKNOWN
        if sym_idx != 0 as u32:
            exp_type = self.symtable.symbols.data[sym_idx].type_id
            
        mut type_node := 0 as u32
        mut init_expr := 0 as u32
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            if is_type_annotation_node(child_node.kind):
                type_node = child
            else:
                init_expr = child
            child = child_node.next_sibling
            
        if type_node != 0 as u32:
            exp_type = self.infer_node(type_node, TYPE_UNKNOWN)
            if sym_idx != 0 as u32:
                self.symtable.symbols.data[sym_idx].type_id = exp_type
                
        if init_expr != 0 as u32:
            let inferred := self.infer_node(init_expr, exp_type)
            // BUG#53 (m5): an explicit `let x: T = <literal>` whose literal is a
            // string but T is a numeric scalar (or a numeric literal assigned to a
            // str/bytes T) is silently accepted, then miscompiled to garbage (the
            // {ptr,len} str repr reinterpreted as an int, or vice-versa). Reject
            // that genuinely-incompatible pair. Gated on the RHS LITERAL node kind
            // (a string/int/float literal has an unambiguous type) rather than the
            // inferred type, because infer_node is imprecise for some str-returning
            // CALLs (reports i64) and trusting it over-rejected valid compiler
            // source. The language's real literal/width coercions (int-lit -> any
            // int width, float-lit -> f32/f64) stay untouched. See
            // [[bug-malformed-input-robustness-cluster]] (m5).
            if type_node != 0 as u32 and exp_type != TYPE_UNKNOWN:
                let rhs_kind = self.tree.nodes.data[init_expr].kind
                let exp_is_str = exp_type == TYPE_STRING or exp_type == TYPE_BYTES
                let exp_is_num = exp_type >= TYPE_I8 and exp_type <= TYPE_USIZE and exp_type != TYPE_STRING and exp_type != TYPE_VOID
                let rhs_is_strlit = rhs_kind == NODE_STRING_LIT
                let rhs_is_numlit = rhs_kind == NODE_INT_LIT or rhs_kind == NODE_FLOAT_LIT
                if (exp_is_num and rhs_is_strlit) or (exp_is_str and rhs_is_numlit):
                    ax_printf_local("error: type mismatch in `let`: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // BUG#53 (let-binding analog of the call-arg reject at ~L4653): an
            // Option/Result/sum VALUE bound to a `let`/`mut` whose ANNOTATED type is a
            // plain SCALAR primitive or a STRUCT (the programmer forgot `.unwrap()`) was
            // silently accepted, then the 8-byte tagged box is read raw as the target
            // type -> garbage (`let x: i64 = o` with `o:Option[i64]` returned 8; `let
            // x: i64 = v.get(0)` returned garbage). Reject. Read the RHS's TRUE type from
            // its SYMBOL for an IDENT init (an annotated `Option[i64]` local resolves to
            // a SUM-kind type here, which is why an OPTION-kind check on `inferred` alone
            // misses it), else RE-INFER with TYPE_UNKNOWN (not `exp_type`, which would
            // coerce a call like `v.get(0)` down to the scalar and hide the box kind).
            // Gated to a PRIMITIVE/STRUCT annotated type + an OPTION/RESULT/SUM RHS:
            // binding an aggregate box where a scalar/struct is expected is always a type
            // error, so this cannot over-reject valid code (an `Option`-annotated local
            // has an OPTION-kind exp_type and is skipped). [[bug-option-as-let-binding-not-rejected]]
            if type_node != 0 as u32 and exp_type != TYPE_UNKNOWN and (exp_type as i64) < self.types.entries.len:
                let exp_k0 = self.types.entries.data[exp_type as i64].kind
                if exp_k0 == TYPE_KIND_PRIMITIVE or exp_k0 == TYPE_KIND_STRUCT:
                    let rhs_k0 = self.tree.nodes.data[init_expr].kind
                    mut rhs_sty := TYPE_UNKNOWN
                    if rhs_k0 == NODE_IDENT:
                        let rhs_sym = self.tree.nodes.data[init_expr].payload
                        if rhs_sym != 0 as u32 and (rhs_sym as i64) < self.symtable.symbols.len:
                            rhs_sty = self.symtable.symbols.data[rhs_sym].type_id
                    else:
                        // Reuse the ALREADY-computed `inferred` (L3477) â€” do NOT re-infer.
                        // A second `infer_node(init_expr, TYPE_UNKNOWN)` has side effects: for a
                        // literal RHS like `let big: u64 = 18000000000000000000` it re-defaults the
                        // int literal to i64 and overwrites node_types, flipping `big > small` to a
                        // SIGNED compare (t_u64cmp regressed 7->1). `inferred` was derived with the
                        // real `exp_type` hint; a call like `v.get(0)` still yields its Option/Result
                        // type there (the hint cannot coerce Option->scalar â€” that IS the miscompile).
                        rhs_sty = inferred
                    if rhs_sty != TYPE_UNKNOWN and (rhs_sty as i64) < self.types.entries.len:
                        let rhs_stk = self.types.entries.data[rhs_sty as i64].kind
                        if rhs_stk == TYPE_KIND_OPTION or rhs_stk == TYPE_KIND_RESULT or rhs_stk == TYPE_KIND_SUM:
                            ax_printf_local("error: cannot bind an Option/Result/sum value to a `let`/`mut` of a plain type; unwrap it first (.unwrap() or match)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            self.diags_count = self.diags_count + 1 as i64
            // RFC 0029: `let s: Iface = <struct>` â€” reject a struct that doesn't implement it.
            if type_node != 0 as u32:
                self.check_iface_conformance(exp_type, init_expr)
            if exp_type != TYPE_UNKNOWN:
                result_type = exp_type
            else:
                result_type = inferred
                if sym_idx != 0 as u32:
                    self.symtable.symbols.data[sym_idx].type_id = inferred
        else:
            result_type = exp_type
            
    elif kind == NODE_RETURN_STMT:
        let expr = self.tree.nodes.data[node_idx].first_child
        if expr != 0 as u32:
            let et_ret = self.infer_node(expr, self.current_return)
            // RFC 0029: `return <struct>` from a `-> Iface` fn â€” reject a non-conforming struct.
            self.check_iface_conformance(self.current_return, expr)
            // BUG#53 (m5agg): `return <aggregate variable>` from a NUMERIC-returning fn
            // (`return p` where p is a struct, fn is `-> i64`) was silently accepted --
            // the aggregate's address was returned as an int -> garbage for the caller.
            // Reject. Gated on the return expr being a bare NODE_IDENT (a variable, whose
            // declared aggregate type is reliable) so an imprecisely-inferred call result
            // is never mis-rejected. Only fires numeric-return vs aggregate-value; struct
            // -> struct and scalar -> scalar returns are untouched.
            if self.current_return != TYPE_UNKNOWN and self.tree.nodes.data[expr].kind == NODE_IDENT and et_ret != TYPE_UNKNOWN and (et_ret as i64) < self.types.entries.len:
                let ce_num = self.current_return >= TYPE_I8 and self.current_return <= TYPE_USIZE and self.current_return != TYPE_STRING and self.current_return != TYPE_VOID
                let ek = self.types.entries.data[et_ret as i64].kind
                let e_agg = ek == TYPE_KIND_STRUCT or ek == TYPE_KIND_SUM or ek == TYPE_KIND_ARRAY or ek == TYPE_KIND_OPTION or ek == TYPE_KIND_RESULT
                if ce_num and e_agg:
                    ax_printf_local("error: type mismatch in `return`: cannot return an aggregate value from a function with a numeric return type\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // BUG#53 (return-path analog of m5): `return <string literal>` from a
            // numeric-returning fn (or a numeric literal from a str/bytes-returning
            // fn) was silently accepted then miscompiled to garbage. Reject the
            // genuinely-incompatible str<->numeric pair. Gated on the return expr's
            // LITERAL node kind (unambiguous type), NOT the inferred type, because
            // infer is imprecise for str-returning CALLs (same reasoning as m5) --
            // so real coercions and value returns are untouched.
            let rk = self.tree.nodes.data[expr].kind
            let rt = self.current_return
            if rt != TYPE_UNKNOWN:
                let ret_is_str = rt == TYPE_STRING or rt == TYPE_BYTES
                let ret_is_num = rt >= TYPE_I8 and rt <= TYPE_USIZE and rt != TYPE_STRING and rt != TYPE_VOID
                let e_strlit = rk == NODE_STRING_LIT
                let e_numlit = rk == NODE_INT_LIT or rk == NODE_FLOAT_LIT
                if (ret_is_num and e_strlit) or (ret_is_str and e_numlit):
                    ax_printf_local("error: type mismatch in `return`: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_DEFER_STMT:
        // #38.4: typecheck the deferred expression so its node_types are
        // populated for codegen (it runs at scope exit, not here).
        let expr = self.tree.nodes.data[node_idx].first_child
        if expr != 0 as u32:
            self.infer_node(expr, TYPE_UNKNOWN)

    elif kind == NODE_MATCH_STMT:
        let scrutinee = self.tree.nodes.data[node_idx].first_child
        if scrutinee != 0 as u32:
            let scrutinee_type = self.infer_node(scrutinee, TYPE_UNKNOWN)
            // A match SCRUTINEE is lowered one of two ways (air_builder lower_match):
            // sum-like (Option/Result/sum/generic-inst-of-sum) dispatches on the variant
            // tag, everything else becomes a C-`switch` that only supports integer/bool/
            // char. An AGGREGATE (struct/array/tuple) or a 16-byte inline primitive
            // (str/bytes) or a float hits NEITHER path: the match lowered to NOTHING and
            // the function fell through returning garbage RAX â€” accept-then-miscompile,
            // BUG#53 class. Reject those precise kinds/ids.
            //
            // This SUBSUMES the per-arm literal-pattern reject below for str/bytes/float
            // (that one only fires on a literal pattern; a bare `_` or binding arm slipped
            // through). Destructuring a tuple/struct scrutinee (`match t: (a, b):`) is
            // RFC 0022 P5, a FUTURE feature â€” until it exists this must be a diagnostic,
            // not a silent no-op.
            //
            // GENERIC_INST is deliberately NOT rejected: it is the kind a monomorphized
            // Option[T]/user-sum instance carries, and rejecting it would break every real
            // generic sum match. TYPE_UNKNOWN is likewise spared (imprecise inference must
            // never turn into an over-reject â€” the recurring trap in this file).
            if scrutinee_type != TYPE_UNKNOWN and (scrutinee_type as i64) < self.types.entries.len:
                let sc_kind = self.types.entries.data[scrutinee_type].kind
                let sc_is_agg = sc_kind == TYPE_KIND_STRUCT or sc_kind == TYPE_KIND_ARRAY or sc_kind == TYPE_KIND_TUPLE
                let sc_is_wide_prim = scrutinee_type == TYPE_STRING or scrutinee_type == TYPE_BYTES or scrutinee_type == TYPE_F32 or scrutinee_type == TYPE_F64
                if sc_is_agg or sc_is_wide_prim:
                    ax_printf_local("error: `match` requires a sum-like (Option/Result/enum/sum) or integer/bool/char scrutinee; matching on a struct/array/tuple/string/float value is not supported\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            let prev_scrutinee = self.current_match_scrutinee
            self.current_match_scrutinee = scrutinee_type

            mut arm := self.tree.nodes.data[scrutinee].next_sibling
            mut arm_type := TYPE_UNKNOWN
            while arm != 0 as u32:
                let t = self.infer_node(arm, expected)
                if arm_type == TYPE_UNKNOWN:
                    arm_type = t
                arm = self.tree.nodes.data[arm].next_sibling

            self.current_match_scrutinee = prev_scrutinee
            result_type = arm_type

            // Mark confirmed non-exhaustive matches so the missing-return terminator
            // analysis knows this match can fall through (used only for that check;
            // AXIOM permits non-exhaustive matches to fall through at runtime).
            if self.match_is_confidently_partial(node_idx, scrutinee_type):
                self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | FLAG_MATCH_PARTIAL

    elif kind == NODE_MATCH_ARM:
        let pattern = self.tree.nodes.data[node_idx].first_child
        mut body := 0 as u32
        if pattern != 0 as u32:
            body = self.tree.nodes.data[pattern].next_sibling
            
        let scrutinee_type = self.current_match_scrutinee
        if scrutinee_type != TYPE_UNKNOWN:
            let s_entry = self.types.entries.data[scrutinee_type]
            // A variant pattern (Some/None/Ok/Err/user variant) requires a sum-like
            // scrutinee. On a non-sum (a scalar/struct/pointer, e.g. `match an_i64: Some(v):`)
            // the payload never binds and the arm body reads uninitialized memory -> segfault.
            // Reject (BUG#53). OPTION/RESULT/SUM/GENERIC_INST are the sum-like kinds handled
            // below (a generic-inst may be an Option[T]/user-sum instance). See
            // [[bug-malformed-input-robustness-cluster]] (m4).
            if pattern != 0 as u32 and self.tree.nodes.data[pattern].kind == NODE_VARIANT_PAT:
                if not (s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT or s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST):
                    ax_printf_local("error: cannot match a value of a non-sum type against a variant pattern (Some/None/Ok/Err/...)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // A LITERAL pattern is lowered as a C-`switch` and only supports integer/bool/char
            // scrutinees (air_builder lower_match). On a FLOAT (f32=9/f64=10), STRING (12) or
            // BYTES (22) scrutinee the `match` silently lowered to NOTHING (the function then
            // returned garbage) â€” accept-then-miscompile. Reject those precise primitive types
            // (float/string equality-match is a future feature, not a silent no-op). BUG#53 class.
            if pattern != 0 as u32 and self.tree.nodes.data[pattern].kind == NODE_LITERAL_PAT:
                if scrutinee_type == TYPE_F32 or scrutinee_type == TYPE_F64 or scrutinee_type == TYPE_STRING or scrutinee_type == TYPE_BYTES:
                    ax_printf_local("error: match with a literal pattern requires an integer/bool/char scrutinee; float/string literal matches are not supported\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            if s_entry.kind == TYPE_KIND_OPTION or s_entry.kind == TYPE_KIND_RESULT:
                // OPTION/RESULT (kind 11/12) have NO sumtypes entry -- `.extra` is the
                // inner/ok TYPE id, not a sumtypes index -- so the SUM path below would
                // read a garbage `variants` pointer and crash (surfaces when a match
                // scrutinee is actually typed OPTION, e.g. `match arr[i]` on `[Option;N]`).
                // Resolve the pattern payload DIRECTLY from the entry, mirroring
                // air_builder's kind-11/12 local match lowering: Some(v)/Ok(v) bind the
                // inner/ok type (`.extra`), Err(e) binds the err type (`.name_id`), None
                // binds nothing, and a bare binding binds the whole Option/Result value.
                if pattern != 0 as u32:
                    let pat_node = self.tree.nodes.data[pattern]
                    if pat_node.kind == NODE_VARIANT_PAT:
                        let arg = pat_node.first_child
                        if arg != 0 as u32 and self.tree.nodes.data[arg].kind == NODE_BINDING_PAT:
                            let arg_sym_idx = self.tree.nodes.data[arg].payload
                            mut pl := s_entry.extra
                            if s_entry.kind == TYPE_KIND_RESULT:
                                let v_sym_idx = pat_node.payload
                                if v_sym_idx != 0 as u32 and (v_sym_idx as i64) < self.symtable.symbols.len:
                                    let vnm = self.intern.get(self.symtable.symbols.data[v_sym_idx].name_id)
                                    if vnm == "Err":
                                        pl = s_entry.name_id
                            if arg_sym_idx != 0 as u32:
                                self.symtable.symbols.data[arg_sym_idx].type_id = pl
                                self.set_node_type(arg, pl)
                    elif pat_node.kind == NODE_BINDING_PAT:
                        let b_sym_idx = pat_node.payload
                        if b_sym_idx != 0 as u32:
                            self.symtable.symbols.data[b_sym_idx].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)
            elif s_entry.kind == TYPE_KIND_SUM or s_entry.kind == TYPE_KIND_GENERIC_INST:
                mut sum_extra := s_entry.extra
                if s_entry.kind == TYPE_KIND_GENERIC_INST:
                    mut idx := 0 as i64
                    while idx < self.types.entries.len:
                        let e = self.types.entries.data[idx]
                        let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                        let s_base = extract_qualified_base_name(self.intern.get(s_entry.name_id))
                        let name_match = (e_base == s_base)
                        if e.kind == TYPE_KIND_SUM and name_match:
                            sum_extra = e.extra
                            break
                        idx = idx + 1
                let sum_info = self.types.sumtypes.data[sum_extra]
                
                // Let's typecheck the pattern!
                if pattern != 0 as u32:
                    let pat_node = self.tree.nodes.data[pattern]
                    if pat_node.kind == NODE_VARIANT_PAT:
                        let v_sym_idx = pat_node.payload
                        if v_sym_idx != 0 as u32:
                            let v_sym = self.symtable.symbols.data[v_sym_idx]
                            
                            // Find corresponding variant in sum_info
                            mut payload_type := TYPE_UNKNOWN
                            mut found := false
                            mut j := 0 as i64
                            while j < sum_info.variants.len:
                                let v_info = sum_info.variants.data[j]
                                if v_info.name_id == v_sym.name_id:
                                    payload_type = v_info.payload_type
                                    found = true
                                    break
                                j = j + 1

                            // GENERIC_INST scrutinee (unannotated `let x = Some((a,b))`):
                            // the template variant's payload is the generic param `T`, which
                            // would bind the pattern var to a single-slot generic type and
                            // collapse every `.N` field access to offset 0. Substitute back the
                            // concrete arg the generic-inst carries. Inert for a concrete SUM
                            // scrutinee (payload already concrete -> helper returns it as-is).
                            payload_type = self.subst_variant_payload_type(scrutinee_type, payload_type)

                            // Now assign payload type to binding patterns (which are children of NODE_VARIANT_PAT)
                            let arg = pat_node.first_child
                            // RFC 0019: a synthesized (flagged) payload struct â€” multi-field OR a
                            // single >8B primitive (str) wrap â€” binds each pattern var to its FIELD
                            // type, not the wrapper struct itself.
                            mut mf_struct_idx := -1 as i64
                            if arg != 0 as u32 and payload_type != TYPE_UNKNOWN and (payload_type as i64) < self.types.entries.len:
                                let pe = self.types.entries.data[payload_type as i64]
                                if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16:
                                    mf_struct_idx = pe.extra as i64
                            if mf_struct_idx >= 0 as i64:
                                mut ap := arg
                                mut afi := 0 as i64
                                while ap != 0 as u32:
                                    if self.tree.nodes.data[ap].kind == NODE_BINDING_PAT:
                                        let ap_sym = self.tree.nodes.data[ap].payload
                                        mut fld_ty := TYPE_UNKNOWN
                                        if mf_struct_idx < self.types.structs.len and afi < self.types.structs.data[mf_struct_idx].fields.len:
                                            fld_ty = self.types.structs.data[mf_struct_idx].fields.data[afi].type_id
                                        if ap_sym != 0 as u32:
                                            self.symtable.symbols.data[ap_sym].type_id = fld_ty
                                            self.set_node_type(ap, fld_ty)
                                    ap = self.tree.nodes.data[ap].next_sibling
                                    afi = afi + 1 as i64
                                // An RFC 0019 synthesized payload binds one name per FIELD, so
                                // the pattern's arity must match the variant's. Binding a
                                // two-field variant to a SINGLE name (`Pair(t)` for
                                // `Pair(i64, i64)`) typed `t` as field 0 and then let the body
                                // read `t.0`/`t.1` off a scalar â€” an accept-then-SEGFAULT
                                // (BUG#53 class). The supported form is `Pair(x, y)`.
                                // Safe to compare counts here because a flagged synth struct is
                                // unambiguously RFC 0019 (`__mfv_â€¦`): a TUPLE payload registers
                                // as an UNFLAGGED `__tupâ€¦` and takes the single-binding branch
                                // below, where binding one name to the whole tuple is correct.
                                if mf_struct_idx < self.types.structs.len and afi != self.types.structs.data[mf_struct_idx].fields.len:
                                    ax_printf_local("error: variant pattern binds the wrong number of values: this variant has %d field(s) but the pattern binds %d; write one name per field\n", self.types.structs.data[mf_struct_idx].fields.len, afi, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    self.diags_count = self.diags_count + 1 as i64
                            elif arg != 0 as u32 and self.tree.nodes.data[arg].kind == NODE_BINDING_PAT:
                                let arg_sym_idx = self.tree.nodes.data[arg].payload
                                if arg_sym_idx != 0 as u32:
                                    self.symtable.symbols.data[arg_sym_idx].type_id = payload_type
                                    self.set_node_type(arg, payload_type)
                    elif pat_node.kind == NODE_BINDING_PAT:
                        let b_sym_idx = pat_node.payload
                        if b_sym_idx != 0 as u32:
                            self.symtable.symbols.data[b_sym_idx].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)
            else:
                // RFC 0006 (#38.2): C-switch (int/bool/char scrutinee). A bare
                // binding pattern binds the whole value; literal patterns need
                // no typing (they are constants compared against the scrutinee).
                if pattern != 0 as u32:
                    let pat_node_i = self.tree.nodes.data[pattern]
                    if pat_node_i.kind == NODE_BINDING_PAT:
                        let bsi2 = pat_node_i.payload
                        if bsi2 != 0 as u32:
                            self.symtable.symbols.data[bsi2].type_id = scrutinee_type
                            self.set_node_type(pattern, scrutinee_type)

        if body != 0 as u32:
            result_type = self.infer_node(body, expected)
        
    elif kind == NODE_IF_STMT:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.check_cond_type(self.infer_node(cond, TYPE_BOOL))
            let then_branch = self.tree.nodes.data[cond].next_sibling
            if then_branch != 0 as u32:
                result_type = self.infer_node(then_branch, expected)
                mut sibling := self.tree.nodes.data[then_branch].next_sibling
                while sibling != 0 as u32:
                    self.infer_node(sibling, expected)
                    sibling = self.tree.nodes.data[sibling].next_sibling
                    
    elif kind == NODE_ELIF_CLAUSE:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.check_cond_type(self.infer_node(cond, TYPE_BOOL))
            let body = self.tree.nodes.data[cond].next_sibling
            if body != 0 as u32:
                result_type = self.infer_node(body, expected)
                
    elif kind == NODE_ELSE_CLAUSE:
        let body = self.tree.nodes.data[node_idx].first_child
        if body != 0 as u32:
            result_type = self.infer_node(body, expected)

    elif kind == NODE_IF_EXPR:
        // RFC 0023: children are `cond0, then0, [condi, theni, ...], else` (flat).
        // Conds are the even-indexed children except the final one; the LAST child
        // is always the mandatory else value; odd-indexed children are then-values.
        let first = self.tree.nodes.data[node_idx].first_child
        // Locate the last child (the else value).
        mut last := first
        mut c := first
        while c != 0 as u32:
            last = c
            c = self.tree.nodes.data[c].next_sibling
        // Anchor result type: the caller's expected type if concrete, else infer the
        // else branch to anchor on it. Int literals coerce to the anchor via `expected`.
        mut anchor := expected
        mut else_done := false
        if anchor == TYPE_UNKNOWN and last != 0 as u32:
            anchor = self.infer_node(last, TYPE_UNKNOWN)
            else_done = true
        // Anchor storage width (bytes). A value branch whose storage width differs
        // from the anchor would miscompile the shared result slot (the value diamond
        // writes one fixed-width vreg on every path) -> reject (BUG#53 convention).
        // Width â€” not exact type_id â€” is the safety criterion: `if c: Some(x) else:
        // None` has two different type_ids but both are 8-byte pointer-repr and is
        // valid; `if c: 42 else: "no"` (8 vs 16) is the dangerous case caught here.
        mut anchor_size := 0 as u32
        if anchor != TYPE_UNKNOWN and (anchor as i64) < self.types.entries.len:
            mut aalign := 0 as u32
            builder_type_size_and_align(self.types, anchor, &anchor_size, &aalign)
        mut idx := 0 as i64
        c = first
        while c != 0 as u32:
            let nxt = self.tree.nodes.data[c].next_sibling
            mut bt := TYPE_UNKNOWN
            mut is_value := true
            if c == last:
                if else_done:
                    is_value = false
                else:
                    bt = self.infer_node(c, anchor)
            elif idx % 2 as i64 == 0 as i64:
                self.infer_node(c, TYPE_BOOL)
                is_value = false
            else:
                bt = self.infer_node(c, anchor)
            if is_value and bt != TYPE_UNKNOWN and (bt as i64) < self.types.entries.len:
                let bkind = self.types.entries.data[bt as i64].kind
                let akind = self.types.entries.data[anchor as i64].kind
                let b_optres = self.tc_is_opt_res(bt)
                let a_optres = self.tc_is_opt_res(anchor)
                // Box-repr types (Option/Result/user-sum/generic-inst) skip the width
                // check: their box lowering round-trips through the shared result slot
                // (a nullary variant and a payload variant report inconsistent sizes
                // through inference but are the same box value). Only plain
                // primitive/str/struct branches get the width-mismatch reject.
                let b_boxy = b_optres or bkind == TYPE_KIND_SUM or bkind == TYPE_KIND_OPTION or bkind == TYPE_KIND_RESULT or bkind == TYPE_KIND_GENERIC_INST
                let a_boxy = a_optres or akind == TYPE_KIND_SUM or akind == TYPE_KIND_OPTION or akind == TYPE_KIND_RESULT or akind == TYPE_KIND_GENERIC_INST
                if anchor_size != 0 as u32 and not a_boxy and not b_boxy:
                    // Plain primitive/str/struct branches: the shared result slot has a
                    // fixed width, so a branch of a different storage width would
                    // miscompile (`if c: 42 else: "no"` is 8 vs 16). Reject.
                    mut bsize := 0 as u32
                    mut balign := 0 as u32
                    builder_type_size_and_align(self.types, bt, &bsize, &balign)
                    if bsize != 0 as u32 and bsize != anchor_size:
                        ax_printf_local("error: if-expression branches have incompatible types (different storage widths)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
            idx = idx + 1 as i64
            c = nxt
        result_type = anchor

    elif kind == NODE_WHILE_STMT:
        let cond = self.tree.nodes.data[node_idx].first_child
        if cond != 0 as u32:
            self.check_cond_type(self.infer_node(cond, TYPE_BOOL))
            let body = self.tree.nodes.data[cond].next_sibling
            if body != 0 as u32:
                self.infer_node(body, TYPE_UNKNOWN)

    elif kind == NODE_FOR_STMT:
        let iter_var = self.tree.nodes.data[node_idx].payload
        let range_expr = self.tree.nodes.data[node_idx].first_child
        // RFC 0018 P1: element type of the loop variable (default i32 for ranges /
        // integer bounds; overwritten to the array element type for `for x in arr`).
        mut for_elem_ty := TYPE_I32
        if range_expr != 0 as u32:
            let iteree_ty = self.infer_node(range_expr, TYPE_UNKNOWN)
            // BUG#87 follow-up: `for x in <collection>` (Vec/HashMap/array/struct) is
            // NOT implemented. lower_for treats any non-range iteree as a numeric limit
            // and the loop variable as a 0-based counter, never fetching elements -- so
            // `for x in vec` compares the counter against the Vec's ADDRESS and loops
            // ~forever (a real hang, no diagnostic). Only integer bounds (`for i in n`)
            // and ranges (`for i in a..b`) are supported. Reject aggregate iteration
            // cleanly instead of hanging (same convention as the BUG#72 slice reject).
            mut for_is_range := false
            if self.tree.nodes.data[range_expr].kind == NODE_BINARY_EXPR:
                let rop = self.node_text(range_expr)
                if rop == "..":
                    for_is_range = true
                safe_free_str(rop)
            // RFC 0018 P1: `for x in <fixed-array>` iterates elements. Bind the loop
            // variable to the array's element type and let air_builder's lower_for
            // desugar it to an index loop. STRUCT/SUM/GENERIC_INST (Vec/HashMap/...)
            // iteration is still unimplemented -> reject cleanly (that is P2), same
            // convention as the BUG#72 slice reject, to avoid the hang/miscompile.
            mut for_is_collection := false
            if not for_is_range and iteree_ty != TYPE_UNKNOWN and (iteree_ty as i64) < self.types.entries.len:
                let ie_kind = self.types.entries.data[iteree_ty].kind
                if iteree_ty == TYPE_BYTES:
                    // RFC 0020 P2: `for b in bytes` yields u8 bytes (byte semantics).
                    for_elem_ty = 5 as u32 // u8
                    for_is_collection = true
                elif iteree_ty == TYPE_STRING:
                    // RFC 0020 P2b: `for c in str` yields UTF-8 codepoints (rune = u32).
                    for_elem_ty = 7 as u32 // rune
                    for_is_collection = true
                elif ie_kind == TYPE_KIND_ARRAY:
                    for_elem_ty = self.types.entries.data[iteree_ty].extra
                    for_is_collection = true
                elif (ie_kind == TYPE_KIND_GENERIC_INST or ie_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.intern.get(self.types.entries.data[iteree_ty].name_id)) == "Vec":
                    // RFC 0018 P2: `for x in vec` where vec: Vec[T]. In a monomorphic
                    // context the Vec is a mono STRUCT (`_AX_std_Vec__i64`); in a generic
                    // context a GENERIC_INST. Its sole generic arg is the element type;
                    // air_builder's lower_for desugars to `vec.data[i]` for `i in 0..vec.len`.
                    let gargs = self.get_generic_args(iteree_ty)
                    if gargs.len >= 1 as i64:
                        for_elem_ty = gargs.data[0]
                        for_is_collection = true
                    else:
                        ax_printf_local("error: cannot determine the element type of this Vec for `for x in vec`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                elif (ie_kind == TYPE_KIND_GENERIC_INST or ie_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.intern.get(self.types.entries.data[iteree_ty].name_id)) == "HashMap":
                    // RFC 0018 P2: `for k in m` where m: HashMap[K,V] iterates the KEYS
                    // (the occupied-slot keys). Bind the loop variable to K (generic arg
                    // 0); air_builder's lower_for walks the table slots, guards on
                    // `occupied[i]`, and binds the var to `keys[i]`.
                    let gargs = self.get_generic_args(iteree_ty)
                    if gargs.len >= 1 as i64:
                        for_elem_ty = gargs.data[0]
                        for_is_collection = true
                    else:
                        ax_printf_local("error: cannot determine the key type of this HashMap for `for k in m`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                elif ie_kind == TYPE_KIND_STRUCT or ie_kind == TYPE_KIND_SUM or ie_kind == TYPE_KIND_GENERIC_INST:
                    ax_printf_local("error: iterating this collection with `for x in <collection>` is not yet supported (only fixed arrays and Vec[T]); use a range `for i in 0..n` or a `while` loop with .len/.get\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    self.diags_count = self.diags_count + 1 as i64
            // RFC 0018 P1: for a COLLECTION loop, bind the loop variable's type to the
            // element type BEFORE inferring the body, so field/method access on the
            // element (`p.y`) resolves against the element struct (otherwise the field
            // index defaults to 0 and every field reads offset 0 -> silent miscompile).
            // Range/integer loops keep the original post-body assignment below so their
            // body type environment (and codegen) is byte-identical.
            if for_is_collection and iter_var != 0 as u32:
                self.symtable.symbols.data[iter_var].type_id = for_elem_ty
            let body = self.tree.nodes.data[range_expr].next_sibling
            if body != 0 as u32:
                self.infer_node(body, TYPE_UNKNOWN)
        if iter_var != 0 as u32:
            self.symtable.symbols.data[iter_var].type_id = for_elem_ty
        
    elif kind == NODE_BINARY_EXPR:
        let lhs = self.tree.nodes.data[node_idx].first_child
        mut rhs := 0 as u32
        if lhs != 0 as u32:
            rhs = self.tree.nodes.data[lhs].next_sibling
            
        if lhs != 0 as u32 and rhs != 0 as u32:
            let op = flags
            if op == 1 as u16: // comparisons ==, !=, <, >, <=, >=
                let t1 = self.infer_node(lhs, TYPE_UNKNOWN)
                let t2 = self.infer_node(rhs, TYPE_UNKNOWN)
                // RFC 0005: a bare int literal operand adopts the other operand's
                // concrete numeric type so `x < 10` needs no `10 as u32`. Guard on
                // t1 != t2 so already-matching / both-cast operands are untouched
                // (keeps the self-host fixpoint: casted literals are CAST_EXPR nodes).
                let lhs_lit = self.tree.nodes.data[lhs].kind == NODE_INT_LIT
                let rhs_lit = self.tree.nodes.data[rhs].kind == NODE_INT_LIT
                if rhs_lit and not lhs_lit and tc_is_numeric(t1) and t1 != t2:
                    self.infer_node(rhs, t1)
                elif lhs_lit and not rhs_lit and tc_is_numeric(t2) and t1 != t2:
                    self.infer_node(lhs, t2)
                // RFC 0006 float-literal width inference for COMPARISONS (mirror of the
                // arithmetic branch below): a float literal defaults to f64, so `c == 4.0`
                // with `c: f32` compared f32 bits against an f64 literal -> mixed-precision
                // compare -> silently WRONG (`4.0f32 == 4.0` returned false). Coerce the
                // float-literal operand to the other operand's concrete float width so both
                // sides are the same precision. Same-width / pure-f64 code is unchanged.
                let lhs_flit = self.node_is_float_litish(lhs)
                let rhs_flit = self.node_is_float_litish(rhs)
                if rhs_flit and not lhs_flit and (t1 == TYPE_F32 or t1 == TYPE_F64) and t1 != t2:
                    self.infer_node(rhs, t1)
                elif lhs_flit and not rhs_flit and (t2 == TYPE_F32 or t2 == TYPE_F64) and t1 != t2:
                    self.infer_node(lhs, t2)

                // BUG#53: a comparison mixing a str/bytes operand and a numeric
                // operand (`s == 5`) silently compares the str's {ptr,len} against an
                // int -> meaningless/garbage result. Reject. str==str and numeric
                // comparisons are untouched (only the incompatible mix is caught).
                // Mirrors the arithmetic-binop str<->numeric reject.
                let c_t1_str = t1 == TYPE_STRING or t1 == TYPE_BYTES
                let c_t2_str = t2 == TYPE_STRING or t2 == TYPE_BYTES
                if (c_t1_str and tc_is_numeric(t2)) or (tc_is_numeric(t1) and c_t2_str):
                    let cbt = self.node_text(node_idx)
                    ax_printf_local("error: comparison '%s' between a string and a numeric operand is not allowed\n", get_str_ptr(cbt) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(cbt)
                    self.diags_count = self.diags_count + 1 as i64

                // Diagnostic: RFC 0007 lowers `a <op> b` on a STRUCT/SUM/GENERIC_INST
                // lhs to a method call (a.eq(b)/a.lt(b)/...) ONLY IF a matching
                // overload method is found; otherwise air_builder's lower_binary_expr
                // silently falls through to the native scalar opcode (OP_EQ/OP_ILT/...)
                // comparing the operands' RAW REGISTER VALUES -- which, for an
                // aggregate held by-address, means comparing the two operands'
                // ADDRESSES, not their field contents. Two distinct struct values with
                // identical fields then compare as "not equal" with NO diagnostic at
                // all (silent accept-then-miscompile, same class as BUG#53/#64). Reject
                // it here instead: if lhs is a user-type and no overload for this
                // operator exists, emit an error rather than emitting broken pointer-
                // comparison code.
                if (t1 as i64) < self.types.entries.len:
                    let t1_entry = self.types.entries.data[t1 as i64]
                    if t1_entry.kind == TYPE_KIND_STRUCT or t1_entry.kind == TYPE_KIND_SUM or t1_entry.kind == TYPE_KIND_GENERIC_INST:
                        let op_text = self.node_text(node_idx)
                        mut mname := ""
                        if op_text == "==" or op_text == "!=":
                            mname = "eq"
                        elif op_text == "<":
                            mname = "lt"
                        elif op_text == "<=":
                            mname = "le"
                        elif op_text == ">":
                            mname = "gt"
                        elif op_text == ">=":
                            mname = "ge"
                        safe_free_str(op_text)
                        if mname != "":
                            let msym = self.diag_resolve_op_method(mname, t1, t2)
                            if msym == 0 as u32:
                                let tname = self.intern.get(t1_entry.name_id)
                                ax_printf_local("error: type '%s' does not implement '%s' for this comparison; no operator overload found\n", get_str_ptr(tname) as i64, get_str_ptr(mname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64

                result_type = TYPE_BOOL
            elif op == 2 as u16: // and / or
                self.infer_node(lhs, TYPE_BOOL)
                self.infer_node(rhs, TYPE_BOOL)
                result_type = TYPE_BOOL
            else:
                mut t1 := self.infer_node(lhs, TYPE_UNKNOWN)
                mut t2 := self.infer_node(rhs, TYPE_UNKNOWN)
                // RFC 0005: bidirectional int-literal type inference (see above).
                let lhs_lit = self.tree.nodes.data[lhs].kind == NODE_INT_LIT
                let rhs_lit = self.tree.nodes.data[rhs].kind == NODE_INT_LIT
                if rhs_lit and not lhs_lit and tc_is_numeric(t1) and t1 != t2:
                    t2 = self.infer_node(rhs, t1)
                elif lhs_lit and not rhs_lit and tc_is_numeric(t2) and t1 != t2:
                    t1 = self.infer_node(lhs, t2)
                // RFC 0006 float-literal width inference. A float literal defaults to
                // f64 (NODE_FLOAT_LIT), so `y * 2.0` with `y: f32` produced mixed f32*f64
                // operands: result_type became F64 (below) but `y` is 32-bit, so codegen
                // emitted a 64-bit mulsd over the 32-bit bits -> garbage (miscompiled to
                // 0). Coerce a float-literal operand to the OTHER operand's concrete float
                // width, or (both literals) to an f32 EXPECTED context, mirroring the
                // integer-literal rule above. Same-width and pure-f64 code is unchanged.
                let lhs_flit = self.node_is_float_litish(lhs)
                let rhs_flit = self.node_is_float_litish(rhs)
                if rhs_flit and not lhs_flit and (t1 == TYPE_F32 or t1 == TYPE_F64) and t1 != t2:
                    t2 = self.infer_node(rhs, t1)
                elif lhs_flit and not rhs_flit and (t2 == TYPE_F32 or t2 == TYPE_F64) and t1 != t2:
                    t1 = self.infer_node(lhs, t2)
                elif lhs_flit and rhs_flit and expected == TYPE_F32:
                    t1 = self.infer_node(lhs, TYPE_F32)
                    t2 = self.infer_node(rhs, TYPE_F32)
                // BUG#53 class: an arithmetic/bitwise operator on an un-unwrapped
                // Option/Result operand silently lowers to OP_IADD/etc on the box value
                // -> garbage (e.g. `v.get(0) + v.get(1)` forgetting `.unwrap()` adds two
                // Option boxes). Reject it. Restricted to Option/Result (tc_is_opt_res,
                // base-name matched) so numeric operands, str+str (concat), and the
                // `hash_key[K]()%cap` generic-call mis-inference are unaffected; the
                // self-host never does arithmetic on an Option/Result value, so A==B holds.
                if self.tc_is_opt_res(t1) or self.tc_is_opt_res(t2):
                    let bot = self.node_text(node_idx)
                    ax_printf_local("error: operator '%s' is not defined for Option/Result operands (missing .unwrap()?)\n", get_str_ptr(bot) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(bot)
                    self.diags_count = self.diags_count + 1 as i64
                // BUG#53: a binary arithmetic/bitwise op with ONE str/bytes operand and
                // ONE numeric operand (`"hello" + 5`) silently lowered to pointer+int
                // (OP_IADD on the str's {ptr,len}) -> garbage. Reject. str+str stays
                // valid (both str -> concat, handled elsewhere); numeric+numeric is the
                // normal path. Only the genuinely-incompatible str<->numeric mix is
                // caught. See [[bug-malformed-input-robustness-cluster]].
                let t1_str = t1 == TYPE_STRING or t1 == TYPE_BYTES
                let t2_str = t2 == TYPE_STRING or t2 == TYPE_BYTES
                if (t1_str and tc_is_numeric(t2)) or (tc_is_numeric(t1) and t2_str):
                    let bot2 = self.node_text(node_idx)
                    ax_printf_local("error: operator '%s' is not defined between a string and a numeric operand\n", get_str_ptr(bot2) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(bot2)
                    self.diags_count = self.diags_count + 1 as i64
                // numeric promotion simple. RFC 0007: for a user-type lhs (operator
                // overload, lowered to a method call by air_builder) the result is
                // the lhs type â€” which the final `else` already yields.
                if t1 == TYPE_F64 or t2 == TYPE_F64:
                    result_type = TYPE_F64
                elif t1 == TYPE_F32 or t2 == TYPE_F32:
                    result_type = TYPE_F32
                elif t1 == TYPE_I64 or t2 == TYPE_I64:
                    result_type = TYPE_I64
                else:
                    result_type = t1
                    
    elif kind == NODE_CALL_EXPR:
        let callee = self.tree.nodes.data[node_idx].first_child
        if callee != 0 as u32:
            mut callee_node = self.tree.nodes.data[callee]
            mut is_generic_call := false
            mut template_sym_idx := 0 as u32

            if callee_node.kind == NODE_IDENT:
                // BUG#80: disambiguate an OVERLOADED free-call by the first argument type
                // BEFORE deciding generic-ness / binding the callee, mirroring the method
                // path. Rewrite the tree payload so air_builder lowers the right overload;
                // re-read callee_node afterwards (inferring the arg may realloc nodes,
                // BUG#51). No-op unless the name is overloaded and the head mismatches.
                let ov_first_arg = self.tree.nodes.data[callee].next_sibling
                mut ov_argc := 0 as i64
                mut ov_an := ov_first_arg
                while ov_an != 0 as u32:
                    ov_argc = ov_argc + 1 as i64
                    ov_an = self.tree.nodes.data[ov_an].next_sibling
                let ov_pick = self.resolve_free_call_overload(callee_node.payload, ov_first_arg, ov_argc)
                if ov_pick != callee_node.payload:
                    self.tree.nodes.data[callee].payload = ov_pick
                    callee_node = self.tree.nodes.data[callee]
                let sym_idx = ov_pick
                if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                    let sym = self.symtable.symbols.data[sym_idx]
                    mut src_tree := self.tree
                    if (sym_idx as i64) < self.symtable.symbol_trees.len:
                        let t = self.symtable.symbol_trees.data[sym_idx]
                        if t != null as ptr[AstTree]:
                            src_tree = t
                    if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                        is_generic_call = true
                        template_sym_idx = sym_idx
            elif callee_node.kind == NODE_FIELD_EXPR:
                if (callee_node.flags & 2048 as u16) != 0 as u16:
                    let rec_node = callee_node.first_child
                    if rec_node != 0 as u32:
                        self.infer_node(rec_node, TYPE_UNKNOWN)
                    mut sym_idx := callee_node.payload
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        mut src_tree := self.tree
                        if (sym_idx as i64) < self.symtable.symbol_trees.len:
                            let t = self.symtable.symbol_trees.data[sym_idx]
                            if t != null as ptr[AstTree]:
                                src_tree = t
                        if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                            is_generic_call = true
                            template_sym_idx = sym_idx
                else:
                    let field_name_id = callee_node.payload
                    let rec_node = callee_node.first_child
                    mut rec_type := TYPE_UNKNOWN
                    if rec_node != 0 as u32:
                        if (rec_node as i64) < self.node_types_cap:
                            rec_type = self.node_types[rec_node as i64]
                        if rec_type == TYPE_UNKNOWN:
                            rec_type = self.infer_node(rec_node, TYPE_UNKNOWN)

                    // Diagnostic: dynamic dispatch through an interface-typed
                    // receiver is not implemented -- there is no vtable/fat-
                    // pointer representation (TYPE_KIND_INTERFACE is otherwise
                    // unhandled everywhere in air_builder). Previously this
                    // silently resolved via plain scope lookup to WHATEVER
                    // same-named method happened to be visible (not the actual
                    // receiver's concrete type) and called it with a mismatched
                    // `self` layout -- a real segfault, same accept-then-
                    // miscompile class as BUG#53/64/68/70. Reject clearly.
                    mut rec_unwrapped := rec_type
                    if rec_unwrapped != TYPE_UNKNOWN and (rec_unwrapped as i64) < self.types.entries.len:
                        mut rue := self.types.entries.data[rec_unwrapped as i64]
                        while rue.kind == TYPE_KIND_POINTER or rue.kind == TYPE_KIND_REF:
                            rec_unwrapped = rue.extra as u32
                            rue = self.types.entries.data[rec_unwrapped as i64]
                        if rue.kind == TYPE_KIND_INTERFACE:
                            // RFC 0029: dynamic dispatch through an interface-typed receiver.
                            // Resolve the call's result type from the interface method contract
                            // (the concrete impl is unknown here â€” that's the point of dynamic
                            // dispatch). air_builder lowers `iface.m()` to a vtable-box indirect
                            // call. Closes BUG#71. Downstream result_type recovery only fires when
                            // still UNKNOWN, so this value stands.
                            result_type = self.interface_method_ret_type(rec_unwrapped, field_name_id)

                    mut sym_idx := self.resolve_method_sym(field_name_id, rec_type)
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        mut src_tree := self.tree
                        if (sym_idx as i64) < self.symtable.symbol_trees.len:
                            let t = self.symtable.symbol_trees.data[sym_idx]
                            if t != null as ptr[AstTree]:
                                src_tree = t
                        if sym.kind == SYM_FUNC and ((sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16)):
                            is_generic_call = true
                            template_sym_idx = sym_idx

                    // Method arity check (accept-then-miscompile, BUG#53 class â€” the twin
                    // of the free-function arity check in the TYPE_KIND_FUNC branch below):
                    // a concrete (non-generic) method call `recv.m(args...)` with the wrong
                    // number of explicit arguments was silently accepted â€” extra args were
                    // dropped, missing args read uninitialized registers. A non-generic method
                    // is NOT bound by resolve_method_sym (that only matches generic templates,
                    // BUG#45); it is matched later by name + receiver-type exactly like
                    // `method_ret_type` / air_builder's dispatch. Mirror that match here: a
                    // method's param[0] IS the receiver, so an INSTANCE call `recv.m(a,b)`
                    // expects (declared params - 1) explicit args and a STATIC call
                    // `Type.m(recv,a,b)` â€” receiver named as a bare type â€” expects exactly
                    // (declared params). Overload-safe: reject only when method(s) of this
                    // name+receiver EXIST but NONE match the call's arity (mirrors the free-fn
                    // overload philosophy). Gated TIGHTLY to stay self-host-safe: non-generic
                    // only (generic methods like `map`/`unwrap` have unreliable inferred arity
                    // and false-positived the fixpoint), and only a plain user STRUCT/SUM
                    // receiver (excludes Option/Result/Vec builtin + backend-intercepted
                    // methods). Module-qualified calls take the flag-2048 branch above.
                    if not is_generic_call and rec_type != TYPE_UNKNOWN and (rec_type as i64) < self.types.entries.len:
                        mut rec_uw := rec_type
                        mut rue2 := self.types.entries.data[rec_uw as i64]
                        while rue2.kind == TYPE_KIND_POINTER or rue2.kind == TYPE_KIND_REF:
                            rec_uw = rue2.extra as u32
                            rue2 = self.types.entries.data[rec_uw as i64]
                        if rue2.kind == TYPE_KIND_STRUCT or rue2.kind == TYPE_KIND_SUM:
                            // A STATIC call names the receiver as a bare type: the
                            // first_child ident binds to a TYPE symbol, not a value.
                            mut is_static_call := false
                            if rec_node != 0 as u32:
                                let rcn = self.tree.nodes.data[rec_node]
                                if rcn.kind == NODE_IDENT or rcn.kind == NODE_TYPE_EXPR:
                                    let rcsym = rcn.payload
                                    if rcsym != 0 as u32 and (rcsym as i64) < self.symtable.symbols.len:
                                        let rck = self.symtable.symbols.data[rcsym as i64].kind
                                        if rck == SYM_STRUCT or rck == SYM_TYPE_ALIAS or rck == SYM_INTERFACE or rck == SYM_BUILTIN_TYPE:
                                            is_static_call = true
                            mut mact := 0 as i64
                            mut mac := self.tree.nodes.data[callee].next_sibling
                            while mac != 0 as u32:
                                mact = mact + 1 as i64
                                mac = self.tree.nodes.data[mac as i64].next_sibling
                            // Scan for concrete methods matching name + receiver type
                            // (mirrors method_ret_type). found_any: a real method exists;
                            // arity_ok: at least one has the right (self-adjusted) arity.
                            let m_field_name = self.intern.get(field_name_id)
                            mut found_any := false
                            mut arity_ok := false
                            mut msi := 0 as i64
                            while msi < self.symtable.symbols.len:
                                let msym = self.symtable.symbols.data[msi]
                                if msym.kind == SYM_FUNC and msym.type_id != TYPE_UNKNOWN and (msym.type_id as i64) < self.types.entries.len and (msym.flags & SYM_FLAG_GENERIC) == 0 as u16:
                                    if self.intern.name_matches_method(msym.name_id, m_field_name):
                                        let mfe = self.types.entries.data[msym.type_id as i64]
                                        if mfe.kind == TYPE_KIND_FUNC and (mfe.extra as i64) < self.types.funcs.len:
                                            let mfi = self.types.funcs.data[mfe.extra as i64]
                                            if mfi.params.len > 0 as i64:
                                                mut mfp := mfi.params.data[0]
                                                while mfp != TYPE_UNKNOWN and (mfp as i64) < self.types.entries.len:
                                                    let mpe = self.types.entries.data[mfp as i64]
                                                    if mpe.kind == TYPE_KIND_POINTER or mpe.kind == TYPE_KIND_REF:
                                                        mfp = mpe.extra as u32
                                                    else:
                                                        break
                                                if mfp == rec_uw:
                                                    found_any = true
                                                    let mdecl = self.sym_decl_param_count(msi as u32)
                                                    if mdecl >= 1 as i64:
                                                        mut expected_expl := mdecl - 1 as i64
                                                        if is_static_call:
                                                            expected_expl = mdecl
                                                        if mact == expected_expl:
                                                            arity_ok = true
                                msi = msi + 1 as i64
                            if found_any and not arity_ok:
                                ax_printf_local("error: method '%s' called with %d argument(s) but no overload takes that many\n", get_str_ptr(m_field_name) as i64, mact, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(m_field_name)

                    // BUG#93: a namespace-qualified call whose member did not resolve.
                    // On the native build imports are stripped textually, so `std`/
                    // `math`/`string` are never SYM_MODULE and the resolver leaves
                    // `std.math.gcd(...)` / `string.concat(a,b)` as an unresolved
                    // NODE_FIELD_EXPR (flag 2048 unset). air_builder then lowers the
                    // callee to a garbage register and emits `call *reg` -> silent
                    // SIGSEGV. Detect it precisely: walk the receiver chain down to its
                    // ROOT identifier and re-resolve that name. If the root binds to
                    // nothing, the whole chain is an undefined namespace reference, not
                    // a value -- so this is an unresolved module-qualified call, NOT a
                    // value method like `r.unwrap()` (whose root binds to a SYM_VAR/
                    // SYM_PARAM and is spared). Reject cleanly (accept-then-miscompile
                    // class, BUG#53/#68/#88). The compiler's own source has no surviving
                    // `std.X.Y` field-exprs post-strip, so this never trips self-build.
                    if sym_idx == 0 as u32 and rec_node != 0 as u32:
                        mut lroot := rec_node
                        mut lk := self.tree.nodes.data[lroot].kind
                        while lk == NODE_FIELD_EXPR:
                            let nc = self.tree.nodes.data[lroot].first_child
                            if nc == 0 as u32:
                                break
                            lroot = nc
                            lk = self.tree.nodes.data[lroot].kind
                        if lroot != 0 as u32 and self.tree.nodes.data[lroot].kind == NODE_IDENT:
                            let root_spell = self.node_text(lroot)
                            if root_spell != "":
                                // Decide if the root ident is BOUND. `symtable.resolve`
                                // only sees module/global scope here (local scopes are
                                // already popped), so it CANNOT be used to detect a
                                // local/param receiver. Instead use the payload the
                                // resolver stamped on the ident: a bound ident's payload
                                // is its symbol index, and that symbol's name_id equals
                                // the ident spelling's name_id. An UNBOUND namespace ident
                                // keeps its raw name_id as payload, indexing some
                                // unrelated symbol whose name_id will not match. Compare
                                // interned name_ids (u32) -- no dependency on str equality
                                // lowering. This distinguishes a real value receiver
                                // (`r`, `self`, a global) from an undefined namespace
                                // (`std`, `math`, `string`).
                                let spell_name_id = self.intern.intern_string(root_spell)
                                mut root_bound := false
                                let rp = self.tree.nodes.data[lroot].payload
                                if rp != 0 as u32 and (rp as i64) < self.symtable.symbols.len:
                                    if self.symtable.symbols.data[rp].name_id == spell_name_id:
                                        root_bound = true
                                if not root_bound:
                                    let fname = self.intern.get(field_name_id)
                                    ax_printf_local("error: unresolved call to '%s' on undefined namespace '%s' -- module not imported or not bundled on this build\n", get_str_ptr(fname) as i64, get_str_ptr(root_spell) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    safe_free_str(fname)
                                    self.diags_count = self.diags_count + 1 as i64

            if is_generic_call:
                let decl_node = self.symtable.symbols.data[template_sym_idx].decl_node
                
                // Find the correct source AstTree for the generic template
                mut src_tree := self.tree
                if (template_sym_idx as i64) < self.symtable.symbol_trees.len:
                    let t = self.symtable.symbol_trees.data[template_sym_idx]
                    if t != null as ptr[AstTree]:
                        src_tree = t

                // Collect generic parameter name_ids using the correct source tree
                mut gen_params := new_u32_vec()
                mut c := src_tree.nodes.data[decl_node].first_child
                while c != 0 as u32:
                    let cn = src_tree.nodes.data[c]
                    if cn.kind == NODE_GENERIC_PARAMS:
                        mut gp := cn.first_child
                        while gp != 0 as u32:
                            let gp_name = self.node_text_in_tree(src_tree, gp)
                            let gp_name_id = self.intern.intern(gp_name)
                            safe_free_str(gp_name)
                            gen_params.push(gp_name_id)
                            gp = src_tree.nodes.data[gp].next_sibling
                        break
                    c = cn.next_sibling
                
                // Collect argument types
                mut arg_types := new_u32_vec()
                if callee_node.kind == NODE_FIELD_EXPR:
                    let rec_node = callee_node.first_child
                    if rec_node != 0 as u32:
                        let rec_type = self.infer_node(rec_node, TYPE_UNKNOWN)
                        arg_types.push(rec_type)
                
                mut arg_idx := self.tree.nodes.data[callee].next_sibling
                while arg_idx != 0 as u32:
                    let a_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    arg_types.push(a_type)
                    arg_idx = self.tree.nodes.data[arg_idx].next_sibling
                
                // Map generic params to inferred TypeIDs using the correct source tree
                mut inferred := new_u32_vec()
                mut i := 0 as i64
                while i < gen_params.len:
                    inferred.push(TYPE_UNKNOWN)
                    i = i + 1
                
                mut p_idx := 0 as i64
                c = src_tree.nodes.data[decl_node].first_child
                while c != 0 as u32:
                    let cn = src_tree.nodes.data[c]
                    if cn.kind == NODE_PARAM_DECL:
                        let type_node_idx = cn.first_child
                        if type_node_idx != 0 as u32 and p_idx < arg_types.len:
                            self.infer_generic_type_args(type_node_idx, arg_types.data[p_idx], gen_params, inferred, src_tree)
                        p_idx = p_idx + 1
                    c = cn.next_sibling
                
                // BUG#79: a type param left UNKNOWN here would be i32-defaulted
                // below. Whether a generic-looking ARGUMENT should block
                // instantiation depends on this: if every param was resolved
                // concretely (e.g. a Vec[Option[i32]] receiver fully determines
                // T), a generic-looking argument such as `None` must NOT defer.
                mut has_unresolved := false
                i = 0
                while i < inferred.len:
                    if inferred.data[i] == TYPE_UNKNOWN:
                        has_unresolved = true
                    i = i + 1

                i = 0
                while i < inferred.len:
                    if inferred.data[i] == TYPE_UNKNOWN:
                        inferred.data[i] = TYPE_I32
                    i = i + 1

                mut has_generic_arg := false
                // A genuinely generic inferred type param (inside a generic body)
                // means no concrete instance can be produced yet â€” always defer.
                mut inf_idx := 0 as i64
                while inf_idx < inferred.len:
                    if self.is_generic(inferred.data[inf_idx]):
                        has_generic_arg = true
                        break
                    inf_idx = inf_idx + 1

                // Only when a param was left UNRESOLVED (and thus i32-defaulted)
                // does a generic ARGUMENT signal a generic context we must defer
                // to, rather than bake a wrong i32 instance. When inference is
                // complete, a generic-looking argument like `None` cannot block.
                if has_unresolved:
                    mut a_idx := 0 as i64
                    while a_idx < arg_types.len:
                        if self.is_generic(arg_types.data[a_idx]):
                            has_generic_arg = true
                            break
                        a_idx = a_idx + 1

                if has_generic_arg:
                    // Deferring a generic-typed call is correct ONLY inside a generic
                    // body (it re-instantiates at monomorphization). In a CONCRETE
                    // function the type param is genuinely un-inferable (e.g. only a
                    // bare `None` supplied it), no instance is ever produced, and the
                    // deferred call silently SEGFAULTs. Reject cleanly instead (BUG#53
                    // convention) â€” the caller must add explicit type arguments
                    // (`f[T](...)`) or annotate the argument. See
                    // [[bug-none-first-generic-inference]] residual cluster (s3/n2).
                    if not self.current_fn_is_generic:
                        ax_printf_local("error: cannot infer generic type parameter for this call in a non-generic context; add explicit type arguments (f[T](...)) or annotate the argument\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    if gen_params.data != null as ptr[u32]:
                        @free(gen_params.data as ptr[u8])
                    if arg_types.data != null as ptr[u32]:
                        @free(arg_types.data as ptr[u8])
                    if inferred.data != null as ptr[u32]:
                        @free(inferred.data as ptr[u8])
                else:
                    // RFC 0022 tupleÃ—generic: a tuple LITERAL passed as a generic
                    // fn/method arg (`Vec[(i64,i64)].push((10,20))`) was inferred with
                    // UNKNOWN during arg_types collection, so its int-literal elements
                    // defaulted to i32 â†’ an 8-byte {i32,i32} stored into a 16-byte element
                    // slot, reading the 2nd field as garbage. Now that `inferred[]` is
                    // final and concrete, re-infer any bare-generic-typed tuple arg with
                    // its monomorphized `__tup` element type as the expected hint: the
                    // NODE_TUPLE_EXPR coercion branch widens the elements and PINS the node
                    // to the `__tup` struct, and the sticky guard preserves it against a
                    // later UNKNOWN re-visit. Mirrors the variant-ctor fix (1aff7ca).
                    mut cp := src_tree.nodes.data[decl_node].first_child
                    // For a method call, param 0 is the receiver `self` (its arg node is
                    // callee.first_child, not in the sibling chain), so skip it; explicit
                    // args start at callee.next_sibling and align with the remaining params.
                    mut ap := self.tree.nodes.data[callee].next_sibling
                    mut skip_self := callee_node.kind == NODE_FIELD_EXPR
                    while cp != 0 as u32:
                        let cpn = src_tree.nodes.data[cp]
                        if cpn.kind == NODE_PARAM_DECL:
                            if skip_self:
                                skip_self = false
                            elif ap != 0 as u32:
                                let arg_n = self.tree.nodes.data[ap]
                                let tnode = cpn.first_child
                                if tnode != 0 as u32 and src_tree.nodes.data[tnode].kind == NODE_TYPE_EXPR:
                                    let tname = self.node_text_in_tree(src_tree, tnode)
                                    let tname_id = self.intern.intern(tname)
                                    safe_free_str(tname)
                                    mut gk := 0 as i64
                                    while gk < gen_params.len:
                                        if gen_params.data[gk] == tname_id:
                                            let et = inferred.data[gk]
                                            // RFC 0022 tupleÃ—generic: a `(a, b)` literal for a
                                            // bare-generic param resolved to a `__tup` struct.
                                            if arg_n.kind == NODE_TUPLE_EXPR and (et as i64) < self.types.entries.len and self.types.entries.data[et as i64].kind == TYPE_KIND_STRUCT:
                                                let enm2 = self.intern.get(self.types.entries.data[et as i64].name_id)
                                                let is_tup2 = std.string.starts_with(enm2, "__tup")
                                                safe_free_str(enm2)
                                                if is_tup2:
                                                    self.infer_node(ap, et)
                                            // f32: a bare-generic param resolved to f32 (e.g.
                                            // `Vec[f32].push(40.0)`, item: T=f32). Re-infer the
                                            // arg with f32 expected so a float literal narrows to
                                            // single instead of storing a DOUBLE into the 4-byte
                                            // f32 element slot -> read back 0 (same class as the
                                            // f32 literal boundary/aggregate bugs). The compiler
                                            // instantiates no generic with f32, so fixpoint-safe.
                                            // [[bug-f32-boundary-abi-open]]
                                            elif et == TYPE_F32:
                                                self.infer_node(ap, et)
                                            // RFC 0022 follow-up: a VARIANT CTOR arg
                                            // (`Vec[Option[(i64,i64)]].push(Some((20,22)))`) whose
                                            // bare-generic param resolved to an Option/Result/sum
                                            // element type. The inner aggregate literal was inferred
                                            // with UNKNOWN during arg_types collection -> defaulted
                                            // to {i32,i32} (8B) even though the receiver fixed the
                                            // element type. Re-infer with the resolved element type;
                                            // try_instantiate_variant_call recovers the payload hint
                                            // from the concrete sum's variant payload_type and
                                            // coerces the inner tuple/struct literal to real widths.
                                            // Gated to a ctor CALL arg; idents/None unaffected.
                                            elif arg_n.kind == NODE_CALL_EXPR and (et as i64) < self.types.entries.len and (self.types.entries.data[et as i64].kind == TYPE_KIND_OPTION or self.types.entries.data[et as i64].kind == TYPE_KIND_RESULT or self.types.entries.data[et as i64].kind == TYPE_KIND_GENERIC_INST or self.types.entries.data[et as i64].kind == TYPE_KIND_SUM):
                                                self.infer_node(ap, et)
                                            break
                                        gk = gk + 1 as i64
                                ap = self.tree.nodes.data[ap].next_sibling
                        cp = cpn.next_sibling
                    mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
                    let mangled_name = mono.mangle_name_ov(template_sym_idx, self.intern.get(self.symtable.symbols.data[template_sym_idx].name_id), inferred)
                    let mangled_id = self.intern.intern(mangled_name)
                    mut existing_sym_idx := self.symtable.resolve(mangled_id)
                    if existing_sym_idx == 0 as u32:
                        existing_sym_idx = self.symtable.resolve_global(mangled_id)
                    
                    mut inst_sym_idx := 0 as u32
                    if existing_sym_idx != 0 as u32:
                        let existing_sym = self.symtable.symbols.data[existing_sym_idx]
                        if existing_sym.type_id != 0 as u32:
                            inst_sym_idx = existing_sym_idx
                    else:
                        let cloned_root = mono.instantiate_function(template_sym_idx, inferred)
                        self.tree.append_child(0 as u32, cloned_root)
                        
                        let saved_data = self.symtable.stack.data
                        let saved_len = self.symtable.stack.len
                        let saved_cap = self.symtable.stack.cap
                        mut temp_stack := new_u32_vec()
                        temp_stack.push(0 as u32)
                        if saved_len > 1:
                            temp_stack.push(saved_data[1])
                        self.symtable.stack = temp_stack
                        mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
                        resolver.resolve_node(cloned_root)
                        @free(self.symtable.stack.data as ptr[u8])
                        self.symtable.stack.data = saved_data
                        self.symtable.stack.len = saved_len
                        self.symtable.stack.cap = saved_cap
                        
                        let payload_sym = self.tree.nodes.data[cloned_root].payload
                        if payload_sym != 0 as u32:
                            inst_sym_idx = payload_sym
                        else:
                            mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                            if resolved_inst_sym == 0 as u32:
                                resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                            inst_sym_idx = resolved_inst_sym
                        
                        self.pre_infer_func_signature(cloned_root)
                        self.infer_node(cloned_root, TYPE_UNKNOWN)
                    
                    self.tree.nodes.data[callee].payload = inst_sym_idx
                    self.tree.nodes.data[callee].flags = self.tree.nodes.data[callee].flags | 2048 as u16
                    
                    if gen_params.data != null as ptr[u32]:
                        @free(gen_params.data as ptr[u8])
                    if arg_types.data != null as ptr[u32]:
                        @free(arg_types.data as ptr[u8])
                    if inferred.data != null as ptr[u32]:
                        @free(inferred.data as ptr[u8])
            
            mut callee_type = self.infer_node(callee, TYPE_UNKNOWN)
            // A monomorphized generic call (callee.flags & 2048, set above) had its
            // payload pointed at the concrete INSTANCE symbol, whose pre-inferred
            // signature carries the concrete return type (f64/i32/struct/...). But
            // infer_node re-resolves the ident to the generic TEMPLATE, whose return is
            // the generic param (ret=0/UNKNOWN) â€” so result_type below defaulted to int,
            // silently corrupting a FLOAT (or other non-int-repr) return (int matched the
            // default by coincidence, hiding this until now). Prefer the instance's own
            // signature type. See [[bug-generic-fn-float-return-default-int]].
            if (self.tree.nodes.data[callee].flags & 2048 as u16) != 0 as u16:
                let inst_pay = self.tree.nodes.data[callee].payload
                if inst_pay != 0 as u32 and (inst_pay as i64) < self.symtable.symbols.len:
                    let inst_tid = self.symtable.symbols.data[inst_pay as i64].type_id
                    if inst_tid != 0 as u32 and (inst_tid as i64) < self.types.entries.len and self.types.entries.data[inst_tid].kind == TYPE_KIND_FUNC:
                        callee_type = inst_tid
            if callee_type != TYPE_UNKNOWN:
                let entry = self.types.entries.data[callee_type]
                if entry.kind == TYPE_KIND_FUNC:
                    let fi = self.types.funcs.data[entry.extra]
                    result_type = fi.ret
                    // Arity check (was silent accept-then-miscompile, BUG#53 class): a
                    // call with the wrong number of arguments compiled clean and
                    // miscompiled -- missing args read uninitialized registers, extra
                    // args were silently dropped. AXIOM has no variadic user functions
                    // or default arguments, so a concrete FUNC callee's arity is exact.
                    // Scoped TIGHTLY to a plain NODE_IDENT free-function callee that is
                    // NOT generic: this is where the args are a clean sibling list with
                    // no implicit receiver. Method / UFCS / generic-method calls
                    // (field-expr callees, e.g. the generic `map`/`ok_or`) are NOT
                    // checked here -- their arg/receiver/partial-signature shape is
                    // unreliable at inference time and would false-positive (broke the
                    // self-host: `'map' expects 1, found 0`). Free-function arity is the
                    // common mistake and is safe to check exactly.
                    if not is_generic_call and self.tree.nodes.data[callee].kind == NODE_IDENT:
                        mut fnm := "function"
                        mut fnm_owned := false
                        let cpay = self.tree.nodes.data[callee].payload
                        if cpay != 0 as u32 and (cpay as i64) < self.symtable.symbols.len:
                            fnm = self.intern.get(self.symtable.symbols.data[cpay as i64].name_id)
                            fnm_owned = true
                        // `compiler_intrinsic` is the one internal VARIADIC intrinsic
                        // (declared 1 param but magic-called `@compiler_intrinsic("op")
                        // [T](...)` with varying arity) -- exclude it. User functions
                        // are never variadic.
                        mut is_intrinsic := false
                        if fnm == "compiler_intrinsic" or fnm == "@compiler_intrinsic" or fnm == "ax_compiler_intrinsic":
                            is_intrinsic = true
                        if not is_intrinsic:
                            mut actual_args := 0 as i64
                            mut ac := self.tree.nodes.data[callee].next_sibling
                            while ac != 0 as u32:
                                actual_args = actual_args + 1 as i64
                                ac = self.tree.nodes.data[ac as i64].next_sibling
                            if actual_args != fi.params.len:
                                ax_printf_local("error: '%s' expects %d argument(s), found %d\n", get_str_ptr(fnm) as i64, fi.params.len, actual_args, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            else:
                                // BUG#53 (arg-path analog of m5): a str/numeric-LITERAL
                                // argument passed where the param is the opposite kind
                                // (`f("hi")` with `f(n:i64)`, or `f(42)` with `f(s:str)`)
                                // was silently accepted then crashed/segfaulted (the
                                // {ptr,len} str repr read as an int, or vice versa).
                                // Reject. Gated on the arg being a str/int/float LITERAL
                                // (unambiguous type) so real coercions & value args are
                                // untouched. See [[bug-malformed-input-robustness-cluster]].
                                mut pchk := 0 as i64
                                mut anode := self.tree.nodes.data[callee].next_sibling
                                while anode != 0 as u32 and pchk < fi.params.len:
                                    let ak = self.tree.nodes.data[anode].kind
                                    let pt = fi.params.data[pchk]
                                    // BUG#53: an Option/Result/sum VALUE passed where a plain SCALAR
                                    // primitive `T` is expected (forgot `.unwrap()`) â€” the 8-byte
                                    // tagged box is read raw as `T` -> garbage (`f(o)` with
                                    // `o:Option[i64]`, `f(x:i64)` returned 9). Reject. Read the arg's
                                    // TRUE type from its SYMBOL (ident args) â€” an annotated
                                    // `Option[i64]` local resolves to a SUM-kind type here, which is
                                    // why node_types (unset at this point) and OPTION-kind checks both
                                    // missed it. Gated to a PRIMITIVE-scalar param + an aggregate-kind
                                    // (OPTION/RESULT/SUM) ident arg: passing an aggregate where a
                                    // scalar is expected is always a type error, so this cannot
                                    // over-reject a valid program. [[bug-option-as-call-arg-not-rejected]]
                                    mut pt_plain := false
                                    if pt != TYPE_UNKNOWN and pt != TYPE_VOID and (pt as i64) < self.types.entries.len:
                                        let pk0 = self.types.entries.data[pt as i64].kind
                                        if pk0 == TYPE_KIND_PRIMITIVE or pk0 == TYPE_KIND_STRUCT:
                                            pt_plain = true
                                    if pt_plain:
                                        // Arg's TRUE type: an IDENT reads its symbol's decl type
                                        // (node_types is unset here, and an annotated `Option[i64]`
                                        // local resolves to a SUM-kind type â€” the reason kind-11/12
                                        // checks missed it); a NON-ident (e.g. a call `v.get(0)`
                                        // returning Option) is inferred. A str/int/float LITERAL infers
                                        // to a PRIMITIVE (never OPTION/RESULT/SUM) so it never rejects.
                                        mut a_sty := TYPE_UNKNOWN
                                        if ak == NODE_IDENT:
                                            let a_ident_sym = self.tree.nodes.data[anode].payload
                                            if a_ident_sym != 0 as u32 and (a_ident_sym as i64) < self.symtable.symbols.len:
                                                a_sty = self.symtable.symbols.data[a_ident_sym].type_id
                                        else:
                                            a_sty = self.infer_node(anode, TYPE_UNKNOWN)
                                        if a_sty != TYPE_UNKNOWN and (a_sty as i64) < self.types.entries.len:
                                            let a_stk = self.types.entries.data[a_sty as i64].kind
                                            if a_stk == TYPE_KIND_OPTION or a_stk == TYPE_KIND_RESULT or a_stk == TYPE_KIND_SUM:
                                                ax_printf_local("error: argument to '%s' is an Option/Result/sum value but the parameter expects a plain value (missing .unwrap()?)\n", get_str_ptr(fnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                                self.diags_count = self.diags_count + 1 as i64
                                    let p_str = pt == TYPE_STRING or pt == TYPE_BYTES
                                    let p_num = pt >= TYPE_I8 and pt <= TYPE_USIZE and pt != TYPE_STRING and pt != TYPE_VOID
                                    let a_strlit = ak == NODE_STRING_LIT
                                    let a_numlit = ak == NODE_INT_LIT or ak == NODE_FLOAT_LIT
                                    if (p_num and a_strlit) or (p_str and a_numlit):
                                        ax_printf_local("error: argument type mismatch in call to '%s': a string and a numeric type are not compatible\n", get_str_ptr(fnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        self.diags_count = self.diags_count + 1 as i64
                                    // RFC 0029: a concrete struct passed where an interface is
                                    // expected must structurally IMPLEMENT it â€” else dispatch
                                    // builds a vtable slot from a 0 method-symbol and calls
                                    // through a null pointer (accept-then-miscompile, BUG#53).
                                    if (pt as i64) < self.types.entries.len and self.types.entries.data[pt as i64].kind == TYPE_KIND_INTERFACE:
                                        mut at := TYPE_UNKNOWN
                                        if (anode as i64) < self.node_types_cap:
                                            at = self.node_types[anode as i64]
                                        if at == TYPE_UNKNOWN:
                                            at = self.infer_node(anode, TYPE_UNKNOWN)
                                        if at != TYPE_UNKNOWN and (at as i64) < self.types.entries.len and self.types.entries.data[at as i64].kind == TYPE_KIND_STRUCT:
                                            let missing = self.interface_missing_method(at, pt)
                                            if missing != 0 as u32:
                                                let mn = self.intern.get(missing)
                                                ax_printf_local("error: type does not implement interface method '%s' required by the interface parameter\n", get_str_ptr(mn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                                safe_free_str(mn)
                                                self.diags_count = self.diags_count + 1 as i64
                                    pchk = pchk + 1 as i64
                                    anode = self.tree.nodes.data[anode as i64].next_sibling
                        if fnm_owned:
                            safe_free_str(fnm)


                elif entry.kind == TYPE_KIND_STRUCT:
                    // BUG#74: if this is a generic struct constructed without
                    // explicit type args, monomorphize it from the field values.
                    result_type = self.try_instantiate_struct_ctor(callee, callee_type, expected)
                    self.check_ctor_field_str_num(callee)
                elif entry.kind == TYPE_KIND_SUM:
                    result_type = self.try_instantiate_variant_call(callee, callee_type, expected)
                    self.coerce_variant_ctor_payload(callee, callee_type)
                    self.check_variant_ctor_arity(callee, callee_type)
                elif entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                    result_type = callee_type
                elif self.tree.nodes.data[callee].kind == NODE_IDENT:
                    // `x(args)` where `x` is a plain VALUE (local/param/const) whose type is
                    // NOT callable (i64, a struct, an array, ...). AXIOM has no first-class
                    // fn-value call through a variable yet â€” a genuine fn pointer types as
                    // TYPE_KIND_FUNC and is handled in the branch above. Previously this was
                    // accepted with result_type UNKNOWN: air_builder's lower_call_expr fell
                    // through to an INDIRECT `call reg` through the scalar value â†’ SIGSEGV,
                    // with no compile-time signal (accept-then-miscompile, BUG#53 class).
                    // Reject cleanly. GATED to VALUE symbols (SYM_VAR/PARAM/CONST) so that
                    // type-name conversion calls / constructor idents (SYM_STRUCT/TYPE_ALIAS/
                    // BUILTIN_TYPE) are never touched, and self-build is safe (the compiler
                    // never calls a value variable).
                    let cvsym = self.tree.nodes.data[callee].payload
                    if cvsym != 0 as u32 and (cvsym as i64) < self.symtable.symbols.len:
                        let cvk = self.symtable.symbols.data[cvsym as i64].kind
                        if cvk == SYM_VAR or cvk == SYM_PARAM or cvk == SYM_CONST:
                            let cv_name_id = self.symtable.symbols.data[cvsym as i64].name_id
                            // ARITY-AWARE guard. A bare ident can resolve (at typecheck) to a
                            // VALUE symbol that SHADOWS a same-named free function â€” e.g. the
                            // compiler's own `let len = std.string.len(s)` locals: the qualified
                            // call collapses to a bare `len` whose typecheck-resolved callee is
                            // the local, yet air_builder re-binds it to `fn len(s: str)` by
                            // name+args and it works. So "a function of this name exists" is too
                            // lenient (it also spared the genuine bug `helper(0)` where
                            // `fn helper()` takes 0 args but is called with 1). Reject only when
                            // NO same-named SYM_FUNC has a matching PARAMETER COUNT: the 5 `len`
                            // self-build sites are 1-arg and `fn len` is 1-param (spared, A==B),
                            // while `helper(0)` (1 arg vs 0-param fn) and `x(3)` (no `fn x`)
                            // both reject. A genuine fn pointer types as TYPE_KIND_FUNC and never
                            // reaches this branch, so first-class fn-values are unaffected.
                            let cvnm = self.intern.get(cv_name_id)
                            mut cv_argc := 0 as i64
                            mut cv_an := self.tree.nodes.data[callee].next_sibling
                            while cv_an != 0 as u32:
                                cv_argc = cv_argc + 1 as i64
                                cv_an = self.tree.nodes.data[cv_an as i64].next_sibling
                            mut arity_match := false
                            mut fsi := 0 as i64
                            while fsi < self.symtable.symbols.len:
                                let fssym = self.symtable.symbols.data[fsi]
                                if fssym.kind == SYM_FUNC and self.intern.name_matches_method(fssym.name_id, cvnm):
                                    let fpc = self.sym_decl_param_count(fsi as u32)
                                    // free-call form: exact param count, OR method form where
                                    // param[0] is self (param count == argc + 1). Spare both.
                                    if fpc == cv_argc or fpc == cv_argc + 1 as i64:
                                        arity_match = true
                                        break
                                fsi = fsi + 1 as i64
                            if not arity_match:
                                ax_printf_local("error: '%s' is not a function; it cannot be called\n", get_str_ptr(cvnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(cvnm)
                elif self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR:
                    // Diagnostic (was silent accept-then-miscompile, same class as
                    // BUG#53): `recv.name(...)` where `name` resolved to a genuine
                    // DATA FIELD (a concrete, non-callable type â€” not FUNC, and not a
                    // STRUCT/SUM/GENERIC_INST/OPTION/RESULT constructor-call), because
                    // no method named `name` exists on recv's type. e.g. `v.len()` on
                    // a Vec, which has a `len: i64` FIELD but no `len()` method (the
                    // correct call is the field `v.len`, no parens). Previously this
                    // left result_type UNKNOWN and air_builder's lower_call_expr fell
                    // back to `getfld` + INDIRECT CALL through the field's scalar
                    // value â€” segfault or a jump to a garbage address, with no
                    // compile-time signal. Scoped to NODE_FIELD_EXPR callees only, so
                    // qualified constructor calls (`Mod.Struct(...)`, `Enum.Variant(x)`
                    // â€” also FIELD_EXPR callees, but those resolve to STRUCT/SUM above
                    // and never reach this branch) are unaffected.
                    let fname = self.intern.get(self.tree.nodes.data[callee].payload)
                    ax_printf_local("error: '%s' is a field, not a function; it cannot be called\n", get_str_ptr(fname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    safe_free_str(fname)
                    self.diags_count = self.diags_count + 1 as i64
            else:
                // BUG#51: `callee_node` is an ADDRESS into the nodes buffer under the
                // native backend (aggregates are held by-address). Generic
                // instantiation above may have GROWN tree.nodes (realloc + free of
                // the old buffer), leaving `callee_node` dangling â€” the gcc-built
                // compiler read stale-but-intact pages, the native allocator
                // (VirtualFree) unmaps them â†’ deterministic segfault. Re-read the
                // node fields through the CURRENT buffer here and below.
                if self.tree.nodes.data[callee].kind == NODE_IDENT:
                    let sym_idx = self.tree.nodes.data[callee].payload
                    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                        let sym = self.symtable.symbols.data[sym_idx]
                        let name = self.intern.get(sym.name_id)
                        if (name == "syscall0" or name == "syscall1" or name == "syscall2" or
                            name == "syscall3" or name == "syscall4" or name == "syscall5" or
                            name == "syscall6"):
                            result_type = TYPE_I64
                        elif name == "panic":
                            result_type = TYPE_VOID

            // BUG#45 case (1): a non-generic method call whose callee failed to
            // type (resolve_method_sym only matches GENERIC methods) leaves the
            // call UNTYPED. Recover the RETURN type â€” but ONLY for AGGREGATE
            // returns, the case that is actually broken (an untyped copy of a
            // scalar already works via the register return, so scalar method
            // calls are left exactly as before to keep the blast radius minimal).
            // This sets only the call's result type; it does NOT mutate the
            // field-expr node/flag/payload, so method dispatch is unchanged.
            // (BUG#51: fresh nodes.data reads â€” see comment above.)
            if result_type == TYPE_UNKNOWN and self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR:
                let rec_node2 = self.tree.nodes.data[callee].first_child
                if rec_node2 != 0 as u32:
                    mut rt := TYPE_UNKNOWN
                    if (rec_node2 as i64) < self.node_types_cap:
                        rt = self.node_types[rec_node2 as i64]
                    if rt == TYPE_UNKNOWN:
                        rt = self.infer_node(rec_node2, TYPE_UNKNOWN)
                    let mret = self.method_ret_type(self.tree.nodes.data[callee].payload, rt)
                    if mret != TYPE_UNKNOWN and mret != 0 as u32 and (mret as i64) < self.types.entries.len:
                        let mk = self.types.entries.data[mret].kind
                        // RFC 0020 P3: `str`/`bytes` are 16-byte {ptr,len} PRIMITIVE
                        // aggregates â€” a str-returning UFCS method (`s.trim()`,
                        // `s.to_upper()`, ...) needs its return type recovered too, else
                        // the `let t = s.trim()` copy defaults to 8 bytes and drops half
                        // the {ptr,len} pair -> corrupt str/segfault (same failure the
                        // aggregate-return recovery guards against for structs).
                        if mk == TYPE_KIND_STRUCT or mk == TYPE_KIND_SUM or mk == TYPE_KIND_GENERIC_INST or mk == TYPE_KIND_OPTION or mk == TYPE_KIND_RESULT or mret == TYPE_STRING or mret == TYPE_BYTES:
                            result_type = mret

            // BUG#61: a GENERIC function call whose instantiated callee symbol's FUNC
            // signature was not yet inferred when infer_node(callee) ran leaves the
            // call UNTYPED. A later `result.method()` then has an UNKNOWN receiver
            // type, cannot resolve the method, and air_builder falls back to field-
            // access-as-call â†’ segfault (e.g. Vec[T].get(i).unwrap()). Recover the
            // return type from the callee symbol's (freshly inferred) signature.
            // Restricted to STRUCTURED returns â€” the only case that is broken; scalar/
            // void calls already work untyped â€” to keep the blast radius minimal
            // (mirrors the BUG#45 method recovery above).
            // Covers both a generic FUNCTION (NODE_IDENT callee) and a generic METHOD
            // (NODE_FIELD_EXPR callee) â€” instantiation stamps callee.payload with the
            // monomorphised function/method symbol in both cases, so e.g.
            // Vec[T].get(i) (a generic method returning Option[T]) is recovered too.
            if result_type == TYPE_UNKNOWN and (self.tree.nodes.data[callee].kind == NODE_IDENT or self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR):
                let csym = self.tree.nodes.data[callee].payload
                if csym != 0 as u32 and (csym as i64) < self.symtable.symbols.len:
                    mut cft = self.symtable.symbols.data[csym].type_id
                    if cft == TYPE_UNKNOWN:
                        let cdecl = self.symtable.symbols.data[csym].decl_node
                        if cdecl != 0 as u32 and cdecl != 0xffffffff as u32:
                            self.pre_infer_func_signature(cdecl)
                            cft = self.symtable.symbols.data[csym].type_id
                    if cft != TYPE_UNKNOWN and (cft as i64) < self.types.entries.len:
                        let ce = self.types.entries.data[cft]
                        if ce.kind == TYPE_KIND_FUNC:
                            let fret = self.types.funcs.data[ce.extra].ret
                            if fret != TYPE_UNKNOWN and fret != 0 as u32 and (fret as i64) < self.types.entries.len:
                                let fk = self.types.entries.data[fret].kind
                                if fk == TYPE_KIND_STRUCT or fk == TYPE_KIND_SUM or fk == TYPE_KIND_GENERIC_INST or fk == TYPE_KIND_OPTION or fk == TYPE_KIND_RESULT:
                                    result_type = fret

            // Diagnostic (was silent accept-then-miscompile, same class as BUG#53/68/
            // 81/93): `recv.name(...)` where `name` names NO callable at all â€” neither
            // a data field, an interface method, a real method, nor a free function
            // usable via UFCS (`fn name(self: T, ...)`). infer_node(callee) could not
            // resolve the field name, so `callee_type == TYPE_UNKNOWN` (distinct from
            // the "field, not a function" case above, where the name resolved to a
            // field and callee_type is known) and the method flag 2048 is unset
            // (resolved methods set it at ~3455, generic methods at ~2800). All
            // recovery blocks above left result_type UNKNOWN. Previously air_builder's
            // lower_call_expr, finding no method/UFCS match (loop ~1565), fell through
            // to `lower_expr(callee)` -> `getfld` of a non-existent field (garbage
            // register) -> INDIRECT `call reg` -> SIGSEGV, with no compile-time signal.
            //
            // SAFETY (self-host fixpoint): the receiver's concrete type is NOT reliably
            // resolved at inference time â€” a cross-module param type (`in_file: File`
            // from std.io) can still read as a placeholder here, so a receiver-type-
            // matched lookup (method_ret_type) would FALSE-POSITIVE on valid UFCS calls
            // like `in_file.read(...)`. Instead use a RECEIVER-AGNOSTIC test: reject
            // only when NO SYM_FUNC anywhere matches `name` as a method name. If any
            // same-named function exists, defer to normal method/UFCS resolution (which
            // completes with full type info in air_builder) â€” conservative, never
            // breaks a real call. `p.ghost()` (no `ghost` fn anywhere) is rejected;
            // `in_file.read()` (a `read` fn exists) is left alone. Also gated:
            //   - callee_type == UNKNOWN  => excludes field-not-fn + every FUNC/STRUCT/
            //     SUM/constructor call (those have a known callee_type).
            //   - flag 2048 unset         => excludes every RESOLVED method.
            //   - receiver known & not INTERFACE => excludes BUG#93 module-qualified
            //     chains (receiver UNKNOWN) and interface dispatch (own diagnostic).
            if result_type == TYPE_UNKNOWN and callee_type == TYPE_UNKNOWN and self.tree.nodes.data[callee].kind == NODE_FIELD_EXPR and (self.tree.nodes.data[callee].flags & 2048 as u16) == 0 as u16:
                let recv_n = self.tree.nodes.data[callee].first_child
                if recv_n != 0 as u32:
                    mut recv_t := TYPE_UNKNOWN
                    if (recv_n as i64) < self.node_types_cap:
                        recv_t = self.node_types[recv_n as i64]
                    if recv_t == TYPE_UNKNOWN:
                        recv_t = self.infer_node(recv_n, TYPE_UNKNOWN)
                    if recv_t != TYPE_UNKNOWN and (recv_t as i64) < self.types.entries.len:
                        mut ruw := recv_t
                        mut rue3 := self.types.entries.data[ruw as i64]
                        while rue3.kind == TYPE_KIND_POINTER or rue3.kind == TYPE_KIND_REF:
                            ruw = rue3.extra as u32
                            rue3 = self.types.entries.data[ruw as i64]
                        if rue3.kind != TYPE_KIND_INTERFACE:
                            let mname = self.intern.get(self.tree.nodes.data[callee].payload)
                            // Receiver-agnostic: is there ANY function named `mname`
                            // (as a method name)? If so, a real UFCS/method call may
                            // resolve later â€” do NOT reject.
                            mut name_exists := false
                            if rue3.kind == TYPE_KIND_PRIMITIVE:
                                // RFC 0020 P3 (+ numeric UFCS): a PRIMITIVE receiver â€” `str`/
                                // `bytes` OR a scalar numeric (`i64`, `f64`, ...) â€” has NO user
                                // methods; UFCS resolves ONLY to a free fn whose first param IS
                                // that primitive. Use a RECEIVER-SPECIFIC test (not the global
                                // name scan) so `s.push(x)` (push exists for Vec, not str) and
                                // `n.trim()` (trim exists for str, not i64) are rejected cleanly
                                // here instead of reaching air_builder's dispatch loop (which
                                // finds no first-param match, returns 0) and miscompiling via
                                // getfld + indirect call (BUG#53 class).
                                if self.method_ret_type(self.tree.nodes.data[callee].payload, ruw) != 0 as u32:
                                    name_exists = true
                            else:
                                // BUG#93(b): for a RELIABLY-NAMED concrete aggregate
                                // receiver (struct/sum/generic-inst with a real name,
                                // NOT Option/Result), be self-type-aware: only a method
                                // whose self base-type matches the receiver counts.
                                // Otherwise a method existing solely on a DIFFERENT type
                                // (`contains` on HashSet, absent on HashMap) passed the
                                // global name scan â†’ no reject â†’ getfld + call*garbage
                                // SIGSEGV. Option/Result stay on the agnostic scan: their
                                // unwrap/is_some/... are backend-intercepted with no self-
                                // typed free fn, so a self-aware scan would false-reject.
                                // The Option/Result methods are backend-intercepted
                                // (bug90) and can appear on a receiver typed as the
                                // PAYLOAD (e.g. `tok.unwrap()` where tok infers to Token,
                                // not Option[Token]) with no self-typed `unwrap` free fn â€”
                                // keep them on the agnostic scan or self-host false-rejects.
                                let is_opt_res_m = (mname == "unwrap" or mname == "unwrap_err" or mname == "is_some" or mname == "is_none" or mname == "is_ok" or mname == "is_err")
                                // A receiver DIRECTLY typed Option/Result (kind 11/12)
                                // calling one of these backend-intercepted methods is always
                                // valid: air_builder lowers is_some/unwrap/... locally with no
                                // free-fn symbol, so the name scan below finds nothing and
                                // false-rejects (e.g. `arr[i].is_some()` on `[Option;N]`, where
                                // arr[i] types to a real OPTION). Accept unconditionally.
                                if is_opt_res_m and (rue3.kind == TYPE_KIND_OPTION or rue3.kind == TYPE_KIND_RESULT):
                                    name_exists = true
                                mut self_aware := false
                                mut rec_base := "" as str
                                if (rue3.kind == TYPE_KIND_STRUCT or rue3.kind == TYPE_KIND_SUM or rue3.kind == TYPE_KIND_GENERIC_INST) and not is_opt_res_m:
                                    if rue3.name_id != 0 as u32:
                                        let rmangled = self.intern.get(rue3.name_id)
                                        rec_base = extract_base_name(rmangled)
                                        safe_free_str(rmangled)
                                        if not (rec_base == "Option" or rec_base == "Result"):
                                            self_aware = true
                                if self_aware:
                                    if self.has_method_for_base(mname, rec_base):
                                        name_exists = true
                                else:
                                    mut si := 0 as i64
                                    while si < self.symtable.symbols.len:
                                        let ssym = self.symtable.symbols.data[si]
                                        if ssym.kind == SYM_FUNC and self.intern.name_matches_method(ssym.name_id, mname):
                                            name_exists = true
                                            break
                                        si = si + 1 as i64
                                if rue3.name_id != 0 as u32 and not is_opt_res_m and (rue3.kind == TYPE_KIND_STRUCT or rue3.kind == TYPE_KIND_SUM or rue3.kind == TYPE_KIND_GENERIC_INST):
                                    safe_free_str(rec_base)
                            if not name_exists:
                                // A builtin PRIMITIVE receiver (str/bytes/int/...) has an
                                // empty type name_id, so print a type-less variant rather
                                // than a stray `on type ''` (e.g. `s.bytes()` on a str).
                                let tname = self.intern.get(rue3.name_id)
                                if std.string.len(tname) == 0 as i64:
                                    ax_printf_local("error: no method '%s' on this value\n", get_str_ptr(mname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                else:
                                    ax_printf_local("error: no method '%s' on type '%s'\n", get_str_ptr(mname) as i64, get_str_ptr(tname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                safe_free_str(tname)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(mname)

            // Infer arguments. For a fixed-array PARAMETER of a plain free function, pass
            // the param type as the arg's expected type so a direct `[..]` literal coerces
            // to the declared element type (a bare-int literal otherwise defaults to
            // [i32;N] and mismatches an [i64;N] param). If the arg is STILL a different
            // fixed-array type (e.g. a variable `let x = [1,2,3]` => [i32;3] passed to an
            // [i64;3] param), that is a genuine element/length mismatch that would silently
            // miscompile the callee's OP_INDEX stride -> reject cleanly (BUG#53 convention).
            // Gated to NODE_IDENT, non-generic callees (free functions have no `self`
            // param and concrete param types), so method/generic arg positions are never
            // misaligned; scoped to array<->array so all other args are untouched. Since no
            // bundled code uses fixed-array params, the self-host fixpoint is unaffected.
            // Struct-constructor ARRAY-field coercion: for `S(f: [<int literals>])`, infer
            // the field value with the field's DECLARED array type as the expected type so
            // the inline literal coerces to the field's element type. Otherwise a bare-int
            // literal defaults to [i32;N] and the element `store`s use the i32 stride (4)
            // into an [i64;N] field slot (8) -> the field's memory layout is corrupted
            // (silent miscompile). try_instantiate_struct_ctor already coerces GENERIC-struct
            // field values; NON-generic ctors early-return there, so cover them here via the
            // same fields<->args lockstep walk. Scoped to ARRAY fields only (scalar/ptr/
            // struct field values keep their prior UNKNOWN inference, so an int literal in a
            // scalar field is NOT silently retyped -> self-host fixpoint unaffected).
            mut did_ctor_args := false
            // For a GENERIC ctor, `callee_type` is the TEMPLATE, whose fields are typed by the
            // still-unbound params â€” no usable expected type. The monomorphized instance in
            // `result_type` carries the concrete field types, so prefer it. This also covers the
            // explicit-type-argument spelling `Box[[i64;2]](v: ..)`, whose callee is an
            // INDEX_EXPR rather than a bare ident; without it the array literal stayed `[i32;N]`
            // and stored 4-byte elements into 8-byte slots.
            mut ctor_sty := callee_type
            if callee_type != TYPE_UNKNOWN and (callee_type as i64) < self.types.entries.len:
                if self.types.entries.data[callee_type as i64].kind == TYPE_KIND_STRUCT and (result_type as i64) < self.types.entries.len:
                    if self.types.entries.data[result_type as i64].kind == TYPE_KIND_STRUCT:
                        ctor_sty = result_type
            let ctor_callee_kind = self.tree.nodes.data[callee].kind
            if (ctor_callee_kind == NODE_IDENT or ctor_callee_kind == NODE_INDEX_EXPR) and ctor_sty != TYPE_UNKNOWN and (ctor_sty as i64) < self.types.entries.len:
                let se = self.types.entries.data[ctor_sty as i64]
                if se.kind == TYPE_KIND_STRUCT and (se.extra as i64) < self.types.structs.len:
                    // Struct's RESOLVED field types (StructInfo, tree-independent). Named
                    // args are assigned POSITIONALLY by the backend (see BUG#21), so arg N
                    // pairs with field N; match by position here to stay consistent.
                    let si = self.types.structs.data[se.extra as i64]
                    did_ctor_args = true
                    mut carg := self.tree.nodes.data[callee].next_sibling
                    mut fpos := 0 as i64
                    while carg != 0 as u32:
                        mut vnode := carg
                        if self.tree.nodes.data[carg as i64].kind == NODE_NAMED_ARG:
                            vnode = self.tree.nodes.data[carg as i64].first_child
                        mut vexp := TYPE_UNKNOWN
                        if fpos < si.fields.len:
                            let fty = si.fields.data[fpos].type_id
                            if fty != TYPE_UNKNOWN and (fty as i64) < self.types.entries.len:
                                let fk = self.types.entries.data[fty as i64].kind
                                if fk == TYPE_KIND_ARRAY:
                                    vexp = fty
                                elif fty == TYPE_F32:
                                    // An f32 scalar field: pass f32 as expected so a float
                                    // literal (`P(x: 40.0)`) is typed f32 and materialized as
                                    // single (movd, 4B) instead of a DOUBLE (8B) that overflows
                                    // the 4-byte field slot / reads back wrong via single-
                                    // precision loads -> 0 (silent miscompile, same class as the
                                    // f32-boundary literal bug). Scoped to F32 only, so int/i64
                                    // scalar fields keep their prior UNKNOWN inference and the
                                    // self-host fixpoint is unaffected. [[bug-f32-boundary-abi-open]]
                                    vexp = fty
                                elif fk == TYPE_KIND_STRUCT:
                                    // RFC 0022: a TUPLE-typed field â€” pass its declared type so a
                                    // `(a, b)` literal coerces its elements to the field's element
                                    // types. Without this the literal defaults to {i32,i32} (8B) and
                                    // is stored into an {i64,i64} (16B) field slot, so the second
                                    // element reads garbage. Guarded to `__tup` structs (never a
                                    // named struct field, whose value is a distinct constructor).
                                    let fnm = self.intern.get(self.types.entries.data[fty as i64].name_id)
                                    if std.string.starts_with(fnm, "__tup"):
                                        vexp = fty
                                    safe_free_str(fnm)
                                elif fk == TYPE_KIND_OPTION or fk == TYPE_KIND_RESULT or fk == TYPE_KIND_GENERIC_INST or fk == TYPE_KIND_SUM:
                                    // RFC 0022 follow-up: a field typed Option/Result/sum whose
                                    // value is an unannotated variant ctor carrying an aggregate
                                    // literal (`Box(v: Some((3,4)))`, field v: Option[(i64,i64)]).
                                    // Pass the field type as expected so try_instantiate_variant_call
                                    // threads the concrete payload type down to the tuple/struct
                                    // literal, coercing it to the field's element widths instead of
                                    // defaulting to {i32,i32} (8B) stored into a 16B slot (silent
                                    // field-1=0 miscompile). Harmless when the value is already
                                    // concrete or None (infer_node ignores an unused expected).
                                    vexp = fty
                        if vnode != 0 as u32:
                            self.infer_node(vnode, vexp)
                        carg = self.tree.nodes.data[carg as i64].next_sibling
                        fpos = fpos + 1 as i64
            // Infer arguments. For a fixed-array PARAMETER of a plain free function, pass
            // the param type as the arg's expected type so a direct `[..]` literal coerces
            // to the declared element type (a bare-int literal otherwise defaults to
            // [i32;N] and mismatches an [i64;N] param). If the arg is STILL a different
            // fixed-array type (e.g. a variable `let x = [1,2,3]` => [i32;3] passed to an
            // [i64;3] param), that is a genuine element/length mismatch that would silently
            // miscompile the callee's OP_INDEX stride -> reject cleanly (BUG#53 convention).
            // Gated to NODE_IDENT, non-generic callees (free functions have no `self`
            // param and concrete param types), so method/generic arg positions are never
            // misaligned; scoped to array<->array so all other args are untouched. Since no
            // bundled code uses fixed-array params, the self-host fixpoint is unaffected.
            mut fp_data := null as ptr[u32]
            mut fp_len := 0 as i64
            if not did_ctor_args and not is_generic_call and self.tree.nodes.data[callee].kind == NODE_IDENT and callee_type != TYPE_UNKNOWN and (callee_type as i64) < self.types.entries.len:
                let ce = self.types.entries.data[callee_type as i64]
                if ce.kind == TYPE_KIND_FUNC and (ce.extra as i64) < self.types.funcs.len:
                    let fi2 = self.types.funcs.data[ce.extra as i64]
                    fp_data = fi2.params.data
                    fp_len = fi2.params.len
            if not did_ctor_args:
                mut arg := self.tree.nodes.data[callee].next_sibling
                mut apos := 0 as i64
                while arg != 0 as u32:
                    mut pexp := TYPE_UNKNOWN
                    mut param_is_arr := false
                    mut param_is_tup := false
                    mut param_is_optlike := false
                    if fp_data != null as ptr[u32] and apos < fp_len:
                        let cand = fp_data[apos]
                        if cand != TYPE_UNKNOWN and (cand as i64) < self.types.entries.len:
                            let ck = self.types.entries.data[cand as i64].kind
                            if ck == TYPE_KIND_ARRAY:
                                pexp = cand
                                param_is_arr = true
                            elif cand == TYPE_F32:
                                // An f32 scalar param: pass f32 as expected so a float
                                // literal arg (`takef(40.0)`) is typed f32 and materialized
                                // as single instead of a DOUBLE -> read back wrong at the
                                // f32 param slot -> 0 (same class as the f32-boundary literal
                                // bug). Scoped to F32, so int scalar params keep prior UNKNOWN
                                // inference; fixpoint-safe. [[bug-f32-boundary-abi-open]]
                                pexp = cand
                            elif ck == TYPE_KIND_STRUCT:
                                // RFC 0022 P2: a tuple param â€” pass its type so a direct
                                // `(a, b)` literal arg coerces its elements to the param's
                                // field types (else int-literal elements default to i32 and
                                // an {i32,i32} value is stored into an {i64,i64} slot).
                                let cnm = self.intern.get(self.types.entries.data[cand as i64].name_id)
                                if std.string.starts_with(cnm, "__tup"):
                                    pexp = cand
                                    param_is_tup = true
                                safe_free_str(cnm)
                            elif ck == TYPE_KIND_OPTION or ck == TYPE_KIND_RESULT or ck == TYPE_KIND_GENERIC_INST or ck == TYPE_KIND_SUM:
                                // A param typed Option/Result/sum: pass its type so an INLINE
                                // variant-ctor arg carrying an aggregate literal
                                // (`use_it(Some((3,4)))`, param o: Option[(i64,i64)]) coerces its
                                // inner tuple to the param's payload widths via try_instantiate_
                                // variant_call, instead of defaulting to {i32,i32} (8B) stored
                                // into a 16B payload slot (silent field-1=0). Harmless when the
                                // arg is already concrete or None. `param_is_optlike` also drives
                                // the width-mismatch reject below for an already-built value arg.
                                pexp = cand
                                param_is_optlike = true
                    // Capture the arg's DECLARED type BEFORE inference. `infer_node` with an
                    // `expected` hint reports the EXPECTED type for a bare ident, which would
                    // mask exactly the width mismatch the Option/Result reject below looks for
                    // (the local's storage was already built at its own width â€” the hint does
                    // not rebuild it). The symbol's own type_id is the ground truth.
                    mut arg_decl_t := TYPE_UNKNOWN
                    if param_is_optlike and self.tree.nodes.data[arg].kind == NODE_IDENT:
                        let asym = self.tree.nodes.data[arg].payload
                        if asym != 0 as u32 and (asym as i64) < self.symtable.symbols.len:
                            arg_decl_t = self.symtable.symbols.data[asym].type_id
                    let at = self.infer_node(arg, pexp)
                    if param_is_arr and at != pexp and at != TYPE_UNKNOWN and (at as i64) < self.types.entries.len and self.types.entries.data[at as i64].kind == TYPE_KIND_ARRAY:
                        ax_printf_local("error: array argument type mismatch: this argument is a different fixed-array type than the parameter (different element type or length); annotate the local `let x: [T;N] = ..` or cast the elements to match\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64
                    // RFC 0022 P2 (BUG#53 convention): a tuple ARG whose type still differs
                    // from the tuple PARAM after coercion (e.g. an unannotated `let t=(10,15)`
                    // is {i32,i32} passed to an {i64,i64} param) would silently store the wrong
                    // width -> reject with an actionable message instead of miscompiling.
                    if param_is_tup and at != pexp and at != TYPE_UNKNOWN and (at as i64) < self.types.entries.len and self.types.entries.data[at as i64].kind == TYPE_KIND_STRUCT:
                        let atnm = self.intern.get(self.types.entries.data[at as i64].name_id)
                        let at_is_tup = std.string.starts_with(atnm, "__tup")
                        safe_free_str(atnm)
                        if at_is_tup:
                            ax_printf_local("error: tuple argument type mismatch: this argument's element types differ from the parameter's; annotate the local `let x: (T0, T1) = ..` or pass the tuple literal directly so its elements coerce\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            self.diags_count = self.diags_count + 1 as i64
                    // BUG#53 convention: the Option/Result analogue of the tuple reject above.
                    // The `pexp` threading further up coerces an INLINE ctor arg
                    // (`take(Some((3,40)))`), but it cannot help when the arg is a VARIABLE
                    // already built at the wrong width â€” `let x = Some((3,40))` builds an
                    // {i32,i32} 8-byte payload (tuple int-literals default to i32), and passing
                    // `x` to a `o: Option[(i64,i64)]` param stored 8 bytes into a 16-byte payload
                    // slot, so the callee read field 1 as 0 (returned 3, not 43). Threading an
                    // expected type does not REBUILD an ident's value, so a coercion is
                    // impossible here and a diagnostic is the correct outcome.
                    //
                    // Compare PAYLOAD SIZE, never type_id: the same Option[i64] carries many
                    // distinct type_ids, so an id-inequality test over-rejects (the reason this
                    // reject was deferred when first attempted). A zero from
                    // optlike_payload_size means "not judgeable" (non-Option/Result, or a
                    // generic payload) and never rejects. The whole block is already gated to a
                    // non-generic NODE_IDENT free-function callee with concrete param types.
                    if param_is_optlike and arg_decl_t != TYPE_UNKNOWN and arg_decl_t != pexp:
                        let p_psz = self.optlike_payload_size(pexp)
                        let a_psz = self.optlike_payload_size(arg_decl_t)
                        // Reject only across the BY-ADDRESS boundary (one payload fits in 8
                        // bytes, the other does not). That is precisely the failure mode: an
                        // 8-byte payload written into a 16-byte slot leaves field 1 reading 0.
                        // Two payloads that are both <=8 (say i32 vs i64) are widened correctly
                        // by the ordinary scalar paths, so rejecting those would only turn
                        // working programs into errors.
                        let crosses_boundary = (p_psz > 8 as u32 and a_psz <= 8 as u32) or (a_psz > 8 as u32 and p_psz <= 8 as u32)
                        if p_psz != 0 as u32 and a_psz != 0 as u32 and crosses_boundary:
                            ax_printf_local("error: Option/Result argument payload width mismatch: this argument's payload is a different size than the parameter's; annotate the local `let x: Option[(T0, T1)] = ..` or pass the constructor directly so its payload coerces\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            self.diags_count = self.diags_count + 1 as i64
                    arg = self.tree.nodes.data[arg].next_sibling
                    apos = apos + 1 as i64
                
    elif kind == NODE_IDENT:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        let is_substituted := ((self.tree.nodes.data[node_idx].flags & FLAG_IS_SUBSTITUTED) != 0 as u16)
        mut is_sym := false
        if not is_substituted:
            is_sym = (sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len)
        if is_sym:
            result_type = self.symtable.symbols.data[sym_idx].type_id
        if result_type == TYPE_UNKNOWN:
            mut text := ""
            if is_substituted:
                if sym_idx != 0 as u32:
                    let cand_text = self.intern.get(sym_idx)
                    if (cand_text == "i8" or cand_text == "i16" or cand_text == "i32" or cand_text == "int" or
                        cand_text == "i64" or cand_text == "u8" or cand_text == "u16" or cand_text == "u32" or cand_text == "rune" or
                        cand_text == "u64" or cand_text == "f32" or cand_text == "f64" or cand_text == "bool" or
                        cand_text == "str" or cand_text == "string" or cand_text == "bytes" or cand_text == "char" or cand_text == "void" or
                        cand_text == "isize" or cand_text == "usize"):
                        text = cand_text
                    else:
                        mut resolved_type_id := 0 as u32
                        mut resolved_sym := self.symtable.resolve(sym_idx)
                        if resolved_sym == 0 as u32:
                            resolved_sym = self.symtable.resolve_global_fallback(sym_idx)
                        if resolved_sym != 0 as u32 and (resolved_sym as i64) < self.symtable.symbols.len:
                            mut sym := self.symtable.symbols.data[resolved_sym]
                            if sym.kind == SYM_GENERIC_PARAM:
                                if sym.type_id == 0 as u32:
                                    let gen_type = self.types.register_generic(sym.name_id)
                                    self.symtable.symbols.data[resolved_sym].type_id = gen_type
                                    sym.type_id = gen_type
                            if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
                                sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
                                sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
                                resolved_type_id = sym.type_id
                                if resolved_type_id == 0 as u32:
                                    let full_name = self.get_full_mangled_name(resolved_sym)
                                    resolved_type_id = self.parse_type_from_name(full_name)
                                    safe_free_str(full_name)
                        if resolved_type_id == 0 as u32:
                            resolved_type_id = self.parse_type_from_name(cand_text)
                        result_type = resolved_type_id
                        safe_free_str(cand_text)
            else:
                text = self.node_text(node_idx)
            if text == "i8":
                result_type = 1 as u32
            elif text == "i16":
                result_type = 2 as u32
            elif text == "i32" or text == "int":
                result_type = 3 as u32
            elif text == "i64":
                result_type = 4 as u32
            elif text == "u8":
                result_type = 5 as u32
            elif text == "u16":
                result_type = 6 as u32
            elif text == "u32" or text == "rune":
                result_type = 7 as u32
            elif text == "u64":
                result_type = 8 as u32
            elif text == "f32":
                result_type = 9 as u32
            elif text == "f64":
                result_type = 10 as u32
            elif text == "bool":
                result_type = 11 as u32
            elif text == "str" or text == "string":
                result_type = 12 as u32
            elif text == "bytes":
                result_type = 22 as u32
            elif text == "char":
                result_type = 13 as u32
            elif text == "void":
                result_type = 14 as u32
            elif text == "isize":
                result_type = 15 as u32
            elif text == "usize":
                result_type = 16 as u32
            safe_free_str(text)
        // Fallback for a substituted tuple type param (see NODE_TYPE_EXPR below):
        // `__tupN` has no resolvable symbol; recover the type_id the monomorphizer
        // stashed in extra_idx.
        if result_type == TYPE_UNKNOWN and is_substituted:
            let sub_tid = self.tree.nodes.data[node_idx].extra_idx
            if sub_tid != 0 as u32:
                result_type = sub_tid as u32

        // BUG#53: a bare value-position identifier the resolver could NOT bind (it
        // forced payload to 0) and that did not recover as a builtin type name is an
        // UNDEFINED name. Previously its raw name_id was left as payload, accidentally
        // indexing an unrelated symbol -> silent garbage/0 at runtime. Reject cleanly
        // (bumps diags_count; the driver halts before codegen). Gated on payload==0
        // (only the resolver's unresolved path produces this) AND result_type still
        // UNKNOWN AND not substituted -- a type name used as a value already set
        // result_type above, so it is never hit here. Self-build safe: the compiler's
        // own source has zero unresolved bare idents. See [[bug-undefined-name-accept]].
        if result_type == TYPE_UNKNOWN and not is_substituted and self.tree.nodes.data[node_idx].payload == 0 as u32:
            let uname = self.node_text(node_idx)
            if uname != "":
                ax_printf_local("error: undefined name '%s'\n", get_str_ptr(uname) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.diags_count = self.diags_count + 1 as i64
            safe_free_str(uname)

    elif kind == NODE_TYPE_EXPR:
        let sym_idx = self.tree.nodes.data[node_idx].payload
        let is_substituted := ((self.tree.nodes.data[node_idx].flags & FLAG_IS_SUBSTITUTED) != 0 as u16)
        mut is_sym := false
        if not is_substituted:
            is_sym = (sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len)
        if is_sym:
            mut sym := self.symtable.symbols.data[sym_idx]
            if sym.kind == SYM_GENERIC_PARAM:
                if sym.type_id == 0 as u32:
                    let gen_type = self.types.register_generic(sym.name_id)
                    self.symtable.symbols.data[sym_idx].type_id = gen_type
                    sym.type_id = gen_type
            if sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE:
                result_type = sym.type_id
            
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let inner = self.infer_node(child, TYPE_UNKNOWN)
            if result_type == TYPE_UNKNOWN:
                result_type = inner
                 
        if result_type == TYPE_UNKNOWN:
            mut text := ""
            if sym_idx != 0 as u32 and sym_idx <= self.intern.state.count as u32:
                let cand_text = self.intern.get(sym_idx)
                if (cand_text == "i8" or cand_text == "i16" or cand_text == "i32" or cand_text == "int" or
                    cand_text == "i64" or cand_text == "u8" or cand_text == "u16" or cand_text == "u32" or
                    cand_text == "u64" or cand_text == "f32" or cand_text == "f64" or cand_text == "bool" or
                    cand_text == "str" or cand_text == "string" or cand_text == "char" or cand_text == "void" or
                    cand_text == "isize" or cand_text == "usize"):
                    text = cand_text
                else:
                    mut resolved_sym := self.symtable.resolve(sym_idx)
                    if resolved_sym == 0 as u32:
                        resolved_sym = self.symtable.resolve_global_fallback(sym_idx)
                    if resolved_sym != 0 as u32 and (resolved_sym as i64) < self.symtable.symbols.len:
                        mut sym := self.symtable.symbols.data[resolved_sym]
                        if sym.kind == SYM_GENERIC_PARAM:
                            if sym.type_id == 0 as u32:
                                let gen_type = self.types.register_generic(sym.name_id)
                                self.symtable.symbols.data[resolved_sym].type_id = gen_type
                                sym.type_id = gen_type
                        if (sym.kind == SYM_STRUCT or sym.kind == SYM_INTERFACE or
                            sym.kind == SYM_TYPE_ALIAS or sym.kind == SYM_VARIANT or
                            sym.kind == SYM_GENERIC_PARAM or sym.kind == SYM_BUILTIN_TYPE):
                            result_type = sym.type_id
                            if result_type == 0 as u32:
                                let full_name = self.get_full_mangled_name(resolved_sym)
                                result_type = self.parse_type_from_name(full_name)
                                safe_free_str(full_name)
                    safe_free_str(cand_text)
            
            if result_type == TYPE_UNKNOWN and text == "":
                if is_sym:
                    text = self.intern.get(self.symtable.symbols.data[sym_idx].name_id)
                else:
                    text = self.node_text(node_idx)
            if text == "i8":
                result_type = 1 as u32
            elif text == "i16":
                result_type = 2 as u32
            elif text == "i32" or text == "int":
                result_type = 3 as u32
            elif text == "i64":
                result_type = 4 as u32
            elif text == "u8":
                result_type = 5 as u32
            elif text == "u16":
                result_type = 6 as u32
            elif text == "u32" or text == "rune":
                result_type = 7 as u32
            elif text == "u64":
                result_type = 8 as u32
            elif text == "f32":
                result_type = 9 as u32
            elif text == "f64":
                result_type = 10 as u32
            elif text == "bool":
                result_type = 11 as u32
            elif text == "str" or text == "string":
                result_type = 12 as u32
            elif text == "bytes":
                result_type = 22 as u32
            elif text == "char":
                result_type = 13 as u32
            elif text == "void":
                result_type = 14 as u32
            elif text == "isize":
                result_type = 15 as u32
            elif text == "usize":
                result_type = 16 as u32
            safe_free_str(text)
        // Fallback for a substituted tuple type param: `__tupN` has no resolvable
        // symbol, so the name-based resolution above yields UNKNOWN. The monomorphizer
        // stashed the exact concrete type_id in extra_idx â€” recover it directly.
        if result_type == TYPE_UNKNOWN and is_substituted:
            let sub_tid = self.tree.nodes.data[node_idx].extra_idx
            if sub_tid != 0 as u32:
                result_type = sub_tid as u32

    elif kind == NODE_GENERIC_TYPE:
        let base_idx = self.tree.nodes.data[node_idx].first_child
        if base_idx != 0 as u32:
            let base_node = self.tree.nodes.data[base_idx]
            let base_name = self.node_text(base_idx)
            let name_id = self.intern.intern(base_name)
            safe_free_str(base_name)
            // Check if name is ptr
            let text = self.intern.get(name_id)
            let ptr_text = text as ptr[u8]
            mut is_ptr := false
            mut is_slice := false
            if std.string.len(text) == 3 as i64 and ptr_text[0] == 'p' as u8 and ptr_text[1] == 't' as u8 and ptr_text[2] == 'r' as u8:
                is_ptr = true
            elif std.string.len(text) == 5 as i64 and ptr_text[0] == 's' as u8 and ptr_text[1] == 'l' as u8 and ptr_text[2] == 'i' as u8 and ptr_text[3] == 'c' as u8 and ptr_text[4] == 'e' as u8:
                is_slice = true

            if is_ptr:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    let inner = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    result_type = self.types.register_pointer(inner)
            elif is_slice:
                let arg_idx = base_node.next_sibling
                if arg_idx != 0 as u32:
                    let inner = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    result_type = self.types.register_slice(inner)
            else:
                // User-defined generic template (like Array or Map)
                let sym_idx = base_node.payload
                if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                    let sym = self.symtable.symbols.data[sym_idx as i64]
                    mut src_tree := self.tree
                    if (sym_idx as i64) < self.symtable.symbol_trees.len:
                        let t = self.symtable.symbol_trees.data[sym_idx]
                        if t != null as ptr[AstTree]:
                            src_tree = t
                    if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16):
                        // Collect concrete type arguments
                        mut args := new_u32_vec()
                        mut arg_idx := base_node.next_sibling
                        while arg_idx != 0 as u32:
                            let arg_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                            args.push(arg_type)
                            arg_idx = self.tree.nodes.data[arg_idx].next_sibling

                        result_type = self.finish_generic_instantiation(sym_idx, args)
    elif kind == NODE_UNARY_EXPR:
        let operand = self.tree.nodes.data[node_idx].first_child
        if operand != 0 as u32:
            let operand_type = self.infer_node(operand, expected)
            let op = self.node_text(node_idx)
            if op == "&":
                result_type = self.types.register_pointer(operand_type)
            elif op == "not" or op == "!":
                result_type = TYPE_BOOL
            else:
                result_type = operand_type

    elif kind == NODE_DEREF_EXPR:
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let child_type = self.infer_node(child, TYPE_UNKNOWN)
            if child_type != TYPE_UNKNOWN:
                let entry = self.types.entries.data[child_type]
                if entry.kind == TYPE_KIND_POINTER:
                    result_type = entry.extra
                else:
                    result_type = child_type

    elif kind == NODE_INT_LIT:
        if expected == TYPE_I8 or expected == TYPE_I16 or expected == TYPE_I32 or expected == TYPE_I64 or expected == TYPE_U8 or expected == TYPE_U16 or expected == TYPE_U32 or expected == TYPE_U64 or expected == TYPE_F32 or expected == TYPE_F64 or expected == TYPE_ISIZE or expected == TYPE_USIZE:
            result_type = expected
        else:
            // An un-hinted integer literal defaults to i32, but ONLY if it actually fits in
            // one. Defaulting a larger value to i32 assigns it a type that cannot represent
            // it, and that lie is not harmless: emit_wrap_to_width narrows every arithmetic
            // result to its inferred width, so `-3000000000` was lowered as `neg ; shl 32 ;
            // sar 32` and silently lost every bit above 32. A bare literal hid the defect --
            // codegen materialises its full value with no arithmetic to wrap -- so it only
            // surfaced where the literal fed an operation: `if c == -3000000000` took the
            // wrong branch and `to_str(-9223372036854775808)` printed "0". Both are -O0 only,
            // because SSA constant folding at -O1+ replaces the sequence with a movabs of the
            // right value and hides it.
            //
            // Deliberately magnitude-based rather than a blanket switch to i64: every literal
            // that fits i32 keeps exactly the type it had, so this cannot perturb ordinary
            // code, overload selection, or the u64 comparison behaviour pinned by t_u64cmp.
            // The only literals that change are ones whose current type is already wrong.
            let lit_val = parse_comptime_int(self.node_text(node_idx))
            if lit_val > 2147483647 as i64 or lit_val < (0 - 2147483648) as i64:
                result_type = TYPE_I64
            else:
                result_type = TYPE_I32
            
    elif kind == NODE_FLOAT_LIT:
        // Coerce a float literal to the expected float type, mirroring the integer
        // literal path above. Without this a literal in an f32 context (`let v: f32
        // = 42.0`, an f32 param/return) stayed TYPE_F64, so air_builder materialized
        // it as a DOUBLE (OP_FCONST 64-bit, movq) â€” consistent for LOCAL use (every
        // op treated it as f64) but WRONG at a function boundary, where the f32 ABI
        // reads XMM0 as single (movss) -> the low 32 bits of the double -> garbage/0
        // (silent miscompile, BUG#53 class). Typing the literal f32 makes air narrow
        // it to single (movd, 32-bit) so the value is genuinely single-precision
        // everywhere. Only f32-expected changes; f64 keeps TYPE_F64 (fixpoint-safe â€”
        // the compiler source has no f32 literals). [[bug-f32-boundary-abi-open]]
        if expected == TYPE_F32:
            result_type = TYPE_F32
        elif expected == TYPE_UNKNOWN and (node_idx as i64) < self.node_types_cap and self.node_types[node_idx as i64] == TYPE_F32:
            // Sticky guard (mirrors the tuple coercion below): an enclosing context may
            // infer this literal TWICE â€” once with expected f32 (a generic arg re-inferred
            // to its resolved f32 param type, `Vec[f32].push(40.0)`) and again later with
            // UNKNOWN. Without this, the hint-less re-visit reverts it to f64 and air
            // materializes a DOUBLE again -> the f32 slot reads 0. Keep a prior f32 pin.
            result_type = TYPE_F32
        else:
            result_type = TYPE_F64

    elif kind == NODE_STRING_LIT:
        result_type = TYPE_STRING
        
    elif kind == NODE_BOOL_LIT:
        result_type = TYPE_BOOL
        
    elif kind == NODE_CHAR_LIT:
        result_type = TYPE_CHAR8

    elif kind == NODE_ARRAY_LIT:
        // `[e0, e1, ...]`. Element type comes from the first element (each
        // further element is inferred with that same expected-type hint, so
        // int/float literals coerce like any other typed context); falls
        // back to i32 for an empty literal, mirroring NODE_INT_LIT's default.
        mut expected_elem := TYPE_UNKNOWN
        if expected != TYPE_UNKNOWN and (expected as i64) < self.types.entries.len:
            let exp_entry = self.types.entries.data[expected as i64]
            if exp_entry.kind == TYPE_KIND_ARRAY:
                expected_elem = exp_entry.extra as u32
        // Sticky coercion â€” the array analogue of the NODE_TUPLE_EXPR guard below.
        // An enclosing context may infer this literal TWICE: once with the concrete
        // expected array type (a variant-ctor payload, `Some([3, 40, 5])` for an
        // `Option[[i64; 3]]`) and again later with UNKNOWN. On that second, hint-less
        // visit the elements re-infer as i32 and `[i32; N]` is re-registered â€” and
        // because that write lands LAST, the elements store 4 bytes wide while the
        // reader uses the declared stride, so `arr[0] + arr[1] + arr[2]` returned 8
        // instead of 48. A plain annotated `let v: [i64;3] = [..]` is visited once and
        // was never affected, which is what made this look payload-specific.
        // Recover the element hint from the type a prior visit already pinned on this
        // node, so the re-visit coerces the elements the same way instead of widening
        // the type while leaving 4-byte element stores behind.
        if expected_elem == TYPE_UNKNOWN and (node_idx as i64) < self.node_types_cap:
            let prior_arr = self.node_types[node_idx as i64]
            if prior_arr != TYPE_UNKNOWN and (prior_arr as i64) < self.types.entries.len:
                if self.types.entries.data[prior_arr as i64].kind == TYPE_KIND_ARRAY:
                    expected_elem = self.types.entries.data[prior_arr as i64].extra as u32
        mut elem_type := expected_elem
        mut count := 0 as u32
        mut mixed_strnum := false
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let ck = self.tree.nodes.data[child].kind
            let et = self.infer_node(child, elem_type)
            if elem_type == TYPE_UNKNOWN:
                elem_type = et
            else:
                // BUG#53: an array literal mixing string and numeric elements
                // (`[1, 2, "three"]`) was accepted -- a str stuffed into a numeric
                // array (or vice versa) -> garbage. Reject. Literal-gated on the
                // element's node kind (unambiguous), so real element coercions
                // (int-lit -> the array's int width, etc.) are untouched.
                // See [[bug-malformed-input-robustness-cluster]].
                let el_str = elem_type == TYPE_STRING or elem_type == TYPE_BYTES
                let el_num = elem_type >= TYPE_I8 and elem_type <= TYPE_USIZE and elem_type != TYPE_STRING and elem_type != TYPE_VOID
                let c_strlit = ck == NODE_STRING_LIT
                let c_numlit = ck == NODE_INT_LIT or ck == NODE_FLOAT_LIT
                if (el_num and c_strlit) or (el_str and c_numlit):
                    mixed_strnum = true
            count = count + 1 as u32
            child = self.tree.nodes.data[child].next_sibling
        if mixed_strnum:
            ax_printf_local("error: array literal mixes string and numeric elements\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            self.diags_count = self.diags_count + 1 as i64
        if elem_type == TYPE_UNKNOWN:
            elem_type = TYPE_I32
        result_type = self.types.register_array(elem_type, count)

    elif kind == NODE_TUPLE_EXPR:
        // RFC 0022: a tuple literal `(e0, e1, ...)` is an anonymous struct with
        // positional fields `_f0`, `_f1`, ... Lowered/typed via the struct machinery.
        //
        // Element COERCION by an expected tuple type (RFC 0022 P2): when the context
        // supplies an expected tuple type of the same arity (an annotated `let`, a
        // param, a `-> (T..)` return, a tuple global init), infer each element with the
        // matching field type as its hint and adopt that type. Without this, integer
        // literals default to i32, so `let p:(i64,i64)=(10,20)` would store an 8-byte
        // {i32,i32} into a 16-byte {i64,i64} slot and read the second field as garbage.
        let first_child = self.tree.nodes.data[node_idx].first_child
        mut used_expected := false
        // Sticky coercion: an enclosing context may infer this tuple TWICE â€” once with
        // a concrete expected `__tup` (e.g. the payload of `Some((10,20))` for an
        // `Option[(i64,i64)]` return) and again later with UNKNOWN (a generic arg-type
        // re-visit). Without this guard the second, hint-less visit re-registers the
        // default `{i32,i32}` and â€” because that write lands last â€” the element stores
        // narrow to 4 bytes and the 2nd field reads garbage. If a prior visit already
        // pinned this node to a concrete `__tup`, keep it and leave the already-coerced
        // element node-types intact.
        if expected == TYPE_UNKNOWN and (node_idx as i64) < self.node_types_cap:
            let prior = self.node_types[node_idx as i64]
            if prior != TYPE_UNKNOWN and (prior as i64) < self.types.entries.len:
                let pe = self.types.entries.data[prior as i64]
                if pe.kind == TYPE_KIND_STRUCT:
                    let pnm = self.intern.get(pe.name_id)
                    let prior_is_tup = std.string.starts_with(pnm, "__tup")
                    safe_free_str(pnm)
                    if prior_is_tup:
                        result_type = prior
                        used_expected = true
        // Element COERCION by an expected tuple type (RFC 0022 P2): when the context
        // supplies an expected tuple type of the same arity (an annotated `let`, a
        // param, a `-> (T..)` return, a tuple global init), infer each element with the
        // matching field type as its hint and adopt that type. Without this, integer
        // literals default to i32, so `let p:(i64,i64)=(10,20)` would store an 8-byte
        // {i32,i32} into a 16-byte {i64,i64} slot and read the second field as garbage.
        if not used_expected and expected != TYPE_UNKNOWN and (expected as i64) < self.types.entries.len:
            let ee = self.types.entries.data[expected as i64]
            if ee.kind == TYPE_KIND_STRUCT and (ee.extra as i64) < self.types.structs.len:
                let enm = self.intern.get(ee.name_id)
                let exp_is_tup = std.string.starts_with(enm, "__tup")
                safe_free_str(enm)
                let einfo = self.types.structs.data[ee.extra as i64]
                mut nchild := 0 as i64
                mut cc := first_child
                while cc != 0 as u32:
                    nchild = nchild + 1 as i64
                    cc = self.tree.nodes.data[cc].next_sibling
                if exp_is_tup and einfo.fields.len == nchild:
                    mut child2 := first_child
                    mut j2 := 0 as i64
                    while child2 != 0 as u32:
                        self.infer_node(child2, einfo.fields.data[j2].type_id)
                        child2 = self.tree.nodes.data[child2].next_sibling
                        j2 = j2 + 1 as i64
                    result_type = expected
                    used_expected = true
        if not used_expected:
            result_type = self.register_tuple_type(first_child)

    elif kind == NODE_NIL_LIT:
        if expected != TYPE_UNKNOWN:
            result_type = expected
        else:
            result_type = TYPE_UNKNOWN
        
    elif kind == NODE_AWAIT_EXPR:
        // RFC 0033 Â§3.2: async/await v1 (synchronous cooperative). `await e` evaluates e
        // to completion and yields its value, so its type is e's type (no Future[T]
        // wrapper in v1). Inert on the compiler self-build â€” it uses no `await`.
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            result_type = self.infer_node(child, expected)

    elif kind == NODE_CAST_EXPR:
        let expr = self.tree.nodes.data[node_idx].first_child
        mut target_type := TYPE_UNKNOWN
        if expr != 0 as u32:
            let target_node = self.tree.nodes.data[expr].next_sibling
            if target_node != 0 as u32:
                target_type = self.infer_node(target_node, TYPE_UNKNOWN)
            self.infer_node(expr, target_type)
        if target_type != TYPE_UNKNOWN:
            self.tree.nodes.data[node_idx].payload = target_type
            result_type = target_type
        else:
            result_type = self.tree.nodes.data[node_idx].payload

    elif kind == NODE_FIELD_EXPR:
        if (self.tree.nodes.data[node_idx].flags & 2048 as u16) != 0 as u16:
            let obj = self.tree.nodes.data[node_idx].first_child
            if obj != 0 as u32:
                self.infer_node(obj, TYPE_UNKNOWN)
            let sym_idx = self.tree.nodes.data[node_idx].payload
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                result_type = self.symtable.symbols.data[sym_idx].type_id
        else:
            let obj = self.tree.nodes.data[node_idx].first_child
            if obj != 0 as u32:
                let field_name_id = self.tree.nodes.data[node_idx].payload
                mut is_builtin_new := false
                if field_name_id != 0 as u32:
                    let field_name = self.intern.get(field_name_id)
                    if field_name == "new":
                        mut base_node_idx := obj
                        let base_kind = self.tree.nodes.data[obj].kind
                        if base_kind == NODE_GENERIC_TYPE or base_kind == NODE_INDEX_EXPR:
                            let first = self.tree.nodes.data[obj].first_child
                            if first != 0 as u32:
                                base_node_idx = first
                        
                        mut obj_name := ""
                        let base_node = self.tree.nodes.data[base_node_idx]
                        if base_node.kind == NODE_IDENT or base_node.kind == NODE_TYPE_EXPR:
                            let payload_val = base_node.payload
                            if payload_val != 0 as u32:
                                if (payload_val as i64) < self.symtable.symbols.len:
                                    obj_name = self.intern.get(self.symtable.symbols.data[payload_val].name_id)
                                else:
                                    obj_name = self.intern.get(payload_val)
                        else:
                            obj_name = self.node_text(base_node_idx)
                        
                        mut is_collection := false
                        if obj_name == "Vec" or std.string.ends_with(obj_name, ".Vec") or std.string.contains(obj_name, ".Vec__") or std.string.contains(obj_name, "__Vec"):
                            is_collection = true
                        elif obj_name == "HashMap" or std.string.ends_with(obj_name, ".HashMap") or std.string.contains(obj_name, ".HashMap__") or std.string.contains(obj_name, "__HashMap"):
                            is_collection = true
                        elif obj_name == "HashSet" or std.string.ends_with(obj_name, ".HashSet") or std.string.contains(obj_name, ".HashSet__") or std.string.contains(obj_name, "__HashSet"):
                            is_collection = true
                        elif obj_name == "Option" or std.string.ends_with(obj_name, ".Option") or std.string.contains(obj_name, ".Option__") or std.string.contains(obj_name, "__Option"):
                            is_collection = true
                        elif obj_name == "Result" or std.string.ends_with(obj_name, ".Result") or std.string.contains(obj_name, ".Result__") or std.string.contains(obj_name, "__Result"):
                            is_collection = true
                        
                        if is_collection:
                            is_builtin_new = true
                            let obj_type_resolved = self.infer_node(obj, TYPE_UNKNOWN)
                            let params_vec = U32Vec(data: null as ptr[u32], len: 0, cap: 0)
                            result_type = self.types.register_function(params_vec, obj_type_resolved)
                            self.set_node_type(node_idx, result_type)
                        
                        safe_free_str(obj_name)
                    safe_free_str(field_name)
                
                if not is_builtin_new:
                    mut obj_type := self.infer_node(obj, TYPE_UNKNOWN)
                    if obj_type != TYPE_UNKNOWN:
                        mut entry = self.types.entries.data[obj_type]
                        if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                            obj_type = entry.extra
                            entry = self.types.entries.data[obj_type]
                        if obj_type == TYPE_STRING or obj_type == TYPE_BYTES:
                            // RFC 0020: `bytes` shares str's {ptr,len} layout, so `.ptr`/`.len`
                            // resolve identically (field 0 = ptr[u8], field 1 = i64 byte length).
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            let field_name = self.intern.get(field_name_id)
                            let ptr_field := field_name as ptr[u8]
                            mut is_ptr_field := false
                            mut is_len_field := false
                            if std.string.len(field_name) == 3 as i64 and ptr_field[0] == 'p' as u8 and ptr_field[1] == 't' as u8 and ptr_field[2] == 'r' as u8:
                                is_ptr_field = true
                            elif std.string.len(field_name) == 3 as i64 and ptr_field[0] == 'l' as u8 and ptr_field[1] == 'e' as u8 and ptr_field[2] == 'n' as u8:
                                is_len_field = true

                            if is_ptr_field:
                                result_type = self.types.register_pointer(5 as u32)
                                self.tree.nodes.data[node_idx].extra_idx = 0 as u32
                            elif is_len_field:
                                result_type = 4 as u32
                                self.tree.nodes.data[node_idx].extra_idx = 1 as u32
                            safe_free_str(field_name)
                        elif entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            mut found := false
                            if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
                                mut is_struct := false
                                mut struct_extra := entry.extra
                                if entry.kind == TYPE_KIND_STRUCT:
                                    is_struct = true
                                elif entry.kind == TYPE_KIND_GENERIC_INST:
                                    mut idx := 0 as i64
                                    while idx < self.types.entries.len:
                                        let e = self.types.entries.data[idx]
                                        let e_base = extract_qualified_base_name(self.intern.get(e.name_id))
                                        let entry_base = extract_qualified_base_name(self.intern.get(entry.name_id))
                                        let name_match = (e_base == entry_base)
                                        if e.kind == TYPE_KIND_STRUCT and name_match:
                                            struct_extra = e.extra
                                            is_struct = true
                                            break
                                        idx = idx + 1
                                if is_struct:
                                    let struct_info = &self.types.structs.data[struct_extra]
                                    mut j := 0 as i64
                                    while j < struct_info.fields.len:
                                        let f = struct_info.fields.data[j]
                                        if f.name_id == field_name_id:
                                            mut ft := f.type_id
                                            // Monomorphize a generic-param field type via the
                                            // instance's concrete args. Under an INFERRED generic
                                            // construction (`Box(v: 42)`, no explicit `Box[i64]`)
                                            // the receiver is a GENERIC_INST over the TEMPLATE, so
                                            // the field type read straight from the template is the
                                            // bare param placeholder `T` â€” not `i64`. Contexts that
                                            // impose an expected type (arith/fn-arg) papered over it,
                                            // but a method-form receiver imposes none, so `b.v.to_str()`
                                            // saw type `T` and rejected. Substitution is guarded to
                                            // ONLY remap a genuine TYPE_KIND_GENERIC placeholder that
                                            // matches a template param position (concrete field types
                                            // and monomorphized structs are left untouched â€” no-op).
                                            if entry.kind == TYPE_KIND_GENERIC_INST and (ft as i64) < self.types.entries.len and self.types.entries.data[ft as i64].kind == TYPE_KIND_GENERIC:
                                                let inst_args = self.get_generic_args(obj_type)
                                                let tmpl_params = &self.types.structs.data[struct_extra].generic_args
                                                if inst_args.len > 0 as i64 and inst_args.len == tmpl_params.len:
                                                    mut pi := 0 as i64
                                                    while pi < tmpl_params.len:
                                                        if tmpl_params.data[pi] == ft:
                                                            ft = inst_args.data[pi]
                                                            break
                                                        pi = pi + 1 as i64
                                                if inst_args.data != null as ptr[u32]:
                                                    @free(inst_args.data as ptr[u8])
                                            result_type = ft
                                            self.tree.nodes.data[node_idx].extra_idx = j as u32
                                            found = true
                                            break
                                        j = j + 1
                            // RFC 0004: qualified variant construction `EnumType.Variant`
                            // (e.g. `Color.Blue`, `Shape.Circle`). The base resolves to a user
                            // sum type; a matching variant NAMES a value of that sum. Bind the
                            // field-expr to the variant SYMBOL (flag 2048) and type it as the
                            // sum. A no-payload variant is a complete value â€” the lowerer builds
                            // it in `lower_field_expr`; a payload variant is completed by a call
                            // `EnumType.Ctor(x)` â€” the lowerer builds it in `lower_call_expr`.
                            if not found and entry.kind == TYPE_KIND_SUM:
                                let sum_extra = entry.extra
                                if (sum_extra as i64) < self.types.sumtypes.len:
                                    let vsum_info = self.types.sumtypes.data[sum_extra]
                                    mut vk := 0 as i64
                                    while vk < vsum_info.variants.len:
                                        let vinfo = vsum_info.variants.data[vk]
                                        if vinfo.name_id == field_name_id:
                                            mut vsi := 0 as i64
                                            while vsi < self.symtable.symbols.len:
                                                let cand = self.symtable.symbols.data[vsi]
                                                if cand.kind == SYM_VARIANT and cand.name_id == field_name_id and cand.type_id == obj_type:
                                                    result_type = obj_type
                                                    self.tree.nodes.data[node_idx].payload = vsi as u32
                                                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                                    found = true
                                                    break
                                                vsi = vsi + 1
                                            break
                                        vk = vk + 1
                            // If not found, check if it is a method or global function
                            if not found:
                                mut sym_idx := self.resolve_method_sym(field_name_id, obj_type)
                                if sym_idx != 0 as u32:
                                    let sym = self.symtable.symbols.data[sym_idx]
                                    result_type = sym.type_id
                                    self.tree.nodes.data[node_idx].payload = sym_idx
                                    self.tree.nodes.data[node_idx].flags = self.tree.nodes.data[node_idx].flags | 2048 as u16
                                else:
                                    // Diagnostic (was silent accept-then-miscompile,
                                    // BUG#53/68/81/93 class): `recv.name` (value load)
                                    // where `name` is neither a field of recv's struct,
                                    // a variant, nor a method/UFCS free fn. air_builder
                                    // then loaded field offset 0 / a garbage address ->
                                    // wrong value or SIGSEGV, no signal (e.g. `c.zzz`
                                    // reads `c.x`). SAFETY: like the undefined-method
                                    // fix, use a RECEIVER-AGNOSTIC test (reject only when
                                    // NO struct anywhere has a field of this name AND no
                                    // SYM_FUNC matches it) so cross-module field-list
                                    // timing never false-positives a valid access.
                                    let mnm = self.intern.get(field_name_id)
                                    mut member_exists := false
                                    mut sfi := 0 as i64
                                    while sfi < self.types.structs.len and not member_exists:
                                        let sinfo = self.types.structs.data[sfi]
                                        mut ffi := 0 as i64
                                        while ffi < sinfo.fields.len:
                                            if sinfo.fields.data[ffi].name_id == field_name_id:
                                                member_exists = true
                                                break
                                            ffi = ffi + 1 as i64
                                        sfi = sfi + 1 as i64
                                    if not member_exists:
                                        mut mi := 0 as i64
                                        while mi < self.symtable.symbols.len:
                                            let msym = self.symtable.symbols.data[mi]
                                            if msym.kind == SYM_FUNC and self.intern.name_matches_method(msym.name_id, mnm):
                                                member_exists = true
                                                break
                                            mi = mi + 1 as i64
                                    // The backend-intercepted Option/Result methods
                                    // (is_some/unwrap/...) have no method symbol, so the
                                    // scans above miss them -> false-reject on an OPTION/
                                    // RESULT-typed receiver (e.g. `arr[i].is_some()` where the
                                    // element types to a real OPTION). air_builder lowers them
                                    // by name; leave result UNKNOWN and let the call proceed.
                                    if not member_exists and (entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT) and (mnm == "unwrap" or mnm == "unwrap_err" or mnm == "is_some" or mnm == "is_none" or mnm == "is_ok" or mnm == "is_err"):
                                        member_exists = true
                                    if not member_exists:
                                        let tnm = self.intern.get(entry.name_id)
                                        ax_printf_local("error: no field or method '%s' on type '%s'\n", get_str_ptr(mnm) as i64, get_str_ptr(tnm) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                        safe_free_str(tnm)
                                        self.diags_count = self.diags_count + 1 as i64
                                    safe_free_str(mnm)
                        elif entry.kind == TYPE_KIND_PRIMITIVE:
                            // Diagnostic (was silent accept-then-miscompile, BUG#53
                            // class): `n.foo` on a primitive scalar (i32/i64/.../bool/
                            // char/f64 -- str/bytes are handled by the `.ptr`/`.len`
                            // branch above). A primitive has no fields, and scalar UFCS
                            // method receivers are unsupported (a `scalar.method()` call
                            // segfaults too). This left result_type UNKNOWN and
                            // air_builder read field offset 0 / a garbage address ->
                            // SIGSEGV, no signal. SAFETY (mirrors the nonexistent-field
                            // fix): receiver-AGNOSTIC -- reject only when the member name
                            // matches NO struct field AND NO SYM_FUNC anywhere. Scanning
                            // struct fields too is essential: a value's type can be
                            // transiently a PRIMITIVE during inference (an operator-
                            // overload result `a + b` reads as its RHS scalar before the
                            // overload return type settles), so a member that is a real
                            // field of SOME struct must not be rejected here -- it is
                            // handled once the correct aggregate type resolves. `n.foo`
                            // (name nowhere) still rejects; `d.v` (v is a field of Num,
                            // d transiently typed i64) does not.
                            let field_name_id = self.tree.nodes.data[node_idx].payload
                            let pmn = self.intern.get(field_name_id)
                            mut pexists := false
                            mut psfi := 0 as i64
                            while psfi < self.types.structs.len and not pexists:
                                let psinfo = self.types.structs.data[psfi]
                                mut pffi := 0 as i64
                                while pffi < psinfo.fields.len:
                                    if psinfo.fields.data[pffi].name_id == field_name_id:
                                        pexists = true
                                        break
                                    pffi = pffi + 1 as i64
                                psfi = psfi + 1 as i64
                            mut pmi := 0 as i64
                            while pmi < self.symtable.symbols.len and not pexists:
                                let psym = self.symtable.symbols.data[pmi]
                                if psym.kind == SYM_FUNC and self.intern.name_matches_method(psym.name_id, pmn):
                                    pexists = true
                                    break
                                pmi = pmi + 1 as i64
                            if not pexists:
                                ax_printf_local("error: no member '%s' on a primitive value (primitives have no fields or methods)\n", get_str_ptr(pmn) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                            safe_free_str(pmn)
                    else:
                        let sym_idx = self.symtable.resolve(self.tree.nodes.data[node_idx].payload)
                        if sym_idx != 0 as u32:
                            let sym = self.symtable.symbols.data[sym_idx]
                            result_type = sym.type_id
                    
    elif kind == NODE_INDEX_EXPR:
        let collection = self.tree.nodes.data[node_idx].first_child
        if collection != 0 as u32:
            mut is_generic_inst := false
            mut sym_idx := 0 as u32
            let col_node = self.tree.nodes.data[collection]
            if col_node.kind == NODE_IDENT:
                sym_idx = col_node.payload
            elif col_node.kind == NODE_FIELD_EXPR:
                if (col_node.flags & 2048 as u16) != 0 as u16:
                    sym_idx = col_node.payload
            
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                let sym = self.symtable.symbols.data[sym_idx]
                mut src_tree := self.tree
                if (sym_idx as i64) < self.symtable.symbol_trees.len:
                    let t = self.symtable.symbol_trees.data[sym_idx]
                    if t != null as ptr[AstTree]:
                        src_tree = t
                if (sym.flags & SYM_FLAG_GENERIC) != 0 as u16 or (sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32 and (sym.decl_node as i64) < src_tree.nodes.len and (src_tree.nodes.data[sym.decl_node].flags & FLAG_IS_GENERIC) != 0 as u16):
                    is_generic_inst = true
            
            if is_generic_inst:
                let sym = self.symtable.symbols.data[sym_idx]
                mut args := new_u32_vec()
                mut arg_idx := col_node.next_sibling
                while arg_idx != 0 as u32:
                    let arg_type = self.infer_node(arg_idx, TYPE_UNKNOWN)
                    args.push(arg_type)
                    arg_idx = self.tree.nodes.data[arg_idx].next_sibling
                
                mut has_generic_arg := false
                mut a_idx := 0 as i64
                while a_idx < args.len:
                    if self.is_generic(args.data[a_idx]):
                        has_generic_arg = true
                        break
                    a_idx = a_idx + 1

                if has_generic_arg:
                    result_type = self.types.register_generic_inst(sym.name_id, args)
                    // `f[T]` where `f` is a generic FUNCTION (not a type) and `T` is
                    // an enclosing type param is a function reference with explicit
                    // type args, NOT a type instantiation. Its type is the function's
                    // RETURN type (still symbolic pre-mono), not a generic-inst named
                    // after the fn. Without this override, `make[T]()` inside a generic
                    // body typed the result as GENERIC_INST("make") and `r.push(..)`
                    // failed with "no method 'push' on type 'make'". (register_generic_inst
                    // above already consumed `args`; we only reinterpret result_type.)
                    if sym.kind == SYM_FUNC:
                        mut fnty := sym.type_id
                        if fnty == TYPE_UNKNOWN and sym.decl_node != 0 as u32 and sym.decl_node != 0xffffffff as u32:
                            self.pre_infer_func_signature(sym.decl_node)
                            fnty = self.symtable.symbols.data[sym_idx as i64].type_id
                        if fnty != TYPE_UNKNOWN and (fnty as i64) < self.types.entries.len:
                            let fe = self.types.entries.data[fnty as i64]
                            if fe.kind == TYPE_KIND_FUNC:
                                let fret = self.types.funcs.data[fe.extra].ret
                                if fret != TYPE_UNKNOWN and fret != 0 as u32:
                                    result_type = fret
                else:
                    mut mono := new_monomorphizer(self.tree, self.intern, self.symtable, self.types)
                    let mangled_name = mono.mangle_name_ov(sym_idx, self.intern.get(sym.name_id), args)
                    let mangled_id = self.intern.intern(mangled_name)
                    mut existing_type_id := 0 as u32
                    mut j_tt := 0 as i64
                    while j_tt < self.types.entries.len:
                        // `TypeEntry.name_id` does NOT always hold a name. `register_array`
                        // stores the array LENGTH there and `register_result` stores the ERR
                        // TYPE ID, so scanning every entry for a mangled name can match one of
                        // those integers by coincidence. It is not hypothetical: mangled ids
                        // land in the high hundreds for even a trivial program, so a
                        // `[i64; 974]` field alongside a generic instantiation whose mangled
                        // name interned to 974 matched the ARRAY entry and used it as the
                        // monomorphized type -> SIGSEGV. Only kinds that are genuinely
                        // registered under a name can be the instantiation we are looking for.
                        let jk = self.types.entries.data[j_tt].kind
                        if jk != TYPE_KIND_ARRAY and jk != TYPE_KIND_RESULT and self.types.entries.data[j_tt].name_id == mangled_id:
                            existing_type_id = j_tt as u32
                            break
                        j_tt = j_tt + 1 as i64

                    mut existing_sym_idx := self.symtable.resolve(mangled_id)
                    if existing_sym_idx == 0 as u32:
                        let proxy_sys_idx = self.symtable.resolve_global(mangled_id)
                        existing_sym_idx = proxy_sys_idx
                    
                    mut inst_sym_idx := 0 as u32
                    if existing_type_id != 0 as u32:
                        if existing_sym_idx != 0 as u32:
                            self.symtable.symbols.data[existing_sym_idx as i64].type_id = existing_type_id
                            inst_sym_idx = existing_sym_idx
                        else:
                            let new_sym = self.symtable.define(mangled_id, SYM_TYPE_ALIAS, 0 as u16, 0 as u32)
                            self.symtable.symbols.data[new_sym as i64].type_id = existing_type_id
                            inst_sym_idx = new_sym
                    elif existing_sym_idx != 0 as u32:
                        let existing_sym = self.symtable.symbols.data[existing_sym_idx]
                        if existing_sym.type_id != 0 as u32:
                            inst_sym_idx = existing_sym_idx
                    else:
                        let cloned_root = mono.instantiate_function(sym_idx, args)
                        self.tree.append_child(0 as u32, cloned_root)
                        
                        let saved_data = self.symtable.stack.data
                        let saved_len = self.symtable.stack.len
                        let saved_cap = self.symtable.stack.cap
                        mut temp_stack := new_u32_vec()
                        temp_stack.push(0 as u32)
                        if saved_len > 1:
                            temp_stack.push(saved_data[1])
                        self.symtable.stack = temp_stack
                        mut resolver := new_name_resolver(self.tree, self.intern, self.symtable)
                        resolver.resolve_node(cloned_root)
                        @free(self.symtable.stack.data as ptr[u8])
                        self.symtable.stack.data = saved_data
                        self.symtable.stack.len = saved_len
                        self.symtable.stack.cap = saved_cap
                        
                        let payload_sym = self.tree.nodes.data[cloned_root].payload
                        if payload_sym != 0 as u32:
                            inst_sym_idx = payload_sym
                        else:
                            mut resolved_inst_sym := self.symtable.resolve(mangled_id)
                            if resolved_inst_sym == 0 as u32:
                                resolved_inst_sym = self.symtable.resolve_global(mangled_id)
                            inst_sym_idx = resolved_inst_sym
                        
                        let cloned_kind = self.tree.nodes.data[cloned_root].kind
                        if cloned_kind == NODE_STRUCT_DECL and mono.struct_type_id != 0 as u32:
                            self.symtable.symbols.data[inst_sym_idx as i64].type_id = mono.struct_type_id
                        
                        if cloned_kind == NODE_STRUCT_DECL:
                            self.pre_infer_struct(cloned_root)
                            mut m_child := self.tree.nodes.data[cloned_root].first_child
                            while m_child != 0 as u32:
                                let mc = self.tree.nodes.data[m_child]
                                let next_sibling = mc.next_sibling
                                if mc.kind == NODE_FUNC_DECL:
                                    self.pre_infer_func_signature(m_child)
                                m_child = next_sibling
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                        elif cloned_kind == NODE_FUNC_DECL:
                            self.pre_infer_func_signature(cloned_root)
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                        elif cloned_kind == NODE_TYPE_ALIAS_DECL:
                            self.pre_infer_type_alias(cloned_root)
                            mut m_child := self.tree.nodes.data[cloned_root].first_child
                            while m_child != 0 as u32:
                                let mc = self.tree.nodes.data[m_child]
                                let next_sibling = mc.next_sibling
                                if mc.kind == NODE_FUNC_DECL:
                                    self.pre_infer_func_signature(m_child)
                                m_child = next_sibling
                            self.infer_node(cloned_root, TYPE_UNKNOWN)
                    
                    let inst_sym = self.symtable.symbols.data[inst_sym_idx]
                    result_type = inst_sym.type_id
                    
                    self.tree.nodes.data[node_idx].payload = inst_sym_idx
                    
                    if args.data != null as ptr[u32]:
                        @free(args.data as ptr[u8])
            else:
                let col_type = self.infer_node(collection, TYPE_UNKNOWN)
                let idx = self.tree.nodes.data[collection].next_sibling
                // RFC 0020 P3: `s[a..b]` on a str/bytes is a SUBSTRING slice.
                // `..` (TK_DOT_DOT) parses into a plain NODE_BINARY_EXPR (parser.ax's
                // parse_led treats it like +/-/etc; no dedicated range node exists) and
                // NODE_FOR_STMT is otherwise the only place that gives it meaning (loop
                // bounds). For a str/bytes base we now ACCEPT it: air_builder lowers it
                // to `std.string.slice(s, a, b)` (byte-indexed, Rust model, bounds-safe)
                // and the result is a fresh view of the SAME base type. For any other
                // base (BUG#72) it stays a hard reject -- used as a raw element offset it
                // is a real, reproducible segfault with no diagnostic.
                mut is_range_slice := false
                if idx != 0 as u32:
                    let idx_node = self.tree.nodes.data[idx]
                    if idx_node.kind == NODE_BINARY_EXPR:
                        let idx_op_text = self.node_text(idx)
                        if idx_op_text == "..":
                            if col_type == TYPE_STRING or col_type == TYPE_BYTES:
                                is_range_slice = true
                            else:
                                ax_printf_local("error: range-slicing ('a[x..y]') is not yet supported for this type; index must be a single value\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                        safe_free_str(idx_op_text)
                    self.infer_node(idx, TYPE_UNKNOWN)
                if is_range_slice:
                    result_type = col_type // str[a..b] -> str, bytes[a..b] -> bytes
                elif col_type != TYPE_UNKNOWN:
                    let c_entry = self.types.entries.data[col_type]
                    if c_entry.kind == TYPE_KIND_POINTER or c_entry.kind == TYPE_KIND_SLICE or c_entry.kind == TYPE_KIND_ARRAY:
                        result_type = c_entry.extra
                    elif col_type == TYPE_STRING or col_type == TYPE_BYTES:
                        result_type = 5 as u32 // str/bytes index -> u8 byte
                    elif c_entry.kind == TYPE_KIND_STRUCT or c_entry.kind == TYPE_KIND_GENERIC_INST:
                        // RFC 0021: `v[i]` on a `Vec[T]` evaluates to the element type T
                        // (== `vec.data[i]`; air_builder's lower_index_expr loads the
                        // `data` field before OP_INDEX). Previously this fell through
                        // UNKNOWN and OP_INDEX read the `{data,len,cap}` HEADER (`c[1]`
                        // returned the length; wide elements segfaulted) -- a silent
                        // miscompile (BUG#53 class, first closed by a reject in d94aa8e).
                        // Scoped to a Vec base name so ordinary pointer/array `.data[i]`
                        // indexing is untouched and the self-host fixpoint is A==B (the
                        // compiler never subscripts a Vec). Element type resolved the
                        // same way the for-in-vec binding does (get_generic_args[0]).
                        let cnm = self.intern.get(c_entry.name_id)
                        let cbase = extract_base_type_name(cnm)
                        if cbase == "Vec":
                            let vargs = self.get_generic_args(col_type)
                            if vargs.len >= 1 as i64:
                                result_type = vargs.data[0]
                            else:
                                ax_printf_local("error: cannot determine the element type of this Vec for `v[i]`\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                        safe_free_str(cbase)
                        safe_free_str(cnm)
                    elif c_entry.kind == TYPE_KIND_PRIMITIVE and col_type != TYPE_STRING and col_type != TYPE_BYTES and col_type != TYPE_VOID and self.tree.nodes.data[collection].kind == NODE_IDENT:
                        // BUG#53: indexing a scalar VARIABLE (`x[0]` where x is i64/f64/
                        // bool/...) is not indexable -- air_builder emits OP_INDEX on the
                        // scalar value -> segfault (no diagnostic). Reject. GATED on the
                        // collection being a bare NODE_IDENT (a variable, whose declared
                        // type is reliable): infer_node imprecisely reports i64 for some
                        // str/array-returning CALLs (same trap as m2/m5), so a call
                        // collection is NOT trustworthy here and must not be rejected.
                        // Only arrays, Vec, str/bytes, pointers are indexable; the
                        // compiler's own source never subscripts a bare scalar var, so
                        // self-build is safe. See [[bug-malformed-input-robustness-cluster]].
                        ax_printf_local("error: cannot index a value of a non-indexable scalar type (only arrays, Vec, str/bytes, and pointers are indexable)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64

    elif kind == NODE_COMPTIME:
        let child = self.tree.nodes.data[node_idx].first_child
        if child != 0 as u32:
            let child_type = self.infer_node(child, expected)
            if child_type == TYPE_UNKNOWN:
                result_type = TYPE_UNKNOWN
            else:
                let val = self.eval_comptime(child)
                mut lit_kind := NODE_INT_LIT
                mut val_str := ""
                mut tok_kind := TK_INT_LIT
                
                if val.kind == TYPE_BOOL:
                    lit_kind = NODE_BOOL_LIT
                    if val.bool_val:
                        val_str = "true"
                        tok_kind = TK_TRUE
                    else:
                        val_str = "false"
                        tok_kind = TK_FALSE
                elif val.kind == TYPE_STRING:
                    lit_kind = NODE_STRING_LIT
                    val_str = std.string.concat("\"", std.string.concat(val.str_val, "\""))
                    tok_kind = TK_STRING_LIT
                elif val.kind == TYPE_F64:
                    lit_kind = NODE_FLOAT_LIT
                    val_str = format_float(val.float_val)
                    tok_kind = TK_FLOAT_LIT
                else:
                    lit_kind = NODE_INT_LIT
                    val_str = format_int(val.int_val)
                    tok_kind = TK_INT_LIT
                
                let new_offset = std.string.len(self.tree.src) as u32
                self.tree.src = std.string.concat(self.tree.src, val_str)
                
                let new_tok_idx = self.tree.tokens.len as u32
                self.tree.tokens.push(Token(
                    kind: tok_kind,
                    padding: 0 as u8,
                    len: std.string.len(val_str) as u16,
                    offset: new_offset,
                ))
                
                // Mutate the AST node in-place
                self.tree.nodes.data[node_idx].kind = lit_kind
                self.tree.nodes.data[node_idx].token_idx = new_tok_idx
                self.tree.nodes.data[node_idx].first_child = NULL_IDX
                self.tree.nodes.data[node_idx].payload = val.kind
                
                result_type = val.kind
        else:
            result_type = TYPE_VOID

    elif kind == NODE_PTR_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
        result_type = self.types.register_pointer(inner_type)

    elif kind == NODE_SLICE_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
        result_type = self.types.register_slice(inner_type)

    elif kind == NODE_TUPLE_TYPE:
        // RFC 0022 P2: a tuple TYPE annotation resolves to the same anonymous struct
        // (fields _f0.._fN) as a tuple literal, so annotations, params, returns, and
        // globals interoperate with tuple literals through identical struct layout.
        result_type = self.register_tuple_type(self.tree.nodes.data[node_idx].first_child)

    elif kind == NODE_ARRAY_TYPE:
        let inner_node = self.tree.nodes.data[node_idx].first_child
        mut inner_type := TYPE_UNKNOWN
        if inner_node != 0 as u32:
            inner_type = self.infer_node(inner_node, TYPE_UNKNOWN)
            // Builtin Option/Result are not user generic templates, so a
            // NODE_GENERIC_TYPE element leaves inner_type UNKNOWN -> the array element
            // falls back to a scalar and the 8-byte box pointer that the constructor
            // stores (pointer-repr, register_option/result kind 11/12, size 16) is
            // truncated on OP_STORE/OP_INDEX -> match/read segfaults. Resolve the real
            // pointer-repr aggregate HERE so both the store stride and OP_INDEX load
            // agree. Scoped to fixed-array ELEMENT position only: the compiler's own
            // source uses no `[Option;N]`/`[Result;N]` arrays, so the self-host fixpoint
            // is unaffected -- retyping Option/Result globally (annotations/ctors) instead
            // shifts every EQ/COPY/MAKE_REF path (RFC 0012) and breaks self-compilation.
            if inner_type == TYPE_UNKNOWN and self.tree.nodes.data[inner_node].kind == NODE_GENERIC_TYPE:
                let ib = self.tree.nodes.data[inner_node].first_child
                if ib != 0 as u32:
                    let ibname = self.node_text(ib)
                    if ibname == "Option":
                        let a1 = self.tree.nodes.data[ib].next_sibling
                        mut it := TYPE_UNKNOWN
                        if a1 != 0 as u32:
                            it = self.infer_node(a1, TYPE_UNKNOWN)
                        inner_type = self.types.register_option(it)
                    elif ibname == "Result":
                        let a1 = self.tree.nodes.data[ib].next_sibling
                        mut okt := TYPE_UNKNOWN
                        mut ert := TYPE_UNKNOWN
                        if a1 != 0 as u32:
                            okt = self.infer_node(a1, TYPE_UNKNOWN)
                            let a2 = self.tree.nodes.data[a1].next_sibling
                            if a2 != 0 as u32:
                                ert = self.infer_node(a2, TYPE_UNKNOWN)
                        inner_type = self.types.register_result(okt, ert)
                    safe_free_str(ibname)
        mut length := 1 as u32
        if inner_node != 0 as u32:
            let size_node = self.tree.nodes.data[inner_node].next_sibling
            if size_node != 0 as u32 and self.tree.nodes.data[size_node].kind == NODE_INT_LIT:
                let text = self.node_text(size_node)
                length = parse_comptime_int(text) as u32
                @free(text as ptr[u8])
        result_type = self.types.register_array(inner_type, length)

    elif kind == NODE_FUNC_TYPE:
        mut param_types := new_u32_vec()
        mut ret_type := TYPE_VOID
        let has_ret = (self.tree.nodes.data[node_idx].flags & 1 as u16 != 0 as u16)
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            let child_node = self.tree.nodes.data[child]
            let next = child_node.next_sibling
            if has_ret and next == 0 as u32:
                ret_type = self.infer_node(child, TYPE_UNKNOWN)
            else:
                let p_type = self.infer_node(child, TYPE_UNKNOWN)
                param_types.push(p_type)
            child = next
        result_type = self.types.register_function(param_types, ret_type)

    elif kind == NODE_ASSIGN_STMT:
        // children: [lhs, rhs]. An assignment must thread the lvalue's type down to the
        // RHS as `expected`, exactly like the VAR_DECL *init* path does â€” otherwise the
        // RHS is inferred with UNKNOWN and any expected-type coercion is skipped:
        //   `g = (30,12)` for `g:(i64,i64)` -> {i32,i32} 8B into a 16B slot (loses .1);
        //   `a = [10,15,17]` for `a:[i64;3]` -> i32 elems at 4B stride into an i64 array;
        //   `o = Some((30,12))` for `o:Option[(i64,i64)]` -> the variant-ctor payload
        //   tuple stays {i32,i32} (1aff7ca coercion needs the expected Option threaded).
        // NODE_ASSIGN_STMT had no infer_node branch and fell to the default traversal
        // (rhs = UNKNOWN). Mirror VAR_DECL: infer the LHS, then infer the RHS with the
        // lvalue type as expected. Frontend ACCEPT-only; the A==B fixpoint gate confirms
        // this does not change the self-host codegen.
        let lhs_a = self.tree.nodes.data[node_idx].first_child
        if lhs_a != 0 as u32:
            let lhs_ty = self.infer_node(lhs_a, TYPE_UNKNOWN)
            let rhs_a = self.tree.nodes.data[lhs_a].next_sibling
            if rhs_a != 0 as u32:
                let rhs_inferred = self.infer_node(rhs_a, lhs_ty)
                // BUG#53 (assignment analog of the let-binding/call-arg reject): an
                // Option/Result/sum VALUE assigned to a plain-typed lvalue (scalar or
                // struct field) WITHOUT unwrapping was silently accepted, storing the
                // 8-byte tagged box raw -> garbage (`x = o` -> 8, `x = v.get(0)` -> 127,
                // `s.a = o` -> 8). Reject, mirroring the NODE_VAR_DECL reject: gate on the
                // LVALUE kind being PRIMITIVE/STRUCT + the RHS true type kind OPTION/RESULT/
                // SUM. RHS true type: symbol decl type for an IDENT rhs (an annotated
                // Option local is SUM-kind here), else REUSE `rhs_inferred` (already
                // computed with the lvalue hint; a second re-infer would side-effect like
                // the t_u64cmp regression). Cannot over-reject â€” a sum lvalue has SUM kind
                // and is skipped, so `mut s: MySum; s = MakeVariant(..)` is unaffected.
                // [[bug-option-as-let-binding-not-rejected]]
                if lhs_ty != TYPE_UNKNOWN and (lhs_ty as i64) < self.types.entries.len:
                    let lhs_k0 = self.types.entries.data[lhs_ty as i64].kind
                    if lhs_k0 == TYPE_KIND_PRIMITIVE or lhs_k0 == TYPE_KIND_STRUCT:
                        let rhs_k0 = self.tree.nodes.data[rhs_a].kind
                        mut rhs_sty := TYPE_UNKNOWN
                        if rhs_k0 == NODE_IDENT:
                            let rhs_sym = self.tree.nodes.data[rhs_a].payload
                            if rhs_sym != 0 as u32 and (rhs_sym as i64) < self.symtable.symbols.len:
                                rhs_sty = self.symtable.symbols.data[rhs_sym].type_id
                        else:
                            rhs_sty = rhs_inferred
                        if rhs_sty != TYPE_UNKNOWN and (rhs_sty as i64) < self.types.entries.len:
                            let rhs_stk = self.types.entries.data[rhs_sty as i64].kind
                            if rhs_stk == TYPE_KIND_OPTION or rhs_stk == TYPE_KIND_RESULT or rhs_stk == TYPE_KIND_SUM:
                                ax_printf_local("error: cannot assign an Option/Result/sum value to a plain lvalue; unwrap it first (.unwrap() or match)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                self.diags_count = self.diags_count + 1 as i64
                // BUG#53 (assignment-path analog of m5): `x = <string literal>` where
                // x is numeric (or a numeric literal into a str/bytes lvalue) was
                // silently accepted then miscompiled to garbage. Reject the
                // str<->numeric pair. Literal-gated (RHS node kind), so real coercions
                // and value assignments are untouched. See
                // [[bug-malformed-input-robustness-cluster]].
                if lhs_ty != TYPE_UNKNOWN:
                    let ak = self.tree.nodes.data[rhs_a].kind
                    let l_str = lhs_ty == TYPE_STRING or lhs_ty == TYPE_BYTES
                    let l_num = lhs_ty >= TYPE_I8 and lhs_ty <= TYPE_USIZE and lhs_ty != TYPE_STRING and lhs_ty != TYPE_VOID
                    let a_strlit = ak == NODE_STRING_LIT
                    let a_numlit = ak == NODE_INT_LIT or ak == NODE_FLOAT_LIT
                    if (l_num and a_strlit) or (l_str and a_numlit):
                        ax_printf_local("error: type mismatch in assignment: a string and a numeric type are not compatible\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.diags_count = self.diags_count + 1 as i64

    else:
        // Default traversal
        mut child := self.tree.nodes.data[node_idx].first_child
        while child != 0 as u32:
            self.infer_node(child, TYPE_UNKNOWN)
            child = self.tree.nodes.data[child].next_sibling
            
    self.set_node_type(node_idx, result_type)
    return result_type

pub fn debug_find_and_print_is_ok(self: ptr[TypeChecker], node_idx: u32):
    if node_idx == 0 as u32:
        return
    let node = self.tree.nodes.data[node_idx]
    if node.kind == NODE_FIELD_EXPR:
        let name = self.intern.get(node.payload)
        ax_printf_local("  [TC-DEBUG-IS-OK] Found field node_idx=%d | name=%s flags=%d payload=%d\n", node_idx as i64, (get_str_ptr(name)) as i64, node.flags as i64, node.payload as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut child := node.first_child
    while child != 0 as u32:
        self.debug_find_and_print_is_ok(child)
        child = self.tree.nodes.data[child].next_sibling
// bootstrap/stage1/connection_graph.ax
// ConnectionGraph models ownership relationships between values as a directed
// graph with typed edges for static memory safety.

pub const EDGE_OWNS: u32 = 0
pub const EDGE_BORROWS: u32 = 1
pub const EDGE_FLOWS_TO: u32 = 2
pub const EDGE_ESCAPES_TO: u32 = 3
pub const EDGE_REUSED_BY: u32 = 4

pub struct CGNode:
    pub id: u32
    pub sym_id: u32
    pub type_id: u32
    pub is_ref: bool
    pub lifetime: u32

pub struct CGNodeVec:
    pub data: ptr[CGNode]
    pub len: i64
    pub cap: i64

pub fn new_cg_node_vec() -> CGNodeVec:
    return CGNodeVec(data: null as ptr[CGNode], len: 0, cap: 0)

pub fn push(mut self: CGNodeVec, n: CGNode) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 20) as ptr[CGNode] // CGNode size is 20 bytes
        if self.data != null as ptr[CGNode]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 20)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = n
    self.len = self.len + 1
    return idx

pub struct CGEdge:
    pub from: u32
    pub to: u32
    pub kind: u32

pub struct CGEdgeVec:
    pub data: ptr[CGEdge]
    pub len: i64
    pub cap: i64

pub fn new_cg_edge_vec() -> CGEdgeVec:
    return CGEdgeVec(data: null as ptr[CGEdge], len: 0, cap: 0)

pub fn push(mut self: CGEdgeVec, e: CGEdge) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[CGEdge] // CGEdge size is 12 bytes
        if self.data != null as ptr[CGEdge]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = e
    self.len = self.len + 1
    return idx



pub struct ConnectionGraph:
    pub nodes: CGNodeVec
    pub edges: CGEdgeVec
    pub adj_out: U32VecVec
    pub adj_in: U32VecVec
    pub sym_to_node: U32Vec

pub fn new_connection_graph() -> ConnectionGraph:
    return ConnectionGraph(
        nodes: new_cg_node_vec(),
        edges: new_cg_edge_vec(),
        adj_out: new_u32_vec_vec(),
        adj_in: new_u32_vec_vec(),
        sym_to_node: new_u32_vec(),
    )

pub fn free_connection_graph(mut self: ConnectionGraph):
    if self.nodes.data != null as ptr[CGNode]:
        @free(self.nodes.data as ptr[u8])
    if self.edges.data != null as ptr[CGEdge]:
        @free(self.edges.data as ptr[u8])
    
    mut i := 0 as i64
    while i < self.adj_out.len:
        let v = self.adj_out.data[i]
        if v.data != null as ptr[u32]:
            @free(v.data as ptr[u8])
        i = i + 1
    if self.adj_out.data != null as ptr[U32Vec]:
        @free(self.adj_out.data as ptr[u8])

    i = 0
    while i < self.adj_in.len:
        let v = self.adj_in.data[i]
        if v.data != null as ptr[u32]:
            @free(v.data as ptr[u8])
        i = i + 1
    if self.adj_in.data != null as ptr[U32Vec]:
        @free(self.adj_in.data as ptr[u8])

    if self.sym_to_node.data != null as ptr[u32]:
        @free(self.sym_to_node.data as ptr[u8])

pub fn ensure_adj_capacity(mut self: ConnectionGraph, node_id: u32):
    while self.adj_out.len <= node_id as i64:
        self.adj_out.push(new_u32_vec())
    while self.adj_in.len <= node_id as i64:
        self.adj_in.push(new_u32_vec())

pub fn add_value_node(mut self: ConnectionGraph, sym_id: u32, type_id: u32, lifetime: u32) -> u32:
    let id = self.nodes.len as u32
    self.nodes.push(CGNode(
        id: id,
        sym_id: sym_id,
        type_id: type_id,
        is_ref: false,
        lifetime: lifetime,
    ))
    self.ensure_adj_capacity(id)
    if sym_id != 0:
        while self.sym_to_node.len <= sym_id as i64:
            self.sym_to_node.push(0xffffffff as u32)
        self.sym_to_node.data[sym_id] = id
    return id

pub fn add_ref_node(mut self: ConnectionGraph, target_node_id: u32) -> u32:
    mut type_id := 0 as u32
    mut lifetime := 0 as u32
    if (target_node_id as i64) < self.nodes.len:
        type_id = self.nodes.data[target_node_id].type_id
        lifetime = self.nodes.data[target_node_id].lifetime
    
    let id = self.nodes.len as u32
    self.nodes.push(CGNode(
        id: id,
        sym_id: 0 as u32,
        type_id: type_id,
        is_ref: true,
        lifetime: lifetime,
    ))
    self.ensure_adj_capacity(id)
    self.add_edge(id, target_node_id, EDGE_BORROWS)
    return id

pub fn add_edge(mut self: ConnectionGraph, from: u32, to: u32, kind: u32):
    let edge_idx = self.edges.push(CGEdge(from: from, to: to, kind: kind))
    self.ensure_adj_capacity(from)
    self.ensure_adj_capacity(to)
    self.adj_out.data[from].push(edge_idx)
    self.adj_in.data[to].push(edge_idx)

pub fn node_of_sym(self: ConnectionGraph, sym_id: u32) -> u32:
    if (sym_id as i64) < self.sym_to_node.len:
        return self.sym_to_node.data[sym_id]
    return 0xffffffff as u32

pub fn escapes(self: ConnectionGraph, node_id: u32) -> bool:
    if self.nodes.len == 0:
        return false
    mut visited = @alloc(self.nodes.len) as ptr[bool]
    mut idx := 0 as i64
    while idx < self.nodes.len:
        visited[idx] = false
        idx = idx + 1
    
    let res = self.escape_dfs(node_id, visited)
    @free(visited as ptr[u8])
    return res

pub fn escape_dfs(self: ConnectionGraph, node_id: u32, visited: ptr[bool]) -> bool:
    if node_id == 0 as u32:
        return true
    if (node_id as i64) >= self.nodes.len:
        return false
    if visited[node_id]:
        return false
    visited[node_id] = true

    if (node_id as i64) >= self.adj_out.len:
        return false

    let out_edges = &self.adj_out.data[node_id]
    mut i := 0 as i64
    while i < out_edges.len:
        let edge_idx = out_edges.data[i]
        let edge = self.edges.data[edge_idx]
        if edge.kind == EDGE_ESCAPES_TO:
            return true
        if edge.kind == EDGE_OWNS or edge.kind == EDGE_FLOWS_TO:
            if self.escape_dfs(edge.to, visited):
                return true
        i = i + 1
    return false
// bootstrap/stage1/ownership.ax
// OwnershipChecker checks single ownership, moves, and mutability.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32
extern "C" fn exit(code: i32)

pub struct OwnershipChecker:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub errors: u32
    // RFC 0014 P1: true iff the program declares ANY `<Type>.drop(self)` method.
    // Computed once in check(); when false, the per-site copy-of-drop scan is
    // skipped entirely (the common case â€” no drop types => zero overhead, inert).
    pub has_drop_types: bool

pub fn new_ownership_checker(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[OwnershipChecker]:
    let oc = @alloc(@compiler_intrinsic("size_of")[OwnershipChecker]()) as ptr[OwnershipChecker]
    oc.tree = tree
    oc.pool = pool
    oc.symtable = symtable
    oc.typetable = typetable
    oc.errors = 0 as u32
    oc.has_drop_types = false
    return oc

pub fn check(mut self: ptr[OwnershipChecker]):
    // RFC 0014 P1: detect once whether any `<Type>.drop(self)` method exists.
    // Only then does check_drop_copy run its per-site scan (see type_has_drop).
    self.has_drop_types = self.scan_has_drop()
    self.check_node(0 as u32)
    if self.errors > 0 as u32:
        ax_puts_local("Ownership check failed.")
        exit(1)

pub fn check_node(mut self: ptr[OwnershipChecker], node_idx: u32):
    // RFC 0015 P1 (BUG#69): this pass is now ACTIVE as a mutability-only checker.
    // The guard previously also returned on `node_idx == 0`, but node 0 is the real
    // NODE_PROGRAM root (ast.ax::new_ast_tree) -- so the whole pass was a no-op.
    // Only 0xffffffff is a genuine sentinel; recursive descents already filter
    // `!= 0` at every call site before recursing, so the root is the only place the
    // old `== 0` clause mattered, and dropping it is what turns the pass on.
    //
    // MOVE-checking is intentionally NOT enabled: AXIOM aggregates have alias/copy
    // semantics (RFC 0010), not move semantics, so `check_move` is a no-op (see its
    // body) and the E4001 path below never fires. Only the E4002 immutable-assign
    // check is live. Escape analysis + CTGC free remain deferred (RFC 0015 P2/P3).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_VAR_DECL:
        let init_idx = node.first_child
        if init_idx != 0 as u32:
            self.check_node(init_idx)
            self.check_move(init_idx)
            self.check_drop_copy(node_idx, init_idx)

    elif kind == NODE_ASSIGN_STMT:
        let lhs_idx = node.first_child
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        self.check_node(lhs_idx)
        self.check_node(rhs_idx)

        if lhs_idx != 0 as u32:
            let lhs_kind = self.tree.nodes.data[lhs_idx].kind
            if lhs_kind == NODE_IDENT:
                let sym_idx = self.tree.nodes.data[lhs_idx].payload
                if sym_idx != 0 as u32:
                    let sym = self.symtable.symbols.data[sym_idx]
                    if (sym.flags & SYM_FLAG_MUT) == 0 as u16:
                        let tok = self.tree.tokens.data[node.token_idx]
                        ax_printf_local("error[E4002]: cannot assign to immutable variable at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        self.errors = self.errors + 1 as u32

            self.check_move(rhs_idx)
            self.check_drop_copy(node_idx, rhs_idx)

    elif kind == NODE_IDENT:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            if (sym.flags & SYM_FLAG_MOVED) != 0 as u16:
                let tok = self.tree.tokens.data[node.token_idx]
                ax_printf_local("error[E4001]: use of moved value at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                self.errors = self.errors + 1 as u32

    elif kind == NODE_CALL_EXPR:
        mut arg_idx := node.first_child
        if arg_idx != 0 as u32:
            self.check_node(arg_idx)
            arg_idx = self.tree.nodes.data[arg_idx].next_sibling
            while arg_idx != 0 as u32:
                self.check_node(arg_idx)
                self.check_move(arg_idx)
                arg_idx = self.tree.nodes.data[arg_idx].next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.check_node(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn check_move(mut self: ptr[OwnershipChecker], node_idx: u32):
    // RFC 0015 P1 (BUG#69): intentionally a NO-OP. AXIOM aggregates are copy/alias
    // values (RFC 0010), not move-only, so binding/passing one does NOT consume it.
    // The previous body marked every struct/sum/option/result/generic-inst use as
    // SYM_FLAG_MOVED, which -- once the pass actually ran -- flagged ~258 valid
    // read-only reuses across the stdlib + compiler as `E4001 use of moved value`.
    // Real move semantics would need a language-level RFC (RFC 0015 Â§4.1); until
    // then this stays inert and only the E4002 mutability check is enforced.
    return

// RFC 0014 P1 (drop-glue double-free guard): unwrap ptr/ref layers of a type.
// Mirrors air_builder.ax::op_unwrap_type but reads this pass's own typetable.
fn ownership_unwrap_type(self: ptr[OwnershipChecker], t: u32) -> u32:
    mut u := t
    mut e := self.typetable.entries.data[u as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        u = e.extra as u32
        e = self.typetable.entries.data[u as i64]
    return u

// RFC 0014 P1: one-time scan â€” does ANY `<Type>.drop(self)` method exist in the
// program? Uses the same mangled-name match as air_builder.ax::resolve_drop_method
// (an inline `fn drop(self)` carries a dotted mangled name resolve_method_sym misses).
fn scan_has_drop(self: ptr[OwnershipChecker]) -> bool:
    let method_id = self.pool.intern("drop")
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.pool, sym.name_id, method_id):
            let t_entry = self.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len == 1 as i64:
                    return true
        i = i + 1 as i64
    return false

// RFC 0014 P1: is `rec_type` a VALUE aggregate whose type declares `drop(self)`?
// A pointer/ref receiver is NOT a value copy (copying `ptr[T]` copies the pointer,
// and pointer-typed locals are never CTGC-freed) -> only flag direct value types.
// The drop method's self param may be `self`(value) OR `ptr[T]`, so unwrap the param
// and compare to the value receiver type.
fn type_has_drop(self: ptr[OwnershipChecker], rec_type: u32) -> bool:
    if rec_type == 0 as u32 or (rec_type as i64) >= self.typetable.entries.len:
        return false
    let re = self.typetable.entries.data[rec_type as i64]
    if re.kind == TYPE_KIND_POINTER or re.kind == TYPE_KIND_REF:
        return false
    let method_id = self.pool.intern("drop")
    mut i := 0 as i64
    while i < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.pool, sym.name_id, method_id):
            let t_entry = self.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len == 1 as i64:
                    let fp = self.ownership_unwrap_type(fi.params.data[0] as u32)
                    if fp == rec_type:
                        return true
        i = i + 1 as i64
    return false

// RFC 0014 P1: reject an implicit copy-by-value of a `drop`-typed value.
// `let b = a` / `mut b := a` / `b = a` where `a` is a NAMED variable whose type
// declares `drop(self)` would alias the resource-owning fields into TWO live
// locals -> a double-drop (or, masked by escape analysis, a silently-skipped
// drop). AXIOM has no explicit move, so â€” like Rust's `Drop` types not being
// `Copy` â€” such copies are forbidden and must be restructured (construct in place,
// pass by `ptr[T]`, or free explicitly). Narrow by design: only a bare IDENT rhs
// of a non-pointer drop type. Inert unless the program declares a drop method.
fn check_drop_copy(mut self: ptr[OwnershipChecker], stmt_idx: u32, rhs_idx: u32):
    if not self.has_drop_types:
        return
    if rhs_idx == 0 as u32 or rhs_idx == 0xffffffff as u32:
        return
    let rnode = self.tree.nodes.data[rhs_idx]
    if rnode.kind != NODE_IDENT:
        return
    let sym_idx = rnode.payload
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symtable.symbols.len:
        return
    let sym = self.symtable.symbols.data[sym_idx as i64]
    if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
        return
    if self.type_has_drop(sym.type_id):
        let tok = self.tree.tokens.data[self.tree.nodes.data[stmt_idx as i64].token_idx]
        ax_printf_local("error[E4003]: cannot copy a value whose type has a `drop` method (would double-drop) at offset %d\n", tok.offset as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        self.errors = self.errors + 1 as u32
// bootstrap/stage1/escape.ax
// EscapeAnalyser performs escape analysis using ConnectionGraph.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct EscapeAnalyser:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub curr_cg: ConnectionGraph
    pub escape_node_idx: u32
    // RFC 0015 P3: per-node resolved result types (from TypeChecker.node_types), used
    // to tell a scalar field/index read (value copy, base does not escape) from an
    // aggregate read (aliases the base). node_types_cap bounds the array.
    pub node_types: ptr[u32]
    pub node_types_cap: i64

pub fn new_escape_analyser(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable], node_types: ptr[u32], node_types_cap: i64) -> ptr[EscapeAnalyser]:
    let ea = @alloc(@compiler_intrinsic("size_of")[EscapeAnalyser]()) as ptr[EscapeAnalyser]
    ea.tree = tree
    ea.pool = pool
    ea.symtable = symtable
    ea.typetable = typetable
    ea.curr_cg = new_connection_graph()
    ea.escape_node_idx = 0 as u32
    ea.node_types = node_types
    ea.node_types_cap = node_types_cap
    return ea

// RFC 0015 P3: true iff `expr_idx`'s resolved result type is a scalar PRIMITIVE.
// Unresolved (0 / out of range) => false (treat conservatively as aggregate).
pub fn ea_result_is_scalar(self: ptr[EscapeAnalyser], expr_idx: u32) -> bool:
    if self.node_types == null as ptr[u32]:
        return false
    if (expr_idx as i64) >= self.node_types_cap:
        return false
    let rt = self.node_types[expr_idx as i64]
    if rt == 0 as u32 or (rt as i64) >= self.typetable.entries.len:
        return false
    return self.typetable.entries.data[rt].kind == TYPE_KIND_PRIMITIVE

pub fn run(mut self: ptr[EscapeAnalyser]):
    self.curr_cg = new_connection_graph()
    self.escape_node_idx = 0 as u32
    self.traverse_nodes(0 as u32)
    // curr_cg is a valid (empty) graph here: every NODE_FUNC_DECL frees its own
    // per-function graph and resets curr_cg back to an empty one, so this final
    // free never touches dangling buffers.
    free_connection_graph(self.curr_cg)

pub fn traverse_nodes(mut self: ptr[EscapeAnalyser], node_idx: u32):
    // RFC 0015 P2: guard fixed to allow traversal of the real root (node 0).
    // Recursive descent already filters `!= 0` at every call site, so only the
    // 0xffffffff sentinel is needed here (node 0 is the real NODE_PROGRAM root).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_FUNC_DECL:
        // Build a fresh connection graph for this function. Functions are never
        // nested in AXIOM, so there is no outer graph to save/restore -- the old
        // `let old_cg = self.curr_cg; ...; self.curr_cg = old_cg` dance was written
        // for value-copy semantics, but AXIOM aggregates ALIAS (RFC 0010), so it
        // left curr_cg pointing at just-freed buffers and crashed the final free.
        self.curr_cg = new_connection_graph()
        self.escape_node_idx = self.curr_cg.add_value_node(0 as u32, 0 as u32, 0 as u32)

        // Register parameters
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_PARAM_DECL:
                let sym_idx = child.payload
                if sym_idx != 0 as u32:
                    let sym = self.symtable.symbols.data[sym_idx]
                    self.curr_cg.add_value_node(sym_idx, sym.type_id, 0 as u32)
            child_idx = child.next_sibling

        // Analyze function body
        child_idx = node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            child_idx = child.next_sibling

        // Tag local variables that escape
        mut idx := 0 as i64
        while idx < self.curr_cg.nodes.len:
            let cg_node = self.curr_cg.nodes.data[idx]
            if cg_node.sym_id != 0 as u32:
                let sym_idx = cg_node.sym_id
                let is_escaping = self.curr_cg.escapes(cg_node.id)
                if is_escaping:
                    // RFC 0015 P2: mark the escaping local in the SYM-flag space at
                    // SYM_FLAG_ESCAPES (4096), NOT the node-space FLAG_ESCAPES_TO_HEAP
                    // (128) -- that value collides with SYM_FLAG_MOVED and would make
                    // ownership.ax emit E4001 on every use. This flag has no consumer
                    // yet (CTGC free = P3), so setting it stays fixpoint-neutral (A==B);
                    // it is the substrate the P3 whitelist will read.
                    self.symtable.symbols.data[sym_idx].flags = self.symtable.symbols.data[sym_idx].flags | SYM_FLAG_ESCAPES
            idx = idx + 1

        // Free this function's graph and reset curr_cg to a valid empty graph so
        // the next function (and run()'s final free) never see dangling buffers.
        free_connection_graph(self.curr_cg)
        self.curr_cg = new_connection_graph()

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.traverse_nodes(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn analyze_block(mut self: ptr[EscapeAnalyser], block_idx: u32):
    if block_idx == 0 as u32 or block_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[block_idx]
    mut child_idx := node.first_child
    while child_idx != 0 as u32:
        self.analyze_stmt(child_idx)
        child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn expr_is_owning(self: ptr[EscapeAnalyser], init_idx: u32) -> bool:
    // A value OWNS fresh single-owner memory only when it constructs a new aggregate:
    // a struct/array literal, or a `Name(...)` call where Name resolves to a struct type
    // (in AXIOM `Box(f: v)` parses as a CALL_EXPR, not a STRUCT_LIT). Any other expression
    // (ident=alias, INDEX/FIELD=borrow into longer-lived memory RFC 0010 Â§9, ordinary
    // call=maybe a borrow) is NON-owning: the value aliases memory CTGC must never free.
    let init_kind = self.tree.nodes.data[init_idx].kind
    mut is_owning := init_kind == NODE_STRUCT_LIT or init_kind == NODE_ARRAY_LIT
    if init_kind == NODE_CALL_EXPR:
        let callee_idx = self.tree.nodes.data[init_idx].first_child
        if callee_idx != 0 as u32:
            let callee = self.tree.nodes.data[callee_idx]
            if callee.kind == NODE_IDENT and callee.payload != 0 as u32:
                if self.symtable.symbols.data[callee.payload].kind == SYM_STRUCT:
                    is_owning = true
    return is_owning

pub fn analyze_stmt(mut self: ptr[EscapeAnalyser], stmt_idx: u32):
    if stmt_idx == 0 as u32 or stmt_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[stmt_idx]
    let kind = node.kind

    if kind == NODE_VAR_DECL:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            let cg_idx = self.curr_cg.add_value_node(sym_idx, sym.type_id, 0 as u32)
            let init_idx = node.first_child
            if init_idx != 0 as u32:
                // RFC 0015 P2/P3 (ownership-origin soundness, prerequisite for P3 free):
                // a local only OWNS fresh, single-owner memory when its initialiser
                // constructs a new aggregate. Owning initialisers:
                //   * a struct/array literal (NODE_STRUCT_LIT / NODE_ARRAY_LIT), and
                //   * a constructor call `Name(...)` where `Name` resolves to a struct
                //     type (SYM_STRUCT) -- in AXIOM `Box(f: v)` parses as a CALL_EXPR,
                //     not a STRUCT_LIT, so without this every struct construction would
                //     be treated as a borrow and P3 would free nothing.
                // Any OTHER initialiser makes the local BORROW/ALIAS longer-lived memory
                // that CTGC must never free (ident=alias, INDEX/FIELD=borrow into a
                // longer-lived aggregate RFC 0010 Â§9, ordinary call=maybe a borrow, no
                // interprocedural analysis). Flow such locals to the escape node so
                // escapes()=true and P3 refuses to free them.
                if not self.expr_is_owning(init_idx):
                    self.curr_cg.add_edge(cg_idx, self.escape_node_idx, EDGE_FLOWS_TO)
                self.analyze_expr(init_idx, cg_idx)

    elif kind == NODE_ASSIGN_STMT:
        let lhs_idx = node.first_child
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        if lhs_idx != 0 as u32:
            let lhs_kind = self.tree.nodes.data[lhs_idx].kind
            if lhs_kind == NODE_IDENT:
                let sym_idx = self.tree.nodes.data[lhs_idx].payload
                if sym_idx != 0 as u32:
                    let lhs_cg_idx = self.curr_cg.node_of_sym(sym_idx)
                    if lhs_cg_idx != 0xffffffff as u32:
                        self.analyze_expr(rhs_idx, lhs_cg_idx)
                        // RFC 0015 P3 soundness (reassign-to-borrow): an owned local
                        // REASSIGNED to a NON-owning RHS (a borrow: index/field read,
                        // ident alias, or ordinary call) now ALIASES longer-lived memory,
                        // so it must escape -- otherwise CTGC would free the borrowed
                        // backing at block end (UAF). Mirrors the VAR_DECL owning-origin
                        // rule. Real case: `dst_alloc = allocs[v]` in x86_regalloc.ax made
                        // the ctor-init'd dst_alloc alias the allocs vector while the escape
                        // graph still saw it as freeable. Conservative (worst case = free
                        // LESS, never a UAF); a reassignment to a fresh ctor stays owning.
                        if not self.expr_is_owning(rhs_idx):
                            self.curr_cg.add_edge(lhs_cg_idx, self.escape_node_idx, EDGE_FLOWS_TO)
                    else:
                        // RFC 0015 P3 soundness: the LHS ident is NOT a tracked local
                        // (a module global, or a binding outside this function's graph),
                        // which outlives the function -- so the RHS ESCAPES. Without this
                        // `g = x` let `x` look non-escaping and CTGC would free memory the
                        // global still points at (UAF).
                        self.analyze_expr(rhs_idx, self.escape_node_idx)
                else:
                    self.analyze_expr(rhs_idx, self.escape_node_idx)
            else:
                // non-ident LHS means struct field or indexing, RHS escapes to heap
                self.analyze_expr(rhs_idx, self.escape_node_idx)

    elif kind == NODE_RETURN_STMT:
        let val_idx = node.first_child
        if val_idx != 0 as u32:
            self.analyze_expr(val_idx, self.escape_node_idx)

    elif kind == NODE_CALL_EXPR:
        // RFC 0015 P3 soundness (container-store escape): a bare call statement
        // (`container.push(local)`, `vec.insert(x)`, `emit(inst)`) discards its value
        // but may STORE an argument into a receiver that outlives the call. Route it
        // through analyze_expr's CALL_EXPR case so the callee + every by-value argument
        // flow to the escape node -> a ctor local handed to a container mutator is marked
        // escaping and CTGC never frees memory the container still aliases. Without this
        // the call sits at statement position and the else-branch (mis)visits its arg
        // nodes as STATEMENTS (analyze_stmt has no NODE_IDENT case) so they never flow ->
        // the missed-escape that made v_exp/exp/init_inst wrongly freeable (would UAF at
        // -ctgc-free activation, e.g. `(&mod.exports).push(v_exp)`). Inert on the default
        // build (SYM_FLAG_ESCAPES is only consumed by the gated-off CTGC free pass).
        self.analyze_expr(stmt_idx, self.escape_node_idx)

    elif kind == NODE_IF_STMT:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            else:
                self.analyze_stmt(child_idx)
            child_idx = child.next_sibling

    elif kind == NODE_WHILE_STMT or kind == NODE_FOR_STMT:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            child_idx = child.next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.analyze_stmt(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn analyze_expr(mut self: ptr[EscapeAnalyser], expr_idx: u32, flow_dest: u32):
    if expr_idx == 0 as u32 or expr_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[expr_idx]
    let kind = node.kind

    if kind == NODE_IDENT:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let cg_src = self.curr_cg.node_of_sym(sym_idx)
            if cg_src != 0xffffffff as u32 and flow_dest != 0xffffffff as u32:
                self.curr_cg.add_edge(cg_src, flow_dest, EDGE_FLOWS_TO)

    elif kind == NODE_CALL_EXPR:
        // Function call: arguments flow to return/escape
        mut child_idx := node.first_child
        if child_idx != 0 as u32:
            // First is callee
            self.analyze_expr(child_idx, self.escape_node_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
            while child_idx != 0 as u32:
                self.analyze_expr(child_idx, self.escape_node_idx)
                child_idx = self.tree.nodes.data[child_idx].next_sibling

    elif kind == NODE_STRUCT_LIT:
        // Struct literal fields flow to the struct dest
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            let val_idx = child.first_child
            if val_idx != 0 as u32:
                self.analyze_expr(val_idx, flow_dest)
            child_idx = child.next_sibling

    elif kind == NODE_FIELD_EXPR or kind == NODE_INDEX_EXPR:
        // RFC 0015 P3 flow refinement: a SCALAR (PRIMITIVE) field/element read of a
        // simple local yields a VALUE COPY -- the base aggregate does NOT escape
        // through it, so P3 may still free the base. Only an aggregate-typed (or
        // unresolved) read aliases into the base and must propagate escape.
        // Conservative on two axes (worst case = free LESS, never a UAF):
        //   * unresolved result type -> treated as aggregate (propagate), and
        //   * only a base that is a plain IDENT is exempted; a complex base
        //     (e.g. `f().field`) falls through to normal propagation.
        let base_idx = node.first_child
        mut base_is_ident := false
        if base_idx != 0 as u32:
            base_is_ident = self.tree.nodes.data[base_idx].kind == NODE_IDENT
        if self.ea_result_is_scalar(expr_idx) and base_is_ident:
            // scalar read of `local.field` / `local[i]`: do NOT flow the base to
            // dest. Still analyse an index operand (it may contain escaping calls).
            if kind == NODE_INDEX_EXPR:
                let idx_operand = self.tree.nodes.data[base_idx].next_sibling
                self.analyze_expr(idx_operand, flow_dest)
        else:
            mut child_idx := node.first_child
            while child_idx != 0 as u32:
                self.analyze_expr(child_idx, flow_dest)
                child_idx = self.tree.nodes.data[child_idx].next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.analyze_expr(child_idx, flow_dest)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
// bootstrap/stage1/ctgc.ax
// Compile-Time Garbage Collection (CTGC) injector.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct CtgcInjector:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub active_vars: U32Vec // Stack of active sym_idx's
    pub active_var_decls: U32Vec // Stack of AST node decl indices
    pub free_enabled: bool // RFC 0015 P3: -ctgc-free opt-in; OFF => whole pass is inert
    pub report_only: bool // RFC 0015 P3 precursor: -ctgc-free-report â€” PRINT the freeable set, inject nothing (dump-only, byte-identical output)

pub fn new_ctgc_injector(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[CtgcInjector]:
    let ci = @alloc(@compiler_intrinsic("size_of")[CtgcInjector]()) as ptr[CtgcInjector]
    ci.tree = tree
    ci.pool = pool
    ci.symtable = symtable
    ci.typetable = typetable
    ci.active_vars = new_u32_vec()
    ci.active_var_decls = new_u32_vec()
    ci.free_enabled = false
    ci.report_only = false
    return ci

pub fn run(mut self: ptr[CtgcInjector]):
    // RFC 0015 P3: the whole pass is opt-in behind -ctgc-free. With BOTH flags OFF
    // (the default, incl. the self-host build) run() returns immediately and no
    // OP_DESTROY is injected, so output is byte-identical to the historical no-op
    // (fixpoint A==B). -ctgc-free ON => compile-time free activates. -ctgc-free-report
    // ON => the traversal runs but only PRINTS the freeable set (no tree mutation,
    // still byte-identical output) â€” the P3 measurement precursor.
    if not self.free_enabled and not self.report_only:
        return
    self.traverse_and_inject(0 as u32, 0 as u32)

// A local is freeable (CTGC may free it) iff it is a NON-escaping heap aggregate.
// Reads SYM_FLAG_ESCAPES (4096, sym-flag space) set by the EscapeAnalyser -- NOT the
// old FLAG_ESCAPES_TO_HEAP (128), which aliases SYM_FLAG_MOVED. Factored out so the
// block-fall-through pass and (future) callers share ONE predicate; the logic is
// byte-identical to the original inline collect so fall-through free is unchanged.
pub fn is_freeable_local(self: ptr[CtgcInjector], sym_idx: u32) -> bool:
    if sym_idx == 0 as u32:
        return false
    let sym = self.symtable.symbols.data[sym_idx]
    if (sym.flags & SYM_FLAG_ESCAPES) != 0 as u16:
        return false
    let type_id = sym.type_id
    if type_id == 0 as u32 or (type_id as i64) >= self.typetable.entries.len:
        return false
    let entry = self.typetable.entries.data[type_id]
    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
        return true
    return false

pub fn traverse_and_inject(mut self: ptr[CtgcInjector], node_idx: u32, parent_idx: u32):
    // Guard: node 0 is the real NODE_PROGRAM root (ast.ax::new_ast_tree), so the
    // historical `node_idx == 0` clause made the pass a permanent no-op. Recursive
    // descents already filter `!= 0` at every call site, so only 0xffffffff is a
    // genuine sentinel. Reached only when free_enabled (gated in run()).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_BLOCK:
        let start_len = self.active_vars.len

        // Single ORDERED pass (RFC 0015 P3 return-path free): descend into each child,
        // then push a freeable var AFTER its decl has been passed, so `active_vars`
        // reflects program order -- a local is on the stack only once its declaration
        // has been descended past. This is what makes return-path free sound: at a
        // NODE_RETURN_STMT (handled below) the ENTIRE stack is provably initialised, so
        // freeing it never touches a not-yet-declared local. The freeable SET and the
        // reverse (LIFO) destroy order at fall-through are identical to the old
        // two-pass collect, so the shipped fall-through free is byte-unchanged.
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let ck = self.tree.nodes.data[child_idx].kind
            let cpay = self.tree.nodes.data[child_idx].payload
            self.traverse_and_inject(child_idx, node_idx)
            if ck == NODE_VAR_DECL:
                if self.is_freeable_local(cpay):
                    self.active_vars.push(cpay)
                    self.active_var_decls.push(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

        // Inject destroy statements for THIS block's vars at fall-through (block end).
        let num_block_vars = self.active_vars.len - start_len
        if num_block_vars > 0 as i64:
            mut idx := self.active_vars.len - 1 as i64
            while idx >= start_len:
                let sym_idx = self.active_vars.data[idx]
                if self.report_only:
                    // Dump-only precursor: PRINT the freeable local, mutate nothing.
                    // Enumerates the freeable set across the compiled program so the
                    // future activation session can inspect the (currently un-enumerated)
                    // borrow-alias blast radius. See [[ctgc-p3-scoping-2026-07-18]].
                    let sym = self.symtable.symbols.data[sym_idx]
                    let nm = self.pool.get_str(sym.name_id)
                    ax_puts_local(std.string.concat("[ctgc-freeable] ", nm))
                else:
                    // Create NODE_DESTROY_STMT node
                    let destroy_node = self.tree.add_node(NODE_DESTROY_STMT, node.token_idx)
                    self.tree.nodes.data[destroy_node].payload = sym_idx
                    self.append_child_node(node_idx, destroy_node)
                idx = idx - 1

            // Pop them from stack
            self.active_vars.len = start_len
            self.active_var_decls.len = start_len

    elif kind == NODE_RETURN_STMT:
        // RFC 0015 P3 return-path free. A `return` exits ALL enclosing scopes, so every
        // currently-live freeable local must be freed on this path too -- otherwise a
        // local live on a return path leaks (the old fall-through-only behaviour). We
        // append the destroys as TRAILING children of the return node; lower_return
        // lowers them AFTER the return value is materialised, so `return r.field` reads
        // `r` before `r` is freed (no UAF -- the reason we do NOT inject a plain destroy
        // *before* the return). Every stack entry is provably initialised here
        // (ordered-descent above), and the EscapeAnalyser has already excluded any local
        // whose memory can reach the return value (t_ctgcfreeesc pins that). report_only
        // must stay byte-identical (no tree mutation), so it appends nothing.
        let val_child = node.first_child
        if val_child != 0 as u32:
            self.traverse_and_inject(val_child, node_idx)
        if self.free_enabled and self.active_vars.len > 0 as i64:
            mut ri := self.active_vars.len - 1 as i64
            while ri >= 0 as i64:
                let sym_idx = self.active_vars.data[ri]
                let destroy_node = self.tree.add_node(NODE_DESTROY_STMT, node.token_idx)
                self.tree.nodes.data[destroy_node].payload = sym_idx
                self.append_child_node(node_idx, destroy_node)
                ri = ri - 1 as i64

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.traverse_and_inject(child_idx, node_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn append_child_node(mut self: ptr[CtgcInjector], parent: u32, child: u32):
    if self.tree.nodes.data[parent].first_child == 0 as u32:
        self.tree.nodes.data[parent].first_child = child
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while self.tree.nodes.data[cur].next_sibling != 0 as u32:
        cur = self.tree.nodes.data[cur].next_sibling
    self.tree.nodes.data[cur].next_sibling = child

pub fn insert_before(mut self: ptr[CtgcInjector], parent: u32, target: u32, new_node: u32):
    if self.tree.nodes.data[parent].first_child == target:
        self.tree.nodes.data[new_node].next_sibling = target
        self.tree.nodes.data[parent].first_child = new_node
        return
    mut cur := self.tree.nodes.data[parent].first_child
    while cur != 0 as u32:
        if self.tree.nodes.data[cur].next_sibling == target:
            self.tree.nodes.data[new_node].next_sibling = target
            self.tree.nodes.data[cur].next_sibling = new_node
            return
        cur = self.tree.nodes.data[cur].next_sibling
// bootstrap/stage1/alias_reuse.ax
// AliasReuseOptimizer optimizes adjacent destroy and alloc pairs into NODE_ALIAS_STMT.


pub struct AliasReuseOptimizer:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]

pub fn new_alias_reuse_optimizer(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[AliasReuseOptimizer]:
    let aro = @alloc(@compiler_intrinsic("size_of")[AliasReuseOptimizer]()) as ptr[AliasReuseOptimizer]
    aro.tree = tree
    aro.pool = pool
    aro.symtable = symtable
    aro.typetable = typetable
    return aro

pub fn run(mut self: ptr[AliasReuseOptimizer]):
    self.optimize_node(0 as u32)

pub fn optimize_node(mut self: ptr[AliasReuseOptimizer], node_idx: u32):
    if node_idx == 0xffffffff as u32 or node_idx == 0 as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_BLOCK:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_DESTROY_STMT:
                let next_idx = child.next_sibling
                if next_idx != 0 as u32:
                    let next_node = self.tree.nodes.data[next_idx]
                    if next_node.kind == NODE_VAR_DECL:
                        // Found adjacent destroy and allocation!
                        let destroy_sym = child.payload
                        let alloc_sym = next_node.payload
                        if destroy_sym != 0 as u32 and alloc_sym != 0 as u32:
                            let sym_d = self.symtable.symbols.data[destroy_sym]
                            let sym_a = self.symtable.symbols.data[alloc_sym]
                            if sym_d.type_id == sym_a.type_id:
                                // Optimize by converting to NODE_ALIAS_STMT!
                                // For simplicity, we flag FlagUsesArena or custom reuse in the AST.
                                self.tree.nodes.data[next_idx].flags = self.tree.nodes.data[next_idx].flags | (FLAG_IS_MOVED as u16)
            
            self.optimize_node(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.optimize_node(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
// bootstrap/stage1/air.ax
// SSA-form Intermediate Representation (AIR) structures and builders for the self-hosted AXIOM compiler frontend.

pub const OP_NOP: u16 = 0x0000

// Memory class (0x01xx)
pub const OP_ALLOC: u16 = 0x0101
pub const OP_FREE: u16 = 0x0102
pub const OP_LOAD: u16 = 0x0103
pub const OP_STORE: u16 = 0x0104
pub const OP_GEP: u16 = 0x0105
pub const OP_COPY: u16 = 0x0106
pub const OP_MOVE: u16 = 0x0107
pub const OP_MAKE_REF: u16 = 0x0108
pub const OP_DEREF: u16 = 0x0109
pub const OP_ARENA_ALLOC: u16 = 0x010A
pub const OP_DESTROY: u16 = 0x010B
pub const OP_ALIAS_REUSE: u16 = 0x010C
pub const OP_GET_FIELD: u16 = 0x010D
pub const OP_SET_FIELD: u16 = 0x010E
pub const OP_INDEX: u16 = 0x010F
pub const OP_SLICE: u16 = 0x0110
// Address of an array/pointer element (`&a[i]`): computes base + i*elem_size and
// returns that ADDRESS, never loading the element. OP_INDEX loads scalars, so
// `&scalar[i]` lowered as OP_INDEX+OP_MAKE_REF took the address of a TEMPORARY
// holding the loaded value instead of the element's lvalue (BUG#84). Scoped to
// scalar elements; aggregate `&agg[i]` still uses OP_INDEX (already returns the
// element address) + OP_MAKE_REF pass-through.
pub const OP_INDEX_ADDR: u16 = 0x0111
// Address of a struct field (`&s.f`): computes base + field_offset via LEA and
// returns that ADDRESS, never loading the field. Twin of OP_INDEX_ADDR for the
// `&s.scalar_field` case (BUG#85); aggregate `&s.aggfield` still uses OP_GET_FIELD
// (already returns the field address) + OP_MAKE_REF pass-through.
pub const OP_FIELD_ADDR: u16 = 0x0112
// Address of a module-level global variable (RFC 0017 / BUG#82). Materializes the
// global's static-storage address via `lea reg,[rip+gsym]` + RELOC_PC32 (structurally
// identical to OP_FUNC_ADDR). src1 carries the global's symbol-table index; the backend
// registers a writable-data symbol under that index and the linker resolves the reloc to
// the global's image RVA. A global read composes OP_GLOBAL_ADDR + OP_LOAD; a global write
// composes OP_GLOBAL_ADDR + OP_STORE.
pub const OP_GLOBAL_ADDR: u16 = 0x0113

// ALU class (0x02xx)
pub const OP_ICONST: u16 = 0x0201
pub const OP_FCONST: u16 = 0x0202
pub const OP_IADD: u16 = 0x0203
pub const OP_ISUB: u16 = 0x0204
pub const OP_IMUL: u16 = 0x0205
pub const OP_IDIV: u16 = 0x0206
pub const OP_IMOD: u16 = 0x0207
pub const OP_FADD: u16 = 0x0208
pub const OP_FSUB: u16 = 0x0209
pub const OP_FMUL: u16 = 0x020A
pub const OP_FDIV: u16 = 0x020B
pub const OP_EQ: u16 = 0x020C
pub const OP_NE: u16 = 0x020D
pub const OP_LT: u16 = 0x020E
pub const OP_LE: u16 = 0x020F
pub const OP_GT: u16 = 0x0210
pub const OP_GE: u16 = 0x0211
pub const OP_AND: u16 = 0x0212
pub const OP_OR: u16 = 0x0213
pub const OP_XOR: u16 = 0x0214
pub const OP_SHL: u16 = 0x0215
pub const OP_SHR: u16 = 0x0216
pub const OP_NOT: u16 = 0x0217
pub const OP_NEG: u16 = 0x021D
pub const OP_ITOF: u16 = 0x021E
pub const OP_FTOI: u16 = 0x021F
pub const OP_ZEXT: u16 = 0x0220
pub const OP_SEXT: u16 = 0x0221
pub const OP_TRUNC: u16 = 0x0222
pub const OP_CAST: u16 = 0x0223

// Control class (0x03xx)
pub const OP_JUMP: u16 = 0x0301
pub const OP_BRANCH: u16 = 0x0302
pub const OP_CALL: u16 = 0x0303
pub const OP_RETURN: u16 = 0x0304
pub const OP_PHI: u16 = 0x0305
pub const OP_LOOP_BEGIN: u16 = 0x0306
pub const OP_LOOP_END: u16 = 0x0307
pub const OP_SPAWN: u16 = 0x0308
pub const OP_SEND: u16 = 0x0309
pub const OP_RECV: u16 = 0x030A
pub const OP_AWAIT: u16 = 0x030B
pub const OP_SYSCALL: u16 = 0x030C
// Address of a top-level function (function pointer). type_id carries the
// function's SYMBOL index (same convention as a direct OP_CALL's type_id).
pub const OP_FUNC_ADDR: u16 = 0x030D

// SIMD class (0x04xx)
pub const OP_SIMD_LOAD: u16 = 0x0401
pub const OP_SIMD_STORE: u16 = 0x0402
pub const OP_SIMD_ADD: u16 = 0x0403
pub const OP_SIMD_MUL: u16 = 0x0404
pub const OP_SIMD_FMA: u16 = 0x0405

// Comptime class (0x05xx)
pub const OP_COMPTIME: u16 = 0x0501

// AirInst struct. Layout is FROZEN at 16 bytes.
pub struct AirInst:
    pub opcode: u16
    pub type_id: u16
    pub dest: u32
    pub src1: u32
    pub src2: u32

// Custom monomorphic vectors for AIR builder
pub struct AirInstVec:
    pub data: ptr[AirInst]
    pub len: i64
    pub cap: i64

pub fn new_air_inst_vec() -> AirInstVec:
    return AirInstVec(data: null as ptr[AirInst], len: 0, cap: 0)

pub fn push(mut self: AirInstVec, inst: AirInst) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let inst_size = @compiler_intrinsic("size_of")[AirInst]() as i64
        let new_data = @alloc(new_cap * inst_size) as ptr[AirInst]
        if self.data != null as ptr[AirInst]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * inst_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = inst
    self.len = self.len + 1
    return idx

pub struct BasicBlock:
    pub id: u32
    pub instrs_start: u32
    pub instrs_len: u32
    pub succs_start: u32
    pub succs_len: u32
    pub preds_start: u32
    pub preds_len: u32
    pub loop_depth: u8
    pub is_entry: bool
    pub is_exit: bool

pub struct BasicBlockVec:
    pub data: ptr[BasicBlock]
    pub len: i64
    pub cap: i64

pub fn new_basic_block_vec() -> BasicBlockVec:
    return BasicBlockVec(data: null as ptr[BasicBlock], len: 0, cap: 0)

pub fn push(mut self: BasicBlockVec, bb: BasicBlock) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 32) as ptr[BasicBlock]
        if self.data != null as ptr[BasicBlock]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 32)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = bb
    self.len = self.len + 1
    return idx


pub struct AirFunc:
    pub sym_id: u32
    pub name: u32
    pub params: U32Vec
    pub ret_type: u32
    pub blocks: BasicBlockVec
    pub insts: AirInstVec
    pub extras: U32Vec
    pub is_async: bool
    pub is_extern: bool
    // Flat block data storage
    pub block_instrs: U32Vec
    pub block_succs: U32Vec
    pub block_preds: U32Vec

pub fn free_air_func(mut f: AirFunc):
    if f.params.data != null as ptr[u32]:
        @free(f.params.data as ptr[u8])
    if f.blocks.data != null as ptr[BasicBlock]:
        @free(f.blocks.data as ptr[u8])
    if f.insts.data != null as ptr[AirInst]:
        @free(f.insts.data as ptr[u8])
    if f.extras.data != null as ptr[u32]:
        @free(f.extras.data as ptr[u8])
    if f.block_instrs.data != null as ptr[u32]:
        @free(f.block_instrs.data as ptr[u8])
    if f.block_succs.data != null as ptr[u32]:
        @free(f.block_succs.data as ptr[u8])
    if f.block_preds.data != null as ptr[u32]:
        @free(f.block_preds.data as ptr[u8])

pub struct AirFuncVec:
    pub data: ptr[AirFunc]
    pub len: i64
    pub cap: i64

pub fn new_air_func_vec() -> AirFuncVec:
    return AirFuncVec(data: null as ptr[AirFunc], len: 0, cap: 0)

pub fn push(mut self: AirFuncVec, f: AirFunc) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[AirFunc]() as i64)) as ptr[AirFunc]
        if self.data != null as ptr[AirFunc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[AirFunc]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = f
    self.len = self.len + 1
    return idx

// RFC 0017 / BUG#82: a module-level global variable with static storage. `init_lo`
// holds the constant-folded initial value as a raw 64-bit bit-pattern (integers/bools
// zero-extended, floats as their IEEE-754 bits); only the low `size` bytes are emitted.
pub struct AirGlobal:
    pub sym_id: u32
    pub type_id: u32
    pub size: u32
    pub init_lo: i64
    // RFC 0017 P2: for a NON-constant scalar initializer, the AST node of the init
    // expression (evaluated at program entry). 0 when the initializer is a folded
    // compile-time constant (value already in `init_lo`).
    pub init_node: u32

pub struct AirGlobalVec:
    pub data: ptr[AirGlobal]
    pub len: i64
    pub cap: i64

pub fn new_air_global_vec() -> AirGlobalVec:
    return AirGlobalVec(data: null as ptr[AirGlobal], len: 0, cap: 0)

pub fn push(mut self: AirGlobalVec, g: AirGlobal) -> u32:
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * (@compiler_intrinsic("size_of")[AirGlobal]() as i64)) as ptr[AirGlobal]
        if self.data != null as ptr[AirGlobal]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * (@compiler_intrinsic("size_of")[AirGlobal]() as i64))
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = g
    self.len = self.len + 1
    return idx

pub struct AirModule:
    pub funcs: AirFuncVec
    pub globals: AirGlobalVec

pub fn free_air_module(mut m: AirModule):
    mut i := 0 as i64
    while i < m.funcs.len:
        free_air_func(m.funcs.data[i])
        i = i + 1
    if m.funcs.data != null as ptr[AirFunc]:
        @free(m.funcs.data as ptr[u8])
    if m.globals.data != null as ptr[AirGlobal]:
        @free(m.globals.data as ptr[u8])

pub struct AirFuncBuilder:
    pub name: u32
    pub ret_type: u32
    pub blocks: BasicBlockVec
    pub insts: AirInstVec
    pub extras: U32Vec
    pub cur_block: i32
    pub next_reg: u32
    // Flat block data builders
    pub block_instrs: U32Vec
    pub block_succs: U32Vec
    pub block_preds: U32Vec

pub fn new_air_func_builder(name: u32, ret_type: u32) -> ptr[AirFuncBuilder]:
    let builder = @alloc(@compiler_intrinsic("size_of")[AirFuncBuilder]()) as ptr[AirFuncBuilder]
    builder.name = name
    builder.ret_type = ret_type
    builder.blocks = new_basic_block_vec()
    builder.insts = new_air_inst_vec()
    builder.extras = new_u32_vec()
    builder.cur_block = -1 as i32
    builder.next_reg = 1 as u32
    builder.block_instrs = new_u32_vec()
    builder.block_succs = new_u32_vec()
    builder.block_preds = new_u32_vec()
    let entry_id = builder.new_block()
    builder.blocks.data[entry_id].is_entry = true
    builder.switch_to(entry_id)
    return builder

pub fn new_block(mut self: ptr[AirFuncBuilder]) -> u32:
    let id = self.blocks.len as u32
    self.blocks.push(BasicBlock(
        id: id,
        instrs_start: 0 as u32,
        instrs_len: 0 as u32,
        succs_start: 0 as u32,
        succs_len: 0 as u32,
        preds_start: 0 as u32,
        preds_len: 0 as u32,
        loop_depth: 0 as u8,
        is_entry: false,
        is_exit: false,
    ))
    return id

pub fn switch_to(mut self: ptr[AirFuncBuilder], block_id: u32):
    self.cur_block = block_id as i32

pub fn current_block(self: ptr[AirFuncBuilder]) -> u32:
    if self.cur_block < 0:
        return 0xffffffff as u32
    return self.cur_block as u32

pub fn emit(mut self: ptr[AirFuncBuilder], inst: AirInst) -> u32:
    let idx = self.insts.push(inst)
    if self.cur_block >= 0 and (self.cur_block as i64) < self.blocks.len:
        mut bb := &self.blocks.data[self.cur_block]
        if bb.instrs_len == 0:
            bb.instrs_start = self.block_instrs.len as u32
        self.block_instrs.push(idx)
        bb.instrs_len = bb.instrs_len + 1 as u32
    return idx

pub fn emit_extra(mut self: ptr[AirFuncBuilder], val: u32) -> u32:
    return self.extras.push(val)

pub fn set_extra(mut self: ptr[AirFuncBuilder], idx: u32, val: u32):
    if (idx as i64) < self.extras.len:
        self.extras.data[idx] = val

pub fn fresh_reg(mut self: ptr[AirFuncBuilder]) -> u32:
    let r = self.next_reg
    self.next_reg = self.next_reg + 1 as u32
    return r

pub fn add_edge(mut self: ptr[AirFuncBuilder], src: u32, dst: u32):
    if (src as i64) < self.blocks.len and (dst as i64) < self.blocks.len:
        mut src_bb := &self.blocks.data[src]
        if src_bb.succs_len == 0:
            src_bb.succs_start = self.block_succs.len as u32
        // Append unique to flat list
        mut exists := false
        mut i := 0 as i64
        while i < src_bb.succs_len as i64:
            let idx = src_bb.succs_start as i64 + i
            if self.block_succs.data[idx] == dst:
                exists = true
            i = i + 1
        if not exists:
            self.block_succs.push(dst)
            src_bb.succs_len = src_bb.succs_len + 1 as u32

        mut dst_bb := &self.blocks.data[dst]
        if dst_bb.preds_len == 0:
            dst_bb.preds_start = self.block_preds.len as u32
        // Append unique to flat list
        exists = false
        i = 0
        while i < dst_bb.preds_len as i64:
            let idx = dst_bb.preds_start as i64 + i
            if self.block_preds.data[idx] == src:
                exists = true
            i = i + 1
        if not exists:
            self.block_preds.push(src)
            dst_bb.preds_len = dst_bb.preds_len + 1 as u32

pub fn build_func(mut self: ptr[AirFuncBuilder]) -> AirFunc:
    // Mark exit blocks
    mut i := 0 as i64
    while i < self.blocks.len:
        mut blk := &self.blocks.data[i]
        if blk.instrs_len > 0:
            let last_idx_idx = blk.instrs_start as i64 + (blk.instrs_len as i64) - 1
            let last_idx = self.block_instrs.data[last_idx_idx] as i64
            if last_idx < self.insts.len and self.insts.data[last_idx].opcode == OP_RETURN:
                blk.is_exit = true
        i = i + 1

    return AirFunc(
        sym_id: 0 as u32,
        name: self.name,
        params: new_u32_vec(),
        ret_type: self.ret_type,
        blocks: self.blocks,
        insts: self.insts,
        extras: self.extras,
        is_async: false,
        is_extern: false,
        block_instrs: self.block_instrs,
        block_succs: self.block_succs,
        block_preds: self.block_preds,
    )

// RFC 0026 P2: rebuild block_succs/block_preds from each block's terminator,
// reproducing add_edge's EXACT ordering (validated against the as-built CFG â€” the
// codegen/liveness passes read these edges directly, so B==C depends on the order):
//   - per-block SUCC order: OP_JUMP -> [src1]; OP_BRANCH -> [src2 (true-target),
//     dest (false-target)] â€” every air_builder BRANCH site adds the true-target
//     BEFORE the false-target. Duplicate targets collapse (add_edge appends unique;
//     the only single-terminator dup is a BRANCH with src2==dest). Out-of-range
//     targets are skipped (mirrors add_edge's bounds guard).
//   - per-block PRED order: the builder adds edges in lowering order, which visits
//     source blocks in ascending block-index order, so a block's preds are its source
//     blocks in ascending index. Reproduced by scanning sources ascending.
// Needed by the multi-block inliner (inline_func) after it rewrites the block list.
pub fn recompute_cfg(mut f: ptr[AirFunc]):
    mut new_succs := new_u32_vec()
    mut new_preds := new_u32_vec()
    let n = f.blocks.len
    // Pass 1: successors, per block in index order.
    mut b := 0 as i64
    while b < n:
        mut bb := &f.blocks.data[b]
        bb.succs_start = new_succs.len as u32
        bb.succs_len = 0 as u32
        if bb.instrs_len > 0 as u32:
            let last_ii = bb.instrs_start as i64 + (bb.instrs_len as i64) - 1 as i64
            let last = f.block_instrs.data[last_ii] as i64
            let t = f.insts.data[last]
            if t.opcode == OP_JUMP:
                if (t.src1 as i64) < n:
                    new_succs.push(t.src1)
                    bb.succs_len = bb.succs_len + 1 as u32
            elif t.opcode == OP_BRANCH:
                if (t.src2 as i64) < n:
                    new_succs.push(t.src2)
                    bb.succs_len = bb.succs_len + 1 as u32
                if (t.dest as i64) < n and t.dest != t.src2:
                    new_succs.push(t.dest)
                    bb.succs_len = bb.succs_len + 1 as u32
        b = b + 1 as i64
    // Pass 2: predecessors, per dst block; scan sources in ascending index order.
    mut d := 0 as i64
    while d < n:
        mut db := &f.blocks.data[d]
        db.preds_start = new_preds.len as u32
        db.preds_len = 0 as u32
        mut s := 0 as i64
        while s < n:
            let sb = &f.blocks.data[s]
            mut k := 0 as u32
            mut has := false
            while k < sb.succs_len:
                if new_succs.data[sb.succs_start + k] == d as u32:
                    has = true
                k = k + 1 as u32
            if has:
                new_preds.push(s as u32)
                db.preds_len = db.preds_len + 1 as u32
            s = s + 1 as i64
        d = d + 1 as i64
    if f.block_succs.data != null as ptr[u32]:
        @free(f.block_succs.data as ptr[u8])
    if f.block_preds.data != null as ptr[u32]:
        @free(f.block_preds.data as ptr[u8])
    f.block_succs = new_succs
    f.block_preds = new_preds

pub fn opcode_mnemonic(op: u16) -> str:
    if op == OP_NOP:
        return "nop"
    if op == OP_ALLOC:
        return "alloc"
    if op == OP_FREE:
        return "free"
    if op == OP_LOAD:
        return "load"
    if op == OP_STORE:
        return "store"
    if op == OP_GEP:
        return "gep"
    if op == OP_COPY:
        return "copy"
    if op == OP_MOVE:
        return "move"
    if op == OP_MAKE_REF:
        return "mkref"
    if op == OP_DEREF:
        return "deref"
    if op == OP_ARENA_ALLOC:
        return "aalloc"
    if op == OP_DESTROY:
        return "destroy"
    if op == OP_ALIAS_REUSE:
        return "areuse"
    if op == OP_GET_FIELD:
        return "getfld"
    if op == OP_SET_FIELD:
        return "setfld"
    if op == OP_INDEX:
        return "index"
    if op == OP_SLICE:
        return "slice"
    if op == OP_INDEX_ADDR:
        return "idxaddr"
    if op == OP_FIELD_ADDR:
        return "fldaddr"

    if op == OP_ICONST:
        return "iconst"
    if op == OP_FCONST:
        return "fconst"
    if op == OP_IADD:
        return "iadd"
    if op == OP_ISUB:
        return "isub"
    if op == OP_IMUL:
        return "imul"
    if op == OP_IDIV:
        return "idiv"
    if op == OP_IMOD:
        return "imod"
    if op == OP_FADD:
        return "fadd"
    if op == OP_FSUB:
        return "fsub"
    if op == OP_FMUL:
        return "fmul"
    if op == OP_FDIV:
        return "fdiv"
    if op == OP_EQ:
        return "eq"
    if op == OP_NE:
        return "ne"
    if op == OP_LT:
        return "lt"
    if op == OP_LE:
        return "le"
    if op == OP_GT:
        return "gt"
    if op == OP_GE:
        return "ge"
    if op == OP_AND:
        return "and"
    if op == OP_OR:
        return "or"
    if op == OP_XOR:
        return "xor"
    if op == OP_SHL:
        return "shl"
    if op == OP_SHR:
        return "shr"
    if op == OP_NOT:
        return "not"
    if op == OP_NEG:
        return "neg"
    if op == OP_ITOF:
        return "itof"
    if op == OP_FTOI:
        return "ftoi"
    if op == OP_ZEXT:
        return "zext"
    if op == OP_SEXT:
        return "sext"
    if op == OP_TRUNC:
        return "trunc"
    if op == OP_CAST:
        return "cast"

    if op == OP_JUMP:
        return "jump"
    if op == OP_BRANCH:
        return "branch"
    if op == OP_CALL:
        return "call"
    if op == OP_RETURN:
        return "ret"
    if op == OP_PHI:
        return "phi"
    if op == OP_LOOP_BEGIN:
        return "loopbeg"
    if op == OP_LOOP_END:
        return "loopend"
    if op == OP_SPAWN:
        return "spawn"
    if op == OP_SEND:
        return "send"
    if op == OP_RECV:
        return "recv"
    if op == OP_AWAIT:
        return "await"
    if op == OP_SYSCALL:
        return "syscall"

    if op == OP_SIMD_LOAD:
        return "vload"
    if op == OP_SIMD_STORE:
        return "vstore"
    if op == OP_SIMD_ADD:
        return "vadd"
    if op == OP_SIMD_MUL:
        return "vmul"
    if op == OP_SIMD_FMA:
        return "vfma"

    if op == OP_COMPTIME:
        return "comptime"
    // These two printed as "???", which is a debuggability hole precisely where it hurts
    // most: OP_FUNC_ADDR is the instruction that creates an INDIRECT call edge, so it is
    // what anyone tracing a call graph (RFC 0031's root set) has to look for, and
    // OP_GLOBAL_ADDR is how every module-level global is reached. CLAUDE.md Â§9 requires
    // the IR to be printable.
    if op == OP_FUNC_ADDR:
        return "funcaddr"
    if op == OP_GLOBAL_ADDR:
        return "globaddr"
    return "???"

pub fn opcode_class(op: u16) -> u16:
    return op >> 8 as u16

pub fn opcode_is_binary_alu(op: u16) -> bool:
    if op == OP_IADD:
        return true
    if op == OP_ISUB:
        return true
    if op == OP_IMUL:
        return true
    if op == OP_IDIV:
        return true
    if op == OP_IMOD:
        return true
    if op == OP_FADD:
        return true
    if op == OP_FSUB:
        return true
    if op == OP_FMUL:
        return true
    if op == OP_FDIV:
        return true
    if op == OP_EQ:
        return true
    if op == OP_NE:
        return true
    if op == OP_LT:
        return true
    if op == OP_LE:
        return true
    if op == OP_GT:
        return true
    if op == OP_GE:
        return true
    if op == OP_AND:
        return true
    if op == OP_OR:
        return true
    if op == OP_XOR:
        return true
    if op == OP_SHL:
        return true
    if op == OP_SHR:
        return true
    return false
// bootstrap/stage1/air_builder.ax
// SSA-form Intermediate Representation (AIR) builder for self-hosted AXIOM frontend.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn atof(s: ptr[u8]) -> f64

pub struct LocalMapEntry:
    pub name_id: u32
    pub reg: u32

pub struct LocalMap:
    pub entries: ptr[LocalMapEntry]
    pub count: u32
    pub capacity: u32

pub fn new_local_map() -> ptr[LocalMap]:
    let capacity = 16 as u32
    let entries = @alloc(capacity as i64 * 8) as ptr[LocalMapEntry]
    mut i := 0 as i64
    while i < capacity as i64:
        entries[i] = LocalMapEntry(name_id: 0 as u32, reg: 0 as u32)
        i = i + 1
    let lm = @alloc(@compiler_intrinsic("size_of")[LocalMap]()) as ptr[LocalMap]
    lm.entries = entries
    lm.count = 0 as u32
    lm.capacity = capacity
    return lm

pub fn free_local_map(mut self: ptr[LocalMap]):
    if self.entries != null as ptr[LocalMapEntry]:
        @free(self.entries as ptr[u8])

fn local_map_hash(v: u32) -> u32:
    mut hash := 2166136261 as u32
    hash = hash ^ (v & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 8 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 16 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    hash = hash ^ ((v >> 24 as u32) & 255 as u32)
    hash = hash * 16777619 as u32
    return hash

pub fn local_map_put(mut self: ptr[LocalMap], name_id: u32, reg: u32):
    if self.count * 4 as u32 > self.capacity * 3 as u32:
        self.local_map_grow()
    self.local_map_insert(name_id, reg)
    self.count = self.count + 1 as u32

fn local_map_insert(self: ptr[LocalMap], name_id: u32, reg: u32):
    let mask = self.capacity - 1 as u32
    mut idx = local_map_hash(name_id) & mask
    while true:
        if self.entries[idx].name_id == 0 as u32 or self.entries[idx].name_id == name_id:
            self.entries[idx].name_id = name_id
            self.entries[idx].reg = reg
            return
        idx = (idx + 1 as u32) & mask

pub fn local_map_get(self: ptr[LocalMap], name_id: u32) -> u32:
    if self.capacity == 0 as u32:
        return 0 as u32
    let mask = self.capacity - 1 as u32
    mut idx = local_map_hash(name_id) & mask
    let start_idx = idx
    while true:
        let entry = self.entries[idx]
        if entry.name_id == 0 as u32:
            return 0 as u32
        if entry.name_id == name_id:
            return entry.reg
        idx = (idx + 1 as u32) & mask
        if idx == start_idx:
            break
    return 0 as u32

fn local_map_grow(mut self: ptr[LocalMap]):
    let old_entries = self.entries
    let old_capacity = self.capacity
    let new_cap = old_capacity * 2 as u32
    self.capacity = new_cap
    self.entries = @alloc(new_cap as i64 * 8) as ptr[LocalMapEntry]
    mut i := 0 as i64
    while i < new_cap as i64:
        self.entries[i] = LocalMapEntry(name_id: 0 as u32, reg: 0 as u32)
        i = i + 1

    i = 0 as i64
    while i < old_capacity as i64:
        let entry = old_entries[i]
        if entry.name_id != 0 as u32:
            self.local_map_insert(entry.name_id, entry.reg)
        i = i + 1
    @free(old_entries as ptr[u8])

pub struct AirModuleBuilder:
    pub tree: ptr[AstTree]
    pub symbols: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub pool: ptr[InternPool]
    pub module: AirModule
    pub node_types: ptr[u32]
    // RFC 0009 P3 / Linux target: the OS the emitted binary targets. Drives the
    // compile-time `@compiler_intrinsic("is_windows"/"is_linux"/"os_name")` fold so the
    // bundled platform runtime (syscall.ax, axalloc.ax) selects the right code path.
    // Default true (Windows/COFF) so the self-host build stays byte-identical; the driver
    // flips it to false only under `--target linux`.
    pub target_is_windows: bool
    // RFC 0028 (opt-in `-jumptable`): lower a dense integer `match` to an O(log N)
    // balanced compare tree (lower_match_bsearch) instead of the O(N) linear chain.
    // Default false â†’ linear path unchanged â†’ self-build byte-identical (A==B).
    pub jumptable_enabled: bool

pub fn new_air_module_builder(tree: ptr[AstTree], symbols: ptr[SymbolTable], typetable: ptr[TypeTable], pool: ptr[InternPool], node_types: ptr[u32]) -> ptr[AirModuleBuilder]:
    let amb = @alloc(@compiler_intrinsic("size_of")[AirModuleBuilder]()) as ptr[AirModuleBuilder]
    amb.tree = tree
    amb.symbols = symbols
    amb.typetable = typetable
    amb.pool = pool
    amb.module = AirModule(funcs: new_air_func_vec(), globals: new_air_global_vec())
    amb.node_types = node_types
    amb.target_is_windows = true
    amb.jumptable_enabled = false
    return amb

pub fn free_air_module_builder(self: ptr[AirModuleBuilder]):
    free_air_module(self.module)

pub fn get_token_text(self: ptr[AirModuleBuilder], token_idx: u32) -> str:
    let tok = self.tree.tokens.data[token_idx as i64]
    if tok.len == 0 as u16:
        return alloc_str_from_raw(null as ptr[u8], 0)
    let start_ptr = ((get_str_ptr(self.tree.src)) as i64 + tok.offset as i64) as ptr[u8]
    return alloc_str_from_raw(start_ptr, tok.len as i64)

pub fn parse_int_from_str(s: str) -> i64:
    let len = std.string.len(s)
    if len == 0:
        return 0 as i64
    mut i := 0
    mut sign := 1 as i64
    if s[0] as u8 == '-' as u8:
        sign = -1 as i64
        i = 1
    elif s[0] as u8 == '+' as u8:
        i = 1

    mut base := 10 as i64
    if i + 1 < len and s[i] as u8 == '0' as u8:
        let next_char = s[i + 1] as u8
        if next_char == 'x' as u8 or next_char == 'X' as u8:
            base = 16 as i64
            i = i + 2
        elif next_char == 'o' as u8 or next_char == 'O' as u8:
            base = 8 as i64
            i = i + 2
        elif next_char == 'b' as u8 or next_char == 'B' as u8:
            base = 2 as i64
            i = i + 2

    mut val := 0 as i64
    while i < len:
        let c = s[i] as u8
        // digit-group separator: skip and keep scanning (e.g. 1_000_000)
        if c == '_' as u8:
            i = i + 1
            continue
        mut digit := -1 as i64
        if c >= '0' as u8 and c <= '9' as u8:
            digit = (c - '0' as u8) as i64
        elif c >= 'a' as u8 and c <= 'f' as u8:
            digit = (c - 'a' as u8 + 10 as u8) as i64
        elif c >= 'A' as u8 and c <= 'F' as u8:
            digit = (c - 'A' as u8 + 10 as u8) as i64

        if digit < 0 or digit >= base:
            break

        val = val * base + digit
        i = i + 1

    return val * sign

// Convert a match LITERAL-pattern token's TEXT to its i64 compare value. A NODE_LITERAL_PAT
// carries only a token_idx (no typed literal sub-node), so discriminate by text shape:
// bool "true"/"false" -> 1/0, a char literal 'x' (incl. escapes) -> its codepoint, everything
// else is an integer literal (decimal/hex/oct/bin) via parse_int_from_str. Fixes the silent
// miscompile where the switch lowering did parse_int_from_str("true")/("'a'") == 0 for BOTH
// arms of a bool/char match (arms then compared against 0 -> wrong branch / fall-through garbage).
pub fn pat_literal_value(s: str) -> i64:
    let len = std.string.len(s)
    if len == 0:
        return 0 as i64
    if s == "true":
        return 1 as i64
    if s == "false":
        return 0 as i64
    if s[0] as u8 == '\'' as u8:
        // char literal: 'x' or '\n'-style escape, with surrounding single quotes.
        if len >= 3 and s[len - 1 as i64] as u8 == '\'' as u8:
            if s[1] as u8 == '\\' as u8 and len >= 4:
                let esc = s[2] as u8
                if esc == 'n' as u8:
                    return 10 as i64
                elif esc == 't' as u8:
                    return 9 as i64
                elif esc == 'r' as u8:
                    return 13 as i64
                elif esc == '\'' as u8:
                    return 39 as i64
                elif esc == '\\' as u8:
                    return 92 as i64
                elif esc == '0' as u8:
                    return 0 as i64
                elif esc == 'b' as u8:
                    return 8 as i64
                elif esc == 'f' as u8:
                    return 12 as i64
                else:
                    return esc as i64
            else:
                return s[1] as i64
        return 0 as i64
    return parse_int_from_str(s)

pub fn map_binary_op(op: str) -> u16:
    if op == "+":
        return OP_IADD
    if op == "-":
        return OP_ISUB
    if op == "*":
        return OP_IMUL
    if op == "/":
        return OP_IDIV
    if op == "%":
        return OP_IMOD
    if op == "==":
        return OP_EQ
    if op == "!=":
        return OP_NE
    if op == "<":
        return OP_LT
    if op == "<=":
        return OP_LE
    if op == ">":
        return OP_GT
    if op == ">=":
        return OP_GE
    if op == "and" or op == "&&" or op == "&":
        return OP_AND
    if op == "or" or op == "||" or op == "|":
        return OP_OR
    if op == "^":
        return OP_XOR
    if op == "<<":
        return OP_SHL
    if op == ">>":
        return OP_SHR
    return OP_NOP

pub struct FuncLowering:
    pub mb: ptr[AirModuleBuilder]
    pub fb: ptr[AirFuncBuilder]
    pub locals: ptr[LocalMap]
    pub params: U32Vec
    pub terminated: bool
    pub loop_conds: U32Vec
    pub loop_exits: U32Vec
    // BUG#89: per-loop counter register + type used to advance a `for` loop's counter
    // when `continue` short-circuits to the condition. The body-tail increment only
    // runs on normal fall-through, so `continue` (which jumps straight to cond) must
    // emit the same increment inline first, or the counter never advances -> infinite
    // loop. A while-loop pushes reg 0 (no increment). Kept parallel to loop_conds.
    pub loop_incr_regs: U32Vec
    pub loop_incr_types: U32Vec
    // RFC 0020 P2b: per-loop counter STEP register. 0 means the default +1 (range /
    // array / Vec / bytes loops). For `for c in str` the step is the current
    // codepoint's UTF-8 byte width, so the counter advances variably â€” both the
    // body-tail increment and `continue` add this reg instead of a constant 1.
    pub loop_incr_steps: U32Vec
    // RFC 0006 (#38.4): deferred expression node indices, in textual order.
    // Flushed LIFO at every return and at function exit (Go-style function-level
    // defer). See lower_defer / flush_defers.
    pub defers: U32Vec

pub fn new_func_lowering(mb: ptr[AirModuleBuilder], fb: ptr[AirFuncBuilder], params: U32Vec) -> ptr[FuncLowering]:
    let fl = @alloc(@compiler_intrinsic("size_of")[FuncLowering]()) as ptr[FuncLowering]
    fl.mb = mb
    fl.fb = fb
    fl.locals = new_local_map()
    fl.params = params
    fl.terminated = false
    fl.loop_conds = new_u32_vec()
    fl.loop_exits = new_u32_vec()
    fl.loop_incr_regs = new_u32_vec()
    fl.loop_incr_types = new_u32_vec()
    fl.loop_incr_steps = new_u32_vec()
    fl.defers = new_u32_vec()
    return fl

pub fn free_func_lowering(mut self: ptr[FuncLowering]):
    free_local_map(self.locals)
    if self.params.data != null as ptr[u32]:
        @free(self.params.data as ptr[u8])
    if self.loop_conds.data != null as ptr[u32]:
        @free(self.loop_conds.data as ptr[u8])
    if self.loop_exits.data != null as ptr[u32]:
        @free(self.loop_exits.data as ptr[u8])
    if self.loop_incr_regs.data != null as ptr[u32]:
        @free(self.loop_incr_regs.data as ptr[u8])
    if self.loop_incr_types.data != null as ptr[u32]:
        @free(self.loop_incr_types.data as ptr[u8])
    if self.loop_incr_steps.data != null as ptr[u32]:
        @free(self.loop_incr_steps.data as ptr[u8])
    if self.defers.data != null as ptr[u32]:
        @free(self.defers.data as ptr[u8])

pub fn register_params(mut self: ptr[FuncLowering], func_idx: u32, func_node: AstNode):
    mut child := func_node.first_child
    mut param_idx := 0 as i64
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_PARAM_DECL:
            mut name_id := cn.payload
            if name_id == 0 as u32:
                let tok_str = self.mb.get_token_text(cn.token_idx)
                name_id = self.mb.pool.intern(tok_str)
                @free(get_str_ptr(tok_str))

            let reg = self.fb.fresh_reg()
            mut type_id := 0 as u32
            if param_idx < self.params.len:
                type_id = self.params.data[param_idx] as u32

            self.fb.emit(AirInst(
                opcode: OP_COPY,
                type_id: type_id,
                dest: reg,
                src1: (param_idx + 1) as u32,
                src2: 0 as u32,
            ))

            self.locals.local_map_put(name_id, reg)
            param_idx = param_idx + 1
        child = cn.next_sibling

pub fn builder_type_size_and_align(table: ptr[TypeTable], type_id: u32, out_size: ptr[u32], out_align: ptr[u32]):
    if type_id == 0 as u32:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32
        return

    mut entry := &table.entries.data[type_id]
    if entry.size != 0 as u32:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return

    if entry.kind == TYPE_KIND_PRIMITIVE:
        out_size[0] = entry.size
        out_align[0] = entry.align
        return
    elif entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
        // For a generic instance, find the concrete struct definition by name.
        // If none matches (the base is a pointer-layout sum/option/result, not a
        // struct), fall through to the 8-byte pointer default â€” never index the
        // structs array with a sum index, which yields a garbage size and breaks
        // the value-passing/return ABI (e.g. Result returned as 16 bytes).
        mut struct_idx := 0xffffffff as u32
        if entry.kind == TYPE_KIND_STRUCT:
            struct_idx = entry.extra
        else:
            mut idx := 0 as i64
            while idx < table.entries.len:
                let e = table.entries.data[idx]
                if e.kind == TYPE_KIND_STRUCT and e.name_id == entry.name_id:
                    struct_idx = e.extra
                    break
                idx = idx + 1
        if struct_idx != 0xffffffff as u32:
            let info = table.structs.data[struct_idx]
            mut offset := 0 as u32
            mut max_align := 1 as u32
            mut i := 0 as i64
            while i < info.fields.len:
                let f = info.fields.data[i]
                mut f_size := 0 as u32
                mut f_align := 0 as u32
                builder_type_size_and_align(table, f.type_id, &f_size, &f_align)
                if f_align == 0 as u32:
                    f_align = 8 as u32
                // Align offset
                offset = (offset + f_align - 1 as u32) & ~(f_align - 1 as u32)
                offset = offset + f_size
                if f_align > max_align:
                    max_align = f_align
                i = i + 1

            mut size := (offset + max_align - 1 as u32) & ~(max_align - 1 as u32)
            if size == 0 as u32:
                size = 8 as u32
            entry.size = size
            entry.align = max_align
            out_size[0] = size
            out_align[0] = max_align
        else:
            out_size[0] = 8 as u32
            out_align[0] = 8 as u32
    elif entry.kind == TYPE_KIND_ARRAY:
        let elem_id = entry.extra
        let length = entry.name_id
        mut elem_size := 0 as u32
        mut elem_align := 0 as u32
        builder_type_size_and_align(table, elem_id, &elem_size, &elem_align)
        let size = elem_size * length
        entry.size = size
        entry.align = elem_align
        out_size[0] = size
        out_align[0] = elem_align
    else:
        out_size[0] = 8 as u32
        out_align[0] = 8 as u32

pub fn try_lower_sizeof(mut self: ptr[FuncLowering], idx: u32) -> u32:
    let node = self.mb.tree.nodes.data[idx as i64]
    if node.kind != NODE_CALL_EXPR:
        return 0 as u32
    
    let callee_idx = node.first_child
    if callee_idx == 0 as u32:
        return 0 as u32
    let callee_node = self.mb.tree.nodes.data[callee_idx as i64]
    if callee_node.kind != NODE_INDEX_EXPR:
        return 0 as u32
        
    let inner_call_idx = callee_node.first_child
    if inner_call_idx == 0 as u32:
        return 0 as u32
    let inner_call_node = self.mb.tree.nodes.data[inner_call_idx as i64]
    if inner_call_node.kind != NODE_CALL_EXPR:
        return 0 as u32
        
    let inner_callee_idx = inner_call_node.first_child
    if inner_callee_idx == 0 as u32:
        return 0 as u32
    let inner_callee_node = self.mb.tree.nodes.data[inner_callee_idx as i64]
    if inner_callee_node.kind != NODE_IDENT:
        return 0 as u32
        
    let inner_callee_name = self.mb.get_token_text(inner_callee_node.token_idx)
    let is_intrinsic = (inner_callee_name == "compiler_intrinsic" or inner_callee_name == "@compiler_intrinsic")
    @free(get_str_ptr(inner_callee_name))
    if not is_intrinsic:
        return 0 as u32
        
    // Check if the argument is "size_of"
    let arg_idx = self.mb.tree.nodes.data[inner_callee_idx as i64].next_sibling
    if arg_idx == 0 as u32:
        return 0 as u32
    let arg_node = self.mb.tree.nodes.data[arg_idx as i64]
    if arg_node.kind != NODE_STRING_LIT:
        return 0 as u32
        
    let arg_text = self.mb.get_token_text(arg_node.token_idx)
    let is_sizeof = (arg_text == "\"size_of\"" or arg_text == "'size_of'" or arg_text == "size_of")
    @free(get_str_ptr(arg_text))
    if not is_sizeof:
        return 0 as u32
        
    // The type node is the index of the index expr (next sibling of the inner call)
    let type_node_idx = self.mb.tree.nodes.data[inner_call_idx as i64].next_sibling
    if type_node_idx == 0 as u32 or type_node_idx == 0xffffffff as u32 or (type_node_idx as i64) >= self.mb.tree.nodes.len:
        return 0 as u32
        
    let type_node = self.mb.tree.nodes.data[type_node_idx as i64]
        
    mut target_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        target_type = self.mb.node_types[type_node_idx as i64]
    if target_type == 0 as u32:
        let sym_idx = type_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            target_type = self.mb.symbols.symbols.data[sym_idx as i64].type_id
            
    mut size := 0 as u32
    mut align := 0 as u32
    if target_type == 0 as u32:
        size = 8 as u32
    elif (target_type as i64) >= self.mb.typetable.entries.len:
        size = 8 as u32
    else:
        builder_type_size_and_align(self.mb.typetable, target_type, &size, &align)
    
    // Emit an OP_ICONST with the evaluated size!
    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 4 as u32, // i64
        dest: reg,
        src1: size,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_expr(mut self: ptr[FuncLowering], idx: u32) -> u32:
    if idx == 0 as u32:
        return 0 as u32
        
    let sizeof_reg = self.try_lower_sizeof(idx)
    if sizeof_reg != 0 as u32:
        return sizeof_reg
        
    let node = self.mb.tree.nodes.data[idx as i64]
    if node.kind == NODE_INT_LIT:
        return self.lower_int_lit(idx, node)
    if node.kind == NODE_FLOAT_LIT:
        return self.lower_float_lit(idx, node)
    if node.kind == NODE_BOOL_LIT:
        return self.lower_bool_lit(node)
    if node.kind == NODE_NIL_LIT:
        return self.lower_nil_lit()
    if node.kind == NODE_STRING_LIT:
        return self.lower_string_lit(node)
    if node.kind == NODE_CHAR_LIT:
        return self.lower_char_lit(node)
    if node.kind == NODE_IDENT:
        return self.lower_ident(node)
    if node.kind == NODE_CLOSURE_EXPR:
        // RFC 0008: a lambda-lifted closure reference. Its payload is the resolved
        // symbol index of the synthesized top-level function (set by the resolver).
        // Emit its address exactly like a bare function name (BUG#49 fn-ptr path).
        let cl_faddr = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_FUNC_ADDR,
            type_id: 4 as u32,
            dest: cl_faddr,
            src1: node.payload,
            src2: 0 as u32,
        ))
        return cl_faddr
    if node.kind == NODE_BINARY_EXPR:
        return self.lower_binary_expr(idx, node)
    if node.kind == NODE_UNARY_EXPR:
        return self.lower_unary_expr(idx, node)
    if node.kind == NODE_CALL_EXPR:
        return self.lower_call_expr(idx, node)
    if node.kind == NODE_FIELD_EXPR:
        return self.lower_field_expr(idx, node)
    if node.kind == NODE_INDEX_EXPR:
        return self.lower_index_expr(idx, node)
    if node.kind == NODE_CAST_EXPR:
        return self.lower_cast_expr(idx, node)
    if node.kind == NODE_DEREF_EXPR:
        return self.lower_deref_expr(idx, node)
    if node.kind == NODE_SPAWN_EXPR:
        return self.lower_spawn_expr(idx, node)
    if node.kind == NODE_AWAIT_EXPR:
        return self.lower_await_expr(idx, node)
    if node.kind == NODE_STRUCT_LIT:
        return self.lower_struct_lit(idx, node)
    if node.kind == NODE_ARRAY_LIT:
        return self.lower_array_lit(idx, node)
    if node.kind == NODE_TUPLE_EXPR:
        return self.lower_tuple_lit(idx, node)
    if node.kind == NODE_IF_EXPR:
        return self.lower_if_expr(idx, node)
    return 0 as u32

pub fn lower_int_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    let val = parse_int_from_str(text)
    @free(get_str_ptr(text))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: type_id,
        dest: reg,
        src1: val as u32,
        src2: (val >> 32 as i64) as u32,
    ))
    return reg

pub fn lower_float_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut fv := atof(get_str_ptr(text))
    @free(get_str_ptr(text))

    mut type_id := 10 as u32 // default f64
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    // RFC 0006: carry the IEEE-754 bit pattern of the constant (NOT the
    // int-truncated value) split across src1(low32)/src2(high32). For f32 narrow
    // to single precision first so the 32-bit pattern lands in src1 (src2=0).
    // (`fv as f32` here is a dead path during self-host â€” the compiler source has
    // no f32 literals â€” so it cannot affect the fixpoint; it only runs when
    // compiling user code with f32 literals.)
    mut bits := (&fv as ptr[u64])[0]
    if type_id == 9 as u32:
        mut f32v := fv as f32
        bits = ((&f32v as ptr[u32])[0]) as u64
    self.fb.emit(AirInst(
        opcode: OP_FCONST,
        type_id: type_id,
        dest: reg,
        src1: (bits & (0xFFFFFFFF as u64)) as u32,
        src2: (bits >> (32 as u64)) as u32,
    ))
    return reg

pub fn lower_bool_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut val := 0 as u32
    if text == "true":
        val = 1 as u32
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 11 as u32, // bool
        dest: reg,
        src1: val,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_nil_lit(mut self: ptr[FuncLowering]) -> u32:
    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 0 as u32,
        dest: reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_string_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    let str_id = self.mb.pool.intern(text)
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 12 as u32, // string
        dest: reg,
        src1: str_id,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_char_lit(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let reg = self.fb.fresh_reg()
    let text = self.mb.get_token_text(node.token_idx)
    mut val := 0 as u32
    let length = std.string.len(text)
    if length > 0:
        if length >= 3 and text[0] as u8 == '\'' as u8 and text[length - 1] as u8 == '\'' as u8:
            if text[1] as u8 == '\\' as u8 and length >= 4:
                let esc = text[2] as u8
                if esc == 'n' as u8:
                    val = 10 as u32
                elif esc == 't' as u8:
                    val = 9 as u32
                elif esc == 'r' as u8:
                    val = 13 as u32
                elif esc == '\'' as u8:
                    val = 39 as u32
                elif esc == '\\' as u8:
                    val = 92 as u32
                elif esc == '0' as u8:
                    val = 0 as u32
                elif esc == 'b' as u8:
                    val = 8 as u32
                elif esc == 'f' as u8:
                    val = 12 as u32
                else:
                    val = esc as u32
            else:
                val = text[1] as u32
    @free(get_str_ptr(text))

    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 13 as u32, // char8
        dest: reg,
        src1: val,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_ident(mut self: ptr[FuncLowering], node: AstNode) -> u32:
    let text = self.mb.get_token_text(node.token_idx)
    if text == "null" or text == "nil":
        @free(get_str_ptr(text))
        return self.lower_nil_lit()
    if text == "None":
        // Bare `None` in expression position: pointer-layout null sum value.
        @free(get_str_ptr(text))
        let none_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: 4 as u32,
            dest: none_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        return none_reg
    let actual_name_id = self.mb.pool.intern(text)

    mut is_resolved := false
    mut sym_idx := 0 as u32
    if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[node.payload as i64]
        if sym.name_id == actual_name_id:
            is_resolved = true
            sym_idx = node.payload
        else:
            // RFC 0022 P3: a SYNTHESIZED tuple-destructure temp reference (`__td<n>`,
            // built by parse_tuple_destructure) carries a placeholder token whose text is
            // NOT the temp's name, so the name-match guard above misses even though the
            // resolver correctly rewrote `payload` to the temp's symbol index. Trust the
            // resolved payload when the symbol is such a synthetic temp. Real user idents
            // always match the token above, so this never affects ordinary code.
            let sname = self.mb.pool.get(sym.name_id)
            if std.string.starts_with(sname, "__td"):
                is_resolved = true
                sym_idx = node.payload
            safe_free_str(sname)

    @free(get_str_ptr(text))

    if is_resolved:
        let sym = self.mb.symbols.symbols.data[sym_idx as i64]
        if sym.kind == SYM_CONST:
            mut init_expr := 0 as u32
            mut child := self.mb.tree.nodes.data[sym.decl_node as i64].first_child
            while child != 0 as u32:
                let child_node = self.mb.tree.nodes.data[child as i64]
                if child_node.kind != NODE_TYPE_EXPR and child_node.kind != NODE_GENERIC_TYPE:
                    init_expr = child
                child = child_node.next_sibling
            if init_expr != 0 as u32:
                return self.lower_expr(init_expr)
            return 0 as u32

        if sym.kind == SYM_VARIANT and sym.type_id != 0 as u32 and (sym.type_id as i64) < self.mb.typetable.entries.len:
            // RFC 0004: bare no-payload user variant (e.g. `Green`) in expr
            // position. Only user sum types (kind 6); builtin None handled above.
            if self.mb.typetable.entries.data[sym.type_id as i64].kind == TYPE_KIND_SUM:
                return self.lower_variant_construct(sym_idx, 0 as u32, 0 as u32)

        if sym.kind == SYM_FUNC:
            // Bare top-level function name used as a value -> function pointer.
            // Emit its address; type_id carries the function symbol index.
            let faddr = self.fb.fresh_reg()
            // type_id = i64 so the result register is a plain 8-byte GPR value
            // (a code address); the function's SYMBOL index rides in src1 for the
            // backend relocation. (Overloading type_id with the symbol index
            // would make get_register_type mis-type the register.)
            self.fb.emit(AirInst(
                opcode: OP_FUNC_ADDR,
                type_id: 4 as u32,
                dest: faddr,
                src1: sym_idx,
                src2: 0 as u32,
            ))
            return faddr
        if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
            return 0 as u32
        // RFC 0017 / BUG#82: a module-level global reads from its static storage
        // (OP_GLOBAL_ADDR + OP_LOAD), not a per-function vreg.
        if sym.kind == SYM_VAR and self.mb.builder_global_index(sym_idx) != -1 as i64:
            return self.lower_global_read(sym_idx, sym.type_id)
        let reg = self.locals.local_map_get(sym_idx)
        return reg

    return 0 as u32

// RFC 0017 / BUG#82: read a module-level global's value from static storage. Composes
// OP_GLOBAL_ADDR (address via lea rip + reloc) with OP_LOAD (sized by the value type).
pub fn lower_global_read(mut self: ptr[FuncLowering], sym_idx: u32, type_id: u32) -> u32:
    // RFC 0017 P2: a by-address AGGREGATE global (struct/array/tuple) is represented by
    // the ADDRESS of its static storage â€” exactly like a local aggregate vreg. Return the
    // OP_GLOBAL_ADDR result directly (NO load), typed as the aggregate so get_register_type
    // reports the struct type and a downstream OP_GET_FIELD / OP_INDEX composes base+offset.
    // Scalars keep the address-typed-as-pointer + OP_LOAD form (byte-identical to before).
    mut is_agg := false
    if type_id != 0 as u32 and (type_id as i64) < self.mb.typetable.entries.len:
        let gk = self.mb.typetable.entries.data[type_id as i64].kind
        is_agg = gk == TYPE_KIND_STRUCT or gk == TYPE_KIND_ARRAY or gk == TYPE_KIND_TUPLE
    let addr = self.fb.fresh_reg()
    if is_agg:
        self.fb.emit(AirInst(opcode: OP_GLOBAL_ADDR, type_id: type_id, dest: addr, src1: sym_idx, src2: 0 as u32))
        return addr
    self.fb.emit(AirInst(opcode: OP_GLOBAL_ADDR, type_id: 4 as u32, dest: addr, src1: sym_idx, src2: 0 as u32))
    let val = self.fb.fresh_reg()
    // A pointer-repr global (sum/Option/Result) stores an 8-byte box pointer; the OP_LOAD
    // carries the pointer-repr type so the selector reads exactly 8 bytes (NOT the 16-byte
    // box size) and keeps `val` typed as the sum/Option/Result so `match`/`.unwrap()` work.
    self.fb.emit(AirInst(opcode: OP_LOAD, type_id: type_id, dest: val, src1: addr, src2: 0 as u32))
    return val

// RFC 0017 / BUG#82: write `value_reg` into a module-level global's static storage.
// Composes OP_GLOBAL_ADDR with OP_STORE (src1 = address, src2 = value).
pub fn lower_global_write(mut self: ptr[FuncLowering], sym_idx: u32, type_id: u32, value_reg: u32):
    let addr = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_GLOBAL_ADDR, type_id: 4 as u32, dest: addr, src1: sym_idx, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_STORE, type_id: type_id, dest: addr, src1: value_reg, src2: 0 as u32))

// BUG#86 / RFC 0016 P3: lower a short-circuit `and`/`or`. The result is carried
// out of the diamond in one vreg (`sc_res`), written on each path:
//   AND: sc_res = lhs; if lhs -> eval rhs, sc_res = rhs; else keep lhs(=false)
//   OR : sc_res = lhs; if lhs keep lhs(=true); else -> eval rhs, sc_res = rhs
// This produces blocks *in the middle of expression evaluation*, out of physical
// control-flow order â€” correct only because compute_liveness is now CFG-aware
// (RFC 0016 P2'): sc_res's live interval covers the linear hull of the diamond.
pub fn lower_short_circuit(mut self: ptr[FuncLowering], lhs_idx: u32, rhs_idx: u32, is_and: bool, result_type: u32) -> u32:
    let sc_res = self.fb.fresh_reg()

    // LHS in the current block; seed sc_res with it (the value taken when we skip RHS).
    let lhs_reg = self.lower_expr(lhs_idx)
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: sc_res, src1: lhs_reg, src2: 0 as u32))

    let rhs_block = self.fb.new_block()
    let merge_block = self.fb.new_block()
    let entry_block = self.fb.current_block()

    // OP_BRANCH: dest = false-target, src1 = cond, src2 = true-target.
    if is_and:
        // lhs true -> evaluate rhs; lhs false -> merge with sc_res already = false.
        self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: merge_block, src1: lhs_reg, src2: rhs_block))
    else:
        // lhs true -> merge with sc_res already = true; lhs false -> evaluate rhs.
        self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: rhs_block, src1: lhs_reg, src2: merge_block))
    self.fb.add_edge(entry_block, rhs_block)
    self.fb.add_edge(entry_block, merge_block)

    // RHS block: evaluate rhs, overwrite sc_res, fall to merge.
    self.fb.switch_to(rhs_block)
    self.terminated = false
    let rhs_reg = self.lower_expr(rhs_idx)
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: sc_res, src1: rhs_reg, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
    self.fb.add_edge(self.fb.current_block(), merge_block)

    // Merge: sc_res holds the short-circuit result.
    self.fb.switch_to(merge_block)
    self.terminated = false
    return sc_res

// RFC 0023: lower an if-EXPRESSION `if C0: V0 (elif Ci: Vi)* else: VE` to a
// value-producing diamond, generalizing the short-circuit lowering above to N
// branches. Children are flat: cond0, then0, cond1, then1, ..., else. One result
// vreg `r` is written on every path and read at the merge block; correct because
// compute_liveness is CFG-aware (RFC 0016 P2') â€” `r`'s interval covers the diamond.
pub fn lower_if_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    mut result_type := 3 as u32 // fallback i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        result_type = self.mb.node_types[idx as i64] as u32

    let r = self.fb.fresh_reg()
    let merge_block = self.fb.new_block()

    mut child := node.first_child
    while child != 0 as u32:
        let then_child = self.mb.tree.nodes.data[child as i64].next_sibling
        if then_child == 0 as u32:
            // `child` is the unpaired trailing else value.
            let else_reg = self.lower_expr(child)
            self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: r, src1: else_reg, src2: 0 as u32))
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), merge_block)
            child = 0 as u32
        else:
            // (cond, then) pair. cond in the current block; branch to then or the
            // next test/else block.
            let cond_reg = self.lower_expr(child)
            let then_block = self.fb.new_block()
            let next_block = self.fb.new_block()
            let entry_block = self.fb.current_block()
            // OP_BRANCH: dest = false-target, src1 = cond, src2 = true-target.
            self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: next_block, src1: cond_reg, src2: then_block))
            self.fb.add_edge(entry_block, then_block)
            self.fb.add_edge(entry_block, next_block)
            // then block: eval then-value into r, jump to merge.
            self.fb.switch_to(then_block)
            self.terminated = false
            let then_reg = self.lower_expr(then_child)
            self.fb.emit(AirInst(opcode: OP_COPY, type_id: result_type, dest: r, src1: then_reg, src2: 0 as u32))
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), merge_block)
            // continue testing the next cond / else in next_block.
            self.fb.switch_to(next_block)
            self.terminated = false
            child = self.mb.tree.nodes.data[then_child as i64].next_sibling

    // Merge: r holds the selected branch value.
    self.fb.switch_to(merge_block)
    self.terminated = false
    return r

pub fn lower_binary_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    // RFC 0006 (#38.3): `**` exponentiation. Handled before the generic binary
    // path because the exponent controls evaluation: a constant non-negative
    // exponent is unrolled to a chain of multiplies, otherwise a runtime loop is
    // synthesized. (Previously `**` mapped to OP_NOP -> garbage result.)
    let op_peek = self.mb.get_token_text(node.token_idx)
    let is_pow = op_peek == "**"
    @free(get_str_ptr(op_peek))
    if is_pow:
        return self.lower_power(idx, node, child)

    // BUG#86 / RFC 0016 P3: short-circuit logical `and`/`&&`/`or`/`||` (NOT the
    // bitwise `&`/`|`, which map to the same OP_AND/OP_OR but must stay eager).
    // Spec (p09-t06, p08-t04) mandates: `a and b` evaluates b only if a is true;
    // `a or b` evaluates b only if a is false. Distinguished purely by token text
    // (opcode alone can't tell `and` from `&`). Safe to enable now that liveness
    // is CFG-aware (P2') â€” the diamond-carried result vreg is allocated correctly.
    let sc_tok = self.mb.get_token_text(node.token_idx)
    let sc_is_and = sc_tok == "and" or sc_tok == "&&"
    let sc_is_or = sc_tok == "or" or sc_tok == "||"
    @free(get_str_ptr(sc_tok))
    if sc_is_and or sc_is_or:
        let sc_rhs = self.mb.tree.nodes.data[child as i64].next_sibling
        if sc_rhs != 0 as u32:
            mut sc_rtype := 4 as u32   // bool
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                sc_rtype = self.mb.node_types[idx as i64]
            return self.lower_short_circuit(child, sc_rhs, sc_is_and, sc_rtype)

    // RFC 0007: operator overloading. When the lhs operand is a user type
    // (struct/sum/generic-inst), `a <op> b` lowers to the conventional method
    // call `a.<name>(b)` (+ -> add, == -> eq, < -> lt, ...). Builtin numeric
    // operands skip this entirely and keep their native codegen (fixpoint-safe,
    // since the compiler never applies operators to user types).
    if self.mb.node_types != null as ptr[u32]:
        let lhs_t = self.mb.node_types[child as i64]
        if lhs_t != 0 as u32 and (lhs_t as i64) < self.mb.typetable.entries.len:
            let le = self.mb.typetable.entries.data[lhs_t as i64]
            if le.kind == TYPE_KIND_STRUCT or le.kind == TYPE_KIND_SUM or le.kind == TYPE_KIND_GENERIC_INST:
                let op_tok = self.mb.get_token_text(node.token_idx)
                let mname = op_to_method_name(op_tok)
                let is_ne = op_tok == "!="
                @free(get_str_ptr(op_tok))
                if not (mname == ""):
                    let rhs_node_idx = self.mb.tree.nodes.data[child as i64].next_sibling
                    mut rhs_t := 0 as u32
                    if rhs_node_idx != 0 as u32:
                        rhs_t = self.mb.node_types[rhs_node_idx as i64]
                    let msym = self.resolve_op_method(mname, lhs_t, rhs_t)
                    if msym != 0 as u32:
                        return self.lower_op_overload(idx, node, child, msym, is_ne)

    // BUG#88: `str + str` -> std.string.concat(a, b). The `str` primitive is not a
    // STRUCT/SUM/GENERIC_INST, so the RFC 0007 operator-overload path above skips it,
    // and `+` fell through to OP_IADD on the two 16-byte str values -> garbage/crash
    // with NO diagnostic. AXIOM intends `+` to concatenate strings (std/os.ax uses
    // `s + "." + ext`). Lower it to the library `concat` call, reusing the overload
    // call-emission path (resolve the concat symbol by name + (str,str) params).
    if self.mb.node_types != null as ptr[u32]:
        let sc_lt = self.mb.node_types[child as i64]
        let sc_rhs_i = self.mb.tree.nodes.data[child as i64].next_sibling
        if sc_lt == TYPE_STRING and sc_rhs_i != 0 as u32 and self.mb.node_types[sc_rhs_i as i64] == TYPE_STRING:
            let sc_op = self.mb.get_token_text(node.token_idx)
            let sc_is_plus = sc_op == "+"
            @free(get_str_ptr(sc_op))
            if sc_is_plus:
                let csym = self.resolve_op_method("concat", TYPE_STRING, TYPE_STRING)
                if csym != 0 as u32:
                    return self.lower_op_overload(idx, node, child, csym, false)

    let lhs_reg = self.lower_expr(child)

    let rhs_idx = self.mb.tree.nodes.data[child as i64].next_sibling
    if rhs_idx == 0 as u32:
        return lhs_reg

    let rhs_reg = self.lower_expr(rhs_idx)

    let op_token = self.mb.get_token_text(node.token_idx)
    mut opcode := map_binary_op(op_token)
    @free(get_str_ptr(op_token))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    // RFC 0006 (BUG#33): float arithmetic. When the RESULT type is float, the
    // operator selects the float opcode (OP_FADD/FSUB/FMUL/FDIV) instead of the
    // integer one, and any integer operand is promoted to float with a real
    // OP_ITOF (cvtsi2sd) â€” NOT a copy-reinterpret. f64 fully supported here;
    // f32 reuses the sd path for now (precise single-precision is a follow-up
    // needing the ss encoder family). Comparison ops keep result type bool, so
    // they never enter this branch (float compare is a separate follow-up).
    mut op_l := lhs_reg
    mut op_r := rhs_reg
    if type_id == 9 as u32 or type_id == 10 as u32:
        if opcode == OP_IADD:
            opcode = OP_FADD
        elif opcode == OP_ISUB:
            opcode = OP_FSUB
        elif opcode == OP_IMUL:
            opcode = OP_FMUL
        elif opcode == OP_IDIV:
            opcode = OP_FDIV
        if opcode == OP_FADD or opcode == OP_FSUB or opcode == OP_FMUL or opcode == OP_FDIV:
            if self.mb.node_types != null as ptr[u32]:
                let lt = self.mb.node_types[child as i64]
                let rt = self.mb.node_types[rhs_idx as i64]
                if lt != 9 as u32 and lt != 10 as u32:
                    let lconv = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: lconv, src1: lhs_reg, src2: 0 as u32))
                    op_l = lconv
                if rt != 9 as u32 and rt != 10 as u32:
                    let rconv = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: rconv, src1: rhs_reg, src2: 0 as u32))
                    op_r = rconv

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: op_l,
        src2: op_r,
    ))
    return reg

// RFC 0007: map a binary operator's token text to its conventional method name
// (Rust core::ops style). Returns "" for operators that are not overloadable.
// `!=` maps to `eq` (the caller negates the bool result).
fn op_to_method_name(op: str) -> str:
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "/":
        return "div"
    if op == "%":
        return "rem"
    if op == "==" or op == "!=":
        return "eq"
    if op == "<":
        return "lt"
    if op == "<=":
        return "le"
    if op == ">":
        return "gt"
    if op == ">=":
        return "ge"
    return ""

// RFC 0007: unwrap ptr/ref layers off a type id (helper for method matching).
fn op_unwrap_type(self: ptr[FuncLowering], t: u32) -> u32:
    mut u := t
    mut e := self.mb.typetable.entries.data[u as i64]
    while e.kind == TYPE_KIND_POINTER or e.kind == TYPE_KIND_REF:
        u = e.extra as u32
        e = self.mb.typetable.entries.data[u as i64]
    return u

// RFC 0007: resolve a struct/sum operator method by conventional name on a
// receiver type. Mirrors the non-generic method resolution in lower_call_expr:
// scan SYM_FUNC symbols whose (mangled) name matches `method_name`, whose first
// parameter (self, unwrapped) equals the receiver type AND â€” when `rhs_type` is
// known (non-zero) â€” whose second parameter (unwrapped) equals it. The rhs match
// supports mixed-type overloads (`add(self, o: u32)`) and, crucially, avoids
// silently calling `add(self, o: BigInt)` with a wrong-typed rhs. Returns 0 when
// no method matches (the operand types have no defined operator).
pub fn resolve_op_method(self: ptr[FuncLowering], method_name: str, rec_type: u32, rhs_type: u32) -> u32:
    let method_id = self.mb.pool.intern(method_name)
    let unwrapped = self.op_unwrap_type(rec_type)
    mut rhs_unwrapped := 0 as u32
    if rhs_type != 0 as u32:
        rhs_unwrapped = self.op_unwrap_type(rhs_type)
    mut i := 0 as i64
    while i < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
            let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len > 0 as i64:
                    let fp = self.op_unwrap_type(fi.params.data[0] as u32)
                    if fp == unwrapped:
                        // Constrain the rhs (2nd param) only when its type is
                        // known; binary operators always have a 2nd param.
                        mut rhs_ok := true
                        if rhs_unwrapped != 0 as u32:
                            rhs_ok = false
                            if fi.params.len > 1 as i64:
                                let sp = self.op_unwrap_type(fi.params.data[1] as u32)
                                if sp == rhs_unwrapped:
                                    rhs_ok = true
                        if rhs_ok:
                            return i as u32
        i = i + 1 as i64
    return 0 as u32

// RFC 0014 (drop-glue): find a `<Type>.drop(self)` method for `rec_type`, or 0.
// Mirrors resolve_op_method (same mangled-name substring match so an INLINE method
// declaration resolves -- BUG#68 lesson) but requires EXACTLY one param (`self`),
// so a stray `drop(self, x)` never matches. Called from lower_destroy: when CTGC
// injects an OP_DESTROY for a non-escaping owned local (RFC 0015 P3, `-ctgc-free`),
// the drop method runs on that instance right before its block is freed.
// RFC 0027 Â§3 path D (2026-07-22): is this expression an ALLOCATION or a null?
// The ownership test below frees a pointer field only when every value ever written
// to it has one of these two provenances. `@alloc`/`@realloc` lex as plain idents
// (lexer.ax skips the leading `@`), so a heap allocation is a CALL_EXPR to `alloc`;
// `null as ptr[T]` is a CAST of the `null` ident. Casts are transparent here because
// an allocation is always spelled `@alloc(..) as ptr[T]`.
// Anything else â€” a borrow `&x as ptr[u8]`, a parameter, another field, a function
// result â€” returns false, which classifies the field BORROWED and leaks it. That is
// the safe direction: a missed free wastes memory, a wrong free is a UAF.
fn expr_is_alloc_or_null(self: ptr[FuncLowering], idx: u32) -> bool:
    if idx == 0 as u32 or (idx as i64) >= self.mb.tree.nodes.len:
        return false
    let n = self.mb.tree.nodes.data[idx as i64]
    if n.kind == NODE_CAST_EXPR:
        return self.expr_is_alloc_or_null(n.first_child)
    if n.kind == NODE_IDENT:
        let t = self.mb.get_token_text(n.token_idx)
        let is_null = t == "null"
        safe_free_str(t)
        // A bare identifier is NEVER accepted, even when the local it names provably
        // holds a fresh allocation. Following the local one binding further was tried
        // and is UNSOUND: `let d = @alloc(..)` followed by `Buf(data: d)` (owning) and
        // by `View(borrowed: d)` (borrowing) are syntactically identical, so provenance
        // cannot separate them â€” the difference is whether anyone ELSE still holds the
        // pointer, which is an aliasing question. Oracle t_ctgcborrow caught this as a
        // real use-after-free (the borrowed buffer was freed, and the next allocation
        // reused and overwrote it). Only a syntactically FRESH allocation expression at
        // the write site proves sole ownership, because nothing else can hold it yet.
        return false
    if n.kind == NODE_CALL_EXPR:
        let c = n.first_child
        if c == 0 as u32:
            return false
        let cn = self.mb.tree.nodes.data[c as i64]
        let t = self.mb.get_token_text(cn.token_idx)
        let is_alloc = t == "alloc" or t == "realloc"
        safe_free_str(t)
        return is_alloc
    return false

// RFC 0027 Â§3 path D: is the field named `fname_id` an OWNED heap buffer?
//
// Ownership is DERIVED, not annotated (the design decision of 2026-07-22: infer from
// the type plus assignment provenance, adding no syntax). A pointer field is owned iff
//   (a) at least one write to it is an allocation, and
//   (b) NO write to it has any other provenance.
// Writes are found in the two places a field can be initialised: a named constructor
// argument (`Vec[T](data: @alloc(..))`) and a field assignment (`self.data = @alloc(..)`).
//
// The scan matches on the field NAME across the whole program, not per declaring type,
// so an unrelated struct with a same-named borrowed field poisons this one. That is
// deliberate: it can only ever move a field from owned to borrowed, i.e. from freeing
// to leaking. Being imprecise in the leak direction is sound; being imprecise in the
// free direction is a use-after-free.
fn field_is_owned_heap(self: ptr[FuncLowering], fname_id: u32) -> bool:
    let fname = self.mb.pool.get_str(fname_id)
    mut saw_alloc := false
    mut i := 0 as i64
    while i < self.mb.tree.nodes.len:
        let n = self.mb.tree.nodes.data[i]
        if n.kind == NODE_NAMED_ARG and n.payload == fname_id:
            // Constructor argument: parse_call_args interns the field name into the
            // NAMED_ARG's payload, so this is an exact match with no text compare.
            if self.expr_is_alloc_or_null(n.first_child):
                saw_alloc = true
            else:
                return false
        elif n.kind == NODE_ASSIGN_STMT:
            let lhs = n.first_child
            if lhs != 0 as u32:
                let ln = self.mb.tree.nodes.data[lhs as i64]
                // A FIELD_EXPR carries the field name in its own token_idx (same place
                // the method-call intercept at lower_call_expr reads it from).
                if ln.kind == NODE_FIELD_EXPR:
                    let t = self.mb.get_token_text(ln.token_idx)
                    let hit = t == fname
                    safe_free_str(t)
                    if hit:
                        if self.expr_is_alloc_or_null(ln.next_sibling):
                            saw_alloc = true
                        else:
                            return false
        i = i + 1 as i64
    return saw_alloc

// RFC 0027 path C's hand-audited allow-list, retained as a FALLBACK beside path D's
// derivation. Keeping it is not redundancy for its own sake: these three types are the
// ones whose free behaviour was validated against the escape analyser on a real corpus,
// and the derived rule is deliberately conservative (any same-named borrowed field
// anywhere in the program demotes a field to borrowed). Retaining the audited answer
// means path D can only ADD coverage for user containers and can never silently
// REMOVE the coverage path C already shipped. Kept in sync with std/collections.ax.
fn field_in_core_container(self: ptr[FuncLowering], owner_name: u32, fname_id: u32) -> bool:
    if owner_name != self.mb.pool.intern("Vec") and owner_name != self.mb.pool.intern("HashMap") and owner_name != self.mb.pool.intern("HashSet"):
        return false
    return fname_id == self.mb.pool.intern("data") or fname_id == self.mb.pool.intern("keys") or fname_id == self.mb.pool.intern("values") or fname_id == self.mb.pool.intern("hashes") or fname_id == self.mb.pool.intern("occupied")

// RFC 0027 (CTGC free-glue): before freeing the HEADER of a non-drop, non-escaping
// owned aggregate local, free the owned heap BUFFERS it points at, so nested heap is
// reclaimed rather than leaked. ax_free(null) is a no-op, so an unallocated container
// (cap 0, null buffers) is safe. Reached only under -ctgc-free (OP_DESTROY is injected
// only then), so the self-host build â€” which never uses the flag â€” is byte-identical
// (fixpoint-neutral by RFC 0027 Â§2.3).
//
// PATH D (2026-07-22) replaced path C's hard-coded allow-list â€” {Vec,HashMap,HashSet} x
// {data,keys,values,hashes,occupied} â€” with a derivation that reaches USER containers
// too. A field is freed when it is POINTER-typed (the type half) and every write to it
// is an allocation (the provenance half). On std/collections.ax this re-derives exactly
// the five fields path C listed, which is the migration's correctness argument: the
// general rule reproduces the hand-audited answer instead of being trusted blind.
//
// NOT recursed into: a nested aggregate FIELD (a `Vec` inside a struct). Under AXIOM's
// reference semantics (RFC 0001 Â§5) such a field may alias a live local, so freeing it
// transitively needs alias tracking the analyser does not have. Nested containers leak
// (safe) â€” see RFC 0027 Â§9.
fn emit_owned_field_frees(mut self: ptr[FuncLowering], reg: u32, type_id: u32):
    let ut = self.op_unwrap_type(type_id)
    if (ut as i64) >= self.mb.typetable.entries.len:
        return
    let entry = self.mb.typetable.entries.data[ut as i64]
    if entry.kind != TYPE_KIND_GENERIC_INST and entry.kind != TYPE_KIND_STRUCT:
        return
    if (entry.extra as i64) >= self.mb.typetable.structs.len:
        return
    let si = self.mb.typetable.structs.data[entry.extra as i64]
    mut fi := 0 as i64
    while fi < si.fields.len:
        let f = si.fields.data[fi]
        mut is_ptr := false
        if (f.type_id as i64) < self.mb.typetable.entries.len:
            if self.mb.typetable.entries.data[f.type_id as i64].kind == TYPE_KIND_POINTER:
                is_ptr = true
        if is_ptr and (self.field_in_core_container(entry.name_id, f.name_id) or self.field_is_owned_heap(f.name_id)):
            let fptr = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: f.type_id, dest: fptr, src1: reg, src2: fi as u32))
            self.fb.emit(AirInst(opcode: OP_FREE, type_id: 0 as u32, dest: 0 as u32, src1: fptr, src2: 0 as u32))
        fi = fi + 1 as i64

pub fn resolve_drop_method(self: ptr[FuncLowering], rec_type: u32) -> u32:
    let method_id = self.mb.pool.intern("drop")
    let unwrapped = self.op_unwrap_type(rec_type)
    mut i := 0 as i64
    while i < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[i]
        if sym.kind == SYM_FUNC and match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
            let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
            if t_entry.kind == TYPE_KIND_FUNC:
                let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                if fi.params.len == 1 as i64:
                    let fp = self.op_unwrap_type(fi.params.data[0] as u32)
                    if fp == unwrapped:
                        return i as u32
        i = i + 1 as i64
    return 0 as u32

// RFC 0007: lower an overloaded operator `a <op> b` to the method call
// `a.<method>(b)` (method symbol `msym` already resolved). Mirrors the
// method-call emission in lower_call_expr: a 2-element arg block [self, rhs] and
// an OP_CALL whose type_id carries the method symbol (src1=0). `!=` reuses the
// `eq` method and negates the bool result with OP_NOT.
pub fn lower_op_overload(mut self: ptr[FuncLowering], idx: u32, node: AstNode, base_idx: u32, msym: u32, is_ne: bool) -> u32:
    let rhs_idx = self.mb.tree.nodes.data[base_idx as i64].next_sibling
    let lhs_reg = self.lower_expr(base_idx)
    mut rhs_reg := 0 as u32
    if rhs_idx != 0 as u32:
        rhs_reg = self.lower_expr(rhs_idx)

    let arg_start = self.fb.emit_extra(2 as u32)
    self.fb.emit_extra(lhs_reg)
    self.fb.emit_extra(rhs_reg)

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_CALL,
        type_id: msym,
        dest: reg,
        src1: 0 as u32,
        src2: arg_start,
    ))

    if is_ne:
        let neg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_NOT, type_id: 11 as u32, dest: neg, src1: reg, src2: 0 as u32))
        return neg
    return reg

// RFC 0006 (#38.3): emit the multiplicative identity (1) for the power base type.
// Integer -> OP_ICONST 1; float -> OP_FCONST with the IEEE bit pattern of 1.0
// (single- or double-precision per type_id), mirroring lower_float_lit.
fn emit_one(mut self: ptr[FuncLowering], type_id: u32, is_float: bool) -> u32:
    let reg = self.fb.fresh_reg()
    if is_float:
        mut fone := 1.0 as f64
        mut bits := (&fone as ptr[u64])[0]
        if type_id == 9 as u32:
            mut f1 := fone as f32
            bits = ((&f1 as ptr[u32])[0]) as u64
        self.fb.emit(AirInst(opcode: OP_FCONST, type_id: type_id, dest: reg, src1: (bits & (0xFFFFFFFF as u64)) as u32, src2: (bits >> (32 as u64)) as u32))
    else:
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: type_id, dest: reg, src1: 1 as u32, src2: 0 as u32))
    return reg

// RFC 0006 (#38.3): lower `base ** exp`. Result type drives int (OP_IMUL) vs
// float (OP_FMUL); an integer base is promoted with a real OP_ITOF when the
// result is float. A constant non-negative exponent <= 64 is unrolled into a
// chain of multiplies; any other exponent (variable, or out of the unroll
// bound) emits a count-down runtime loop. Negative/fractional exponents are not
// supported (integer -> 0 path, float fractional unsupported) â€” rare and
// flagged as a known limitation, not silently miscompiled into garbage.
pub fn lower_power(mut self: ptr[FuncLowering], idx: u32, node: AstNode, base_idx: u32) -> u32:
    let exp_idx = self.mb.tree.nodes.data[base_idx as i64].next_sibling
    if exp_idx == 0 as u32:
        return self.lower_expr(base_idx)

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    let is_float = type_id == 9 as u32 or type_id == 10 as u32

    // Base evaluated exactly once (no double side effects).
    mut base_reg := self.lower_expr(base_idx)
    if is_float and self.mb.node_types != null as ptr[u32]:
        let bt = self.mb.node_types[base_idx as i64]
        if bt != 9 as u32 and bt != 10 as u32:
            let bc = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ITOF, type_id: type_id, dest: bc, src1: base_reg, src2: 0 as u32))
            base_reg = bc

    mut mul_op := OP_IMUL
    if is_float:
        mul_op = OP_FMUL

    // Constant exponent -> unroll.
    let exp_node = self.mb.tree.nodes.data[exp_idx as i64]
    if exp_node.kind == NODE_INT_LIT:
        let etext = self.mb.get_token_text(exp_node.token_idx)
        let n = parse_int_from_str(etext)
        @free(get_str_ptr(etext))
        if n >= 0 as i64 and n <= 64 as i64:
            if n == 0 as i64:
                return self.emit_one(type_id, is_float)
            if n == 1 as i64:
                let cp = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_COPY, type_id: type_id, dest: cp, src1: base_reg, src2: 0 as u32))
                return cp
            mut acc := self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: acc, src1: base_reg, src2: base_reg))
            mut k := 2 as i64
            while k < n:
                let nx = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: nx, src1: acc, src2: base_reg))
                acc = nx
                k = k + 1 as i64
            return acc

    // Variable exponent -> count-down loop. acc and cnt are loop-carried via
    // OP_COPY into fixed vregs, exactly how the front-end lowers user `mut`
    // locals across blocks (register-machine IR, no phi).
    let exp_reg = self.lower_expr(exp_idx)
    let acc = self.emit_one(type_id, is_float)
    let cnt = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: 3 as u32, dest: cnt, src1: exp_reg, src2: 0 as u32))

    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()
    let entry_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(entry_block, cond_block)

    self.fb.switch_to(cond_block)
    let zero = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 3 as u32, dest: zero, src1: 0 as u32, src2: 0 as u32))
    let test = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_GT, type_id: 11 as u32, dest: test, src1: cnt, src2: zero))
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: exit_block, src1: test, src2: body_block))
    self.fb.add_edge(cond_block, body_block)
    self.fb.add_edge(cond_block, exit_block)

    self.fb.switch_to(body_block)
    let nacc = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: mul_op, type_id: type_id, dest: nacc, src1: acc, src2: base_reg))
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: type_id, dest: acc, src1: nacc, src2: 0 as u32))
    let one_c = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 3 as u32, dest: one_c, src1: 1 as u32, src2: 0 as u32))
    let ncnt = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ISUB, type_id: 3 as u32, dest: ncnt, src1: cnt, src2: one_c))
    self.fb.emit(AirInst(opcode: OP_COPY, type_id: 3 as u32, dest: cnt, src1: ncnt, src2: 0 as u32))
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(body_block, cond_block)

    self.fb.switch_to(exit_block)
    self.terminated = false
    return acc

pub fn lower_unary_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    // BUG#84: `&a[i]` on a SCALAR element. lower_expr(child) below would LOAD the
    // element value (OP_INDEX), and OP_MAKE_REF then takes the address of that
    // TEMPORARY -- so the returned pointer aliases a stack temp, not the array slot
    // (writes are lost; reads past index 0 hit zeroed stack). Emit OP_INDEX_ADDR
    // (base + i*elem_size, no load) directly and return it, bypassing OP_MAKE_REF.
    // Aggregate `&agg[i]` is left on the existing OP_INDEX (which already yields the
    // element address for aggregates) + OP_MAKE_REF pass-through path, so the
    // compiler's own `&self.data[i]` self-codegen is unchanged.
    let child_node = self.mb.tree.nodes.data[child as i64]
    let op_tok0 = self.mb.get_token_text(node.token_idx)
    let is_ref_op = op_tok0 == "&"
    @free(get_str_ptr(op_tok0))
    if is_ref_op and child_node.kind == NODE_INDEX_EXPR:
        mut elem_ty := 0 as u32
        if self.mb.node_types != null as ptr[u32] and self.mb.node_types[child as i64] != 0 as u32:
            elem_ty = self.mb.node_types[child as i64] as u32
        if elem_ty != 0 as u32 and not type_is_aggregate(self.mb.typetable, elem_ty):
            let arr_child = child_node.first_child
            let arr_reg2 = self.lower_expr(arr_child)
            let idx_child = self.mb.tree.nodes.data[arr_child as i64].next_sibling
            mut idx_reg2 := 0 as u32
            if idx_child != 0 as u32:
                idx_reg2 = self.lower_expr(idx_child)
            mut ref_ty := elem_ty
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                ref_ty = self.mb.node_types[idx as i64] as u32
            let areg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_INDEX_ADDR,
                type_id: ref_ty,
                dest: areg,
                src1: arr_reg2,
                src2: idx_reg2,
            ))
            return areg

    // BUG#85: `&s.f` on a SCALAR field -- same defect as `&a[i]`. lower_expr(child)
    // (OP_GET_FIELD) LOADS the field value for scalars, so OP_MAKE_REF would take the
    // address of that temp. Emit OP_FIELD_ADDR (base + field_offset LEA, no load).
    // Only a genuine field LOAD (has an object child, not a qualified-variant/const
    // field-expr) with a scalar field type; aggregate `&s.aggfield` keeps the
    // OP_GET_FIELD (already returns the field address) + OP_MAKE_REF path.
    if is_ref_op and child_node.kind == NODE_FIELD_EXPR and child_node.first_child != 0 as u32 and (child_node.flags & 2048 as u16) == 0 as u16:
        mut fld_ty := 0 as u32
        if self.mb.node_types != null as ptr[u32] and self.mb.node_types[child as i64] != 0 as u32:
            fld_ty = self.mb.node_types[child as i64] as u32
        if fld_ty != 0 as u32 and not type_is_aggregate(self.mb.typetable, fld_ty):
            let obj_reg2 = self.lower_expr(child_node.first_child)
            mut ref_ty2 := fld_ty
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                ref_ty2 = self.mb.node_types[idx as i64] as u32
            let freg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_FIELD_ADDR,
                type_id: ref_ty2,
                dest: freg,
                src1: obj_reg2,
                src2: child_node.extra_idx,
            ))
            return freg

    let operand_reg = self.lower_expr(child)

    let op_token = self.mb.get_token_text(node.token_idx)
    mut opcode := OP_NOP
    if op_token == "-":
        opcode = OP_NEG
    elif op_token == "not" or op_token == "!":
        opcode = OP_NOT
    elif op_token == "~":
        opcode = OP_NOT
    elif op_token == "&":
        opcode = OP_MAKE_REF
    @free(get_str_ptr(op_token))

    mut type_id := 3 as u32 // default i32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: operand_reg,
        src2: 0 as u32,
    ))
    return reg

fn air_starts_with(s: str, prefix: str) -> bool:
    let s_len = std.string.len(s)
    let p_len = std.string.len(prefix)
    if s_len < p_len:
        return false
    let s_ptr = get_str_ptr(s)
    let p_ptr = get_str_ptr(prefix)
    mut i := 0 as i64
    while i < p_len:
        if s_ptr[i] != p_ptr[i]:
            return false
        i = i + 1 as i64
    return true

fn match_base_names(base1: str, base2: str) -> bool:
    if base1 == base2:
        return true
    let len1 = std.string.len(base1)
    let len2 = std.string.len(base2)
    if len1 == 0 as i64 or len2 == 0 as i64:
        return false
        
    let ptr1 = get_str_ptr(base1)
    let ptr2 = get_str_ptr(base2)
    
    mut dot1 := -1 as i64
    mut i1 := len1 - 1 as i64
    while i1 >= 0 as i64:
        if ptr1[i1] == '.' as u8:
            dot1 = i1
            break
        i1 = i1 - 1
        
    mut dot2 := -1 as i64
    mut i2 := len2 - 1 as i64
    while i2 >= 0 as i64:
        if ptr2[i2] == '.' as u8:
            dot2 = i2
            break
        i2 = i2 - 1
        
    mut start1 := 0 as i64
    if dot1 != -1 as i64:
        start1 = dot1 + 1 as i64
        
    mut start2 := 0 as i64
    if dot2 != -1 as i64:
        start2 = dot2 + 1 as i64
    
    let sub_len1 = len1 - start1
    let sub_len2 = len2 - start2
    
    if sub_len1 != sub_len2:
        return false
        
    mut k := 0 as i64
    while k < sub_len1:
        if ptr1[start1 + k] != ptr2[start2 + k]:
            return false
        k = k + 1
        
    return true

fn match_mangled_method_raw_bytes(pool: ptr[InternPool], sym_id: u32, method_id: u32) -> bool:
    if sym_id == method_id:
        return true
    if sym_id == 0 as u32 or method_id == 0 as u32:
        return false
        
    let sym_entry = pool.ids[sym_id as i64 - 1]
    let method_entry = pool.ids[method_id as i64 - 1]
    
    let sym_bytes = (pool.arena as i64 + sym_entry.start as i64) as ptr[u8]
    let method_bytes = (pool.arena as i64 + method_entry.start as i64) as ptr[u8]
    
    let sym_len = sym_entry.len as i64
    let method_len = method_entry.len as i64
    
    if sym_len < method_len:
        return false
        
    mut i := 0 as i64
    while i <= sym_len - method_len:
        mut matches := true
        mut j := 0 as i64
        while j < method_len:
            if sym_bytes[i + j] != method_bytes[j]:
                matches = false
                break
            j = j + 1 as i64
            
        if matches:
            mut post_ok := false
            if i + method_len == sym_len:
                post_ok = true
            elif i + method_len + 2 <= sym_len:
                if sym_bytes[i + method_len] == 95 as u8 and sym_bytes[i + method_len + 1] == 95 as u8:
                    post_ok = true
                    
            if post_ok:
                mut pre_ok := false
                if i == 0:
                    pre_ok = true
                else:
                    let prev_char = sym_bytes[i - 1]
                    if prev_char == 46 as u8 or prev_char == 95 as u8: // '.' or '_'
                        pre_ok = true
                        
                if pre_ok:
                    return true
                    
        i = i + 1 as i64
        
    return false

fn match_mangled_method_name(sym_name: str, method_name: str) -> bool:
    if sym_name == method_name:
        return true
    let prefix = std.string.concat("_AX_std_", method_name)
    let full_prefix = std.string.concat(prefix, "__")
    let starts := air_starts_with(sym_name, full_prefix)
    @free(get_str_ptr(prefix))
    @free(get_str_ptr(full_prefix))
    return starts

// f32<->f64 implicit argument coercion. A call argument whose static type is one
// float width, passed to a parameter of the OTHER float width, needs a real convert
// (cvtss2sd / cvtsd2ss). Without it the callee reads the raw bits at the wrong width:
// an f32 variable into an f64 param read 0, and a user free fn with a concrete float
// param shadowing a generic method (Vec.map) segfaulted (accept-then-miscompile,
// the residual HOLE at the end of [[bug-freefn-stdlib-collision-noarg]]). Reuses the
// existing OP_CAST float-pair lowering (x86_selector -> MACH_CVTSS2SD/CVTSD2SS).
// Returns the original reg when no coercion applies. Guarded to a resolved FUNC
// symbol whose parameter at `param_idx` is a concrete f32/f64, so integer/aggregate
// args and the compiler's own f64-only float code are untouched (dormant for
// self-compilation -> fixpoint-safe).
// RFC 0029: find the SYM_FUNC symbol index of concrete struct `struct_type`'s method
// named `method_id` (its param[0] == the receiver type). Mirrors the UFCS method-dispatch
// match-by-(name,receiver) loop. Returns 0 if none.
pub fn find_struct_method_sym(mut self: ptr[FuncLowering], struct_type: u32, method_id: u32) -> u32:
    mut i := 0 as i64
    while i < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[i]
        if sym.kind == SYM_FUNC and sym.type_id != 0 as u32 and (sym.type_id as i64) < self.mb.typetable.entries.len:
            if match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
                let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
                if t_entry.kind == TYPE_KIND_FUNC:
                    let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                    if fi.params.len > 0 as i64:
                        mut fp := fi.params.data[0]
                        mut pe = self.mb.typetable.entries.data[fp as i64]
                        while pe.kind == TYPE_KIND_POINTER or pe.kind == TYPE_KIND_REF:
                            fp = pe.extra
                            pe = self.mb.typetable.entries.data[fp as i64]
                        if fp == struct_type:
                            return i as u32
        i = i + 1
    return 0 as u32

// RFC 0029: get/create the "box" struct type backing an interface value â€” a struct with
// (N+1) i64 fields {data, m0..m(N-1)}: field 0 = the concrete receiver's address, fields
// 1..N = the concrete methods' code addresses (an inline per-value vtable). The interface
// value is an 8-byte pointer to a heap instance of this box. Cached by reusing the
// interface's own name_id for the synthesized struct (interfaces and structs never share a
// name), so repeat coercions/dispatch reuse the same type.
pub fn ensure_iface_box_type(mut self: ptr[FuncLowering], iface_type: u32) -> u32:
    if (iface_type as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let iface_name = self.mb.typetable.entries.data[iface_type as i64].name_id
    mut i := 0 as i64
    while i < self.mb.typetable.entries.len:
        let e = self.mb.typetable.entries.data[i]
        if e.kind == TYPE_KIND_STRUCT and e.name_id == iface_name and iface_name != 0 as u32:
            return i as u32
        i = i + 1
    let methods = self.mb.typetable.interface_method_list(iface_type)
    mut fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
    (&fields).push(StructField(name_id: iface_name, type_id: 4 as u32)) // data
    mut k := 0 as i64
    while k < methods.len:
        (&fields).push(StructField(name_id: methods.data[k], type_id: 4 as u32)) // method ptr
        k = k + 1
    return self.mb.typetable.register_struct(iface_name, fields)

// RFC 0029: coerce a concrete struct value into an interface value â€” build the box
// {data = &struct, m0..m(N-1) = &struct.method_k} and return an 8-byte pointer to it.
pub fn build_interface_value(mut self: ptr[FuncLowering], struct_reg: u32, struct_type: u32, iface_type: u32) -> u32:
    let box_ty = self.ensure_iface_box_type(iface_type)
    if box_ty == 0 as u32:
        return struct_reg
    let box = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ALLOC, type_id: box_ty, dest: box, src1: 0 as u32, src2: 0 as u32))
    // field 0 = data (the struct's by-address pointer)
    self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: box_ty, dest: struct_reg, src1: box, src2: 0 as u32))
    let methods = self.mb.typetable.interface_method_list(iface_type)
    mut k := 0 as i64
    while k < methods.len:
        let msym = self.find_struct_method_sym(struct_type, methods.data[k])
        let fa = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_FUNC_ADDR, type_id: 4 as u32, dest: fa, src1: msym, src2: 0 as u32))
        self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: box_ty, dest: fa, src1: box, src2: (k + 1 as i64) as u32))
        k = k + 1
    return box

// RFC 0029: if the callee's param at `param_idx` is an interface and the arg is a concrete
// struct, build the interface box value; otherwise pass the arg unchanged.
pub fn coerce_interface_arg(mut self: ptr[FuncLowering], fn_sym: u32, param_idx: u32, arg_node: u32, arg_reg: u32) -> u32:
    if fn_sym == 0 as u32 or (fn_sym as i64) >= self.mb.symbols.symbols.len:
        return arg_reg
    if self.mb.node_types == null as ptr[u32]:
        return arg_reg
    let sym = self.mb.symbols.symbols.data[fn_sym as i64]
    if sym.kind != SYM_FUNC or sym.type_id == 0 as u32 or (sym.type_id as i64) >= self.mb.typetable.entries.len:
        return arg_reg
    let e = self.mb.typetable.entries.data[sym.type_id as i64]
    if e.kind != TYPE_KIND_FUNC:
        return arg_reg
    let fi = self.mb.typetable.funcs.data[e.extra as i64]
    if (param_idx as i64) >= fi.params.len:
        return arg_reg
    let pt = fi.params.data[param_idx as i64]
    if (pt as i64) >= self.mb.typetable.entries.len or self.mb.typetable.entries.data[pt as i64].kind != TYPE_KIND_INTERFACE:
        return arg_reg
    return self.coerce_struct_to_interface(pt, arg_node, arg_reg)

// RFC 0029: general T->I coercion. If `target_type` is an interface and the source
// expression (`src_node`) is a concrete struct, build the interface box value and return
// its pointer; otherwise return `src_reg` unchanged. Used at every site a concrete struct
// can flow into an interface-typed slot: call-arg, let-binding, return, struct-field init,
// assignment. Without this, a struct stored into an interface slot dispatches on raw struct
// bytes -> segfault (the "demonstrated hole": only call-arg was covered before).
pub fn coerce_struct_to_interface(mut self: ptr[FuncLowering], target_type: u32, src_node: u32, src_reg: u32) -> u32:
    if self.mb.node_types == null as ptr[u32]:
        return src_reg
    if (target_type as i64) >= self.mb.typetable.entries.len or self.mb.typetable.entries.data[target_type as i64].kind != TYPE_KIND_INTERFACE:
        return src_reg
    if src_node == 0 as u32:
        return src_reg
    let at = self.mb.node_types[src_node as i64]
    if at == 0 as u32 or (at as i64) >= self.mb.typetable.entries.len or self.mb.typetable.entries.data[at as i64].kind != TYPE_KIND_STRUCT:
        return src_reg
    return self.build_interface_value(src_reg, at, target_type)

pub fn coerce_float_arg(mut self: ptr[FuncLowering], fn_sym: u32, param_idx: u32, arg_node: u32, arg_reg: u32) -> u32:
    if fn_sym == 0 as u32 or (fn_sym as i64) >= self.mb.symbols.symbols.len:
        return arg_reg
    if self.mb.node_types == null as ptr[u32]:
        return arg_reg
    let sym = self.mb.symbols.symbols.data[fn_sym as i64]
    if sym.kind != SYM_FUNC or sym.type_id == 0 as u32 or (sym.type_id as i64) >= self.mb.typetable.entries.len:
        return arg_reg
    let e = self.mb.typetable.entries.data[sym.type_id as i64]
    if e.kind != TYPE_KIND_FUNC:
        return arg_reg
    let fi = self.mb.typetable.funcs.data[e.extra as i64]
    if (param_idx as i64) >= fi.params.len:
        return arg_reg
    let pt = fi.params.data[param_idx as i64]
    if pt != 9 as u32 and pt != 10 as u32:
        return arg_reg
    let at = self.mb.node_types[arg_node as i64]
    if (at != 9 as u32 and at != 10 as u32) or at == pt:
        return arg_reg
    let cr = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_CAST, type_id: pt, dest: cr, src1: arg_reg, src2: 0 as u32))
    return cr

pub fn lower_call_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let callee_node = self.mb.tree.nodes.data[child as i64]

    // BUG#90: intercept Option/Result methods (unwrap/is_some/is_none/is_ok/is_err) on
    // a receiver typed as Option/Result, and emit the SAME deterministic pointer-tagged
    // inline logic lower_match_tagged uses (Some/Ok=box non-null/even; payload=[box]).
    // std/result.ax reads the box via `(&self)[0]`, which crashes when self's param
    // home-slot doesn't hold the box pointer (e.g. an Option returned by a mono'd
    // generic method). This is off the stdlib ABI, same tactic RFC 0012 used for match.
    if callee_node.kind == NODE_FIELD_EXPR and self.mb.node_types != null as ptr[u32]:
        let orc_recv = callee_node.first_child
        if orc_recv != 0 as u32:
            let orc_rty = self.mb.node_types[orc_recv as i64]
            if self.opt_res_kind(orc_rty) >= 0 as i64:
                let mtok = self.mb.get_token_text(callee_node.token_idx)
                mut orc_handled := false
                mut orc_reg := 0 as u32
                if mtok == "unwrap":
                    let rr = self.lower_expr(orc_recv)
                    mut pl_type := 4 as u32
                    if self.mb.node_types[idx as i64] != 0 as u32:
                        pl_type = self.mb.node_types[idx as i64] as u32
                    orc_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_DEREF, type_id: pl_type, dest: orc_reg, src1: rr, src2: 0 as u32))
                    orc_handled = true
                elif mtok == "is_some" or mtok == "is_none":
                    let rr = self.lower_expr(orc_recv)
                    let zr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zr, src1: 0 as u32, src2: 0 as u32))
                    orc_reg = self.fb.fresh_reg()
                    mut opc := OP_NE
                    if mtok == "is_none":
                        opc = OP_EQ
                    self.fb.emit(AirInst(opcode: opc, type_id: 11 as u32, dest: orc_reg, src1: rr, src2: zr))
                    orc_handled = true
                elif mtok == "is_ok" or mtok == "is_err":
                    let rr = self.lower_expr(orc_recv)
                    let onr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: onr, src1: 1 as u32, src2: 0 as u32))
                    let bitr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: bitr, src1: rr, src2: onr))
                    let zr = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zr, src1: 0 as u32, src2: 0 as u32))
                    orc_reg = self.fb.fresh_reg()
                    mut opc := OP_EQ
                    if mtok == "is_err":
                        opc = OP_NE
                    self.fb.emit(AirInst(opcode: opc, type_id: 11 as u32, dest: orc_reg, src1: bitr, src2: zr))
                    orc_handled = true
                safe_free_str(mtok)
                if orc_handled:
                    return orc_reg

    // RFC 0029: dynamic dispatch through an interface-typed receiver. The receiver value is
    // an 8-byte pointer to a box {data, m0..m(N-1)} (built at the T->I coercion site). Read
    // the concrete receiver (data = field 0) and the method's code pointer (field slot+1),
    // then indirect-call fptr(data, explicit args...). Closes BUG#71.
    if callee_node.kind == NODE_FIELD_EXPR and self.mb.node_types != null as ptr[u32]:
        let if_recv = callee_node.first_child
        if if_recv != 0 as u32:
            mut if_rty := self.mb.node_types[if_recv as i64]
            if if_rty != 0 as u32 and (if_rty as i64) < self.mb.typetable.entries.len:
                mut ife = self.mb.typetable.entries.data[if_rty as i64]
                while (ife.kind == TYPE_KIND_POINTER or ife.kind == TYPE_KIND_REF) and (if_rty as i64) < self.mb.typetable.entries.len:
                    if_rty = ife.extra
                    ife = self.mb.typetable.entries.data[if_rty as i64]
                if ife.kind == TYPE_KIND_INTERFACE:
                    let mtok2 = self.mb.get_token_text(callee_node.token_idx)
                    let mid = self.mb.pool.intern(mtok2)
                    safe_free_str(mtok2)
                    let methods = self.mb.typetable.interface_method_list(if_rty)
                    mut slot := -1 as i64
                    mut si := 0 as i64
                    while si < methods.len:
                        if methods.data[si] == mid:
                            slot = si
                            break
                        si = si + 1
                    if slot >= 0 as i64:
                        let boxr = self.lower_expr(if_recv)
                        let datar = self.fb.fresh_reg()
                        self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: 4 as u32, dest: datar, src1: boxr, src2: 0 as u32))
                        let fptrr = self.fb.fresh_reg()
                        self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: 4 as u32, dest: fptrr, src1: boxr, src2: (slot + 1 as i64) as u32))
                        mut iargs := @alloc(64 * 8) as ptr[u32]
                        iargs[0] = datar
                        mut icount := 1 as u32
                        mut ia := callee_node.next_sibling
                        while ia != 0 as u32:
                            iargs[icount as i64] = self.lower_expr(ia)
                            icount = icount + 1 as u32
                            ia = self.mb.tree.nodes.data[ia as i64].next_sibling
                        let iarg_start = self.fb.emit_extra(icount)
                        mut ii := 0 as u32
                        while ii < icount:
                            self.fb.emit_extra(iargs[ii as i64])
                            ii = ii + 1 as u32
                        @free(iargs as ptr[u8])
                        mut irty := 4 as u32
                        if self.mb.node_types[idx as i64] != 0 as u32:
                            irty = self.mb.node_types[idx as i64]
                        let ires = self.fb.fresh_reg()
                        self.fb.emit(AirInst(opcode: OP_CALL, type_id: irty, dest: ires, src1: fptrr, src2: iarg_start))
                        return ires

    if callee_node.kind == NODE_FIELD_EXPR:
        let field_name_id = callee_node.payload
        let field_name = self.mb.pool.get(field_name_id)
        if field_name == "new":
            mut is_collection_new := false
            let rec_node = callee_node.first_child
            if rec_node != 0 as u32:
                mut ret_type := 0 as u32
                if self.mb.node_types != null as ptr[u32]:
                    ret_type = self.mb.node_types[idx as i64]
                if ret_type != 0 as u32 and (ret_type as i64) < self.mb.typetable.entries.len:
                    let entry = self.mb.typetable.entries.data[ret_type as i64]
                    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                        is_collection_new = true
            
            if is_collection_new:
                mut ret_type := 0 as u32
                if self.mb.node_types != null as ptr[u32]:
                    ret_type = self.mb.node_types[idx as i64]
                return self.lower_struct_constructor_call(idx, node, ret_type)
    
    if callee_node.kind == NODE_IDENT:
        let sym_idx = callee_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let name_id = self.mb.symbols.symbols.data[sym_idx as i64].name_id
            let name = self.mb.pool.get(name_id)
            if name == "compiler_intrinsic":
                let arg_idx = callee_node.next_sibling
                if arg_idx != 0 as u32:
                    let arg_node = self.mb.tree.nodes.data[arg_idx as i64]
                    if arg_node.kind == NODE_STRING_LIT:
                        let arg_text = self.mb.get_token_text(arg_node.token_idx)
                        mut lower_to_const := false
                        mut const_type := 0 as u32
                        mut const_val := 0 as u32
                        
                        if arg_text == "\"is_windows\"" or arg_text == "'is_windows'" or arg_text == "is_windows":
                            lower_to_const = true
                            const_type = 11 as u32
                            if self.mb.target_is_windows:
                                const_val = 1 as u32
                            else:
                                const_val = 0 as u32
                        elif arg_text == "\"is_linux\"" or arg_text == "'is_linux'" or arg_text == "is_linux":
                            lower_to_const = true
                            const_type = 11 as u32
                            if self.mb.target_is_windows:
                                const_val = 0 as u32
                            else:
                                const_val = 1 as u32
                        elif arg_text == "\"is_macos\"" or arg_text == "'is_macos'" or arg_text == "is_macos":
                            lower_to_const = true
                            const_type = 11 as u32
                            const_val = 0 as u32
                        elif arg_text == "\"os_name\"" or arg_text == "'os_name'" or arg_text == "os_name":
                            lower_to_const = true
                            const_type = 12 as u32
                            if self.mb.target_is_windows:
                                const_val = self.mb.pool.intern("\"windows\"")
                            else:
                                const_val = self.mb.pool.intern("\"linux\"")
                        elif arg_text == "\"arch_name\"" or arg_text == "'arch_name'" or arg_text == "arch_name":
                            lower_to_const = true
                            const_type = 12 as u32
                            const_val = self.mb.pool.intern("\"x86_64\"")
                        elif arg_text == "\"path_separator\"" or arg_text == "'path_separator'" or arg_text == "path_separator":
                            lower_to_const = true
                            const_type = 12 as u32
                            if self.mb.target_is_windows:
                                const_val = self.mb.pool.intern("\"\\\\\"")
                            else:
                                const_val = self.mb.pool.intern("\"/\"")
                        
                        if lower_to_const:
                            @free(get_str_ptr(arg_text))
                            let reg = self.fb.fresh_reg()
                            self.fb.emit(AirInst(
                                opcode: OP_ICONST,
                                type_id: const_type,
                                dest: reg,
                                src1: const_val,
                                src2: 0 as u32,
                            ))
                            return reg
                        @free(get_str_ptr(arg_text))
    
    // Check if callee is a constant â€” if so, inline the value rather than calling
    if callee_node.kind == NODE_IDENT:
        let const_sym_idx = callee_node.payload
        if const_sym_idx != 0 as u32 and (const_sym_idx as i64) < self.mb.symbols.symbols.len:
            let const_sym = self.mb.symbols.symbols.data[const_sym_idx as i64]
            if const_sym.kind == SYM_CONST:
                // Inline the constant value by lowering its initializer expression
                mut init_expr := 0 as u32
                mut const_child := self.mb.tree.nodes.data[const_sym.decl_node as i64].first_child
                while const_child != 0 as u32:
                    let const_child_node = self.mb.tree.nodes.data[const_child as i64]
                    if const_child_node.kind != NODE_TYPE_EXPR and const_child_node.kind != NODE_GENERIC_TYPE:
                        init_expr = const_child
                    const_child = const_child_node.next_sibling
                if init_expr != 0 as u32:
                    return self.lower_expr(init_expr)
                // Const with no initializer â€” return 0
                let zero_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 3 as u32,
                    dest: zero_reg,
                    src1: 0 as u32,
                    src2: 0 as u32,
                ))
                return zero_reg
    
    // Check if callee is a method call on a struct
    mut is_method_call := false
    mut method_sym_idx := 0 as u32
    mut receiver_node_idx := 0 as u32
    if callee_node.kind == NODE_FIELD_EXPR:
        receiver_node_idx = callee_node.first_child
        
        if (callee_node.flags & 2048 as u16) != 0 as u16:
            let spec_sym_idx = callee_node.payload
            mut is_real_method := false
            mut rec_type := 0 as u32
            if receiver_node_idx != 0 as u32:
                let receiver_node = self.mb.tree.nodes.data[receiver_node_idx as i64]
                mut is_module_rec := false
                mut rec_sym_idx := 0 as u32
                if receiver_node.kind == NODE_IDENT:
                    rec_sym_idx = receiver_node.payload
                elif receiver_node.kind == NODE_FIELD_EXPR:
                    if (receiver_node.flags & 2048 as u16) != 0 as u16:
                        rec_sym_idx = receiver_node.payload
                if rec_sym_idx != 0 as u32 and (rec_sym_idx as i64) < self.mb.symbols.symbols.len:
                    let rec_sym = self.mb.symbols.symbols.data[rec_sym_idx as i64]
                    if rec_sym.kind == SYM_MODULE:
                        is_module_rec = true
                if not is_module_rec:
                    if self.mb.node_types != null as ptr[u32]:
                        rec_type = self.mb.node_types[receiver_node_idx as i64]
                        if rec_type == 0 as u32:
                            is_real_method = true
                        elif (rec_type as i64) < self.mb.typetable.entries.len:
                            mut entry = self.mb.typetable.entries.data[rec_type as i64]
                            while (entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF) and (rec_type as i64) < self.mb.typetable.entries.len:
                                rec_type = entry.extra
                                if (rec_type as i64) < self.mb.typetable.entries.len:
                                    entry = self.mb.typetable.entries.data[rec_type as i64]
                            if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                                is_real_method = true
            
            if is_real_method:
                if spec_sym_idx != 0 as u32 and (spec_sym_idx as i64) < self.mb.symbols.symbols.len:
                    let sym = self.mb.symbols.symbols.data[spec_sym_idx as i64]
                    if sym.kind == SYM_FUNC:
                        let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
                        if t_entry.kind == TYPE_KIND_FUNC:
                            let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                            if fi.params.len > 0 as i64:
                                is_method_call = true
                                method_sym_idx = spec_sym_idx
        if not is_method_call:
            mut resolved := false

            if not resolved:
                receiver_node_idx = callee_node.first_child
                // The match-by-name UFCS dispatch below is a REPAIR for calls the resolver
                // could NOT bind â€” it is receiver-type-agnostic and picks the FIRST same-named
                // SYM_FUNC by symbol order. When the callee FIELD_EXPR is ALREADY resolved
                // (flag 2048) it must NOT run: a real method call is already handled by the
                // flag-2048 branch above (sets is_method_call there), and a module-qualified
                // free call (`lib_b.close(...)`) carries the EXACT resolved payload â€” re-running
                // UFCS would override it with the first same-named fn (e.g. lib_a.close for a
                // lib_b.close call when two modules define `close`), mis-linking cross-module
                // same-name calls (t_modcollide 101â†’2 once an unrelated stdlib symbol shifts
                // indices enough to make the loop match). See
                // [[bug-crossmodule-resolution-fragility-open]].
                let callee_resolved = (callee_node.flags & 2048 as u16) != 0 as u16
                if receiver_node_idx != 0 as u32 and self.mb.node_types != null as ptr[u32] and not callee_resolved:
                    mut rec_type := self.mb.node_types[receiver_node_idx as i64]
                    if rec_type != 0 as u32 and (rec_type as i64) < self.mb.typetable.entries.len:
                        mut entry = self.mb.typetable.entries.data[rec_type as i64]
                        while (entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF) and (rec_type as i64) < self.mb.typetable.entries.len:
                            rec_type = entry.extra
                            if (rec_type as i64) < self.mb.typetable.entries.len:
                                entry = self.mb.typetable.entries.data[rec_type as i64]
                        
                        // RFC 0020 P3: UFCS method dispatch on a PRIMITIVE `str`/`bytes`
                        // receiver â€” `s.trim()`, `s.contains(x)`, ... resolve to a free
                        // function whose first param is `str`/`bytes` (e.g. std.string.*),
                        // exactly like a struct method (param[0] == receiver). Previously
                        // typecheck accepted the call (a matching free fn exists) but this
                        // dispatch loop excluded primitive receivers, so the callee fell
                        // through to getfld + indirect call -> SIGSEGV (accept-then-
                        // miscompile, BUG#53 class). The match-by-first-param loop below is
                        // already receiver-type-agnostic, so only the guard needs widening.
                        // TYPE_KIND_PRIMITIVE covers str/bytes AND the scalar numerics
                        // (i64/u64/f64/...): a numeric UFCS method-form like `n.to_str()`
                        // / `n.to_hex()` resolves to a free fn whose first param is that
                        // primitive (std.string.to_str(i64), ...), exactly like the str
                        // receivers shipped in RFC 0020 P3. Without this, a primitive
                        // receiver fell through to getfld + indirect call -> SIGSEGV
                        // (accept-then-miscompile, BUG#53 class). The match-by-first-param
                        // loop below is receiver-type-agnostic, so only the guard widens.
                        if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT or entry.kind == TYPE_KIND_PRIMITIVE:
                            let m_name_tok = self.mb.get_token_text(callee_node.token_idx)
                            let method_id = self.mb.pool.intern(m_name_tok)
                            safe_free_str(m_name_tok)
                            mut i := 0 as i64
                            while i < self.mb.symbols.symbols.len:
                                let sym = self.mb.symbols.symbols.data[i]
                                if sym.kind == SYM_FUNC:
                                    if match_mangled_method_raw_bytes(self.mb.pool, sym.name_id, method_id):
                                        let t_entry = self.mb.typetable.entries.data[sym.type_id as i64]
                                        if t_entry.kind == TYPE_KIND_FUNC:
                                            let fi = self.mb.typetable.funcs.data[t_entry.extra as i64]
                                            if fi.params.len > 0 as i64:
                                                mut first_param := fi.params.data[0]
                                                mut p_entry = self.mb.typetable.entries.data[first_param as i64]
                                                while p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
                                                    first_param = p_entry.extra
                                                    p_entry = self.mb.typetable.entries.data[first_param as i64]
                                                
                                                mut matches_type := false
                                                if first_param == rec_type:
                                                    matches_type = true
                                                // Numeric UFCS widening (mirror of the
                                                // typecheck gate, method_ret_type ~1096):
                                                // a narrower integer receiver matches an
                                                // i64 first param (4). No receiver cast is
                                                // emitted: narrow-int registers are already
                                                // normalized to full 64-bit width by the
                                                // selector, so the value equals `recv as
                                                // i64` already. NOT f32->f64 (needs a real
                                                // cvtss2sd, would miscompile with no cast).
                                                if first_param == 4 as u32 and (rec_type == 1 as u32 or rec_type == 2 as u32 or rec_type == 3 as u32 or rec_type == 5 as u32 or rec_type == 6 as u32 or rec_type == 7 as u32):
                                                    matches_type = true
                                                if matches_type:
                                                    method_sym_idx = i as u32
                                                    resolved = true
                                                    is_method_call = true
                                                    break
                                i = i + 1 as i64

    // Variant constructors (Ok/Err/Some/None) use the pointer-layout sum
    // representation, matching the C backend macros ax_Result_ok/ax_Result_err:
    // payload is boxed on the heap; Err sets tag bit 0; None is the null pointer.
    // std/result.ax reads this layout when ax_sum_layout_is_pointer() is true.
    // Detection is by token text: the variant symbol may come from an imported
    // module whose intern pool differs from this module's, so the symbol's
    // name_id cannot be compared against self.mb.pool here.
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let v_name = self.mb.get_token_text(callee_node.token_idx)
        mut variant_ctor := 0 as i64
        if v_name == "Ok":
            variant_ctor = 1
        elif v_name == "Err":
            variant_ctor = 2
        elif v_name == "Some":
            variant_ctor = 3
        elif v_name == "None":
            variant_ctor = 4
        @free(get_str_ptr(v_name))
        if variant_ctor != 0:
            if variant_ctor == 4:
                // None = null pointer (a plain 8-byte i64 zero).
                let none_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 4 as u32,
                    dest: none_reg,
                    src1: 0 as u32,
                    src2: 0 as u32,
                ))
                return none_reg
            mut payload_reg := 0 as u32
            mut payload_t := 0 as u32
            let payload_idx = callee_node.next_sibling
            if payload_idx != 0 as u32:
                payload_reg = self.lower_expr(payload_idx)
                if self.mb.node_types != null as ptr[u32]:
                    payload_t = self.mb.node_types[payload_idx as i64]
                    // RFC 0029: if the declared Option/Result payload is an INTERFACE (the
                    // ctor node typed Option[I]/Result[I] by typecheck), box the concrete
                    // struct payload into an interface value before storing it, so the box's
                    // 8-byte payload slot holds a vtable box pointer and `unwrap().m()`
                    // dispatches dynamically. coerce_struct_to_interface self-guards (only
                    // fires when node_types[payload_idx] is a struct), so this is inert for
                    // scalar/str/non-interface payloads.
                    if payload_reg != 0 as u32:
                        let iface_t = self.opt_res_ctor_iface(self.mb.node_types[idx as i64], variant_ctor)
                        if iface_t != 0 as u32:
                            let boxed = self.coerce_struct_to_interface(iface_t, payload_idx, payload_reg)
                            if boxed != payload_reg:
                                payload_reg = boxed
                                payload_t = iface_t
            // RFC 0012: type the box register with a real Option/Result type
            // (kind 11/12), computed LOCALLY from the payload type â€” NOT `str` (12).
            // The kind-11/12 entry is size-16 (so OP_ALLOC still reserves room for a
            // str payload) but AGGREGATE, so â€” exactly like a user sum (kind 6) â€” the
            // value is an 8-byte box pointer that copies/passes as a pointer. Because
            // the register type is no longer str(12), EQ/COPY/MAKE_REF stop taking the
            // string-by-address deref path, which is what lets `match` (lower_match_
            // tagged) dispatch on the box pointer. Done here (not via typecheck) to
            // keep the change off the stdlib's generic Option/Result ABI.
            mut box_ty := 12 as u32
            if variant_ctor == 3:
                box_ty = self.mb.typetable.register_option(payload_t)
            elif variant_ctor == 1:
                box_ty = self.mb.typetable.register_result(payload_t, 0 as u32)
            elif variant_ctor == 2:
                box_ty = self.mb.typetable.register_result(0 as u32, payload_t)
            let box_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_ALLOC,
                type_id: box_ty,
                dest: box_reg,
                src1: 0 as u32,
                src2: 0 as u32,
            ))
            if payload_reg != 0 as u32:
                // str payloads copy all 16 bytes; everything else stores
                // the 8-byte value (scalars and struct heap pointers).
                mut store_t := 4 as u32
                if payload_t == 12 as u32:
                    store_t = 12 as u32
                self.fb.emit(AirInst(
                    opcode: OP_STORE,
                    type_id: store_t,
                    dest: box_reg,
                    src1: payload_reg,
                    src2: 0 as u32,
                ))
            if variant_ctor == 2:
                let one_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: 4 as u32,
                    dest: one_reg,
                    src1: 1 as u32,
                    src2: 0 as u32,
                ))
                let tagged_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_OR,
                    type_id: box_ty,
                    dest: tagged_reg,
                    src1: box_reg,
                    src2: one_reg,
                ))
                return tagged_reg
            return box_reg

    // RFC 0004: a non-builtin user sum variant with a payload, e.g. `Circle(r)`.
    // Reached only when the Ok/Err/Some/None name match above did NOT apply, so
    // Option/Result keep their pointer layout while user sums get the tag-in-box
    // layout. Guarded on TYPE_KIND_SUM so only kind-6 sums take this path.
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let vcsym_idx = callee_node.payload
        if vcsym_idx != 0 as u32 and (vcsym_idx as i64) < self.mb.symbols.symbols.len:
            let vcsym = self.mb.symbols.symbols.data[vcsym_idx as i64]
            if vcsym.kind == SYM_VARIANT and vcsym.type_id != 0 as u32 and (vcsym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[vcsym.type_id as i64].kind == TYPE_KIND_SUM:
                    let payload_arg = callee_node.next_sibling
                    return self.lower_variant_construct(vcsym_idx, payload_arg, self.mb.node_types[idx as i64])

    // RFC 0004: qualified payload-variant construction `EnumType.Ctor(x)`. The
    // callee is a NODE_FIELD_EXPR that typecheck bound to the variant symbol
    // (flag 2048); build the same tag-in-box value the bare `Ctor(x)` path above
    // does, with the call's first argument as the payload. Without this the
    // callee lowered as an OP_GET_FIELD on the type name and crashed.
    if not is_method_call and callee_node.kind == NODE_FIELD_EXPR and (callee_node.flags & 2048 as u16) != 0 as u16:
        let fvsym_idx = callee_node.payload
        if fvsym_idx != 0 as u32 and (fvsym_idx as i64) < self.mb.symbols.symbols.len:
            let fvsym = self.mb.symbols.symbols.data[fvsym_idx as i64]
            if fvsym.kind == SYM_VARIANT and fvsym.type_id != 0 as u32 and (fvsym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[fvsym.type_id as i64].kind == TYPE_KIND_SUM:
                    let fpayload_arg = callee_node.next_sibling
                    return self.lower_variant_construct(fvsym_idx, fpayload_arg, self.mb.node_types[idx as i64])

    mut is_struct_constructor := false
    mut struct_type_id := 0 as u32

    if not is_method_call:
        if callee_node.kind == NODE_IDENT:
            let sym_idx = callee_node.payload
            if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
                let sym = self.mb.symbols.symbols.data[sym_idx as i64]
                if sym.kind == SYM_STRUCT:
                    is_struct_constructor = true
                    struct_type_id = sym.type_id
                    // BUG#74: for a generic struct constructed with no explicit
                    // type args (`Pair(first: v, ...)`), typecheck records the
                    // concrete MONOMORPHIZED struct type on the call node itself
                    // (node_types[idx]); prefer it over the bare template
                    // (sym.type_id) so the value is built with the SAME packed
                    // field layout the receiving generic function reads it back
                    // through. Without this the value used the template's generic
                    // 8-byte field slots (second field always at offset 8) while
                    // the callee read a packed concrete struct -- every combo
                    // except a fully-8-byte-aligned one (e.g. Pair[i32,i32],
                    // packed second at offset 4) coincidentally matched. Guarded
                    // to STRUCT/GENERIC_INST and `ct != sym.type_id`, so a
                    // non-generic struct (node_types == template) is unchanged.
                    if self.mb.node_types != null as ptr[u32]:
                        let ct = self.mb.node_types[idx as i64]
                        if ct != 0 as u32 and ct != sym.type_id and (ct as i64) < self.mb.typetable.entries.len:
                            let ce = self.mb.typetable.entries.data[ct as i64]
                            if ce.kind == TYPE_KIND_STRUCT or ce.kind == TYPE_KIND_GENERIC_INST:
                                struct_type_id = ct
        elif callee_node.kind == NODE_INDEX_EXPR or callee_node.kind == NODE_GENERIC_TYPE:
            if self.mb.node_types != null as ptr[u32]:
                let t_id = self.mb.node_types[child as i64]
                if t_id != 0 as u32 and (t_id as i64) < self.mb.typetable.entries.len:
                    let entry = self.mb.typetable.entries.data[t_id as i64]
                    if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
                        is_struct_constructor = true
                        struct_type_id = t_id

    if is_struct_constructor:
        return self.lower_struct_constructor_call(idx, node, struct_type_id)

    let temp_args = @alloc(128 * 4) as ptr[u32]
    mut temp_count := 0 as u32

    // Resolved callee FUNC symbol, for f32<->f64 implicit argument coercion below.
    // Free call: the IDENT payload. Method call: the resolved method symbol (its
    // param 0 is `self`, so an explicit arg's param index == temp_count, which
    // already counts the receiver). Other callees (generic-inst, variant ctor) leave
    // this 0 -> no coercion.
    mut cfn_sym := 0 as u32
    if is_method_call:
        cfn_sym = method_sym_idx
    elif callee_node.kind == NODE_IDENT:
        cfn_sym = callee_node.payload

    if is_method_call:
        // A static-form call `Type.method(args)` names a TYPE as the "receiver",
        // and `self` is passed explicitly as the first argument. In that case we
        // must NOT synthesize a receiver register: lowering the bare type name
        // yields a bogus value and shifts every real argument by one slot, which
        // corrupts the call's argument/home-slot layout (SIGSEGV for anything but
        // the degenerate single-arg case). Detect it by the receiver symbol kind
        // (a type, not a value) and let the explicit args carry `self`.
        mut is_static_recv := false
        let rnode = self.mb.tree.nodes.data[receiver_node_idx as i64]
        if rnode.kind == NODE_IDENT and rnode.payload != 0 as u32 and (rnode.payload as i64) < self.mb.symbols.symbols.len:
            let rk = self.mb.symbols.symbols.data[rnode.payload as i64].kind
            if rk == SYM_STRUCT or rk == SYM_TYPE_ALIAS or rk == SYM_INTERFACE:
                is_static_recv = true
        if not is_static_recv:
            let receiver_reg = self.lower_expr(receiver_node_idx)
            temp_args[temp_count as i64] = receiver_reg
            temp_count = temp_count + 1 as u32

    mut arg := callee_node.next_sibling
    while arg != 0 as u32:
        mut arg_reg := self.lower_expr(arg)
        arg_reg = self.coerce_float_arg(cfn_sym, temp_count, arg, arg_reg)
        arg_reg = self.coerce_interface_arg(cfn_sym, temp_count, arg, arg_reg)
        temp_args[temp_count as i64] = arg_reg
        temp_count = temp_count + 1 as u32
        arg = self.mb.tree.nodes.data[arg as i64].next_sibling

    // The `assert(cond)` builtin lowers to the runtime `ax_assert_axiom(cond, msg)`
    // (symbol mapped in x86_resolve_sym_name). The surface form passes only `cond`, so
    // synthesize the second `msg` argument â€” a "assertion failed" string constant, mirroring
    // the C backend (cgen.ax). Guarded to a non-method call of the `assert` builtin with
    // exactly one arg; the compiler's own source uses no `assert`, so this is dormant for
    // self-compilation (fixpoint-safe). (`child` is the stable callee node index; re-read it
    // because lowering args above may have reallocated the node array â€” BUG#51.)
    if not is_method_call and temp_count == 1 as u32:
        let cn_fresh = self.mb.tree.nodes.data[child as i64]
        if cn_fresh.kind == NODE_IDENT and cn_fresh.payload != 0 as u32 and (cn_fresh.payload as i64) < self.mb.symbols.symbols.len:
            let cnm = self.mb.pool.get(self.mb.symbols.symbols.data[cn_fresh.payload as i64].name_id)
            if cnm == "assert":
                let msg_reg = self.fb.fresh_reg()
                let msg_id = self.mb.pool.intern("assertion failed")
                self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 12 as u32, dest: msg_reg, src1: msg_id, src2: 0 as u32))
                temp_args[temp_count as i64] = msg_reg
                temp_count = temp_count + 1 as u32
            safe_free_str(cnm)

    let arg_start = self.fb.emit_extra(temp_count)
    mut i := 0 as u32
    while i < temp_count:
        self.fb.emit_extra(temp_args[i as i64])
        i = i + 1 as u32

    @free(temp_args as ptr[u8])

    mut type_id := 0 as u32
    mut callee_reg := 0 as u32

    if is_method_call:
        type_id = method_sym_idx as u32
        callee_reg = 0 as u32
    else:
        if callee_node.kind == NODE_IDENT:
            let call_sym_idx = callee_node.payload
            mut is_var_or_param := false
            if call_sym_idx != 0 as u32 and (call_sym_idx as i64) < self.mb.symbols.symbols.len:
                let call_sym = self.mb.symbols.symbols.data[call_sym_idx as i64]
                if call_sym.kind == SYM_VAR or call_sym.kind == SYM_PARAM:
                    is_var_or_param = true
            if is_var_or_param:
                // SYM_VAR/SYM_PARAM â€” indirect call through function pointer variable
                callee_reg = self.lower_ident(callee_node)
                if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                    type_id = self.mb.node_types[idx as i64] as u32
            else:
                callee_reg = 0 as u32
                type_id = callee_node.payload as u32
        elif callee_node.kind == NODE_FIELD_EXPR and (callee_node.flags & 2048 as u16) != 0 as u16:
            callee_reg = 0 as u32
            type_id = callee_node.payload as u32
        elif (callee_node.kind == NODE_INDEX_EXPR or callee_node.kind == NODE_GENERIC_TYPE) and callee_node.payload != 0 as u32 and (callee_node.payload as i64) < self.mb.symbols.symbols.len and self.mb.symbols.symbols.data[callee_node.payload as i64].kind == SYM_FUNC:
            // BUG#62: explicit generic instantiation `f[T](args)` (e.g. hash_key[K](key)
            // in a mono'd HashMap method, or new[i32]()). Typecheck's NODE_INDEX_EXPR
            // path instantiates the template and stamps the node payload with the
            // instance FUNC symbol; without this branch the callee fell into
            // lower_expr(INDEX_EXPR) â€” an ARRAY INDEX of the template symbol â€” and
            // the backends emitted a phantom `ax_<template>` extern (link failure)
            // or an indirect call through garbage. Guarded on SYM_FUNC so struct
            // instantiations (SYM_STRUCT/SYM_TYPE_ALIAS payloads) and plain indexing
            // (payload 0) are untouched. Direct call, same convention as above.
            callee_reg = 0 as u32
            type_id = callee_node.payload as u32
        else:
            callee_reg = self.lower_expr(child)
            if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
                type_id = self.mb.node_types[idx as i64] as u32
            else:
                if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
                    let sym = self.mb.symbols.symbols.data[node.payload as i64]
                    if sym.type_id != 0 as u32:
                        type_id = sym.type_id as u32

    mut opcode := OP_CALL
    if not is_method_call and callee_node.kind == NODE_IDENT:
        let sym_idx = callee_node.payload
        if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let name_id = self.mb.symbols.symbols.data[sym_idx as i64].name_id
            let name = self.mb.pool.get(name_id)
            if (name == "syscall0" or name == "syscall1" or name == "syscall2" or
                name == "syscall3" or name == "syscall4" or name == "syscall5" or
                name == "syscall6" or name == "syscall"):
                opcode = OP_SYSCALL

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: callee_reg,
        src2: arg_start,
    ))
    return reg

pub fn lower_field_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    if (node.flags & 2048 as u16) != 0 as u16:
        let sym_idx = node.payload
        if self.mb.symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[sym_idx as i64]
            // RFC 0011 P4 inc4a: a library-provided const has no AST initializer
            // (decl_node 0); its value was carried in the `.lib` interface and stashed in
            // next_overload. Inline it directly as an integer constant.
            if sym.kind == SYM_CONST and sym.decl_node == 0 as u32:
                let lc_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: sym.type_id,
                    dest: lc_reg,
                    src1: sym.next_overload,
                    src2: 0 as u32,
                ))
                return lc_reg
            if sym.kind == SYM_CONST and sym.decl_node != 0 as u32:
                mut init_expr := 0 as u32
                
                mut imported_mod := null as ptr[ModuleInfo]
                if self.mb.symbols.lazy_resolver != null as ptr[void]:
                    imported_mod = lazy_resolver_find_module_of_symbol(self.mb.symbols.lazy_resolver as ptr[LazyResolver], sym_idx)
                
                let saved_tree = self.mb.tree
                let saved_node_types = self.mb.node_types
                if imported_mod != null as ptr[ModuleInfo] and imported_mod.ast_tree != null as ptr[AstTree]:
                    self.mb.tree = imported_mod.ast_tree
                    self.mb.node_types = imported_mod.node_types as ptr[u32]

                mut child_const := 0 as u32
                if (sym.decl_node as i64) < self.mb.tree.nodes.len:
                    child_const = self.mb.tree.nodes.data[sym.decl_node as i64].first_child
                while child_const != 0 as u32 and (child_const as i64) < self.mb.tree.nodes.len:
                    let child_const_node = self.mb.tree.nodes.data[child_const as i64]
                    if child_const_node.kind != NODE_TYPE_EXPR and child_const_node.kind != NODE_GENERIC_TYPE:
                        init_expr = child_const
                    child_const = child_const_node.next_sibling
                
                mut val_reg := 0 as u32
                if init_expr != 0 as u32:
                    val_reg = self.lower_expr(init_expr)
                
                self.mb.tree = saved_tree
                self.mb.node_types = saved_node_types
                
                return val_reg
            
            // RFC 0004: qualified nullary-variant construction `EnumType.Variant`.
            // Typecheck bound this field-expr to the variant symbol (flag 2048); build
            // the same tagged value a bare `Variant` would, instead of an OP_GET_FIELD
            // on the type name (which read a garbage receiver and crashed). Only
            // no-payload variants complete here; a payload variant `EnumType.Ctor(x)`
            // is a call and is built in lower_call_expr with its argument.
            if sym.kind == SYM_VARIANT and sym.type_id != 0 as u32 and (sym.type_id as i64) < self.mb.typetable.entries.len:
                if self.mb.typetable.entries.data[sym.type_id as i64].kind == TYPE_KIND_SUM:
                    mut ntag := -1 as i64
                    mut npayload := 0 as u32
                    self.find_variant_info(sym.type_id, sym.name_id, &ntag, &npayload)
                    if npayload == TYPE_UNKNOWN:
                        return self.lower_variant_construct(sym_idx, 0 as u32, 0 as u32)
            if sym.kind != SYM_VAR and sym.kind != SYM_PARAM:
                return 0 as u32
            let reg = self.locals.local_map_get(sym_idx)
            return reg
        return 0 as u32

    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let obj_reg = self.lower_expr(child)
    let field_idx = node.extra_idx

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_GET_FIELD,
        type_id: type_id,
        dest: reg,
        src1: obj_reg,
        src2: field_idx,
    ))
    return reg

pub fn lower_index_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let idx_expr = self.mb.tree.nodes.data[child as i64].next_sibling

    // RFC 0020 P3: `s[a..b]` on a str/bytes base is a SUBSTRING slice, not an
    // element index. Typecheck accepts this only for str/bytes (result type =
    // base type); here we lower it to `std.string.slice(s, a, b)` (the same
    // library value-ABI call the `str + str` -> concat lowering uses), reusing
    // the proven str-return path instead of assembling a 16-byte {ptr,len} view
    // in codegen. Detected by the `..` binary-expr index; the compiler itself
    // never slices, so the self-host fixpoint is unaffected on the frontend side.
    if idx_expr != 0 as u32 and self.mb.node_types != null as ptr[u32]:
        let child_ty0 = self.mb.node_types[child as i64]
        if child_ty0 == 12 as u32 or child_ty0 == 22 as u32:
            let ie_node = self.mb.tree.nodes.data[idx_expr as i64]
            if ie_node.kind == NODE_BINARY_EXPR:
                let ie_op = self.mb.get_token_text(ie_node.token_idx)
                let ie_is_range = ie_op == ".."
                @free(get_str_ptr(ie_op))
                if ie_is_range:
                    let lo_idx = ie_node.first_child
                    if lo_idx != 0 as u32:
                        let hi_idx = self.mb.tree.nodes.data[lo_idx as i64].next_sibling
                        if hi_idx != 0 as u32:
                            let ssym = self.resolve_op_method("slice", TYPE_STRING, 0 as u32)
                            if ssym != 0 as u32:
                                let s_reg = self.lower_expr(child)
                                let lo_reg = self.lower_expr(lo_idx)
                                let hi_reg = self.lower_expr(hi_idx)
                                let arg_start = self.fb.emit_extra(3 as u32)
                                self.fb.emit_extra(s_reg)
                                self.fb.emit_extra(lo_reg)
                                self.fb.emit_extra(hi_reg)
                                let sl_reg = self.fb.fresh_reg()
                                self.fb.emit(AirInst(opcode: OP_CALL, type_id: ssym, dest: sl_reg, src1: 0 as u32, src2: arg_start))
                                return sl_reg

    mut arr_reg = self.lower_expr(child)
    mut idx_reg := 0 as u32
    if idx_expr != 0 as u32:
        idx_reg = self.lower_expr(idx_expr)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // RFC 0021: `v[i]` on a `Vec[T]` is `vec.data[i]`. The operand is a by-address
    // `{data,len,cap}` aggregate, so index its `data` POINTER field, not the header.
    // Load `data` first, then OP_INDEX on it -- the same sequence the for-in-vec
    // lowering uses (~3688). Detected by the operand's static Vec base name, so plain
    // pointer/array `p[i]` (the only forms the compiler itself uses) is unchanged and
    // the self-host fixpoint stays A==B.
    if self.mb.node_types != null as ptr[u32]:
        let child_ty = self.mb.node_types[child as i64]
        if child_ty != 0 as u32 and (child_ty as i64) < self.mb.typetable.entries.len:
            let ce = self.mb.typetable.entries.data[child_ty as i64]
            if (ce.kind == TYPE_KIND_GENERIC_INST or ce.kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(ce.name_id)) == "Vec":
                let data_nid = self.mb.pool.intern("data")
                mut vd_idx := 0 as u32
                let vd_type = fl_resolve_field(self, child_ty, data_nid, &vd_idx)
                if vd_type != 0 as u32:
                    let data_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: vd_type, dest: data_reg, src1: arr_reg, src2: vd_idx))
                    arr_reg = data_reg

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_INDEX,
        type_id: type_id,
        dest: reg,
        src1: arr_reg,
        src2: idx_reg,
    ))
    return reg

pub fn lower_cast_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let src_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // RFC 0020: `str` <-> `bytes` share the same {ptr,len} 16-byte repr, so the cast
    // is a pure reinterpret (a zero-cost view). Reuse the source register directly â€”
    // an OP_CAST would treat the value as an 8-byte scalar and drop the len field.
    if self.mb.node_types != null as ptr[u32] and (type_id == 12 as u32 or type_id == 22 as u32):
        let src_ty0 = self.mb.node_types[child as i64]
        if src_ty0 == 12 as u32 or src_ty0 == 22 as u32:
            return src_reg

    // RFC 0006 (BUG#33/BUG#35): intâ†”float casts must be real convert
    // instructions, not OP_CAST copy-reinterpret. intâ†’float â†’ OP_ITOF
    // (cvtsi2sd); floatâ†’int â†’ OP_FTOI (cvttsd2si, truncate toward zero).
    // intâ†”int and f32â†”f64 stay OP_CAST for now (f32â†”f64 precise convert is a
    // follow-up with the ss encoder family).
    mut opcode := OP_CAST
    if self.mb.node_types != null as ptr[u32] and type_id != 0 as u32:
        let src_ty = self.mb.node_types[child as i64]
        if src_ty != 0 as u32:
            let dst_is_float = type_id == 9 as u32 or type_id == 10 as u32
            let src_is_float = src_ty == 9 as u32 or src_ty == 10 as u32
            if dst_is_float and not src_is_float:
                opcode = OP_ITOF
            elif src_is_float and not dst_is_float:
                opcode = OP_FTOI

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: opcode,
        type_id: type_id,
        dest: reg,
        src1: src_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_deref_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let ptr_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // Dereferencing a ptr[str] yields a 16-byte str value. The deref node's own
    // inferred type is not always monomorphised to the concrete pointee (a
    // generic T resolving to str stays generic in node_types), which would make
    // both regalloc and the selector treat the result as 8 bytes and drop the
    // str's len field. Recover the concrete type from the operand's pointee.
    if self.mb.node_types != null as ptr[u32] and type_id != 12 as u32:
        let child_type = self.mb.node_types[child as i64]
        if child_type != 0 as u32 and (child_type as i64) < self.mb.typetable.entries.len:
            let ce = self.mb.typetable.entries.data[child_type as i64]
            if (ce.kind == TYPE_KIND_POINTER or ce.kind == TYPE_KIND_REF) and ce.extra == 12 as u32:
                type_id = 12 as u32
            elif (ce.kind == TYPE_KIND_POINTER or ce.kind == TYPE_KIND_REF) and ce.extra != 0 as u32 and (ce.extra as i64) < self.mb.typetable.entries.len:
                // Recover concrete aggregate pointee so the selector treats `p.*`
                // (p: ptr[Struct/Sum/etc]) as a by-address aggregate value (returns
                // the pointer) instead of loading the full struct size. The deref's
                // own inferred type stays generic when p came from `masked as ptr[T]`
                // in Result/Option.unwrap. Mirrors the str (12) recovery above.
                let pe = self.mb.typetable.entries.data[ce.extra as i64]
                if pe.kind == TYPE_KIND_STRUCT or pe.kind == TYPE_KIND_ARRAY or pe.kind == TYPE_KIND_TUPLE or pe.kind == TYPE_KIND_SUM or pe.kind == TYPE_KIND_GENERIC_INST or pe.kind == TYPE_KIND_OPTION or pe.kind == TYPE_KIND_RESULT:
                    type_id = ce.extra

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_DEREF,
        type_id: type_id,
        dest: reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_spawn_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    mut target_reg := 0 as u32
    mut type_id := 0 as u32
    let child_node = self.mb.tree.nodes.data[child as i64]
    if child_node.kind == NODE_CALL_EXPR:
        let callee_node_idx = child_node.first_child
        if callee_node_idx != 0 as u32:
            target_reg = self.lower_expr(callee_node_idx)
            let callee_node = self.mb.tree.nodes.data[callee_node_idx as i64]
            if callee_node.kind == NODE_IDENT:
                type_id = callee_node.payload as u32
    else:
        target_reg = self.lower_expr(child)

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_SPAWN,
        type_id: type_id,
        dest: reg,
        src1: target_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_await_expr(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    let child = node.first_child
    if child == 0 as u32:
        return 0 as u32

    let future_reg = self.lower_expr(child)

    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    let reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_AWAIT,
        type_id: type_id,
        dest: reg,
        src1: future_reg,
        src2: 0 as u32,
    ))
    return reg

pub fn lower_struct_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    let struct_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: struct_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    mut child := node.first_child
    mut field_idx := 0 as u32
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_NAMED_ARG:
            let val_child = cn.first_child
            if val_child != 0 as u32:
                let val_reg = self.lower_expr(val_child)
                self.fb.emit(AirInst(
                    opcode: OP_SET_FIELD,
                    type_id: type_id,
                    dest: val_reg,
                    src1: struct_reg,
                    src2: field_idx,
                ))
            field_idx = field_idx + 1 as u32
        child = cn.next_sibling
    return struct_reg

pub fn lower_tuple_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    // RFC 0022: a tuple literal lowers exactly like a struct literal but with
    // POSITIONAL children (each child is the field value directly, with no
    // NODE_NAMED_ARG wrapper). typecheck registered an anonymous struct type
    // (fields _f0.._fN) for this node, so OP_ALLOC + per-field OP_SET_FIELD
    // build it and `.N` field access reads it through the ordinary struct path.
    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32

    let struct_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: struct_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    mut tup_struct := 0 - 1 as i64
    if (type_id as i64) < self.mb.typetable.entries.len:
        if self.mb.typetable.entries.data[type_id as i64].kind == TYPE_KIND_STRUCT:
            let ex = self.mb.typetable.entries.data[type_id as i64].extra
            if (ex as i64) < self.mb.typetable.structs.len:
                tup_struct = ex as i64

    mut child := node.first_child
    mut field_idx := 0 as u32
    while child != 0 as u32:
        mut val_reg = self.lower_expr(child)
        val_reg = self.coerce_field_to_interface(tup_struct, field_idx, child, val_reg)
        self.fb.emit(AirInst(
            opcode: OP_SET_FIELD,
            type_id: type_id,
            dest: val_reg,
            src1: struct_reg,
            src2: field_idx,
        ))
        field_idx = field_idx + 1 as u32
        child = self.mb.tree.nodes.data[child as i64].next_sibling
    return struct_reg

pub fn lower_array_lit(mut self: ptr[FuncLowering], idx: u32, node: AstNode) -> u32:
    mut type_id := 0 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[idx as i64] != 0 as u32:
        type_id = self.mb.node_types[idx as i64] as u32
    else:
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                type_id = sym.type_id as u32

    // Element type (needed so OP_STORE below scales the index by the right
    // element size -- mirrors the `a[i] = v` index-assignment lowering,
    // which reads `entry.extra` the same way; see lower_assign_stmt).
    mut elem_type_id := 0 as u32
    if type_id != 0 as u32 and (type_id as i64) < self.mb.typetable.entries.len:
        let arr_entry = self.mb.typetable.entries.data[type_id as i64]
        if arr_entry.kind == TYPE_KIND_ARRAY or arr_entry.kind == TYPE_KIND_SLICE or arr_entry.kind == TYPE_KIND_POINTER:
            elem_type_id = arr_entry.extra as u32

    let arr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: arr_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    mut child := node.first_child
    mut elem_idx := 0 as u32
    while child != 0 as u32:
        mut elem_reg = self.lower_expr(child)
        // RFC 0029: `[Square(..), Circle(..)]` typed `[Iface; N]` boxes each concrete
        // element (else the raw struct is stored and dispatch reads garbage -> segfault).
        elem_reg = self.coerce_struct_to_interface(elem_type_id, child, elem_reg)

        let idx_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: 3 as u32, // i32
            dest: idx_reg,
            src1: elem_idx,
            src2: 0 as u32,
        ))

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: elem_type_id,
            dest: arr_reg,
            src1: elem_reg,
            src2: idx_reg,
        ))

        elem_idx = elem_idx + 1 as u32
        child = self.mb.tree.nodes.data[child as i64].next_sibling
    return arr_reg

pub fn lower_struct_constructor_call(mut self: ptr[FuncLowering], idx: u32, node: AstNode, type_id: u32) -> u32:
    let struct_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id as u32,
        dest: struct_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let callee = node.first_child
    if callee == 0 as u32:
        return struct_reg

    // RFC 0029: the struct-index for this ctor's type, so a field declared as an interface
    // can box a concrete-struct field initializer (`Holder(shp: Square(...))`).
    mut cfield_struct := -1 as i64
    if (type_id as i64) < self.mb.typetable.entries.len:
        let cte = self.mb.typetable.entries.data[type_id as i64]
        if cte.kind == TYPE_KIND_STRUCT and (cte.extra as i64) < self.mb.typetable.structs.len:
            cfield_struct = cte.extra as i64

    mut child := self.mb.tree.nodes.data[callee as i64].next_sibling
    mut field_idx := 0 as u32
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind == NODE_NAMED_ARG:
            let val_child = cn.first_child
            if val_child != 0 as u32:
                mut val_reg = self.lower_expr(val_child)
                val_reg = self.coerce_field_to_interface(cfield_struct, field_idx, val_child, val_reg)
                self.fb.emit(AirInst(
                    opcode: OP_SET_FIELD,
                    type_id: type_id as u32,
                    dest: val_reg,
                    src1: struct_reg,
                    src2: field_idx,
                ))
            field_idx = field_idx + 1 as u32
        else:
            mut val_reg = self.lower_expr(child)
            val_reg = self.coerce_field_to_interface(cfield_struct, field_idx, child, val_reg)
            self.fb.emit(AirInst(
                opcode: OP_SET_FIELD,
                type_id: type_id as u32,
                dest: val_reg,
                src1: struct_reg,
                src2: field_idx,
            ))
            field_idx = field_idx + 1 as u32
        child = cn.next_sibling
    return struct_reg

// RFC 0029: coerce a struct-field initializer to an interface value when the field at
// `field_idx` of struct `struct_index` is declared as an interface type.
pub fn coerce_field_to_interface(mut self: ptr[FuncLowering], struct_index: i64, field_idx: u32, val_node: u32, val_reg: u32) -> u32:
    if struct_index < 0 as i64:
        return val_reg
    let si = self.mb.typetable.structs.data[struct_index]
    if (field_idx as i64) >= si.fields.len:
        return val_reg
    let fty = si.fields.data[field_idx as i64].type_id
    return self.coerce_struct_to_interface(fty, val_node, val_reg)

pub fn emit_heap_alloc(mut self: ptr[FuncLowering], type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: type_id,
        dest: ptr_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let ref_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_MAKE_REF,
        type_id: type_id,
        dest: ref_reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return ref_reg

pub fn emit_deref(mut self: ptr[FuncLowering], ref_reg: u32, type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_DEREF,
        type_id: type_id,
        dest: ptr_reg,
        src1: ref_reg,
        src2: 0 as u32,
    ))
    return ptr_reg

pub fn emit_move(mut self: ptr[FuncLowering], src_reg: u32, type_id: u32) -> u32:
    let dest_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_MOVE,
        type_id: type_id,
        dest: dest_reg,
        src1: src_reg,
        src2: 0 as u32,
    ))
    return dest_reg

pub fn emit_free(mut self: ptr[FuncLowering], ptr_reg: u32):
    self.fb.emit(AirInst(
        opcode: OP_FREE,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: ptr_reg,
        src2: 0 as u32,
    ))

pub fn emit_arena_alloc(mut self: ptr[FuncLowering], arena_reg: u32, type_id: u32) -> u32:
    let ptr_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ARENA_ALLOC,
        type_id: type_id,
        dest: ptr_reg,
        src1: arena_reg,
        src2: 0 as u32,
    ))
    return ptr_reg

pub fn emit_alias_reuse(mut self: ptr[FuncLowering], ptr_reg: u32, type_id: u32) -> u32:
    let dest_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALIAS_REUSE,
        type_id: type_id,
        dest: dest_reg,
        src1: ptr_reg,
        src2: 0 as u32,
    ))
    return dest_reg

pub fn lower_ownership_aware(mut self: ptr[FuncLowering], idx: u32, node: AstNode, init_reg: u32) -> u32:
    if node.flags & FLAG_ESCAPES_TO_HEAP != 0 as u16:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        let ref_reg = self.emit_heap_alloc(type_id)

        if init_reg != 0 as u32:
            let ptr_reg = self.emit_deref(ref_reg, type_id)
            self.fb.emit(AirInst(
                opcode: OP_STORE,
                type_id: 0 as u32,
                dest: ptr_reg,
                src1: init_reg,
                src2: 0 as u32,
            ))
        return ref_reg

    if node.flags & FLAG_USES_ARENA != 0 as u16:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        let ptr_reg = self.emit_arena_alloc(0 as u32, type_id)
        if init_reg != 0 as u32:
            self.fb.emit(AirInst(
                opcode: OP_STORE,
                type_id: 0 as u32,
                dest: ptr_reg,
                src1: init_reg,
                src2: 0 as u32,
            ))
        return ptr_reg

    if node.flags & FLAG_IS_MOVED != 0 as u16 and init_reg != 0 as u32:
        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        return self.emit_move(init_reg, type_id)

    return init_reg

pub fn lower_alias_stmt(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        let cn = self.mb.tree.nodes.data[node.first_child as i64]
        let src_reg = self.lower_expr(node.first_child)

        mut type_id := 0 as u32
        if node.extra_idx != 0 as u32:
            type_id = node.extra_idx as u32
        self.emit_alias_reuse(src_reg, type_id)

pub fn lower_block(mut self: ptr[FuncLowering], block_idx: u32):
    let node = self.mb.tree.nodes.data[block_idx as i64]
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        self.lower_stmt(child, cn)
        child = cn.next_sibling

// RFC 0004: look up the sequential tag + payload type of variant `name_id`
// inside sum type `sum_type_id`. Returns true if found.
// BUG#91: resolve a type to the underlying user-sum type id, seeing through a
// GENERIC_INST (e.g. an unannotated `One(42)` types as GENERIC_INST `Opt[i64]`, not
// the kind-6 sum). A generic instance's name_id equals its base type's name_id
// (same shortcut builder_type_size uses for structs). Returns 0 if not a sum.
pub fn resolve_sum_type(self: ptr[FuncLowering], type_id: u32) -> u32:
    if type_id == 0 as u32 or (type_id as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let e = self.mb.typetable.entries.data[type_id as i64]
    if e.kind == TYPE_KIND_SUM:
        return type_id
    if e.kind == TYPE_KIND_GENERIC_INST:
        mut k := 0 as i64
        while k < self.mb.typetable.entries.len:
            let e2 = self.mb.typetable.entries.data[k]
            if e2.kind == TYPE_KIND_SUM and e2.name_id == e.name_id:
                return k as u32
            k = k + 1
    return 0 as u32

// BUG#90: does `s` equal `prefix` or start with it? (zero-alloc; both are views.)
pub fn name_has_prefix(s: str, prefix: str) -> bool:
    let pl = std.string.len(prefix)
    let sl = std.string.len(s)
    if sl < pl:
        return false
    let sp = get_str_ptr(s)
    let pp = get_str_ptr(prefix)
    mut i := 0 as i64
    while i < pl:
        if sp[i] != pp[i]:
            return false
        i = i + 1 as i64
    return true

// BUG#90: classify a receiver type as Option (0), Result (1), or neither (-1), seeing
// through kind 11/12 and a GENERIC_INST/SUM whose base name is Option/Result.
// RFC 0029: for an Option/Result ctor node typed Option[I] / Result[I, ..] (I an
// interface, set by typecheck from the declared annotation via try_instantiate_variant_call),
// return the interface payload type so the Some/Ok/Err lowering can box a concrete-struct
// payload into an interface value. Returns 0 when the payload is not an interface. `which`
// is the variant_ctor code (1=Ok, 2=Err, 3=Some).
pub fn opt_res_ctor_iface(self: ptr[FuncLowering], ctor_ty: u32, which: i64) -> u32:
    if ctor_ty == 0 as u32 or (ctor_ty as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let e = self.mb.typetable.entries.data[ctor_ty as i64]
    mut payload := 0 as u32
    if e.kind == TYPE_KIND_OPTION:
        payload = e.extra
    elif e.kind == TYPE_KIND_RESULT:
        if which == 2 as i64:
            payload = e.name_id
        else:
            payload = e.extra
    elif e.kind == TYPE_KIND_GENERIC_INST and (e.extra as i64) < self.mb.typetable.generic_insts.len:
        let ga = self.mb.typetable.generic_insts.data[e.extra as i64]
        mut ai := 0 as i64
        if which == 2 as i64 and ga.len > 1 as i64:
            ai = 1 as i64
        if ai < ga.len:
            payload = ga.data[ai]
    if payload == 0 as u32 or (payload as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    if self.mb.typetable.entries.data[payload as i64].kind == TYPE_KIND_INTERFACE:
        return payload
    return 0 as u32

pub fn opt_res_kind(self: ptr[FuncLowering], type_id: u32) -> i64:
    if type_id == 0 as u32 or (type_id as i64) >= self.mb.typetable.entries.len:
        return -1 as i64
    let e = self.mb.typetable.entries.data[type_id as i64]
    if e.kind == TYPE_KIND_OPTION:
        return 0 as i64
    if e.kind == TYPE_KIND_RESULT:
        return 1 as i64
    if (e.kind == TYPE_KIND_GENERIC_INST or e.kind == TYPE_KIND_SUM) and e.name_id != 0 as u32:
        let nm = self.mb.pool.get(e.name_id)
        if name_has_prefix(nm, "Option"):
            return 0 as i64
        if name_has_prefix(nm, "Result"):
            return 1 as i64
    return -1 as i64

pub fn find_variant_info(self: ptr[FuncLowering], sum_type_id: u32, name_id: u32, out_tag: ptr[i64], out_payload: ptr[u32]) -> bool:
    out_tag[0] = -1 as i64
    out_payload[0] = 0 as u32
    let resolved_sum = self.resolve_sum_type(sum_type_id)
    if resolved_sum == 0 as u32:
        return false
    let entry = self.mb.typetable.entries.data[resolved_sum as i64]
    let sum_extra = entry.extra
    if (sum_extra as i64) >= self.mb.typetable.sumtypes.len:
        return false
    let sum_info = self.mb.typetable.sumtypes.data[sum_extra as i64]
    mut j := 0 as i64
    while j < sum_info.variants.len:
        let v = sum_info.variants.data[j]
        if v.name_id == name_id:
            out_tag[0] = v.tag as i64
            out_payload[0] = v.payload_type
            return true
        j = j + 1
    return false

// RFC 0004: construct a user sum value. `payload_arg_idx` is the AST node of the
// single payload argument (0 = no payload). The value is an 8-byte pointer to a
// heap box [tag@0, payload@8]; reuses OP_ALLOC/OP_SET_FIELD (the sum reg type
// makes field_offset yield 0 and 8 for fields 0 and 1).
// BUG#92b helper: resolve the concrete monomorphized SUM for a variant construction
// from the ctor expression's inferred type. `ctor_ty` is node_types[call]; `vname` is
// the variant's name_id (disambiguates which mono sum owns this constructor). Returns a
// kind-6 SUM type_id, or 0 when none applies (keeping the template layout). Matches a
// GENERIC_INST to its mono SUM by generic_args equality + variant-name presence rather
// than by name_id, because the mono sum is registered under a MANGLED name while the
// generic-inst carries the base name.
pub fn resolve_mono_sum_for_ctor(self: ptr[FuncLowering], ctor_ty: u32, vname: u32) -> u32:
    if ctor_ty == 0 as u32 or (ctor_ty as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let e = self.mb.typetable.entries.data[ctor_ty as i64]
    if e.kind == TYPE_KIND_SUM:
        return ctor_ty
    if e.kind != TYPE_KIND_GENERIC_INST:
        return 0 as u32
    if (e.extra as i64) >= self.mb.typetable.generic_insts.len:
        return 0 as u32
    let gi_args = self.mb.typetable.generic_insts.data[e.extra as i64]
    if gi_args.len == 0 as i64:
        return 0 as u32
    mut k := 0 as i64
    while k < self.mb.typetable.entries.len:
        let e2 = self.mb.typetable.entries.data[k]
        if e2.kind == TYPE_KIND_SUM and (e2.extra as i64) < self.mb.typetable.sumtypes.len:
            let si = self.mb.typetable.sumtypes.data[e2.extra as i64]
            mut args_eq := si.generic_args.len == gi_args.len
            if args_eq:
                mut ai := 0 as i64
                while ai < gi_args.len:
                    if si.generic_args.data[ai] != gi_args.data[ai]:
                        args_eq = false
                        break
                    ai = ai + 1
            if args_eq:
                mut vj := 0 as i64
                while vj < si.variants.len:
                    if si.variants.data[vj].name_id == vname:
                        return k as u32
                    vj = vj + 1
        k = k + 1
    return 0 as u32

pub fn lower_variant_construct(mut self: ptr[FuncLowering], variant_sym_idx: u32, payload_arg_idx: u32, ctor_node_type: u32) -> u32:
    let vsym = self.mb.symbols.symbols.data[variant_sym_idx as i64]
    let sum_type_id = vsym.type_id
    mut tag := -1 as i64
    mut payload_type := 0 as u32
    self.find_variant_info(sum_type_id, vsym.name_id, &tag, &payload_type)
    if tag < 0 as i64:
        tag = 0 as i64

    // BUG#92b: vsym.type_id is the TEMPLATE sum, whose RFC 0019 synth payload struct
    // carries TEMPLATE field types (a generic param defaults to 8 bytes). When a payload
    // field monomorphizes to a >8B type (e.g. `str`, 16B) the template layout (field@0/8B,
    // next@8) diverges from the MONO synth struct (str@0/16B, next@16) that `lower_match`
    // reads from the scrutinee's concrete sum -> the constructor would store fields at the
    // wrong offsets/sizes (str len dropped, next field shifted). If the ctor expression's
    // inferred type resolves to a concrete mono sum owning this variant, re-derive
    // payload_type from IT so both sides agree on layout. Inert for scalar/<=8B payloads
    // (template==mono layout) and non-generic sums (mono_sum == sum_type_id -> skipped).
    let mono_sum = self.resolve_mono_sum_for_ctor(ctor_node_type, vsym.name_id)
    if mono_sum != 0 as u32 and mono_sum != sum_type_id:
        mut m_tag := -1 as i64
        mut m_payload := 0 as u32
        if self.find_variant_info(mono_sum, vsym.name_id, &m_tag, &m_payload):
            if m_payload != 0 as u32:
                payload_type = m_payload

    let box_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ALLOC,
        type_id: sum_type_id,
        dest: box_reg,
        src1: 0 as u32,
        src2: 0 as u32,
    ))

    let tag_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(
        opcode: OP_ICONST,
        type_id: 4 as u32,
        dest: tag_reg,
        src1: tag as u32,
        src2: 0 as u32,
    ))
    self.fb.emit(AirInst(
        opcode: OP_SET_FIELD,
        type_id: sum_type_id,
        dest: tag_reg,
        src1: box_reg,
        src2: 0 as u32,
    ))

    if payload_arg_idx != 0 as u32:
        // RFC 0019: a SYNTHESIZED (flagged) payload struct â€” a multi-field variant
        // (`Rect(3,4)`) or a single >8B primitive wrap (`Text(str)`). Gather the N call
        // args into a fresh struct box (arg[i] -> struct field i), then store the struct
        // pointer into box field 1 â€” a value byte-identical to a user single-struct
        // payload, and one that fits the box's 8-byte payload slot. A plain single
        // payload (scalar or user struct) takes the existing path below.
        mut is_multifield := false
        if payload_type != 0 as u32 and (payload_type as i64) < self.mb.typetable.entries.len:
            let pe = self.mb.typetable.entries.data[payload_type as i64]
            if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16:
                is_multifield = true
        if is_multifield:
            let struct_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ALLOC, type_id: payload_type, dest: struct_reg, src1: 0 as u32, src2: 0 as u32))
            mut arg := payload_arg_idx
            mut fi := 0 as u32
            while arg != 0 as u32:
                let arg_reg = self.lower_expr(arg)
                self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: payload_type, dest: arg_reg, src1: struct_reg, src2: fi))
                arg = self.mb.tree.nodes.data[arg as i64].next_sibling
                fi = fi + 1 as u32
            self.fb.emit(AirInst(opcode: OP_SET_FIELD, type_id: sum_type_id, dest: struct_reg, src1: box_reg, src2: 1 as u32))
        else:
            mut pl_reg = self.lower_expr(payload_arg_idx)
            // RFC 0029: a concrete struct in an INTERFACE-typed variant payload
            // (`Wrap = Box(Shape)`, `Box(Sq(..))`) was stored raw, so the later
            // `.area()` dispatched on struct bytes as a box pointer -> SIGSEGV. Unlike
            // the Some/Ok path in lower_call_expr, THIS site has the declared payload
            // type in hand (`payload_type`, from find_variant_info), so no type has to
            // be recovered from a node typecheck may have retyped -- sidestepping the
            // ordering conflict documented in the bug note. Guarded internally: a no-op
            // unless payload_type is an interface AND the arg node is still a struct.
            pl_reg = self.coerce_struct_to_interface(payload_type, payload_arg_idx, pl_reg)
            self.fb.emit(AirInst(
                opcode: OP_SET_FIELD,
                type_id: sum_type_id,
                dest: pl_reg,
                src1: box_reg,
                src2: 1 as u32,
            ))
    return box_reg

// RFC 0004: lower `match` on a user sum value to a tag-dispatch if/elif chain.
// Each arm pattern is one of: NODE_VARIANT_PAT (tag + bind payload), bare
// NODE_BINDING_PAT whose name IS a variant (tag, no bind), bare NODE_BINDING_PAT
// of a non-variant name (catch-all, binds scrutinee), or NODE_WILDCARD_PAT
// (catch-all). The scrutinee box pointer is read once; field 0 = tag, field 1 =
// payload. v1 handles sum scrutinees only.
// RFC 0012: classify a `match` as Option (0) / Result (1) / neither (-1) by its
// arm pattern names. Some/None â‡’ Option, Ok/Err â‡’ Result. Uses the pattern's TOKEN
// text (reliable in the current module), not the scrutinee's static type.
pub fn match_arms_tagged_kind(mut self: ptr[FuncLowering], scrutinee_idx: u32) -> i64:
    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut result := -1 as i64
    while arm != 0 as u32:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        if arm_node.kind == NODE_MATCH_ARM:
            let pat = arm_node.first_child
            if pat != 0 as u32:
                let pat_node = self.mb.tree.nodes.data[pat as i64]
                if pat_node.kind == NODE_VARIANT_PAT or pat_node.kind == NODE_BINDING_PAT:
                    let ptext = self.mb.get_token_text(pat_node.token_idx)
                    if ptext == "Some" or ptext == "None":
                        result = 0 as i64
                    elif ptext == "Ok" or ptext == "Err":
                        result = 1 as i64
                    @free(get_str_ptr(ptext))
                    if result >= 0 as i64:
                        return result
        arm = arm_node.next_sibling
    return result

// RFC 0012: dispatch `match` on an Option/Result (kind 11/12) scrutinee. Unlike a
// user sum (tag@field0, payload@field1), these are pointer-tagged: the scrutinee
// register holds an 8-byte box pointer â€” None = null(0), Some = non-null; Ok = box
// with bit0 clear, Err = box|1; the payload lives at [box & ~1 + 0]. Arms are
// classified by the pattern's TOKEN text (Some/None/Ok/Err), because the builtin
// variants are not registered in the sum table and cross-module name_ids are
// unreliable here (see the constructor comment). is_res selects Result vs Option.
pub fn lower_match_tagged(mut self: ptr[FuncLowering], scrutinee_idx: u32, scrut_reg: u32, is_res: bool):
    // The scrutinee's static type is the monomorphised std Option/Result sum
    // (`type Option[T] = Some(T)|None`), so find_variant_info can recover each
    // arm's payload TYPE â€” needed to load the payload at the right width (a str
    // payload is a 16-byte by-address value, everything else an 8-byte slot).
    mut scrut_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        scrut_type = self.mb.node_types[scrutinee_idx as i64]
    let merge_block = self.fb.new_block()
    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut done := false
    while arm != 0 as u32 and not done:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        let next_arm = arm_node.next_sibling
        if arm_node.kind != NODE_MATCH_ARM:
            arm = next_arm
            continue
        let pat = arm_node.first_child
        if pat == 0 as u32:
            arm = next_arm
            continue
        let pat_node = self.mb.tree.nodes.data[pat as i64]
        let body = pat_node.next_sibling

        // Classify the arm by its pattern token text.
        mut arm_kind := -1 as i64   // 0=None 1=Some 2=Ok 3=Err
        mut is_default := false
        mut bind_sym := 0 as u32          // catch-all binding of the whole scrutinee
        mut payload_bind_sym := 0 as u32  // variant payload binding
        let pat_variant_sym = pat_node.payload  // variant symbol (for payload type lookup)
        if pat_node.kind == NODE_WILDCARD_PAT:
            is_default = true
        else:
            let ptext = self.mb.get_token_text(pat_node.token_idx)
            if ptext == "None":
                arm_kind = 0
            elif ptext == "Some":
                arm_kind = 1
            elif ptext == "Ok":
                arm_kind = 2
            elif ptext == "Err":
                arm_kind = 3
            @free(get_str_ptr(ptext))
            if arm_kind < 0 as i64:
                // A bare non-variant identifier is a catch-all binding.
                if pat_node.kind == NODE_BINDING_PAT:
                    is_default = true
                    bind_sym = pat_node.payload
                else:
                    is_default = true
            elif pat_node.kind == NODE_VARIANT_PAT:
                let arg = pat_node.first_child
                if arg != 0 as u32 and self.mb.tree.nodes.data[arg as i64].kind == NODE_BINDING_PAT:
                    payload_bind_sym = self.mb.tree.nodes.data[arg as i64].payload

        if is_default:
            if bind_sym != 0 as u32:
                self.locals.local_map_put(bind_sym, scrut_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)
            done = true
        else:
            // Build the discriminant register to compare against zero.
            // None/Some: the box pointer itself. Ok/Err: (box & 1).
            mut disc_reg := scrut_reg
            if arm_kind == 2 as i64 or arm_kind == 3 as i64:
                let one_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: one_reg, src1: 1 as u32, src2: 0 as u32))
                let and_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: and_reg, src1: scrut_reg, src2: one_reg))
                disc_reg = and_reg
            let zero_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: zero_reg, src1: 0 as u32, src2: 0 as u32))
            let cmp_reg = self.fb.fresh_reg()
            // None (0) and Ok (bit0==0) take the arm when the discriminant == 0;
            // Some (non-null) and Err (bit0==1) take it when != 0.
            mut cmp_op := OP_EQ
            if arm_kind == 1 as i64 or arm_kind == 3 as i64:
                cmp_op = OP_NE
            self.fb.emit(AirInst(opcode: cmp_op, type_id: 11 as u32, dest: cmp_reg, src1: disc_reg, src2: zero_reg))

            let then_block = self.fb.new_block()
            let else_block = self.fb.new_block()
            self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: else_block, src1: cmp_reg, src2: then_block))
            let cur = self.fb.current_block()
            self.fb.add_edge(cur, then_block)
            self.fb.add_edge(cur, else_block)

            self.fb.switch_to(then_block)
            self.terminated = false
            if payload_bind_sym != 0 as u32:
                // box = scrut (Some/Ok) or scrut & ~1 (Err); payload = [box+0].
                mut box_reg := scrut_reg
                if arm_kind == 3 as i64:
                    let mask_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: mask_reg, src1: 0xFFFFFFFE as u32, src2: 0xFFFFFFFF as u32))
                    let cleared = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: cleared, src1: scrut_reg, src2: mask_reg))
                    box_reg = cleared
                // Recover the payload TYPE: prefer the scrutinee sum's variant info
                // (gives str/struct/scalar exactly), then the binding symbol's type,
                // then i64. Extract via OP_DEREF (not a raw 8-byte load) so a str
                // payload gets its full 16-byte by-address value and a struct/scalar
                // gets its correct width â€” mirroring how `.*`/GET_FIELD read a payload.
                mut pl_type := 0 as u32
                if pat_variant_sym != 0 as u32 and (pat_variant_sym as i64) < self.mb.symbols.symbols.len:
                    let vname = self.mb.symbols.symbols.data[pat_variant_sym as i64].name_id
                    mut vt := -1 as i64
                    mut vpl := 0 as u32
                    if self.find_variant_info(scrut_type, vname, &vt, &vpl):
                        pl_type = vpl
                // Option/Result are registered as dedicated kinds (11/12) with the
                // payload in `extra` (Some/Ok inner) and `name_id` (Result Err) â€” not
                // as a sum with a variant vector â€” so find_variant_info can't see them.
                // Derive the payload type directly so a str (12) payload gets its full
                // 16-byte DEREF instead of the 8-byte default (else `s.len` reads junk).
                if pl_type == 0 as u32 and scrut_type != 0 as u32 and (scrut_type as i64) < self.mb.typetable.entries.len:
                    let se = self.mb.typetable.entries.data[scrut_type as i64]
                    if se.kind == TYPE_KIND_OPTION:
                        pl_type = se.extra
                    elif se.kind == TYPE_KIND_RESULT:
                        if arm_kind == 3 as i64:
                            pl_type = se.name_id
                        else:
                            pl_type = se.extra
                // A GENERIC_INST scrutinee (unannotated `let x = Some((a,b))`) makes
                // find_variant_info return the TEMPLATE variant's generic param `T`
                // (kind 7). Deref'ing a small (<=8B) aggregate payload with a generic
                // scalar type loads it into a register where the 2nd+ field is not
                // addressable (reads 0). The typechecker already typed the pattern var
                // concretely (subst_variant_payload_type), so prefer that concrete type
                // whenever find_variant_info yielded 0 or a bare generic param.
                mut pl_is_generic := false
                if pl_type != 0 as u32 and (pl_type as i64) < self.mb.typetable.entries.len:
                    if self.mb.typetable.entries.data[pl_type as i64].kind == TYPE_KIND_GENERIC:
                        pl_is_generic = true
                if (pl_type == 0 as u32 or pl_is_generic) and (payload_bind_sym as i64) < self.mb.symbols.symbols.len:
                    let bt = self.mb.symbols.symbols.data[payload_bind_sym as i64].type_id
                    if bt != 0 as u32 and (bt as i64) < self.mb.typetable.entries.len and self.mb.typetable.entries.data[bt as i64].kind != TYPE_KIND_GENERIC:
                        pl_type = bt
                // A str payload is stored INLINE as a 16-byte str: the constructor
                // (Some/Ok/Err, ~line 1656) uses store_t=12 whenever the payload EXPR is
                // str. But for a str variant the sum table records the RFC 0019 synth
                // struct that WRAPS the str (a single-str-field struct), whose type id
                // isn't str(12) â€” so a plain DEREF would take the 8-byte path and drop
                // the length half (`s.len` reads junk). Unwrap a single-str-field struct
                // back to str(12) so the DEREF loads the full 16 bytes, mirroring the
                // constructor exactly. (Genuine multi-field / >8B user-struct payloads
                // are heap-boxed as an 8-byte pointer and must NOT be unwrapped.)
                if pl_type != 0 as u32 and (pl_type as i64) < self.mb.typetable.entries.len:
                    let pe = self.mb.typetable.entries.data[pl_type as i64]
                    if pe.kind == TYPE_KIND_STRUCT and (pe.flags & 1 as u16) != 0 as u16 and (pe.extra as i64) < self.mb.typetable.structs.len:
                        let si = self.mb.typetable.structs.data[pe.extra as i64]
                        if si.fields.len == 1 as i64 and si.fields.data[0].type_id == 12 as u32:
                            pl_type = 12 as u32
                if pl_type == 0 as u32:
                    pl_type = 4 as u32
                let pl_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(opcode: OP_DEREF, type_id: pl_type, dest: pl_reg, src1: box_reg, src2: 0 as u32))
                self.locals.local_map_put(payload_bind_sym, pl_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)

            self.fb.switch_to(else_block)
            self.terminated = false
        arm = next_arm

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)
    self.fb.switch_to(merge_block)
    self.terminated = false

// RFC 0028 (opt-in `-jumptable`): recursively emit a BALANCED compare tree over the
// SORTED arm values[lo..hi]. Operates in the already-switched-to current block. Each node:
// `if scrut == values[mid]: <body[mid]> elif scrut < values[mid]: <left> else <right>`.
// Leaves lower each arm body exactly once; an out-of-range value falls to default_block.
// O(log N) compares vs the linear chain's O(N). Gated to i64 scrutinees so the i64 (signed)
// sort matches the signed OP_LT ordering.
pub fn emit_bsearch_range(mut self: ptr[FuncLowering], match_reg: u32, scrut_type: u32, values: ptr[i64], bodies: ptr[u32], lo: i64, hi: i64, default_block: u32, merge_block: u32):
    if lo > hi:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: default_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), default_block)
        return
    let mid = (lo + hi) / 2 as i64
    let v = values[mid]
    let v_lo = (v & (0xFFFFFFFF as i64)) as u32
    let v_hi = ((v >> (32 as i64)) & (0xFFFFFFFF as i64)) as u32
    // equality test against the median
    let eq_const = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: scrut_type, dest: eq_const, src1: v_lo, src2: v_hi))
    let eq_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_EQ, type_id: 11 as u32, dest: eq_reg, src1: match_reg, src2: eq_const))
    let hit_block = self.fb.new_block()
    let miss_block = self.fb.new_block()
    // OP_BRANCH: dest = false-target, src1 = cond, src2 = true-target
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: miss_block, src1: eq_reg, src2: hit_block))
    let cur0 = self.fb.current_block()
    self.fb.add_edge(cur0, hit_block)
    self.fb.add_edge(cur0, miss_block)
    // hit: lower this arm's body, then jump to merge
    self.fb.switch_to(hit_block)
    self.terminated = false
    let body = bodies[mid]
    if body != 0 as u32:
        let bn = self.mb.tree.nodes.data[body as i64]
        if bn.kind == NODE_BLOCK:
            self.lower_block(body)
        else:
            self.lower_expr(body)
    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)
    // miss: order test -> recurse into the lower or upper half
    self.fb.switch_to(miss_block)
    self.terminated = false
    let lt_const = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: scrut_type, dest: lt_const, src1: v_lo, src2: v_hi))
    let lt_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_LT, type_id: 11 as u32, dest: lt_reg, src1: match_reg, src2: lt_const))
    let left_block = self.fb.new_block()
    let right_block = self.fb.new_block()
    // lt true -> left (lower half), lt false -> right (upper half)
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: right_block, src1: lt_reg, src2: left_block))
    let cur1 = self.fb.current_block()
    self.fb.add_edge(cur1, left_block)
    self.fb.add_edge(cur1, right_block)
    self.fb.switch_to(left_block)
    self.terminated = false
    self.emit_bsearch_range(match_reg, scrut_type, values, bodies, lo, mid - 1 as i64, default_block, merge_block)
    self.fb.switch_to(right_block)
    self.terminated = false
    self.emit_bsearch_range(match_reg, scrut_type, values, bodies, mid + 1 as i64, hi, default_block, merge_block)

// RFC 0028: try to lower an i64 `match` as a balanced compare tree. Returns true if it did
// (caller returns), false to fall back to the linear chain. Collects the literal arms +
// a single default (wildcard or bare-ident catch-all), requires >= 4 literal arms (below
// that the linear chain is as fast), sorts by value, and emits the tree. Bails (false) on
// any non-literal/non-default pattern (e.g. a stray variant pattern) â€” soundness first.
pub fn try_lower_match_bsearch(mut self: ptr[FuncLowering], scrutinee_idx: u32, match_reg: u32, scrut_type: u32) -> bool:
    // Count literal arms first.
    mut n := 0 as i64
    mut a := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    while a != 0 as u32:
        let an = self.mb.tree.nodes.data[a as i64]
        if an.kind == NODE_MATCH_ARM:
            let p = an.first_child
            if p != 0 as u32:
                let pk = self.mb.tree.nodes.data[p as i64].kind
                if pk == NODE_LITERAL_PAT:
                    n = n + 1 as i64
                elif pk == NODE_WILDCARD_PAT or pk == NODE_BINDING_PAT:
                    a = a  // default â€” handled below
                else:
                    return false  // unexpected pattern in an i64 match -> linear
        a = an.next_sibling
    if n < 4 as i64:
        return false
    // Allocate parallel value/body arrays and fill them.
    let values = @alloc(n * 8 as i64) as ptr[i64]
    let bodies = @alloc(n * 4 as i64) as ptr[u32]
    mut default_body := 0 as u32
    mut default_bind := 0 as u32
    mut have_default := false
    mut fi := 0 as i64
    a = self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    while a != 0 as u32:
        let an = self.mb.tree.nodes.data[a as i64]
        if an.kind == NODE_MATCH_ARM:
            let p = an.first_child
            if p != 0 as u32:
                let pn = self.mb.tree.nodes.data[p as i64]
                let body = pn.next_sibling
                if pn.kind == NODE_LITERAL_PAT:
                    let ltext = self.mb.get_token_text(pn.token_idx)
                    mut lv := pat_literal_value(ltext)
                    if pn.payload == 1 as u32:  // negative literal pattern (`-5`)
                        lv = 0 as i64 - lv
                    values[fi] = lv
                    @free(get_str_ptr(ltext))
                    bodies[fi] = body
                    fi = fi + 1 as i64
                elif pn.kind == NODE_WILDCARD_PAT or pn.kind == NODE_BINDING_PAT:
                    if not have_default:
                        default_body = body
                        default_bind = pn.payload
                        have_default = true
        a = an.next_sibling
    // Insertion sort by value (signed i64; arms are few).
    mut i := 1 as i64
    while i < n:
        let kv = values[i]
        let kb = bodies[i]
        mut j := i - 1 as i64
        while j >= 0 as i64 and values[j] > kv:
            values[j + 1 as i64] = values[j]
            bodies[j + 1 as i64] = bodies[j]
            j = j - 1 as i64
        values[j + 1 as i64] = kv
        bodies[j + 1 as i64] = kb
        i = i + 1 as i64
    let merge_block = self.fb.new_block()
    mut default_block := merge_block
    if have_default:
        default_block = self.fb.new_block()
    // Emit the tree in the CURRENT (entry) block FIRST. Do NOT switch to another block
    // before this: switching AWAY from entry and back mis-attributes instructions in the
    // func builder (the entry ended up with the default body's `ret`). The tree only
    // references default_block by id, so lowering the default body AFTER is fine.
    self.emit_bsearch_range(match_reg, scrut_type, values, bodies, 0 as i64, n - 1 as i64, default_block, merge_block)
    if have_default:
        self.fb.switch_to(default_block)
        self.terminated = false
        if default_bind != 0 as u32:
            self.locals.local_map_put(default_bind, match_reg)
        if default_body != 0 as u32:
            let dbn = self.mb.tree.nodes.data[default_body as i64]
            if dbn.kind == NODE_BLOCK:
                self.lower_block(default_body)
            else:
                self.lower_expr(default_body)
        if not self.terminated:
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), merge_block)
    @free(values as ptr[u8])
    @free(bodies as ptr[u8])
    self.fb.switch_to(merge_block)
    self.terminated = false
    return true

// RFC 0028 Â§7e: fold a comptime INTEGER constant expression used as an if-chain compare
// value. Handles the literal forms plus a named `const` (the shape the compiler's own
// dispatch uses: `op == OP_IADD`, where OP_IADD is a module-level const). Returns false â€”
// never a bogus 0 â€” for anything it cannot prove constant, so the caller falls back to the
// linear chain. `out` receives the value only on true.
pub fn ifchain_const_int(self: ptr[FuncLowering], idx: u32, out: ptr[i64]) -> bool:
    if idx == 0 as u32 or (idx as i64) >= self.mb.tree.nodes.len:
        return false
    let node = self.mb.tree.nodes.data[idx as i64]
    if node.kind == NODE_CAST_EXPR:
        return self.ifchain_const_int(node.first_child, out)
    if node.kind == NODE_UNARY_EXPR:
        let op = self.mb.get_token_text(node.token_idx)
        let is_neg = op == "-"
        let is_pos = op == "+"
        @free(get_str_ptr(op))
        if not is_neg and not is_pos:
            return false
        mut inner := 0 as i64
        if not self.ifchain_const_int(node.first_child, &inner):
            return false
        if is_neg:
            inner = 0 as i64 - inner
        out[0] = inner
        return true
    if node.kind == NODE_INT_LIT or node.kind == NODE_BOOL_LIT or node.kind == NODE_CHAR_LIT:
        out[0] = self.mb.builder_global_fold_int(idx)
        return true
    // A named constant: resolve the symbol and fold its initializer. Only a resolved
    // SYM_CONST whose declaration lives in THIS tree is accepted â€” an imported/library
    // const (decl_node 0, value in next_overload) is deliberately left to the linear
    // path rather than duplicating that inlining rule here.
    if node.kind == NODE_IDENT:
        if node.payload == 0 as u32 or (node.payload as i64) >= self.mb.symbols.symbols.len:
            return false
        let sym = self.mb.symbols.symbols.data[node.payload as i64]
        if sym.kind != SYM_CONST or sym.decl_node == 0 as u32:
            return false
        if (sym.decl_node as i64) >= self.mb.tree.nodes.len:
            return false
        mut init_expr := 0 as u32
        mut child := self.mb.tree.nodes.data[sym.decl_node as i64].first_child
        while child != 0 as u32:
            let child_node = self.mb.tree.nodes.data[child as i64]
            if child_node.kind != NODE_TYPE_EXPR and child_node.kind != NODE_GENERIC_TYPE:
                init_expr = child
            child = child_node.next_sibling
        if init_expr == 0 as u32:
            return false
        return self.ifchain_const_int(init_expr, out)
    return false

// RFC 0028 Â§7e: collect the compare values of ONE clause condition. Accepts either a
// single `<ident> == <const int>` or an OR-chain of them over the SAME ident
// (`op == OP_ALLOC or op == OP_ARENA_ALLOC or op == OP_SYSCALL` â€” the disjunctive arm the
// compiler's own selector dispatch is full of; it is the `case A: case B:` of a switch and
// maps several values to one body). Appends each value at `vals_out[count_io[0]]` and
// advances the count. `sym_out[0]` is 0 on entry and pins the scrutinee symbol at the first
// leaf; a leaf naming a DIFFERENT variable fails the whole clause. Returns false â€” leaving
// the caller to use the linear path â€” for any other shape (`and`, a non-ident left side, a
// non-constant right side, or more than `cap` values).
pub fn ifchain_collect_values(self: ptr[FuncLowering], cond_idx: u32, sym_out: ptr[u32], ident_out: ptr[u32], vals_out: ptr[i64], cap: i64, count_io: ptr[i64]) -> bool:
    if cond_idx == 0 as u32 or (cond_idx as i64) >= self.mb.tree.nodes.len:
        return false
    let cond = self.mb.tree.nodes.data[cond_idx as i64]
    if cond.kind != NODE_BINARY_EXPR:
        return false
    let op = self.mb.get_token_text(cond.token_idx)
    let is_eq = op == "=="
    let is_or = op == "or" or op == "||"
    @free(get_str_ptr(op))
    let lhs_idx = cond.first_child
    if lhs_idx == 0 as u32:
        return false
    if is_or:
        let rhs_or = self.mb.tree.nodes.data[lhs_idx as i64].next_sibling
        if rhs_or == 0 as u32:
            return false
        if not self.ifchain_collect_values(lhs_idx, sym_out, ident_out, vals_out, cap, count_io):
            return false
        return self.ifchain_collect_values(rhs_or, sym_out, ident_out, vals_out, cap, count_io)
    if not is_eq:
        return false
    let lhs = self.mb.tree.nodes.data[lhs_idx as i64]
    if lhs.kind != NODE_IDENT:
        return false
    // The scrutinee must be a plain local/param read: pure (so evaluating it ONCE up
    // front is equivalent to re-reading it at each linear compare) and identifiable by
    // symbol index. A const/func/variant ident is not a dispatch scrutinee.
    if lhs.payload == 0 as u32 or (lhs.payload as i64) >= self.mb.symbols.symbols.len:
        return false
    let lsym = self.mb.symbols.symbols.data[lhs.payload as i64]
    if lsym.kind != SYM_VAR and lsym.kind != SYM_PARAM:
        return false
    if sym_out[0] == 0 as u32:
        sym_out[0] = lhs.payload
        ident_out[0] = lhs_idx
    elif sym_out[0] != lhs.payload:
        return false
    let rhs_idx = lhs.next_sibling
    if rhs_idx == 0 as u32:
        return false
    let slot = count_io[0]
    if slot >= cap:
        return false
    mut cv := 0 as i64
    if not self.ifchain_const_int(rhs_idx, &cv):
        return false
    vals_out[slot] = cv
    count_io[0] = slot + 1 as i64
    return true

// RFC 0028 Â§7e: emit a balanced compare tree whose leaves JUMP to a pre-allocated block,
// instead of lowering an arm body inline the way emit_bsearch_range does. This is what an
// if-chain needs: one clause can carry several or'd compare values (`x == A or x == B`), and
// all of them must reach ONE copy of the body â€” lowering inline per leaf would clone the body
// once per value. Targets are referenced by block id only, so the caller lowers each body
// AFTER this returns. `values[lo..hi]` must already be sorted in the scrutinee's compare
// order; an out-of-range value falls through to default_block.
pub fn emit_bsearch_blocks(mut self: ptr[FuncLowering], match_reg: u32, scrut_type: u32, values: ptr[i64], targets: ptr[u32], lo: i64, hi: i64, default_block: u32):
    if lo > hi:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: default_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), default_block)
        return
    let mid = (lo + hi) / 2 as i64
    let v = values[mid]
    let v_lo = (v & (0xFFFFFFFF as i64)) as u32
    let v_hi = ((v >> (32 as i64)) & (0xFFFFFFFF as i64)) as u32
    // equality test against the median -> jump straight to that clause's block
    let eq_const = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: scrut_type, dest: eq_const, src1: v_lo, src2: v_hi))
    let eq_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_EQ, type_id: 11 as u32, dest: eq_reg, src1: match_reg, src2: eq_const))
    let hit_block = targets[mid]
    let miss_block = self.fb.new_block()
    // OP_BRANCH: dest = false-target, src1 = cond, src2 = true-target
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: miss_block, src1: eq_reg, src2: hit_block))
    let cur0 = self.fb.current_block()
    self.fb.add_edge(cur0, hit_block)
    self.fb.add_edge(cur0, miss_block)
    // miss: order test -> recurse into the lower or upper half
    self.fb.switch_to(miss_block)
    self.terminated = false
    let lt_const = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_ICONST, type_id: scrut_type, dest: lt_const, src1: v_lo, src2: v_hi))
    let lt_reg = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: OP_LT, type_id: 11 as u32, dest: lt_reg, src1: match_reg, src2: lt_const))
    let left_block = self.fb.new_block()
    let right_block = self.fb.new_block()
    self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: right_block, src1: lt_reg, src2: left_block))
    let cur1 = self.fb.current_block()
    self.fb.add_edge(cur1, left_block)
    self.fb.add_edge(cur1, right_block)
    self.fb.switch_to(left_block)
    self.terminated = false
    self.emit_bsearch_blocks(match_reg, scrut_type, values, targets, lo, mid - 1 as i64, default_block)
    self.fb.switch_to(right_block)
    self.terminated = false
    self.emit_bsearch_blocks(match_reg, scrut_type, values, targets, mid + 1 as i64, hi, default_block)

// RFC 0028 Â§7e: recognize an `if x == C0: â€¦ elif x == C1: â€¦ else: â€¦` CHAIN â€” the shape the
// compiler's own opcode dispatch is written in â€” and lower it as the SAME balanced O(log N)
// compare tree used for a dense `match`. Returns true if it took over the lowering (caller
// must not run the linear path), false to fall back.
//
// Equivalence argument: a body only runs after every preceding condition tested false, and
// no condition can run after a body, so no body's side effects can be observed by a compare.
// Each condition is `<pure ident read> == <constant>`, so hoisting the read out of the chain
// and reordering the compares into a search tree preserves semantics â€” PROVIDED the arm
// values are pairwise distinct (otherwise linear first-match-wins would differ), which is
// checked below.
pub fn try_lower_if_chain_bsearch(mut self: ptr[FuncLowering], cond_idx: u32, body_idx: u32, next_clause_idx: u32, merge_block: u32) -> bool:
    // A single clause may contribute several values (`x == A or x == B`), so the buffers
    // are sized by a cap rather than by the clause count: IFCHAIN_MAX_VALUES total across
    // the chain, IFCHAIN_MAX_PER_CLAUSE within one condition. Exceeding either bails to the
    // linear path (no correctness impact, only a missed optimization).
    let cap_total = 256 as i64
    let cap_clause = 64 as i64
    let scratch = @alloc(cap_clause * 8 as i64) as ptr[i64]
    mut scrut_sym := 0 as u32
    mut scrut_idx := 0 as u32
    mut c0 := 0 as i64
    if not self.ifchain_collect_values(cond_idx, &scrut_sym, &scrut_idx, scratch, cap_clause, &c0):
        @free(scratch as ptr[u8])
        return false
    // Gate on the scrutinee's static type: integer widths only (1-8 = i8..u64,
    // 15/16 = isize/usize). bool/char are excluded â€” a 2-value or codepoint dispatch is
    // not worth a tree and keeps the sort's ordering question closed.
    mut scrut_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        scrut_type = self.mb.node_types[scrut_idx as i64]
    let is_signed = scrut_type == 1 as u32 or scrut_type == 2 as u32 or scrut_type == 3 as u32 or scrut_type == 4 as u32 or scrut_type == 15 as u32
    let is_unsigned = scrut_type == 5 as u32 or scrut_type == 6 as u32 or scrut_type == 7 as u32 or scrut_type == 8 as u32 or scrut_type == 16 as u32
    if not is_signed and not is_unsigned:
        @free(scratch as ptr[u8])
        return false
    if self.mb.tree.nodes.data[body_idx as i64].kind != NODE_BLOCK:
        @free(scratch as ptr[u8])
        return false

    // Pass 1: total the compare values and locate the trailing `else` (if any). Any clause
    // that is not `<same ident> == <const>` (or an or-chain of those) with a NODE_BLOCK body
    // aborts the rewrite.
    mut n := c0
    mut nclauses := 1 as i64
    mut else_body := 0 as u32
    mut have_else := false
    mut clause := next_clause_idx
    while clause != 0 as u32:
        let cn = self.mb.tree.nodes.data[clause as i64]
        if cn.kind == NODE_ELSE_CLAUSE:
            let eb = cn.first_child
            if eb == 0 as u32 or self.mb.tree.nodes.data[eb as i64].kind != NODE_BLOCK:
                @free(scratch as ptr[u8])
                return false
            else_body = eb
            have_else = true
            clause = 0 as u32
        elif cn.kind == NODE_ELIF_CLAUSE:
            let ec = cn.first_child
            if ec == 0 as u32:
                @free(scratch as ptr[u8])
                return false
            mut esym := scrut_sym
            mut eident := scrut_idx
            mut ecount := 0 as i64
            if not self.ifchain_collect_values(ec, &esym, &eident, scratch, cap_clause, &ecount):
                @free(scratch as ptr[u8])
                return false
            let eb2 = self.mb.tree.nodes.data[ec as i64].next_sibling
            if eb2 == 0 as u32 or self.mb.tree.nodes.data[eb2 as i64].kind != NODE_BLOCK:
                @free(scratch as ptr[u8])
                return false
            n = n + ecount
            nclauses = nclauses + 1 as i64
            if n > cap_total:
                @free(scratch as ptr[u8])
                return false
            clause = cn.next_sibling
        else:
            @free(scratch as ptr[u8])
            return false
    // Threshold 8, twice the `match` path's 4. An if-chain tree costs ~3 basic blocks and 4
    // vregs per value, and if-chains are far more common in real code than dense matches, so
    // the break-even sits higher: at 4 arms a tree saves ~0.5 compares, which does not pay
    // for the extra blocks. The long dispatch chains this exists for are 10+ arms.
    if n < 8 as i64:
        @free(scratch as ptr[u8])
        return false

    // Pass 2: allocate ONE block per clause and map every compare value to its clause's
    // block. Several or'd values share a block, so the body is lowered exactly once â€” the
    // linear chain's shared arm block, reached from several tree leaves instead of several
    // sequential compares.
    // NOTHING here may allocate a basic block until every bail check has passed: a block
    // handed out and then abandoned stays in the function forever. Bailing after allocating
    // is what pushed the compiler's own `-jumptable` build past the allocator ceiling, since
    // thousands of chains each leaked one dead block per clause. So pass 2 records a clause
    // INDEX per value, and blocks are minted only once the rewrite is committed.
    let values = @alloc(n * 8 as i64) as ptr[i64]
    let val_clause = @alloc(n * 4 as i64) as ptr[u32]
    let targets = @alloc(n * 4 as i64) as ptr[u32]
    let cl_blocks = @alloc(nclauses * 4 as i64) as ptr[u32]
    let cl_bodies = @alloc(nclauses * 4 as i64) as ptr[u32]
    mut fi := 0 as i64
    mut ci := 1 as i64
    cl_bodies[0] = body_idx
    // Re-collect clause 0's values: pass 1 reused `scratch` for every elif, so what it holds
    // now is the LAST clause's values, not the first's. (Reading the stale buffer put the
    // final arm's value in slot 0, which then collided with that arm's own entry and made the
    // duplicate check reject every chain â€” the rewrite silently never fired.)
    mut c0b := 0 as i64
    mut sym0 := scrut_sym
    mut id0 := scrut_idx
    if not self.ifchain_collect_values(cond_idx, &sym0, &id0, scratch, cap_clause, &c0b):
        @free(scratch as ptr[u8])
        @free(values as ptr[u8])
        @free(val_clause as ptr[u8])
        @free(targets as ptr[u8])
        @free(cl_blocks as ptr[u8])
        @free(cl_bodies as ptr[u8])
        return false
    mut k := 0 as i64
    while k < c0b:
        values[fi] = scratch[k]
        val_clause[fi] = 0 as u32
        fi = fi + 1 as i64
        k = k + 1 as i64
    clause = next_clause_idx
    while clause != 0 as u32 and fi < n:
        let cn2 = self.mb.tree.nodes.data[clause as i64]
        if cn2.kind == NODE_ELIF_CLAUSE:
            let ec2 = cn2.first_child
            mut esym2 := scrut_sym
            mut eident2 := scrut_idx
            mut ecount2 := 0 as i64
            if self.ifchain_collect_values(ec2, &esym2, &eident2, scratch, cap_clause, &ecount2):
                cl_bodies[ci] = self.mb.tree.nodes.data[ec2 as i64].next_sibling
                mut k2 := 0 as i64
                while k2 < ecount2 and fi < n:
                    values[fi] = scratch[k2]
                    val_clause[fi] = ci as u32
                    fi = fi + 1 as i64
                    k2 = k2 + 1 as i64
                ci = ci + 1 as i64
            clause = cn2.next_sibling
        else:
            clause = 0 as u32
    @free(scratch as ptr[u8])

    // Sort by value, using the SAME ordering the emitted OP_LT will use (select_comparison
    // picks CC_L for signed operands and CC_B for unsigned) â€” a signed sort on unsigned
    // values would build a tree the compares then walk in the wrong direction.
    mut i := 1 as i64
    while i < n:
        let kv = values[i]
        let kb = val_clause[i]
        mut j := i - 1 as i64
        mut moving := true
        while j >= 0 as i64 and moving:
            mut greater := values[j] > kv
            if is_unsigned:
                greater = (values[j] as u64) > (kv as u64)
            if greater:
                values[j + 1 as i64] = values[j]
                val_clause[j + 1 as i64] = val_clause[j]
                j = j - 1 as i64
            else:
                moving = false
        values[j + 1 as i64] = kv
        val_clause[j + 1 as i64] = kb
        i = i + 1 as i64
    // Duplicate compare values would make the tree pick an arbitrary arm where the linear
    // chain picks the FIRST â€” bail rather than silently change which body runs.
    mut d := 1 as i64
    while d < n:
        if values[d] == values[d - 1 as i64]:
            @free(values as ptr[u8])
            @free(val_clause as ptr[u8])
            @free(targets as ptr[u8])
            @free(cl_blocks as ptr[u8])
            @free(cl_bodies as ptr[u8])
            return false
        d = d + 1 as i64

    // Committed: mint one block per clause and resolve each value's target.
    mut cb := 0 as i64
    while cb < ci:
        cl_blocks[cb] = self.fb.new_block()
        cb = cb + 1 as i64
    mut t := 0 as i64
    while t < n:
        targets[t] = cl_blocks[val_clause[t] as i64]
        t = t + 1 as i64
    // Evaluate the scrutinee ONCE in the current block, then emit the tree here (do not
    // switch away first â€” see the note in try_lower_match_bsearch). The tree only names
    // blocks, so every body is lowered afterwards.
    let match_reg = self.lower_expr(scrut_idx)
    mut default_block := merge_block
    if have_else:
        default_block = self.fb.new_block()
    self.emit_bsearch_blocks(match_reg, scrut_type, values, targets, 0 as i64, n - 1 as i64, default_block)
    mut b := 0 as i64
    while b < ci:
        self.fb.switch_to(cl_blocks[b])
        self.terminated = false
        self.lower_block(cl_bodies[b])
        if not self.terminated:
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), merge_block)
        b = b + 1 as i64
    if have_else:
        self.fb.switch_to(default_block)
        self.terminated = false
        self.lower_block(else_body)
        if not self.terminated:
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), merge_block)
    @free(values as ptr[u8])
    @free(val_clause as ptr[u8])
    @free(targets as ptr[u8])
    @free(cl_blocks as ptr[u8])
    @free(cl_bodies as ptr[u8])
    return true

pub fn lower_match(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let scrutinee_idx = node.first_child
    if scrutinee_idx == 0 as u32:
        return
    let scrut_reg = self.lower_expr(scrutinee_idx)

    mut scrut_type := 0 as u32
    if self.mb.node_types != null as ptr[u32]:
        scrut_type = self.mb.node_types[scrutinee_idx as i64]

    // RFC 0012: Option/Result use the pointer-tagged layout (None=null, Some=box;
    // Ok=even box, Err=box|1; payload at [box&~1]), NOT the user-sum tag-at-field-0
    // box. Detect them by ARM NAMES (Some/None â‡’ Option, Ok/Err â‡’ Result) rather
    // than the scrutinee's static type: the builtin variants are declared as a
    // generic sum in std/result.ax, so typecheck may type the scrutinee as that sum
    // (or leave it untyped), and codegen always emits the pointer-tagged layout for
    // these names. Classifying by name keeps the whole fix inside the backend, off
    // the stdlib's generic Option/Result ABI. -1 = not tagged, 0 = Option, 1 = Result.
    let tagged_kind = self.match_arms_tagged_kind(scrutinee_idx)
    if tagged_kind >= 0 as i64:
        self.lower_match_tagged(scrutinee_idx, scrut_reg, tagged_kind == 1 as i64)
        return

    mut is_sum := false
    // BUG#91: a user sum scrutinee may be typed as a GENERIC_INST (unannotated generic
    // construction like `One(42)` for `Opt[T]`), not a kind-6 SUM. Resolve through it,
    // else the match silently lowered to nothing (the whole `match` disappeared).
    if self.resolve_sum_type(scrut_type) != 0 as u32:
        is_sum = true
    // RFC 0006 (BUG#37/#38.2): `match` on a plain integer/bool/char scrutinee is
    // the C-`switch` equivalent â€” compare the value itself against literal-pattern
    // values. (1-8 = int widths, 11 = bool, 13 = char8, 15/16 = isize/usize.)
    mut is_int := false
    if not is_sum:
        if (scrut_type >= 1 as u32 and scrut_type <= 8 as u32) or scrut_type == 11 as u32 or scrut_type == 13 as u32 or scrut_type == 15 as u32 or scrut_type == 16 as u32:
            is_int = true
    if not is_sum and not is_int:
        return

    // The register compared against each arm: the tag (sum) or the value (int).
    mut match_reg := scrut_reg
    if is_sum:
        let tag_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_GET_FIELD,
            type_id: 4 as u32,
            dest: tag_reg,
            src1: scrut_reg,
            src2: 0 as u32,
        ))
        match_reg = tag_reg

    // RFC 0028 (opt-in `-jumptable`): a dense SIGNED-int `match` -> balanced O(log N) compare
    // tree. Gated to signed integer scrutinees (i8=1/i16=2/i32=3/i64=4/isize=15) so the i64
    // (signed) arm-value sort matches the signed OP_LT ordering; unsigned/bool/char stay on the
    // linear chain (their order would differ). Falls back to linear on any non-qualifying shape.
    // Default off -> linear -> self-build A==B.
    if self.mb.jumptable_enabled and is_int and (scrut_type == 1 as u32 or scrut_type == 2 as u32 or scrut_type == 3 as u32 or scrut_type == 4 as u32 or scrut_type == 15 as u32):
        if self.try_lower_match_bsearch(scrutinee_idx, match_reg, scrut_type):
            return

    let merge_block = self.fb.new_block()

    mut arm := self.mb.tree.nodes.data[scrutinee_idx as i64].next_sibling
    mut done := false
    while arm != 0 as u32 and not done:
        let arm_node = self.mb.tree.nodes.data[arm as i64]
        let next_arm = arm_node.next_sibling
        if arm_node.kind != NODE_MATCH_ARM:
            arm = next_arm
            continue
        let pat = arm_node.first_child
        if pat == 0 as u32:
            arm = next_arm
            continue
        let pat_node = self.mb.tree.nodes.data[pat as i64]
        let body = pat_node.next_sibling

        // Classify the pattern.
        mut is_default := false
        mut variant_tag := -1 as i64
        mut payload_type := 0 as u32
        mut bind_sym := 0 as u32        // catch-all binding (whole scrutinee)
        mut payload_bind_sym := 0 as u32 // variant payload binding

        if pat_node.kind == NODE_WILDCARD_PAT:
            is_default = true
        elif pat_node.kind == NODE_LITERAL_PAT:
            // C-switch case: compare the scrutinee value against this literal.
            let ltext = self.mb.get_token_text(pat_node.token_idx)
            variant_tag = pat_literal_value(ltext)
            if pat_node.payload == 1 as u32:  // negative literal pattern (`-5`)
                variant_tag = 0 as i64 - variant_tag
            @free(get_str_ptr(ltext))
        elif pat_node.kind == NODE_VARIANT_PAT:
            let vsi = pat_node.payload
            if vsi != 0 as u32:
                let vname = self.mb.symbols.symbols.data[vsi as i64].name_id
                self.find_variant_info(scrut_type, vname, &variant_tag, &payload_type)
            let arg = pat_node.first_child
            if arg != 0 as u32 and self.mb.tree.nodes.data[arg as i64].kind == NODE_BINDING_PAT:
                payload_bind_sym = self.mb.tree.nodes.data[arg as i64].payload
        elif pat_node.kind == NODE_BINDING_PAT:
            // Bare ident: it is a no-payload variant if its name matches one,
            // otherwise a catch-all binding of the whole scrutinee.
            let bsi = pat_node.payload
            mut bname := 0 as u32
            if bsi != 0 as u32:
                bname = self.mb.symbols.symbols.data[bsi as i64].name_id
            mut t := -1 as i64
            mut pt := 0 as u32
            if self.find_variant_info(scrut_type, bname, &t, &pt):
                variant_tag = t
            else:
                is_default = true
                bind_sym = bsi
        else:
            is_default = true

        if is_default:
            if bind_sym != 0 as u32:
                self.locals.local_map_put(bind_sym, scrut_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)
            done = true
        else:
            // A sum tag that never resolved stays at the -1 default; clamp it to 0 so the
            // ICONST split is well-formed. But an INT literal pattern may LEGITIMATELY be
            // negative (`match n: -5:` â€” RFC: negative match-arm literals), so never clamp
            // in the int case (positive int literals were never < 0 before this feature).
            if not is_int and variant_tag < 0 as i64:
                variant_tag = 0 as i64
            mut const_type := 4 as u32   // i64 tag (sum)
            if is_int:
                const_type = scrut_type  // compare in the scrutinee's own width/signedness
            let const_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_ICONST, type_id: const_type, dest: const_reg, src1: (variant_tag & (0xFFFFFFFF as i64)) as u32, src2: ((variant_tag >> (32 as i64)) & (0xFFFFFFFF as i64)) as u32))
            let cmp_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(opcode: OP_EQ, type_id: 11 as u32, dest: cmp_reg, src1: match_reg, src2: const_reg))

            let then_block = self.fb.new_block()
            let else_block = self.fb.new_block()
            self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: else_block, src1: cmp_reg, src2: then_block))
            let cur = self.fb.current_block()
            self.fb.add_edge(cur, then_block)
            self.fb.add_edge(cur, else_block)

            self.fb.switch_to(then_block)
            self.terminated = false
            if payload_bind_sym != 0 as u32:
                let pat_arg0 = pat_node.first_child
                mut is_mf := false
                if pat_arg0 != 0 as u32 and payload_type != 0 as u32 and (payload_type as i64) < self.mb.typetable.entries.len:
                    let pe2 = self.mb.typetable.entries.data[payload_type as i64]
                    if pe2.kind == TYPE_KIND_STRUCT and (pe2.flags & 1 as u16) != 0 as u16:
                        is_mf = true
                if is_mf:
                    // RFC 0019: multi-field variant â€” read the struct payload pointer from
                    // box field 1, then bind each pattern var to its struct field.
                    let struct_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: payload_type, dest: struct_reg, src1: scrut_reg, src2: 1 as u32))
                    let s_idx = self.mb.typetable.entries.data[payload_type as i64].extra
                    mut bp := pat_arg0
                    mut bfi := 0 as u32
                    while bp != 0 as u32:
                        if self.mb.tree.nodes.data[bp as i64].kind == NODE_BINDING_PAT:
                            let bsym = self.mb.tree.nodes.data[bp as i64].payload
                            mut fld_ty := 0 as u32
                            if (s_idx as i64) < self.mb.typetable.structs.len and (bfi as i64) < self.mb.typetable.structs.data[s_idx as i64].fields.len:
                                fld_ty = self.mb.typetable.structs.data[s_idx as i64].fields.data[bfi as i64].type_id
                            let f_reg = self.fb.fresh_reg()
                            self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: fld_ty, dest: f_reg, src1: struct_reg, src2: bfi))
                            if bsym != 0 as u32:
                                self.locals.local_map_put(bsym, f_reg)
                        bp = self.mb.tree.nodes.data[bp as i64].next_sibling
                        bfi = bfi + 1 as u32
                else:
                    // GENERIC_INST scrutinee (unannotated `let x = Wrap((a,b))` on a user
                    // generic sum): find_variant_info returned the template variant's
                    // generic param `T`, which reads a <=8B aggregate payload into a
                    // register where field1 is unaddressable (reads 0). The typechecker
                    // typed the pattern var concretely (subst_variant_payload_type); prefer
                    // that so the payload loads by-address. Mirror of the tagged-path fix.
                    mut lp_type := payload_type
                    mut lp_generic := false
                    if lp_type != 0 as u32 and (lp_type as i64) < self.mb.typetable.entries.len:
                        if self.mb.typetable.entries.data[lp_type as i64].kind == TYPE_KIND_GENERIC:
                            lp_generic = true
                    if (lp_type == 0 as u32 or lp_generic) and (payload_bind_sym as i64) < self.mb.symbols.symbols.len:
                        let lbt = self.mb.symbols.symbols.data[payload_bind_sym as i64].type_id
                        if lbt != 0 as u32 and (lbt as i64) < self.mb.typetable.entries.len and self.mb.typetable.entries.data[lbt as i64].kind != TYPE_KIND_GENERIC:
                            lp_type = lbt
                    let pl_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: lp_type, dest: pl_reg, src1: scrut_reg, src2: 1 as u32))
                    self.locals.local_map_put(payload_bind_sym, pl_reg)
            if body != 0 as u32:
                let bn = self.mb.tree.nodes.data[body as i64]
                if bn.kind == NODE_BLOCK:
                    self.lower_block(body)
                else:
                    self.lower_expr(body)
            if not self.terminated:
                self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
                self.fb.add_edge(self.fb.current_block(), merge_block)

            self.fb.switch_to(else_block)
            self.terminated = false
        arm = next_arm

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)
    self.fb.switch_to(merge_block)
    self.terminated = false

pub fn lower_stmt(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.terminated:
        return

    if node.kind == NODE_VAR_DECL:
        self.lower_var_decl(idx, node)
    elif node.kind == NODE_ASSIGN_STMT:
        self.lower_assign(idx, node)
    elif node.kind == NODE_RETURN_STMT:
        self.lower_return(idx, node)
    elif node.kind == NODE_IF_STMT:
        self.lower_if(idx, node)
    elif node.kind == NODE_WHILE_STMT:
        self.lower_while(idx, node)
    elif node.kind == NODE_MATCH_STMT:
        self.lower_match(idx, node)
    elif node.kind == NODE_FOR_STMT:
        self.lower_for(idx, node)
    elif node.kind == NODE_BLOCK:
        self.lower_block(idx)
    elif node.kind == NODE_DESTROY_STMT:
        self.lower_destroy(idx, node)
    elif node.kind == NODE_ALIAS_STMT:
        self.lower_alias_stmt(idx, node)
    elif node.kind == NODE_DEFER_STMT:
        self.lower_defer(idx, node)
    elif node.kind == NODE_BREAK_STMT:
        self.lower_break(idx, node)
    elif node.kind == NODE_CONTINUE_STMT:
        self.lower_continue(idx, node)
    elif node.kind == NODE_UNSAFE_BLOCK or node.kind == NODE_ARENA_BLOCK:
        // RFC 0006 (#38.5/#38.6): execute the inner block transparently. unsafe
        // (gen-check disable) and arena (alloc routing) semantics are deferred.
        if node.first_child != 0 as u32:
            self.lower_block(node.first_child)
    else:
        self.lower_expr(idx)

pub fn lower_break(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.loop_exits.len == 0 as i64:
        return
    let target = self.loop_exits.data[self.loop_exits.len - 1]
    self.fb.emit(AirInst(
        opcode: OP_JUMP,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: target,
        src2: 0 as u32,
    ))
    self.fb.add_edge(self.fb.current_block(), target)
    self.terminated = true

pub fn lower_continue(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if self.loop_conds.len == 0 as i64:
        return
    // BUG#89: `continue` jumps to the loop condition, bypassing the body-tail
    // increment. For a `for` loop, advance the counter inline first (same +1 the tail
    // emits) so it does not spin forever; a while-loop has incr_reg 0 and is skipped.
    if self.loop_incr_regs.len > 0 as i64:
        let incr_reg = self.loop_incr_regs.data[self.loop_incr_regs.len - 1]
        if incr_reg != 0 as u32:
            let incr_type = self.loop_incr_types.data[self.loop_incr_types.len - 1]
            // RFC 0020 P2b: a non-zero step reg (str codepoint width) advances the
            // counter variably; otherwise add a constant 1.
            mut step_reg := self.loop_incr_steps.data[self.loop_incr_steps.len - 1]
            if step_reg == 0 as u32:
                step_reg = self.fb.fresh_reg()
                self.fb.emit(AirInst(
                    opcode: OP_ICONST,
                    type_id: incr_type,
                    dest: step_reg,
                    src1: 1 as u32,
                    src2: 0 as u32,
                ))
            let nv_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_IADD,
                type_id: incr_type,
                dest: nv_reg,
                src1: incr_reg,
                src2: step_reg,
            ))
            self.fb.emit(AirInst(
                opcode: OP_COPY,
                type_id: incr_type,
                dest: incr_reg,
                src1: nv_reg,
                src2: 0 as u32,
            ))
    let target = self.loop_conds.data[self.loop_conds.len - 1]
    self.fb.emit(AirInst(
        opcode: OP_JUMP,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: target,
        src2: 0 as u32,
    ))
    self.fb.add_edge(self.fb.current_block(), target)
    self.terminated = true

pub fn lower_var_decl(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let name_id = node.payload
    mut type_id := 0 as u32

    mut init_reg := 0 as u32
    mut init_node_idx := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.mb.tree.nodes.data[child as i64]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_PTR_TYPE and cn.kind != NODE_SLICE_TYPE and cn.kind != NODE_ARRAY_TYPE and cn.kind != NODE_FUNC_TYPE and cn.kind != NODE_GENERIC_TYPE:
            init_reg = self.lower_expr(child)
            init_node_idx = child
        child = cn.next_sibling

    if init_reg != 0 as u32:
        mut src_reg := init_reg
        if node.flags & (FLAG_ESCAPES_TO_HEAP | FLAG_USES_ARENA | FLAG_IS_MOVED) != 0 as u16:
            src_reg = self.lower_ownership_aware(idx, node, init_reg)

        let reg = self.fb.fresh_reg()
        mut var_type_id := 0 as u32
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[node.payload as i64]
            if sym.type_id != 0 as u32:
                var_type_id = sym.type_id as u32

        // RFC 0029: `let s: Iface = <struct>` -> box the struct into an interface value.
        src_reg = self.coerce_struct_to_interface(var_type_id, init_node_idx, src_reg)

        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: var_type_id,
            dest: reg,
            src1: src_reg,
            src2: 0 as u32,
        ))
        self.locals.local_map_put(name_id, reg)
    else:
        // A declaration with no initializer. For a SCALAR, binding the name to a zero
        // constant is right: `mut x: i64` then `x = 7` works, and that behaviour is what
        // the language already promises.
        //
        // For an AGGREGATE it is not. An array or struct variable holds a POINTER to its
        // storage, so OP_ICONST bound the name to integer 0 -- a null pointer -- and the
        // first element or field store wrote through it. `mut arr: [i64; 2]` followed by
        // `arr[0] = 7` SEGFAULTED at every optimisation level, with no diagnostic: the
        // compiler exited 0 and emitted a binary that died. Same for `mut p: P` with a
        // struct type.
        //
        // Reserving the storage here makes aggregates behave the way scalars already do.
        // This is a consistency fix, not a semantic choice -- rejecting the form instead
        // would have contradicted the scalar case, which has always worked. Covering
        // struct, array AND tuple together on purpose: fixing only the array shape this
        // was reported from would repeat the partial-fix mistake recorded in
        // bug-f32-compare-float-literal, where a rule was added on one branch and its
        // sibling forgotten.
        //
        // Nothing changes for scalars: they take the same OP_ICONST path as before.
        mut decl_type := 0 as u32
        if node.payload != 0 as u32 and (node.payload as i64) < self.mb.symbols.symbols.len:
            let dsym = self.mb.symbols.symbols.data[node.payload as i64]
            if dsym.type_id != 0 as u32:
                decl_type = dsym.type_id as u32
        mut is_aggregate := false
        if decl_type != 0 as u32 and (decl_type as i64) < self.mb.typetable.entries.len:
            let dkind = self.mb.typetable.entries.data[decl_type as i64].kind
            is_aggregate = dkind == TYPE_KIND_STRUCT or dkind == TYPE_KIND_ARRAY or dkind == TYPE_KIND_TUPLE
        let reg = self.fb.fresh_reg()
        if is_aggregate:
            self.fb.emit(AirInst(
                opcode: OP_ALLOC,
                type_id: decl_type,
                dest: reg,
                src1: 0 as u32,
                src2: 0 as u32,
            ))
        else:
            self.fb.emit(AirInst(
                opcode: OP_ICONST,
                type_id: type_id,
                dest: reg,
                src1: 0 as u32,
                src2: 0 as u32,
            ))
        self.locals.local_map_put(name_id, reg)

// RFC 0006 (#38.1): lower the RHS value of an assignment, applying compound
// `op=` semantics. `a op= b` desugars to `a = a op b` â€” the lhs is re-read as an
// expression for its current value (simple lvalues; side-effecting bases are
// evaluated twice, acceptable for now). The op follows the lhs type: float ->
// OP_F*, unsigned div handled downstream by the selector. Plain `=` returns the
// rhs unchanged. (Was silently dropping the op so `a += b` ran as `a = b`.)
pub fn assign_value(mut self: ptr[FuncLowering], node: AstNode, lhs_idx: u32, rhs_idx: u32) -> u32:
    let rhs_reg = self.lower_expr(rhs_idx)
    let op_text = self.mb.get_token_text(node.token_idx)
    mut bop := OP_NOP
    if op_text == "+=":
        bop = OP_IADD
    elif op_text == "-=":
        bop = OP_ISUB
    elif op_text == "*=":
        bop = OP_IMUL
    elif op_text == "/=":
        bop = OP_IDIV
    elif op_text == "%=":
        bop = OP_IMOD
    @free(get_str_ptr(op_text))
    if bop == OP_NOP:
        return rhs_reg
    mut rty := 3 as u32
    if self.mb.node_types != null as ptr[u32] and self.mb.node_types[lhs_idx as i64] != 0 as u32:
        rty = self.mb.node_types[lhs_idx as i64] as u32
    if rty == 9 as u32 or rty == 10 as u32:
        if bop == OP_IADD:
            bop = OP_FADD
        elif bop == OP_ISUB:
            bop = OP_FSUB
        elif bop == OP_IMUL:
            bop = OP_FMUL
        elif bop == OP_IDIV:
            bop = OP_FDIV
    let cur_reg = self.lower_expr(lhs_idx)
    let comb = self.fb.fresh_reg()
    self.fb.emit(AirInst(opcode: bop, type_id: rty, dest: comb, src1: cur_reg, src2: rhs_reg))
    return comb

pub fn lower_assign(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let lhs_idx = node.first_child
    if lhs_idx == 0 as u32:
        return
    let lhs_node = self.mb.tree.nodes.data[lhs_idx as i64]

    if lhs_node.kind == NODE_FIELD_EXPR:
        let obj_idx = lhs_node.first_child
        let obj_reg = self.lower_expr(obj_idx)
        let field_idx = lhs_node.extra_idx

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        mut val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let obj_type = self.mb.node_types[obj_idx as i64]
        if obj_type != 0 as u32 and (obj_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[obj_type as i64]
            if entry.kind == TYPE_KIND_POINTER:
                type_id = entry.extra as u32
            else:
                type_id = obj_type as u32

        // RFC 0029: `obj.field = <struct>` where the field is interface-typed boxes it.
        if (type_id as i64) < self.mb.typetable.entries.len:
            let ste = self.mb.typetable.entries.data[type_id as i64]
            if ste.kind == TYPE_KIND_STRUCT and (ste.extra as i64) < self.mb.typetable.structs.len:
                val_reg = self.coerce_field_to_interface(ste.extra as i64, field_idx, rhs_idx, val_reg)

        self.fb.emit(AirInst(
            opcode: OP_SET_FIELD,
            type_id: type_id,
            dest: val_reg,
            src1: obj_reg,
            src2: field_idx,
        ))
        return

    elif lhs_node.kind == NODE_INDEX_EXPR:
        let arr_idx = lhs_node.first_child
        mut arr_reg = self.lower_expr(arr_idx)
        let index_idx = self.mb.tree.nodes.data[arr_idx as i64].next_sibling
        mut index_reg := 0 as u32
        if index_idx != 0 as u32:
            index_reg = self.lower_expr(index_idx)

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        mut val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let arr_type = self.mb.node_types[arr_idx as i64]
        if arr_type != 0 as u32 and (arr_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[arr_type as i64]
            if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_SLICE or entry.kind == TYPE_KIND_ARRAY:
                type_id = entry.extra as u32
            elif (entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(entry.name_id)) == "Vec":
                // RFC 0021: `v[i] = x` stores into `vec.data[i]`. Load the `data`
                // pointer field first (mirror of the read-side data-load in
                // lower_index_expr); without it OP_STORE would write into the
                // {data,len,cap} HEADER (a silent miscompile -- the element type
                // typing of a Vec index-expr made `v[i] = x` accepted but the store
                // went to the header, so `v.get(i)` still saw the old value). Element
                // type from the index-expr node (typecheck set it to T).
                let data_nid = self.mb.pool.intern("data")
                mut vd_idx := 0 as u32
                let vd_type = fl_resolve_field(self, arr_type, data_nid, &vd_idx)
                if vd_type != 0 as u32:
                    let data_reg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: vd_type, dest: data_reg, src1: arr_reg, src2: vd_idx))
                    arr_reg = data_reg
                type_id = self.mb.node_types[lhs_idx as i64]

        // RFC 0029: `arr[i] = <struct>` where the element type is an interface must
        // box, exactly as `obj.field = <struct>` does above. The NODE_FIELD_EXPR
        // branch had the coercion; this indexed-store branch did not, so a
        // `[Shape;2]` element assigned a concrete struct stored raw and the next
        // `arr[i].area()` dispatched on struct bytes -> SIGSEGV. type_id is the
        // element type here (array `entry.extra`, or the index-expr node type for
        // Vec), which is the interface target; the coerce is a no-op otherwise.
        val_reg = self.coerce_struct_to_interface(type_id, rhs_idx, val_reg)

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: type_id,
            dest: arr_reg,
            src1: val_reg,
            src2: index_reg,
        ))
        return

    elif lhs_node.kind == NODE_DEREF_EXPR:
        let ptr_idx = lhs_node.first_child
        let ptr_reg = self.lower_expr(ptr_idx)

        let rhs_idx = lhs_node.next_sibling
        if rhs_idx == 0 as u32:
            return
        let val_reg = self.assign_value(node, lhs_idx, rhs_idx)

        mut type_id := 0 as u32
        let ptr_type = self.mb.node_types[ptr_idx as i64]
        if ptr_type != 0 as u32 and (ptr_type as i64) < self.mb.typetable.entries.len:
            let entry = self.mb.typetable.entries.data[ptr_type as i64]
            if entry.kind == TYPE_KIND_POINTER:
                type_id = entry.extra as u32

        self.fb.emit(AirInst(
            opcode: OP_STORE,
            type_id: type_id,
            dest: ptr_reg,
            src1: val_reg,
            src2: 0 as u32,
        ))
        return

    mut name_id := lhs_node.payload
    if name_id == 0 as u32:
        let text = self.mb.get_token_text(lhs_node.token_idx)
        name_id = self.mb.pool.intern(text)
        @free(get_str_ptr(text))

    let rhs_idx = lhs_node.next_sibling
    if rhs_idx == 0 as u32:
        return
    let rhs_node = self.mb.tree.nodes.data[rhs_idx as i64]
    mut val_reg = self.assign_value(node, lhs_idx, rhs_idx)

    mut type_id := 3 as u32 // default i32
    if lhs_node.payload != 0 as u32 and (lhs_node.payload as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[lhs_node.payload as i64]
        if sym.type_id != 0 as u32:
            type_id = sym.type_id as u32

    // RFC 0029: `s = <struct>` where `s` is interface-typed boxes the struct into an
    // interface value (else the raw struct bytes are stored and dispatch reads garbage).
    val_reg = self.coerce_struct_to_interface(type_id, rhs_idx, val_reg)

    // RFC 0017 / BUG#82: assigning to a module-level global writes its static storage
    // (OP_GLOBAL_ADDR + OP_STORE), not a per-function vreg â€” so the value persists
    // across calls and read-modify-write is correct.
    if lhs_node.payload != 0 as u32 and (lhs_node.payload as i64) < self.mb.symbols.symbols.len:
        if self.mb.symbols.symbols.data[lhs_node.payload as i64].kind == SYM_VAR and self.mb.builder_global_index(lhs_node.payload) != -1 as i64:
            self.lower_global_write(lhs_node.payload, type_id, val_reg)
            return

    let existing_reg = self.locals.local_map_get(name_id)
    if existing_reg != 0 as u32:
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: type_id,
            dest: existing_reg,
            src1: val_reg,
            src2: 0 as u32,
        ))
    else:
        self.locals.local_map_put(name_id, val_reg)

pub fn lower_return(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    mut ret_val := 0 as u32
    let fc = node.first_child
    // `fc` is the return VALUE, unless it is a NODE_DESTROY_STMT -- which happens for a
    // VOID `return` that CTGC appended return-path frees to (RFC 0015 P3). Only lower a
    // value when fc is a real value node.
    mut has_val := false
    if fc != 0 as u32:
        if self.mb.tree.nodes.data[fc as i64].kind != NODE_DESTROY_STMT:
            has_val = true
    if has_val:
        ret_val = self.lower_expr(fc)
        // RFC 0029: `return <struct>` from a fn declared `-> Iface` boxes the struct.
        ret_val = self.coerce_struct_to_interface(self.fb.ret_type, fc, ret_val)

    // RFC 0015 P3 return-path free: CTGC appended NODE_DESTROY_STMT nodes as TRAILING
    // children of this return for every freeable local live on this path. Lower them
    // AFTER the return value is materialised (so `return r.field` reads `r` before it is
    // freed -- no UAF) and BEFORE flush_defers, matching the fall-through ordering (a
    // block's destroys run before the function-tail defers). No-op when -no-ctgc-free
    // (nothing appended) or when nothing is freeable (self-host set = 0).
    mut sib := fc
    if has_val:
        sib = self.mb.tree.nodes.data[fc as i64].next_sibling
    while sib != 0 as u32:
        let snode = self.mb.tree.nodes.data[sib as i64]
        let nsib = snode.next_sibling
        if snode.kind == NODE_DESTROY_STMT:
            self.lower_destroy(sib, snode)
        sib = nsib

    // RFC 0006 (#38.4): run deferred expressions (LIFO) after the return value
    // is computed but before transferring control, on every return path.
    self.flush_defers()

    self.fb.emit(AirInst(
        opcode: OP_RETURN,
        type_id: 0 as u32,
        dest: 0 as u32,
        src1: ret_val,
        src2: 0 as u32,
    ))
    self.terminated = true

pub fn lower_if(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let merge_block = self.fb.new_block()

    let cond_node_idx = node.first_child
    if cond_node_idx == 0 as u32:
        return
    let cond_node = self.mb.tree.nodes.data[cond_node_idx as i64]

    let body_node_idx = cond_node.next_sibling
    if body_node_idx == 0 as u32:
        return
    let body_node = self.mb.tree.nodes.data[body_node_idx as i64]

    let next_clause_idx = body_node.next_sibling

    // RFC 0028 Â§7e (opt-in `-jumptable`): a >=8-value `if x == C: â€¦ elif x == C2: â€¦` chain over
    // one integer variable lowers to the balanced O(log N) compare tree instead of the linear
    // chain. Falls back to `lower_if_chain` on any shape it cannot prove equivalent.
    if self.mb.jumptable_enabled:
        if self.try_lower_if_chain_bsearch(cond_node_idx, body_node_idx, next_clause_idx, merge_block):
            self.fb.switch_to(merge_block)
            self.terminated = false
            return

    self.lower_if_chain(cond_node_idx, cond_node, body_node_idx, body_node, next_clause_idx, merge_block)

    // Merge block
    self.fb.switch_to(merge_block)
    self.terminated = false

pub fn lower_if_chain(mut self: ptr[FuncLowering], cond_idx: u32, cond_node: AstNode, body_idx: u32, body_node: AstNode, next_clause_idx: u32, merge_block: u32):
    let then_block = self.fb.new_block()
    let else_block = self.fb.new_block()

    // Lower condition
    let cond_reg = self.lower_expr(cond_idx)

    // Branch
    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: else_block,
        src1: cond_reg,
        src2: then_block,
    ))
    let cur_block = self.fb.current_block()
    self.fb.add_edge(cur_block, then_block)
    self.fb.add_edge(cur_block, else_block)

    // Then block
    self.fb.switch_to(then_block)
    self.terminated = false
    if body_node.kind == NODE_BLOCK:
        self.lower_block(body_idx)
    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)

    // Else block
    self.fb.switch_to(else_block)
    self.terminated = false
    mut delegated := false
    if next_clause_idx != 0 as u32:
        let cn = self.mb.tree.nodes.data[next_clause_idx as i64]
        if cn.kind == NODE_ELSE_CLAUSE:
            let else_body_idx = cn.first_child
            if else_body_idx != 0 as u32:
                let else_body_node = self.mb.tree.nodes.data[else_body_idx as i64]
                if else_body_node.kind == NODE_BLOCK:
                    self.lower_block(else_body_idx)
        elif cn.kind == NODE_ELIF_CLAUSE:
            let elif_cond_idx = cn.first_child
            if elif_cond_idx != 0 as u32:
                let elif_cond_node = self.mb.tree.nodes.data[elif_cond_idx as i64]
                let elif_body_idx = elif_cond_node.next_sibling
                if elif_body_idx != 0 as u32:
                    let elif_body_node = self.mb.tree.nodes.data[elif_body_idx as i64]
                    self.lower_if_chain(elif_cond_idx, elif_cond_node, elif_body_idx, elif_body_node, cn.next_sibling, merge_block)
                    delegated = true

    if not self.terminated and not delegated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: merge_block, src2: 0 as u32))
        self.fb.add_edge(self.fb.current_block(), merge_block)

pub fn lower_while(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()

    self.loop_conds.push(cond_block)
    self.loop_exits.push(exit_block)
    // BUG#89: a while-loop has no loop increment â€” `continue` jumps straight to cond.
    // Push reg 0 so lower_continue emits no increment (keeps stacks parallel).
    self.loop_incr_regs.push(0 as u32)
    self.loop_incr_types.push(0 as u32)
    self.loop_incr_steps.push(0 as u32)

    let cur_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(cur_block, cond_block)

    // Condition
    self.fb.switch_to(cond_block)
    self.terminated = false
    let child = node.first_child
    if child == 0 as u32:
        self.loop_conds.pop()
        self.loop_exits.pop()
        self.loop_incr_regs.pop()
        self.loop_incr_types.pop()
        self.loop_incr_steps.pop()
        return
    let cn = self.mb.tree.nodes.data[child as i64]
    let cond_reg = self.lower_expr(child)

    // BUG#86: lowering the condition may itself create blocks (short-circuit
    // `and`/`or` builds a diamond), so the block that actually holds the OP_BRANCH
    // is the *current* block, not `cond_block`. Attribute the CFG edges to it â€”
    // otherwise the merge block has no recorded successor to the exit and
    // remove_unreachable_blocks() wrongly NOPs the exit's `ret` (infinite loop at
    // -O1). lower_if_chain already does this; while must match.
    let branch_block = self.fb.current_block()
    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: exit_block,
        src1: cond_reg,
        src2: body_block,
    ))
    self.fb.add_edge(branch_block, body_block)
    self.fb.add_edge(branch_block, exit_block)

    // Body
    self.fb.switch_to(body_block)
    self.terminated = false
    let body_child = cn.next_sibling
    if body_child != 0 as u32:
        let bcn = self.mb.tree.nodes.data[body_child as i64]
        if bcn.kind == NODE_BLOCK:
            self.lower_block(body_child)

    if not self.terminated:
        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
        self.fb.add_edge(body_block, cond_block)

    // Exit
    self.fb.switch_to(exit_block)
    self.terminated = false

    self.loop_conds.pop()
    self.loop_exits.pop()
    self.loop_incr_regs.pop()
    self.loop_incr_types.pop()
    self.loop_incr_steps.pop()

// RFC 0018 P2: resolve the underlying struct of a STRUCT/GENERIC_INST type and
// return the type_id of the field whose name interns to `field_name_id`, writing its
// field index to *out_idx. Returns 0 if not resolvable. Mirrors the typecheck field
// resolution (generic-inst base-name match) so indices agree with OP_GET_FIELD.
fn fl_resolve_field(self: ptr[FuncLowering], type_id: u32, field_name_id: u32, out_idx: ptr[u32]) -> u32:
    if (type_id as i64) >= self.mb.typetable.entries.len:
        return 0 as u32
    let entry = self.mb.typetable.entries.data[type_id as i64]
    mut struct_extra := entry.extra
    mut is_struct := false
    if entry.kind == TYPE_KIND_STRUCT:
        is_struct = true
    elif entry.kind == TYPE_KIND_GENERIC_INST:
        let entry_base = extract_qualified_base_name(self.mb.pool.get(entry.name_id))
        mut i := 0 as i64
        while i < self.mb.typetable.entries.len:
            let e = self.mb.typetable.entries.data[i]
            if e.kind == TYPE_KIND_STRUCT:
                let e_base = extract_qualified_base_name(self.mb.pool.get(e.name_id))
                if e_base == entry_base:
                    struct_extra = e.extra
                    is_struct = true
                    break
            i = i + 1
    if not is_struct or (struct_extra as i64) >= self.mb.typetable.structs.len:
        return 0 as u32
    let si = &self.mb.typetable.structs.data[struct_extra as i64]
    mut j := 0 as i64
    while j < si.fields.len:
        if si.fields.data[j].name_id == field_name_id:
            out_idx.* = j as u32
            return si.fields.data[j].type_id
        j = j + 1
    return 0 as u32

pub fn lower_for(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    let cond_block = self.fb.new_block()
    let body_block = self.fb.new_block()
    let exit_block = self.fb.new_block()

    self.loop_conds.push(cond_block)
    self.loop_exits.push(exit_block)

    let sym_idx = node.payload
    // BUG#87: the loop variable must be keyed in local_map by its SYMBOL INDEX
    // (node.payload), because that is the key lower_ident uses to read it
    // (`local_map_get(sym_idx)`) â€” exactly like a `let`/`mut` var-decl (which keys by
    // node.payload too). Keying by `sym.name_id` here stored it under a different key,
    // so every body reference to the loop variable missed the map and read 0/garbage
    // (the loop still ran the right count since lower_for's own get/put were mutually
    // consistent). name_id below IS the symbol index despite the name.
    mut name_id := sym_idx
    mut type_id := 3 as u32 // default i32

    if sym_idx != 0 as u32 and (sym_idx as i64) < self.mb.symbols.symbols.len:
        let sym = self.mb.symbols.symbols.data[sym_idx as i64]
        if sym.type_id != 0 as u32:
            type_id = sym.type_id as u32

    let range_expr_idx = node.first_child
    mut start_reg := 0 as u32
    mut limit_reg := 0 as u32
    mut is_range := false
    // RFC 0018 P1: `for x in <fixed-array>` element iteration state.
    mut is_collection := false
    mut coll_reg := 0 as u32
    mut elem_type := 0 as u32
    mut coll_len := 0 as u32
    // RFC 0018 P2: `for x in vec` (Vec[T]) state. Unlike a fixed array the length is a
    // RUNTIME field (vec.len) and the elements live behind the vec.data pointer, so we
    // load both fields instead of using a compile-time bound / direct OP_INDEX.
    mut is_vec := false
    mut vec_data_idx := 0 as u32
    mut vec_data_type := 0 as u32
    mut vec_len_idx := 0 as u32
    // RFC 0020 P2: `for b in bytes` â€” like an array (direct OP_INDEX on the value,
    // which yields the u8 byte) but with a RUNTIME bound (bytes.len, field 1).
    mut is_bytes := false
    // RFC 0020 P2b: `for c in str` â€” UTF-8 codepoint iteration. The counter is a BYTE
    // offset; each iteration calls std.string.utf8_decode(s, off) -> packed
    // (width<<32)|codepoint, binds the loop var (rune) to the codepoint, and advances
    // the offset by the variable width (str_width_reg).
    mut is_string := false
    mut str_decode_sym := 0 as u32
    mut str_width_reg := 0 as u32
    // RFC 0018 P2 (HashMap): `for k in m` walks the open-addressed table slots
    // 0..cap and yields the KEY of every OCCUPIED slot. HashMap layout is parallel
    // arrays {keys, values, hashes, occupied, size, cap}; the loop is a plain
    // 0..cap index loop whose body is GUARDED by `occupied[i]` (the increment runs
    // for every slot, only the user body runs when occupied). Field indices are
    // resolved by name (order-independent).
    mut is_hashmap := false
    mut hm_keys_idx := 0 as u32
    mut hm_keys_type := 0 as u32 // type of `keys` field (ptr[K])
    mut hm_occ_idx := 0 as u32
    mut hm_occ_type := 0 as u32 // type of `occupied` field (ptr[bool])
    mut hm_occ_elem := 11 as u32 // pointee of `occupied` (bool)
    mut hm_cap_idx := 0 as u32
    mut hm_keep_block := 0 as u32 // body-runs block (slot occupied)
    mut hm_cont_block := 0 as u32 // per-slot continue/increment block
    // Type of the numeric counter driving the loop: for a range/integer-bound loop
    // the counter IS the loop variable (its type); for a collection loop the counter
    // is an internal i32 index (the loop variable holds the element instead).
    mut counter_type := type_id

    if range_expr_idx != 0 as u32:
        let range_node = self.mb.tree.nodes.data[range_expr_idx as i64]
        if range_node.kind == NODE_BINARY_EXPR:
            let op_text = self.mb.get_token_text(range_node.token_idx)
            if op_text == "..":
                is_range = true
                let start_node_idx = range_node.first_child
                if start_node_idx != 0 as u32:
                    start_reg = self.lower_expr(start_node_idx)
                    let start_node = self.mb.tree.nodes.data[start_node_idx as i64]
                    let end_node_idx = start_node.next_sibling
                    if end_node_idx != 0 as u32:
                        limit_reg = self.lower_expr(end_node_idx)
            @free(get_str_ptr(op_text))

    // RFC 0018 P1: detect a fixed-array iteree. node_types holds the iteree's type;
    // a TYPE_KIND_ARRAY carries compile-time length in name_id and element type in
    // extra. (An integer-bound `for i in n` has a numeric type here and stays on the
    // 0..n counter path below.) Typecheck rejects Vec/HashMap/struct/sum (P2).
    if not is_range and range_expr_idx != 0 as u32 and self.mb.node_types != null as ptr[u32]:
        let coll_ty = self.mb.node_types[range_expr_idx as i64] as u32
        if coll_ty != 0 as u32 and (coll_ty as i64) < self.mb.typetable.entries.len:
            let coll_kind = self.mb.typetable.entries.data[coll_ty as i64].kind
            if coll_kind == TYPE_KIND_ARRAY:
                is_collection = true
                elem_type = self.mb.typetable.entries.data[coll_ty as i64].extra
                coll_len = self.mb.typetable.entries.data[coll_ty as i64].name_id
                counter_type = 3 as u32 // i32 index counter
            elif (coll_kind == TYPE_KIND_GENERIC_INST or coll_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(self.mb.typetable.entries.data[coll_ty as i64].name_id)) == "Vec":
                // RFC 0018 P2: iterate a Vec[T] by loading vec.len (bound) and indexing
                // vec.data. The loop variable's type (type_id) is the element type T,
                // bound by typecheck. Counter is i64 to match the i64 len field.
                let data_nid = self.mb.pool.intern("data")
                let len_nid = self.mb.pool.intern("len")
                vec_data_type = fl_resolve_field(self, coll_ty, data_nid, &vec_data_idx)
                let len_ty = fl_resolve_field(self, coll_ty, len_nid, &vec_len_idx)
                if vec_data_type != 0 as u32 and len_ty != 0 as u32:
                    is_collection = true
                    is_vec = true
                    elem_type = type_id // loop var type == element type T
                    counter_type = 4 as u32 // i64 index counter (matches vec.len)
            elif coll_ty == TYPE_BYTES:
                // RFC 0020 P2: bytes shares str's {ptr@0, len@1} repr; OP_INDEX on the
                // value yields a u8 (proven by `b[i]`), so iterate like an array with a
                // runtime bound = bytes.len (field 1).
                is_collection = true
                is_bytes = true
                elem_type = 5 as u32 // u8
                counter_type = 4 as u32 // i64 index counter (matches the i64 len field)
                vec_len_idx = 1 as u32 // len is field 1 in the {ptr,len} layout
            elif coll_ty == TYPE_STRING:
                // RFC 0020 P2b: iterate UTF-8 codepoints. Resolve the decode helper via
                // the same symbol path the `str + str` -> concat overload uses (a direct
                // `string.utf8_decode(..)` call currently miscompiles for str args).
                let dsym = self.resolve_op_method("utf8_decode", TYPE_STRING, 4 as u32)
                if dsym != 0 as u32:
                    is_collection = true
                    is_string = true
                    str_decode_sym = dsym
                    elem_type = 7 as u32 // rune (u32 codepoint)
                    counter_type = 4 as u32 // i64 byte offset
                    vec_len_idx = 1 as u32 // str.len (byte length) is field 1
                    str_width_reg = self.fb.fresh_reg()
            elif (coll_kind == TYPE_KIND_GENERIC_INST or coll_kind == TYPE_KIND_STRUCT) and extract_base_type_name(self.mb.pool.get(self.mb.typetable.entries.data[coll_ty as i64].name_id)) == "HashMap":
                // RFC 0018 P2 (HashMap): `for k in m` yields each occupied KEY. Resolve
                // the parallel-array field indices by name (keys/occupied/cap) so the
                // slot walk is layout-order-independent. Element (key) type is the loop
                // var type bound by typecheck (HashMap[K,V] generic arg 0).
                let keys_nid = self.mb.pool.intern("keys")
                let occ_nid = self.mb.pool.intern("occupied")
                let cap_nid = self.mb.pool.intern("cap")
                let keys_ty = fl_resolve_field(self, coll_ty, keys_nid, &hm_keys_idx)
                let occ_ty = fl_resolve_field(self, coll_ty, occ_nid, &hm_occ_idx)
                let cap_ty = fl_resolve_field(self, coll_ty, cap_nid, &hm_cap_idx)
                if keys_ty != 0 as u32 and occ_ty != 0 as u32 and cap_ty != 0 as u32:
                    is_collection = true
                    is_hashmap = true
                    hm_keys_type = keys_ty
                    hm_occ_type = occ_ty
                    elem_type = type_id // loop var type == key type K
                    counter_type = 4 as u32 // i64 slot index (matches cap)
                    // pointee of `occupied` (ptr[bool]) for the OP_INDEX element type.
                    if (occ_ty as i64) < self.mb.typetable.entries.len:
                        let oe = self.mb.typetable.entries.data[occ_ty as i64]
                        if oe.kind == TYPE_KIND_POINTER:
                            hm_occ_elem = oe.extra

    let iter_reg = self.fb.fresh_reg()
    if is_range:
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: type_id,
            dest: iter_reg,
            src1: start_reg,
            src2: 0 as u32,
        ))
    elif is_collection:
        // Evaluate the collection base once; iter_reg is the internal 0-based index.
        coll_reg = self.lower_expr(range_expr_idx)
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: counter_type,
            dest: iter_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        limit_reg = self.fb.fresh_reg()
        if is_hashmap:
            // HashMap slot walk: the bound is the table capacity (cap field).
            self.fb.emit(AirInst(
                opcode: OP_GET_FIELD,
                type_id: 4 as u32, // i64
                dest: limit_reg,
                src1: coll_reg,
                src2: hm_cap_idx,
            ))
        elif is_vec or is_bytes or is_string:
            // Runtime bound: load the len (i64) field once before the loop
            // (Vec.len / bytes.len / str.len byte length, all at vec_len_idx).
            self.fb.emit(AirInst(
                opcode: OP_GET_FIELD,
                type_id: 4 as u32, // i64
                dest: limit_reg,
                src1: coll_reg,
                src2: vec_len_idx,
            ))
        else:
            self.fb.emit(AirInst(
                opcode: OP_ICONST,
                type_id: counter_type,
                dest: limit_reg,
                src1: coll_len,
                src2: 0 as u32,
            ))
    else:
        self.fb.emit(AirInst(
            opcode: OP_ICONST,
            type_id: type_id,
            dest: iter_reg,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        if range_expr_idx != 0 as u32:
            limit_reg = self.lower_expr(range_expr_idx)

    // For a collection loop the loop variable is bound in the body (to arr[i]); the
    // counter register iter_reg must NOT shadow it.
    if not is_collection:
        self.locals.local_map_put(name_id, iter_reg)

    // BUG#89: record the counter (iter_reg) + its type so `continue` can advance it
    // inline before jumping to cond (the body-tail increment only runs on fall-through).
    self.loop_incr_regs.push(iter_reg)
    self.loop_incr_types.push(counter_type)
    // str: advance by the codepoint width (str_width_reg); others: 0 => default +1.
    self.loop_incr_steps.push(str_width_reg)

    let cur_block = self.fb.current_block()
    self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
    self.fb.add_edge(cur_block, cond_block)

    // Condition
    self.fb.switch_to(cond_block)
    self.terminated = false

    let cmp_reg = self.fb.fresh_reg()
    // Range/integer-bound: counter is the loop var (local_map). Collection: counter is
    // the internal iter_reg. (For a range, local_map_get(name_id) == iter_reg, so the
    // emitted OP_LT is byte-identical to before.)
    mut current_iter := iter_reg
    if not is_collection:
        current_iter = self.locals.local_map_get(name_id)
    self.fb.emit(AirInst(
        opcode: OP_LT,
        type_id: 11 as u32, // bool
        dest: cmp_reg,
        src1: current_iter,
        src2: limit_reg,
    ))

    self.fb.emit(AirInst(
        opcode: OP_BRANCH,
        type_id: 0 as u32,
        dest: exit_block,
        src1: cmp_reg,
        src2: body_block,
    ))
    self.fb.add_edge(cond_block, body_block)
    self.fb.add_edge(cond_block, exit_block)

    // Body
    self.fb.switch_to(body_block)
    self.terminated = false

    // RFC 0018 P1: at the top of each iteration bind the loop variable to arr[i].
    // The loop var maps directly to this OP_INDEX result (no OP_COPY), which handles
    // scalar elements by-value and aggregate elements by-address (RFC 0001 Â§5).
    if is_collection and is_hashmap:
        // RFC 0018 P2 (HashMap): guard the body by `occupied[iter]`. Load the bool;
        // if the slot is empty branch straight to the per-slot continue block (which
        // increments and re-tests cond) so the user body never sees a stale key. When
        // occupied, bind the loop var to `keys[iter]` and fall into the body.
        let occ_ptr_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: hm_occ_type, dest: occ_ptr_reg, src1: coll_reg, src2: hm_occ_idx))
        let occ_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_INDEX, type_id: hm_occ_elem, dest: occ_reg, src1: occ_ptr_reg, src2: iter_reg))
        hm_keep_block = self.fb.new_block()
        hm_cont_block = self.fb.new_block()
        // OP_BRANCH: cond true -> src2 (keep), false -> dest (cont).
        self.fb.emit(AirInst(opcode: OP_BRANCH, type_id: 0 as u32, dest: hm_cont_block, src1: occ_reg, src2: hm_keep_block))
        self.fb.add_edge(body_block, hm_keep_block)
        self.fb.add_edge(body_block, hm_cont_block)
        self.fb.switch_to(hm_keep_block)
        self.terminated = false
        let keys_ptr_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_GET_FIELD, type_id: hm_keys_type, dest: keys_ptr_reg, src1: coll_reg, src2: hm_keys_idx))
        let key_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_INDEX, type_id: elem_type, dest: key_reg, src1: keys_ptr_reg, src2: iter_reg))
        self.locals.local_map_put(name_id, key_reg)
    elif is_collection and is_string:
        // RFC 0020 P2b: decode the UTF-8 codepoint at the current byte offset via
        // std.string.utf8_decode(s, off) -> packed (width<<32)|codepoint. Bind the
        // loop var (rune) to the low 32 bits; stash the width (high 32) for the
        // variable increment.
        let arg_start = self.fb.emit_extra(2 as u32)
        self.fb.emit_extra(coll_reg)
        self.fb.emit_extra(iter_reg)
        let packed_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_CALL, type_id: str_decode_sym, dest: packed_reg, src1: 0 as u32, src2: arg_start))
        // codepoint = packed & 0xFFFFFFFF
        let mask_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: mask_reg, src1: 0xFFFFFFFF as u32, src2: 0 as u32))
        let cp_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_AND, type_id: 4 as u32, dest: cp_reg, src1: packed_reg, src2: mask_reg))
        // width = packed >> 32 (logical) -> str_width_reg (used by the increment)
        let sh_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(opcode: OP_ICONST, type_id: 4 as u32, dest: sh_reg, src1: 32 as u32, src2: 0 as u32))
        self.fb.emit(AirInst(opcode: OP_SHR, type_id: 4 as u32, dest: str_width_reg, src1: packed_reg, src2: sh_reg))
        self.locals.local_map_put(name_id, cp_reg)
    elif is_collection:
        // The array/Vec base to index: for a fixed array the collection reg IS the
        // element base; for a Vec the elements live behind the vec.data pointer, so
        // load that field first (per-iteration â€” cheap, and keeps coll_reg as the
        // struct for the len already read above).
        mut index_base := coll_reg
        if is_vec:
            let data_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_GET_FIELD,
                type_id: vec_data_type,
                dest: data_reg,
                src1: coll_reg,
                src2: vec_data_idx,
            ))
            index_base = data_reg
        let elem_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_INDEX,
            type_id: elem_type,
            dest: elem_reg,
            src1: index_base,
            src2: iter_reg,
        ))
        self.locals.local_map_put(name_id, elem_reg)

    if range_expr_idx != 0 as u32:
        let range_node = self.mb.tree.nodes.data[range_expr_idx as i64]
        let body_node_idx = range_node.next_sibling
        if body_node_idx != 0 as u32:
            let body_node = self.mb.tree.nodes.data[body_node_idx as i64]
            if body_node.kind == NODE_BLOCK:
                self.lower_block(body_node_idx)

    // RFC 0018 P2 (HashMap): merge the occupied (post-body) path and the empty-slot
    // path into the per-slot continue block, then let the shared increment below run
    // there (advance the slot index and re-test cond). Both edges feed hm_cont_block.
    if is_hashmap:
        if not self.terminated:
            self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: hm_cont_block, src2: 0 as u32))
            self.fb.add_edge(self.fb.current_block(), hm_cont_block)
        self.fb.switch_to(hm_cont_block)
        self.terminated = false

    if not self.terminated:
        // Step amount: for `for c in str` advance by the codepoint width; otherwise +1.
        mut step_reg := str_width_reg
        if not is_string:
            step_reg = self.fb.fresh_reg()
            self.fb.emit(AirInst(
                opcode: OP_ICONST,
                type_id: counter_type,
                dest: step_reg,
                src1: 1 as u32,
                src2: 0 as u32,
            ))
        mut current_iter2 := iter_reg
        if not is_collection:
            current_iter2 = self.locals.local_map_get(name_id)
        let new_val_reg = self.fb.fresh_reg()
        self.fb.emit(AirInst(
            opcode: OP_IADD,
            type_id: counter_type,
            dest: new_val_reg,
            src1: current_iter2,
            src2: step_reg,
        ))
        self.fb.emit(AirInst(
            opcode: OP_COPY,
            type_id: counter_type,
            dest: current_iter2,
            src1: new_val_reg,
            src2: 0 as u32,
        ))

        self.fb.emit(AirInst(opcode: OP_JUMP, type_id: 0 as u32, dest: 0 as u32, src1: cond_block, src2: 0 as u32))
        // HashMap runs the increment in hm_cont_block; every other loop in body_block.
        mut incr_src := body_block
        if is_hashmap:
            incr_src = hm_cont_block
        self.fb.add_edge(incr_src, cond_block)

    // Exit
    self.fb.switch_to(exit_block)
    self.terminated = false

    self.loop_conds.pop()
    self.loop_exits.pop()
    self.loop_incr_regs.pop()
    self.loop_incr_types.pop()
    self.loop_incr_steps.pop()

pub fn lower_destroy(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        let val_reg = self.lower_expr(node.first_child)
        self.fb.emit(AirInst(
            opcode: OP_DESTROY,
            type_id: 0 as u32,
            dest: 0 as u32,
            src1: val_reg,
            src2: 0 as u32,
        ))
    else:
        let sym_id = node.payload
        if sym_id != 0 as u32 and (sym_id as i64) < self.mb.symbols.symbols.len:
            let sym = self.mb.symbols.symbols.data[sym_id as i64]
            // local_map is keyed by the VAR_DECL's node.payload (= sym_idx), see
            // lower_var_decl -- NOT by sym.name_id. The old `local_map_get(sym.name_id)`
            // never matched (name intern id != sym index), so every CTGC OP_DESTROY was
            // silently dropped (reg=0) and nothing was ever freed. (BUG#87 class.)
            let reg = self.locals.local_map_get(sym_id)
            if reg != 0 as u32:
                // RFC 0014 (drop-glue): free is emitted ONLY for a local whose type
                // declares `drop(self)`. We call drop(self) first (so it can read the
                // fields it owns) THEN OP_DESTROY frees the block.
                //
                // Why gate the free on `drop`: RFC 0015's GENERAL free of every
                // non-escaping owned local is not yet SOUND on the self-host compiler
                // (RFC 0010 Â§9: the compiler pervasively aliases into buffers it later
                // reuses; the escape analysis still misses some of those, so freeing a
                // compiler local UAF-crashes a `-ctgc-free` self-build). `drop`-typed
                // types are user-declared and simple, so freeing exactly them is sound
                // (validated on a corpus). The compiler declares no `drop`, so nothing
                // is freed there -> `-ctgc-free` self-build is byte-identical/safe.
                // General free stays deferred (RFC 0015 Â§5) behind sound escape analysis.
                // Non-escaping guarantee (escape analysis) means a moved/returned drop
                // instance is never reached here -> no double-drop / no early free.
                let drop_sym = self.resolve_drop_method(sym.type_id)
                if drop_sym != 0 as u32:
                    let arg_start = self.fb.emit_extra(1 as u32)
                    self.fb.emit_extra(reg)
                    let dreg = self.fb.fresh_reg()
                    self.fb.emit(AirInst(
                        opcode: OP_CALL,
                        type_id: drop_sym,
                        dest: dreg,
                        src1: 0 as u32,
                        src2: arg_start,
                    ))
                    self.fb.emit(AirInst(
                        opcode: OP_DESTROY,
                        type_id: 0 as u32,
                        dest: 0 as u32,
                        src1: reg,
                        src2: 0 as u32,
                    ))
                else:
                    // RFC 0015 P3 GENERAL FREE (activation): a non-escaping owned local
                    // whose type declares NO drop still gets its heap block freed with a
                    // plain OP_DESTROY (no drop call). Sound because the escape analyser is
                    // proven conservative on the self-host build (freeable set = 0, so this
                    // is inert there â€” A==B) and validated on the aggregate-escape corpus.
                    // For a container that owns nested heap (HashMap/Vec) this frees the
                    // header only (inner buffers leak until synthesised free-glue lands) â€”
                    // RFC 0027 path D: free the local's OWNED pointer buffers BEFORE the
                    // header, so the nested heap is reclaimed rather than leaked. Ownership
                    // is derived (pointer-typed field + all writes are allocations), so this
                    // covers user containers, not just Vec/HashMap/HashSet. No-op otherwise.
                    self.emit_owned_field_frees(reg, sym.type_id)
                    self.fb.emit(AirInst(
                        opcode: OP_DESTROY,
                        type_id: 0 as u32,
                        dest: 0 as u32,
                        src1: reg,
                        src2: 0 as u32,
                    ))

// RFC 0006 (#38.4): a `defer expr` registers the expression to run at scope
// exit instead of executing it now (the old stub ran it immediately, which was
// wrong). We record the expr node index in textual order; flush_defers emits
// them LIFO at each return and at function exit. Function-level (Go) semantics:
// an unconditional `defer` at the top of a function runs on every return path.
// LIMITATION: a defer inside a not-taken conditional branch is still emitted at
// later exits (no runtime registration) â€” documented in knowledge/bugs.md.
pub fn lower_defer(mut self: ptr[FuncLowering], idx: u32, node: AstNode):
    if node.first_child != 0 as u32:
        self.defers.push(node.first_child)

// Emit all registered deferred expressions into the current block, last-in
// first-out. Does NOT clear the list: each control-flow exit path (return /
// fall-through) is a distinct basic block and must run the defers once.
pub fn flush_defers(mut self: ptr[FuncLowering]):
    if self.defers.len == 0 as i64:
        return
    mut i := self.defers.len - 1 as i64
    while i >= 0 as i64:
        self.lower_expr(self.defers.data[i])
        i = i - 1 as i64

pub fn ensure_return(mut self: ptr[FuncLowering]):
    if not self.terminated:
        self.flush_defers()
        self.fb.emit(AirInst(
            opcode: OP_RETURN,
            type_id: 0 as u32,
            dest: 0 as u32,
            src1: 0 as u32,
            src2: 0 as u32,
        ))
        self.terminated = true

pub fn lower_func(self: ptr[AirModuleBuilder], idx: u32, node: AstNode) -> AirFunc:
    if node.flags & FLAG_IS_EXTERN != 0 as u16:
        return AirFunc(sym_id: 0 as u32, name: 0 as u32, params: new_u32_vec(), ret_type: 0 as u32, blocks: new_basic_block_vec(), insts: new_air_inst_vec(), extras: new_u32_vec(), is_async: false, is_extern: true, block_instrs: new_u32_vec(), block_succs: new_u32_vec(), block_preds: new_u32_vec())

    mut name_id := 0 as u32
    mut ret_type_id := 0 as u32
    mut param_types := new_u32_vec()

    let sym_idx = node.payload
    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symbols.symbols.len:
        let sym = self.symbols.symbols.data[sym_idx as i64]
        name_id = sym.name_id
        if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.typetable.entries.len:
            let entry = self.typetable.entries.data[sym.type_id as i64]
            if entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[entry.extra as i64]
                ret_type_id = fi.ret
                

                
                mut i := 0 as i64
                while i < fi.params.len:
                    param_types.push(fi.params.data[i])
                    i = i + 1

    if name_id == 0 as u32:
        let text = self.get_token_text(node.token_idx)
        name_id = self.pool.intern(text)
        @free(get_str_ptr(text))

    mut fb := new_air_func_builder(name_id, ret_type_id)
    mut fl := new_func_lowering(self, fb, param_types)

    fl.register_params(idx, node)

    // RFC 0017 P2: run non-constant module-level global initializers at program entry,
    // in source-declaration order, as the first thing `main` does. Each is evaluated and
    // stored into the global's static storage (OP_GLOBAL_ADDR + OP_STORE via
    // lower_global_write). Constant globals (init_node == 0) are already materialized in
    // `.data` and need no runtime init. The globals table is fully populated before any
    // function is lowered (build_module collects globals first), so the write routing is
    // complete. A unit with no non-constant globals (the compiler itself) emits nothing
    // extra here, preserving the fixpoint.
    let fname = self.pool.get(name_id)
    if fname == "main":
        mut gi := 0 as i64
        while gi < self.module.globals.len:
            let g = self.module.globals.data[gi]
            if g.init_node != 0 as u32:
                mut vreg = fl.lower_expr(g.init_node)
                // RFC 0029: the global-init prologue is a VALUE SITE like any other, so a
                // struct initializing an INTERFACE-typed global must be boxed with its
                // vtable here too. Without this the raw struct pointer was stored and the
                // first dispatch through the global read a method slot out of the struct's
                // own fields -> SIGSEGV. (`mut g: Shape` then assigning inside `main` already
                // worked: that path is an ordinary assignment, which was wired in 770dfc3.)
                vreg = fl.coerce_struct_to_interface(g.type_id, g.init_node, vreg)
                fl.lower_global_write(g.sym_id, g.type_id, vreg)
            gi = gi + 1

    mut body_idx := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child as i64]
        if cn.kind == NODE_BLOCK:
            body_idx = child
        child = cn.next_sibling

    if body_idx != 0 as u32:
        fl.lower_block(body_idx)

    fl.ensure_return()

    mut fn_built := fl.fb.build_func()
    fn_built.sym_id = sym_idx
    fn_built.is_async = (node.flags & FLAG_IS_ASYNC != 0 as u16)
    fn_built.params.data = fl.params.data
    fn_built.params.len = fl.params.len
    fn_built.params.cap = fl.params.cap

    fl.params.data = null as ptr[u32]

    free_func_lowering(fl)
    return fn_built

// RFC 0017 / BUG#82: fold a module-level global's constant initializer as a floating
// value (handles a leading unary +/- and intâ†’float promotion). Only reached for f32/f64
// globals; kept in lockstep with typecheck.ax's ax_global_init_is_const gate.
pub fn builder_global_fold_float(self: ptr[AirModuleBuilder], idx: u32) -> f64:
    if idx == 0 as u32:
        return 0.0
    let node = self.tree.nodes.data[idx as i64]
    if node.kind == NODE_CAST_EXPR:
        return self.builder_global_fold_float(node.first_child)
    if node.kind == NODE_UNARY_EXPR:
        let op = self.get_token_text(node.token_idx)
        let is_neg = op == "-"
        @free(get_str_ptr(op))
        let inner = self.builder_global_fold_float(node.first_child)
        if is_neg:
            return 0.0 - inner
        return inner
    if node.kind == NODE_FLOAT_LIT:
        let text = self.get_token_text(node.token_idx)
        let fv = atof(get_str_ptr(text))
        @free(get_str_ptr(text))
        return fv
    if node.kind == NODE_INT_LIT:
        let text = self.get_token_text(node.token_idx)
        let v = parse_int_from_str(text)
        @free(get_str_ptr(text))
        return v as f64
    return 0.0

// RFC 0017 / BUG#82: fold a module-level global's constant initializer as an i64 bit
// pattern (integers/bools/chars, with a leading unary +/-). Absent init folds to zero.
pub fn builder_global_fold_int(self: ptr[AirModuleBuilder], idx: u32) -> i64:
    if idx == 0 as u32:
        return 0 as i64
    let node = self.tree.nodes.data[idx as i64]
    if node.kind == NODE_CAST_EXPR:
        return self.builder_global_fold_int(node.first_child)
    if node.kind == NODE_UNARY_EXPR:
        let op = self.get_token_text(node.token_idx)
        let is_neg = op == "-"
        @free(get_str_ptr(op))
        let inner = self.builder_global_fold_int(node.first_child)
        if is_neg:
            return 0 as i64 - inner
        return inner
    if node.kind == NODE_INT_LIT:
        let text = self.get_token_text(node.token_idx)
        let v = parse_int_from_str(text)
        @free(get_str_ptr(text))
        return v
    if node.kind == NODE_BOOL_LIT:
        let text = self.get_token_text(node.token_idx)
        mut v := 0 as i64
        if text == "true":
            v = 1 as i64
        @free(get_str_ptr(text))
        return v
    if node.kind == NODE_CHAR_LIT:
        let text = self.get_token_text(node.token_idx)
        mut val := 0 as i64
        let length = std.string.len(text)
        if length >= 3 and text[0] as u8 == '\'' as u8 and text[length - 1] as u8 == '\'' as u8:
            if text[1] as u8 == '\\' as u8 and length >= 4:
                let esc = text[2] as u8
                if esc == 'n' as u8:
                    val = 10 as i64
                elif esc == 't' as u8:
                    val = 9 as i64
                elif esc == 'r' as u8:
                    val = 13 as i64
                elif esc == '\'' as u8:
                    val = 39 as i64
                elif esc == '\\' as u8:
                    val = 92 as i64
                elif esc == '0' as u8:
                    val = 0 as i64
                elif esc == 'b' as u8:
                    val = 8 as i64
                elif esc == 'f' as u8:
                    val = 12 as i64
                else:
                    val = esc as i64
            else:
                val = text[1] as i64
        @free(get_str_ptr(text))
        return val
    return 0 as i64

// RFC 0017 / BUG#82: fold a global's constant initializer to the raw i64 bit pattern
// stored in AirGlobal.init_lo. Float types (f32=9, f64=10) encode IEEE-754 bits; every
// other scalar uses the integer value.
pub fn builder_fold_global_init(self: ptr[AirModuleBuilder], idx: u32, type_id: u32) -> i64:
    if type_id == 9 as u32:
        let fv = self.builder_global_fold_float(idx)
        mut f32v := fv as f32
        return ((&f32v as ptr[u32])[0]) as i64
    if type_id == 10 as u32:
        let fv = self.builder_global_fold_float(idx)
        mut d := fv
        return ((&d as ptr[u64])[0]) as i64
    return self.builder_global_fold_int(idx)

// RFC 0017 / BUG#82: collect one module-level `let`/`mut` declaration into the module's
// global table. The typechecker Phase 4 gate has already rejected non-scalar and
// non-constant-init globals, so this only sees valid scalars.
pub fn collect_global(self: ptr[AirModuleBuilder], node: AstNode):
    let sym_idx = node.payload
    if sym_idx == 0 as u32 or (sym_idx as i64) >= self.symbols.symbols.len:
        return
    let type_id = self.symbols.symbols.data[sym_idx as i64].type_id
    mut size := 0 as u32
    mut align := 0 as u32
    builder_type_size_and_align(self.typetable, type_id, &size, &align)
    if size == 0 as u32:
        return
    // RFC 0017 P2: a by-address AGGREGATE global (struct/array/tuple) gets a `.data`
    // slot of its full size; scalars are still capped at 8 bytes (stored inline).
    // The typecheck Phase 4 gate already rejected everything else, so this mirror
    // just distinguishes the two storage strategies.
    mut is_agg := false
    if (type_id as i64) < self.typetable.entries.len:
        let gk = self.typetable.entries.data[type_id as i64].kind
        is_agg = gk == TYPE_KIND_STRUCT or gk == TYPE_KIND_ARRAY or gk == TYPE_KIND_TUPLE
    // RFC 0017 P2: a pointer-repr global (sum/Option/Result) has entry.size 16 (the box)
    // but its VALUE is an 8-byte tagged box pointer. Give the `.data` slot 8 bytes and
    // store the pointer inline â€” NOT a 16-byte block copy of the box (which would overrun
    // the slot). It is runtime-init like an aggregate (init produces a heap box).
    let is_ptr_repr = type_is_pointer_repr(self.typetable, self.pool, type_id)
    // RFC 0017 P2: a 16-byte INLINE primitive (`str`/`bytes`, {ptr,len}) â€” its value's
    // home holds all 16 bytes (NOT by-address, NOT an 8-byte box pointer). The `.data`
    // slot is the full 16 bytes; init is runtime (store both halves inline).
    let is_inline16 = not is_agg and not is_ptr_repr and size == 16 as u32
    if is_ptr_repr:
        size = 8 as u32
    elif not is_agg and not is_inline16 and size > 8 as u32:
        return
    mut init_expr := 0 as u32
    mut child := node.first_child
    while child != 0 as u32:
        let cn = self.tree.nodes.data[child as i64]
        if cn.kind != NODE_TYPE_EXPR and cn.kind != NODE_PTR_TYPE and cn.kind != NODE_SLICE_TYPE and cn.kind != NODE_ARRAY_TYPE and cn.kind != NODE_FUNC_TYPE and cn.kind != NODE_GENERIC_TYPE:
            init_expr = child
        child = cn.next_sibling
    // A scalar with a compile-time-constant initializer is folded into the `.data`
    // image bytes (init_lo). Everything else (a non-constant scalar, OR any aggregate)
    // leaves the storage zeroed and records the AST node so it is evaluated + stored at
    // program entry (see lower_func for `main`). Aggregates are ALWAYS runtime-init:
    // their initializer is a constructor expression whose value is a by-address
    // aggregate, block-copied into the slot by lower_global_write's OP_STORE.
    mut bits := 0 as i64
    mut init_node := 0 as u32
    if not is_agg and not is_ptr_repr and not is_inline16 and ax_global_init_is_const(self.tree, init_expr):
        bits = self.builder_fold_global_init(init_expr, type_id)
    else:
        init_node = init_expr
    (&self.module.globals).push(AirGlobal(sym_id: sym_idx, type_id: type_id, size: size, init_lo: bits, init_node: init_node))

// RFC 0017 / BUG#82: index of a symbol in the module's global table, or -1. Used by
// lower_ident / assignment lowering to route reads/writes through OP_GLOBAL_ADDR.
pub fn builder_global_index(self: ptr[AirModuleBuilder], sym_idx: u32) -> i64:
    mut i := 0 as i64
    while i < self.module.globals.len:
        if self.module.globals.data[i].sym_id == sym_idx:
            return i
        i = i + 1
    return -1 as i64

pub fn build_module(self: ptr[AirModuleBuilder]):
    let root = self.tree.nodes.data[0]
    // RFC 0017 / BUG#82: collect module-level globals FIRST so every function body that
    // reads/writes a global can route it through OP_GLOBAL_ADDR (membership is complete
    // before any function is lowered).
    mut gchild := root.first_child
    while gchild != 0 as u32:
        let gnode = self.tree.nodes.data[gchild as i64]
        if gnode.kind == NODE_VAR_DECL:
            self.collect_global(gnode)
        gchild = gnode.next_sibling
    mut child := root.first_child
    while child != 0 as u32:
        let node = self.tree.nodes.data[child as i64]
        if node.kind == NODE_FUNC_DECL:
            if node.flags & FLAG_IS_EXTERN == 0 as u16 and node.flags & FLAG_IS_GENERIC == 0 as u16:
                let fn_val = self.lower_func(child, node)
                self.module.funcs.push(fn_val)
        elif node.kind == NODE_STRUCT_DECL:
            if node.flags & FLAG_IS_GENERIC == 0 as u16:
                mut member := node.first_child
                while member != 0 as u32:
                    let member_node = self.tree.nodes.data[member as i64]
                    if member_node.kind == NODE_FUNC_DECL:
                        if member_node.flags & FLAG_IS_EXTERN == 0 as u16 and member_node.flags & FLAG_IS_GENERIC == 0 as u16:
                            let fn_val = self.lower_func(member, member_node)
                            self.module.funcs.push(fn_val)
                    member = member_node.next_sibling
        elif node.kind == NODE_TYPE_ALIAS_DECL:
            if node.flags & FLAG_IS_GENERIC == 0 as u16:
                mut member := node.first_child
                while member != 0 as u32:
                    let member_node = self.tree.nodes.data[member as i64]
                    if member_node.kind == NODE_FUNC_DECL:
                        if member_node.flags & FLAG_IS_EXTERN == 0 as u16 and member_node.flags & FLAG_IS_GENERIC == 0 as u16:
                            let fn_val = self.lower_func(member, member_node)
                            self.module.funcs.push(fn_val)
                    member = member_node.next_sibling
        child = node.next_sibling

pub fn builder_str_to_null_terminated(self: ptr[AirModuleBuilder], s: str) -> ptr[u8]:
    let len = std.string.len(s)
    let p = @alloc(len + 1) as ptr[u8]
    @memcpy(p, s as ptr[u8], len)
    p[len] = 0 as u8
    return p
// bootstrap/stage1/ssa_opt.ax
// SSA linear Intermediate Representation (AIR) O1 optimization passes:
// Constant Folding, Copy Propagation, and Dead Code Elimination.


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct ConstVal:
    pub known: bool
    pub val: u64

pub struct SsaOptimizer:
    pub level: u8

pub fn new_ssa_optimizer() -> SsaOptimizer:
    return SsaOptimizer(level: 1 as u8)

pub fn max_reg_id(f: ptr[AirFunc]) -> u32:
    mut max_id := 0 as u32
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.dest > max_id:
            max_id = inst.dest
        // src1 is a register only if it is a register operand (not block target or immediate constant)
        // src2 is a register only if it is a register operand
        if inst.opcode != OP_ICONST and inst.opcode != OP_FCONST and inst.opcode != OP_JUMP:
            if inst.src1 > max_id:
                max_id = inst.src1
            if inst.src2 > max_id and inst.opcode != OP_BRANCH:
                max_id = inst.src2
        i = i + 1 as i64
    return max_id

pub fn is_unary_foldable(op: u16) -> bool:
    return op == OP_NEG or op == OP_NOT

pub fn has_side_effect(op: u16) -> bool:
    if op == OP_STORE or op == OP_FREE or op == OP_DESTROY or op == OP_ALIAS_REUSE:
        return true
    if op == OP_CALL or op == OP_SPAWN or op == OP_SEND:
        return true
    // A raw syscall (write/mmap/exit/...) performs I/O or memory effects the optimizer
    // cannot see. Without this, a result-discarding `syscall(1,1,buf,len,..)` (e.g. the
    // freestanding Linux print runtime) was deleted as a pure dead value.
    if op == OP_SYSCALL:
        return true
    if op == OP_RETURN or op == OP_JUMP or op == OP_BRANCH:
        return true
    if op == OP_SET_FIELD:
        return true
    return false

pub fn opcode_is_control(op: u16) -> bool:
    if op == OP_JUMP or op == OP_BRANCH or op == OP_CALL or op == OP_RETURN:
        return true
    if op == OP_LOOP_BEGIN or op == OP_LOOP_END:
        return true
    return false

pub fn eval_binary(op: u16, a: u64, b: u64, out_val: ptr[u64]) -> bool:
    let ai = a as i64
    let bi = b as i64

    if op == OP_IADD:
        out_val[0] = (ai + bi) as u64
        return true
    elif op == OP_ISUB:
        out_val[0] = (ai - bi) as u64
        return true
    elif op == OP_IMUL:
        out_val[0] = (ai * bi) as u64
        return true
    elif op == OP_IDIV:
        if bi == 0 as i64:
            return false
        out_val[0] = (ai / bi) as u64
        return true
    elif op == OP_IMOD:
        if bi == 0 as i64:
            return false
        out_val[0] = (ai % bi) as u64
        return true
    elif op == OP_EQ:
        mut res := 0 as u64
        if ai == bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_NE:
        mut res := 0 as u64
        if ai != bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_LT:
        mut res := 0 as u64
        if ai < bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_LE:
        mut res := 0 as u64
        if ai <= bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_GT:
        mut res := 0 as u64
        if ai > bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_GE:
        mut res := 0 as u64
        if ai >= bi:
            res = 1 as u64
        out_val[0] = res
        return true
    elif op == OP_AND:
        out_val[0] = a & b
        return true
    elif op == OP_OR:
        out_val[0] = a | b
        return true
    elif op == OP_XOR:
        out_val[0] = a ^ b
        return true
    elif op == OP_SHL or op == OP_SHR:
        // Do NOT const-fold `const << const` / `const >> const`. When both operands
        // were compile-time constants this fold produced a WRONG value at -O1 (the
        // folded `iconst` came out 0 -> garbage) and crashed native codegen on some
        // `>>` inputs, while `-O0` and every non-both-const shift (var<<var,
        // var<<const, const<<var) were correct. The arithmetic here (`a << b`) is
        // itself right and var-shifts work, so the defect is in how the folded
        // constant is applied/materialized for a shift specifically; leaving shifts
        // to the (correct) runtime lowering restores correctness. The lost
        // optimization -- folding two integer LITERALS in a shift -- is negligible.
        // (BUG from bug-probe round 5; exact fold/apply micro-cause still open.)
        return false

    return false

pub fn eval_unary(op: u16, a: u64, out_val: ptr[u64]) -> bool:
    if op == OP_NEG:
        out_val[0] = (-(a as i64)) as u64
        return true
    // BUG#22: do NOT const-fold OP_NOT here. eval_unary has no operand type, and
    // OP_NOT is overloaded (bool logical `!` vs integer bitwise `~`). Folding it as
    // logical (a==0) corrupted bitwise `~const` (e.g. `~4095` -> 0), which broke
    // every `& ~(align-1)` idiom (struct layout, PE RVAs -> SizeOfImage=0). Leave
    // it unfolded; the type-aware selector (x86_selector OP_NOT) lowers it right.
    return false

// A register whose address is taken (the operand of OP_MAKE_REF) can be mutated
// through that pointer later â€” by a store, or by a call that receives the
// pointer. Such a register must NOT be treated as a compile-time constant by the
// value-folding passes even if it was defined by an ICONST: folding a use like
// `if flag` after `set(&flag)` to its initial constant skips the memory reload
// that actually observes the mutation. (The backend already spills address-taken
// vregs to a stack slot, so at -O0 the reload happens correctly; this only guards
// the optimizer from short-circuiting it.) Returns a bool[max_reg+1] marking each
// such register; caller frees it.
pub fn mark_addr_taken_regs(f: ptr[AirFunc], max_reg: u32) -> ptr[bool]:
    let arr = @alloc(max_reg as i64 + 1 as i64) as ptr[bool]
    @memset(arr as ptr[void], 0 as u8, max_reg as i64 + 1 as i64)
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_MAKE_REF and inst.src1 != 0 as u32 and inst.src1 <= max_reg:
            arr[inst.src1] = true
        i = i + 1 as i64
    return arr

// Wrap a folded integer constant to the width of its AIR type so a compile-time
// fold matches the runtime narrow-register op. `type_id` is the canonical
// primitive id (i8=1,i16=2,i32=3,i64=4,u8=5,u16=6,u32=7,u64=8,bool=11,char8=13,
// isize=15,usize=16). Only sub-64-bit integer types are masked; 8-byte ints,
// unknown (0), and non-integer ids are returned unchanged (floats are already
// excluded from folding by the has_flt guard). Signed narrow types sign-extend
// to 64 bits; unsigned narrow types zero-extend. See
// [[bug-const-fold-narrow-int-wrap]].
pub fn fold_narrow_mask(type_id: u16, val: u64) -> u64:
    let t = type_id as i64
    mut wbytes := 0 as i64
    mut signed := false
    if t == 1 as i64:
        wbytes = 1
        signed = true
    elif t == 2 as i64:
        wbytes = 2
        signed = true
    elif t == 3 as i64:
        wbytes = 4
        signed = true
    elif t == 5 as i64:
        wbytes = 1
    elif t == 6 as i64:
        wbytes = 2
    elif t == 7 as i64:
        wbytes = 4
    elif t == 11 as i64:
        wbytes = 1
    elif t == 13 as i64:
        wbytes = 1
    if wbytes == 0 as i64 or wbytes >= 8 as i64:
        return val
    let bits = (wbytes * 8 as i64) as u64
    let mask = ((1 as u64) << bits) - 1 as u64
    mut m := val & mask
    if signed:
        let sign_bit = (1 as u64) << (bits - 1 as u64)
        if (m & sign_bit) != 0 as u64:
            m = m | (mask ^ (0xFFFFFFFFFFFFFFFF as u64))
    return m

pub fn fold_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32 and inst.opcode != OP_BRANCH:
            def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32

    // BUG#40: float constants must NOT be integer-folded. eval_binary treats all
    // operands as i64, but comparison opcodes (OP_EQ/NE/LT/LE/GT/GE) are shared by
    // int and float (the selector picks comisd vs cmp by operand type). Folding a
    // float comparison with integer semantics on its IEEE-754 bit pattern gives a
    // wrong result (e.g. `1.41 > 10.0` at -O1). Track which constant regs came from
    // OP_FCONST and skip folding any binary op with a float operand (float
    // arithmetic uses distinct OP_F* opcodes that eval_binary already rejects; only
    // the shared comparisons need this guard).
    let is_flt = @alloc(max_reg as i64 + 1 as i64) as ptr[bool]
    @memset(is_flt as ptr[void], 0 as u8, max_reg as i64 + 1 as i64)

    mut changed := false
    let out_val = @alloc(8 as i64) as ptr[u64]
    let addr_taken = mark_addr_taken_regs(f, max_reg)

    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]

        if inst.opcode == OP_ICONST or inst.opcode == OP_FCONST:
            if inst.dest != 0 as u32:
                if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                    if inst.opcode == OP_ICONST:
                        let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
                        vals[inst.dest] = ConstVal(known: true, val: full_val)
                    else:
                        vals[inst.dest] = ConstVal(known: true, val: inst.src1 as u64)
                        if inst.dest <= max_reg:
                            is_flt[inst.dest] = true
                else:
                    vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
            i = i + 1 as i64
            continue

        if not opcode_is_binary_alu(inst.opcode) and not is_unary_foldable(inst.opcode):
            if inst.dest != 0 as u32:
                vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
            i = i + 1 as i64
            continue

        if opcode_is_binary_alu(inst.opcode):
            let src1_val = vals[inst.src1]
            let src2_val = vals[inst.src2]
            // BUG#40: never integer-fold an op with a float constant operand.
            let has_flt = is_flt[inst.src1] or is_flt[inst.src2]
            if src1_val.known and src2_val.known and not has_flt:
                let ok = eval_binary(inst.opcode, src1_val.val, src2_val.val, out_val)
                if ok:
                    // Narrow-integer wrap: eval_binary computes in full 64-bit, but a
                    // sub-64-bit result (u8/u16/u32/i8/i16/i32) must wrap to its type
                    // width exactly as the runtime 32/16/8-bit register op does. Without
                    // this, folding `u32 4000000000 + 500000000` kept 4_500_000_000 at
                    // -O1 (runtime wraps to 205_032_704) â€” a silent O0-vs-O1 miscompile.
                    // Signed narrow types sign-extend so the stored i64 constant matches
                    // the runtime value.
                    // GUARD: AIR type_id is NOT always the true value width (e.g. a
                    // negated i64::MIN literal in to_str carries an i32 type_id); masking
                    // such a mislabeled op would corrupt a full-width value (i64::MIN->0).
                    // Only wrap when BOTH operands already fit the declared width â€” then
                    // the type_id is consistent with the values and the wrap reflects a
                    // genuine narrow-type overflow. See [[bug-const-fold-narrow-int-wrap]].
                    if fold_narrow_mask(inst.type_id, src1_val.val) == src1_val.val and fold_narrow_mask(inst.type_id, src2_val.val) == src2_val.val:
                        out_val[0] = fold_narrow_mask(inst.type_id, out_val[0])
                    inst.opcode = OP_ICONST
                    inst.src1 = (out_val[0] & 0xFFFFFFFF as u64) as u32
                    inst.src2 = ((out_val[0] >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                    if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                        vals[inst.dest] = ConstVal(known: true, val: out_val[0])
                    else:
                        vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
                    changed = true
                    i = i + 1 as i64
                    continue

        if is_unary_foldable(inst.opcode):
            let src1_val = vals[inst.src1]
            // BUG#40 sibling: never integer-fold OP_NEG on a FLOAT operand. eval_unary
            // computes two's-complement `-(a as i64)`, which corrupts an IEEE-754 bit
            // pattern (a float `-x` folded to garbage/0.0 at -O1). Leave float neg to
            // the selector's XMM sign-flip. Mirrors the binary fold's has_flt guard.
            if src1_val.known and not is_flt[inst.src1]:
                let ok = eval_unary(inst.opcode, src1_val.val, out_val)
                if ok:
                    // Narrow-integer wrap (see the binary fold above): OP_NEG on an
                    // i8/i16/i32/u8/u16/u32 must wrap to its width. Same operand-fit
                    // GUARD: skip when the operand doesn't fit the declared width (a
                    // mislabeled type_id, e.g. negated i64::MIN carrying an i32 type_id).
                    if fold_narrow_mask(inst.type_id, src1_val.val) == src1_val.val:
                        out_val[0] = fold_narrow_mask(inst.type_id, out_val[0])
                    inst.opcode = OP_ICONST
                    inst.src1 = (out_val[0] & 0xFFFFFFFF as u64) as u32
                    inst.src2 = ((out_val[0] >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                    if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                        vals[inst.dest] = ConstVal(known: true, val: out_val[0])
                    else:
                        vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
                    changed = true
                    i = i + 1 as i64
                    continue

        if inst.dest != 0 as u32:
            vals[inst.dest] = ConstVal(known: false, val: 0 as u64)
        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(vals as ptr[u8])
    @free(out_val as ptr[u8])
    @free(addr_taken as ptr[u8])
    @free(is_flt as ptr[u8])
    return changed

pub fn copy_prop_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    let copy_map = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(copy_map as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    // BUG#31: an ADDRESS-TAKEN vreg must never participate in a copy chain. For
    // `mut modrm := 0; &modrm; ...; use modrm`, the front end emits
    // `%6 = copy %5; mkref %6` (the variable %6 is the addr-taken cell). The
    // callee writes %6's stack slot through the pointer, so %6 is NOT a true copy
    // of %5 â€” its value changes invisibly. If we record copy_map[%6]=%5 and then
    // rewrite the data read of %6 to %5 (its stale init) while the mkref/store
    // stays on %6, the read observes the pre-call value -> every `mov reg,reg`
    // collapsed to modrm=0 in self-host stage3 (the backend already force-spills
    // addr-taken vregs; this only stops the optimizer from short-circuiting the
    // reload). Mirror fold_func's `not addr_taken[...]` guard. Guard BOTH ends:
    // dest addr-taken (its memory mutates) and src addr-taken (the snapshot
    // diverges from the live cell after a later through-pointer write).
    let addr_taken = mark_addr_taken_regs(f, max_reg)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32:
            if inst.dest <= max_reg:
                def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    i = 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP:
            if (inst.opcode == OP_COPY or inst.opcode == OP_MOVE) and inst.dest != 0 as u32 and inst.src1 != 0 as u32:
                if inst.dest <= max_reg and inst.src1 <= max_reg:
                    if def_counts[inst.dest] == 1 as u32 and def_counts[inst.src1] == 1 as u32 and not addr_taken[inst.dest] and not addr_taken[inst.src1]:
                        copy_map[inst.dest] = inst.src1
        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]
        if inst.opcode == OP_NOP or inst.opcode == OP_ICONST or inst.opcode == OP_FCONST:
            i = i + 1 as i64
            continue

        // BUG (fn-ptr): OP_FUNC_ADDR encodes the FUNCTION SYMBOL INDEX (an
        // immediate) in src1, not a value vreg â€” analogous to GET_FIELD/SET_FIELD
        // src2 below (BUG#15). Copy-propagating it corrupts the symbol selector
        // whenever the index numerically collides with a vreg id in a copy chain
        // (e.g. `let f = add` renumbers vregs so add's sym_idx aliases a live
        // copy) -> wrong function address -> crash. Leave src1 untouched here.
        if inst.src1 != 0 as u32 and inst.opcode != OP_JUMP and inst.opcode != OP_FUNC_ADDR:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1

            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        // BUG#15: GET_FIELD/SET_FIELD encode the FIELD INDEX (an immediate) in
        // src2, not a value vreg. Copy-propagating it corrupts the field selector
        // whenever the index numerically collides with a vreg id that is in a
        // copy chain (e.g. field 6 "count" rewritten to vreg 1). src2 here must be
        // left untouched; only true value operands may be propagated.
        if inst.src2 != 0 as u32 and not opcode_is_control(inst.opcode) and inst.opcode != OP_GET_FIELD and inst.opcode != OP_SET_FIELD:
            mut curr := inst.src2
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1

            if curr != inst.src2:
                inst.src2 = curr
                changed = true

        if inst.dest != 0 as u32 and (inst.opcode == OP_STORE or inst.opcode == OP_SET_FIELD):
            mut curr := inst.dest
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.dest:
                inst.dest = curr
                changed = true

        if inst.opcode == OP_BRANCH and inst.src1 != 0 as u32:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        if inst.opcode == OP_RETURN and inst.src1 != 0 as u32:
            mut curr := inst.src1
            mut depth := 0
            while curr != 0 as u32 and depth < 100:
                let parent = copy_map[curr]
                if parent == 0 as u32:
                    break
                curr = parent
                depth = depth + 1
            
            if curr != inst.src1:
                inst.src1 = curr
                changed = true

        // OP_SYSCALL carries its argument vregs in `extras` exactly like OP_CALL
        // (count at extras[src2], args following), so copy-propagate them the same way.
        if inst.opcode == OP_CALL or inst.opcode == OP_SYSCALL:
            let arg_start = inst.src2
            mut arg_count := 0 as u32
            if arg_start < f.extras.len as u32:
                arg_count = f.extras.data[arg_start]

            mut idx := 0 as u32
            while idx < arg_count:
                let arg_reg_idx = arg_start + 1 as u32 + idx
                let arg_reg = f.extras.data[arg_reg_idx]
                if arg_reg != 0 as u32:
                    mut curr := arg_reg
                    mut depth := 0
                    while curr != 0 as u32 and depth < 100:
                        let parent = copy_map[curr]
                        if parent == 0 as u32:
                            break
                        curr = parent
                        depth = depth + 1

                    if curr != arg_reg:
                        f.extras.data[arg_reg_idx] = curr
                        changed = true
                idx = idx + 1 as u32

        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(copy_map as ptr[u8])
    @free(addr_taken as ptr[u8])
    return changed

pub fn remove_unreachable_blocks(f: ptr[AirFunc]) -> bool:
    if f.blocks.len <= 1 as i64:
        return false

    let reachable = @alloc(f.blocks.len) as ptr[bool]
    @memset(reachable as ptr[void], 0 as u8, f.blocks.len)
    reachable[0] = true

    let queue = @alloc(f.blocks.len * 4 as i64) as ptr[u32]
    mut head := 0 as i64
    mut tail := 0 as i64

    queue[tail] = 0 as u32
    tail = tail + 1 as i64

    while head < tail:
        let cur = queue[head]
        head = head + 1 as i64

        if (cur as i64) < f.blocks.len:
            let blk = f.blocks.data[cur]
            mut i := 0 as u32
            while i < blk.succs_len:
                let succ = f.block_succs.data[blk.succs_start + i]
                if (succ as i64) < f.blocks.len:
                    if not reachable[succ]:
                        reachable[succ] = true
                        queue[tail] = succ
                        tail = tail + 1 as i64
                i = i + 1 as u32

    if tail == f.blocks.len:
        @free(reachable as ptr[u8])
        @free(queue as ptr[u8])
        return false

    mut bi := 0 as i64
    while bi < f.blocks.len:
        if not reachable[bi]:
            mut blk := &f.blocks.data[bi]
            mut i := 0 as u32
            while i < blk.instrs_len:
                let inst_idx = f.block_instrs.data[blk.instrs_start + i]
                if (inst_idx as i64) < f.insts.len:
                    f.insts.data[inst_idx].opcode = OP_NOP
                    f.insts.data[inst_idx].type_id = 0 as u16
                    f.insts.data[inst_idx].dest = 0 as u32
                    f.insts.data[inst_idx].src1 = 0 as u32
                    f.insts.data[inst_idx].src2 = 0 as u32
                i = i + 1 as u32
            blk.instrs_len = 0 as u32
            blk.succs_len = 0 as u32
            blk.preds_len = 0 as u32
        bi = bi + 1 as i64

    @free(reachable as ptr[u8])
    @free(queue as ptr[u8])
    return true

pub fn dce_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let use_count = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(use_count as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_NOP:
            i = i + 1 as i64
            continue

        // OP_SYSCALL shares OP_CALL's extras-based argument list; its arg vregs are
        // real uses. Without counting them, DCE deletes the instructions that compute
        // the syscall number / fd / buffer / length, so the inlined `syscall(...)`
        // executes with garbage registers (e.g. write(2) wrote nothing on Linux).
        if inst.opcode == OP_CALL or inst.opcode == OP_SYSCALL:
            let arg_start = inst.src2
            mut arg_count := 0 as u32
            if arg_start < f.extras.len as u32:
                arg_count = f.extras.data[arg_start]

            mut idx := 0 as u32
            while idx < arg_count:
                let arg_reg = f.extras.data[arg_start + 1 as u32 + idx]
                if arg_reg != 0 as u32:
                    use_count[arg_reg] = use_count[arg_reg] + 1 as u32
                idx = idx + 1 as u32
            // BUG (fn-ptr): an INDIRECT call carries its target in src1 (the vreg
            // holding the function address, e.g. from a local `let f = add`). It is
            // a real use â€” without counting it, DCE sees the OP_FUNC_ADDR def as
            // dead (no side effect) and deletes it, leaving the call target as
            // garbage -> crash at -O1. Direct calls have src1==0 (no-op here).
            // OP_SYSCALL's src1 is the dead `syscall` callee address â€” intentionally
            // NOT counted, so it stays eliminated (and never becomes an import).
            if inst.opcode == OP_CALL and inst.src1 != 0 as u32:
                use_count[inst.src1] = use_count[inst.src1] + 1 as u32
            i = i + 1 as i64
            continue

        if inst.opcode == OP_ICONST or inst.opcode == OP_FCONST or inst.opcode == OP_JUMP:
            i = i + 1 as i64
            continue

        if inst.opcode == OP_BRANCH:
            if inst.src1 != 0 as u32:
                use_count[inst.src1] = use_count[inst.src1] + 1 as u32
            i = i + 1 as i64
            continue

        if inst.dest != 0 as u32 and (inst.opcode == OP_STORE or inst.opcode == OP_SET_FIELD):
            use_count[inst.dest] = use_count[inst.dest] + 1 as u32

        if inst.src1 != 0 as u32:
            use_count[inst.src1] = use_count[inst.src1] + 1 as u32

        if inst.src2 != 0 as u32:
            use_count[inst.src2] = use_count[inst.src2] + 1 as u32

        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32:
            if not has_side_effect(inst.opcode):
                if use_count[inst.dest] == 0 as u32:
                    inst.opcode = OP_NOP
                    inst.type_id = 0 as u16
                    inst.dest = 0 as u32
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    changed = true
        i = i + 1 as i64

    @free(use_count as ptr[u8])

    if remove_unreachable_blocks(f):
        changed = true

    return changed

// Loop-Invariant Code Motion â€” RFC 0025 "model A" (sound on non-SSA AIR).
//
// RE-ENABLED in the -O2/-O3 pipeline (see SsaOptimizer.run). AIR is NON-SSA (a
// register may be reassigned inside a loop: an induction variable `i = i + 1`, an
// accumulator `acc = acc + i`). A naive LICM that hoists a definition and NOPs the
// in-loop copy is only valid under single-assignment, so on a multiply-defined
// register it moves/erases the wrong definition â†’ the loop body reads a stale
// register â†’ the compiled program crashes at run time. The previous naive pass hit
// exactly this (a plain `while i<N: acc=acc+i; i=i+1` sum loop segfaulted at run
// time). Model A closes that hole with three gates that make every hoist provably
// safe WITHOUT building SSA:
//
//   1. WHITELIST (is_hoistable_op): only pure, fault-free, register/immediate-
//      operand ALU ops (add/sub/mul, float add/sub/mul, compares, bitwise, neg/not).
//      EXCLUDES: constants (OP_ICONST/OP_FCONST â€” no compute benefit, and forcing a
//      const into a loop-crossing register only adds register pressure), all memory
//      ops (may fault â€” the address may be valid only inside the loop), div/mod
//      (trap on div-by-zero if the loop never runs), and everything with a side
//      effect (store/call/syscall). RFC 0025 D3 + empirical: including constants
//      previously reintroduced a segfault; excluding them is all-safety / no-loss.
//   2. SINGLE-DEF GATE: hoist a candidate only if its dest register is defined
//      EXACTLY ONCE in the whole function AND every register operand is defined
//      exactly once, OUTSIDE the loop. This is the non-SSA soundness key: a
//      single-def register cannot be the wrong definition, and def_block[reg] is
//      then unambiguous. Any induction/accumulator var is multiply-defined â†’ never
//      hoisted (correct: it is not invariant anyway).
//   3. UNIQUE DOMINATING PRE-HEADER: hoist only into a loop header that has EXACTLY
//      ONE predecessor with lower loop_depth (all other preds are back-edges), which
//      makes that predecessor a true pre-header that dominates the header. If a
//      unique pre-header cannot be established, the loop is skipped (hoist nothing).
//
// The two crash fixes the naive pass needed are kept (they are shared by the sound
// strength_reduction/loop_unroll passes): insert_inst_at adjusts instrs_start by
// PHYSICAL layout position, and register-operand reads guard against ICONST/FCONST/
// JUMP/BRANCH immediate slots. Acceptance test (RFC 0025 Â§4): differential O0..O3 on
// the loop battery + a must-hoist positive oracle + building the compiler at -O2 and
// running the full regression on the -O2-built compiler (self-build is blind â€” it
// uses -O1, so LICM never runs during it).

// Pure, fault-free ALU ops whose operands are all registers/immediates. These are
// the ONLY ops model-A LICM will relocate (RFC 0025 D3). Deliberately excludes
// OP_ICONST/OP_FCONST (constants), OP_IDIV/OP_IMOD/OP_FDIV (trap), memory ops
// (LOAD/GET_FIELD/INDEX/... â€” may fault), casts/conversions (src2 may encode a
// width, not a register), and anything with a side effect.
pub fn is_hoistable_op(op: u16) -> bool:
    if op == OP_IADD or op == OP_ISUB or op == OP_IMUL:
        return true
    if op == OP_FADD or op == OP_FSUB or op == OP_FMUL:
        return true
    if op == OP_EQ or op == OP_NE or op == OP_LT or op == OP_LE or op == OP_GT or op == OP_GE:
        return true
    if op == OP_AND or op == OP_OR or op == OP_XOR or op == OP_SHL or op == OP_SHR:
        return true
    if op == OP_NEG or op == OP_NOT:
        return true
    // OP_COPY is deliberately not hoisted; instead copy_prop_func runs BEFORE LICM
    // (see SsaOptimizer.run) to collapse the copies a lowered invariant chain
    // `t1=a*b; t2=t1+c` leaves between its links. Once t2's operand is t1 directly,
    // LICM's within-pass chaining hoists the whole chain (after hoisting t1,
    // def_block[t1]=pre-header, so the direct-operand t2 is then invariant too).
    //
    // KNOWN LIMITATION (measured, not a bug): a chain link whose OPERAND vreg is
    // REUSED inside the loop does not hoist. Example: `t1=a*b; t2=t1+c` where AIR
    // reuses c's vreg for an unrelated loop temp â†’ c has def_count==2 (one def at
    // loop depth) â†’ the single-def gate conservatively (correctly) refuses to hoist
    // t2, since it cannot prove WHICH def of c reaches the use without reaching-
    // definitions. Non-reused chains DO fully hoist (verified). Closing this gap
    // needs reaching-defs / SSA â€” the model-B path RFC 0025 scopes as a separate
    // epic; refusing to hoist here is always sound.
    return false

// Fill preheader[b] with the pre-header block id for every loop-body block b whose
// INNERMOST loop has a unique dominating pre-header, else 0xffffffff. A natural loop
// is identified by a back-edge b->h (h a successor of b, h's block id <= b's). Its
// header h has a unique pre-header iff exactly one pred of h has loop_depth < h's;
// that pred then dominates h (every other pred is a back-edge, only reachable after
// h). Membership is the classic backward walk from the back-edge source, stopping at
// the header. Only blocks whose own loop_depth equals the header's are assigned here
// (their innermost loop is this one); blocks in a nested inner loop have a higher
// depth and are assigned when that inner loop's back-edge is processed. Deterministic
// (fixed block/succ/pred iteration order).
pub fn compute_loop_preheaders(f: ptr[AirFunc], preheader: ptr[u32]):
    let nblocks = f.blocks.len
    if nblocks == 0 as i64:
        return
    let in_loop = @alloc(nblocks) as ptr[bool]
    let queue = @alloc(nblocks * 4 as i64) as ptr[u32]

    mut b := 0 as u32
    while b < nblocks as u32:
        let blk = f.blocks.data[b]
        mut si := 0 as u32
        while si < blk.succs_len:
            let h = f.block_succs.data[blk.succs_start + si]
            if h <= b and h < nblocks as u32:
                let hd = f.blocks.data[h].loop_depth
                // unique pre-header of h = the sole pred with lower loop_depth
                mut ph := 0xffffffff as u32
                mut nph := 0 as i64
                mut pi := 0 as u32
                while pi < f.blocks.data[h].preds_len:
                    let p = f.block_preds.data[f.blocks.data[h].preds_start + pi]
                    if p < nblocks as u32:
                        if f.blocks.data[p].loop_depth < hd:
                            ph = p
                            nph = nph + 1 as i64
                    pi = pi + 1 as u32

                if nph == 1 as i64:
                    // membership: {h} U preds*(b) not crossing h
                    @memset(in_loop as ptr[void], 0 as u8, nblocks)
                    in_loop[h] = true
                    in_loop[b] = true
                    mut head := 0 as i64
                    mut tail := 0 as i64
                    if h != b:
                        queue[tail] = b
                        tail = tail + 1 as i64
                    while head < tail:
                        let curr = queue[head]
                        head = head + 1 as i64
                        let curr_blk = f.blocks.data[curr]
                        mut ppi := 0 as u32
                        while ppi < curr_blk.preds_len:
                            let pred = f.block_preds.data[curr_blk.preds_start + ppi]
                            if pred < nblocks as u32:
                                if not in_loop[pred]:
                                    in_loop[pred] = true
                                    queue[tail] = pred
                                    tail = tail + 1 as i64
                            ppi = ppi + 1 as u32
                    // assign pre-header to member blocks at the header's depth
                    mut i := 0 as i64
                    while i < nblocks:
                        if in_loop[i] and f.blocks.data[i].loop_depth == hd:
                            preheader[i] = ph
                        i = i + 1 as i64
            si = si + 1 as u32
        b = b + 1 as u32

    @free(in_loop as ptr[u8])
    @free(queue as ptr[u8])

pub fn licm_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let n = max_reg as i64 + 1 as i64
    // per-register def COUNT (single-def gate) + the block of its (last) def.
    let def_count = @alloc(n * 4 as i64) as ptr[u32]
    @memset(def_count as ptr[void], 0 as u8, n * 4 as i64)
    let def_block = @alloc(n * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, n * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_count[inst.dest] = def_count[inst.dest] + 1 as u32
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    // per-block -> unique dominating pre-header (0xffffffff if none)
    let preheader = @alloc(f.blocks.len * 4 as i64) as ptr[u32]
    @memset(preheader as ptr[void], 0xff as u8, f.blocks.len * 4 as i64)
    compute_loop_preheaders(f, preheader)

    mut changed := false

    bi = 0 as i64
    while bi < f.blocks.len:
        // Fresh re-reads of block/inst fields on every use: a hoist calls
        // insert_inst_at, which may REALLOCATE f.insts.data and shifts instrs_start
        // of physically-later blocks â€” a captured ptr[AirInst]/AirBlock would be
        // stale (this segfaulted the naive pass at -O2/-O3 on any loop).
        let ph = preheader[bi]
        if ph != 0xffffffff as u32:
            let cur_depth = f.blocks.data[bi].loop_depth
            mut inst_i := 0 as u32
            while inst_i < f.blocks.data[bi].instrs_len:
                let inst_idx = f.block_instrs.data[f.blocks.data[bi].instrs_start + inst_i]
                let op = f.insts.data[inst_idx].opcode
                let ty = f.insts.data[inst_idx].type_id
                let dst = f.insts.data[inst_idx].dest
                let s1 = f.insts.data[inst_idx].src1
                let s2 = f.insts.data[inst_idx].src2

                // Gate 1: whitelist. Gate 2a: dest single-def.
                if is_hoistable_op(op) and dst != 0 as u32 and dst <= max_reg and def_count[dst] == 1 as u32:
                    // Gate 2b: every register operand single-def AND defined outside
                    // the loop. For whitelisted ops src1/src2 are always registers
                    // (or 0 for the unused slot of a unary op).
                    mut ok := true
                    if s1 != 0 as u32:
                        if s1 > max_reg or def_count[s1] != 1 as u32:
                            ok = false
                        else:
                            let db = def_block[s1]
                            if db == 0xffffffff as u32 or f.blocks.data[db].loop_depth >= cur_depth:
                                ok = false
                    if ok and s2 != 0 as u32:
                        if s2 > max_reg or def_count[s2] != 1 as u32:
                            ok = false
                        else:
                            let db = def_block[s2]
                            if db == 0xffffffff as u32 or f.blocks.data[db].loop_depth >= cur_depth:
                                ok = false

                    if ok:
                        // Insert BEFORE the pre-header's terminator (appending after
                        // the jump into the loop would be dead code / undefined dest).
                        mut pos := f.blocks.data[ph].instrs_len
                        if pos > 0 as u32:
                            let last_idx = f.block_instrs.data[f.blocks.data[ph].instrs_start + (pos - 1 as u32)]
                            let last_op = f.insts.data[last_idx].opcode
                            if last_op == OP_JUMP or last_op == OP_BRANCH or last_op == OP_RETURN:
                                pos = pos - 1 as u32

                        insert_inst_at(f, ph, pos, AirInst(
                            opcode: op,
                            type_id: ty,
                            dest: dst,
                            src1: s1,
                            src2: s2
                        ))

                        // The value is now defined in the pre-header (still exactly
                        // one def). A dependent invariant later in the same block sees
                        // this and becomes hoistable too (single-pass chaining).
                        def_block[dst] = ph

                        // NOP the original in place, addressed by index (the insert
                        // may have reallocated f.insts.data).
                        f.insts.data[inst_idx].opcode = OP_NOP
                        f.insts.data[inst_idx].type_id = 0 as u16
                        f.insts.data[inst_idx].dest = 0 as u32
                        f.insts.data[inst_idx].src1 = 0 as u32
                        f.insts.data[inst_idx].src2 = 0 as u32

                        changed = true
                inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    @free(def_count as ptr[u8])
    @free(def_block as ptr[u8])
    @free(preheader as ptr[u8])
    return changed

pub fn insert_inst_at(f: ptr[AirFunc], block_id: u32, pos_in_block: u32, inst: AirInst) -> u32:
    let new_inst_idx = f.insts.push(inst)
    let blk = &f.blocks.data[block_id]
    let insert_pos = blk.instrs_start + pos_in_block

    f.block_instrs.push(0 as u32)
    mut shift_i := f.block_instrs.len - 1 as i64
    while shift_i > insert_pos as i64:
        f.block_instrs.data[shift_i] = f.block_instrs.data[shift_i - 1 as i64]
        shift_i = shift_i - 1 as i64
    f.block_instrs.data[insert_pos] = new_inst_idx
    blk.instrs_len = blk.instrs_len + 1 as u32

    // Bump instrs_start for every OTHER block whose region is PHYSICALLY at or
    // after the insertion point. `block_instrs` is a flat array laid out in
    // physical (instrs_start) order, which is NOT necessarily block-index order â€”
    // an optimizer may make a loop's pre-header (lower instrs_start) have a HIGHER
    // block index than the loop body (e.g. LICM hoisting into `pre_header_id > bi`).
    // The old `index > block_id` adjustment then failed to shift a physically-later
    // block that happened to have a lower index, corrupting its instruction window
    // (duplicate/garbage indices â†’ out-of-bounds read â†’ compiler SEGV at -O2/-O3).
    // Comparing physical positions is correct regardless of index ordering.
    mut adjust_bi := 0 as i64
    while adjust_bi < f.blocks.len:
        if adjust_bi != block_id as i64:
            if f.blocks.data[adjust_bi].instrs_start >= insert_pos:
                f.blocks.data[adjust_bi].instrs_start = f.blocks.data[adjust_bi].instrs_start + 1 as u32
        adjust_bi = adjust_bi + 1 as i64
    return new_inst_idx

pub fn compute_loop_depths(f: ptr[AirFunc]) -> bool:
    mut bi := 0 as i64
    while bi < f.blocks.len:
        f.blocks.data[bi].loop_depth = 0 as u8
        bi = bi + 1 as i64

    mut changed := false
    let in_loop = @alloc(f.blocks.len) as ptr[bool]
    let queue = @alloc(f.blocks.len * 4 as i64) as ptr[u32]

    mut b := 0 as u32
    while b < f.blocks.len as u32:
        let blk = f.blocks.data[b]
        mut succ_i := 0 as u32
        while succ_i < blk.succs_len:
            let h = f.block_succs.data[blk.succs_start + succ_i]
            if h <= b and h < f.blocks.len as u32:
                @memset(in_loop as ptr[void], 0 as u8, f.blocks.len)
                in_loop[h] = true
                in_loop[b] = true

                mut head := 0 as i64
                mut tail := 0 as i64
                
                if h != b:
                    queue[tail] = b
                    tail = tail + 1 as i64

                while head < tail:
                    let curr = queue[head]
                    head = head + 1 as i64

                    let curr_blk = f.blocks.data[curr]
                    mut pred_i := 0 as u32
                    while pred_i < curr_blk.preds_len:
                        let pred = f.block_preds.data[curr_blk.preds_start + pred_i]
                        if pred < f.blocks.len as u32:
                            if not in_loop[pred]:
                                in_loop[pred] = true
                                queue[tail] = pred
                                tail = tail + 1 as i64
                        pred_i = pred_i + 1 as u32

                mut i := 0 as i64
                while i < f.blocks.len:
                    if in_loop[i]:
                        let old_depth = f.blocks.data[i].loop_depth
                        if old_depth < 255 as u8:
                            f.blocks.data[i].loop_depth = old_depth + 1 as u8
                            changed = true
                    i = i + 1 as i64
            succ_i = succ_i + 1 as u32
        b = b + 1 as u32

    @free(in_loop as ptr[u8])
    @free(queue as ptr[u8])
    return changed

pub fn strength_reduction_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_block = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    mut changed := false
    mut next_reg := max_reg + 1 as u32

    bi = 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        if blk.loop_depth > 0 as u8:
            mut pre_header_id := 0xffffffff as u32
            mut pred_i := 0 as u32
            while pred_i < blk.preds_len:
                let pred = f.block_preds.data[blk.preds_start + pred_i]
                if pred < f.blocks.len as u32:
                    if f.blocks.data[pred].loop_depth < blk.loop_depth:
                        pre_header_id = pred
                        break
                pred_i = pred_i + 1 as u32

            if pre_header_id != 0xffffffff as u32:
                mut iv_reg := 0 as u32
                mut step_val := 0 as u32
                mut step_reg := 0 as u32
                mut is_add := true

                mut inst_i := 0 as u32
                while inst_i < blk.instrs_len:
                    let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
                    let inst = f.insts.data[inst_idx]
                    if inst.opcode == OP_COPY and inst.dest != 0 as u32:
                        let src = inst.src1
                        let src_def_idx = f.block_instrs.data[blk.instrs_start + inst_i - 1 as u32]
                        let src_def = f.insts.data[src_def_idx]
                        if src_def.dest == src and (src_def.opcode == OP_IADD or src_def.opcode == OP_ISUB):
                            if src_def.src1 == inst.dest:
                                iv_reg = inst.dest
                                step_reg = src_def.src2
                                is_add = (src_def.opcode == OP_IADD)
                                break
                            elif src_def.src2 == inst.dest and src_def.opcode == OP_IADD:
                                iv_reg = inst.dest
                                step_reg = src_def.src1
                                is_add = true
                                break
                    inst_i = inst_i + 1 as u32

                if iv_reg != 0 as u32:
                    inst_i = 0 as u32
                    while inst_i < blk.instrs_len:
                        let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
                        mut inst := &f.insts.data[inst_idx]
                        if inst.opcode == OP_IMUL and inst.dest != 0 as u32:
                            mut c_reg := 0 as u32
                            if inst.src1 == iv_reg:
                                c_reg = inst.src2
                            elif inst.src2 == iv_reg:
                                c_reg = inst.src1
                            
                            if c_reg != 0 as u32:
                                mut is_invariant := false
                                let c_def_b = def_block[c_reg]
                                if c_def_b == 0xffffffff as u32:
                                    is_invariant = true
                                else:
                                    if f.blocks.data[c_def_b].loop_depth < blk.loop_depth:
                                        is_invariant = true
                                        
                                if is_invariant:
                                    mut start_reg := 0 as u32
                                    let ph_blk = f.blocks.data[pre_header_id]
                                    mut ph_inst_i := 0 as u32
                                    while ph_inst_i < ph_blk.instrs_len:
                                        let ph_inst_idx = f.block_instrs.data[ph_blk.instrs_start + ph_inst_i]
                                        let ph_inst = f.insts.data[ph_inst_idx]
                                        if (ph_inst.opcode == OP_COPY or ph_inst.opcode == OP_MOVE) and ph_inst.dest == iv_reg:
                                            start_reg = ph_inst.src1
                                            break
                                        elif ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                            start_reg = iv_reg
                                            break
                                        ph_inst_i = ph_inst_i + 1 as u32
                                        
                                    if start_reg != 0 as u32:
                                        let acc_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        mut init_inst := AirInst(
                                            opcode: OP_IMUL,
                                            type_id: inst.type_id,
                                            dest: acc_reg,
                                            src1: start_reg,
                                            src2: c_reg
                                        )
                                        if start_reg == iv_reg:
                                            mut iv_const_val := 0 as u32
                                            let ph_blk2 = f.blocks.data[pre_header_id]
                                            mut ph_inst_i2 := 0 as u32
                                            while ph_inst_i2 < ph_blk2.instrs_len:
                                                let ph_inst_idx = f.block_instrs.data[ph_blk2.instrs_start + ph_inst_i2]
                                                let ph_inst = f.insts.data[ph_inst_idx]
                                                if ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                                    iv_const_val = ph_inst.src1
                                                    break
                                                ph_inst_i2 = ph_inst_i2 + 1 as u32
                                            let temp_start_reg = next_reg
                                            next_reg = next_reg + 1 as u32
                                            insert_inst_at(f, pre_header_id, ph_blk2.instrs_len - 1 as u32, AirInst(
                                                opcode: OP_ICONST,
                                                type_id: inst.type_id,
                                                dest: temp_start_reg,
                                                src1: iv_const_val,
                                                src2: 0 as u32
                                            ))
                                            init_inst.src1 = temp_start_reg
                                        
                                        insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, init_inst)
                                        
                                        inst.opcode = OP_COPY
                                        inst.src1 = acc_reg
                                        inst.src2 = 0 as u32
                                        
                                        let step_mul_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        let new_acc_reg = next_reg
                                        next_reg = next_reg + 1 as u32
                                        
                                        mut copy_pos := 0 as u32
                                        mut loop_inst_i := 0 as u32
                                        while loop_inst_i < blk.instrs_len:
                                            let loop_inst_idx = f.block_instrs.data[blk.instrs_start + loop_inst_i]
                                            let loop_inst = f.insts.data[loop_inst_idx]
                                            if loop_inst.opcode == OP_COPY and loop_inst.dest == iv_reg:
                                                copy_pos = loop_inst_i + 1 as u32
                                                break
                                            loop_inst_i = loop_inst_i + 1 as u32
                                            
                                        if copy_pos != 0 as u32:
                                            insert_inst_at(f, bi as u32, copy_pos, AirInst(
                                                opcode: OP_IMUL,
                                                type_id: inst.type_id,
                                                dest: step_mul_reg,
                                                src1: step_reg,
                                                src2: c_reg
                                            ))
                                            
                                            mut add_op := OP_IADD as u16
                                            if not is_add:
                                                add_op = OP_ISUB
                                                
                                            insert_inst_at(f, bi as u32, copy_pos + 1 as u32, AirInst(
                                                opcode: add_op,
                                                type_id: inst.type_id,
                                                dest: new_acc_reg,
                                                src1: acc_reg,
                                                src2: step_mul_reg
                                            ))
                                            
                                            insert_inst_at(f, bi as u32, copy_pos + 2 as u32, AirInst(
                                                opcode: OP_COPY,
                                                type_id: inst.type_id,
                                                dest: acc_reg,
                                                src1: new_acc_reg,
                                                src2: 0 as u32
                                            ))
                                            
                                            changed = true
                        inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    @free(def_block as ptr[u8])
    return changed

pub fn loop_unroll_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_block = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_block as ptr[void], 0xff as u8, (max_reg as i64 + 1 as i64) * 4 as i64)

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        mut inst_i := 0 as u32
        while inst_i < blk.instrs_len:
            let inst_idx = f.block_instrs.data[blk.instrs_start + inst_i]
            let inst = f.insts.data[inst_idx]
            if inst.opcode != OP_NOP and inst.dest != 0 as u32:
                def_block[inst.dest] = bi as u32
            inst_i = inst_i + 1 as u32
        bi = bi + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32

    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_ICONST and inst.dest != 0 as u32:
            let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
            vals[inst.dest] = ConstVal(known: true, val: full_val)
        i = i + 1 as i64

    mut changed := false
    mut next_reg := max_reg + 1 as u32

    bi = 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]
        if blk.loop_depth > 0 as u8:
            // UNIQUE dominating pre-header only (RFC 0025): exactly one predecessor
            // with lower loop_depth (all others are back-edges), and the header has
            // exactly two predecessors (pre-header + single back-edge). This is the
            // simple natural loop the single-block clone can reproduce; anything else
            // (multiple entries, irreducible, non-unique pre-header) is skipped.
            mut pre_header_id := 0xffffffff as u32
            mut ph_count := 0 as i64
            mut pred_i := 0 as u32
            while pred_i < blk.preds_len:
                let pred = f.block_preds.data[blk.preds_start + pred_i]
                if pred < f.blocks.len as u32:
                    if f.blocks.data[pred].loop_depth < blk.loop_depth:
                        pre_header_id = pred
                        ph_count = ph_count + 1 as i64
                pred_i = pred_i + 1 as u32

            if pre_header_id != 0xffffffff as u32 and ph_count == 1 as i64 and blk.preds_len == 2 as u32:
                mut cond_inst_idx := 0xffffffff as u32
                mut loop_body_block_id := 0xffffffff as u32
                mut exit_block_id := 0xffffffff as u32

                if blk.instrs_len > 0 as u32:
                    let final_inst_idx = f.block_instrs.data[blk.instrs_start + blk.instrs_len - 1 as u32]
                    let final_inst = f.insts.data[final_inst_idx]
                    if final_inst.opcode == OP_BRANCH:
                        cond_inst_idx = final_inst_idx
                        exit_block_id = final_inst.dest
                        loop_body_block_id = final_inst.src2

                if cond_inst_idx != 0xffffffff as u32 and loop_body_block_id < f.blocks.len as u32 and loop_body_block_id != bi as u32:
                    let cond_inst = f.insts.data[cond_inst_idx]
                    mut cmp_inst_idx := 0xffffffff as u32
                    mut inst_idx_i := blk.instrs_start
                    while inst_idx_i < blk.instrs_start + blk.instrs_len:
                        let idx = f.block_instrs.data[inst_idx_i]
                        let inst = f.insts.data[idx]
                        if inst.dest == cond_inst.src1 and (inst.opcode == OP_LT or inst.opcode == OP_LE):
                            cmp_inst_idx = idx
                            break
                        inst_idx_i = inst_idx_i + 1 as u32

                    if cmp_inst_idx != 0xffffffff as u32:
                        let cmp_inst = f.insts.data[cmp_inst_idx]
                        let iv_reg = cmp_inst.src1
                        let limit_reg = cmp_inst.src2

                        let limit_val_const = vals[limit_reg]
                        if limit_val_const.known:
                            let limit_val = limit_val_const.val
                            mut start_reg := 0 as u32
                            let ph_blk = f.blocks.data[pre_header_id]
                            mut ph_inst_i := 0 as u32
                            while ph_inst_i < ph_blk.instrs_len:
                                let ph_inst_idx = f.block_instrs.data[ph_blk.instrs_start + ph_inst_i]
                                let ph_inst = f.insts.data[ph_inst_idx]
                                if (ph_inst.opcode == OP_COPY or ph_inst.opcode == OP_MOVE) and ph_inst.dest == iv_reg:
                                    start_reg = ph_inst.src1
                                    break
                                elif ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                    start_reg = iv_reg
                                    break
                                ph_inst_i = ph_inst_i + 1 as u32

                            if start_reg != 0 as u32:
                                mut start_val := 0 as u64
                                mut start_known := false
                                if start_reg == iv_reg:
                                    let ph_blk2 = f.blocks.data[pre_header_id]
                                    mut ph_inst_i2 := 0 as u32
                                    while ph_inst_i2 < ph_blk2.instrs_len:
                                        let ph_inst_idx = f.block_instrs.data[ph_blk2.instrs_start + ph_inst_i2]
                                        let ph_inst = f.insts.data[ph_inst_idx]
                                        if ph_inst.opcode == OP_ICONST and ph_inst.dest == iv_reg:
                                            start_val = ((ph_inst.src2 as u64) << 32 as u64) | (ph_inst.src1 as u64)
                                            start_known = true
                                            break
                                        ph_inst_i2 = ph_inst_i2 + 1 as u32
                                else:
                                    let start_val_const = vals[start_reg]
                                    if start_val_const.known:
                                        start_val = start_val_const.val
                                        start_known = true

                                if start_known:
                                    mut step_val := 1 as u32
                                    let body_blk = f.blocks.data[loop_body_block_id]
                                    mut body_inst_i := 0 as u32
                                    while body_inst_i < body_blk.instrs_len:
                                        let b_inst_idx = f.block_instrs.data[body_blk.instrs_start + body_inst_i]
                                        let b_inst = f.insts.data[b_inst_idx]
                                        if b_inst.opcode == OP_IADD and (b_inst.src1 == iv_reg or b_inst.src2 == iv_reg):
                                            mut step_reg := b_inst.src2
                                            if b_inst.src2 == iv_reg:
                                                step_reg = b_inst.src1
                                            let step_val_const = vals[step_reg]
                                            if step_val_const.known:
                                                step_val = step_val_const.val as u32
                                                break
                                        body_inst_i = body_inst_i + 1 as u32

                                    let cmp_op = cmp_inst.opcode
                                    mut trip_count := 0 as u32
                                    if cmp_op == OP_LT:
                                        if limit_val > start_val and step_val > 0 as u32:
                                            trip_count = ((limit_val - start_val) / (step_val as u64)) as u32
                                    elif cmp_op == OP_LE:
                                        if limit_val >= start_val and step_val > 0 as u32:
                                            trip_count = ((limit_val - start_val) / (step_val as u64) + 1 as u64) as u32

                                    // SAFETY GATE (RFC 0025 / bug-o2-large-code): only
                                    // unroll a SINGLE-BLOCK body that jumps straight back
                                    // to the header, with NO nested control flow, calls,
                                    // side effects, or memory ops the single-block clone
                                    // cannot faithfully reproduce. (a) body's only
                                    // successor is the header; (b) no BRANCH (nested if),
                                    // CALL/SPAWN/SEND/SYSCALL (clobbers/effects), STORE/
                                    // SET_FIELD/FREE/DESTROY (memory effects the clone
                                    // would duplicate/misorder), or LOAD/INDEX/GET_FIELD
                                    // (may alias the mutated memory). Bail on anything not
                                    // provably a pure-register straight-line body.
                                    mut body_ok := true
                                    if body_blk.succs_len != 1 as u32:
                                        body_ok = false
                                    elif f.block_succs.data[body_blk.succs_start] != bi as u32:
                                        body_ok = false
                                    mut bchk := 0 as u32
                                    while body_ok and bchk < body_blk.instrs_len:
                                        let bi_idx = f.block_instrs.data[body_blk.instrs_start + bchk]
                                        let bop = f.insts.data[bi_idx].opcode
                                        if bop == OP_BRANCH or bop == OP_CALL or bop == OP_SPAWN or bop == OP_SEND or bop == OP_SYSCALL or bop == OP_RECV or bop == OP_AWAIT:
                                            body_ok = false
                                        elif bop == OP_STORE or bop == OP_SET_FIELD or bop == OP_FREE or bop == OP_DESTROY or bop == OP_ALIAS_REUSE:
                                            body_ok = false
                                        elif bop == OP_LOAD or bop == OP_INDEX or bop == OP_GET_FIELD or bop == OP_INDEX_ADDR or bop == OP_FIELD_ADDR or bop == OP_GLOBAL_ADDR or bop == OP_ALLOC:
                                            body_ok = false
                                        bchk = bchk + 1 as u32

                                    if body_ok and trip_count > 0 as u32 and trip_count <= 4 as u32:
                                        // SOUND full unroll on non-SSA AIR. `cur[r]` = the
                                        // register currently holding original reg r's value.
                                        // Initialised to identity and PERSISTED across
                                        // iterations, so a loop-carried value (an
                                        // accumulator `acc = acc + iv`) is threaded: each
                                        // iteration reads cur[acc] (the previous iteration's
                                        // fresh result) and writes a new cur[acc]. The old
                                        // pass reset the map every iteration, so iteration k
                                        // read the ORIGINAL acc (and even read its own fresh
                                        // dest before defining it) â†’ the miscompile that
                                        // segfaulted a -O2-built compiler.
                                        let cur = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
                                        mut ci := 0 as u32
                                        while ci <= max_reg:
                                            cur[ci] = ci
                                            ci = ci + 1 as u32

                                        mut iter := 0 as u32
                                        while iter < trip_count:
                                            let curr_iv_val = start_val + (iter as u64) * (step_val as u64)
                                            let temp_iv_reg = next_reg
                                            next_reg = next_reg + 1 as u32
                                            insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                opcode: OP_ICONST,
                                                type_id: 3 as u32,
                                                dest: temp_iv_reg,
                                                src1: (curr_iv_val & 0xFFFFFFFF as u64) as u32,
                                                src2: ((curr_iv_val >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                                            ))

                                            mut body_inst_i2 := 0 as u32
                                            while body_inst_i2 < body_blk.instrs_len:
                                                let b_inst_idx = f.block_instrs.data[body_blk.instrs_start + body_inst_i2]
                                                let b_inst = f.insts.data[b_inst_idx]
                                                if b_inst.opcode == OP_JUMP or b_inst.opcode == OP_BRANCH or b_inst.opcode == OP_NOP:
                                                    body_inst_i2 = body_inst_i2 + 1 as u32
                                                    continue

                                                // Read operands THROUGH cur[] (iv â†’ this
                                                // iteration's const). ICONST/FCONST pack
                                                // immediates in src1/src2 â€” never remap them.
                                                mut src1 := b_inst.src1
                                                if b_inst.opcode != OP_ICONST and b_inst.opcode != OP_FCONST:
                                                    if src1 == iv_reg:
                                                        src1 = temp_iv_reg
                                                    elif src1 != 0 as u32 and src1 <= max_reg:
                                                        src1 = cur[src1]

                                                mut src2 := b_inst.src2
                                                if b_inst.opcode != OP_ICONST and b_inst.opcode != OP_FCONST and b_inst.opcode != OP_BRANCH:
                                                    if src2 == iv_reg:
                                                        src2 = temp_iv_reg
                                                    elif src2 != 0 as u32 and src2 <= max_reg:
                                                        src2 = cur[src2]

                                                // Fresh dest, then publish it to cur AFTER
                                                // the reads above (so this instruction's own
                                                // sources still saw the prior value).
                                                mut dest := b_inst.dest
                                                if b_inst.dest != 0 as u32 and b_inst.dest != iv_reg:
                                                    dest = next_reg
                                                    next_reg = next_reg + 1 as u32

                                                insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                    opcode: b_inst.opcode,
                                                    type_id: b_inst.type_id,
                                                    dest: dest,
                                                    src1: src1,
                                                    src2: src2
                                                ))
                                                if b_inst.dest != 0 as u32 and b_inst.dest != iv_reg and b_inst.dest <= max_reg:
                                                    cur[b_inst.dest] = dest
                                                body_inst_i2 = body_inst_i2 + 1 as u32
                                            iter = iter + 1 as u32

                                        // Copy each body-defined register's FINAL value back
                                        // to its original name, so any post-loop read of it
                                        // sees the unrolled result. Over-copying a dead temp
                                        // is harmless (DCE removes it). Then set the induction
                                        // variable to its post-loop value (start + trip*step),
                                        // the value it holds when the original loop exits.
                                        mut cb := 0 as u32
                                        while cb < body_blk.instrs_len:
                                            let cb_idx = f.block_instrs.data[body_blk.instrs_start + cb]
                                            let cb_inst = f.insts.data[cb_idx]
                                            let od = cb_inst.dest
                                            if cb_inst.opcode != OP_NOP and od != 0 as u32 and od != iv_reg and od <= max_reg:
                                                if cur[od] != od:
                                                    insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                                        opcode: OP_COPY,
                                                        type_id: cb_inst.type_id,
                                                        dest: od,
                                                        src1: cur[od],
                                                        src2: 0 as u32
                                                    ))
                                                    cur[od] = od
                                            cb = cb + 1 as u32

                                        let final_iv_val = start_val + (trip_count as u64) * (step_val as u64)
                                        insert_inst_at(f, pre_header_id, f.blocks.data[pre_header_id].instrs_len - 1 as u32, AirInst(
                                            opcode: OP_ICONST,
                                            type_id: 3 as u32,
                                            dest: iv_reg,
                                            src1: (final_iv_val & 0xFFFFFFFF as u64) as u32,
                                            src2: ((final_iv_val >> 32 as u64) & 0xFFFFFFFF as u64) as u32
                                        ))

                                        @free(cur as ptr[u8])

                                        let ph_blk3 = &f.blocks.data[pre_header_id]
                                        let ph_final_idx = f.block_instrs.data[ph_blk3.instrs_start + ph_blk3.instrs_len - 1 as u32]
                                        mut ph_final := &f.insts.data[ph_final_idx]
                                        ph_final.opcode = OP_JUMP
                                        ph_final.src1 = exit_block_id
                                        ph_final.src2 = 0 as u32

                                        f.block_succs.data[ph_blk3.succs_start] = exit_block_id
                                        ph_blk3.succs_len = 1 as u32

                                        changed = true
                                        break
        bi = bi + 1 as i64

    @free(def_block as ptr[u8])
    @free(vals as ptr[u8])
    return changed

// Algebraic simplification pass:
// Handles identity operations (x+0, x*1, x/1), zero annihilation (x*0),
// self-ops (x-x=0, x^x=0, x&x=x), comparison tautologies (x==xâ†’1),
// and constant branch folding (branch(const)â†’jump).
pub fn alg_simp_func(f: ptr[AirFunc]) -> bool:
    let max_reg = max_reg_id(f)
    if max_reg == 0 as u32:
        return false

    let def_counts = @alloc((max_reg as i64 + 1 as i64) * 4 as i64) as ptr[u32]
    @memset(def_counts as ptr[void], 0 as u8, (max_reg as i64 + 1 as i64) * 4 as i64)
    mut i := 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode != OP_NOP and inst.dest != 0 as u32 and inst.opcode != OP_BRANCH:
            def_counts[inst.dest] = def_counts[inst.dest] + 1 as u32
        i = i + 1 as i64

    let vals = @alloc((max_reg as i64 + 1 as i64) * (@compiler_intrinsic("size_of")[ConstVal]() as i64)) as ptr[ConstVal]
    mut reg_idx := 0 as u32
    while reg_idx <= max_reg:
        vals[reg_idx] = ConstVal(known: false, val: 0 as u64)
        reg_idx = reg_idx + 1 as u32
    let addr_taken = mark_addr_taken_regs(f, max_reg)
    i = 0 as i64
    while i < f.insts.len:
        let inst = f.insts.data[i]
        if inst.opcode == OP_ICONST and inst.dest != 0 as u32:
            if def_counts[inst.dest] <= 1 as u32 and not addr_taken[inst.dest]:
                let full_val = ((inst.src2 as u64) << 32 as u64) | (inst.src1 as u64)
                vals[inst.dest] = ConstVal(known: true, val: full_val)
        i = i + 1 as i64

    mut changed := false
    i = 0 as i64
    while i < f.insts.len:
        mut inst := &f.insts.data[i]

        if inst.opcode == OP_IADD:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 0 as u64:
                    // x + 0 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                else:
                    let v1 = vals[inst.src1]
                    if v1.known and v1.val == 0 as u64:
                        // 0 + x = x
                        inst.opcode = OP_COPY
                        inst.src1 = inst.src2
                        inst.src2 = 0 as u32
                        changed = true

        elif inst.opcode == OP_ISUB:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x - x = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true
                else:
                    let v2 = vals[inst.src2]
                    if v2.known and v2.val == 0 as u64:
                        // x - 0 = x
                        inst.opcode = OP_COPY
                        inst.src2 = 0 as u32
                        changed = true

        elif inst.opcode == OP_IMUL:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                let v1 = vals[inst.src1]
                let v2 = vals[inst.src2]
                if (v2.known and v2.val == 0 as u64) or (v1.known and v1.val == 0 as u64):
                    // x * 0 = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true
                elif v2.known and v2.val == 1 as u64:
                    // x * 1 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                elif v1.known and v1.val == 1 as u64:
                    // 1 * x = x
                    inst.opcode = OP_COPY
                    inst.src1 = inst.src2
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_IDIV:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 1 as u64:
                    // x / 1 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_IMOD:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 1 as u64:
                    // x % 1 = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true

        elif inst.opcode == OP_AND:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x & x = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true
                else:
                    let v1 = vals[inst.src1]
                    let v2 = vals[inst.src2]
                    if (v1.known and v1.val == 0 as u64) or (v2.known and v2.val == 0 as u64):
                        // x & 0 = 0
                        inst.opcode = OP_ICONST
                        inst.src1 = 0 as u32
                        inst.src2 = 0 as u32
                        if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                            vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                        changed = true

        elif inst.opcode == OP_OR:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x | x = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_XOR:
            if inst.src1 != 0 as u32 and inst.src2 != 0 as u32:
                if inst.src1 == inst.src2:
                    // x ^ x = 0
                    inst.opcode = OP_ICONST
                    inst.src1 = 0 as u32
                    inst.src2 = 0 as u32
                    if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                        vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                    changed = true

        elif inst.opcode == OP_SHL or inst.opcode == OP_SHR:
            if inst.src2 != 0 as u32:
                let v2 = vals[inst.src2]
                if v2.known and v2.val == 0 as u64:
                    // x << 0 = x, x >> 0 = x
                    inst.opcode = OP_COPY
                    inst.src2 = 0 as u32
                    changed = true

        elif inst.opcode == OP_EQ:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x == x = true
                inst.opcode = OP_ICONST
                inst.src1 = 1 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 1 as u64)
                changed = true

        elif inst.opcode == OP_NE:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x != x = false
                inst.opcode = OP_ICONST
                inst.src1 = 0 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                changed = true

        elif inst.opcode == OP_LT or inst.opcode == OP_GT:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x < x = false, x > x = false
                inst.opcode = OP_ICONST
                inst.src1 = 0 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 0 as u64)
                changed = true

        elif inst.opcode == OP_LE or inst.opcode == OP_GE:
            if inst.src1 != 0 as u32 and inst.src1 == inst.src2:
                // x <= x = true, x >= x = true
                inst.opcode = OP_ICONST
                inst.src1 = 1 as u32
                inst.src2 = 0 as u32
                if inst.dest != 0 as u32 and def_counts[inst.dest] <= 1 as u32:
                    vals[inst.dest] = ConstVal(known: true, val: 1 as u64)
                changed = true

        elif inst.opcode == OP_BRANCH:
            // Constant branch folding: branch(known_const) -> jump
            if inst.src1 != 0 as u32:
                let cond_val = vals[inst.src1]
                if cond_val.known:
                    let true_blk = inst.src2
                    let false_blk = inst.dest
                    if cond_val.val != 0 as u64:
                        inst.opcode = OP_JUMP
                        inst.src1 = true_blk
                        inst.src2 = 0 as u32
                        inst.dest = 0 as u32
                    else:
                        inst.opcode = OP_JUMP
                        inst.src1 = false_blk
                        inst.src2 = 0 as u32
                        inst.dest = 0 as u32
                    changed = true

        i = i + 1 as i64

    @free(def_counts as ptr[u8])
    @free(vals as ptr[u8])
    @free(addr_taken as ptr[u8])
    return changed

// Per-basic-block Common Subexpression Elimination:
// Within each block, finds duplicate pure computations and replaces later
// occurrences with COPY of the first result, enabling DCE to remove the redundant
// computation.
pub fn cse_func(f: ptr[AirFunc]) -> bool:
    mut changed := false

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let blk = f.blocks.data[bi]

        mut i := 0 as u32
        while i < blk.instrs_len:
            let inst_idx_i = f.block_instrs.data[blk.instrs_start + i]
            let inst_i = f.insts.data[inst_idx_i]

            if inst_i.opcode == OP_NOP or inst_i.dest == 0 as u32 or has_side_effect(inst_i.opcode):
                i = i + 1 as u32
                continue
            if inst_i.opcode == OP_ICONST or inst_i.opcode == OP_FCONST:
                i = i + 1 as u32
                continue
            if not opcode_is_binary_alu(inst_i.opcode) and inst_i.opcode != OP_NEG and inst_i.opcode != OP_NOT:
                i = i + 1 as u32
                continue

            // Scan earlier instructions in this block for an identical
            // expression. CSE keys on (opcode, src1, src2) â€” sound ONLY while
            // neither source operand is redefined between the two instructions.
            // AIR is not strict SSA (a mutable local reuses one register), so
            // `b = b * b; b = b * b` lowers to `t1 = MUL b,b; b = COPY t1;
            // t2 = MUL b,b; b = COPY t2` â€” the two MULs look identical but the
            // second must recompute against the reassigned `b`. Scan DOWNWARD
            // from i and STOP at the first instruction that redefines src1 or
            // src2: any match beyond it would reuse a stale value (the silent
            // -O1 miscompile: second squaring became a no-op).
            mut j := (i as i64) - 1 as i64
            while j >= 0 as i64:
                let inst_idx_j = f.block_instrs.data[blk.instrs_start + (j as u32)]
                let inst_j = f.insts.data[inst_idx_j]
                // A redefinition of either source invalidates all earlier
                // candidates (check BEFORE matching so a self-referential
                // `b = <op> b` that redefines its own source is not reused).
                if inst_j.dest != 0 as u32 and (inst_j.dest == inst_i.src1 or inst_j.dest == inst_i.src2):
                    break
                if inst_j.opcode == inst_i.opcode and inst_j.src1 == inst_i.src1 and inst_j.src2 == inst_i.src2 and inst_j.dest != 0 as u32 and inst_j.opcode != OP_NOP:
                    mut cur_inst := &f.insts.data[inst_idx_i]
                    cur_inst.opcode = OP_COPY
                    cur_inst.src1 = inst_j.dest
                    cur_inst.src2 = 0 as u32
                    changed = true
                    break
                j = j - 1 as i64
            i = i + 1 as u32

        bi = bi + 1 as i64

    return changed

// Functions exceeding this instruction count skip expensive O(nÂ²) and
// structural passes (CSE, LICM, strength reduction, loop unrolling) to
// avoid blowing compilation time on giant switch-dispatch functions.
pub const OPT_LARGE_FUNC_THRESHOLD: i64 = 2000

// ============================================================================
// RFC 0026 â€” function INLINING (module-level pre-pass, before per-fn passes).
// Minimal first increment: inline only SMALL, SINGLE-BLOCK, PURE-SCALAR-
// ARITHMETIC, NON-RECURSIVE callees that never mutate a param. This sidesteps
// every memory/aggregate/control-flow/type hazard (see the design + hazard list
// in knowledge/m6-perf-gate-fib-benchmark.md "INLINER IMPLEMENTATION SPEC").
// The one synthesized instruction is the return->copy, whose type_id is the
// callee's real return type. Downstream fold/copy_prop/dce clean up the copies.
// ============================================================================
pub const INLINE_INST_THRESHOLD: i64 = 16
// RFC 0026 P2 â€” multi-block (control-flow) inliner caps. Kept small so the first
// increment stays a bounded, benchmark-relevant transform (collatz_len is ~5
// blocks / ~25 insts) and does not explode the compiler's own giant functions.
pub const INLINE_MB_BLOCK_THRESHOLD: i64 = 8
pub const INLINE_MB_INST_THRESHOLD: i64 = 48

// A callee-body opcode safe to clone: pure scalar const / copy / arithmetic /
// compare / convert (class 0x02xx) / return. Anything touching memory, fields,
// aggregates, calls, branches, or globals is rejected (callee not inlinable).
fn inline_op_ok(op: u16) -> bool:
    if op == OP_ICONST or op == OP_FCONST or op == OP_COPY or op == OP_RETURN:
        return true
    if op == OP_GET_FIELD:      // gated further to scalar fields of a param (see inl_is_inlinable)
        return true
    if op == OP_INDEX:          // gated further to a scalar element type (see inl_is_inlinable)
        return true
    if op >= 0x0201 as u16 and op <= 0x0223 as u16:
        return true
    return false

// AXIOM convention (air_builder.ax:288-295): AirFunc.params.data[i] holds the
// param's TYPE id; the param's VREG is (i + 1). We copy each arg into a fresh
// param vreg at the inline site, so param mutation is isolated (no clobber of
// the caller's arg) and no param-mutation guard is needed.

fn inl_is_inlinable(callee: ptr[AirFunc], table: ptr[TypeTable]) -> bool:
    if callee.is_extern or callee.is_async:
        return false
    if callee.blocks.len != 1 as i64:
        return false
    if callee.insts.len > INLINE_INST_THRESHOLD:
        return false
    let bb = &callee.blocks.data[0]
    mut nret := 0 as i64
    mut i := 0 as i64
    while i < bb.instrs_len as i64:
        let idx = callee.block_instrs.data[bb.instrs_start as i64 + i] as i64
        let inst = callee.insts.data[idx]
        if not inline_op_ok(inst.opcode):
            return false
        if inst.opcode == OP_RETURN:
            if inst.src1 == 0 as u32:      // void return: nothing to copy -> skip
                return false
            nret = nret + 1 as i64
        elif inst.opcode == OP_GET_FIELD:
            // Only a single-level SCALAR field read of a PARAM: src1 must be a
            // param vreg (1..params.len), whose struct type = params.data[src1-1];
            // the field must be scalar (<=8B, not aggregate, not a pointer-sum box).
            // src2 is the field INDEX (not a vreg).
            if inst.src1 < 1 as u32 or (inst.src1 as i64) > callee.params.len:
                return false
            let struct_type = callee.params.data[(inst.src1 as i64) - 1 as i64] as u32
            if field_is_aggregate(table, struct_type, inst.src2):
                return false
            if field_is_pointer_sum(table, struct_type, inst.src2):
                return false
            if field_size(table, struct_type, inst.src2) > 8 as u32:
                return false
        elif inst.opcode == OP_INDEX:
            // Array/collection element read. The element type is carried in
            // `type_id` (x86_selector.ax:542); require it resolved (nonzero) and
            // scalar (<=8B, not aggregate) so the inlined index loads a value, not
            // a by-address aggregate. Both operands (array ptr, index) are vregs.
            if inst.type_id == 0 as u16:
                return false
            let elem_ty = inst.type_id as u32
            if type_is_aggregate(table, elem_ty):
                return false
            mut esz := 0 as u32
            mut eal := 0 as u32
            type_size_and_align(table, elem_ty, &esz, &eal)
            if esz > 8 as u32:
                return false
        i = i + 1 as i64
    if nret != 1 as i64:
        return false
    return true

fn inl_find_callee(m: ptr[AirModule], sym: u32) -> i64:
    mut i := 0 as i64
    while i < m.funcs.len:
        if m.funcs.data[i].sym_id == sym:
            return i
        i = i + 1 as i64
    return -1 as i64

// returns the callee func index if `inst` is an inlinable DIRECT call, else -1
fn inl_call_target(inst: AirInst, caller: ptr[AirFunc], m: ptr[AirModule], table: ptr[TypeTable]) -> i64:
    if inst.opcode != OP_CALL:
        return -1 as i64
    if inst.src1 != 0 as u32:                 // indirect (fn-ptr) call
        return -1 as i64
    let ci = inl_find_callee(m, inst.type_id as u32)
    if ci < 0 as i64:
        return -1 as i64
    let callee = &m.funcs.data[ci]
    if callee.sym_id == caller.sym_id:         // never inline self-recursion
        return -1 as i64
    if not inl_is_inlinable(callee, table):
        return -1 as i64
    let arg_start = inst.src2
    if arg_start >= caller.extras.len as u32:
        return -1 as i64
    let argc = caller.extras.data[arg_start]
    if argc as i64 != callee.params.len:
        return -1 as i64
    return ci

// physical order == execution order iff every block references strictly-
// increasing inst indices in block order. If so a block-order rebuild is an
// order-preserving reindex; otherwise bail (leave the caller untouched).
fn inl_blocks_contiguous(f: ptr[AirFunc]) -> bool:
    if f.blocks.len == 0 as i64:
        return false
    mut prev := -1 as i64
    mut bi := 0 as i64
    while bi < f.blocks.len:
        let bb = &f.blocks.data[bi]
        mut k := 0 as i64
        while k < bb.instrs_len as i64:
            let idx = f.block_instrs.data[bb.instrs_start as i64 + k] as i64
            if idx <= prev:
                return false
            prev = idx
            k = k + 1 as i64
        bi = bi + 1 as i64
    return true

// rename a callee vreg for cloning into the caller: every callee vreg (params
// included) is offset by `base` into fresh caller vreg space. Args are wired via
// explicit param-copies emitted at the inline site (see inline_func).
fn inl_rename(v: u32, base: u32) -> u32:
    if v == 0 as u32:
        return 0 as u32
    return base + v

pub fn inline_func(mut caller: ptr[AirFunc], m: ptr[AirModule], table: ptr[TypeTable]) -> bool:
    if caller.is_extern:
        return false
    mut found := false
    mut i := 0 as i64
    while i < caller.insts.len:
        if inl_call_target(caller.insts.data[i], caller, m, table) >= 0 as i64:
            found = true
            i = caller.insts.len
        else:
            i = i + 1 as i64
    if not found:
        return false
    if not inl_blocks_contiguous(caller):
        return false

    mut fresh := max_reg_id(caller) + 1 as u32
    mut new_insts := new_air_inst_vec()
    mut new_bi := new_u32_vec()

    mut bi := 0 as i64
    while bi < caller.blocks.len:
        mut bb := &caller.blocks.data[bi]
        let new_start = new_bi.len as u32
        mut k := 0 as i64
        while k < bb.instrs_len as i64:
            let old_idx = caller.block_instrs.data[bb.instrs_start as i64 + k] as i64
            let inst = caller.insts.data[old_idx]
            let ci = inl_call_target(inst, caller, m, table)
            if ci >= 0 as i64:
                let callee = &m.funcs.data[ci]
                let base = fresh
                let arg_start = inst.src2
                // Wire args: copy each caller arg vreg into the callee's (offset)
                // param vreg. Param i has callee vreg (i+1); its type is params.data[i].
                mut pidx := 0 as i64
                while pidx < callee.params.len:
                    let argv = caller.extras.data[arg_start + 1 as u32 + pidx as u32]
                    let pcopy = AirInst(opcode: OP_COPY, type_id: callee.params.data[pidx] as u16, dest: base + (pidx as u32 + 1 as u32), src1: argv, src2: 0 as u32)
                    let ppc = new_insts.push(pcopy)
                    new_bi.push(ppc)
                    pidx = pidx + 1 as i64
                let cbb = &callee.blocks.data[0]
                mut j := 0 as i64
                while j < cbb.instrs_len as i64:
                    let cidx = callee.block_instrs.data[cbb.instrs_start as i64 + j] as i64
                    let cin = callee.insts.data[cidx]
                    if cin.opcode == OP_RETURN:
                        if inst.dest != 0 as u32:
                            let rv = inl_rename(cin.src1, base)
                            let cp = AirInst(opcode: OP_COPY, type_id: callee.ret_type as u16, dest: inst.dest, src1: rv, src2: 0 as u32)
                            let pp = new_insts.push(cp)
                            new_bi.push(pp)
                    else:
                        // Build a FRESH AirInst â€” `mut nn := cin` would ALIAS the
                        // callee's original inst (aggregates are by-reference in AXIOM),
                        // so mutating it corrupts the callee's own AIR body.
                        mut nd := cin.dest
                        if cin.dest != 0 as u32:
                            nd = base + cin.dest
                        mut ns1 := cin.src1
                        mut ns2 := cin.src2
                        if cin.opcode == OP_ICONST or cin.opcode == OP_FCONST:
                            // src1/src2 are immediate bits â€” keep verbatim
                            ns1 = cin.src1
                            ns2 = cin.src2
                        elif cin.opcode == OP_GET_FIELD:
                            ns1 = inl_rename(cin.src1, base)   // struct ptr vreg
                            ns2 = cin.src2                      // field INDEX â€” keep
                        else:
                            ns1 = inl_rename(cin.src1, base)
                            ns2 = inl_rename(cin.src2, base)
                        let nn = AirInst(opcode: cin.opcode, type_id: cin.type_id, dest: nd, src1: ns1, src2: ns2)
                        let pp = new_insts.push(nn)
                        new_bi.push(pp)
                    j = j + 1 as i64
                fresh = fresh + max_reg_id(callee) + 1 as u32
            else:
                let pp = new_insts.push(inst)
                new_bi.push(pp)
            k = k + 1 as i64
        bb.instrs_start = new_start
        bb.instrs_len = new_bi.len as u32 - new_start
        bi = bi + 1 as i64

    if caller.insts.data != null as ptr[AirInst]:
        @free(caller.insts.data as ptr[u8])
    if caller.block_instrs.data != null as ptr[u32]:
        @free(caller.block_instrs.data as ptr[u8])
    caller.insts = new_insts
    caller.block_instrs = new_bi
    return true

// ============================================================================
// RFC 0026 P2 â€” CONTROL-FLOW (multi-block) inliner.
// Inlines a small, MULTI-block callee (e.g. `collatz_len` with its while loop)
// by cloning its blocks into the caller: split the caller block at the call,
// clone every callee block with fresh block ids + vreg offset, remap terminator
// targets, turn each `return v` into `copy call.dest=v'; jump continuation`, and
// lay the result out in EXECUTION order (so the physical-order value passes stay
// valid). Caller original terminators reference caller block ids â†’ remapped via
// caller_newid[]; callee clone terminators reference callee-local ids â†’ remapped
// inline via clone_base. The CFG is rebuilt by recompute_cfg (caller in run()).
// First increment: scalar params/return only, whitelisted pure-scalar +
// control-flow body, NO nested calls / memory / aggregates / getters.
// ============================================================================

// Body opcode allowed in a multi-block clone: pure scalar const/copy/arithmetic,
// plus the control-flow terminators (JUMP/BRANCH/RETURN). Excludes calls, memory,
// fields, index, globals â€” kept out of this first increment.
fn inl_mb_op_ok(op: u16) -> bool:
    if op == OP_JUMP or op == OP_BRANCH or op == OP_RETURN:
        return true
    if op == OP_ICONST or op == OP_FCONST or op == OP_COPY:
        return true
    if op == OP_GET_FIELD:      // gated to a scalar field of a param (see inl_multiblock_ok)
        return true
    if op == OP_INDEX:          // gated to a scalar element type (see inl_multiblock_ok)
        return true
    if op >= 0x0201 as u16 and op <= 0x0223 as u16:
        return true
    return false

// Successors of a callee block (from its terminator) â€” used by the RPO DFS.
// JUMP -> [src1]; BRANCH -> [src2 (true), dest (false)]; RETURN/none -> [].
fn inl_block_term(callee: ptr[AirFunc], b: u32) -> AirInst:
    let bb = &callee.blocks.data[b as i64]
    if bb.instrs_len == 0 as u32:
        return AirInst(opcode: OP_NOP, type_id: 0 as u16, dest: 0 as u32, src1: 0 as u32, src2: 0 as u32)
    let last = callee.block_instrs.data[bb.instrs_start as i64 + (bb.instrs_len as i64) - 1 as i64] as i64
    return callee.insts.data[last]

// Post-order DFS from `b`, appending to `post`. RPO = reverse(post) gives an
// execution-order block layout so the physical-order value/regalloc passes stay
// correct after the callee's blocks are cloned into the caller (the callee's own
// block order may put a merge/exit block physically before its predecessors).
fn inl_rpo_dfs(callee: ptr[AirFunc], b: u32, mut visited: ptr[bool], mut post: ptr[U32Vec]):
    if visited[b]:
        return
    visited[b] = true
    let t = inl_block_term(callee, b)
    let nb = callee.blocks.len
    if t.opcode == OP_JUMP:
        if (t.src1 as i64) < nb:
            inl_rpo_dfs(callee, t.src1, visited, post)
    elif t.opcode == OP_BRANCH:
        if (t.src2 as i64) < nb:
            inl_rpo_dfs(callee, t.src2, visited, post)
        if (t.dest as i64) < nb:
            inl_rpo_dfs(callee, t.dest, visited, post)
    post.push(b)

// DFS from `b` detecting a BACK-EDGE (an edge to a node currently on the DFS
// path = a loop). color: 0=white 1=gray(on-path) 2=black(done). A gray successor
// => the callee has a loop. Index order is NOT a reliable loop signal (a callee's
// merge/exit block can sit at a low index with forward edges into it â€” e.g.
// floorf), so proper coloring is required.
fn inl_loop_dfs(callee: ptr[AirFunc], b: u32, mut color: ptr[u8]) -> bool:
    color[b] = 1 as u8
    let t = inl_block_term(callee, b)
    let nb = callee.blocks.len
    if t.opcode == OP_JUMP:
        if (t.src1 as i64) < nb:
            if color[t.src1] == 1 as u8:
                return true
            if color[t.src1] == 0 as u8 and inl_loop_dfs(callee, t.src1, color):
                return true
    elif t.opcode == OP_BRANCH:
        if (t.src2 as i64) < nb:
            if color[t.src2] == 1 as u8:
                return true
            if color[t.src2] == 0 as u8 and inl_loop_dfs(callee, t.src2, color):
                return true
        if (t.dest as i64) < nb:
            if color[t.dest] == 1 as u8:
                return true
            if color[t.dest] == 0 as u8 and inl_loop_dfs(callee, t.dest, color):
                return true
    color[b] = 2 as u8
    return false

// True if the callee's CFG contains a loop (any back-edge from the entry).
fn inl_has_loop(callee: ptr[AirFunc]) -> bool:
    let n = callee.blocks.len
    let color = @alloc(n) as ptr[u8]
    @memset(color as ptr[void], 0 as u8, n)
    let r = inl_loop_dfs(callee, 0 as u32, color)
    @free(color as ptr[u8])
    return r

fn inl_multiblock_ok(callee: ptr[AirFunc], table: ptr[TypeTable]) -> bool:
    if callee.is_extern or callee.is_async:
        return false
    if callee.blocks.len < 2 as i64:            // single-block handled by inline_func
        return false
    // A callee with its OWN loop pessimizes when inlined into a loop: the call is
    // amortized over the callee's iterations, so removing it saves little, while
    // the merged loop raises register pressure (measured: collatz +11%). Only
    // inline branchy (loop-free) multi-block callees â€” the call-dominated wins.
    if inl_has_loop(callee):
        return false
    if callee.blocks.len > INLINE_MB_BLOCK_THRESHOLD:
        return false
    if callee.insts.len > INLINE_MB_INST_THRESHOLD:
        return false
    // Params may be aggregate (struct/array) â€” needed for getter/index bodies that
    // read a scalar field/element of a param (single-block getter path already
    // allows this). The GET_FIELD/INDEX scalar gates below ensure only SCALAR
    // field/element VALUES are consumed.
    // scalar, non-void return
    if callee.ret_type == 0 as u32:
        return false
    if type_is_aggregate(table, callee.ret_type):
        return false
    mut rsz := 0 as u32
    mut ral := 0 as u32
    type_size_and_align(table, callee.ret_type, &rsz, &ral)
    if rsz > 8 as u32:
        return false
    // whitelist body + require at least one value return
    mut has_ret := false
    mut bi := 0 as i64
    while bi < callee.blocks.len:
        let bb = &callee.blocks.data[bi]
        mut k := 0 as i64
        while k < bb.instrs_len as i64:
            let idx = callee.block_instrs.data[bb.instrs_start as i64 + k] as i64
            let inst = callee.insts.data[idx]
            if not inl_mb_op_ok(inst.opcode):
                return false
            if inst.opcode == OP_RETURN:
                if inst.src1 == 0 as u32:        // void return -> defer
                    return false
                has_ret = true
            elif inst.opcode == OP_GET_FIELD:
                // single-level SCALAR field read of a PARAM (mirror single-block gate)
                if inst.src1 < 1 as u32 or (inst.src1 as i64) > callee.params.len:
                    return false
                let struct_type = callee.params.data[(inst.src1 as i64) - 1 as i64] as u32
                if field_is_aggregate(table, struct_type, inst.src2):
                    return false
                if field_is_pointer_sum(table, struct_type, inst.src2):
                    return false
                if field_size(table, struct_type, inst.src2) > 8 as u32:
                    return false
            elif inst.opcode == OP_INDEX:
                if inst.type_id == 0 as u16:
                    return false
                let elem_ty = inst.type_id as u32
                if type_is_aggregate(table, elem_ty):
                    return false
                mut esz := 0 as u32
                mut eal := 0 as u32
                type_size_and_align(table, elem_ty, &esz, &eal)
                if esz > 8 as u32:
                    return false
            k = k + 1 as i64
        bi = bi + 1 as i64
    return has_ret

// callee func index if `inst` is an inlinable DIRECT call to a MULTI-block callee, else -1
fn inl_mb_call_target(inst: AirInst, caller: ptr[AirFunc], m: ptr[AirModule], table: ptr[TypeTable]) -> i64:
    if inst.opcode != OP_CALL:
        return -1 as i64
    if inst.src1 != 0 as u32:                    // indirect (fn-ptr) call
        return -1 as i64
    if inst.dest == 0 as u32:                    // void call -> no return value to wire
        return -1 as i64
    let ci = inl_find_callee(m, inst.type_id as u32)
    if ci < 0 as i64:
        return -1 as i64
    let callee = &m.funcs.data[ci]
    if callee.sym_id == caller.sym_id:           // never inline self-recursion
        return -1 as i64
    if not inl_multiblock_ok(callee, table):
        return -1 as i64
    let arg_start = inst.src2
    if arg_start >= caller.extras.len as u32:
        return -1 as i64
    let argc = caller.extras.data[arg_start]
    if argc as i64 != callee.params.len:
        return -1 as i64
    return ci

pub fn inline_multiblock_func(mut caller: ptr[AirFunc], m: ptr[AirModule], table: ptr[TypeTable]) -> bool:
    if caller.is_extern:
        return false
    if caller.insts.len > OPT_LARGE_FUNC_THRESHOLD:   // skip huge callers (code explosion)
        return false
    mut found := false
    mut i := 0 as i64
    while i < caller.insts.len:
        if inl_mb_call_target(caller.insts.data[i], caller, m, table) >= 0 as i64:
            found = true
            break
        i = i + 1 as i64
    if not found:
        return false
    if not inl_blocks_contiguous(caller):
        return false

    let ncaller = caller.blocks.len
    let caller_newid = @alloc(ncaller * 4 as i64) as ptr[u32]
    mut fixups := new_u32_vec()               // new_insts indices of caller-original terminators

    mut new_insts := new_air_inst_vec()
    mut new_bi := new_u32_vec()
    mut new_blocks := new_basic_block_vec()
    mut fresh := max_reg_id(caller) + 1 as u32
    mut next_id := 0 as u32                    // == new_blocks.len, assigned as blocks open

    mut bi := 0 as i64
    while bi < ncaller:
        let cbb = &caller.blocks.data[bi]
        mut open_id := next_id
        next_id = next_id + 1 as u32
        mut open_start := new_bi.len as u32
        mut cur_is_entry := cbb.is_entry
        caller_newid[bi] = open_id

        mut k := 0 as i64
        while k < cbb.instrs_len as i64:
            let old_idx = caller.block_instrs.data[cbb.instrs_start as i64 + k] as i64
            let inst = caller.insts.data[old_idx]
            let ci = inl_mb_call_target(inst, caller, m, table)
            if ci >= 0 as i64:
                let callee = &m.funcs.data[ci]
                let base = fresh
                let arg_start = inst.src2
                // param copies into the current open block
                mut pidx := 0 as i64
                while pidx < callee.params.len:
                    let argv = caller.extras.data[arg_start + 1 as u32 + pidx as u32]
                    let pc = AirInst(opcode: OP_COPY, type_id: callee.params.data[pidx] as u16, dest: base + (pidx as u32 + 1 as u32), src1: argv, src2: 0 as u32)
                    let pci = new_insts.push(pc)
                    new_bi.push(pci)
                    pidx = pidx + 1 as i64
                // Reverse-post-order the callee blocks so the clone is laid out in
                // EXECUTION order (a callee merge/exit block can sit physically before
                // its predecessors â€” cloning that verbatim breaks the physical-order
                // value/regalloc passes). pos[j] = clone position of callee block j.
                let nblk = callee.blocks.len
                let visited = @alloc(nblk) as ptr[bool]
                @memset(visited as ptr[void], 0 as u8, nblk)
                let pos = @alloc(nblk * 4 as i64) as ptr[u32]
                @memset(pos as ptr[void], 0 as u8, nblk * 4 as i64)
                mut post := new_u32_vec()
                inl_rpo_dfs(callee, 0 as u32, visited, &post)
                let ncloned = post.len                          // reachable blocks (== nblk normally)
                mut pp := 0 as i64
                while pp < ncloned:
                    let blk_id = post.data[ncloned - 1 as i64 - pp]
                    pos[blk_id] = pp as u32
                    pp = pp + 1 as i64
                let clone_base = next_id
                let cont_id = clone_base + ncloned as u32
                // close head with a JUMP to the callee entry clone (RPO puts entry first)
                let hj = AirInst(opcode: OP_JUMP, type_id: 0 as u16, dest: 0 as u32, src1: clone_base + pos[0 as i64], src2: 0 as u32)
                let hji = new_insts.push(hj)
                new_bi.push(hji)
                new_blocks.push(BasicBlock(id: open_id, instrs_start: open_start, instrs_len: new_bi.len as u32 - open_start, succs_start: 0 as u32, succs_len: 0 as u32, preds_start: 0 as u32, preds_len: 0 as u32, loop_depth: 0 as u8, is_entry: cur_is_entry, is_exit: false))
                cur_is_entry = false
                // clone callee blocks in RPO order
                mut cp := 0 as i64
                while cp < ncloned:
                    let cbid = post.data[ncloned - 1 as i64 - cp] as i64
                    let clbb = &callee.blocks.data[cbid]
                    let cl_id = clone_base + cp as u32
                    next_id = next_id + 1 as u32
                    let cl_start = new_bi.len as u32
                    mut j := 0 as i64
                    while j < clbb.instrs_len as i64:
                        let cidx = callee.block_instrs.data[clbb.instrs_start as i64 + j] as i64
                        let cin = callee.insts.data[cidx]
                        if cin.opcode == OP_RETURN:
                            let rv = inl_rename(cin.src1, base)
                            let cp2 = AirInst(opcode: OP_COPY, type_id: callee.ret_type as u16, dest: inst.dest, src1: rv, src2: 0 as u32)
                            let cpi = new_insts.push(cp2)
                            new_bi.push(cpi)
                            let rj = AirInst(opcode: OP_JUMP, type_id: 0 as u16, dest: 0 as u32, src1: cont_id, src2: 0 as u32)
                            let rji = new_insts.push(rj)
                            new_bi.push(rji)
                        elif cin.opcode == OP_JUMP:
                            let nj = AirInst(opcode: OP_JUMP, type_id: 0 as u16, dest: 0 as u32, src1: clone_base + pos[cin.src1 as i64], src2: 0 as u32)
                            let nji = new_insts.push(nj)
                            new_bi.push(nji)
                        elif cin.opcode == OP_BRANCH:
                            // src1 = cond VREG (rename); src2 = true-target, dest = false-target (block ids -> RPO pos)
                            let nb = AirInst(opcode: OP_BRANCH, type_id: cin.type_id, dest: clone_base + pos[cin.dest as i64], src1: inl_rename(cin.src1, base), src2: clone_base + pos[cin.src2 as i64])
                            let nbi = new_insts.push(nb)
                            new_bi.push(nbi)
                        elif cin.opcode == OP_ICONST or cin.opcode == OP_FCONST:
                            mut nd := cin.dest
                            if cin.dest != 0 as u32:
                                nd = base + cin.dest
                            let nc = AirInst(opcode: cin.opcode, type_id: cin.type_id, dest: nd, src1: cin.src1, src2: cin.src2)
                            let nci = new_insts.push(nc)
                            new_bi.push(nci)
                        elif cin.opcode == OP_GET_FIELD:
                            // src1 = struct-ptr vreg (rename); src2 = field INDEX (keep verbatim)
                            mut ndg := cin.dest
                            if cin.dest != 0 as u32:
                                ndg = base + cin.dest
                            let ng = AirInst(opcode: OP_GET_FIELD, type_id: cin.type_id, dest: ndg, src1: inl_rename(cin.src1, base), src2: cin.src2)
                            let ngi = new_insts.push(ng)
                            new_bi.push(ngi)
                        else:
                            mut nd2 := cin.dest
                            if cin.dest != 0 as u32:
                                nd2 = base + cin.dest
                            let nn = AirInst(opcode: cin.opcode, type_id: cin.type_id, dest: nd2, src1: inl_rename(cin.src1, base), src2: inl_rename(cin.src2, base))
                            let nni = new_insts.push(nn)
                            new_bi.push(nni)
                        j = j + 1 as i64
                    new_blocks.push(BasicBlock(id: cl_id, instrs_start: cl_start, instrs_len: new_bi.len as u32 - cl_start, succs_start: 0 as u32, succs_len: 0 as u32, preds_start: 0 as u32, preds_len: 0 as u32, loop_depth: 0 as u8, is_entry: false, is_exit: false))
                    cp = cp + 1 as i64
                @free(visited as ptr[u8])
                @free(pos as ptr[u8])
                if post.data != null as ptr[u32]:
                    @free(post.data as ptr[u8])
                // advance past the clone's vregs â€” cover both body vregs and the
                // param vregs (a param unused in the body would otherwise be missed).
                mut adv := max_reg_id(callee)
                if callee.params.len as u32 > adv:
                    adv = callee.params.len as u32
                fresh = fresh + adv + 1 as u32
                // open the continuation block
                open_id = cont_id
                next_id = next_id + 1 as u32
                open_start = new_bi.len as u32
            else:
                let ni = new_insts.push(inst)
                new_bi.push(ni)
                if inst.opcode == OP_JUMP or inst.opcode == OP_BRANCH:
                    fixups.push(ni)
            k = k + 1 as i64

        // close the final block of caller block bi
        mut is_exit := false
        if new_bi.len as u32 > open_start:
            let li = new_bi.data[new_bi.len - 1 as i64] as i64
            if new_insts.data[li].opcode == OP_RETURN:
                is_exit = true
        new_blocks.push(BasicBlock(id: open_id, instrs_start: open_start, instrs_len: new_bi.len as u32 - open_start, succs_start: 0 as u32, succs_len: 0 as u32, preds_start: 0 as u32, preds_len: 0 as u32, loop_depth: 0 as u8, is_entry: cur_is_entry, is_exit: is_exit))
        bi = bi + 1 as i64

    // remap caller-original terminator targets (caller block id -> new head id)
    mut fx := 0 as i64
    while fx < fixups.len:
        let ii = fixups.data[fx] as i64
        mut term := &new_insts.data[ii]
        if term.opcode == OP_JUMP:
            if (term.src1 as i64) < ncaller:
                term.src1 = caller_newid[term.src1]
        elif term.opcode == OP_BRANCH:
            if (term.src2 as i64) < ncaller:
                term.src2 = caller_newid[term.src2]
            if (term.dest as i64) < ncaller:
                term.dest = caller_newid[term.dest]
        fx = fx + 1 as i64

    @free(caller_newid as ptr[u8])
    if caller.insts.data != null as ptr[AirInst]:
        @free(caller.insts.data as ptr[u8])
    if caller.block_instrs.data != null as ptr[u32]:
        @free(caller.block_instrs.data as ptr[u8])
    if caller.blocks.data != null as ptr[BasicBlock]:
        @free(caller.blocks.data as ptr[u8])
    caller.insts = new_insts
    caller.block_instrs = new_bi
    caller.blocks = new_blocks
    return true

// True if block `bi` ends with a TAIL self-call: `%r = call self(args)` immediately
// followed by the block-terminating `ret %r` (result used only by that return),
// direct call, argc == nparams. Writes the arg-list start to *arg_start_out.
fn sr_is_tail_block(f: ptr[AirFunc], bi: i64, arg_start_out: ptr[u32]) -> bool:
    let bb = &f.blocks.data[bi]
    if bb.instrs_len < 2 as u32:
        return false
    let last_idx = f.block_instrs.data[bb.instrs_start as i64 + (bb.instrs_len as i64) - 1 as i64] as i64
    let prev_idx = f.block_instrs.data[bb.instrs_start as i64 + (bb.instrs_len as i64) - 2 as i64] as i64
    let last = f.insts.data[last_idx]
    let prev = f.insts.data[prev_idx]
    if last.opcode != OP_RETURN or prev.opcode != OP_CALL:
        return false
    if prev.src1 != 0 as u32:                       // indirect call
        return false
    if prev.type_id as u32 != f.sym_id:             // not a SELF call
        return false
    if prev.dest == 0 as u32 or last.src1 != prev.dest:  // result not the returned value
        return false
    let as0 = prev.src2
    if as0 >= f.extras.len as u32:
        return false
    if f.extras.data[as0] as i64 != f.params.len:  // argc must match
        return false
    arg_start_out[0 as i64] = as0
    return true

// RFC 0026 Â§2b â€” TAIL-SELF-RECURSION -> LOOP. Rewrites `return self(args)` into
// `paramN = argN (staged via temps); jump entry(block 0)`, turning tail recursion
// into an in-function loop (one activation; no call/frame per iteration). Safe
// because emit_param_prologue runs BEFORE the .L_b_0 label (x86_selector option B),
// so re-entering block 0 does NOT re-materialize params from the incoming arg
// registers. The two-phase stage (args->temps->params) is REQUIRED so an arg that
// references a param isn't clobbered (e.g. a swap `f(b,a)`). MUST run AFTER the
// value passes (copy_prop would collapse `param=copy temp` â€” params have no other
// AIR def â€” and rewrite the entry's param reads to the loop-only temp). Adds a
// back-edge; the caller recomputes the CFG.
pub fn selfrec_to_loop(mut f: ptr[AirFunc]) -> bool:
    if f.is_extern or f.is_async:
        return false
    if f.blocks.len == 0 as i64:
        return false
    if f.params.len == 0 as i64:                    // no args to advance -> would be an infinite loop
        return false
    // NOTE: no contiguity guard â€” the rebuild re-lays-out block_instrs in block
    // order, and this pass runs LAST (no physical-order value pass follows), so a
    // non-contiguous layout (common for `if-return / else-tailcall`, where the
    // tail block sits at a low index but is emitted last) is fine.
    // any tail-self-call?
    mut as_tmp := 0 as u32
    mut any := false
    mut bi := 0 as i64
    while bi < f.blocks.len:
        if sr_is_tail_block(f, bi, &as_tmp):
            any = true
        bi = bi + 1 as i64
    if not any:
        return false

    let nparams = f.params.len
    mut fresh := max_reg_id(f) + 1 as u32
    mut new_insts := new_air_inst_vec()
    mut new_bi := new_u32_vec()
    bi = 0 as i64
    while bi < f.blocks.len:
        mut bb := &f.blocks.data[bi]
        let new_start = new_bi.len as u32
        mut arg_start := 0 as u32
        let is_tail = sr_is_tail_block(f, bi, &arg_start)
        let lim = bb.instrs_len as i64
        mut k := 0 as i64
        while k < lim:
            if is_tail and k == lim - 2 as i64:
                // replace the CALL (+ the following RET at k+1) with staging + jump
                let base = fresh
                mut p := 0 as i64
                while p < nparams:                  // phase 1: temp_i = arg_i
                    let argv = f.extras.data[arg_start + 1 as u32 + p as u32]
                    let c1 = AirInst(opcode: OP_COPY, type_id: f.params.data[p] as u16, dest: base + (p as u32 + 1 as u32), src1: argv, src2: 0 as u32)
                    let i1 = new_insts.push(c1)
                    new_bi.push(i1)
                    p = p + 1 as i64
                p = 0 as i64
                while p < nparams:                  // phase 2: param_i = temp_i
                    let c2 = AirInst(opcode: OP_COPY, type_id: f.params.data[p] as u16, dest: (p as u32 + 1 as u32), src1: base + (p as u32 + 1 as u32), src2: 0 as u32)
                    let i2 = new_insts.push(c2)
                    new_bi.push(i2)
                    p = p + 1 as i64
                fresh = fresh + nparams as u32 + 1 as u32
                let jj = AirInst(opcode: OP_JUMP, type_id: 0 as u16, dest: 0 as u32, src1: 0 as u32, src2: 0 as u32)
                let ji = new_insts.push(jj)
                new_bi.push(ji)
                k = k + 2 as i64                    // skip CALL and RET
            else:
                let idx = f.block_instrs.data[bb.instrs_start as i64 + k] as i64
                let pp = new_insts.push(f.insts.data[idx])
                new_bi.push(pp)
                k = k + 1 as i64
        bb.instrs_start = new_start
        bb.instrs_len = new_bi.len as u32 - new_start
        if is_tail:
            bb.is_exit = false                      // now ends in JUMP, not RETURN
        bi = bi + 1 as i64

    if f.insts.data != null as ptr[AirInst]:
        @free(f.insts.data as ptr[u8])
    if f.block_instrs.data != null as ptr[u32]:
        @free(f.block_instrs.data as ptr[u8])
    f.insts = new_insts
    f.block_instrs = new_bi
    return true

pub fn run(mut self: SsaOptimizer, mut m: ptr[AirModule], table: ptr[TypeTable]):
    mut fi := 0 as i64
    while fi < m.funcs.len:
        mut f := &m.funcs.data[fi]
        if not f.is_extern:
            // RFC 0026: inline small pure-arithmetic + scalar-getter helpers.
            if self.level >= 1 as u8:
                inline_func(f, m, table)
                // RFC 0026 P2: control-flow (multi-block) inliner. Rewrites the block
                // list, so it recomputes the CFG internally. Runs after the single-block
                // inliner (which removes single-block calls first).
                if inline_multiblock_func(f, m, table):
                    recompute_cfg(f)
            let is_large = f.insts.len > OPT_LARGE_FUNC_THRESHOLD

            // Structural passes: run once before iterative value passes.
            // LICM/strength-reduction/unrolling expose new constants that
            // the iterative loop below will clean up.
            if self.level >= 2 as u8 and not is_large:
                // Collapse copies BEFORE LICM so an invariant chain fully hoists. A
                // lowered `t1=a*b; t2=t1+c` emits `t1=imul; tc=copy t1; t2=iadd tc,c`;
                // without this, LICM (whitelist excludes OP_COPY) hoists only t1 â€” the
                // copy keeps t2's operand "in the loop". copy_prop rewrites t2 to use
                // t1 directly, so LICM's within-pass chaining then hoists t2 as well
                // (after hoisting t1, def_block[t1]=pre-header â†’ the direct-operand t2
                // is invariant). CFG-preserving, so loop_depths below stay valid.
                copy_prop_func(f)
                compute_loop_depths(f)
                licm_func(f) // RFC 0025: sound model-A LICM (single-def gate + whitelist + unique pre-header)
                strength_reduction_func(f)
                // RFC 0025: sound full unroll of const-trip (<=4) loops. Re-enabled
                // after rewriting the renaming: the OLD pass reset its rename map every
                // iteration, so a loop-carried accumulator (`acc = acc + iv`) read the
                // ORIGINAL acc each iteration (and read its own fresh dest before
                // defining it) â†’ a -O2-built compiler SEGFAULTED on every input
                // ([[bug-o2-large-code-miscompile]]). The new loop_unroll_func threads
                // values through a PERSISTENT cur[] map, copies each body-defined
                // register's final value back to its original name, sets the induction
                // variable to its post-loop value, and BAILS on any body containing a
                // branch (nested control flow it cannot clone). Gated on the same
                // -O2-self-compile acceptance test as LICM (self-build is -O1 = blind).
                loop_unroll_func(f)

            // Iterative value passes: fold â†’ simplify â†’ propagate â†’ eliminate.
            // Converges in 2-4 iterations for typical functions.
            mut iter := 0
            while iter < 6:
                mut changed := false

                if fold_func(f):
                    changed = true
                if alg_simp_func(f):
                    changed = true
                if copy_prop_func(f):
                    changed = true
                if not is_large:
                    if cse_func(f):
                        changed = true
                if dce_func(f):
                    changed = true

                if not changed:
                    break
                iter = iter + 1

            // RFC 0026 Â§2b â€” tail-self-recursion -> loop. Runs LAST (after the value
            // passes): copy_prop would otherwise collapse the synthesized
            // `param = copy temp` (params carry no other AIR def) and rewrite the
            // entry's param reads to the loop-only temp -> garbage on first entry.
            if self.level >= 1 as u8:
                if selfrec_to_loop(f):
                    recompute_cfg(f)
        fi = fi + 1 as i64
// bootstrap/stage1/cgen.ax
// SSA AIR to C11 Code Generator.


extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fclose(stream: ptr[void]) -> i32
extern "C" fn fputs(s: ptr[u8], stream: ptr[void]) -> i32
// extern "C" fn fprintf(stream: ptr[void], fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32

fn normalize_struct_cast(t_name: str) -> str:
    let len = std.string.len(t_name)
    mut i := len
    let ptr = get_str_ptr(t_name)
    while i > 0 and ptr[i - 1] == '*' as u8:
        i = i - 1
    let base = std.string.slice(t_name, 0, i)
    let res = @alloc(std.string.len(base) + 2) as ptr[u8]
    @memcpy(res, get_str_ptr(base), std.string.len(base))
    res[std.string.len(base)] = '*' as u8
    res[std.string.len(base) + 1] = 0 as u8
    if std.string.len(base) > 0 as i64 and get_str_ptr(base) != get_str_ptr(t_name):
        @free(get_str_ptr(base))
    return res as str

fn opcode_defines_dest(op: u16) -> bool:
    if op == 0 as u16: // OP_NOP
        return false
    if op == 0x0102 as u32: // OP_FREE
        return false
    if op == 0x010B as u16: // OP_DESTROY
        return false
    if op == 0x0104 as u16: // OP_STORE
        return false
    if op == 0x010E as u16: // OP_SET_FIELD
        return false
    if op == 0x0301 as u16: // OP_JUMP
        return false
    if op == 0x0302 as u16: // OP_BRANCH
        return false
    if op == 0x0304 as u16: // OP_RETURN
        return false
    return true

pub struct CGenerator:
    pub module: AirModule
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub file: ptr[void]
    pub reg_types: ptr[u32]

pub fn new_c_generator(mod: AirModule, tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable]) -> ptr[CGenerator]:
    let cg = @alloc(@compiler_intrinsic("size_of")[CGenerator]()) as ptr[CGenerator]
    cg.module = mod
    cg.tree = tree
    cg.pool = pool
    cg.symtable = symtable
    cg.typetable = typetable
    cg.file = null as ptr[void]
    cg.reg_types = null as ptr[u32]
    return cg

pub fn get_c_type(self: ptr[CGenerator], type_id: u32) -> str:
    if type_id == 1 as u32:
        return alloc_str("ax_i8")
    if type_id == 2 as u32:
        return alloc_str("ax_i16")
    if type_id == 3 as u32:
        return alloc_str("ax_i32")
    if type_id == 4 as u32:
        return alloc_str("ax_i64")
    if type_id == 5 as u32:
        return alloc_str("ax_u8")
    if type_id == 6 as u32:
        return alloc_str("ax_u16")
    if type_id == 7 as u32:
        return alloc_str("ax_u32")
    if type_id == 8 as u32:
        return alloc_str("ax_u64")
    if type_id == 9 as u32:
        return alloc_str("ax_f32")
    if type_id == 10 as u32:
        return alloc_str("ax_f64")
    if type_id == 11 as u32:
        return alloc_str("ax_bool")
    if type_id == 12 as u32:
        return alloc_str("ax_string")
    if type_id == 13 as u32:
        return alloc_str("ax_char")
    if type_id == 14 as u32:
        return alloc_str("void")
    if type_id == 15 as u32:
        return alloc_str("ax_isize")
    if type_id == 16 as u32:
        return alloc_str("ax_usize")
    if type_id == 21 as u32:
        return alloc_str("AxActorID")
    
    if (type_id as i64) < self.typetable.entries.len:
        let entry = self.typetable.entries.data[type_id]
        if entry.kind == TYPE_KIND_REF:
            return alloc_str("AxRef")
        if entry.kind == TYPE_KIND_POINTER:
            return alloc_str("void*")
        if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
            if entry.name_id != 0 as u32:
                let name = self.pool.get(entry.name_id)
                mut is_sum := false
                if entry.kind == TYPE_KIND_GENERIC_INST:
                    mut idx := 0 as i64
                    mut found_struct := false
                    while idx < self.typetable.entries.len:
                        let e = self.typetable.entries.data[idx]
                        if e.name_id == entry.name_id:
                            if e.kind == TYPE_KIND_STRUCT:
                                found_struct = true
                                break
                            elif e.kind == TYPE_KIND_SUM or e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
                                is_sum = true
                        idx = idx + 1
                    if not found_struct:
                        return alloc_str("void*")
                
                // Return struct pointer name
                mut res := @alloc(std.string.len(name) + 2) as ptr[u8]
                @memcpy(res, get_str_ptr(name), std.string.len(name))
                res[std.string.len(name)] = '*' as u8
                res[std.string.len(name) + 1] = 0 as u8
                return res as str
            return alloc_str("void*")
        if entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT:
            return alloc_str("void*")
        if entry.kind == TYPE_KIND_SLICE:
            return alloc_str("ax_slice_void")
    return alloc_str("void*")

pub fn is_stdlib_func(self: ptr[CGenerator], name: str) -> bool:
    if name == "system" or name == "remove" or name == "fopen" or name == "fclose" or name == "fseek" or name == "ftell" or name == "rewind" or name == "fread" or name == "fwrite" or name == "printf" or name == "puts" or name == "putchar" or name == "getchar" or name == "fgetc" or name == "fgets" or name == "fputc" or name == "fputs" or name == "sprintf" or name == "snprintf" or name == "fprintf" or name == "scanf" or name == "fscanf" or name == "sscanf" or name == "malloc" or name == "free" or name == "realloc" or name == "calloc" or name == "exit" or name == "abort" or name == "memset" or name == "memcpy" or name == "memmove" or name == "println" or name == "print" or name == "eprint" or name == "eprintln" or name == "assert" or name == "fflush" or name == "VirtualAlloc" or name == "VirtualFree" or name == "GetStdHandle" or name == "WriteFile" or name == "ReadFile" or name == "CreateFileA" or name == "CloseHandle" or name == "ExitProcess" or name == "GetLastError" or name == "GetFileAttributesA" or name == "CreateDirectoryA" or name == "RemoveDirectoryA" or name == "DeleteFileA" or name == "MoveFileA" or name == "CopyFileA" or name == "GetCommandLineW" or name == "GetCommandLineA" or name == "GetEnvironmentVariableA" or name == "SetEnvironmentVariableA" or name == "CreateProcessA" or name == "WaitForSingleObject" or name == "GetExitCodeProcess" or name == "TerminateProcess" or name == "strlen" or name == "atof" or name == "syscall" or name == "syscall0" or name == "syscall1" or name == "syscall2" or name == "syscall3" or name == "syscall4" or name == "syscall5" or name == "syscall6":
        return true
    
    let name_ptr = get_str_ptr(name)
    let len = std.string.len(name)
    if len >= 3 and name_ptr[0] == 'a' as u8 and name_ptr[1] == 'x' as u8 and name_ptr[2] == '_' as u8:
        if name == "ax_driver_load_module":
            return false
        return true
            
    return false

fn starts_with_std_string(s: str) -> bool:
    let len = std.string.len(s)
    if len < 11:
        return false
    let ptr = get_str_ptr(s)
    if ptr[0] == 's' as u8 and ptr[1] == 't' as u8 and ptr[2] == 'd' as u8 and ptr[3] == '.' as u8 and ptr[4] == 's' as u8 and ptr[5] == 't' as u8 and ptr[6] == 'r' as u8 and ptr[7] == 'i' as u8 and ptr[8] == 'n' as u8 and ptr[9] == 'g' as u8 and ptr[10] == '.' as u8:
        return true
    return false

fn cgen_starts_with(s: str, prefix: str) -> bool:
    let s_len = std.string.len(s)
    let p_len = std.string.len(prefix)
    if s_len < p_len:
        return false
    let s_ptr = get_str_ptr(s)
    let p_ptr = get_str_ptr(prefix)
    mut i := 0 as i64
    while i < p_len:
        if s_ptr[i] != p_ptr[i]:
            return false
        i = i + 1
    return true

fn alloc_str(s: str) -> str:
    let len = std.string.len(s)
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, get_str_ptr(s), len)
    buf[len] = 0 as u8
    return buf as str

fn cgen_contains(s: str, sub: str) -> bool:
    let s_len = std.string.len(s)
    let sub_len = std.string.len(sub)
    if s_len < sub_len:
        return false
    let s_ptr = get_str_ptr(s)
    let sub_ptr = get_str_ptr(sub)
    mut i := 0 as i64
    while i <= s_len - sub_len:
        mut j := 0 as i64
        mut matched := true
        while j < sub_len:
            if s_ptr[i + j] != sub_ptr[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn get_base_sum_name(sum_name: str) -> str:
    if cgen_contains(sum_name, "Result"):
        return "Result"
    if cgen_contains(sum_name, "Option"):
        return "Option"
    return sum_name

pub fn get_mangled_name_by_sym(self: ptr[CGenerator], sym_idx: u32) -> str:
    mut fn_name := "func"
    if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[sym_idx as i64]
        fn_name = self.pool.get(sym.name_id)
        

        if fn_name == "main":
            return alloc_str("ax_main_usr")

        if fn_name == "free":
            let is_extern = ((sym.flags & 4 as u16) != 0 as u16)
            if is_extern:
                return alloc_str("free")
            return alloc_str("ax_free")

        if starts_with_std_string(fn_name):
            let rest = std.string.slice(fn_name, 11, std.string.len(fn_name))
            let res_str = std.string.concat("ax_str_", rest)
            let ret_str = alloc_str(res_str)
            @free(get_str_ptr(res_str))
            return ret_str

        if self.is_stdlib_func(fn_name):
            let mangled = std.string.replace(fn_name, ".", "_")
            return alloc_str(mangled)

        let is_extern = ((sym.flags & 4 as u16) != 0 as u16)
        if is_extern:
            let mangled = std.string.replace(fn_name, ".", "_")
            return alloc_str(mangled)

        // BUG#50: cross-module same-name fn â€” emit unique "ax_<name>__m<idx>"
        // (mirror of x86_resolve_sym_name; both backends must agree).
        if (sym.flags & 2048 as u16) != 0 as u16:
            let base_len = std.string.len(fn_name)
            mut digits := @alloc(16) as ptr[u8]
            mut dval := sym_idx as i64
            mut dlen := 0
            if dval == 0 as i64:
                digits[0] = '0' as u8
                dlen = 1
            while dval > 0 as i64:
                digits[dlen] = ('0' as u8 + (dval % 10 as i64) as u8)
                dlen = dlen + 1
                dval = dval / 10 as i64
            let total = 3 + base_len + 3 + dlen
            mut mres := @alloc(total + 1) as ptr[u8]
            @memcpy(mres, "ax_" as ptr[u8], 3)
            @memcpy(((mres as u64) + 3 as u64) as ptr[u8], get_str_ptr(fn_name), base_len)
            @memcpy(((mres as u64) + 3 as u64 + base_len as u64) as ptr[u8], "__m" as ptr[u8], 3)
            mut mk := 0
            while mk < dlen:
                mres[3 + base_len + 3 + mk] = digits[dlen - 1 - mk]
                mk = mk + 1
            mres[total] = 0 as u8
            @free(digits)
            let mres_str = alloc_str_from_raw(mres, total)
            @free(mres)
            return mres_str

        if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.typetable.entries.len:
            let entry = self.typetable.entries.data[sym.type_id as i64]
            
            // Check if it is a variant constructor first (SYM_VARIANT is 5)
            if sym.kind == 5 as u8 or sym.kind == SYM_VARIANT:
                if (entry.kind == TYPE_KIND_SUM or entry.kind == TYPE_KIND_GENERIC_INST or entry.kind == TYPE_KIND_OPTION or entry.kind == TYPE_KIND_RESULT) and entry.name_id != 0 as u32:
                    let raw_sum_name = self.pool.get(entry.name_id)
                    let sum_name = get_base_sum_name(raw_sum_name)
                    mut lower_variant := ""
                    if fn_name == "Some" or cgen_starts_with(fn_name, "Some_"):
                        lower_variant = "some"
                    elif fn_name == "None" or cgen_starts_with(fn_name, "None_"):
                        lower_variant = "none"
                    elif fn_name == "Ok" or cgen_starts_with(fn_name, "Ok_"):
                        lower_variant = "ok"
                    elif fn_name == "Err" or cgen_starts_with(fn_name, "Err_"):
                        lower_variant = "err"
                    
                    if std.string.len(lower_variant) > 0 as i64:
                        let sum_len = std.string.len(sum_name)
                        let v_len = std.string.len(lower_variant)
                        let total_len = 3 + sum_len + 1 + v_len
                        mut res := @alloc(total_len + 1) as ptr[u8]
                        @memcpy(res, "ax_" as ptr[u8], 3)
                        let dest1 = ((res as u64) + 3 as u64) as ptr[u8]
                        @memcpy(dest1, get_str_ptr(sum_name), sum_len)
                        res[3 + sum_len] = '_' as u8
                        let dest2 = ((res as u64) + 3 as u64 + sum_len as u64 + 1 as u64) as ptr[u8]
                        @memcpy(dest2, lower_variant as ptr[u8], v_len)
                        res[total_len] = 0 as u8
                        
                        let res_str = res as str
                        let mangled = std.string.replace(res_str, ".", "_")
                        let ret_str = alloc_str(mangled)
                        @free(res)
                        return ret_str

            if entry.kind == TYPE_KIND_FUNC:
                let fi = self.typetable.funcs.data[entry.extra as i64]
                
                // Mangle sum type variant constructors (Ok, Err, Some, None) to avoid conflicts
                mut ret_type := fi.ret
                if (ret_type as i64) < self.typetable.entries.len:
                    mut r_entry := self.typetable.entries.data[ret_type as i64]
                    while r_entry.kind == TYPE_KIND_POINTER or r_entry.kind == TYPE_KIND_REF:
                        ret_type = r_entry.extra
                        r_entry = self.typetable.entries.data[ret_type as i64]
                    
                    if (r_entry.kind == TYPE_KIND_SUM or r_entry.kind == TYPE_KIND_GENERIC_INST or r_entry.kind == TYPE_KIND_OPTION or r_entry.kind == TYPE_KIND_RESULT) and r_entry.name_id != 0 as u32:
                        let raw_sum_name = self.pool.get(r_entry.name_id)
                        let sum_name = get_base_sum_name(raw_sum_name)
                        mut lower_variant := ""
                        if fn_name == "Some" or cgen_starts_with(fn_name, "Some_"):
                            lower_variant = "some"
                        elif fn_name == "None" or cgen_starts_with(fn_name, "None_"):
                            lower_variant = "none"
                        elif fn_name == "Ok" or cgen_starts_with(fn_name, "Ok_"):
                            lower_variant = "ok"
                        elif fn_name == "Err" or cgen_starts_with(fn_name, "Err_"):
                            lower_variant = "err"
                        
                        if std.string.len(lower_variant) > 0 as i64:
                            let sum_len = std.string.len(sum_name)
                            let v_len = std.string.len(lower_variant)
                            let total_len = 3 + sum_len + 1 + v_len
                            mut res := @alloc(total_len + 1) as ptr[u8]
                            @memcpy(res, "ax_" as ptr[u8], 3)
                            let dest1 = ((res as u64) + 3 as u64) as ptr[u8]
                            @memcpy(dest1, get_str_ptr(sum_name), sum_len)
                            res[3 + sum_len] = '_' as u8
                            let dest2 = ((res as u64) + 3 as u64 + sum_len as u64 + 1 as u64) as ptr[u8]
                            @memcpy(dest2, lower_variant as ptr[u8], v_len)
                            res[total_len] = 0 as u8
                            
                            let res_str = res as str
                            let mangled = std.string.replace(res_str, ".", "_")
                            let ret_str = alloc_str(mangled)
                            @free(res)
                            return ret_str

                if fi.params.len > 0 as i64:
                    mut first_param_type = fi.params.data[0]
                    mut p_entry = self.typetable.entries.data[first_param_type as i64]
                    while p_entry.kind == TYPE_KIND_POINTER or p_entry.kind == TYPE_KIND_REF:
                        first_param_type = p_entry.extra
                        p_entry = self.typetable.entries.data[first_param_type as i64]
                    
                    if (p_entry.kind == TYPE_KIND_STRUCT or p_entry.kind == TYPE_KIND_SUM or p_entry.kind == TYPE_KIND_GENERIC_INST or p_entry.kind == TYPE_KIND_OPTION or p_entry.kind == TYPE_KIND_RESULT) and p_entry.name_id != 0 as u32:
                        let struct_name = self.pool.get(p_entry.name_id)
                        let struct_len = std.string.len(struct_name)
                        let fn_len = std.string.len(fn_name)
                        let total_len = 3 + struct_len + 1 + fn_len
                        mut res := @alloc(total_len + 1) as ptr[u8]
                        @memcpy(res, "ax_" as ptr[u8], 3)
                        
                        let dest1 = ((res as u64) + 3 as u64) as ptr[u8]
                        @memcpy(dest1, get_str_ptr(struct_name), struct_len)
                        
                        res[3 + struct_len] = '_' as u8
                        
                        let dest2 = ((res as u64) + 3 as u64 + struct_len as u64 + 1 as u64) as ptr[u8]
                        @memcpy(dest2, get_str_ptr(fn_name), fn_len)
                        
                        res[total_len] = 0 as u8
                        
                        let res_str = res as str
                        let mangled = std.string.replace(res_str, ".", "_")
                        let ret_str = alloc_str(mangled)
                        @free(res)
                        return ret_str

    let fn_len = std.string.len(fn_name)
    mut res := @alloc(3 + fn_len + 1) as ptr[u8]
    @memcpy(res, "ax_" as ptr[u8], 3)
    let dest = ((res as u64) + 3 as u64) as ptr[u8]
    @memcpy(dest, get_str_ptr(fn_name), fn_len)
    res[3 + fn_len] = 0 as u8
    
    let res_str = res as str
    let mangled = std.string.replace(res_str, ".", "_")
    let ret_str = alloc_str(mangled)
    @free(res)
    return ret_str

fn str_to_null_terminated(s: str) -> ptr[u8]:
    let len = std.string.len(s)
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, s as ptr[u8], len)
    buf[len] = 0 as u8
    return buf

pub fn generate(mut self: ptr[CGenerator], out_filename: str) -> bool:
    let filename_nt = str_to_null_terminated(out_filename)
    self.file = fopen(filename_nt as ptr[void], get_str_ptr("w"))
    @free(filename_nt)
    if self.file == null as ptr[void]:
        return false

    mut has_main := false
    mut main_has_args := false
    mut main_param_count := 0 as i64
    mut fn_idx := 0 as i64
    while fn_idx < self.module.funcs.len:
        let f = self.module.funcs.data[fn_idx]
        let original_name = self.pool.get(f.name)
        if original_name == "main":
            has_main = true
            main_param_count = f.params.len
            if f.params.len > 0 as i64:
                main_has_args = true
        fn_idx = fn_idx + 1 as i64

    fputs(get_str_ptr("// Generated automatically by AXIOM AirCGen Stage 1\n"), self.file)
    fputs(get_str_ptr("#define AXIOM_SUMLAYOUT_POINTER\n"), self.file)
    if has_main:
        fputs(get_str_ptr("#define AX_EMIT_MAIN\n"), self.file)
        if main_has_args:
            fputs(get_str_ptr("#define AX_MAIN_WITH_ARGS\n"), self.file)
    fputs(get_str_ptr("#include \"ax_runtime.h\"\n"), self.file)
    fputs(get_str_ptr("#include \"ax_stdlib.h\"\n\n"), self.file)
    fputs(get_str_ptr("extern ax_i64 syscall(ax_u64 num, ...);\n\n"), self.file)
    fputs(get_str_ptr("#define ax_Result_ok(v) ({ \\\n    void* _ptr = ax_alloc(sizeof(v)); \\\n    *(__typeof__(v)*)_ptr = (v); \\\n    _ptr; \\\n})\n\n"), self.file)
    fputs(get_str_ptr("#define ax_Result_err(v) ({ \\\n    void* _ptr = ax_alloc(sizeof(v)); \\\n    *(__typeof__(v)*)_ptr = (v); \\\n    (void*)((ax_u64)_ptr | 1ULL); \\\n})\n\n"), self.file)
    fputs(get_str_ptr("#define ax_Option_some(v) ({ \\\n    void* _ptr = ax_alloc(sizeof(v)); \\\n    *(__typeof__(v)*)_ptr = (v); \\\n    _ptr; \\\n})\n\n"), self.file)
    fputs(get_str_ptr("#define ax_Option_none() ((void*)0)\n\n"), self.file)
    fputs(get_str_ptr("#define r_0 0\n\n"), self.file)

    // 1. Forward declare all structs
    fputs(get_str_ptr("// Forward Declarations\n"), self.file)
    mut i := 0 as i64
    while i < self.typetable.entries.len:
        let entry = self.typetable.entries.data[i]
        if (entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST) and entry.name_id != 0 as u32:
            let name = self.pool.get(entry.name_id)
            
            mut is_sum_inst := false
            if entry.kind == TYPE_KIND_GENERIC_INST:
                mut idx := 0 as i64
                mut found_struct := false
                while idx < self.typetable.entries.len:
                    let e = self.typetable.entries.data[idx]
                    if e.name_id == entry.name_id:
                        if e.kind == TYPE_KIND_STRUCT:
                            found_struct = true
                            break
                        elif e.kind == TYPE_KIND_SUM or e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
                            is_sum_inst = true
                    idx = idx + 1
                if not found_struct:
                    i = i + 1
                    continue

            mut already_declared := false
            mut prev_i := 0 as i64
            while prev_i < i:
                let prev_entry = self.typetable.entries.data[prev_i]
                if (prev_entry.kind == TYPE_KIND_STRUCT or prev_entry.kind == TYPE_KIND_GENERIC_INST) and prev_entry.name_id != 0 as u32:
                    let prev_name = self.pool.get(prev_entry.name_id)
                    if prev_name == name:
                        already_declared = true
                        break
                prev_i = prev_i + 1 as i64
                
            if not already_declared:
                ax_fprintf_local(self.file, "typedef struct %s %s;\n", (get_str_ptr(name)) as i64, (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        i = i + 1
    fputs(get_str_ptr("\n"), self.file)
 
    // 2. Define structures
    fputs(get_str_ptr("// Struct Definitions\n"), self.file)
    i = 0 as i64
    while i < self.typetable.entries.len:
        let entry = self.typetable.entries.data[i]
        if (entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST) and entry.name_id != 0 as u32:
            let name = self.pool.get(entry.name_id)
            
            mut is_sum_inst := false
            if entry.kind == TYPE_KIND_GENERIC_INST:
                mut idx := 0 as i64
                mut found_struct := false
                while idx < self.typetable.entries.len:
                    let e = self.typetable.entries.data[idx]
                    if e.name_id == entry.name_id:
                        if e.kind == TYPE_KIND_STRUCT:
                            found_struct = true
                            break
                        elif e.kind == TYPE_KIND_SUM or e.kind == TYPE_KIND_OPTION or e.kind == TYPE_KIND_RESULT:
                            is_sum_inst = true
                    idx = idx + 1
                if not found_struct:
                    i = i + 1
                    continue

            mut already_defined := false
            mut prev_i := 0 as i64
            while prev_i < i:
                let prev_entry = self.typetable.entries.data[prev_i]
                if (prev_entry.kind == TYPE_KIND_STRUCT or prev_entry.kind == TYPE_KIND_GENERIC_INST) and prev_entry.name_id != 0 as u32:
                    let prev_name = self.pool.get(prev_entry.name_id)
                    if prev_name == name:
                        already_defined = true
                        break
                prev_i = prev_i + 1 as i64
                
            if not already_defined:
                ax_fprintf_local(self.file, "struct %s {\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                let temp_si = self.typetable.structs.data[entry.extra as i64]
                ax_printf_local("[CGEN-DEBUG] struct definition name: %s kind=%d extra=%d fields_len=%d\n", get_str_ptr(name) as i64, entry.kind as i64, entry.extra as i64, temp_si.fields.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                mut struct_extra := entry.extra
                if entry.kind == TYPE_KIND_GENERIC_INST:
                    mut idx := 0 as i64
                    while idx < self.typetable.entries.len:
                        let e = self.typetable.entries.data[idx]
                        let e_base = extract_qualified_base_name(self.pool.get(e.name_id))
                        let entry_base = extract_qualified_base_name(self.pool.get(entry.name_id))
                        let name_match = (e_base == entry_base)
                        if e.kind == TYPE_KIND_STRUCT and name_match:
                            struct_extra = e.extra
                            break
                        idx = idx + 1
                let si = self.typetable.structs.data[struct_extra as i64]
                mut f_idx := 0 as i64
                while f_idx < si.fields.len:
                    let field = si.fields.data[f_idx]
                    let field_type = self.get_c_type(field.type_id)
                    ax_fprintf_local(self.file, "    %s f_%d;\n", (field_type as ptr[u8]) as i64, f_idx, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    f_idx = f_idx + 1 as i64
                fputs(get_str_ptr("};\n\n"), self.file)
        i = i + 1

    // 3. Function prototypes
    fputs(get_str_ptr("// Function Prototypes\n"), self.file)
    
    // Emit prototypes for all user-defined extern functions (like syscall) from the symbol table
    mut sym_idx_proto := 0 as i64
    while sym_idx_proto < self.symtable.symbols.len:
        let sym = self.symtable.symbols.data[sym_idx_proto]
        if sym.kind == 1 as u8: // SYM_FUNC
            let is_extern = ((sym.flags & 4 as u16) != 0 as u16)
            if is_extern:
                let original_name = self.pool.get(sym.name_id)
                if not self.is_stdlib_func(original_name):
                    if sym.type_id != 0 as u32 and (sym.type_id as i64) < self.typetable.entries.len:
                        let entry = self.typetable.entries.data[sym.type_id]
                        if entry.kind == TYPE_KIND_FUNC:
                            let fi = self.typetable.funcs.data[entry.extra as i64]
                            let ret_type = self.get_c_type(fi.ret)
                            ax_fprintf_local(self.file, "%s %s(", (get_str_ptr(ret_type)) as i64, (get_str_ptr(original_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            if fi.params.len == 0 as i64:
                                fputs(get_str_ptr("void"), self.file)
                            else:
                                mut p_idx := 0 as i64
                                while p_idx < fi.params.len:
                                    if p_idx > 0:
                                        fputs(get_str_ptr(", "), self.file)
                                    let param_type = self.get_c_type(fi.params.data[p_idx])
                                    ax_fprintf_local(self.file, "%s p_%d", (get_str_ptr(param_type)) as i64, p_idx, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                                    p_idx = p_idx + 1 as i64
                            fputs(get_str_ptr(");\n"), self.file)
                            @free(get_str_ptr(ret_type))
        sym_idx_proto = sym_idx_proto + 1 as i64

    mut f_idx := 0 as i64
    while f_idx < self.module.funcs.len:
        let f = self.module.funcs.data[f_idx]
        mut is_generic := false
        if f.sym_id != 0 as u32 and (f.sym_id as i64) < self.symtable.symbols.len:
            let sym = self.symtable.symbols.data[f.sym_id as i64]
            if (sym.flags & 1024 as u16) != 0 as u16 or (sym.decl_node != 0 as u32 and (self.tree.nodes.data[sym.decl_node].flags & 512 as u16) != 0 as u16):
                is_generic = true
        mut skip_proto := is_generic
        if f.is_extern:
            let original_name = self.pool.get(f.name)
            if self.is_stdlib_func(original_name):
                if original_name != "ax_ax_driver_load_module":
                    skip_proto = true
        if skip_proto:
            f_idx = f_idx + 1 as i64
        else:
            let original_name = self.pool.get(f.name)
            let mangled_name = self.get_mangled_name_by_sym(f.sym_id)
            let ret_type = self.get_c_type(f.ret_type)
            ax_fprintf_local(self.file, "%s %s(", (get_str_ptr(ret_type)) as i64, (get_str_ptr(mangled_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            if f.params.len == 0 as i64:
                fputs(get_str_ptr("void"), self.file)
            else:
                mut p_idx := 0 as i64
                while p_idx < f.params.len:
                    if p_idx > 0:
                        fputs(get_str_ptr(", "), self.file)
                    mut param_type := self.get_c_type(f.params.data[p_idx])
                    if original_name == "main" and p_idx == 1 as i64:
                        param_type = "ax_u8**"
                    ax_fprintf_local(self.file, "%s p_%d", (get_str_ptr(param_type)) as i64, p_idx, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    p_idx = p_idx + 1 as i64
            fputs(get_str_ptr(");\n"), self.file)
            @free(get_str_ptr(mangled_name))
            f_idx = f_idx + 1 as i64
    fputs(get_str_ptr("\n"), self.file)

    // 4. Function definitions
    fputs(get_str_ptr("// Function Definitions\n"), self.file)
    f_idx = 0
    while f_idx < self.module.funcs.len:
        let f = self.module.funcs.data[f_idx]
        mut is_generic := false
        if f.sym_id != 0 as u32 and (f.sym_id as i64) < self.symtable.symbols.len:
            let sym = self.symtable.symbols.data[f.sym_id as i64]
            if (sym.flags & 1024 as u16) != 0 as u16 or (sym.decl_node != 0 as u32 and (self.tree.nodes.data[sym.decl_node].flags & 512 as u16) != 0 as u16):
                is_generic = true
        if f.is_extern or is_generic:
            f_idx = f_idx + 1 as i64
        else:
            let original_name = self.pool.get(f.name)
            let mangled_name = self.get_mangled_name_by_sym(f.sym_id)
            let ret_type = self.get_c_type(f.ret_type)
            
            ax_fprintf_local(self.file, "%s %s(", (get_str_ptr(ret_type)) as i64, (get_str_ptr(mangled_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            if f.params.len == 0 as i64:
                fputs(get_str_ptr("void"), self.file)
            else:
                mut p_idx := 0 as i64
                while p_idx < f.params.len:
                    if p_idx > 0:
                        fputs(get_str_ptr(", "), self.file)
                    mut param_type := self.get_c_type(f.params.data[p_idx])
                    if original_name == "main" and p_idx == 1 as i64:
                        param_type = "ax_u8**"
                    ax_fprintf_local(self.file, "%s p_%d", (get_str_ptr(param_type)) as i64, p_idx, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    p_idx = p_idx + 1 as i64
            fputs(get_str_ptr(") {\n"), self.file)
            @free(get_str_ptr(mangled_name))

            // Declare all SSA registers
            // First scan to collect maximum registers
            mut max_reg := 0 as u32
            if f.params.data != null as ptr[u32]:
                max_reg = f.params.len as u32
            mut inst_idx := 0 as i64
            while inst_idx < f.insts.len:
                let inst = f.insts.data[inst_idx]
                if inst.dest > max_reg and inst.dest < 1000000 as u32:
                    max_reg = inst.dest
                
                mut scan_src1 := true
                mut scan_src2 := true
                let op = inst.opcode
                if op == 0x0201 as u16 or op == 0x0202 as u16: // OP_ICONST, OP_FCONST
                    scan_src1 = false
                    scan_src2 = false
                elif op == OP_FUNC_ADDR: // src1 = function symbol index, not a register
                    scan_src1 = false
                    scan_src2 = false
                elif op == 0x010D as u16 or op == 0x010E as u16: // OP_GET_FIELD, OP_SET_FIELD
                    scan_src2 = false

                if scan_src1 and inst.src1 > max_reg and inst.src1 < 1000000 as u32:
                    max_reg = inst.src1
                if scan_src2 and inst.src2 > max_reg and inst.src2 < 1000000 as u32:
                    max_reg = inst.src2
                inst_idx = inst_idx + 1

            // Initialize register array types dynamically
            if max_reg > 0 as u32:
                self.reg_types = @alloc((max_reg as i64 + 1) * 4) as ptr[u32]
                mut r := 0 as i64
                while r <= max_reg as i64:
                    self.reg_types[r] = 0 as u32
                    r = r + 1

                // Pre-populate parameter register types
                if f.params.data != null as ptr[u32]:
                    mut p_idx := 0 as i64
                    while p_idx < f.params.len:
                        let p_reg = (p_idx + 1) as u32
                        if p_reg <= max_reg:
                            self.reg_types[p_reg] = f.params.data[p_idx]
                        p_idx = p_idx + 1

                inst_idx = 0
                while inst_idx < f.insts.len:
                    let inst = f.insts.data[inst_idx]
                    if opcode_defines_dest(inst.opcode) and inst.dest > 0 as u32:
                        mut t_id := inst.type_id as u32
                        if inst.opcode == 0x010D as u16: // OP_GET_FIELD
                            mut obj_type_id = inst.type_id as u32
                            if obj_type_id == 0 as u32 and inst.src1 > 0 as u32:
                                obj_type_id = self.reg_types[inst.src1]
                            if obj_type_id == 12 as u32:
                                if inst.src2 == 0 as u32:
                                    t_id = 0 as u32
                                else:
                                    t_id = 4 as u32
                            elif (obj_type_id as i64) < self.typetable.entries.len:
                                mut entry = self.typetable.entries.data[obj_type_id]
                                if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_REF:
                                    let pointee_id = entry.extra
                                    if pointee_id != 0 as u32 and (pointee_id as i64) < self.typetable.entries.len:
                                        entry = self.typetable.entries.data[pointee_id]
                                if entry.kind == TYPE_KIND_STRUCT or entry.kind == TYPE_KIND_GENERIC_INST:
                                    mut struct_extra := entry.extra
                                    if entry.kind == TYPE_KIND_GENERIC_INST:
                                        mut idx := 0 as i64
                                        while idx < self.typetable.entries.len:
                                            let e = self.typetable.entries.data[idx]
                                            if e.kind == TYPE_KIND_STRUCT and e.name_id == entry.name_id:
                                                struct_extra = e.extra
                                                break
                                            idx = idx + 1
                                    let si = self.typetable.structs.data[struct_extra as i64]
                                    if (inst.src2 as i64) < si.fields.len:
                                        t_id = si.fields.data[inst.src2 as i64].type_id
                                else:
                                    t_id = 0 as u32
                        elif (inst.opcode == 0x0105 as u16 or inst.opcode == 0x0109 as u16 or inst.opcode == 0x010F as u16) and t_id == 0 as u32: // OP_INDEX, OP_GEP or OP_DEREF
                            if inst.src1 > 0 as u32 and self.reg_types[inst.src1] != 0 as u32:
                                let src_type = self.reg_types[inst.src1]
                                if src_type == 12 as u32: // str
                                    t_id = 5 as u32 // u8
                                elif (src_type as i64) < self.typetable.entries.len:
                                    let entry = self.typetable.entries.data[src_type]
                                    if entry.kind == TYPE_KIND_POINTER or entry.kind == TYPE_KIND_SLICE or entry.kind == TYPE_KIND_ARRAY:
                                        t_id = entry.extra
                        elif inst.opcode == 0x0103 as u16: // OP_LOAD
                            if inst.src1 > 0 as u32 and self.reg_types[inst.src1] != 0 as u32:
                                let src_type = self.reg_types[inst.src1]
                                if (src_type as i64) < self.typetable.entries.len:
                                    let entry = self.typetable.entries.data[src_type]
                                    if entry.kind == TYPE_KIND_POINTER:
                                        t_id = entry.extra
                        elif inst.opcode == 0x0105 as u16: // OP_GEP
                            if inst.src1 > 0 as u32:
                                t_id = self.reg_types[inst.src1]
                        elif inst.opcode == 0x0106 as u16 or inst.opcode == 0x0107 as u16 or inst.opcode == 0x010C as u16: // OP_COPY, OP_MOVE, OP_ALIAS_REUSE
                            if inst.src1 > 0 as u32:
                                t_id = self.reg_types[inst.src1]
                        elif inst.opcode == 0x0201 as u16 or inst.opcode == 0x0202 as u16: // OP_ICONST, OP_FCONST
                            t_id = inst.type_id as u32
                        elif inst.opcode >= 0x020C as u16 and inst.opcode <= 0x0211 as u16: // OP_EQ to OP_GE (comparisons)
                            t_id = 11 as u32 // TYPE_BOOL (11)
                        elif inst.opcode >= 0x0203 as u16 and inst.opcode <= 0x0216 as u16: // OP_IADD to OP_SHR (binary ALU)
                            if inst.src1 > 0 as u32:
                                t_id = self.reg_types[inst.src1]
                        elif inst.opcode == 0x0217 as u16 or inst.opcode == 0x021D as u16: // OP_NOT, OP_NEG (unary ALU)
                            if inst.src1 > 0 as u32:
                                t_id = self.reg_types[inst.src1]
                        elif inst.opcode == 0x0223 as u16: // OP_CAST
                            t_id = inst.type_id as u32
                        elif inst.opcode == OP_CALL: // OP_CALL
                            if inst.src1 > 0 as u32:
                                t_id = inst.type_id as u32
                            else:
                                let sym_idx = inst.type_id as u32
                                if sym_idx != 0 as u32 and (sym_idx as i64) < self.symtable.symbols.len:
                                    let sym = self.symtable.symbols.data[sym_idx as i64]
                                    let fn_name = self.pool.get(sym.name_id)
                                    if fn_name == "println" or fn_name == "print" or fn_name == "eprint" or fn_name == "eprintln" or fn_name == "assert" or fn_name == "free" or fn_name == "panic":
                                        t_id = 14 as u32
                                    elif fn_name == "compiler_intrinsic":
                                        t_id = f.ret_type
                                    elif fn_name == "memcpy" or fn_name == "memmove" or fn_name == "memset" or fn_name == "ax_alloc" or fn_name == "alloc" or fn_name == "malloc" or fn_name == "realloc" or fn_name == "calloc":
                                        t_id = 0 as u32
                                    elif fn_name == "std.string.slice" or fn_name == "std.string.concat" or fn_name == "std.string.replace" or fn_name == "str_slice" or fn_name == "str_concat" or fn_name == "str_trim" or fn_name == "to_str":
                                        t_id = 12 as u32 // TYPE_STR (12)
                                    elif fn_name == "str_contains" or fn_name == "str_starts_with" or fn_name == "str_ends_with" or fn_name == "str_eq":
                                        t_id = 11 as u32 // TYPE_BOOL (11)
                                    elif fn_name == "len" or fn_name == "std.string.len" or fn_name == "strlen" or fn_name == "std.string.len_str" or fn_name == "str_len" or fn_name == "str_char_count" or fn_name == "str_index_of":
                                        t_id = 4 as u32 // TYPE_I64
                                    elif fn_name == "ax_puts_local" or fn_name == "fputs" or fn_name == "fclose" or fn_name == "fflush":
                                        t_id = 3 as u32 // TYPE_I32
                                    else:
                                        let fn_type_id = sym.type_id
                                        if fn_type_id != 0 as u32 and (fn_type_id as i64) < self.typetable.entries.len:
                                            let entry = self.typetable.entries.data[fn_type_id]
                                            if entry.kind == TYPE_KIND_FUNC:
                                                let fi = self.typetable.funcs.data[entry.extra as i64]
                                                t_id = fi.ret
                        self.reg_types[inst.dest] = t_id
                    inst_idx = inst_idx + 1

                // Print register declarations
                r = 1
                while r <= max_reg as i64:
                    if self.reg_types[r] != 14 as u32:
                        let t_name = self.get_c_type(self.reg_types[r])
                        ax_fprintf_local(self.file, "    %s r_%d = {0};\n", (get_str_ptr(t_name)) as i64, r, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    r = r + 1

                // Copy parameters to registers
                if f.params.data != null as ptr[u32]:
                    mut p_idx := 0 as i64
                    while p_idx < f.params.len:
                        let r_idx = (p_idx + 1) as i64
                        ax_fprintf_local(self.file, "    r_%d = p_%d;\n", r_idx, p_idx, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        p_idx = p_idx + 1

            // Generate C statements block-by-block
            mut b_idx := 0 as i64
            while b_idx < f.blocks.len:
                let bb = f.blocks.data[b_idx]
                ax_fprintf_local(self.file, "block_%d: ;\n", bb.id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

                mut inst_offset := 0 as i64
                while inst_offset < bb.instrs_len as i64:
                    let inst_pos = f.block_instrs.data[bb.instrs_start as i64 + inst_offset]
                    let inst = f.insts.data[inst_pos as i64]
                    self.translate_inst(f, inst)
                    inst_offset = inst_offset + 1 as i64
                b_idx = b_idx + 1 as i64

            if max_reg > 0 as u32:
                @free(self.reg_types as ptr[u8])
                self.reg_types = null as ptr[u32]

            fputs(get_str_ptr("}\n\n"), self.file)
            f_idx = f_idx + 1 as i64

    if has_main:
        fputs(get_str_ptr("\n/* Entry point wrapper */\n"), self.file)
        if main_has_args:
            ax_fprintf_local(self.file, "ax_i32 ax_main(ax_i32 argc, ax_u8** argv) {\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            if main_param_count == 1 as i64:
                ax_fprintf_local(self.file, "    ax_main_usr(argc);\n    return 0;\n}\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(self.file, "    ax_main_usr(argc, argv);\n    return 0;\n}\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_fprintf_local(self.file, "ax_i32 ax_main(void) {\n    ax_main_usr();\n    return 0;\n}\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    fclose(self.file)
    return true

fn cgen_escape_string(s: str) -> str:
    let len = std.string.len(s)
    let s_ptr = get_str_ptr(s)
    let buf = @alloc(len * 2 + 1) as ptr[u8]
    mut i := 0 as i64
    mut dest_idx := 0 as i64
    while i < len:
        let c = s_ptr[i]
        if c == 10 as u8:
            buf[dest_idx] = '\\' as u8
            buf[dest_idx + 1] = 'n' as u8
            dest_idx = dest_idx + 2
        elif c == 13 as u8:
            buf[dest_idx] = '\\' as u8
            buf[dest_idx + 1] = 'r' as u8
            dest_idx = dest_idx + 2
        elif c == 9 as u8:
            buf[dest_idx] = '\\' as u8
            buf[dest_idx + 1] = 't' as u8
            dest_idx = dest_idx + 2
        elif c == 34 as u8:
            buf[dest_idx] = '\\' as u8
            buf[dest_idx + 1] = '"' as u8
            dest_idx = dest_idx + 2
        elif c == 92 as u8:
            if i + 1 < len:
                let next_c = s_ptr[i + 1]
                if next_c == 'n' as u8 or next_c == 't' as u8 or next_c == 'r' as u8 or next_c == '\\' as u8 or next_c == '"' as u8 or next_c == '\'' as u8 or next_c == '0' as u8:
                    buf[dest_idx] = '\\' as u8
                    buf[dest_idx + 1] = next_c
                    dest_idx = dest_idx + 2
                    i = i + 1
                elif next_c == 'x' as u8:
                    if i + 3 < len:
                        buf[dest_idx] = '\\' as u8
                        buf[dest_idx + 1] = 'x' as u8
                        buf[dest_idx + 2] = s_ptr[i + 2]
                        buf[dest_idx + 3] = s_ptr[i + 3]
                        dest_idx = dest_idx + 4
                        i = i + 3
                    else:
                        buf[dest_idx] = '\\' as u8
                        buf[dest_idx + 1] = 'x' as u8
                        dest_idx = dest_idx + 2
                        i = i + 1
                elif next_c == 'u' as u8:
                    if i + 5 < len:
                        buf[dest_idx] = '\\' as u8
                        buf[dest_idx + 1] = 'u' as u8
                        buf[dest_idx + 2] = s_ptr[i + 2]
                        buf[dest_idx + 3] = s_ptr[i + 3]
                        buf[dest_idx + 4] = s_ptr[i + 4]
                        buf[dest_idx + 5] = s_ptr[i + 5]
                        dest_idx = dest_idx + 6
                        i = i + 5
                    else:
                        buf[dest_idx] = '\\' as u8
                        buf[dest_idx + 1] = 'u' as u8
                        dest_idx = dest_idx + 2
                        i = i + 1
                else:
                    buf[dest_idx] = '\\' as u8
                    buf[dest_idx + 1] = next_c
                    dest_idx = dest_idx + 2
                    i = i + 1
            else:
                buf[dest_idx] = '\\' as u8
                buf[dest_idx + 1] = '\\' as u8
                dest_idx = dest_idx + 2
        else:
            buf[dest_idx] = c
            dest_idx = dest_idx + 1
        i = i + 1
    buf[dest_idx] = 0 as u8
    return buf as str

pub fn translate_inst(mut self: ptr[CGenerator], f: AirFunc, inst: AirInst):
    let op = inst.opcode
    if op == OP_NOP:
        return

    if op == OP_ICONST:
        if inst.type_id == 12 as u32: // string
            let str_val = self.pool.get(inst.src1)
            mut val_ptr = str_val as ptr[u8]
            mut val_len = std.string.len(str_val)
            mut is_stripped := false
            if val_len >= 2 as i64 and val_ptr[0] == '"' as u8 and val_ptr[val_len - 1] == '"' as u8:
                val_ptr = ((val_ptr as u64) + 1 as u64) as ptr[u8]
                val_len = val_len - 2 as i64
                is_stripped = true
            
            mut print_buf := val_ptr
            if is_stripped:
                print_buf = @alloc(val_len + 1) as ptr[u8]
                @memcpy(print_buf, val_ptr, val_len)
                print_buf[val_len] = 0 as u8

            let escaped_str = cgen_escape_string(print_buf as str)
            ax_fprintf_local(self.file, "    r_%d = AX_STR(\"%s\");\n", inst.dest as i64, get_str_ptr(escaped_str) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            @free(get_str_ptr(escaped_str))

            if is_stripped:
                @free(print_buf)
        else:
