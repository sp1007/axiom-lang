pub fn x86_encode_cvtsi2ss(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
