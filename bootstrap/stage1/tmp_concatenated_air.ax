                ax_fprintf_local(file, "    call ax_actor_spawn\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -4 as i64:
                ax_fprintf_local(file, "    call ax___ax_runtime_init\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -5 as i64:
                ax_fprintf_local(file, "    call ax___ax_runtime_shutdown\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -10 as i64:
                ax_fprintf_local(file, "    call ax_println_str\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -11 as i64:
                ax_fprintf_local(file, "    call ax_println_i64\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -12 as i64:
                ax_fprintf_local(file, "    call ax_println_f64\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -13 as i64:
                ax_fprintf_local(file, "    call ax_println_bool\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -14 as i64:
                ax_fprintf_local(file, "    call ax_print_str\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -15 as i64:
                ax_fprintf_local(file, "    call ax_print_i64\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -16 as i64:
                ax_fprintf_local(file, "    call ax_print_f64\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -17 as i64:
                ax_fprintf_local(file, "    call ax_print_bool\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -8 as i64:
                ax_fprintf_local(file, "    call abort\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -20 as i64:
                ax_fprintf_local(file, "    call ExitProcess\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -21 as i64:
                ax_fprintf_local(file, "    call strlen\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif inst.src1.imm == -22 as i64:
                ax_fprintf_local(file, "    call ax_str_eq\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(file, "    call %s\n", (get_str_ptr(fn_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            mut sym_name := x86_resolve_sym_name(inst.src1.imm as u32, symbols, pool, table)
            if sym_name == "std.string.len" or sym_name == "ax_std.string.len":
                sym_name = "ax_str_len"
            elif sym_name == "std.string.concat" or sym_name == "ax_std.string.concat":
                sym_name = "ax_str_concat"
            elif sym_name == "std.string.replace" or sym_name == "ax_std.string.replace":
                sym_name = "ax_str_replace"
            elif sym_name == "std.string.slice" or sym_name == "ax_std.string.slice":
                sym_name = "ax_str_slice"
            ax_fprintf_local(file, "    call %s\n", (get_str_ptr(sym_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

pub fn emit_function(file: ptr[void], fn_name: str, insts: ptr[MachInst], insts_len: i64, allocs: ptr[RegAllocation], frame: ptr[StackFrame], format: str, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable]):
    if format == "winasm":
        ax_fprintf_local(file, "%s PROC\n", (get_str_ptr(fn_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        ax_fprintf_local(file, "%s:\n", (get_str_ptr(fn_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    mut str_lit_counter := 0 as i32
    mut prologue := new_mach_inst_vec()
    emit_prologue(frame, &prologue)
    mut i := 0 as i64
    while i < prologue.len:
        emit_inst(file, prologue.data[i], fn_name, allocs, format, symbols, pool, table, frame, &str_lit_counter)
        i = i + 1
    if prologue.data != null as ptr[MachInst]:
        @free(prologue.data as ptr[u8])

    let is_entry = (fn_name == "main" or fn_name == "_AX_main_main_v_v")
    i = 0 as i64
    while i < insts_len:
        let inst = insts[i]
        if inst.op == MACH_RET:
            mut epilogue := new_mach_inst_vec()
            emit_epilogue(frame, &epilogue)
            mut j := 0 as i64
            while j < epilogue.len:
                emit_inst(file, epilogue.data[j], fn_name, allocs, format, symbols, pool, table, frame, &str_lit_counter)
                j = j + 1
            if epilogue.data != null as ptr[MachInst]:
                @free(epilogue.data as ptr[u8])
            
            if is_entry:
                if @compiler_intrinsic("is_windows"):
                    ax_fprintf_local(file, "    mov ecx, eax\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    ax_fprintf_local(file, "    sub rsp, 40\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    ax_fprintf_local(file, "    call ExitProcess\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                else:
                    ax_fprintf_local(file, "    mov rdi, rax\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    ax_fprintf_local(file, "    mov rax, 60\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    ax_fprintf_local(file, "    syscall\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                emit_inst(file, inst, fn_name, allocs, format, symbols, pool, table, frame, &str_lit_counter)
        else:
            emit_inst(file, inst, fn_name, allocs, format, symbols, pool, table, frame, &str_lit_counter)
        i = i + 1

    if format == "winasm":
        ax_fprintf_local(file, "%s ENDP\n", (get_str_ptr(fn_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fclose(stream: ptr[void]) -> i32

fn x86_str_to_null_terminated(s: str) -> ptr[u8]:
    let len = std.string.len(s)
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, s as ptr[u8], len)
    buf[len] = 0 as u8
    return buf

pub fn compile_native_asm(output_asm_file: str, mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], format: str) -> bool:
    let output_asm_file_nt = x86_str_to_null_terminated(output_asm_file)
    let file = fopen(output_asm_file_nt as ptr[void], get_str_ptr("wb"))
    @free(output_asm_file_nt)
    if file == null as ptr[void]:
        return false

    // 1. Emit assembler-specific header
    if format == "fasm":
        ax_fprintf_local(file, "; Generated by AXIOM Compiler (FASM format)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "format ELF64 executable\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "segment readable executable\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif format == "winasm":
        ax_fprintf_local(file, "; Generated by AXIOM Compiler (WinAsm / MASM format)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, ".code\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        // Default to NASM
        ax_fprintf_local(file, "; Generated by AXIOM Compiler (NASM format)\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "bits 64\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "section .text\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 2. Declare external symbols
    mut fi := 0 as i64
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if fn_ptr.is_extern:
            let name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)
            if format == "fasm":
                ax_fprintf_local(file, "extrn %s\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif format == "winasm":
                ax_fprintf_local(file, "EXTERN %s:PROC\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(file, "extern %s\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        fi = fi + 1
    if @compiler_intrinsic("is_windows"):
        if format == "fasm":
            ax_fprintf_local(file, "extrn ExitProcess\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif format == "winasm":
            ax_fprintf_local(file, "EXTERN ExitProcess:PROC\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_fprintf_local(file, "extern ExitProcess\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    ax_fprintf_local(file, "\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 3. Declare global symbols
    fi = 0
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if not fn_ptr.is_extern:
            let name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)
            if format == "fasm":
                ax_fprintf_local(file, "public %s\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            elif format == "winasm":
                ax_fprintf_local(file, "PUBLIC %s\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(file, "global %s\n", (get_str_ptr(name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        fi = fi + 1
    ax_fprintf_local(file, "\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 4. Compile each function to assembly text
    let abi = "win64"
    fi = 0
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if not fn_ptr.is_extern:
            let fn_name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)
            
            // Run selection & register allocation
            let mach_insts = select_all(fn_ptr, abi, table, symbols, pool)
            let intervals = compute_liveness(mach_insts.data, mach_insts.len)
            
            let alloc_res = allocate_registers_orchestrator(intervals, mach_insts.data, mach_insts.len, abi, fn_ptr, table, symbols)
            mut num_str_lits := 0 as i32
            mut loop_i := 0 as i64
            while loop_i < mach_insts.len:
                let inst = mach_insts.data[loop_i]
                if inst.op == MACH_MOV_IMM and inst.src1.vreg == 2 as u32:
                    num_str_lits = num_str_lits + 1
                loop_i = loop_i + 1

            mut local_bytes := 0 as i32
            if num_str_lits > 0:
                local_bytes = 16 + num_str_lits * 16

            mut cs_len := 0 as i64
            let cs_regs = get_used_callee_saved(abi, alloc_res.allocs, alloc_res.max_vreg, &cs_len)
            let frame = compute_frame(cs_regs, cs_len, alloc_res.spill_count, local_bytes, abi)
            
            let final_insts = insert_spill_code(mach_insts.data, mach_insts.len, alloc_res.allocs, &frame, fn_ptr, table, symbols)
            // Â§9 verification: nothing may still be a virtual register here. See
            // verify_all_operands_allocated â€” an unallocated operand would be encoded
            // silently as r15/xmm15 rather than reported.
            let unalloc = verify_all_operands_allocated(final_insts.data, final_insts.len, alloc_res.allocs, alloc_res.max_vreg, fn_name)

            // Emit ASM
            emit_function(file, fn_name, final_insts.data, final_insts.len, alloc_res.allocs, &frame, format, symbols, pool, table)
            ax_fprintf_local(file, "\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            
            // Free structures
            @free(cs_regs)
            @free(alloc_res.allocs)
            if intervals.data != null as ptr[LiveInterval]:
                @free(intervals.data as ptr[u8])
            if mach_insts.data != null as ptr[MachInst]:
                @free(mach_insts.data as ptr[u8])
            if final_insts.data != null as ptr[MachInst]:
                @free(final_insts.data as ptr[u8])
        fi = fi + 1

    // Emit identity variant constructors for sum types (Ok, Err, Some, None)
    if format == "fasm":
        ax_fprintf_local(file, "public ax_Ok\nax_Ok:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "public ax_Err\nax_Err:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "public ax_Some\nax_Some:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "public ax_None\nax_None:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "public ax_block_size\nax_block_size:\n    jmp ax_str_slice\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif format == "winasm":
        ax_fprintf_local(file, "PUBLIC ax_Ok\nax_Ok PROC\n    mov rax, rcx\n    ret\nax_Ok ENDP\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "PUBLIC ax_Err\nax_Err PROC\n    mov rax, rcx\n    ret\nax_Err ENDP\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "PUBLIC ax_Some\nax_Some PROC\n    mov rax, rcx\n    ret\nax_Some ENDP\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "PUBLIC ax_None\nax_None PROC\n    mov rax, rcx\n    ret\nax_None ENDP\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "PUBLIC ax_block_size\nax_block_size PROC\n    jmp ax_str_slice\nax_block_size ENDP\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        ax_fprintf_local(file, "global ax_Ok\nax_Ok:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "global ax_Err\nax_Err:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "global ax_Some\nax_Some:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "global ax_None\nax_None:\n    mov rax, rcx\n    ret\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_fprintf_local(file, "global ax_block_size\nax_block_size:\n    jmp ax_str_slice\n\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 5. Output rdata section for string literals
    mut str_keys := new_u32_vec()
    mut scan_fi := 0 as i64
    while scan_fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[scan_fi]
        if not fn_ptr.is_extern:
            mut inst_i := 0 as i64
            while inst_i < fn_ptr.insts.len:
                let inst = &fn_ptr.insts.data[inst_i]
                let t_id = inst.type_id as u32
                mut is_str := (t_id == 12 as u32)
                if t_id < table.entries.len as u32:
                    if table.entries.data[t_id].size == 16 as u32:
                        is_str = true
                if inst.opcode == OP_ICONST and is_str:
                    let str_id = inst.src1
                    mut found := false
                    mut j := 0 as i64
                    while j < str_keys.len:
                        if str_keys.data[j] == str_id:
                            found = true
                            break
                        j = j + 1
                    if not found:
                        str_keys.push(str_id)
                inst_i = inst_i + 1
        scan_fi = scan_fi + 1

    if str_keys.len > 0:
        if format == "winasm":
            ax_fprintf_local(file, "_rdata SEGMENT\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_fprintf_local(file, "section .rdata\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        mut str_i := 0 as i64
        while str_i < str_keys.len:
            let str_id = str_keys.data[str_i]
            let raw_text = pool.get(str_id)
            let text = unescape_string_literal(raw_text)
            let len = std.string.len(text)
            let text_ptr = text as ptr[u8]

            ax_fprintf_local(file, "Linfo.string.%d:\n", str_id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            if len > 0:
                ax_fprintf_local(file, "    db ", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                mut k := 0 as i64
                while k < len:
                    if k > 0:
                        ax_fprintf_local(file, ", ", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    ax_fprintf_local(file, "%d", text_ptr[k] as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                    k = k + 1
                ax_fprintf_local(file, ", 0\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(file, "    db 0\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

            @free(text_ptr)
            str_i = str_i + 1

        if format == "winasm":
            ax_fprintf_local(file, "_rdata ENDS\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    if str_keys.data != null as ptr[u32]:
        @free(str_keys.data as ptr[u8])

    if format == "winasm":
        ax_fprintf_local(file, "END\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    fclose(file)
    return true
// bootstrap/stage1/x86_modrm.ax
// ModRM and SIB byte encoding schemas for x86-64 in self-hosted AXIOM.

pub const MOD_INDIRECT:   u8 = 0b00 // [reg] â€” register indirect
pub const MOD_DISP8:      u8 = 0b01 // [reg + disp8]
pub const MOD_DISP32:     u8 = 0b10 // [reg + disp32]
pub const MOD_REG_DIRECT: u8 = 0b11 // reg â€” register direct

pub const REX_BASE: u8 = 0x40 // 0100xxxx
pub const REX_W:    u8 = 0x08 // W bit: 64-bit operand size
pub const REX_R:    u8 = 0x04 // R bit: extends ModRM.reg
pub const REX_X:    u8 = 0x02 // X bit: extends SIB.index
pub const REX_B:    u8 = 0x01 // B bit: extends ModRM.rm or SIB.base

pub struct ByteVec:
    pub data: ptr[u8]
    pub len: i64
    pub cap: i64

pub fn new_byte_vec() -> ByteVec:
    return ByteVec(data: null as ptr[u8], len: 0, cap: 0)

pub fn push_byte(mut self: ptr[ByteVec], b: u8):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap) as ptr[u8]
        if self.data != null as ptr[u8]:
            @memcpy(new_data, self.data, self.len)
            @free(self.data)
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = b
    self.len = self.len + 1

pub fn push_bytes(mut self: ptr[ByteVec], bytes: ptr[u8], bytes_len: i64):
    if bytes_len <= 0 as i64:
        return
    let needed = self.len + bytes_len
    if needed > self.cap:
        mut new_cap := self.cap
        if new_cap == 0 as i64:
            new_cap = 16 as i64
        while new_cap < needed:
            new_cap = new_cap * 2 as i64
        let new_data = @alloc(new_cap) as ptr[u8]
        if self.data != null as ptr[u8]:
            @memcpy(new_data, self.data, self.len)
            @free(self.data)
        self.data = new_data
        self.cap = new_cap
    @memcpy(((self.data as i64) + self.len) as ptr[u8], bytes, bytes_len)
    self.len = self.len + bytes_len

pub fn push_u16_le(mut self: ptr[ByteVec], val: u16):
    push_byte(self, (val & 0xFF as u16) as u8)
    push_byte(self, ((val >> 8 as u16) & 0xFF as u16) as u8)

pub fn push_u32_le(mut self: ptr[ByteVec], val: u32):
    push_byte(self, (val & 0xFF as u32) as u8)
    push_byte(self, ((val >> 8 as u32) & 0xFF as u32) as u8)
    push_byte(self, ((val >> 16 as u32) & 0xFF as u32) as u8)
    push_byte(self, ((val >> 24 as u32) & 0xFF as u32) as u8)

pub fn push_u64_le(mut self: ptr[ByteVec], val: u64):
    push_u32_le(self, (val & 0xFFFFFFFF as u64) as u32)
    push_u32_le(self, ((val >> 32 as u64) & 0xFFFFFFFF as u64) as u32)

pub fn encode_rex(w: bool, r: bool, x: bool, b: bool) -> u8:
    mut rex := REX_BASE
    if w:
        rex = rex | REX_W
    if r:
        rex = rex | REX_R
    if x:
        rex = rex | REX_X
    if b:
        rex = rex | REX_B
    return rex

pub fn x86_encode_modrm_rr(reg: u8, rm: u8, out_modrm: ptr[u8], out_rex: ptr[u8], out_need_rex: ptr[bool]):
    let reg_field = reg_hw_reg(reg)
    let rm_field = reg_hw_reg(rm)
    out_modrm[0] = (MOD_REG_DIRECT << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | (rm_field & 7 as u8)
    
    let reg_need = reg_needs_rex(reg)
    let rm_need = reg_needs_rex(rm)
    
    if reg_need or rm_need:
        out_need_rex[0] = true
        mut rex := REX_BASE
        if reg_need:
            rex = rex | REX_R
        if rm_need:
            rex = rex | REX_B
        out_rex[0] = rex
    else:
        out_need_rex[0] = false
        out_rex[0] = 0 as u8

pub fn x86_encode_modrm_rm(reg: u8, base: u8, disp: i32, buf: ptr[ByteVec]):
    let base_field = reg_hw_reg(base)
    let reg_field = reg_hw_reg(reg)
    
    let needs_sib = ((base_field & 7 as u8) == 4 as u8)
    let needs_disp8_for_rbp = (((base_field & 7 as u8) == 5 as u8) and disp == 0)
    
    mut mod := MOD_INDIRECT
    if needs_disp8_for_rbp:
        mod = MOD_DISP8
    elif disp == 0:
        mod = MOD_INDIRECT
    elif disp >= -128 and disp <= 127:
        mod = MOD_DISP8
    else:
        mod = MOD_DISP32
        
    mut rex := 0 as u8
    let reg_need = reg_needs_rex(reg)
    let base_need = reg_needs_rex(base)
    if reg_need or base_need:
        rex = REX_BASE
        if reg_need:
            rex = rex | REX_R
        if base_need:
            rex = rex | REX_B
            
    if rex != 0 as u8:
        push_byte(buf, rex)
        
    if needs_sib:
        let modrm = (mod << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | 0x04 as u8
        let sib = (0 as u8 << 6 as u8) | (0x04 as u8 << 3 as u8) | (base_field & 7 as u8)
        push_byte(buf, modrm)
        push_byte(buf, sib)
    else:
        let modrm = (mod << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | (base_field & 7 as u8)
        push_byte(buf, modrm)
        
    if mod == MOD_DISP8:
        push_byte(buf, disp as u8)
    elif mod == MOD_DISP32:
        push_u32_le(buf, disp as u32)

pub fn x86_encode_modrm_rip(reg: u8, disp32: i32, buf: ptr[ByteVec]):
    mut rex := 0 as u8
    if reg_needs_rex(reg):
        rex = REX_BASE | REX_R
        
    if rex != 0 as u8:
        push_byte(buf, rex)
        
    let reg_field = reg_hw_reg(reg)
    let modrm = (MOD_INDIRECT << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | 0x05 as u8
    push_byte(buf, modrm)
    push_u32_le(buf, disp32 as u32)

pub fn x86_encode_modrm_sib(reg: u8, base: u8, index: u8, scale: u8, disp: i32, buf: ptr[ByteVec]):
    mut scale_bits := 0 as u8
    if scale == 1 as u8:
        scale_bits = 0 as u8
    elif scale == 2 as u8:
        scale_bits = 1 as u8
    elif scale == 4 as u8:
        scale_bits = 2 as u8
    elif scale == 8 as u8:
        scale_bits = 3 as u8
    else:
        scale_bits = 0 as u8
        
    let base_field = reg_hw_reg(base)
    let reg_field = reg_hw_reg(reg)
    let index_field = reg_hw_reg(index)
    
    let needs_disp8_for_rbp = (((base_field & 7 as u8) == 5 as u8) and disp == 0)
    mut mod := MOD_INDIRECT
    if needs_disp8_for_rbp:
        mod = MOD_DISP8
    elif disp == 0:
        mod = MOD_INDIRECT
    elif disp >= -128 and disp <= 127:
        mod = MOD_DISP8
    else:
        mod = MOD_DISP32
        
    mut rex := 0 as u8
    let reg_need = reg_needs_rex(reg)
    let base_need = reg_needs_rex(base)
    let index_need = reg_needs_rex(index)
    if reg_need or base_need or index_need:
        rex = REX_BASE
        if reg_need:
            rex = rex | REX_R
        if index_need:
            rex = rex | REX_X
        if base_need:
            rex = rex | REX_B
            
    if rex != 0 as u8:
        push_byte(buf, rex)
        
    let modrm = (mod << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | 0x04 as u8
    let sib = (scale_bits << 6 as u8) | ((index_field & 7 as u8) << 3 as u8) | (base_field & 7 as u8)
    push_byte(buf, modrm)
    push_byte(buf, sib)
    
    if mod == MOD_DISP8:
        push_byte(buf, disp as u8)
    elif mod == MOD_DISP32:
        push_u32_le(buf, disp as u32)
// bootstrap/stage1/x86_encoding.ax
// x86-64 instruction encoders in self-hosted AXIOM.

pub fn x86_encode_ret(buf: ptr[ByteVec]):
    push_byte(buf, 0xC3 as u8)

pub fn x86_encode_nop(buf: ptr[ByteVec]):
    push_byte(buf, 0x90 as u8)

pub fn x86_encode_int3(buf: ptr[ByteVec]):
    push_byte(buf, 0xCC as u8)

pub fn x86_encode_push(reg: u8, buf: ptr[ByteVec]):
    if reg_needs_rex(reg):
        push_byte(buf, REX_BASE | REX_B)
    push_byte(buf, 0x50 as u8 + (reg_hw_reg(reg) & 7 as u8))

pub fn x86_encode_pop(reg: u8, buf: ptr[ByteVec]):
    if reg_needs_rex(reg):
        push_byte(buf, REX_BASE | REX_B)
    push_byte(buf, 0x58 as u8 + (reg_hw_reg(reg) & 7 as u8))

pub fn x86_encode_mov_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
        push_byte(buf, rex)
    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x89 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_mov_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (0 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xC7 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_mov_ri64(dst: u8, imm: i64, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    push_byte(buf, rex)
    push_byte(buf, 0xB8 as u8 + (reg_hw_reg(dst) & 7 as u8))
    push_u64_le(buf, imm as u64)

pub fn x86_encode_add_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x01 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_add_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (0 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_sub_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x29 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_sub_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (5 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_imul_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0xAF as u8)
    push_byte(buf, modrm)

// REX.W 69 /r id â€” `imul r64, r/m64, imm32`. Unlike the group-1 ops below this is x86's
// only THREE-operand integer form, so the destructive `vD = vD * k` we are encoding becomes
// `imul dst, dst, k`: dst names both the reg field and the r/m field, which is why the REX
// R and B bits are both driven from it.
pub fn x86_encode_imul_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, reg_needs_rex(dst), false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | ((reg_hw_reg(dst) & 7 as u8) << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x69 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_cqo(buf: ptr[ByteVec]):
    push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x99 as u8)

pub fn x86_encode_idiv_r(divisor: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(divisor))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (7 as u8 << 3 as u8) | (reg_hw_reg(divisor) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xF7 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_div_r(divisor: u8, buf: ptr[ByteVec]):
    // unsigned divide: REX.W F7 /6 â€” rdx:rax / divisor (rdx MUST be zeroed by
    // the caller, unlike signed idiv which sign-extends via cqo). reg field = 6.
    let rex = encode_rex(true, false, false, reg_needs_rex(divisor))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (6 as u8 << 3 as u8) | (reg_hw_reg(divisor) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xF7 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_neg_r(reg: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (3 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xF7 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_not_r(reg: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (2 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xF7 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_cmp_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x39 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_cmp_ri(reg: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (7 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_test_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x85 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_and_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x21 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_or_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x09 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_xor_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
    else:
        rex = encode_rex(true, false, false, false)
    push_byte(buf, rex)
    push_byte(buf, 0x31 as u8)
    push_byte(buf, modrm)

// The rest of the group-1 immediate forms: `REX.W 81 /d id`, identical in shape to
// x86_encode_add_ri (/0), x86_encode_sub_ri (/5) and x86_encode_cmp_ri (/7) above, differing
// only in the opcode-extension digit carried in the ModRM reg field. imm32 is SIGN-extended to
// 64 bits by the hardware, which is why the folding peephole refuses any constant outside
// signed-imm32 range rather than truncating it.
pub fn x86_encode_and_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (4 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_or_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (1 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_xor_ri(dst: u8, imm: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(dst))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (6 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x81 as u8)
    push_byte(buf, modrm)
    push_u32_le(buf, imm as u32)

pub fn x86_encode_shl_cl(reg: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (4 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xD3 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_sar_cl(reg: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (7 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xD3 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_shr_cl(reg: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (5 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xD3 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_xor_zero(reg: u8, buf: ptr[ByteVec]):
    let modrm = (MOD_REG_DIRECT << 6 as u8) | ((reg_hw_reg(reg) & 7 as u8) << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    if reg_needs_rex(reg):
        let rex = REX_BASE | REX_R | REX_B
        push_byte(buf, rex)
    push_byte(buf, 0x31 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_setcc(cc: u8, dst: u8, buf: ptr[ByteVec]):
    if reg_needs_rex(dst) or reg_hw_reg(dst) >= 4 as u8:
        mut rex := REX_BASE
        if reg_needs_rex(dst):
            rex = rex | REX_B
        push_byte(buf, rex)
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (0 as u8 << 3 as u8) | (reg_hw_reg(dst) & 7 as u8)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x90 as u8 + cc)
    push_byte(buf, modrm)

pub fn x86_encode_movzx_br(dst: u8, src: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, reg_needs_rex(dst), false, reg_needs_rex(src))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | ((reg_hw_reg(dst) & 7 as u8) << 3 as u8) | (reg_hw_reg(src) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0xB6 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_jmp_rel32(rel32: i32, buf: ptr[ByteVec]):
    push_byte(buf, 0xE9 as u8)
    push_u32_le(buf, rel32 as u32)

pub fn x86_encode_jcc_rel32(cc: u8, rel32: i32, buf: ptr[ByteVec]):
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x80 as u8 + cc)
    push_u32_le(buf, rel32 as u32)

pub fn x86_encode_call_rel32(rel32: i32, buf: ptr[ByteVec]):
    push_byte(buf, 0xE8 as u8)
    push_u32_le(buf, rel32 as u32)

pub fn x86_encode_call_r(reg: u8, buf: ptr[ByteVec]):
    if reg_needs_rex(reg):
        push_byte(buf, REX_BASE | REX_B)
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (2 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, 0xFF as u8)
    push_byte(buf, modrm)

pub fn x86_encode_lea(dst: u8, base: u8, disp: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, reg_needs_rex(dst), false, reg_needs_rex(base))
    
    // We construct a temporary byte vector to receive the ModRM byte sequence,
    // merging REX bits if necessary, just like the reference Go emitter.
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(dst, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(dst) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    push_byte(buf, final_rex)
    push_byte(buf, 0x8D as u8)
    
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_mov_load(dst: u8, base: u8, disp: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(true, reg_needs_rex(dst), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(dst, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(dst) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    push_byte(buf, final_rex)
    push_byte(buf, 0x8B as u8)
    
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_mov_store(base: u8, disp: i32, src: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, reg_needs_rex(src), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(src, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(src) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    push_byte(buf, final_rex)
    push_byte(buf, 0x89 as u8)
    
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_syscall(buf: ptr[ByteVec]):
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x05 as u8)

pub fn x86_encode_lea_rip(dst: u8, disp32: i32, buf: ptr[ByteVec]):
    mut rex := REX_BASE | REX_W
    if reg_needs_rex(dst):
        rex = rex | REX_R
    push_byte(buf, rex)
    push_byte(buf, 0x8D as u8)
    let reg_field = reg_hw_reg(dst)
    let modrm = (MOD_INDIRECT << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | 0x05 as u8
    push_byte(buf, modrm)
    push_u32_le(buf, disp32 as u32)

pub fn x86_encode_shl_imm(reg: u8, imm: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (4 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xC1 as u8)
    push_byte(buf, modrm)
    push_byte(buf, imm)

pub fn x86_encode_sar_imm(reg: u8, imm: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (7 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xC1 as u8)
    push_byte(buf, modrm)
    push_byte(buf, imm)

pub fn x86_encode_shr_imm(reg: u8, imm: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(true, false, false, reg_needs_rex(reg))
    let modrm = (MOD_REG_DIRECT << 6 as u8) | (5 as u8 << 3 as u8) | (reg_hw_reg(reg) & 7 as u8)
    push_byte(buf, rex)
    push_byte(buf, 0xC1 as u8)
    push_byte(buf, modrm)
    push_byte(buf, imm)

pub fn x86_encode_mov_load_sized(dst: u8, base: u8, disp: i32, size: u8, buf: ptr[ByteVec]):
    mut w_bit := true
    mut op_byte1 := 0x8B as u8
    mut op_byte2 := 0 as u8
    mut is_two_byte_op := false
    
    if size == 1 as u8:
        w_bit = true
        is_two_byte_op = true
        op_byte1 = 0x0F as u8
        op_byte2 = 0xB6 as u8
    elif size == 2 as u8:
        w_bit = true
        is_two_byte_op = true
        op_byte1 = 0x0F as u8
        op_byte2 = 0xB7 as u8
    elif size == 4 as u8:
        w_bit = false
        is_two_byte_op = false
        op_byte1 = 0x8B as u8
    else:
        w_bit = true
        is_two_byte_op = false
        op_byte1 = 0x8B as u8

    let rex = encode_rex(w_bit, reg_needs_rex(dst), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(dst, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(dst) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    let needs_rex_prefix = w_bit or reg_needs_rex(dst) or reg_needs_rex(base)
    if needs_rex_prefix:
        push_byte(buf, final_rex)
        
    if is_two_byte_op:
        push_byte(buf, op_byte1)
        push_byte(buf, op_byte2)
    else:
        push_byte(buf, op_byte1)
        
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_mov_store_sized(base: u8, disp: i32, src: u8, size: u8, buf: ptr[ByteVec]):
    mut w_bit := true
    mut op_byte := 0x89 as u8
    
    if size == 1 as u8:
        w_bit = false
        op_byte = 0x88 as u8
    elif size == 2 as u8:
        w_bit = false
        op_byte = 0x89 as u8
        push_byte(buf, 0x66 as u8)
    elif size == 4 as u8:
        w_bit = false
        op_byte = 0x89 as u8
    else:
        w_bit = true
        op_byte = 0x89 as u8

    let rex = encode_rex(w_bit, reg_needs_rex(src), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(src, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(src) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    mut needs_rex_prefix := w_bit or reg_needs_rex(src) or reg_needs_rex(base)
    // BUG#27: an 8-bit store from SPL/BPL/SIL/DIL (hw regs 4-7) REQUIRES a REX
    // prefix. Without it the modrm reg field 4-7 decodes as the legacy high-byte
    // registers AH/CH/DH/BH, so e.g. `mov %sil,m` silently becomes `mov %dh,m`
    // and stores garbage. encode_rex already yields a 0x40-based REX here.
    if size == 1 as u8:
        let src_hw = reg_hw_reg(src)
        if src_hw >= 4 as u8 and src_hw <= 7 as u8:
            needs_rex_prefix = true
    if needs_rex_prefix:
        push_byte(buf, final_rex)

    push_byte(buf, op_byte)
    
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_movsd(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0xF2 as u8)
    if need_rex:
        push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x10 as u8)
    push_byte(buf, modrm)

pub fn x86_encode_movdq(dst: u8, src: u8, buf: ptr[ByteVec]):
    // movq xmm, r/m64 = 66 REX.W 0F 6E /r. The 0x66 operand-size prefix is
    // MANDATORY â€” without it the opcode is the MMX `movq mm, r/m64` (mm0-7 alias
    // the x87 stack, NOT the XMM regs), so the gprâ†’xmm move silently targets the
    // wrong register file (BUG#33 sub-bug: intâ†’float conversions read garbage).
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0x66 as u8)
    if need_rex:
        rex = rex | REX_W
        push_byte(buf, rex)
    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x6E as u8)
    push_byte(buf, modrm)

pub fn x86_encode_movqd(dst: u8, src: u8, buf: ptr[ByteVec]):
    // movq r/m64, xmm = 66 REX.W 0F 7E /r. 0x66 mandatory (see movdq above) â€”
    // without it this is the MMX `movq r/m64, mm` and extracts from the wrong
    // register file (xmmâ†’gpr round-trip returned garbage).
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    push_byte(buf, 0x66 as u8)
    if need_rex:
        rex = rex | REX_W
        push_byte(buf, rex)
    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x7E as u8)
    push_byte(buf, modrm)

pub fn x86_encode_movsd_load(dst: u8, base: u8, disp: i32, buf: ptr[ByteVec]):
    let rex = encode_rex(false, reg_needs_rex(dst), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(dst, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
    let has_rex := reg_needs_rex(dst) or reg_needs_rex(base)
    if has_rex and temp_buf.len > 0 as i64:
        let first_byte = temp_buf.data[0]
        if (first_byte & 0xF0 as u8) == 0x40 as u8:
            final_rex = final_rex | (first_byte & 0x0F as u8)
            start_idx = 1
            
    push_byte(buf, 0xF2 as u8)
    if final_rex != 0 as u8:
        push_byte(buf, final_rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x10 as u8)
    
    mut i := start_idx
    while i < temp_buf.len:
        push_byte(buf, temp_buf.data[i])
        i = i + 1
        
    if temp_buf.data != null as ptr[u8]:
        @free(temp_buf.data)

pub fn x86_encode_movsd_store(base: u8, disp: i32, src: u8, buf: ptr[ByteVec]):
    let rex = encode_rex(false, reg_needs_rex(src), false, reg_needs_rex(base))
    mut temp_buf := new_byte_vec()
    x86_encode_modrm_rm(src, base, disp, &temp_buf)
    
    mut final_rex := rex
    mut start_idx := 0 as i64
