                let tmp_dest_addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

                let tmp_val1 = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val1, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val1, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

                let tmp_val2 = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val2, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_dest_addr, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_val2, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: type_size as u8, 
                    dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: inst.dest, label: 0 as u32, imm: 0 as i64), 
                    src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: tmp_ptr, label: 0 as u32, imm: 0 as i64), 
                    src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

        if type_size == 1 as u32 or type_size == 2 as u32 or type_size == 4 as u32:
            emit_load_extend(sel, inst.dest, type_size, get_register_type(sel, inst.dest), out_insts)

    else:
        out_insts.push(MachInst(op: MACH_NOP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

// Materialize all parameters into their param vregs at function entry.
//
// The previous design materialized params lazily on first use. For 8-byte
// params that emitted `MOV pvreg = arg_reg`, which the register allocator
// detects (param_idx_of_vreg) and protects from being colored with a *later*
// param's arg register. But 16-byte (str) params materialize via LOAD/LEA/STORE
// with fresh scratch temps that carry no such protection, so an earlier str
// param's scratch could grab a later param's incoming arg register (e.g. RDX),
// clobbering it before that later param was read. The symptom: with two str
// params, reading the 2nd returned the 1st's value.
//
// Fix: snapshot every integer-register-passed argument into a fresh vreg via
// `MOV snap = arg_reg` FIRST. Those MOVs are param-tagged and mutually
// non-clobbering, so after this phase all original arg registers are safely
// captured and later value-loading scratch may use any register. Then load each
// parameter's value from its snapshot. param_idx_processed is set past the end
// so the lazy per-instruction paths are skipped.
pub fn emit_param_prologue(sel: ptr[InstructionSelector], out_insts: ptr[MachInstVec]):
    let nparams = sel.fn_ptr.params.len
    if nparams <= 0 as i64:
        return
    let snaps = @alloc(nparams * 4 as i64) as ptr[u32]
    // Phase 1: snapshot incoming arg registers (protected MOVs).
    // RFC 0006: a float param (f32/f64) arrives in the positional XMM arg reg
    // (XMM0..XMM3 on win64), not the integer arg reg. Reading it from RCX/RDX
    // yielded garbage â†’ all float fn args were 0. The snapshot MOV preserves the
    // raw 64 bits even if `snap` is GPR-classified (movq is bit-exact), and the
    // param vreg (float-typed) is XMM-classified so phase-2 movq restores it.
    mut p := 0 as i64
    while p < nparams:
        snaps[p] = 0 as u32
        let pty_snap = sel.fn_ptr.params.data[p] as u32
        mut phys := abi_int_arg_reg(sel.abi_name, p)
        if pty_snap == 9 as u32 or pty_snap == 10 as u32:
            phys = abi_float_arg_reg(sel.abi_name, p)
        if phys != REG_NONE:
            let snap = next_vreg(sel)
            snaps[p] = snap
            out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: phys, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        p = p + 1
    // Phase 2: store each parameter's value into its param vreg.
    p = 0 as i64
    while p < nparams:
        let pvreg = (p + 1 as i64) as u32
        mut psize := 8 as u32
        let pty = sel.fn_ptr.params.data[p] as u32
        if pty < sel.table.entries.len as u32:
            psize = sel.table.entries.data[pty as i64].size
        mut phys := abi_int_arg_reg(sel.abi_name, p)
        if pty == 9 as u32 or pty == 10 as u32:
            phys = abi_float_arg_reg(sel.abi_name, p)
        if phys != REG_NONE:
            let snap = snaps[p]
            // RFC 0001: `str` (16-byte PRIMITIVE) is passed as a pointer and copied
            // 16-byte-inline into its param home. A by-address aggregate param is
            // ITSELF an 8-byte pointer in the arg register â€” store it directly (the
            // else branch); copying 16 bytes made the home hold the data while
            // getfld then derefs it -> deref of the field value (segfault, tsp).
            if psize == 16 as u32 and not type_is_aggregate(sel.table, pty):
                // arg register held a pointer to the 16-byte value
                let lo = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                let hi = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                let addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: snap, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            // stack-passed parameter (arg index >= number of register args)
            mut offset := 0 as i64
            if sel.abi_name == "win64":
                offset = 48 as i64 + (p - 4 as i64) * 8 as i64
            else:
                offset = 16 as i64 + (p - 6 as i64) * 8 as i64
            // RFC 0001: see register-passed case above â€” aggregate = 8-byte pointer.
            if psize == 16 as u32 and not type_is_aggregate(sel.table, pty):
                let saddr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)))
                let lo = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                let hi = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: saddr, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
                let addr = next_vreg(sel)
                out_insts.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: lo, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: addr, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: hi, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64)))
            else:
                out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_VREG, phys: 0 as u8, padding: 0 as u16, vreg: pvreg, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)))
        p = p + 1
    @free(snaps as ptr[u8])

// PEEPHOLE (pre-regalloc, vreg-level): compare-branch fusion.
// `select_comparison` lowers `a < b` into the 3-inst boolean sequence
//   CMP a,b / SETCC cc -> vb / MOVZX_B vb <- vb
// and `OP_BRANCH` lowers `if vb:` into
//   TEST vb,vb / JCC NE -> Ltrue / JMP -> Lfalse
// When these six land contiguously (the overwhelmingly common `if <cmp>:` /
// `while <cmp>:` shape) the boolean vb is a throwaway: we can branch directly on
// the CMP's flags. Collapse the window
//   CMP a,b / SETCC cc / MOVZX vb / TEST vb / JCC NE Ltrue   ->   CMP a,b / JCC cc Ltrue
// dropping SETCC+MOVZX+TEST and the dead vb vreg. This removes 3 hot-path insts
// per conditional AND one live vreg (register-pressure relief), and is exactly
// what clang emits (`cmp;jl`) â€” closing a large slice of the M6 perf gap.
//
// SAFETY: (1) the window must be textually contiguous, so no MACH_LABEL (block
// boundary) or flag-clobbering inst can sit between the CMP and the JCC â€” the
// CMP's flags reach the fused JCC intact (SETCC/MOVZX/mov do not write flags).
// (2) vb must have NO other use in the function (occurrence count == exactly the
// 5 references inside the removed insts), else the boolean is consumed elsewhere
// and must still be materialized. (3) SETCC's cc and JCC's cc share the x86 tttn
// encoding (setcc=0x90+cc, jcc=0x80+cc), so reusing SETCC's cc for the JCC is a
// verbatim condition transfer; TEST+JNE means "branch when vb!=0" == "branch when
// cc holds", so the fused JCC uses cc unchanged.
// PEEPHOLE (pre-regalloc, vreg-level): fold a materialised constant into an adjacent
// CMP's immediate operand. The selector lowers `n < 2` as
//   MOV_IMM v <- 2 / CMP n(dst), v(src1)   (the const is CMP's SECOND/source operand)
// but x86 has a `cmp r64, imm32` form (the encoder already emits it for the setcc path,
// x86_selector.ax:1402). Collapse the two-inst window
//   MOV_IMM v,c / CMP n, v   ->   CMP n, imm(c)
// dropping the dead MOV_IMM and the vreg v (register-pressure relief). This is exactly
// what clang emits (`cmp $2,%rsi`) and removes 1 hot-path inst per constant compare â€”
// runs BEFORE fuse_compare_branch so the two compose (the CMP still fuses into a JCC).
//
// SAFETY: (1) MOV_IMM must carry a PLAIN integer immediate (src1.kind==OPND_IMM, no
// reloc label), never the str-lit marker (src1.vreg==2, kind OPND_VREG). (2) the const
// must sit in the CMP's SRC1 (source) operand, never the dst (`2 < n` keeps the const as
// dst and is left alone â€” a missed opt, not a miscompile). (3) v must have EXACTLY 2
// references total (the MOV_IMM def + this one CMP use), so no other consumer loses it â€”
// the machine IR is non-SSA, so a global occurrence count is required. (4) c must fit a
// signed imm32 (cmp r64,imm32 sign-extends); bail otherwise. (5) the two insts must be
// textually adjacent, so nothing redefines v between def and use. `cmp r,imm` sets the
// same flags as `mov imm->r; cmp r,r`, so the fusion is a verbatim semantic transfer.
pub fn fuse_cmp_immediate(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 2 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1
    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut fused := false
        if r + 1 < len:
            let m = &insts[r]
            let c = &insts[r + 1 as i64]
            // The zero producer is MACH_XOR_ZERO, not MACH_MOV_IMM. select_inst materialises the
            // constant 0 with `xor r,r` (shorter, breaks the dependency), so `n == 0` lowered to
            // `XOR_ZERO v ; CMP n,v` and this fold â€” which only looked for MOV_IMM â€” never fired
            // on it. Comparing against zero is everywhere, and in a loop the xor is re-executed
            // every iteration for a value that never changes.
            //
            // PRICED BEFORE IMPLEMENTING, on a tail-recursive shape where the compare sits in the
            // hot loop: NASM with `test rcx,rcx` ran 16.2 ms, the same loop with
            // `xor r8d,r8d ; cmp rcx,r8` ran 17.6 ms -- 8.83% for rematerialising a constant zero.
            // (Folding to `CMP dst,imm(0)` rather than `TEST dst,dst`: TEST would be one byte
            // shorter but fuse_compare_branch downstream matches on MACH_CMP, and this fold is
            // ordered before it.)
            mut zero_producer := false
            if m.op == MACH_XOR_ZERO and m.dst.kind == OPND_VREG:
                zero_producer = true
            mut plain_imm := false
            if m.op == MACH_MOV_IMM and m.dst.kind == OPND_VREG and m.src1.kind == OPND_IMM and m.src1.vreg == 0 as u32 and m.src1.label == 0 as u32:
                plain_imm = true
            if (plain_imm or zero_producer) and c.op == MACH_CMP and c.src1.kind == OPND_VREG and c.src1.vreg == m.dst.vreg:
                let v = m.dst.vreg
                mut imm := 0 as i64
                if plain_imm:
                    imm = m.src1.imm
                if (v as i64) < n and counts[v as i64] == 2 as i32 and imm >= (0 - 2147483648) as i64 and imm <= 2147483647 as i64:
                    // Emit the CMP with the constant folded into its immediate operand;
                    // drop the MOV_IMM (dead â€” v had exactly this one use).
                    insts[w] = MachInst(op: MACH_CMP, cc: c.cc, padding: c.padding, dst: c.dst, src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: imm), src2: c.src2)
                    w = w + 1 as i64
                    r = r + 2 as i64
                    fused = true
        if not fused:
            insts[w] = insts[r]
            w = w + 1 as i64
            r = r + 1 as i64
    @free(counts as ptr[u8])
    return w

// (M6 opt B â€” lea for `dst = base Â± const` â€” was PROTOTYPED here and REVERTED 2026-07-24e
// after MEASURING a fib regression, diagnosed then as "the allocator spills base". It now
// lives in select_inst's OP_IADD/OP_ISUB instead, and the spill had a concrete cause the old
// diagnosis missed: a LEA over a vreg makes the allocator treat that vreg as ADDRESS-TAKEN and
// spill it unconditionally, which the `padding: 1` marker now excludes. See
// [[m6-perf-baseline]] and the comment on the fold itself.)

// Delete a materialised constant nothing reads. The LEA fold above consumes its addend as an
// immediate but does not remove the MOV_IMM that produced it, so `x - 1` was left emitting
// `mov $0x1,%rax; lea -0x1(%rbx),%rax` â€” two instructions where the whole point was one, with
// the first writing a register the second immediately overwrites.
//
// This is the part that actually costs time. A register-to-register MOV is resolved at
// register rename and occupies no execution slot (measured repeatedly in this project), so
// replacing `mov r,r; sub` with `lea` removes only free work; the immediate materialisation is
// a real uop. Measured on fib: the fold WITHOUT this pass is +3.1% (a loss).
//
// `counts[v] == 1` means the vreg is written once and never read â€” the same reference-count
// idiom fuse_cmp_immediate uses, where 2 means one def plus one use. MOV_IMM has no other
// effect, so dropping a dead one is safe. A physical destination is never touched: those are
// ABI slots whose value is read by something outside this vreg accounting.
pub fn drop_dead_mov_imm(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 1 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1
    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut drop := false
        let m = &insts[r]
        if m.op == MACH_MOV_IMM and m.dst.kind == OPND_VREG:
            let v = m.dst.vreg as i64
            if v < n and counts[v] == 1 as i32:
                drop = true
        if not drop:
            insts[w] = insts[r]
            w = w + 1 as i64
        r = r + 1 as i64
    @free(counts as ptr[u8])
    return w

// The ALU ops that have an `OP r64, imm32` encoding AND whose immediate lives in src1 under
// the destructive two-operand model. Deliberately NOT the shifts: the selector already emits
// `SHL vD, imm` directly for a constant shift count, so admitting them here would buy nothing
// while forcing a second, different width argument (imm8, hardware-masked to 6 bits) through
// the same fold. Deliberately NOT CMP either -- fuse_cmp_immediate already owns that pattern
// and runs earlier, because its result has to compose with fuse_compare_branch.
fn mach_alu_takes_imm32(op: u16) -> bool:
    return op == MACH_ADD or op == MACH_SUB or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_IMUL

// PEEPHOLE 1d (M6): fold a materialised constant into the ALU operand that consumes it.
//   MOV_IMM vC,k ; ALU vD,vC              ->  ALU vD,imm(k)
//   MOV_IMM vC,k ; MOV vT,vD ; ALU vT,vC  ->  MOV vT,vD ; ALU vT,imm(k)
//
// âš ï¸ THE SECOND WINDOW IS THE ONE THAT MATTERS, and the first version of this pass had only
// the first. Selection materialises a binop's constant operand BEFORE emitting the destructive
// form's `MOV vT, lhs` copy, so for every user-level `x OP const` the MOV_IMM and its consumer
// are TWO apart, not adjacent. Written with the adjacent window alone, this fold fired on
// exactly zero of callloop's four constants -- it matched only compiler-internal width masks,
// which happen to be emitted next to their AND. It was caught by dumping the actual
// instruction stream this pass sees, and it could NOT have been caught by reading the emitted
// assembly: there the pair shows up adjacent (`mov $0x2,%rbx; imul %rbx,%rdx`), because
// downstream stages do not preserve this ordering. The disassembly is evidence about the
// finished binary, not about the array a pre-allocation peephole matches on.
//
// WHY, and why the earlier "immediate folding is worthless" measurement does not apply. This
// candidate was priced by hand-written NASM on 2026-07-24e and scored -0.5/-13 ms, i.e. noise,
// so it was dropped. That pricing was done on FIB, which is latency-bound: a constant load sits
// off the recursion's dependency chain and is invisible there. The exact same mistake was made
// about register coalescing, which measured 0 on fib and then -30% on xorshift once it was
// priced on a throughput-bound shape. callloop is the throughput-bound shape here, and its
// asm floor (added the commit before this one) puts it at 1.28x -- the ONLY shape of the four
// that misses the M6-codegen gate of 15%. Its 13-instruction loop body spends FOUR
// instructions doing nothing but moving a constant into a register so the next instruction can
// read it:
//     mov $0x2,%rbx ; imul %rbx,%rdx        ->  imul %rdx,%rdx,2
//     mov $0x3,%rdx ; imul %rdx,%rax        ->  imul %rax,%rax,3
//     mov $0xfffff,%rax ; and %rax,%rcx     ->  and %rcx,0xfffff
// Every one of those loads is a real uop on the critical path of a throughput-bound loop.
//
// Runs BEFORE coalesce_dest_copy (1c) rather than after, and that ordering is load-bearing
// rather than cosmetic: 1c's shape A requires `MOV vT,vD ; OP vT,C ; MOV vD,vT` to be textually
// ADJACENT, and a compound assignment against a constant (`acc = acc & 1048575`) emits the
// MOV_IMM *between* the first copy and the op, splitting the window so 1c cannot fire at all.
// Removing the MOV_IMM first closes the window back up. It cannot work the other way round:
// this fold only ever deletes an instruction that 1c does not match on.
//
// SAFETY, same single criterion the three folds before it use: `counts[vC]` is the number of
// operand slots the WHOLE function mentions vC in, so requiring exactly 2 (the MOV_IMM's def
// plus this one use) proves no other instruction can observe the register -- no CFG reasoning
// and no dependence on block ordering, which is the assumption the reverted copy-propagation
// got wrong. Beyond that:
//   (1) The constant must be a PLAIN integer: `src1.kind == OPND_IMM` AND `src1.vreg == 0` AND
//       no reloc label. MACH_MOV_IMM is overloaded as the carrier for string-literal, function-
//       address, global-address and spawn-entry relocations, and every one of those forms is
//       discriminated by a marker in src1.vreg (1,2,3,4) -- checking vreg explicitly means this
//       does not silently start folding addresses if a fifth marker is ever added.
//   (2) k must fit a SIGNED imm32: all these encodings sign-extend the immediate to 64 bits,
//       so `x & 0xFFFFFFFF` must stay a register op rather than become `and r64,-1`.
//   (3) The constant must sit in the ALU's src1 (the source), never its dst. `5 - x` keeps the
//       constant as the destination of a destructive SUB, and that shape simply does not match
//       (a MOV_IMM's dst is the ALU's dst, not its src1) -- a missed fold, not a miscompile.
//   (4) Adjacency, so nothing can redefine vC between its def and its use.
// Flags are unaffected: `and r,imm` sets exactly what `mov imm->r; and r,r` sets, and the
// deleted MOV_IMM never wrote flags to begin with.
pub fn fold_alu_immediate(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 2 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1

    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut folded := false
        if r + 1 < len:
            let m = &insts[r]
            if m.op == MACH_MOV_IMM and m.dst.kind == OPND_VREG and m.src1.kind == OPND_IMM and m.src1.vreg == 0 as u32 and m.src1.label == 0 as u32:
                let vc = m.dst.vreg
                let imm = m.src1.imm
                if (vc as i64) < n and counts[vc as i64] == 2 as i32 and imm >= (0 - 2147483648) as i64 and imm <= 2147483647 as i64:
                    // Locate the consumer: either the next instruction, or the one after it
                    // across a single interposed MACH_MOV (see the window note above).
                    mut ai := 0 as i64
                    mut have := false
                    let n1 = &insts[r + 1 as i64]
                    if mach_alu_takes_imm32(n1.op):
                        ai = r + 1 as i64
                        have = true
                    elif n1.op == MACH_MOV and r + 2 < len:
                        let n2 = &insts[r + 2 as i64]
                        if mach_alu_takes_imm32(n2.op):
                            ai = r + 2 as i64
                            have = true
                    if have:
                        let a = &insts[ai]
                        if a.dst.kind == OPND_VREG and a.src1.kind == OPND_VREG and a.src1.vreg == vc and a.src2.kind == OPND_NONE:
                            // Keep the interposed copy, in its original position relative to
                            // the op; only the now-dead MOV_IMM disappears.
                            if ai == r + 2 as i64:
                                insts[w] = insts[r + 1 as i64]
                                w = w + 1 as i64
                            insts[w] = MachInst(op: a.op, cc: a.cc, padding: a.padding, dst: a.dst, src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: imm), src2: a.src2)
                            w = w + 1 as i64
                            r = ai + 1 as i64
                            folded = true
        if not folded:
            insts[w] = insts[r]
            w = w + 1 as i64
            r = r + 1 as i64
    @free(counts as ptr[u8])
    return w

// The two-operand ALU ops: `OP d, s` means `d = d OP s`, so the destination is an implicit
// SOURCE as well. That is what forces select_binop to prefix every one of them with a
// `MOV dest, src1` copy, and it is the precondition coalesce_dest_copy relies on.
// Deliberately integer-only: the float family (FADD/FSUB/...) copies through MOVDQ, not
// MACH_MOV, so it can never match the pattern below anyway, and admitting it would mean
// reasoning about cross-class copies for no measured gain.
fn mach_is_destructive_alu(op: u16) -> bool:
    return op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR

// PEEPHOLE 1c (M6): coalesce the copy PAIR that the destructive two-operand form wraps
// around every compound assignment `d = d OP e`.
//
// select_binop must emit `MOV vT, vD; OP vT, C` because x86 has no three-operand ALU form,
// and the AIR-level store back into the variable then adds `MOV vD, vT`. So one step of
// xorshift (`x = x ^ (x << 13)`) leaves FIVE instructions where hand-written assembly needs
// three:
//     mov %rax,%rdx ; shl $0xd,%rdx ; mov %rax,%rbx ; xor %rdx,%rbx ; mov %rbx,%rax
// against the NASM floor
//     mov rdx,rax  ; shl rdx,13    ;                 xor rax,rdx
// The two surplus instructions are the copy INTO the scratch destination and the copy back
// out of it. Both vanish if the op simply writes vD directly.
//
// âš ï¸ WHY THIS IS NOT THE COPY-PROPAGATION THAT WAS MEASURED AND REVERTED. That pass
// propagated FORWARD (rewrite uses of a copy's destination to its source), which EXTENDS the
// source's live range and made the allocator spill â€” measured -6.5% on fib. This one folds
// the temp BACKWARD into a variable that is already live across the whole region, and
// deletes the temp outright: the number of simultaneously-live vregs at every program point
// is unchanged or one lower, so it cannot introduce a spill. Same reason the interference
// graph never needed to change.
//
// âš ï¸ AND WHY THE ALLOCATOR'S EXISTING move_partner BIAS CANNOT DO IT. That bias only drops
// an interference edge when the two live ranges are boundary-disjoint (x86_regalloc.ax:817).
// Here vD is the LOOP-CARRIED variable: the interval model merges all of its definitions into
// one range spanning the entire loop, so vT sits strictly INSIDE it and the two genuinely
// "interfere" under that model even though vD's old value is dead at the copy. No amount of
// biased colouring reaches this; the copies have to go before allocation, not during it.
//
// Two shapes, both purely local and both requiring the three/two instructions to be ADJACENT
// (a MACH_LABEL is a real slot in this array, so adjacency already proves no branch can land
// in the middle):
//
//   A. `MOV vT,vD ; OP vT,C ; MOV vD,vT`  ->  `OP vD,C`
//   B. `LEA vT,[..] ; MOV vD,vT`          ->  `LEA vD,[..]`
//      (the loop-counter shape: `lea 0x1(%rcx),%rdx; mov %rdx,%rcx` -> `lea 0x1(%rcx),%rcx`.
//      LEA is the only non-destructive op admitted here: it writes its destination without
//      reading it, and reads its sources before that write, so vD may safely appear on both
//      sides.)
//
// SAFETY, in one criterion: `counts[vT]` is the number of operand slots the WHOLE function
// mentions vT in. Requiring it to equal exactly the slots the pattern itself accounts for (3
// for A, 2 for B) proves vT is used nowhere else â€” no CFG reasoning, no liveness, and no
// dependence on block ordering, which is the assumption the reverted copy-prop got wrong.
// vD's own live range only ever grows backward across the deleted copy, into the hole vT
// just vacated. Flags are preserved exactly: MOV does not write them and the surviving OP is
// the same OP in the same position relative to any consumer.
pub fn coalesce_dest_copy(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 2 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1

    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut folded := false

        // Shape A: MOV vT,vD ; OP vT,C ; MOV vD,vT  ->  OP vD,C
        if r + 2 < len:
            let a0 = &insts[r]
            let a1 = &insts[r + 1 as i64]
            let a2 = &insts[r + 2 as i64]
            if a0.op == MACH_MOV and a0.dst.kind == OPND_VREG and a0.src1.kind == OPND_VREG and a0.src2.kind == OPND_NONE:
                if a2.op == MACH_MOV and a2.dst.kind == OPND_VREG and a2.src1.kind == OPND_VREG and a2.src2.kind == OPND_NONE:
                    let vt = a0.dst.vreg
                    let vd = a0.src1.vreg
                    if vt != vd and a2.dst.vreg == vd and a2.src1.vreg == vt:
                        if mach_is_destructive_alu(a1.op) and a1.dst.kind == OPND_VREG and a1.dst.vreg == vt and a1.src2.kind == OPND_NONE:
                            if (vt as i64) < n and counts[vt as i64] == 3 as i32:
                                let f_op = a1.op
                                let f_cc = a1.cc
                                let f_pad = a1.padding
                                let f_src1 = a1.src1
                                let f_src2 = a1.src2
                                let f_dst = a2.dst
                                insts[w] = MachInst(op: f_op, cc: f_cc, padding: f_pad, dst: f_dst, src1: f_src1, src2: f_src2)
                                w = w + 1 as i64
                                r = r + 3 as i64
                                folded = true

        // Shape B: LEA vT,[..] ; MOV vD,vT  ->  LEA vD,[..]
        if not folded and r + 1 < len:
            let b0 = &insts[r]
            let b1 = &insts[r + 1 as i64]
            // b1's destination may be a PHYSICAL register as well as a vreg. The physical case
            // is the argument-setup sequence in front of every call: selection emits
            // `LEA vT,[vI+k] ; MOV rcx,vT`, and restricting this to vreg destinations left the
            // copy in place at every call site. fib pays two of them per recursive call, and a
            // literal NASM transcription showed its surplus copies are worth 8.6% -- they are
            // NOT free, contrary to the older "copies are invisible in latency-bound code" note.
            // Folding is still a verbatim transfer: LEA reads its sources before writing its
            // destination, the two instructions are adjacent so nothing can read rcx in between,
            // and rcx was already being written at this point by the MOV -- the write only moves
            // one instruction earlier.
            // b0 may also be `MOV vT, <phys>` -- the parameter-entry copy. Selection lands an
            // incoming argument in a vreg and a later copy moves it to the vreg that actually
            // holds the variable, so fib opens with `mov %rcx,%rax ; mov %rax,%rbx` where one
            // instruction would do. Restricted to a PHYSICAL source on purpose: the deleted
            // temp lets the source's live range reach one instruction further, and for a
            // physical ABI register that is not something the vreg allocator prices, so this
            // cannot reproduce the pressure failure that killed the general forward
            // copy-propagation (-6.5% on fib, 2026-07-29e). A vreg source is NOT admitted here.
            mut b0_ok := b0.op == MACH_LEA
            if b0.op == MACH_MOV and b0.src1.kind == OPND_PHYS and b0.src2.kind == OPND_NONE:
                b0_ok = true
            if b0_ok and b0.dst.kind == OPND_VREG:
                if b1.op == MACH_MOV and (b1.dst.kind == OPND_VREG or b1.dst.kind == OPND_PHYS) and b1.src1.kind == OPND_VREG and b1.src2.kind == OPND_NONE:
                    let vt = b0.dst.vreg
                    // A vreg destination must differ from vT; a physical one cannot alias it.
                    mut dst_ok := b1.dst.kind == OPND_PHYS
                    if b1.dst.kind == OPND_VREG:
                        dst_ok = b1.dst.vreg != vt
                    if b1.src1.vreg == vt and dst_ok:
                        if (vt as i64) < n and counts[vt as i64] == 2 as i32:
                            let g_op = b0.op
                            let g_cc = b0.cc
                            let g_pad = b0.padding
                            let g_src1 = b0.src1
                            let g_src2 = b0.src2
                            let g_dst = b1.dst
                            insts[w] = MachInst(op: g_op, cc: g_cc, padding: g_pad, dst: g_dst, src1: g_src1, src2: g_src2)
                            w = w + 1 as i64
                            r = r + 2 as i64
                            folded = true

        if not folded:
            insts[w] = insts[r]
            w = w + 1 as i64
            r = r + 1 as i64
    @free(counts as ptr[u8])
    return w

// Instructions across which peephole 1f must NOT move a destination's write.
//
// Control flow first, and this one is mandatory rather than cautious: linear instruction order
// is NOT the CFG's execution order (the note on compute_liveness, RFC 0016 P2'), so a span that
// crosses a label or a jump cannot be reasoned about by position at all. That is precisely the
// unsound premise behind the copy-propagation variant that measured -4.4% and was dropped for
// good (2026-07-29e) -- a win measured on a pass with a false premise is not a win.
//
// Calls next: moving a vreg's def above a call makes it live ACROSS the call, which changes what
// the allocator must do with it. Correct allocators handle that, but it is a pressure change this
// peephole has no business making.
//
// The divide family is bailed on CONSERVATIVELY, not out of necessity: MACH_DIVCLOBBER's own
// comment says the allocator already keeps vregs spanning it off RAX/RDX, so spanning is a
// handled case. It is excluded because it costs approximately nothing to exclude (a divide within
// eight instructions of a copy chain is rare) and because the ordering hazard below is enough
// novel reasoning for one pass. Removing it is a legitimate follow-up IF a fire count shows it
// suppresses real matches.
fn chain_span_blocks(op: u16) -> bool:
    if op == MACH_JMP or op == MACH_JCC or op == MACH_LABEL or op == MACH_RET:
        return true
    if op == MACH_CALL or op == MACH_CALL_INDIRECT or op == MACH_SYSCALL:
        return true
    if op == MACH_IDIV or op == MACH_DIV or op == MACH_CQO or op == MACH_DIVCLOBBER:
        return true
    return false

// PEEPHOLE 1f (M6): collapse a copy CHAIN whose two links are NOT adjacent.
//
//     DEF vT, ...        (MOV or LEA -- both write dst without reading it)
//     ... instructions touching neither vT nor vD ...
//     MOV vD, vT         ->    DEF vD, ...      and the MOV is deleted
//
// This is coalesce_dest_copy's shape B with the ADJACENCY requirement lifted, and it exists
// because the shape that actually costs time is not adjacent. Read off sumto's pre-regalloc
// stream (2026-07-30) -- the real stream, with an identity printed on every function, after two
// earlier readings attributed the wrong function's instructions to it -- the loop body carries a
// DOUBLE chain:
//
//     LEA v6,[v1-1] ; MOV v7,v2 ; ADD v7,v1 ; MOV v10,v6 ; MOV v11,v7 ; MOV v1,v10 ; MOV v2,v11
//
// v6 -> v10 -> v1 and v7 -> v11 -> v2: four movs where two suffice, INSIDE a loop body that runs
// 20M times, and every link sits two or three instructions from its partner because the two
// parameters interleave. That gap is the entire reason shape B never fired here, and the gap was
// invisible in the disassembly: after regalloc the pairs look adjacent because the later stages
// do not preserve this ordering.
//
// WHY THIS IS NOT THE FORWARD COPY-PROPAGATION THAT MEASURED -6.5% AND WAS DROPPED:
// the surviving instruction stays at the DEF's index -- it does not move down to the copy. So the
// def's operands are read at exactly the same point as before and NO source live range grows.
// The only range that changes is the DESTINATION's: its def moves up to CHAIN_WINDOW instructions
// earlier. Bounded, and guarded below. Forward propagation extended ranges by an unbounded amount
// and let the allocator spill.
//
// ORDERING HAZARD -- why a naive "just widen the window" is silently WRONG.
// Folding moves the write of vD EARLIER. In sumto, `acc += n` reads the OLD n, so `MOV v1,v10`
// (n := n-1) must NOT be hoisted above `ADD v7,v1` (acc += n). The interference scan rejects
// exactly that: any surviving instruction between the def and the copy that MENTIONS vD blocks
// the fold. On sumto this fires for the v6 and v11 links and correctly REFUSES the v10 -> v1
// link, and that refusal is what keeps the answer right. A fold that inverted those two would
// still produce a plausible-looking number, so t_copychain checks the VALUE, not just that the
// program runs -- the trap t_spawnsmoke sat in for months.
//
// SAFETY IS ONE CRITERION, as with 1c: counts[vT] == 2 over the whole function means the def and
// this copy are the ONLY two mentions of vT, so nothing else can observe it. No CFG reasoning is
// needed for vT; the span scan handles vD; the control-flow bail keeps both inside one block.
const CHAIN_WINDOW: i64 = 8
pub fn collapse_copy_chain(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 3 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    let def_at = @alloc(n * 8) as ptr[i64]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        def_at[z] = 0 - 1 as i64
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
            def_at[inst.dst.vreg as i64] = ci
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1

    let dead = @alloc(len) as ptr[u8]
    mut d0 := 0 as i64
    while d0 < len:
        dead[d0] = 0 as u8
        d0 = d0 + 1

    mut j := 0 as i64
    while j < len:
        let m = &insts[j]
        if m.op == MACH_MOV and m.dst.kind == OPND_VREG and m.src1.kind == OPND_VREG and m.src2.kind == OPND_NONE:
            let vt = m.src1.vreg as i64
            let vd = m.dst.vreg as i64
            // vt == vd is a self-move; folding it is the identity and 1c does not own it either.
            if vt != vd and vt < n and vd < n and counts[vt] == 2 as i32:
                let i = def_at[vt]
                // gap >= 2 keeps this pass DISJOINT from 1c's shape B (which owns the adjacent
                // case, including its physical-destination form). Two passes that can match the
                // same window make a measured delta unattributable.
                if i >= 0 as i64 and i < j and dead[i] == 0 as u8 and j - i >= 2 as i64 and j - i <= CHAIN_WINDOW:
                    let d = &insts[i]
                    mut ok := d.op == MACH_MOV or d.op == MACH_LEA
                    if ok:
                        ok = d.dst.kind == OPND_VREG and (d.dst.vreg as i64) == vt
                    // The def must not read a PHYSICAL register. A `MOV vT, PHYS(r)` is not a
                    // value copy at all -- it is ABI ESTABLISHMENT, and its position is load-
                    // bearing in a way this pass's vreg counts cannot see. `counts[vT] == 2`
                    // proves nothing about a physical register: `r` is a second, invisible
                    // source whose lifetime is governed by the calling convention.
                    //
                    // MEASURED, not feared (2026-07-30b). Without this check, 1f folded the
                    // float parameter prologue of every function with 4+ f64 params and
                    // miscompiled it: t_interpolation 127 -> 79, t_colorhsl 127 -> 120,
                    // t_quatrot 8 -> 3, identically at O0/O1/O2. The disassembly of the folded
                    // prologue says exactly why:
                    //
                    //     movsd %xmm0,%xmm2      ; v1 spilled, via the float spill scratch
                    //     movsd %xmm1,%xmm2      ; v2 spilled, same scratch
                    //     movsd %xmm2,%xmm9      ; v3 := p2 -- reads a CLOBBERED %xmm2
                    //
                    // The float spill scratch is XMM2 (chosen in 2026-07-29e when spilled float
                    // ALU destinations were fixed), and on win64 XMM2 is also the THIRD float
                    // argument register. emit_param_prologue avoids that collision structurally
                    // by snapshotting all four incoming arg registers into fresh vregs BEFORE
                    // reading any of them -- see the comment on emit_param_prologue, which says
                    // so outright. Those snapshots are the protection, and folding them away is
                    // deleting it.
                    //
                    // Excluding PHYS defs rather than float or parameter vregs is deliberate on
                    // three counts. It names the actual mechanism (ABI vs value), so it is not
                    // the unexplained guard that f3e3915 warns against. It costs none of the
                    // measured win: sumto's two winning folds have defs `LEA v6,[v1-1]` and
                    // `MOV v11,v7`, both vreg-to-vreg -- a param-vreg exclusion would have
                    // deleted half the -14.2%, since sumto's winning destination IS a parameter.
                    // And it closes the integer form of the same hazard, which is only saved
                    // today by param_idx_of_vreg (x86_regalloc.ax:519) recognising RCX/RDX/R8/R9
                    // -- protection 1f would equally have been deleting. NOTE that
                    // param_idx_of_vreg does NOT list XMM0-XMM3, so the float side has no such
                    // backstop; see knowledge/bug-float-arg-reg-unprotected.md.
                    if ok:
                        ok = d.src1.kind != OPND_PHYS and d.src2.kind != OPND_PHYS
                    if ok:
                        mut k := i + 1 as i64
                        while k < j:
                            // Skip instructions already deleted this pass: they are not in the
                            // output, so they cannot observe anything. (They are only ever MOVs,
                            // never control flow.)
                            if dead[k] == 0 as u8:
                                let s = &insts[k]
                                if chain_span_blocks(s.op):
                                    ok = false
                                if s.dst.kind == OPND_VREG and (s.dst.vreg as i64) == vd:
                                    ok = false
                                // CALIBRATED 2026-07-30: flipping either of these two to `ok = true`
                                // makes t_copychain return 1 at -O1 (sumto gives 45, not 55). Note
                                // that bin/t_tailrecloop.ax still returns its expected 128 with the
                                // guard broken -- the benchmark is value-blind to this miscompile,
                                // which is why this oracle checks three distinct values.
                                if s.src1.kind == OPND_VREG and (s.src1.vreg as i64) == vd:
                                    ok = false
                                if s.src2.kind == OPND_VREG and (s.src2.vreg as i64) == vd:
                                    ok = false
                            k = k + 1
                    if ok:
                        let nd = insts[j].dst
                        insts[i] = MachInst(op: insts[i].op, cc: insts[i].cc, padding: insts[i].padding, dst: nd, src1: insts[i].src1, src2: insts[i].src2)
                        dead[j] = 1 as u8
                        // vD's def now lives at i, so a LATER copy off vD can chain onto it --
                        // this is what collapses sumto's two-hop chains in a single pass. Every
                        // guard is re-checked for the new (i, j') pair, span scan included.
                        def_at[vd] = i
        j = j + 1

    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        if dead[r] == 0 as u8:
            if w != r:
                insts[w] = insts[r]
            w = w + 1 as i64
        r = r + 1 as i64
    @free(counts as ptr[u8])
    @free(def_at as ptr[u8])
    @free(dead)
    return w

// PEEPHOLE 1e (M6): strength-reduce a multiply by a power-of-two immediate.
//     IMUL vD, imm(2)    ->  ADD vD, vD
//     IMUL vD, imm(2^k)  ->  SHL vD, imm(k)
// Only reachable because peephole 1d created the immediate form in the first place. IMUL is
// 3-cycle latency and issues on a single port; ADD is 1 cycle at four per cycle, SHL 1 cycle.
//
// ORDER IS LOAD-BEARING, and this was MEASURED rather than reasoned. It runs AFTER
// coalesce_dest_copy (1c), not before and not inside 1d. 1c matches
// `MOV vT,vD ; OP vT,C ; MOV vD,vT` on the criterion counts[vT]==3, counting every operand slot
// in the function that names vT; rewriting to `ADD vT,vT` adds a FOURTH mention and so disables
// the coalescing for exactly the shape this fires on. Built both ways, `x = x * 2` in a loop:
//     1e after 1c   ->  add %rax,%rax
//     1e before 1c  ->  mov %rax,%rdx ; add %rdx,%rdx ; mov %rdx,%rax
//
// âš ï¸ AND THE SELF-HOST GATE CANNOT SEE IT. Compiling the compiler's own 2 MB source with both
// orderings produces BYTE-IDENTICAL output (413C6A12...), because nothing in it happens to
// write `x = x * 2^k` as a compound assignment. So A==B/B==C would be green with the ordering
// wrong. Another instance of the standing rule that a green fixpoint can prove zero -- the
// ordering is justified by the two disassemblies above, not by the gate.
//
// FLAGS: no analysis needed, and this is worth stating because the opposite was assumed at
// first. IMUL leaves SF/ZF/AF/PF ARCHITECTURALLY UNDEFINED, so no correct consumer can read
// flags across one; whatever ADD or SHL writes there cannot be observed by correct code. (CF/OF
// are defined for IMUL, but this compiler emits no branch on them: narrow-width wrapping goes
// through emit_wrap_to_width -> emit_load_extend, a mask/sign-extend, and no site emits a JO.)
// `x * 2^k == x << k` and `x * 2 == x + x` hold exactly in two's complement, including wrap.
fn imul_pow2_shift(imm: i64) -> i64:
    // Returns k for imm == 2^k with k in 1..62, else -1. Excludes 1 (no-op, and deleting an
    // instruction is a different transform) and every non-power-of-two.
    if imm < 2 as i64:
        return 0 - 1 as i64
    mut k := 1 as i64
    mut v := 2 as i64
    while k < 63 as i64:
        if v == imm:
            return k
        v = v * 2 as i64
        k = k + 1 as i64
    return 0 - 1 as i64

pub fn strength_reduce_imul(insts: ptr[MachInst], len: i64) -> i64:
    mut i := 0 as i64
    while i < len:
        let m = &insts[i]
        if m.op == MACH_IMUL and m.dst.kind == OPND_VREG and m.src1.kind == OPND_IMM:
            let k = imul_pow2_shift(m.src1.imm)
            if k == 1 as i64:
                insts[i] = MachInst(op: MACH_ADD, cc: m.cc, padding: m.padding, dst: m.dst, src1: m.dst, src2: m.src2)
            elif k > 1 as i64:
                insts[i] = MachInst(op: MACH_SHL, cc: m.cc, padding: m.padding, dst: m.dst, src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: k), src2: m.src2)
        i = i + 1
    return len

pub fn fuse_compare_branch(insts: ptr[MachInst], len: i64, max_vreg: u32) -> i64:
    if len < 5 as i64:
        return len
    let n = (max_vreg as i64) + 1 as i64
    let counts = @alloc(n * 4) as ptr[i32]
    mut z := 0 as i64
    while z < n:
        counts[z] = 0 as i32
        z = z + 1
    mut ci := 0 as i64
    while ci < len:
        let inst = &insts[ci]
        if inst.dst.kind == OPND_VREG:
            counts[inst.dst.vreg as i64] = counts[inst.dst.vreg as i64] + 1 as i32
        if inst.src1.kind == OPND_VREG:
            counts[inst.src1.vreg as i64] = counts[inst.src1.vreg as i64] + 1 as i32
        if inst.src2.kind == OPND_VREG:
            counts[inst.src2.vreg as i64] = counts[inst.src2.vreg as i64] + 1 as i32
        ci = ci + 1
    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut fused := false
        if r + 4 < len:
            let c0 = &insts[r]
            let c1 = &insts[r + 1 as i64]
            let c2 = &insts[r + 2 as i64]
            let c3 = &insts[r + 3 as i64]
            let c4 = &insts[r + 4 as i64]
            if (c0.op == MACH_CMP or c0.op == MACH_FCMP) and c1.op == MACH_SETCC and c2.op == MACH_MOVZX_B and c3.op == MACH_TEST and c4.op == MACH_JCC and c4.cc == CC_NE:
                let vb = c1.dst.vreg
                if c1.dst.kind == OPND_VREG and c2.dst.kind == OPND_VREG and c2.dst.vreg == vb and c2.src1.kind == OPND_VREG and c2.src1.vreg == vb and c3.dst.kind == OPND_VREG and c3.dst.vreg == vb and c3.src1.kind == OPND_VREG and c3.src1.vreg == vb:
                    if (vb as i64) < n and counts[vb as i64] == 5 as i32:
                        // keep the CMP/FCMP as-is
                        insts[w] = insts[r]
                        w = w + 1 as i64
                        // replace TEST+JCC(NE) with a single JCC using SETCC's condition
                        insts[w] = MachInst(op: MACH_JCC, cc: c1.cc, padding: 0 as u8, dst: c4.dst, src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64))
                        w = w + 1 as i64
                        r = r + 5 as i64
                        fused = true
        if not fused:
            insts[w] = insts[r]
            w = w + 1 as i64
            r = r + 1 as i64
    @free(counts as ptr[u8])
    return w

// PEEPHOLE (pre-regalloc, control flow only): thread jump-to-jump chains and delete jumps
// that merely fall through to the next instruction.
//
// The block lowering emits every `if` as `JCC taken; JMP fallthrough`, and the fallthrough
// target is frequently a block whose entire body is one more `JMP`. fib's `n < 2` compiled to
//   cmp; jl base; jmp L_X; <else body>; ... ; base: ...; L_X: jmp <else body>
// -- two unconditional jumps to reach code that was already the next instruction. Measured
// price of just ONE such extra jump on fib(40): +42..+108 ms across runs (see
// scripts/perf_asm_variants.ps1, V3b -> V4), i.e. the largest single-instruction effect in the
// whole pricing table, because a taken branch also costs prediction and I-cache density.
//
// Two rewrites, both purely local:
//   (1) THREAD: a JMP/JCC whose target label starts a block whose first real instruction is an
//       unconditional JMP is retargeted to that JMP's destination. Sound because the
//       intervening block does nothing else -- only LABELs may sit in between. Depth-capped so
//       a self-loop (`L: jmp L`) terminates.
//   (2) FALLTHROUGH: a JMP whose target label is reachable from it by passing only LABELs is
//       deleted outright, because control already arrives there.
// Order matters: threading first, since it is what turns `jmp L_X` into a jump to the very next
// label that (2) can then delete.
//
// SAFETY: labels are pseudo-instructions that emit no bytes (x86_emitter records their offset),
// so "only LABELs in between" really does mean "the next instruction executed". Conditional
// jumps are only ever RETARGETED, never removed, so no path is created or destroyed. Runs
// before liveness/allocation, so removing a JMP cannot invalidate an allocation, and it shrinks
// the CFG the liveness dataflow then walks.
pub fn thread_and_drop_jumps(insts: ptr[MachInst], len: i64) -> i64:
    if len < 2 as i64:
        return len
    // Compact (label -> index) table: label ids are sparse (synthesized ones start at
    // 1,000,000), so an array indexed BY label id would be megabytes per function. The count of
    // labels in one function is small, so a linear probe over a compact table is cheaper.
    mut nlab := 0 as i64
    mut c := 0 as i64
    while c < len:
        if insts[c].op == MACH_LABEL:
            nlab = nlab + 1
        c = c + 1
    if nlab == 0 as i64:
        return len
    let lab_id = @alloc(nlab * 4) as ptr[u32]
    let lab_idx = @alloc(nlab * 8) as ptr[i64]
    mut w2 := 0 as i64
    c = 0
    while c < len:
        if insts[c].op == MACH_LABEL:
            lab_id[w2] = insts[c].dst.label
            lab_idx[w2] = c
            w2 = w2 + 1
        c = c + 1

    // (1) thread jump -> jump
    mut ji := 0 as i64
    while ji < len:
        let jop = insts[ji].op
        if (jop == MACH_JMP or jop == MACH_JCC) and insts[ji].dst.kind == OPND_LABEL:
            mut target := insts[ji].dst.label
            mut hops := 0 as i64
            while hops < 8 as i64:
                mut ti := -1 as i64
                mut s := 0 as i64
                while s < nlab:
                    if lab_id[s] == target:
                        ti = lab_idx[s]
                        s = nlab
                    else:
                        s = s + 1
                if ti < 0 as i64:
                    hops = 8
                else:
                    // first REAL instruction at/after the label
                    mut k = ti + 1 as i64
                    while k < len and insts[k].op == MACH_LABEL:
                        k = k + 1
                    if k < len and insts[k].op == MACH_JMP and insts[k].dst.kind == OPND_LABEL and insts[k].dst.label != target:
                        target = insts[k].dst.label
                        hops = hops + 1
                    else:
                        hops = 8
            insts[ji].dst.label = target
        ji = ji + 1

    // (2) drop a JMP that only falls through
    mut w := 0 as i64
    mut r := 0 as i64
    while r < len:
        mut drop := false
        if insts[r].op == MACH_JMP and insts[r].dst.kind == OPND_LABEL:
            let want = insts[r].dst.label
            mut k = r + 1 as i64
            while k < len and insts[k].op == MACH_LABEL:
                if insts[k].dst.label == want:
                    drop = true
                    k = len
                else:
                    k = k + 1
        if not drop:
            insts[w] = insts[r]
            w = w + 1 as i64
        r = r + 1 as i64
    @free(lab_id as ptr[u8])
    @free(lab_idx as ptr[u8])
    return w

pub fn select_all(f: ptr[AirFunc], abi: str, table: ptr[TypeTable], symbols: ptr[SymbolTable], pool: ptr[InternPool]) -> MachInstVec:
    mut actual_max_vreg := 0 as u32
    mut vi := 0 as i64
    while vi < f.insts.len:
        let inst = &f.insts.data[vi]
        if inst.dest > actual_max_vreg:
            actual_max_vreg = inst.dest
        vi = vi + 1

    mut actual_max_label := 0 as u32
    mut bi_init := 0 as i64
    while bi_init < f.blocks.len:
        let bb = &f.blocks.data[bi_init]
        if bb.id > actual_max_label:
            actual_max_label = bb.id
        bi_init = bi_init + 1

    if actual_max_label < 1000000 as u32:
        actual_max_label = 1000000 as u32

    // PERF: build the def-index once (sized to the max AIR dest); get_register_type
    // uses it to avoid an O(insts) scan per call (25 call sites, many per inst).
    let gr_def_size = (actual_max_vreg as i64) + 1 as i64
    let gr_def_idx = build_vreg_def_idx(f, gr_def_size)

    mut sel := InstructionSelector(
        fn_ptr: f,
        abi_name: abi,
        table: table,
        param_idx_processed: 0,
        symbols: symbols,
        pool: pool,
        max_vreg: actual_max_vreg,
        max_label: actual_max_label,
        def_idx: gr_def_idx,
        def_size: gr_def_size
    )
    mut result := new_mach_inst_vec()

    let fn_name = pool.get(f.name)
    let is_main = (fn_name == "main" or fn_name == "_AX_main_main_v_v")

    if f.blocks.len > 0:
        // Materialize params BEFORE the first block label (.L_b_0), so the entry
        // block is RE-ENTRANT: a jump to .L_b_0 (RFC 0026 Â§2b tail-self-recursion->
        // loop) must NOT re-run the `MOV pvreg=arg_reg` snapshot (that would reset
        // params to the original incoming args). Byte-identical for non-looping code
        // (the label emits no bytes and nothing jumped to entry before).
        emit_param_prologue(&sel, &result)
        sel.param_idx_processed = sel.fn_ptr.params.len as i32
        mut bi := 0 as i64
        while bi < f.blocks.len:
            let bb = &f.blocks.data[bi]
            result.push(MachInst(op: MACH_LABEL, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_LABEL, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: bb.id, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
            
            // RFC 0009 P3 Linux (minimal freestanding): the eager __ax_runtime_init
            // (-4) brings up the actor heap + M:N scheduler, which are not yet ported to
            // Linux (they crash on first mmap). For the SysV target we skip it so pure-
            // compute programs run; the allocator inits lazily on first use. Windows keeps
            // the eager init. Enabling the full runtime on Linux is a follow-up.
            if is_main and bi == 0 as i64 and abi == "win64":
                result.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 32 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                result.push(MachInst(op: MACH_CALL, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: -4 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
                result.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 32 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

            mut i := 0 as i64
            while i < bb.instrs_len as i64:
                let inst_idx = f.block_instrs.data[bb.instrs_start as i64 + i]
                if inst_idx < f.insts.len as u32:
                    let inst = &f.insts.data[inst_idx as i64]
                    select_inst(&sel, inst, &result)
                i = i + 1
            bi = bi + 1
    else:
        emit_param_prologue(&sel, &result)
        sel.param_idx_processed = sel.fn_ptr.params.len as i32
        mut i := 0 as i64
        while i < f.insts.len:
            let inst = &f.insts.data[i]
            select_inst(&sel, inst, &result)
            i = i + 1

    @free(gr_def_idx as ptr[u8])
    // Peephole 1 (RFC 0015-adjacent / M6 opt A): fold a materialised constant into an
    // adjacent CMP's immediate operand (MOV_IMM v,c; CMP n,v -> CMP n,imm(c)). Runs
    // FIRST so the resulting `CMP n,imm` still composes with fuse_compare_branch below.
    result.len = fuse_cmp_immediate(result.data, result.len, sel.max_vreg)
    // Peephole 1b (M6): drop constants nothing reads, which is what the LEA fold in
    // select_inst leaves behind. Placed after the CMP fusion so it also sweeps up any
    // MOV_IMM that fusion orphaned, and before the rest so they see fewer instructions.
    result.len = drop_dead_mov_imm(result.data, result.len, sel.max_vreg)
    // Peephole 1d (M6): fold a materialised constant into the ALU operand that reads it.
    // BEFORE 1c on purpose â€” a compound assignment against a constant emits the MOV_IMM in the
    // middle of the three-instruction window 1c matches on, so removing it here is what lets 1c
    // fire at all on those. See fold_alu_immediate.
    result.len = fold_alu_immediate(result.data, result.len, sel.max_vreg)
    // Peephole 1f (M6): collapse non-adjacent copy chains. BEFORE 1c on purpose, and the reason
    // is compaction rather than counts: deleting the intervening copies is what brings 1c's
    // three-instruction shape-A window ADJACENT. On sumto, 1f removes the v6 and v11 links, which
    // leaves `MOV v7,v2 ; ADD v7,v1 ; MOV v2,v7` consecutive so 1c can fold it to `ADD v2,v1` --
    // neither pass reaches that alone. After 1d for the same reason 1c is: a folded-away constant
    // is one less instruction inside the window. See collapse_copy_chain.
    result.len = collapse_copy_chain(result.data, result.len, sel.max_vreg)
    // Peephole 1c (M6): fold the destructive two-operand form's copy pair into the op itself.
    // After 1b, so the counts it reasons about are not inflated by constants already known
    // dead, and before allocation, because the allocator's interval model provably cannot
    // coalesce a temp that sits inside a loop-carried variable's range. See coalesce_dest_copy.
    result.len = coalesce_dest_copy(result.data, result.len, sel.max_vreg)
    // Peephole 1e (M6): multiply by a power of two -> add/shift. AFTER 1c on purpose: it adds
    // a mention of the destination vreg, which would break 1c's counts[vT]==3 test if it ran
    // first. See strength_reduce_imul.
    result.len = strength_reduce_imul(result.data, result.len)
    // Peephole 2: fuse throwaway compare-then-branch boolean sequences into a direct
    // conditional jump on the CMP flags (pre-regalloc, so the dead bool vreg is gone
    // before liveness/allocation). See fuse_compare_branch for the safety contract.
    result.len = fuse_compare_branch(result.data, result.len, sel.max_vreg)
    // Peephole 3 (M6 block layout): thread jump-to-jump chains and delete jumps that only fall
    // through. Runs LAST so it also cleans up any layout the two fusions above leave behind.
    result.len = thread_and_drop_jumps(result.data, result.len)
    return result
// bootstrap/stage1/x86_regalloc.ax
// Liveness Analysis and Graph-Coloring Register Allocation for x86-64 in self-hosted AXIOM.


pub struct LiveInterval:
    pub vreg: u32
    pub start: i32
    pub end: i32

pub struct LiveIntervalVec:
    pub data: ptr[LiveInterval]
    pub len: i64
    pub cap: i64

pub fn new_live_interval_vec() -> LiveIntervalVec:
    return LiveIntervalVec(data: null as ptr[LiveInterval], len: 0, cap: 0)

pub fn push(mut self: LiveIntervalVec, iv: LiveInterval) -> u32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[LiveInterval]
        if self.data != null as ptr[LiveInterval]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as u32
    self.data[self.len] = iv
    self.len = self.len + 1
    return idx

pub fn is_two_operand_read(op: u16) -> bool:
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR or op == MACH_NEG or op == MACH_NOT:
        return true
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE:
        return true
    // BUG#41: comisd (MACH_FCMP) READS its dst operand (the lhs float). Without
    // this, the lhs's live interval is not extended to the compare, so it looks
    // dead right after its FCONST and the rhs's FCONST can be allocated the SAME
    // XMM -> comisd compares a value against itself -> every strict float compare
    // is false. At -O0 a laundering COPY masked it; at -O1 copy-prop removes it.
    if op == MACH_FCMP:
        return true
    // BUG#42: the float RMW ops lower to `op dst, src` (addsd/subsd/mulsd/divsd)
    // which READ dst. Same liveness hazard as FCMP -- without marking dst a read,
    // a chained result (e.g. `(a+b)*0.5`) is considered dead at the second op and
    // its XMM is reused, corrupting the value. Treat dst as a use, like MACH_*.
    if op == MACH_FADD or op == MACH_FSUB or op == MACH_FMUL or op == MACH_FDIV:
        return true
    return false

// RFC 0016 P2': does this opcode WRITE (overwrite) its dst vreg? Used to build the
// per-block def-set for CFG-aware liveness. CRITICAL SAFETY RULE: an opcode that
// only *reads* its dst (CMP/TEST/STORE/FCMP) must NOT be treated as a def â€” marking
// it a def would kill the value backward across the block and shrink its live range
// (miscompile). When unsure, return false: failing to record a def only keeps a
// value live longer (conservative, extra spills at worst), never wrong.
// Count trailing zeros of a non-zero u64 (position of the lowest set bit).
pub fn ctz_u64(x: u64) -> i64:
    if x == 0 as u64:
        return 64 as i64
    mut n := 0 as i64
    mut v := x
    while (v & (1 as u64)) == 0 as u64:
        v = v >> (1 as u64)
        n = n + 1 as i64
    return n

pub fn inst_defs_dst(op: u16) -> bool:
    if op == MACH_MOV or op == MACH_MOV_IMM or op == MACH_XOR_ZERO:
        return true
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_NEG or op == MACH_NOT:
        return true
    if op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR:
        return true
    if op == MACH_SETCC or op == MACH_MOVZX_B or op == MACH_LEA or op == MACH_LOAD or op == MACH_POP:
        return true
    if op == MACH_IDIV or op == MACH_DIV:
        return true
    if op == MACH_FADD or op == MACH_FSUB or op == MACH_FMUL or op == MACH_FDIV:
        return true
    if op == MACH_ITOF or op == MACH_FTOI or op == MACH_MOVDQ or op == MACH_MOVQD:
        return true
    if op == MACH_CVTSS2SD or op == MACH_CVTSD2SS:
        return true
    return false

pub fn compute_liveness(insts: ptr[MachInst], insts_len: i64) -> LiveIntervalVec:
    mut max_vreg := 0 as u32
    mut i := 0 as i64
    while i < insts_len:
        let inst = &insts[i]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        i = i + 1

    let map_size = (max_vreg + 1 as u32) as i64
    let interval_map = @alloc(map_size * 8) as ptr[ptr[LiveInterval]]
    @memset(interval_map as ptr[u8], 0 as u8, map_size * 8)

    i = 0 as i64
    while i < insts_len:
        let inst = &insts[i]

        if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
            let v = inst.dst.vreg
            if interval_map[v] == null as ptr[LiveInterval]:
                let iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = i as i32
                // M6 perf: a param snapshot (`MOV pv <- PHYS(arg reg)`) used to be pinned
                // live to the LAST instruction of the function. That predates the CFG-aware
                // dataflow below (RFC 0016 P2'), which already extends any vreg live across a
                // back-edge â€” including a param re-entered by RFC 0026 tail-self-recursion,
                // whose snapshot sits before .L_b_0 â€” to the linear hull of every block where
                // it is live. With the pin, EVERY param interfered with EVERY later value and
                // spanned every call, so it was forced into a callee-saved register and its
                // copy chain (`snap<-rcx; local<-snap`) could never be coalesced by the
                // move_partner bias: fib paid a push/pop of %rbx on all ~331M calls to hold a
                // value that is dead two instructions in. Ending the interval at the def and
                // letting the dataflow grow it is strictly more precise, never shorter than
                // real liveness (step 7 only grows intervals).
                iv.end = i as i32
                interval_map[v] = iv

        if inst.src1.kind == OPND_VREG and inst.src1.vreg != 0 as u32:
            let v = inst.src1.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if inst.src2.kind == OPND_VREG and inst.src2.vreg != 0 as u32:
            let v = inst.src2.vreg
            mut iv = interval_map[v]
            if iv == null as ptr[LiveInterval]:
                iv = @alloc(12) as ptr[LiveInterval]
                iv.vreg = v
                iv.start = 0 as i32
                iv.end = i as i32
                interval_map[v] = iv
            elif (i as i32) > iv.end:
                iv.end = i as i32

        if is_two_operand_read(inst.op):
            if inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                let v = inst.dst.vreg
                mut iv = interval_map[v]
                if iv == null as ptr[LiveInterval]:
                    iv = @alloc(12) as ptr[LiveInterval]
                    iv.vreg = v
                    iv.start = 0 as i32
                    iv.end = i as i32
                    interval_map[v] = iv
                elif (i as i32) > iv.end:
                    iv.end = i as i32
        i = i + 1

    // ===== CFG-aware liveness extension (RFC 0016 P2') =====
    // The base [first_def, last_use] intervals above are computed in *linear
    // instruction-array order*. That is only correct when the physical order is a
    // CFG topological order â€” which it is NOT once a lowering emits blocks out of
    // control-flow order (the if/else merge block, and future mid-expression
    // short-circuit blocks). The old back-edge hack only patched linearly-backward
    // jumps (loops) and could not see forward-reordered blocks, and it was not a
    // real dataflow so it also mis-handled some loop-carried values (t_math under
    // RPO). Here we build the basic-block CFG, solve live-in/live-out by backward
    // dataflow, then extend each vreg's contiguous interval to cover the linear
    // hull of every block where it is live. Extension only *grows* intervals, so it
    // can never shrink a real live range: at worst it is conservative (more
    // interference / spills), never a miscompile.
    if insts_len > 0 as i64:
        // --- 1. block boundaries: a block starts at index 0, at every LABEL, and
        //        at the instruction right after any JMP/JCC/RET terminator. ---
        let is_start = @alloc(insts_len) as ptr[bool]
        @memset(is_start as ptr[u8], 0 as u8, insts_len)
        is_start[0] = true
        mut si := 0 as i64
        while si < insts_len:
            let sop = insts[si].op
            if sop == MACH_LABEL:
                is_start[si] = true
            if sop == MACH_JMP or sop == MACH_JCC or sop == MACH_RET:
                if si + 1 as i64 < insts_len:
                    is_start[si + 1 as i64] = true
            si = si + 1

        // --- 2. assign block ids + lo/hi linear bounds ---
        let block_of = @alloc(insts_len * 4) as ptr[i32]
        mut nb := 0 as i64
        si = 0
        while si < insts_len:
            if is_start[si] and si > 0 as i64:
                nb = nb + 1
            block_of[si] = nb as i32
            si = si + 1
        let num_blocks = nb + 1 as i64

        let block_lo = @alloc(num_blocks * 8) as ptr[i64]
        let block_hi = @alloc(num_blocks * 8) as ptr[i64]
        mut bfill := 0 as i64
        while bfill < num_blocks:
            block_lo[bfill] = -1 as i64
            bfill = bfill + 1
        si = 0
        while si < insts_len:
            let b = block_of[si] as i64
            if block_lo[b] < 0 as i64:
                block_lo[b] = si
            block_hi[b] = si
            si = si + 1

        // --- 3. label -> block id ---
        mut max_label := 0 as u32
        si = 0
        while si < insts_len:
            if insts[si].op == MACH_LABEL:
                if insts[si].dst.label > max_label:
                    max_label = insts[si].dst.label
            si = si + 1
        let l2b_size = (max_label + 1 as u32) as i64
        let label_to_block = @alloc(l2b_size * 8) as ptr[i64]
        mut lf := 0 as i64
        while lf < l2b_size:
            label_to_block[lf] = -1 as i64
            lf = lf + 1
        si = 0
        while si < insts_len:
            if insts[si].op == MACH_LABEL:
                label_to_block[insts[si].dst.label as i64] = block_of[si] as i64
            si = si + 1

        // --- 4. successors (up to 2): JMP->target, JCC->target+fallthrough,
        //        RET->none, else fallthrough. Unknown targets fall through
        //        (conservative). ---
        let succ0 = @alloc(num_blocks * 8) as ptr[i64]
        let succ1 = @alloc(num_blocks * 8) as ptr[i64]
        mut sb := 0 as i64
        while sb < num_blocks:
            succ0[sb] = -1 as i64
            succ1[sb] = -1 as i64
            let last = &insts[block_hi[sb]]
            mut handled := false
            if last.op == MACH_JMP and last.dst.kind == OPND_LABEL:
                succ0[sb] = label_to_block[last.dst.label as i64]
                handled = true
            elif last.op == MACH_JCC and last.dst.kind == OPND_LABEL:
                succ0[sb] = label_to_block[last.dst.label as i64]
                if sb + 1 as i64 < num_blocks:
                    succ1[sb] = sb + 1 as i64
                handled = true
            elif last.op == MACH_RET:
                handled = true
            if not handled:
                if sb + 1 as i64 < num_blocks:
                    succ0[sb] = sb + 1 as i64
            sb = sb + 1

        // --- 5. per-block def/use bitsets (bit index = vreg id) ---
        let nwords = ((max_vreg as i64) + 64 as i64) / 64 as i64
        let use_set = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let def_set = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let live_in = @alloc(num_blocks * nwords * 8) as ptr[u64]
        let live_out = @alloc(num_blocks * nwords * 8) as ptr[u64]
        @memset(use_set as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(def_set as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(live_in as ptr[u8], 0 as u8, num_blocks * nwords * 8)
        @memset(live_out as ptr[u8], 0 as u8, num_blocks * nwords * 8)

        mut b2 := 0 as i64
        while b2 < num_blocks:
            let base_w = b2 * nwords
            mut ii := block_lo[b2]
            while ii <= block_hi[b2]:
                let inst = &insts[ii]
                // reads: src1, src2, and dst when the op reads dst too. A read is
                // an upward-exposed use only if not yet defined earlier in the block.
                if inst.src1.kind == OPND_VREG and inst.src1.vreg != 0 as u32:
                    let v = inst.src1.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                if inst.src2.kind == OPND_VREG and inst.src2.vreg != 0 as u32:
                    let v = inst.src2.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                if is_two_operand_read(inst.op) and inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                    let v = inst.dst.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    if (def_set[w] & mask) == 0 as u64:
                        use_set[w] = use_set[w] | mask
                // def: only opcodes that actually overwrite dst.
                if inst_defs_dst(inst.op) and inst.dst.kind == OPND_VREG and inst.dst.vreg != 0 as u32:
                    let v = inst.dst.vreg as i64
                    let w = base_w + (v / 64 as i64)
                    let mask = (1 as u64) << ((v & 63 as i64) as u64)
                    def_set[w] = def_set[w] | mask
                ii = ii + 1
            b2 = b2 + 1

        // --- 6. backward dataflow fixpoint ---
        //   live_out[b] = U live_in[succ]
        //   live_in[b]  = use[b] U (live_out[b] - def[b])
        mut changed := true
        while changed:
            changed = false
            mut bb := num_blocks - 1 as i64
            while bb >= 0 as i64:
                let base_w = bb * nwords
                let s0 = succ0[bb]
                let s1 = succ1[bb]
                mut w := 0 as i64
                while w < nwords:
                    mut lo_word := 0 as u64
                    if s0 >= 0 as i64:
                        lo_word = lo_word | live_in[s0 * nwords + w]
                    if s1 >= 0 as i64:
                        lo_word = lo_word | live_in[s1 * nwords + w]
                    live_out[base_w + w] = lo_word
                    let new_li = use_set[base_w + w] | (lo_word & (~def_set[base_w + w]))
                    if new_li != live_in[base_w + w]:
                        live_in[base_w + w] = new_li
                        changed = true
                    w = w + 1
                bb = bb - 1 as i64

        // --- 7. extend intervals to the linear hull of live blocks ---
        //   live_in[b]  -> the vreg is live at b's entry: cover down to block_lo[b]
        //   live_out[b] -> the vreg is live at b's exit:  cover up to block_hi[b]
        mut b3 := 0 as i64
        while b3 < num_blocks:
            let base_w = b3 * nwords
            let lo = block_lo[b3] as i32
            let hi = block_hi[b3] as i32
            mut w := 0 as i64
            while w < nwords:
                mut liw := live_in[base_w + w]
                while liw != 0 as u64:
                    let tz = ctz_u64(liw)
                    let v = (w * 64 as i64) + tz
                    let iv = interval_map[v]
                    if iv != null as ptr[LiveInterval]:
                        if lo < iv.start:
                            iv.start = lo
                    liw = liw & (liw - 1 as u64)
                mut low := live_out[base_w + w]
                while low != 0 as u64:
                    let tz = ctz_u64(low)
                    let v = (w * 64 as i64) + tz
                    let iv = interval_map[v]
                    if iv != null as ptr[LiveInterval]:
                        if hi > iv.end:
                            iv.end = hi
                    low = low & (low - 1 as u64)
                w = w + 1
            b3 = b3 + 1

        @free(is_start as ptr[u8])
        @free(block_of as ptr[u8])
        @free(block_lo as ptr[u8])
        @free(block_hi as ptr[u8])
        @free(label_to_block as ptr[u8])
        @free(succ0 as ptr[u8])
        @free(succ1 as ptr[u8])
        @free(use_set as ptr[u8])
        @free(def_set as ptr[u8])
        @free(live_in as ptr[u8])
        @free(live_out as ptr[u8])

    mut result := new_live_interval_vec()
    mut v := 0 as i64
    while v < map_size:
        let iv = interval_map[v]
        if iv != null as ptr[LiveInterval]:
            result.push(iv[0])
            @free(iv as ptr[u8])
        v = v + 1
    @free(interval_map as ptr[u8])

    // Counting sort on start positions â€” O(n + insts_len) vs O(n^2) insertion sort.
    // start values are always in [0, insts_len), so insts_len is the range bound.
    if result.len > 1 as i64 and insts_len > 0 as i64:
        let count_arr = @alloc(insts_len * 4) as ptr[i32]
        @memset(count_arr as ptr[void], 0 as u8, insts_len * 4)
        mut ci := 0 as i64
        while ci < result.len:
            let s = result.data[ci].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] + 1
            ci = ci + 1
        mut pi := 1 as i64
        while pi < insts_len:
            count_arr[pi] = count_arr[pi] + count_arr[pi - 1 as i64]
            pi = pi + 1
        let sorted_buf = @alloc(result.len * 12) as ptr[LiveInterval]
        mut ri := result.len - 1 as i64
        while ri >= 0 as i64:
            let s = result.data[ri].start
            if s >= 0 and s < insts_len as i32:
                count_arr[s as i64] = count_arr[s as i64] - 1
                sorted_buf[count_arr[s as i64]] = result.data[ri]
            ri = ri - 1 as i64
        @memcpy(result.data as ptr[u8], sorted_buf as ptr[u8], result.len * 12)
        @free(sorted_buf as ptr[u8])
        @free(count_arr as ptr[u8])

    return result

pub struct RegAllocation:
    pub vreg: u32
    pub phys: u8
    pub spilled: bool
    pub spill_idx: i32

pub struct RegAllocResult:
    pub allocs: ptr[RegAllocation]
    pub max_vreg: u32
    pub spill_count: i32
    // BUG#18: with exactly {ptr@0, u32@8, i32@12} this struct is 16 bytes and the
    // native backend returns it by value via the str-like RAX:RDX path (which
    // assumes a {ptr, i64} layout), so reads of max_vreg/spill_count come back
    // wrong (max_vreg read returned the `allocs` pointer value -> giant loop
    // bound -> allocs[] OOB segfault). Pad to >16 bytes so it is returned
    // by-address (sret), the heavily-tested aggregate path (cf. LiveIntervalVec).
    pub pad0: i64

// NOTE (M6 perf, 2026-07-24e): a per-ABI "volatile GPRs first" reorder was tried here to
// shrink prologues (fewer callee-saved pushes). MEASURED NEUTRAL â€” fib's prologue was
// unchanged and the self-host driver was byte-identical in size. Reason: fib's callee-saved
// registers hold values LIVE ACROSS A CALL, which forbid volatiles (graph_coloring_alloc:867)
// and therefore MUST be callee-saved regardless of the preference order; the reorder only
// reaches non-call-spanning values, which weren't the bottleneck. The real fib cost is
// structural (redundant copies + greedy-colouring quality + values kept live across calls),
// not the register preference order. Kept the original order; see [[m6-perf-baseline]].
pub fn get_allocatable_gprs(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(12) as ptr[u8]
    arr[0] = REG_RAX
    arr[1] = REG_RCX
    arr[2] = REG_RDX
    arr[3] = REG_RBX
    arr[4] = REG_RSI
    arr[5] = REG_RDI
    arr[6] = REG_R8
    arr[7] = REG_R9
    arr[8] = REG_R12
    arr[9] = REG_R13
    arr[10] = REG_R14
    arr[11] = REG_R15
    out_len[0] = 12
    return arr

pub fn reg_is_caller_saved(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    else:
        if r == REG_RAX or r == REG_RCX or r == REG_RDX or r == REG_RSI or r == REG_RDI or r == REG_R8 or r == REG_R9 or r == REG_R10 or r == REG_R11:
            return true
    return false

pub fn reg_is_parameter_reg(abi: str, r: u8) -> bool:
    if abi == "win64":
        if r == REG_RCX or r == REG_RDX or r == REG_R8 or r == REG_R9:
            return true
    else:
        if r == REG_RDI or r == REG_RSI or r == REG_RDX or r == REG_RCX or r == REG_R8 or r == REG_R9:
            return true
    return false


pub fn graph_coloring_alloc(intervals: LiveIntervalVec, avail_regs: ptr[u8], avail_regs_len: i64, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    if intervals.len == 0 or avail_regs_len == 0:
        return RegAllocResult(allocs: null as ptr[RegAllocation], max_vreg: 0 as u32, spill_count: 0 as i32, pad0: 0 as i64)

    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    // PERF: one def-index for the whole allocation; feeds regalloc_is_16byte_cached
    // in both the spill-all fallback (per interval) and the coloring phase, turning
    // their O(vregs Ã— insts) 16-byte checks into O(vregs). Freed on every return.
    let r16_def_idx = build_vreg_def_idx(fn_ptr, graph_size)

    let param_idx_of_vreg = @alloc(graph_size * 4) as ptr[i32]
    mut param_vi := 0 as i64
    while param_vi < graph_size:
        param_idx_of_vreg[param_vi] = -1 as i32
        param_vi = param_vi + 1

    mut inst_idx := 0 as i64
    while inst_idx < insts_len:
        let inst = insts[inst_idx]
        if inst.op == MACH_MOV and inst.dst.kind == OPND_VREG and inst.src1.kind == OPND_PHYS:
            let phys = inst.src1.phys
            mut p_idx := -1 as i32
            if abi == "win64":
                if phys == REG_RCX:
                    p_idx = 0 as i32
                elif phys == REG_RDX:
                    p_idx = 1 as i32
                elif phys == REG_R8:
                    p_idx = 2 as i32
                elif phys == REG_R9:
                    p_idx = 3 as i32
            else:
                if phys == REG_RDI:
                    p_idx = 0 as i32
                elif phys == REG_RSI:
                    p_idx = 1 as i32
                elif phys == REG_RDX:
                    p_idx = 2 as i32
                elif phys == REG_RCX:
                    p_idx = 3 as i32
                elif phys == REG_R8:
                    p_idx = 4 as i32
                elif phys == REG_R9:
                    p_idx = 5 as i32
            
            if p_idx != -1 as i32:
                let vr = inst.dst.vreg
                if vr < max_vreg + 1 as u32:
                    param_idx_of_vreg[vr as i64] = p_idx
        inst_idx = inst_idx + 1

    // Determine for each virtual register if its live interval spans any call instruction
    let spans_call = @alloc(graph_size) as ptr[bool]
    @memset(spans_call as ptr[u8], 0 as u8, graph_size)

    let forbid_rax_rdx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rax_rdx as ptr[u8], 0 as u8, graph_size)

    let forbid_rcx = @alloc(graph_size) as ptr[bool]
    @memset(forbid_rcx as ptr[u8], 0 as u8, graph_size)

    let is_arg_vreg = @alloc(graph_size) as ptr[bool]
    @memset(is_arg_vreg as ptr[u8], 0 as u8, graph_size)

    let address_taken = @alloc(graph_size) as ptr[bool]
    @memset(address_taken as ptr[u8], 0 as u8, graph_size)

    // MOVE COALESCING (biased coloring): for each vreg, record ONE move partner â€”
    // the other vreg of a `MOV vdst, vsrc` it appears in. During color selection we
    // try to give a vreg the same physical register its partner already got, so the
    // MOV becomes a self-move (`mov r,r`) the emitter peephole then deletes. This
    // removes the redundant param/snapshot copy chains (`snap<-rcx; pvreg<-snap`)
    // that otherwise inflate register pressure and force extra callee-saved pushes.
    // SAFETY: the bias only ever picks a color that is NOT forbidden (interference,
    // spans_call, arg-reg, div/shift constraints all already recorded there) and that
    // is a member of this pass's avail_regs (so a cross-class movq gpr<->xmm partner
    // can never mis-bias). First move wins; a vreg in no vreg-to-vreg MOV stays -1.
    let move_partner = @alloc(graph_size * 4) as ptr[i32]
    mut mp_init := 0 as i64
    while mp_init < graph_size:
        move_partner[mp_init] = -1 as i32
        mp_init = mp_init + 1

    mut scan_idx := 0 as i64
    while scan_idx < insts_len:
        let inst = &insts[scan_idx]
        if (inst.op == MACH_IDIV or inst.op == MACH_DIV) and inst.src1.kind == OPND_VREG:
            // RFC 0006: the (unsigned) DIV divisor, like IDIV's, must avoid
            // rax/rdx â€” those are the implicit dividend/remainder and the
            // sequence zeroes rdx, which would clobber a divisor placed there.
            let v = inst.src1.vreg
            if v < graph_size as u32:
                forbid_rax_rdx[v] = true
        
        if (inst.op == MACH_SHL or inst.op == MACH_SAR or inst.op == MACH_SHR) and inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            if v < graph_size as u32:
                forbid_rcx[v] = true
        
        // Tag virtual registers that are loaded into parameter registers for calls/syscalls
        if inst.op == MACH_MOV or inst.op == MACH_STORE:
            if inst.dst.kind == OPND_PHYS:
                if reg_is_parameter_reg(abi, inst.dst.phys):
                    if inst.src1.kind == OPND_VREG:
                        let v = inst.src1.vreg
                        if v < graph_size as u32:
                            is_arg_vreg[v] = true
        elif inst.op == MACH_LEA and inst.padding != 1 as u8:
            // `padding == 1` marks a LEA the selector emitted as VALUE arithmetic
            // (`x + <const>` folded into one instruction), not as taking a vreg's address.
            // Without that exclusion the fold would be self-defeating: reaching this branch
            // forces the base vreg to be SPILLED unconditionally below, so `n` would move to
            // memory on every call to save one register-only instruction.
            if inst.src1.kind == OPND_VREG:
                let v = inst.src1.vreg
                if v < graph_size as u32:
                    address_taken[v] = true
        if inst.op == MACH_MOV and inst.dst.kind == OPND_VREG and inst.src1.kind == OPND_VREG:
            let vd = inst.dst.vreg
            let vs = inst.src1.vreg
            if vd != vs and vd < graph_size as u32 and vs < graph_size as u32:
                if move_partner[vd as i64] == -1 as i32:
                    move_partner[vd as i64] = vs as i32
                if move_partner[vs as i64] == -1 as i32:
                    move_partner[vs as i64] = vd as i32
        scan_idx = scan_idx + 1

    // Precompute call instruction positions once so each interval check is O(log m)
    // instead of the naive O(m) inner scan per interval.
    let call_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut call_count := 0 as i64
    mut ci_scan := 0 as i64
    while ci_scan < insts_len:
        let op2 = insts[ci_scan].op
        if op2 == MACH_CALL or op2 == MACH_CALL_INDIRECT:
            call_pos[call_count] = ci_scan as i32
            call_count = call_count + 1
        ci_scan = ci_scan + 1

    mut iv_idx := 0 as i64
    while iv_idx < intervals.len:
        let vreg = intervals.data[iv_idx].vreg
        let istart = intervals.data[iv_idx].start
        let iend = intervals.data[iv_idx].end
        if call_count > 0 as i64:
            mut lo := 0 as i64
            mut hi := call_count - 1 as i64
            while lo <= hi:
                let mid = (lo + hi) / 2 as i64
                let cp = call_pos[mid]
                if cp <= istart:
                    lo = mid + 1 as i64
                elif cp >= iend:
                    hi = mid - 1 as i64
                else:
                    spans_call[vreg] = true
                    break
        iv_idx = iv_idx + 1
    @free(call_pos as ptr[u8])

    // MACH_IDIV / MACH_DIV clobber RAX and RDX (the `cqo; idiv` and `mov rdx,0;
    // div` sequences). Any vreg whose live range SPANS a division â€” not just the
    // dividend/divisor (handled above) â€” must not be assigned RAX/RDX, otherwise
    // the division silently destroys it. This bit the reverse-loop counter `i`
    // (held in RDX) across `len / 2`: `cqo` wiped RDX â†’ infinite loop; and any
    // function doing `/`/`%` with a live RDX/RAX value (incl. the parser â†’ stage3
    // token misread). BUG#47: the UNSIGNED path emits MACH_DIV (not MACH_IDIV),
    // so this span pass must scan BOTH â€” otherwise an unsigned `%`/`/` in a loop
    // wipes a loop-carried value sitting in RDX (e.g. the dividend `n` across a
    // trial-division primality loop). Mirror the spans_call logic.
    let idiv_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut idiv_count := 0 as i64
    mut di_scan := 0 as i64
    while di_scan < insts_len:
        // MACH_DIVCLOBBER marks a div/mod-by-pow2 strength-reduced sequence that
        // clobbers RAX+RDX (see x86_selector.ax); treat it exactly like IDIV/DIV so
        // any vreg whose live range spans it is denied RAX/RDX.
        if insts[di_scan].op == MACH_IDIV or insts[di_scan].op == MACH_DIV or insts[di_scan].op == MACH_DIVCLOBBER:
            idiv_pos[idiv_count] = di_scan as i32
            idiv_count = idiv_count + 1
        di_scan = di_scan + 1

    if idiv_count > 0 as i64:
        mut iv2 := 0 as i64
        while iv2 < intervals.len:
            let vreg2 = intervals.data[iv2].vreg
            let istart2 = intervals.data[iv2].start
            let iend2 = intervals.data[iv2].end
            mut lo2 := 0 as i64
            mut hi2 := idiv_count - 1 as i64
            while lo2 <= hi2:
                let mid2 = (lo2 + hi2) / 2 as i64
                let dp = idiv_pos[mid2]
                if dp <= istart2:
                    lo2 = mid2 + 1 as i64
                elif dp >= iend2:
                    hi2 = mid2 - 1 as i64
                else:
                    if vreg2 < graph_size as u32:
                        forbid_rax_rdx[vreg2] = true
                    break
            iv2 = iv2 + 1
    @free(idiv_pos as ptr[u8])

    // A VARIABLE-COUNT shift clobbers RCX. x86 can only shift by an immediate or by
    // CL, so `MACH_SHL/SAR/SHR` whose count operand is NOT an immediate is emitted as
    // the `_cl` form (x86_emitter.ax:326-342) preceded by `MOV PHYS(rcx) <- count`.
    // That mov destroys whatever else was living in RCX. The `forbid_rcx` scan above
    // only protects the shift's own DESTINATION vreg, which is not the value at risk:
    // any vreg whose live range merely SPANS the shift can be sitting in RCX and is
    // silently corrupted. Mirror the IDIV/RAX-RDX span rule above and deny RCX to every
    // interval that strictly contains a variable shift. (Immediate-count shifts â€”
    // `sar $1,%rax`, incl. the div/mod-by-pow2 strength reduction â€” never touch RCX and
    // must NOT be included, or every shift-heavy function loses a register for nothing.)
    // LATENT until parameter liveness became precise: params used to be pinned live to
    // the end of their function, so they always spanned a call and were forced into
    // callee-saved registers, never RCX. With precise intervals a pointer param landed
    // in RCX across `n >> 1` and the callee wrote through a corrupted pointer (t_fft
    // SIGSEGV) â€” the bug was always here, the pin was accidentally hiding it.
    let vshift_pos = @alloc(insts_len * 4 + 4) as ptr[i32]
    mut vshift_count := 0 as i64
    mut vs_scan := 0 as i64
    while vs_scan < insts_len:
        let vop = insts[vs_scan].op
        if vop == MACH_SHL or vop == MACH_SAR or vop == MACH_SHR:
            if insts[vs_scan].src1.kind != OPND_IMM:
                vshift_pos[vshift_count] = vs_scan as i32
                vshift_count = vshift_count + 1
        vs_scan = vs_scan + 1

    if vshift_count > 0 as i64:
        mut iv3 := 0 as i64
        while iv3 < intervals.len:
            let vreg3 = intervals.data[iv3].vreg
            let istart3 = intervals.data[iv3].start
            let iend3 = intervals.data[iv3].end
            mut lo3 := 0 as i64
            mut hi3 := vshift_count - 1 as i64
            while lo3 <= hi3:
                let mid3 = (lo3 + hi3) / 2 as i64
                let sp = vshift_pos[mid3]
                if sp <= istart3:
                    lo3 = mid3 + 1 as i64
                elif sp >= iend3:
                    hi3 = mid3 - 1 as i64
                else:
                    if vreg3 < graph_size as u32:
                        forbid_rcx[vreg3] = true
                    break
            iv3 = iv3 + 1
    @free(vshift_pos as ptr[u8])

    // For very large functions, the O(n^2) interference graph overflows memory.
    // Fall back to spill-all: every vreg gets a stack slot.
    // Correct but conservative; the emitter already handles spills.
    // insts_len > 5000 catches huge selector functions (~10K mach insts) that
    // would OOM even with a modest interval count.
    let REGALLOC_GRAPH_LIMIT: i64 = 50000
    let REGALLOC_INSTS_LIMIT: i64 = 5000
    if intervals.len > REGALLOC_GRAPH_LIMIT or insts_len > REGALLOC_INSTS_LIMIT:
        let allocs_s = @alloc(graph_size * 12) as ptr[RegAllocation]
        @memset(allocs_s as ptr[u8], 0 as u8, graph_size * 12)
        let seen_s = @alloc(graph_size) as ptr[bool]
        @memset(seen_s as ptr[u8], 0 as u8, graph_size)
        mut spill_count_s := 0 as i32
        mut siv := 0 as i64
        while siv < intervals.len:
            let sv := intervals.data[siv].vreg
            if not seen_s[sv]:
                seen_s[sv] = true
                allocs_s[sv] = RegAllocation(vreg: sv, phys: REG_NONE, spilled: true, spill_idx: spill_count_s)
                // 16-byte (str/16-byte struct) values occupy TWO 8-byte stack
                // slots. The graph-coloring path reserves 2; this spill-all
                // fallback (used for large functions) MUST do the same, else
                // each spilled 16-byte value clobbers the next vreg's slot.
                if regalloc_is_16byte_cached(sv, fn_ptr, table, symbols, r16_def_idx, graph_size):
                    spill_count_s = spill_count_s + 2
                else:
                    spill_count_s = spill_count_s + 1
            siv = siv + 1
        @free(seen_s as ptr[u8])
        @free(param_idx_of_vreg as ptr[u8])
        @free(spans_call as ptr[u8])
        @free(forbid_rax_rdx as ptr[u8])
        @free(forbid_rcx as ptr[u8])
        @free(is_arg_vreg as ptr[u8])
        @free(address_taken as ptr[u8])
        @free(move_partner as ptr[u8])
        @free(r16_def_idx as ptr[u8])
        return RegAllocResult(allocs: allocs_s, max_vreg: max_vreg, spill_count: spill_count_s, pad0: 0 as i64)

    let adj = @alloc(graph_size * 24) as ptr[U32Vec]
    mut vi := 0 as i64
    while vi < graph_size:
        adj[vi] = new_u32_vec()
        vi = vi + 1

    mut i := 0 as i64
    while i < intervals.len:
        let iv1 = &intervals.data[i]
        mut j := i + 1
        while j < intervals.len:
            let iv2 = &intervals.data[j]
            if iv2.start > iv1.end:
                break
            if iv1.vreg != iv2.vreg:
                // MOVE COALESCING: a copy pair `d <- s` whose live ranges only TOUCH
                // at the copy point (s dies exactly where d begins) is not a real
                // conflict â€” the same register can hold s then d, making the copy a
                // self-move. The interval model would otherwise flag boundary contact
                // (iv2.start == iv1.end) as interference and forbid the shared color.
                // Drop the edge ONLY for a recorded move partner AND only when the
                // ranges are boundary-disjoint (no true overlap), so genuinely
                // simultaneously-live values still interfere. move_partner is
                // first-move-wins (conservative): a non-matching partner keeps the edge.
                mut coalesce_skip := false
                if move_partner[iv1.vreg as i64] == iv2.vreg as i32 or move_partner[iv2.vreg as i64] == iv1.vreg as i32:
                    if iv1.end <= iv2.start or iv2.end <= iv1.start:
                        coalesce_skip = true
                if not coalesce_skip:
                    adj[iv1.vreg].push(iv2.vreg)
                    adj[iv2.vreg].push(iv1.vreg)
            j = j + 1
        i = i + 1

    let degrees = @alloc(graph_size * 4) as ptr[i32]
    mut di := 0 as i64
    while di < graph_size:
        degrees[di] = adj[di].len as i32
        di = di + 1

    let removed = @alloc(graph_size) as ptr[bool]
    @memset(removed as ptr[u8], 0 as u8, graph_size)

    mut stack := new_u32_vec()
    let K = avail_regs_len as i32
    mut simplified_count := 0 as i64
    let target_count = intervals.len

    mut simplify_worklist := new_u32_vec()
    
    let in_worklist = @alloc(graph_size) as ptr[bool]
    @memset(in_worklist as ptr[u8], 0 as u8, graph_size)

    mut init_i := 0 as i64
    while init_i < intervals.len:
        let vreg = intervals.data[init_i].vreg
        if degrees[vreg] < K:
            simplify_worklist.push(vreg)
            in_worklist[vreg] = true
        init_i = init_i + 1

    while simplified_count < target_count:
        if simplify_worklist.len > 0:
            let node = simplify_worklist.pop()
            if not removed[node]:
                stack.push(node)
                removed[node] = true
                simplified_count = simplified_count + 1
                
                mut n_idx := 0 as i64
                while n_idx < adj[node].len:
                    let neighbor = adj[node].data[n_idx]
                    if not removed[neighbor]:
                        degrees[neighbor] = degrees[neighbor] - 1
                        if degrees[neighbor] < K and not in_worklist[neighbor]:
                            simplify_worklist.push(neighbor)
                            in_worklist[neighbor] = true
                    n_idx = n_idx + 1
        else:
            mut spill_candidate := 0 as u32
            mut max_degree := -1 as i32
            mut has_candidate := false

            mut iv_idx := 0 as i64
            while iv_idx < intervals.len:
                let vreg = intervals.data[iv_idx].vreg
                if not removed[vreg]:
                    if degrees[vreg] > max_degree:
                        max_degree = degrees[vreg]
                        spill_candidate = vreg
                        has_candidate = true
                iv_idx = iv_idx + 1

            if not has_candidate:
                break

            stack.push(spill_candidate)
            removed[spill_candidate] = true
            simplified_count = simplified_count + 1

            mut n_idx := 0 as i64
            while n_idx < adj[spill_candidate].len:
                let neighbor = adj[spill_candidate].data[n_idx]
                if not removed[neighbor]:
                    degrees[neighbor] = degrees[neighbor] - 1
                    if degrees[neighbor] < K and not in_worklist[neighbor]:
                        simplify_worklist.push(neighbor)
                        in_worklist[neighbor] = true
                n_idx = n_idx + 1


    let assigned_colors = @alloc(graph_size) as ptr[u8]
    @memset(assigned_colors, REG_NONE, graph_size)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)
    mut spill_count := 0 as i32

    mut st_idx := stack.len - 1
    while st_idx >= 0:
        let vreg = stack.data[st_idx]
        let forbidden = @alloc(256) as ptr[bool]
        @memset(forbidden as ptr[u8], 0 as u8, 256)

        let p_idx = param_idx_of_vreg[vreg as i64]
        if p_idx != -1 as i32:
            mut j := (p_idx + 1) as i64
            while j < 6 as i64:
                let r = abi_int_arg_reg(abi, j)
                if r != REG_NONE:
                    forbidden[r as i64] = true
                j = j + 1

        mut n_idx := 0 as i64
        while n_idx < adj[vreg].len:
            let neighbor = adj[vreg].data[n_idx]
            let color = assigned_colors[neighbor]
            if color != REG_NONE:
                forbidden[color] = true
            n_idx = n_idx + 1

        if spans_call[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_caller_saved(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if is_arg_vreg[vreg]:
            mut r := 0 as i64
            while r < 256:
                if reg_is_parameter_reg(abi, r as u8):
                    forbidden[r] = true
                r = r + 1

        if forbid_rax_rdx[vreg]:
            forbidden[REG_RAX as i64] = true
            forbidden[REG_RDX as i64] = true

        if forbid_rcx[vreg]:
            forbidden[REG_RCX as i64] = true

        mut colored := false
        // COALESCE BIAS: if this vreg's move partner is already colored with a legal
        // (non-forbidden, this-class) register, take it so the copy becomes a self-move.
        let mp = move_partner[vreg as i64]
        if mp != -1 as i32 and (mp as i64) < graph_size:
            let pcolor = assigned_colors[mp as i64]
            if pcolor != REG_NONE and not forbidden[pcolor as i64]:
                mut in_avail := false
                mut ai := 0 as i64
                while ai < avail_regs_len:
                    if avail_regs[ai] == pcolor:
                        in_avail = true
                        break
                    ai = ai + 1
                if in_avail:
                    assigned_colors[vreg] = pcolor
                    allocs[vreg] = RegAllocation(vreg: vreg, phys: pcolor, spilled: false, spill_idx: 0 as i32)
                    colored = true
        mut c_idx := 0 as i64
        while not colored and c_idx < avail_regs_len:
            let color = avail_regs[c_idx]
            if not forbidden[color]:
                assigned_colors[vreg] = color
                allocs[vreg] = RegAllocation(vreg: vreg, phys: color, spilled: false, spill_idx: 0 as i32)
                colored = true
                break
            c_idx = c_idx + 1

        @free(forbidden as ptr[u8])

        if regalloc_is_16byte_cached(vreg, fn_ptr, table, symbols, r16_def_idx, graph_size):
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 2
            assigned_colors[vreg] = REG_NONE
        elif address_taken[vreg]:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE
        elif not colored:
            allocs[vreg] = RegAllocation(vreg: vreg, phys: REG_NONE, spilled: true, spill_idx: spill_count)
            spill_count = spill_count + 1
            assigned_colors[vreg] = REG_NONE

        st_idx = st_idx - 1

    @free(removed as ptr[u8])
    @free(degrees as ptr[u8])
    @free(assigned_colors)
    @free(spans_call as ptr[u8])
    @free(forbid_rax_rdx as ptr[u8])
    @free(forbid_rcx as ptr[u8])
    @free(is_arg_vreg as ptr[u8])
    @free(param_idx_of_vreg as ptr[u8])
    @free(address_taken as ptr[u8])
    @free(move_partner as ptr[u8])
    @free(r16_def_idx as ptr[u8])
    @free(in_worklist as ptr[u8])
    if simplify_worklist.data != null as ptr[u32]:
        @free(simplify_worklist.data as ptr[u8])
    if stack.data != null as ptr[u32]:
        @free(stack.data as ptr[u8])

    mut f_idx := 0 as i64
    while f_idx < graph_size:
        if adj[f_idx].data != null as ptr[u32]:
            @free(adj[f_idx].data as ptr[u8])
        f_idx = f_idx + 1
    @free(adj as ptr[u8])

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_count, pad0: 0 as i64)

pub fn get_used_callee_saved(abi: str, allocs: ptr[RegAllocation], max_vreg: u32, out_len: ptr[i64]) -> ptr[u8]:
    // Covers GPR phys 0-15 AND XMM phys 16-31. BUG#44: callee-saved XMM (win64
    // XMM6-15) used for float vregs must be saved/restored across calls just like
    // callee-saved GPRs. They are returned AFTER the GPRs so the prologue pushes
    // GPRs first then movsd-saves XMMs; both occupy 8 bytes per slot, so every
    // frame offset that keys off callee_saved_len (spills, str-lit, pushed_bytes)
    // stays correct with no other change.
    let used = @alloc(32) as ptr[bool]
    @memset(used as ptr[u8], 0 as u8, 32)

    // BUG#17: `max_vreg as i64` (u32->i64 zero-extend) is mis-compiled by the
    // native backend, leaving garbage in the upper 32 bits -> garbage-large
    // bound -> allocs[] OOB. Mask to a clean u32 so the loop stays in range.
    let mv_bound = (max_vreg as i64) & (4294967295 as i64)
    mut i := 0 as i64
    while i <= mv_bound:
        let phys = allocs[i].phys
        if phys != REG_NONE:
            if abi == "win64":
                if reg_is_win64_callee_saved(phys):
                    used[phys] = true
                if reg_is_xmm(phys) and phys >= REG_XMM6:
                    used[phys] = true
            else:
                if reg_is_sysv_callee_saved(phys):
                    used[phys] = true
        i = i + 1

    mut count := 0 as i64
    mut r := 0 as i64
    while r < 32:
        if used[r]:
            count = count + 1
        r = r + 1

    let result = @alloc(count) as ptr[u8]
    mut idx := 0 as i64
    r = 0
    while r < 32:
        if used[r]:
            result[idx] = r as u8
            idx = idx + 1
        r = r + 1

    @free(used as ptr[u8])
    out_len[0] = count
    return result

pub struct StackFrame:
    pub callee_saved: ptr[u8]
    pub callee_saved_len: i64
    pub spill_slots: i32
    pub local_bytes: i32
    pub align_padding: i32
    pub total_size: i32

pub fn compute_frame(callee_saved: ptr[u8], callee_saved_len: i64, spill_count: i32, local_bytes: i32, abi: str) -> StackFrame:
    mut needed := spill_count * 8 + local_bytes
    if abi == "win64":
        needed = needed + 32
    let pushed_bytes = (callee_saved_len + 2) * 8

    mut total := needed
    mut padding := 0 as i32
    if (pushed_bytes + total as i64) % 16 != 0:
        padding = (16 as i64 - (pushed_bytes + total as i64) % 16) as i32
        total = total + padding

    return StackFrame(
        callee_saved: callee_saved,
        callee_saved_len: callee_saved_len,
        spill_slots: spill_count,
        local_bytes: local_bytes,
        align_padding: padding,
        total_size: total
    )

pub fn emit_prologue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
    out_insts.push(MachInst(op: MACH_MOV, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := 0 as i64
    while i < frame.callee_saved_len:
        let reg = frame.callee_saved[i]
        if reg_is_xmm(reg):
            // BUG#44: callee-saved XMM -> reserve a slot and movsd-save it. The
            // slot is at rbp-(i+1)*8 (contiguous below the GPR pushes), matching
            // what `sub rsp,8` just reserved; using rbp-relative movsd reuses the
            // working spill encoding (avoids the rsp-base SIB edge case).
            out_insts.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
            let xoff = 0 as i64 - (i + 1) * 8
            out_insts.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: xoff)))
        else:
            out_insts.push(MachInst(op: MACH_PUSH, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i + 1

    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_SUB, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub fn emit_epilogue(frame: ptr[StackFrame], out_insts: ptr[MachInstVec]):
    if frame.total_size > 0:
        out_insts.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: frame.total_size as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

    mut i := frame.callee_saved_len - 1
    while i >= 0:
        let reg = frame.callee_saved[i]
        if reg_is_xmm(reg):
            // BUG#44: restore callee-saved XMM (movsd back) then release its slot.
            let xoff = 0 as i64 - (i + 1) * 8
            out_insts.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: xoff)))
            out_insts.push(MachInst(op: MACH_ADD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RSP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 8 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        else:
            out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: reg, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))
        i = i - 1

    out_insts.push(MachInst(op: MACH_POP, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_NONE, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)))

pub const DST_UNUSED: u8 = 0
pub const DST_WRITE_ONLY: u8 = 1
pub const DST_READ_WRITE: u8 = 2
pub const DST_READ_ONLY: u8 = 3

// EVERY opcode that writes its dst must be classified here. An unclassified
// writer falls through to DST_UNUSED, and insert_spill_code then pushes it
// UNCHANGED â€” leaving a spilled dst as a raw vreg that emitter_resolve_reg
// resolves to REG_NONE (255). The encoders mask that to 4 bits, so the write
// silently lands in %xmm15 / %r15 instead of the spill slot. That is exactly
// how the float ALU ops below were miscompiling: `a = a + c` on a spilled f64
// wrote xmm15 and left the slot holding the PRE-add value, so the accumulator
// lost one update per spilled operation (invisible until >8 f64 are live at
// once, i.e. more than the 8 allocatable XMMs).
pub fn get_dst_behavior(op: u16) -> u8:
    if op == MACH_MOV or op == MACH_MOV_IMM or op == MACH_XOR_ZERO or op == MACH_SETCC or op == MACH_MOVZX_B or op == MACH_POP or op == MACH_LOAD or op == MACH_LEA:
        return DST_WRITE_ONLY
    // Float/convert writers. ITOF/FTOI/MOVDQ/MOVQD/CVTSS2SD/CVTSD2SS overwrite
    // dst outright; the four float ALU ops are accumulate-in-place (dst = dst OP
    // src1), so they READ dst as well and must round-trip through the slot.
    if op == MACH_ITOF or op == MACH_FTOI or op == MACH_MOVDQ or op == MACH_MOVQD or op == MACH_CVTSS2SD or op == MACH_CVTSD2SS:
        return DST_WRITE_ONLY
    if op == MACH_ADD or op == MACH_SUB or op == MACH_IMUL or op == MACH_NEG or op == MACH_NOT or op == MACH_AND or op == MACH_OR or op == MACH_XOR or op == MACH_SHL or op == MACH_SAR or op == MACH_SHR:
        return DST_READ_WRITE
    if op == MACH_FADD or op == MACH_FSUB or op == MACH_FMUL or op == MACH_FDIV:
        return DST_READ_WRITE
    if op == MACH_CMP or op == MACH_TEST or op == MACH_STORE or op == MACH_FCMP:
        return DST_READ_ONLY
    return DST_UNUSED

pub fn insert_spill_code(insts: ptr[MachInst], insts_len: i64, allocs: ptr[RegAllocation], frame: ptr[StackFrame], fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> MachInstVec:
    mut result := new_mach_inst_vec()

    // PERF: the per-spilled-operand 16-byte/float checks below linear-scan
    // fn_ptr.insts; on mega-functions (select_inst: ~13k spilled uses) that is
    // O(uses Ã— insts). Build one def-index (sized to the max vreg actually
    // referenced by the mach insts) and query the cached forms. Freed before return.
    mut sp_maxv := 0 as u32
    mut sp_si := 0 as i64
    while sp_si < insts_len:
        let mi = &insts[sp_si]
        if mi.dst.kind == OPND_VREG and mi.dst.vreg > sp_maxv:
            sp_maxv = mi.dst.vreg
        if mi.src1.kind == OPND_VREG and mi.src1.vreg > sp_maxv:
            sp_maxv = mi.src1.vreg
        if mi.src2.kind == OPND_VREG and mi.src2.vreg > sp_maxv:
            sp_maxv = mi.src2.vreg
        sp_si = sp_si + 1
    let sp_def_size = (sp_maxv as i64) + 1 as i64
    let sp_def_idx = build_vreg_def_idx(fn_ptr, sp_def_size)

    // if insts_len > 300 as i64:
    //     ax_printf_local("[Debug] insert_spill_code for function sym_id=%d, len=%d:\n", fn_ptr.sym_id as i64, insts_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //     mut max_v := 0 as u32
    //     mut j := 0 as i64
    //     while j < insts_len:
    //         let inst = insts[j]
    //         ax_printf_local("  inst %d: op=%d, dst.kind=%d, dst.vreg=%d, src1.kind=%d, src1.vreg=%d\n", j, inst.op as i64, inst.dst.kind as i64, inst.dst.vreg as i64, inst.src1.kind as i64, inst.src1.vreg as i64, 0 as i64, 0 as i64)
    //         if inst.dst.kind == 1 as u8 and inst.dst.vreg > max_v:
    //             max_v = inst.dst.vreg
    //         if inst.src1.kind == 1 as u8 and inst.src1.vreg > max_v:
    //             max_v = inst.src1.vreg
    //         if inst.src2.kind == 1 as u8 and inst.src2.vreg > max_v:
    //             max_v = inst.src2.vreg
    //         j = j + 1
    // 
    //     mut k := 0 as i32
    //     while k <= max_v as i32:
    //         let alloc = allocs[k]
    //         if alloc.spilled:
    //             let is_16 = regalloc_is_16byte(k as u32, fn_ptr, table, symbols)
    //             ax_printf_local("  vreg %d: spilled=true, spill_idx=%d, is_16=%d\n", k as i64, alloc.spill_idx as i64, is_16 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    //         k = k + 1

    mut i := 0 as i64
    while i < insts_len:
        mut inst := insts[i]

        if inst.src1.kind == OPND_VREG:
            let v = inst.src1.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16 = regalloc_is_16byte_cached(v, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
                mut add_mult := 1 as i64
                if is_16:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if inst.op == MACH_LEA and inst.src2.kind == OPND_IMM:
                    // GET_FIELD on a pointer / by-ref struct base (the only LEA whose
                    // src2 is an IMM disp): the spilled vreg's SLOT holds a pointer
                    // VALUE (a heap address), not inline data. We want value(src1)+disp,
                    // so LOAD the pointer from the slot into a scratch register and keep
                    // the field disp. Rewriting to RBP+slot+disp (the home-address path
                    // below) would point at this frame's stack slot instead of the heap
                    // object â€” silently losing through-pointer field mutation.
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif inst.op == MACH_LEA:
                    // LEA of a spilled vreg with no disp means "address of the value"
                    // (&self / MAKE_REF / 16-byte value address): rewrite to RBP + slot
                    // offset. Loading the value and taking lea (reg) would yield the
                    // value itself, not its address.
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                    inst.src2 = MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset)
                elif is_16:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg_cached(fn_ptr, v, table, symbols, sp_def_idx, sp_def_size):
                    // RFC 0006: a spilled FLOAT operand must be reloaded into an
                    // XMM scratch via movsd (MACH_LOAD with xmm dst). Reloading
                    // into a GP scratch (R10) would leave the value in the wrong
                    // register file â€” float encoders (addsd/cvttsd2si/â€¦) encode
                    // the operand as XMM, and R10's hw-index aliases XMM10, so the
                    // CPU would read garbage. XMM0/XMM1 are scratch (not in the
                    // allocatable XMM8-15 set).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_XMM0, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src1 = MachOperand(kind: OPND_PHYS, phys: REG_R10, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        if inst.src2.kind == OPND_VREG:
            let v = inst.src2.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                let is_16_s2 = regalloc_is_16byte_cached(v, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
                mut add_mult := 1 as i64
                if is_16_s2:
                    add_mult = 2 as i64
                let offset = -((frame.callee_saved_len + add_mult + alloc.spill_idx as i64) * 8)
                if is_16_s2:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                elif is_float_vreg_cached(fn_ptr, v, table, symbols, sp_def_idx, sp_def_size):
                    // RFC 0006: spilled FLOAT src2 â†’ XMM1 scratch via movsd (see src1).
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 8 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_XMM1, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                    inst.src2 = MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)

        mut dst_spilled := false
        mut dst_alloc = RegAllocation(vreg: 0 as u32, phys: 0 as u8, spilled: false, spill_idx: 0 as i32)
        if inst.dst.kind == OPND_VREG:
            let v = inst.dst.vreg
            let alloc = allocs[v]
            if alloc.spilled:
                dst_spilled = true
                dst_alloc = alloc

        if dst_spilled:
            let behavior = get_dst_behavior(inst.op)
            let is_16_dst = regalloc_is_16byte_cached(dst_alloc.vreg, fn_ptr, table, symbols, sp_def_idx, sp_def_size)
            mut add_mult := 1 as i64
            if is_16_dst:
                add_mult = 2 as i64
            let offset = -((frame.callee_saved_len + add_mult + dst_alloc.spill_idx as i64) * 8)

            // A spilled FLOAT dst must round-trip through an XMM scratch: the float
            // encoders take an XMM dst, and R10/R11's hardware indices alias
            // XMM10/XMM11 (both allocatable), so reusing the GPR scratch would encode
            // the write into a live float register. XMM2 is reserved for the dst â€”
            // XMM0/XMM1 are already the src1/src2 reload scratches above, and all of
            // XMM0-7 sit outside the allocatable XMM8-15 set. A 16-byte dst keeps the
            // GPR path: that branch LEAs the slot ADDRESS, which is always a GPR.
            mut dst_scratch := REG_R11
            mut dst_pad := 0 as u8
            if not is_16_dst and is_float_vreg_cached(fn_ptr, dst_alloc.vreg, table, symbols, sp_def_idx, sp_def_size):
                dst_scratch = REG_XMM2
                dst_pad = 8 as u8

            if behavior == DST_READ_ONLY:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: dst_pad, dst: MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
            elif behavior == DST_READ_WRITE:
                if is_16_dst:
                    result.push(MachInst(op: MACH_LEA, cc: 0 as u8, padding: 0 as u8, dst: MachOperand(kind: OPND_PHYS, phys: REG_R11, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                else:
                    result.push(MachInst(op: MACH_LOAD, cc: 0 as u8, padding: dst_pad, dst: MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
                inst.dst = MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: dst_pad, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            elif behavior == DST_WRITE_ONLY:
                inst.dst = MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64)
                result.push(inst)
                result.push(MachInst(op: MACH_STORE, cc: 0 as u8, padding: dst_pad, dst: MachOperand(kind: OPND_PHYS, phys: REG_RBP, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src1: MachOperand(kind: OPND_PHYS, phys: dst_scratch, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64), src2: MachOperand(kind: OPND_IMM, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: offset as i64)))
            else:
                result.push(inst)
        else:
            result.push(inst)

        i = i + 1
    @free(sp_def_idx as ptr[u8])
    return result

// True if this operand still names a virtual register with no machine register
// behind it, after spill rewriting has run.
fn operand_unallocated(o: MachOperand, allocs: ptr[RegAllocation]) -> bool:
    if o.kind != OPND_VREG:
        return false
    if o.vreg == 0 as u32:
        // vreg 0 is the pipeline's "no register" placeholder â€” compute_liveness and
        // every reference table skip it, so it is not a real value.
        return false
    // Deliberately NOT bounds-checked against RegAllocResult.max_vreg: that field is
    // known to read back garbage-large on this backend (see BUG#17 at the merge loops),
    // and insert_spill_code already indexes allocs[] by any operand vreg, so the array
    // is sized for every vreg the instructions can name.
    let a = allocs[o.vreg as i64]
    if a.spilled:
        return true
    return a.phys == REG_NONE

// VERIFICATION LAYER (Â§9). By the time spill rewriting is done, every operand must
// name a real machine register. A surviving OPND_VREG that is spilled or unallocated
// is an internal invariant violation â€” and it is NOT benign: emitter_resolve_reg
// returns REG_NONE (255) for it, and the encoders mask that straight into a 3- or
// 4-bit register field, so the access silently lands in %r15 / %xmm15 instead of
// failing. Only 4 of the emitter's 62 resolve sites test for REG_NONE, so the other
// ~58 will encode the sentinel as a real register without a word.
//
// That is precisely how a spilled float ALU destination (MACH_FADD/FSUB/FMUL/FDIV
// missing from get_dst_behavior) corrupted results for months: the codegen was wrong
// at construction, every gate stayed green, and only a hand-written probe found it.
// This check turns that whole family into a diagnosable event at the point where the
// invariant breaks, instead of a wrong answer much later.
//
// Reports at most 10 instructions so a systemic break cannot flood the build, and
// returns the total count (0 == clean).
pub fn verify_all_operands_allocated(insts: ptr[MachInst], len: i64, allocs: ptr[RegAllocation], max_vreg: u32, fn_name: str) -> i64:
    mut bad := 0 as i64
    mut i := 0 as i64
    while i < len:
        let inst = &insts[i]
        let d = operand_unallocated(inst.dst, allocs)
        let s1 = operand_unallocated(inst.src1, allocs)
        let s2 = operand_unallocated(inst.src2, allocs)
        if d or s1 or s2:
            bad = bad + 1 as i64
            if bad <= 10 as i64:
                ax_puts_local("internal error: unallocated vreg reaches the emitter (would encode as r15/xmm15) in:")
                ax_puts_local(fn_name)
                ax_printf_local("  inst #%d op=%d  dst_bad=%d src1_bad=%d src2_bad=%d\n", i, inst.op as i64, d as i64, s1 as i64, s2 as i64, 0 as i64, 0 as i64, 0 as i64)
        i = i + 1
    // FATAL on purpose. The alternative is emitting an instruction that reads or writes
    // a register nobody assigned, which produces a plausible-looking binary that is
    // simply wrong â€” the failure mode this check exists to end. Calibrated by deleting
    // the float-ALU line from get_dst_behavior and rebuilding: it then names
    // `main / op=33 (MACH_FADD) / dst_bad=1`, i.e. the exact defect, at the exact site.
    if bad > 0 as i64:
        ax_panic("codegen: unallocated virtual register reached the emitter (see report above)")
    return bad

pub fn is_float_vreg(fn_ptr: ptr[AirFunc], vreg: u32, table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> bool:
    if vreg == 0 as u32:
        return false
    // A float-typed PARAMETER is passed in an XMM arg register; its type lives
    // in fn_ptr.params, not in a defining instruction.
    if vreg >= 1 as u32 and vreg <= fn_ptr.params.len as u32:
        let pt = fn_ptr.params.data[vreg as i64 - 1 as i64] as u32
        return pt == 9 as u32 or pt == 10 as u32
    mut i := 0 as i64
    while i < fn_ptr.insts.len:
        let inst = &fn_ptr.insts.data[i]
        if inst.dest == vreg:
            // BUG#48: OP_CALL overloads type_id â€” for a DIRECT call (src1==0) it
            // holds the callee SYMBOL INDEX, not the result type. Resolve the
            // callee's return type instead. Without this, a float-returning
            // call's result vreg is classified as integer, allocated a GPR, and
            // every addsd/mulsd that consumes it encodes the operand by
            // hardware index into the WRONG register file (e.g. rsi index 6 ->
            // xmm6) â†’ silent garbage. Mirrors get_register_type / regalloc_is_16byte.
            if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
                let sym_idx = inst.type_id as u32
                if symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < symbols.symbols.len:
                    let sym = &symbols.symbols.data[sym_idx as i64]
                    if sym.kind == SYM_FUNC:
                        let fn_type_id = sym.type_id as u32
                        if fn_type_id != 0 as u32 and (fn_type_id as i64) < table.entries.len:
                            let entry = &table.entries.data[fn_type_id as i64]
                            if entry.kind == TYPE_KIND_FUNC:
                                let fi = &table.funcs.data[entry.extra as i64]
                                let rt = fi.ret
                                return rt == 9 as u32 or rt == 10 as u32
                return false
            let t_id = inst.type_id
            return t_id == 9 as u32 or t_id == 10 as u32
        i = i + 1
    return false

// PERF: is_float_vreg / regalloc_is_16byte each LINEAR-scan fn_ptr.insts for the
// defining instruction of a vreg. Called once per interval in the orchestrator
// split loop and once per spilled operand-use in insert_spill_code, that is
// O(vregs Ã— insts) â€” quadratic on mega-functions (select_inst: ~2s of codegen).
// This builds, in one O(insts) pass, def_idx[vreg] = the index of the FIRST inst
// whose dest == vreg (matching is_float_vreg's first-match semantics), or -1.
// The cached wrappers then reuse the EXACT same per-inst classification logic via
// an O(1) lookup â€” no logic duplication, so classification is byte-identical.
pub fn build_vreg_def_idx(fn_ptr: ptr[AirFunc], size: i64) -> ptr[i32]:
    let arr = @alloc(size * 4) as ptr[i32]
    mut k := 0 as i64
    while k < size:
        arr[k] = -1 as i32
        k = k + 1
    mut i := 0 as i64
    while i < fn_ptr.insts.len:
        let d = fn_ptr.insts.data[i].dest as i64
        if d >= 0 as i64 and d < size and arr[d] == -1 as i32:
            arr[d] = i as i32
        i = i + 1
    return arr

// Cached form of is_float_vreg. `def_idx` must be sized `def_size` (>= vreg+1 for
// any vreg queried); a vreg beyond it (e.g. a selection scratch above max AIR
// dest) is never an AIR dest â†’ not float, same as the linear-scan fallthrough.
pub fn is_float_vreg_cached(fn_ptr: ptr[AirFunc], vreg: u32, table: ptr[TypeTable], symbols: ptr[SymbolTable], def_idx: ptr[i32], def_size: i64) -> bool:
    if vreg == 0 as u32:
        return false
    if vreg >= 1 as u32 and vreg <= fn_ptr.params.len as u32:
        let pt = fn_ptr.params.data[vreg as i64 - 1 as i64] as u32
        return pt == 9 as u32 or pt == 10 as u32
    if (vreg as i64) >= def_size:
        return false
    let di = def_idx[vreg as i64]
    if di < 0 as i32:
        return false
    let inst = &fn_ptr.insts.data[di as i64]
    if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
        let sym_idx = inst.type_id as u32
        if symbols != null as ptr[SymbolTable] and sym_idx != 0 as u32 and (sym_idx as i64) < symbols.symbols.len:
            let sym = &symbols.symbols.data[sym_idx as i64]
            if sym.kind == SYM_FUNC:
                let fn_type_id = sym.type_id as u32
                if fn_type_id != 0 as u32 and (fn_type_id as i64) < table.entries.len:
                    let entry = &table.entries.data[fn_type_id as i64]
                    if entry.kind == TYPE_KIND_FUNC:
                        let fi = &table.funcs.data[entry.extra as i64]
                        let rt = fi.ret
                        return rt == 9 as u32 or rt == 10 as u32
        return false
    let t_id = inst.type_id
    return t_id == 9 as u32 or t_id == 10 as u32

pub fn get_allocatable_xmms(out_len: ptr[i64]) -> ptr[u8]:
    let arr = @alloc(8) as ptr[u8]
    arr[0] = REG_XMM8
    arr[1] = REG_XMM9
    arr[2] = REG_XMM10
    arr[3] = REG_XMM11
    arr[4] = REG_XMM12
    arr[5] = REG_XMM13
    arr[6] = REG_XMM14
    arr[7] = REG_XMM15
    out_len[0] = 8
    return arr

pub fn allocate_registers_orchestrator(intervals: LiveIntervalVec, insts: ptr[MachInst], insts_len: i64, abi: str, fn_ptr: ptr[AirFunc], table: ptr[TypeTable], symbols: ptr[SymbolTable]) -> RegAllocResult:
    mut max_vreg := 0 as u32
    mut scan_v := 0 as i64
    while scan_v < insts_len:
        let inst = &insts[scan_v]
        if inst.dst.kind == OPND_VREG and inst.dst.vreg > max_vreg:
            max_vreg = inst.dst.vreg
        if inst.src1.kind == OPND_VREG and inst.src1.vreg > max_vreg:
            max_vreg = inst.src1.vreg
        if inst.src2.kind == OPND_VREG and inst.src2.vreg > max_vreg:
            max_vreg = inst.src2.vreg
        scan_v = scan_v + 1

    let graph_size = (max_vreg + 1 as u32) as i64

    mut gpr_intervals := new_live_interval_vec()
    mut xmm_intervals := new_live_interval_vec()

    // PERF: memoize the float/GPR classification. Formerly is_float_vreg (a linear
    // scan of fn_ptr.insts) per interval â†’ O(intervals Ã— insts), ~2s on select_inst.
    let def_idx = build_vreg_def_idx(fn_ptr, graph_size)
    mut i := 0 as i64
    while i < intervals.len:
        let iv = intervals.data[i]
        if is_float_vreg_cached(fn_ptr, iv.vreg, table, symbols, def_idx, graph_size):
            xmm_intervals.push(iv)
        else:
            gpr_intervals.push(iv)
        i = i + 1
    @free(def_idx as ptr[u8])

    mut gpr_len := 0 as i64
    let avail_gprs = get_allocatable_gprs(&gpr_len)

    mut xmm_len := 0 as i64
    let avail_xmms = get_allocatable_xmms(&xmm_len)

    let gpr_alloc = graph_coloring_alloc(gpr_intervals, avail_gprs, gpr_len, insts, insts_len, abi, fn_ptr, table, symbols)
    let xmm_alloc = graph_coloring_alloc(xmm_intervals, avail_xmms, xmm_len, insts, insts_len, abi, fn_ptr, table, symbols)

    let allocs = @alloc(graph_size * 12) as ptr[RegAllocation]
    @memset(allocs as ptr[u8], 0 as u8, graph_size * 12)

    mut v := 0 as i64
    while v < graph_size:
        allocs[v] = RegAllocation(vreg: v as u32, phys: REG_NONE, spilled: false, spill_idx: 0 as i32)
        v = v + 1

    if gpr_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: `gpr_alloc.max_vreg as i64` is mis-compiled by the native
        // backend (u32 struct-field zero-extend reads the adjacent spill_count
        // into the upper 32 bits -> garbage-large bound -> allocs[] OOB scan ->
        // segfault). gpr_alloc.allocs is sized graph_size (== max_vreg+1, same
        // insts) with indices 0..graph_size-1 all initialized, so bound by the
        // clean local graph_size instead of the corrupt field read.
        mut idx := 0 as i64
        while idx < graph_size:
            let al = gpr_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                allocs[al.vreg] = al
            idx = idx + 1
        @free(gpr_alloc.allocs as ptr[u8])

    if xmm_alloc.allocs != null as ptr[RegAllocation]:
        // BUG#17: same garbage-bound issue as the gpr loop above; bound by the
        // clean local graph_size (xmm_alloc.allocs is also sized graph_size).
        mut idx := 0 as i64
        while idx < graph_size:
            mut al := xmm_alloc.allocs[idx]
            if al.vreg < graph_size as u32:
                if al.spilled:
                    al.spill_idx = al.spill_idx + gpr_alloc.spill_count
                allocs[al.vreg] = al
            idx = idx + 1
        @free(xmm_alloc.allocs as ptr[u8])

    let spill_total = gpr_alloc.spill_count + xmm_alloc.spill_count

    if gpr_intervals.data != null as ptr[LiveInterval]:
        @free(gpr_intervals.data as ptr[u8])
    if xmm_intervals.data != null as ptr[LiveInterval]:
        @free(xmm_intervals.data as ptr[u8])
    @free(avail_gprs)
    @free(avail_xmms)

    return RegAllocResult(allocs: allocs, max_vreg: max_vreg, spill_count: spill_total, pad0: 0 as i64)
// bootstrap/stage1/x86_asm_emitter.ax
// Assembly Text Emitter for NASM, FASM, and WinAsm/MASM in self-hosted AXIOM.


pub fn to_byte_reg(reg: u8) -> str:
    let hw = reg_hw_reg(reg)
    if reg_is_gpr(reg):
        if hw == 0:
            return "al"
        if hw == 1:
            return "cl"
        if hw == 2:
            return "dl"
        if hw == 3:
            return "bl"
        if hw == 4:
            return "spl"
        if hw == 5:
            return "bpl"
        if hw == 6:
            return "sil"
        if hw == 7:
            return "dil"
        if hw == 8:
            return "r8b"
        if hw == 9:
            return "r9b"
        if hw == 10:
            return "r10b"
        if hw == 11:
            return "r11b"
        if hw == 12:
            return "r12b"
        if hw == 13:
            return "r13b"
        if hw == 14:
            return "r14b"
        if hw == 15:
            return "r15b"
    return "al"

pub fn to_word_reg(reg: u8) -> str:
    let hw = reg_hw_reg(reg)
    if reg_is_gpr(reg):
        if hw == 0:
            return "ax"
        if hw == 1:
            return "cx"
        if hw == 2:
            return "dx"
        if hw == 3:
            return "bx"
        if hw == 4:
            return "sp"
        if hw == 5:
            return "bp"
        if hw == 6:
            return "si"
        if hw == 7:
            return "di"
        if hw == 8:
            return "r8w"
        if hw == 9:
            return "r9w"
        if hw == 10:
            return "r10w"
        if hw == 11:
            return "r11w"
        if hw == 12:
            return "r12w"
        if hw == 13:
            return "r13w"
        if hw == 14:
            return "r14w"
        if hw == 15:
            return "r15w"
    return "ax"

pub fn to_dword_reg(reg: u8) -> str:
    let hw = reg_hw_reg(reg)
    if reg_is_gpr(reg):
        if hw == 0:
            return "eax"
        if hw == 1:
            return "ecx"
        if hw == 2:
            return "edx"
        if hw == 3:
            return "ebx"
        if hw == 4:
            return "esp"
        if hw == 5:
            return "ebp"
        if hw == 6:
            return "esi"
        if hw == 7:
            return "edi"
        if hw == 8:
            return "r8d"
        if hw == 9:
            return "r9d"
        if hw == 10:
            return "r10d"
        if hw == 11:
            return "r11d"
        if hw == 12:
            return "r12d"
        if hw == 13:
            return "r13d"
        if hw == 14:
            return "r14d"
        if hw == 15:
            return "r15d"
    return "eax"

pub fn format_operand(op: MachOperand, format: str, allocs: ptr[RegAllocation]) -> str:
    if op.kind == OPND_PHYS:
        return reg_to_str(op.phys)
    elif op.kind == OPND_VREG:
        let r = op.vreg
        let alloc = allocs[r]
        return reg_to_str(alloc.phys)
    elif op.kind == OPND_IMM:
        return format_int(op.imm)
    elif op.kind == OPND_LABEL:
        if format == "winasm":
            return std.string.concat("L_b_", format_int(op.label as i64))
        return std.string.concat(".L_b_", format_int(op.label as i64))
    return "none"

pub fn operand_phys(op: MachOperand, allocs: ptr[RegAllocation]) -> u8:
    if op.kind == OPND_PHYS:
        return op.phys
    elif op.kind == OPND_VREG:
        let r = op.vreg
        let alloc = allocs[r]
        return alloc.phys
    return REG_NONE

pub fn emit_inst(file: ptr[void], inst: MachInst, fn_name: str, allocs: ptr[RegAllocation], format: str, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], frame: ptr[StackFrame], str_lit_counter: ptr[i32]):
    let op = inst.op
    if op == MACH_NOP or op == MACH_DIVCLOBBER:
        ax_fprintf_local(file, "    nop\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == MACH_LABEL:
        let lbl_id = inst.dst.label
        if format == "winasm":
            ax_fprintf_local(file, "L_b_%d:\n", lbl_id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_fprintf_local(file, ".L_b_%d:\n", lbl_id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == MACH_RET:
        ax_fprintf_local(file, "    ret\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == MACH_MOV:
        let dst_reg = operand_phys(inst.dst, allocs)
        let src_reg = operand_phys(inst.src1, allocs)
        let dst = format_operand(inst.dst, format, allocs)
        let src = format_operand(inst.src1, format, allocs)
        if reg_is_xmm(dst_reg) and reg_is_xmm(src_reg):
            ax_fprintf_local(file, "    movsd %s, %s\n", (get_str_ptr(dst)) as i64, (get_str_ptr(src)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif reg_is_xmm(dst_reg) or reg_is_xmm(src_reg):
            ax_fprintf_local(file, "    movq %s, %s\n", (get_str_ptr(dst)) as i64, (get_str_ptr(src)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_fprintf_local(file, "    mov %s, %s\n", (get_str_ptr(dst)) as i64, (get_str_ptr(src)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == MACH_MOV_IMM:
        let dst = format_operand(inst.dst, format, allocs)
        if inst.src1.vreg == 1 as u32:
            let sym_name = x86_resolve_sym_name(inst.src1.imm as u32, symbols, pool, table)
            if format == "winasm":
                ax_fprintf_local(file, "    mov %s, OFFSET %s\n", (get_str_ptr(dst)) as i64, (get_str_ptr(sym_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_fprintf_local(file, "    mov %s, %s\n", (get_str_ptr(dst)) as i64, (get_str_ptr(sym_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif inst.src1.vreg == 2 as u32 and frame != null as ptr[StackFrame] and str_lit_counter != null as ptr[i32]:
            let imm = inst.src1.imm
            let raw_text = pool.get(imm as u32)
            let text = unescape_string_literal(raw_text)
            let len = std.string.len(text)
            @free(get_str_ptr(text))
            
            let struct_offset = (frame.callee_saved_len * 8) + (frame.spill_slots * 8) + 16 + str_lit_counter[0] * 16
            let len_offset = struct_offset - 8
            str_lit_counter[0] = str_lit_counter[0] + 1
            
            if format == "winasm":
                ax_fprintf_local(file, "    lea %s, Linfo.string.%d\n", (get_str_ptr(dst)) as i64, imm, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                ax_fprintf_local(file, "    mov [rbp - %d], %s\n", struct_offset as i64, (get_str_ptr(dst)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                ax_fprintf_local(file, "    mov %s, %d\n", (get_str_ptr(dst)) as i64, len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                ax_fprintf_local(file, "    mov [rbp - %d], %s\n", len_offset as i64, (get_str_ptr(dst)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
