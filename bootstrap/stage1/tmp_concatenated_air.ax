    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x2A as u8)
    push_byte(buf, modrm)

pub fn x86_encode_cvttss2si(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0xF3 as u8)
    if need_rex:
        rex = rex | REX_W
        push_byte(buf, rex)
    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x2C as u8)
    push_byte(buf, modrm)

pub fn x86_encode_cvtss2sd(dst: u8, src: u8, buf: ptr[ByteVec]):
    // f32 -> f64 widen: F3 0F 5A
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0xF3 as u8)
    if need_rex:
        push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x5A as u8)
    push_byte(buf, modrm)

pub fn x86_encode_cvtsd2ss(dst: u8, src: u8, buf: ptr[ByteVec]):
    // f64 -> f32 narrow: F2 0F 5A
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0xF2 as u8)
    if need_rex:
        push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x5A as u8)
    push_byte(buf, modrm)

pub fn x86_encode_movd(dst: u8, src: u8, buf: ptr[ByteVec]):
    // movd xmm, r/m32 = 66 0F 6E /r (32-bit, NO REX.W) â€” gpr32 -> xmm low dword.
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0x66 as u8)
    if need_rex:
        push_byte(buf, rex)
    push_byte(buf, 0x0F as u8)
    push_byte(buf, 0x6E as u8)
    push_byte(buf, modrm)


// bootstrap/stage1/x86_emitter.ax
// Binary machine code emitter for x86-64 in self-hosted AXIOM.

pub const RELOC_PC32:  u8 = 0
pub const RELOC_ABS64: u8 = 1
pub const RELOC_PLT32: u8 = 2

pub struct Relocation:
    pub offset: i64
    pub kind: u8
    pub padding1: u8
    pub padding2: u16
    pub sym_name: u32 // Interned symbol name index
    pub addend: i64

pub struct RelocationVec:
    pub data: ptr[Relocation]
    pub len: i64
    pub cap: i64

pub fn new_relocation_vec() -> RelocationVec:
    return RelocationVec(data: null as ptr[Relocation], len: 0, cap: 0)

pub fn push_reloc(mut self: ptr[RelocationVec], r: Relocation):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[Relocation]
        if self.data != null as ptr[Relocation]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = r
    self.len = self.len + 1

pub struct Fixup:
    pub offset: i64
    pub label_id: u32
    pub inst_size: i32
    // BUG#19: {i64, u32, i32} is exactly 16 bytes, so a freshly-constructed
    // Fixup(...) literal passed by value (push_fixup) is mis-marshalled by the
    // native backend via the str-like {ptr,i64} RAX:RDX path -> the second
    // 8-byte word (label_id|inst_size) and even offset come back garbage.
    // Pad to >16 bytes to force by-address passing (same fix as RegAllocResult).
    pub pad0: i64

pub struct FixupVec:
    pub data: ptr[Fixup]
    pub len: i64
    pub cap: i64

pub fn new_fixup_vec() -> FixupVec:
    return FixupVec(data: null as ptr[Fixup], len: 0, cap: 0)

pub fn push_fixup(mut self: ptr[FixupVec], f: Fixup):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[Fixup]
        if self.data != null as ptr[Fixup]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = f
    self.len = self.len + 1

pub struct LabelMap:
    pub keys: ptr[u32]
    pub values: ptr[i64]
    pub len: i64
    pub cap: i64

pub fn new_label_map() -> LabelMap:
    return LabelMap(keys: null as ptr[u32], values: null as ptr[i64], len: 0, cap: 0)

pub fn label_map_set(mut self: ptr[LabelMap], key: u32, val: i64):
    mut i := 0 as i64
    while i < self.len:
        if self.keys[i] == key:
            self.values[i] = val
            return
        i = i + 1
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_keys = @alloc(new_cap * 4) as ptr[u32]
        let new_values = @alloc(new_cap * 8) as ptr[i64]
        if self.keys != null as ptr[u32]:
            @memcpy(new_keys as ptr[u8], self.keys as ptr[u8], self.len * 4)
            @memcpy(new_values as ptr[u8], self.values as ptr[u8], self.len * 8)
            @free(self.keys as ptr[u8])
            @free(self.values as ptr[u8])
        self.keys = new_keys
        self.values = new_values
        self.cap = new_cap
    self.keys[self.len] = key
    self.values[self.len] = val
    self.len = self.len + 1

pub fn label_map_get(self: ptr[LabelMap], key: u32, out_val: ptr[i64]) -> bool:
    mut i := 0 as i64
    while i < self.len:
        if self.keys[i] == key:
            out_val[0] = self.values[i]
            return true
        i = i + 1
    return false

pub struct MachEmitter:
    pub code: ByteVec
    pub relocs: RelocationVec
    pub labels: LabelMap
    pub fixups: FixupVec

pub fn new_mach_emitter() -> MachEmitter:
    return MachEmitter(
        code: new_byte_vec(),
        relocs: new_relocation_vec(),
        labels: new_label_map(),
        fixups: new_fixup_vec()
    )

pub fn free_mach_emitter(mut self: ptr[MachEmitter]):
    if self.code.data != null as ptr[u8]:
        @free(self.code.data)
    if self.relocs.data != null as ptr[Relocation]:
        @free(self.relocs.data as ptr[u8])
    if self.labels.keys != null as ptr[u32]:
        @free(self.labels.keys as ptr[u8])
    if self.labels.values != null as ptr[i64]:
        @free(self.labels.values as ptr[u8])
    if self.fixups.data != null as ptr[Fixup]:
        @free(self.fixups.data as ptr[u8])

pub fn emitter_resolve_reg(op: MachOperand, allocs: ptr[RegAllocation]) -> u8:
    if op.kind == OPND_PHYS:
        return op.phys
    elif op.kind == OPND_VREG:
        let r = op.vreg
        let alloc = allocs[r]
        return alloc.phys
    return REG_NONE

pub fn emit_mach_inst(mut e: ptr[MachEmitter], inst: MachInst, allocs: ptr[RegAllocation], pool: ptr[InternPool], frame: ptr[StackFrame], mut str_lit_counter: ptr[i32]):
    let op = inst.op
    let buf = &e.code
    
    if op == MACH_NOP or op == MACH_DIVCLOBBER:
        // MACH_DIVCLOBBER is a regalloc-only marker (see x86_selector.ax); emit a
        // harmless nop so it occupies no meaningful code (1 byte, no effect).
        x86_encode_nop(buf)
    elif op == MACH_LABEL:
        label_map_set(&e.labels, inst.dst.label, buf.len)
    elif op == MACH_RET:
        x86_encode_ret(buf)
    elif op == MACH_MOV:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if dst != REG_NONE and src != REG_NONE:
            if reg_is_xmm(dst) and reg_is_xmm(src):
                x86_encode_movsd(dst, src, buf)
            elif reg_is_xmm(dst) and reg_is_gpr(src):
                x86_encode_movdq(dst, src, buf)
            elif reg_is_gpr(dst) and reg_is_xmm(src):
                x86_encode_movqd(dst, src, buf)
            else:
                // Peephole: skip a GPR self-move `mov reg, reg` â€” a no-op on x86 (no flags,
                // no side effects). Register allocation frequently resolves a MACH_MOV's dst
                // and src to the SAME physical register (~15% of reg-reg movs were self-moves),
                // so dropping them shrinks every function's hot path. (M6 perf.)
                if dst != src:
                    x86_encode_mov_rr(dst, src, buf)
    elif op == MACH_MOV_IMM:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let imm = inst.src1.imm
        // ax_printf_local("[Debug emit_mach_inst] MACH_MOV_IMM dst=%d, vreg_flag=%d, imm=%d\n", dst as i64, inst.src1.vreg as i64, imm, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        // fflush(null as ptr[void])
        if dst != REG_NONE:
            if inst.src1.vreg == 1 as u32: // OP_SPAWN thread-entry function address
                // RFC 0032 P3: load the thread-entry address RIP-relative (lea reg,[rip+disp32]
                // + PC32 reloc), IDENTICAL to the vreg==3 func-address path below, instead of an
                // absolute movabs. The loaded value is the entry function's runtime VA either
                // way, but the absolute form baked a link-time address that pointed at the
                // un-relocated image once a --shared .so is dlopen'd at a random base â€” so an
                // #[export] function that transitively `spawn`ed a thread made a wild call in a
                // rebased .so. This is the only vreg==1 site (grep-confirmed), so the change is
                // scoped to spawn. It IS target-independent (COFF + ELF), so it perturbs the
                // self-build spawn bytes â†’ gated by the B==C backend fixpoint, not A==B.
                let offset = buf.len + 3 as i64
                push_reloc(&e.relocs, Relocation(
                    offset: offset,
                    kind: RELOC_PC32,
                    padding1: 0 as u8,
                    padding2: 0 as u16,
                    sym_name: imm as u32,
                    addend: -4 as i64
                ))
                x86_encode_lea_rip(dst, 0 as i32, buf)
            elif inst.src1.vreg == 3 as u32: // Function address (RIP-relative, ASLR-safe)
                // imm = function symbol index (positive â†’ resolve_binary_sym_name
                // yields the function's code symbol). lea reg,[rip+disp32] + a
                // PC-relative reloc, so the address survives image rebasing under
                // ASLR (an absolute movabs would not).
                let f_offset = buf.len + 3 as i64
                push_reloc(&e.relocs, Relocation(
                    offset: f_offset,
                    kind: RELOC_PC32,
                    padding1: 0 as u8,
                    padding2: 0 as u16,
                    sym_name: imm as u32,
                    addend: -4 as i64
                ))
                x86_encode_lea_rip(dst, 0 as i32, buf)
            elif inst.src1.vreg == 4 as u32: // RFC 0017 / BUG#82: global data address
                // imm = the global's symbol index (resolve_binary_sym_name yields the
                // global's .data symbol). lea reg,[rip+disp32] + PC-relative reloc, so the
                // writable-data address survives ASLR rebasing (same form as vreg==3).
                let g_offset = buf.len + 3 as i64
                push_reloc(&e.relocs, Relocation(
                    offset: g_offset,
                    kind: RELOC_PC32,
                    padding1: 0 as u8,
                    padding2: 0 as u16,
                    sym_name: imm as u32,
                    addend: -4 as i64
                ))
                x86_encode_lea_rip(dst, 0 as i32, buf)
            elif inst.src1.vreg == 2 as u32: // String literal!
                let offset = buf.len + 3 as i64
                let base: i64 = 3758096384
                let sym_val = base + imm
                push_reloc(&e.relocs, Relocation(
                    offset: offset,
                    kind: RELOC_PC32,
                    padding1: 0 as u8,
                    padding2: 0 as u16,
                    sym_name: sym_val as u32,
                    addend: -4 as i64
                ))
                x86_encode_lea_rip(dst, 0 as i32, buf)
                
                let raw_text = pool.get(imm as u32)
                let text = unescape_string_literal(raw_text)
                let len = std.string.len(text)
                @free(get_str_ptr(text))
                
                let struct_offset = (frame.callee_saved_len * 8) + (frame.spill_slots * 8) + 16 + str_lit_counter[0] * 16
                let len_offset = struct_offset - 8
                str_lit_counter[0] = str_lit_counter[0] + 1
                
                x86_encode_mov_store(REG_RBP, 0 as i32 - struct_offset as i32, dst, buf)
                x86_encode_mov_ri64(dst, len, buf)
                x86_encode_mov_store(REG_RBP, 0 as i32 - len_offset as i32, dst, buf)
                x86_encode_lea(dst, REG_RBP, 0 as i32 - struct_offset as i32, buf)

            else:
                if imm >= -2147483648 as i64 and imm <= 2147483647 as i64:
                    x86_encode_mov_ri(dst, imm as i32, buf)
                else:
                    x86_encode_mov_ri64(dst, imm, buf)

    elif op == MACH_XOR_ZERO:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if dst != REG_NONE:
            x86_encode_xor_zero(dst, buf)
    elif op == MACH_ADD:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_add_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_add_rr(dst, src, buf)
    elif op == MACH_SUB:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            if dst == REG_RSP and inst.src1.imm > 4096 as i64:
                mut remaining := inst.src1.imm
                while remaining > 4096 as i64:
                    x86_encode_sub_ri(REG_RSP, 4096 as i32, buf)
                    push_byte(buf, 0x85 as u8)
                    push_byte(buf, 0x04 as u8)
                    push_byte(buf, 0x24 as u8)
                    remaining = remaining - 4096 as i64
                if remaining > 0 as i64:
                    x86_encode_sub_ri(REG_RSP, remaining as i32, buf)
            else:
                x86_encode_sub_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_sub_rr(dst, src, buf)
    elif op == MACH_IMUL:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_imul_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_imul_rr(dst, src, buf)
    elif op == MACH_IDIV:
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_idiv_r(src, buf)
    elif op == MACH_DIV:
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_div_r(src, buf)
    elif op == MACH_CQO:
        x86_encode_cqo(buf)
    elif op == MACH_NEG:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        x86_encode_neg_r(dst, buf)
    elif op == MACH_NOT:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        x86_encode_not_r(dst, buf)
    elif op == MACH_AND:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_and_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_and_rr(dst, src, buf)
    elif op == MACH_OR:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_or_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_or_rr(dst, src, buf)
    elif op == MACH_XOR:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_xor_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_xor_rr(dst, src, buf)
    elif op == MACH_SHL:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_shl_imm(dst, inst.src1.imm as u8, buf)
        else:
            x86_encode_shl_cl(dst, buf)
    elif op == MACH_SAR:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_sar_imm(dst, inst.src1.imm as u8, buf)
        else:
            x86_encode_sar_cl(dst, buf)
    elif op == MACH_SHR:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_shr_imm(dst, inst.src1.imm as u8, buf)
        else:
            x86_encode_shr_cl(dst, buf)
    elif op == MACH_CMP:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        if inst.src1.kind == OPND_IMM:
            x86_encode_cmp_ri(dst, inst.src1.imm as i32, buf)
        else:
            let src = emitter_resolve_reg(inst.src1, allocs)
            x86_encode_cmp_rr(dst, src, buf)
    elif op == MACH_TEST:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_test_rr(dst, src, buf)
    elif op == MACH_SETCC:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        x86_encode_setcc(inst.cc, dst, buf)
    elif op == MACH_MOVZX_B:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_movzx_br(dst, src, buf)
    elif op == MACH_PUSH:
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_push(src, buf)
    elif op == MACH_POP:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        x86_encode_pop(dst, buf)
    elif op == MACH_JMP:
        if inst.dst.kind == OPND_LABEL:
            push_fixup(&e.fixups, Fixup(offset: buf.len + 1, label_id: inst.dst.label, inst_size: 5, pad0: 0 as i64))
            x86_encode_jmp_rel32(0 as i32, buf)
    elif op == MACH_JCC:
        if inst.dst.kind == OPND_LABEL:
            push_fixup(&e.fixups, Fixup(offset: buf.len + 2, label_id: inst.dst.label, inst_size: 6, pad0: 0 as i64))
            x86_encode_jcc_rel32(inst.cc, 0 as i32, buf)
    elif op == MACH_CALL:
        mut disp := 0 as i32
        if inst.src1.imm == 0 as i64:
            // Recursive call to current function (starts at 0)
            disp = -(buf.len + 5) as i32
        else:
            if inst.src1.imm > 0 as i64:
                push_fixup(&e.fixups, Fixup(offset: buf.len + 1, label_id: (inst.src1.imm as u32) | 0x80000000 as u32, inst_size: 5, pad0: 0 as i64))
            else:
                push_fixup(&e.fixups, Fixup(offset: buf.len + 1, label_id: inst.src1.imm as u32, inst_size: 5, pad0: 0 as i64))
        x86_encode_call_rel32(disp, buf)
    elif op == MACH_CALL_INDIRECT:
        // Indirect call through a register (function pointer). src1 holds the
        // target register (a phys reg, R11 from the selector). Encodes FF /2.
        let treg = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_call_r(treg, buf)
    elif op == MACH_SYSCALL:
        x86_encode_syscall(buf)
    elif op == MACH_LEA:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let base = emitter_resolve_reg(inst.src1, allocs)
        mut disp := 0 as i32
        if inst.src2.kind == OPND_IMM:
            disp = inst.src2.imm as i32
        x86_encode_lea(dst, base, disp, buf)
    elif op == MACH_LOAD:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let base = emitter_resolve_reg(inst.src1, allocs)
        mut disp := 0 as i32
        if inst.src2.kind == OPND_IMM:
            disp = inst.src2.imm as i32
        if reg_is_xmm(dst):
            // RFC 0006 f32: a 4-byte float slot uses movss; 8-byte uses movsd.
            if inst.padding == 4 as u8:
                x86_encode_movss_load(dst, base, disp, buf)
            else:
                x86_encode_movsd_load(dst, base, disp, buf)
        else:
            mut size := inst.padding
            if size == 0 as u8:
                size = 8 as u8
            x86_encode_mov_load_sized(dst, base, disp, size, buf)
    elif op == MACH_STORE:
        let base = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        mut disp := 0 as i32
        if inst.src2.kind == OPND_IMM:
            disp = inst.src2.imm as i32
        if reg_is_xmm(src):
            if inst.padding == 4 as u8:
                x86_encode_movss_store(base, disp, src, buf)
            else:
                x86_encode_movsd_store(base, disp, src, buf)
        else:
            mut size := inst.padding
            if size == 0 as u8:
                size = 8 as u8
            x86_encode_mov_store_sized(base, disp, src, size, buf)
    elif op == MACH_FADD:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_addss(dst, src, buf)
        else:
            x86_encode_addsd(dst, src, buf)
    elif op == MACH_FSUB:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_subss(dst, src, buf)
        else:
            x86_encode_subsd(dst, src, buf)
    elif op == MACH_FMUL:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_mulss(dst, src, buf)
        else:
            x86_encode_mulsd(dst, src, buf)
    elif op == MACH_FDIV:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_divss(dst, src, buf)
        else:
            x86_encode_divsd(dst, src, buf)
    elif op == MACH_FCMP:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_comiss(dst, src, buf)
        else:
            x86_encode_comisd(dst, src, buf)
    elif op == MACH_ITOF:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_cvtsi2ss(dst, src, buf)
        else:
            x86_encode_cvtsi2sd(dst, src, buf)
    elif op == MACH_FTOI:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_cvttss2si(dst, src, buf)
        else:
            x86_encode_cvttsd2si(dst, src, buf)
    elif op == MACH_CVTSS2SD:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_cvtss2sd(dst, src, buf)
    elif op == MACH_CVTSD2SS:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_cvtsd2ss(dst, src, buf)
    elif op == MACH_MOVDQ:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        if inst.padding == 4 as u8:
            x86_encode_movd(dst, src, buf)
        else:
            x86_encode_movdq(dst, src, buf)
    elif op == MACH_MOVQD:
        let dst = emitter_resolve_reg(inst.dst, allocs)
        let src = emitter_resolve_reg(inst.src1, allocs)
        x86_encode_movqd(dst, src, buf)

pub fn emitter_resolve_fixups(mut e: ptr[MachEmitter]):
    mut i := 0 as i64
    while i < e.fixups.len:
        let fix = e.fixups.data[i]
        let limit_80: u64 = 2147483648
        let limit_F0: u64 = 4026531840
        let fix_id = fix.label_id as u64
        if fix_id >= limit_80:
            mut sym_idx := fix.label_id
            if fix_id < limit_F0:
                sym_idx = fix.label_id & 2147483647 as u32
            push_reloc(&e.relocs, Relocation(
                offset: fix.offset,
                kind: RELOC_PC32,
                padding1: 0 as u8,
                padding2: 0 as u16,
                sym_name: sym_idx,
                addend: -4 as i64
            ))
        else:
            mut target := 0 as i64
            let found = label_map_get(&e.labels, fix.label_id, &target)
            if not found:
                // External symbol â€” needs linker relocation
                push_reloc(&e.relocs, Relocation(
                    offset: fix.offset,
                    kind: RELOC_PC32,
                    padding1: 0 as u8,
                    padding2: 0 as u16,
                    sym_name: fix.label_id,
                    addend: -4 as i64
                ))
            else:
                // Compute PC-relative offset
                let rel = (target - (fix.offset + 4 as i64)) as i32
                
                // Patch rel32 field in code
                e.code.data[fix.offset + 0] = (rel & 0xFF as i32) as u8
                e.code.data[fix.offset + 1] = ((rel >> 8) & 0xFF as i32) as u8
                e.code.data[fix.offset + 2] = ((rel >> 16) & 0xFF as i32) as u8
                e.code.data[fix.offset + 3] = ((rel >> 24) & 0xFF as i32) as u8
        i = i + 1

pub fn emit_function_binary(mut e: ptr[MachEmitter], fn_name: str, insts: ptr[MachInst], insts_len: i64, allocs: ptr[RegAllocation], frame: ptr[StackFrame], is_windows: bool, pool: ptr[InternPool], mut str_lit_counter: ptr[i32], self_link: bool):
    mut prologue := new_mach_inst_vec()
    emit_prologue(frame, &prologue)
    mut i := 0 as i64
    while i < prologue.len:
        emit_mach_inst(e, prologue.data[i], allocs, pool, frame, str_lit_counter)
        i = i + 1
    if prologue.data != null as ptr[MachInst]:
        @free(prologue.data as ptr[u8])
        
    let is_entry = (fn_name == "main" or fn_name == "_AX_main_main_v_v")
    i = 0 as i64
    while i < insts_len:
        let inst = insts[i]
        if inst.op == MACH_RET:
            mut epilogue := new_mach_inst_vec()
            emit_epilogue(frame, &epilogue)
            mut j := 0 as i64
            while j < epilogue.len:
                emit_mach_inst(e, epilogue.data[j], allocs, pool, frame, str_lit_counter)
                j = j + 1
            if epilogue.data != null as ptr[MachInst]:
                @free(epilogue.data as ptr[u8])
                
            if is_entry and self_link:
                if is_windows:
                    // mov ecx, eax -> 89 C1
                    push_byte(&e.code, 0x89 as u8)
                    push_byte(&e.code, 0xC1 as u8)
                    // sub rsp, 40 -> 48 83 EC 28
                    push_byte(&e.code, 0x48 as u8)
                    push_byte(&e.code, 0x83 as u8)
                    push_byte(&e.code, 0xEC as u8)
                    push_byte(&e.code, 0x28 as u8)
                    // call ExitProcess (relocation sym_name = -20)
                    let offset = e.code.len + 1 as i64
                    push_reloc(&e.relocs, Relocation(
                        offset: offset,
                        kind: RELOC_PC32,
                        padding1: 0 as u8,
                        padding2: 0 as u16,
                        sym_name: 4294967276 as u32, // -20 as i64 represented as u32
                        addend: -4 as i64
                    ))
                    push_byte(&e.code, 0xE8 as u8)
                    push_u32_le(&e.code, 0 as u32)
                else:
                    // Linux exit syscall:
                    // mov rdi, rax -> 48 89 C7
                    push_byte(&e.code, 0x48 as u8)
                    push_byte(&e.code, 0x89 as u8)
                    push_byte(&e.code, 0xC7 as u8)
                    // mov rax, 60 -> 48 C7 C0 3C 00 00 00
                    push_byte(&e.code, 0x48 as u8)
                    push_byte(&e.code, 0xC7 as u8)
                    push_byte(&e.code, 0xC0 as u8)
                    push_u32_le(&e.code, 60 as u32)
                    // syscall -> 0F 05
                    push_byte(&e.code, 0x0F as u8)
                    push_byte(&e.code, 0x05 as u8)
            else:
                emit_mach_inst(e, inst, allocs, pool, frame, str_lit_counter)
        else:
            emit_mach_inst(e, inst, allocs, pool, frame, str_lit_counter)
        i = i + 1
        
    emitter_resolve_fixups(e)
// bootstrap/stage1/x86_elf64.ax
// ELF64 Object File Writer for x86-64 Linux targets in self-hosted AXIOM.


extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fwrite(buffer: ptr[void], size: i64, count: i64, stream: ptr[void]) -> i64
extern "C" fn fclose(stream: ptr[void]) -> i32

pub const ELF_CLASS64:    u8 = 2
pub const ELF_DATA2LSB:   u8 = 1
pub const EV_CURRENT:     u8 = 1
pub const ET_REL:        u16 = 1
pub const EM_X86_64:     u16 = 62

pub const SHT_NULL:      u32 = 0
pub const SHT_PROGBITS:  u32 = 1
pub const SHT_SYMTAB:    u32 = 2
pub const SHT_STRTAB:    u32 = 3
pub const SHT_RELA:      u32 = 4
pub const SHT_NOBITS:    u32 = 8

pub const SHF_WRITE:     u64 = 0x01
pub const SHF_ALLOC:     u64 = 0x02
pub const SHF_EXECINSTR: u64 = 0x04

pub const STB_LOCAL:      u8 = 0
pub const STB_GLOBAL:     u8 = 1
pub const STT_OBJECT:     u8 = 1
pub const STT_FUNC:       u8 = 2
pub const STT_SECTION:    u8 = 3

pub struct ELF64Sym:
    pub name_str: str
    pub value: u64
    pub size: u64
    pub binding: u8
    pub sym_type: u8
    pub section: u16

pub struct ELF64SymVec:
    pub data: ptr[ELF64Sym]
    pub len: i64
    pub cap: i64

pub fn new_elf64_sym_vec() -> ELF64SymVec:
    return ELF64SymVec(data: null as ptr[ELF64Sym], len: 0, cap: 0)

pub fn push_elf64_sym(mut self: ptr[ELF64SymVec], s: ELF64Sym):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 40) as ptr[ELF64Sym]
        if self.data != null as ptr[ELF64Sym]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 40)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = s
    self.len = self.len + 1

pub fn elf64_serialize(code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[RelocationVec], symbols: ptr[ELF64SymVec], out_bytes: ptr[ByteVec]):
    // Fixed 7-section layout whose PROGBITS indices match the linker's canonical COFF
    // convention (1=.text, 2=.rodata/.rdata, 3=.data), so symbol `section` values flow
    // through emitter -> object -> linker with no translation:
    //   0 NULL | 1 .text | 2 .rodata | 3 .data | 4 .symtab | 5 .strtab | 6 .rela.text
    // RFC 0030 P4 appends `.bss` as section 7 rather than inserting it after `.data`:
    // indices 4-6 are referenced by hardcoded sh_link values and by the linker's symbol
    // mapping, so inserting would shift them. The linker recognises `.bss` by NAME and
    // normalises it to the logical section 4, so its physical index here is free.
    // .rodata carries string literals; .data carries RFC 0017 module globals. Sections
    // may be zero-sized; emitting all seven unconditionally keeps the layout deterministic.
    // 1. Build string table
    mut strtab := new_byte_vec()
    push_byte(&strtab, 0 as u8) // first byte is NULL

    // NB: `str` is a 16-byte {ptr,len} value, so a 6-element ptr[str] array needs 6*16
    // bytes â€” the original 4*8 under-allocated by half and overflowed the heap (this
    // writer had never been exercised: is_windows was hardcoded).
    let sec_names = @alloc(7 * @compiler_intrinsic("size_of")[str]()) as ptr[str]
    sec_names[0] = ".text"
    sec_names[1] = ".rodata"
    sec_names[2] = ".data"
    sec_names[3] = ".symtab"
    sec_names[4] = ".strtab"
    sec_names[5] = ".rela.text"
    sec_names[6] = ".bss"

    let sec_offsets = @alloc(7 * 4) as ptr[u32]
    mut i := 0 as i64
    while i < 7:
        sec_offsets[i] = strtab.len as u32
        let s = sec_names[i]
        let s_len = std.string.len(s)
        let s_ptr = s as ptr[u8]
        mut char_i := 0 as i64
        while char_i < s_len:
            push_byte(&strtab, s_ptr[char_i])
            char_i = char_i + 1
        push_byte(&strtab, 0 as u8)
        i = i + 1

    // Add symbol names
    let sym_offsets = @alloc(symbols.len * 4) as ptr[u32]
    mut si := 0 as i64
    while si < symbols.len:
        sym_offsets[si] = strtab.len as u32
        let s = symbols.data[si].name_str
        let s_len = std.string.len(s)
        let s_ptr = s as ptr[u8]
        mut char_i := 0 as i64
        while char_i < s_len:
            push_byte(&strtab, s_ptr[char_i])
            char_i = char_i + 1
        push_byte(&strtab, 0 as u8)
        si = si + 1

    // 2. Lay out the file
    let num_sections = 8 as u16 // RFC 0030 P4: + .bss (SHT_NOBITS) at index 7
    let ehdr_size = 64 as i64
    let shdr_size = 64 as i64

    let text_off = ehdr_size
    let text_size = code.len

    mut rodata_off := text_off + text_size
    if (rodata_off % 8 as i64) != 0 as i64:
        rodata_off = rodata_off + (8 as i64 - (rodata_off % 8 as i64))
    let rodata_size = rdata.len

    mut data_off := rodata_off + rodata_size
    if (data_off % 8 as i64) != 0 as i64:
        data_off = data_off + (8 as i64 - (data_off % 8 as i64))
    let data_size = data.len

    mut symtab_off := data_off + data_size
    if (symtab_off % 8 as i64) != 0 as i64:
        symtab_off = symtab_off + (8 as i64 - (symtab_off % 8 as i64))
    let sym_ent_size = 24 as i64
    let sym_count = 1 as i64 + symbols.len // first NULL entry
    let symtab_size = sym_count * sym_ent_size

    let strtab_off = symtab_off + symtab_size
    let strtab_size = strtab.len

    mut rela_off := strtab_off + strtab_size
    if (rela_off % 8 as i64) != 0 as i64:
        rela_off = rela_off + (8 as i64 - (rela_off % 8 as i64))
    let rela_ent_size = 24 as i64
    let rela_size = relocs.len * rela_ent_size

    mut shdr_off := rela_off + rela_size
    if (shdr_off % 8 as i64) != 0 as i64:
        shdr_off = shdr_off + (8 as i64 - (shdr_off % 8 as i64))

    // 3. Write ELF64 Header
    push_byte(out_bytes, 0x7F as u8)
    push_byte(out_bytes, 'E' as u8)
    push_byte(out_bytes, 'L' as u8)
    push_byte(out_bytes, 'F' as u8)
    push_byte(out_bytes, ELF_CLASS64)
    push_byte(out_bytes, ELF_DATA2LSB)
    push_byte(out_bytes, EV_CURRENT)

    // pad out to 16 bytes
    mut pad_i := 0 as i64
    while pad_i < 9:
        push_byte(out_bytes, 0 as u8)
        pad_i = pad_i + 1

    push_u16_le(out_bytes, ET_REL)
    push_u16_le(out_bytes, EM_X86_64)
    push_u32_le(out_bytes, EV_CURRENT as u32)
    push_u64_le(out_bytes, 0 as u64) // e_entry = 0
    push_u64_le(out_bytes, 0 as u64) // e_phoff = 0
    push_u64_le(out_bytes, shdr_off as u64)
    push_u32_le(out_bytes, 0 as u32) // e_flags = 0
    push_u16_le(out_bytes, ehdr_size as u16)
    push_u16_le(out_bytes, 0 as u16) // e_phentsize
    push_u16_le(out_bytes, 0 as u16) // e_phnum
    push_u16_le(out_bytes, shdr_size as u16)
    push_u16_le(out_bytes, num_sections)
    push_u16_le(out_bytes, 5 as u16) // e_shstrndx = 5 (.strtab)

    // 4. Section contents: .text, .rodata, .data
    push_bytes(out_bytes, code.data, text_size)
    if rodata_size > 0 as i64:
        while out_bytes.len < rodata_off:
            push_byte(out_bytes, 0 as u8)
        push_bytes(out_bytes, rdata.data, rodata_size)
    if data_size > 0 as i64:
        while out_bytes.len < data_off:
            push_byte(out_bytes, 0 as u8)
        push_bytes(out_bytes, data.data, data_size)
    while out_bytes.len < symtab_off:
        push_byte(out_bytes, 0 as u8)

    // 5. Write Symbol Table
    // NULL symbol (24 bytes)
    mut sym_pad := 0 as i64
    while sym_pad < 24:
        push_byte(out_bytes, 0 as u8)
        sym_pad = sym_pad + 1

    si = 0
    while si < symbols.len:
        let sym = &symbols.data[si]
        let name_idx = sym_offsets[si]
        push_u32_le(out_bytes, name_idx)
        push_byte(out_bytes, (sym.binding << 4 as u8) | sym.sym_type)
        push_byte(out_bytes, 0 as u8) // st_other
        push_u16_le(out_bytes, sym.section)
        push_u64_le(out_bytes, sym.value)
        push_u64_le(out_bytes, sym.size)
        si = si + 1

    // 6. Write String Table
    push_bytes(out_bytes, strtab.data, strtab_size)

    // 7. Write Relocations
    if relocs.len > 0 as i64:
        while out_bytes.len < rela_off:
            push_byte(out_bytes, 0 as u8)
        mut ri := 0 as i64
        while ri < relocs.len:
            let r = relocs.data[ri]
            push_u64_le(out_bytes, r.offset as u64)

            mut r_type := 1 as u32 // R_X86_64_64
            if r.kind == RELOC_PC32:
                r_type = 2 as u32 // R_X86_64_PC32
            elif r.kind == RELOC_PLT32:
                r_type = 4 as u32 // R_X86_64_PLT32
            elif r.kind == RELOC_ABS64:
                r_type = 1 as u32 // R_X86_64_64

            let r_info = (r_type as u64) | ((r.sym_name as u64) << 32 as u64)
            push_u64_le(out_bytes, r_info)
            push_u64_le(out_bytes, r.addend as u64)
            ri = ri + 1

    // Padding to section headers
    while out_bytes.len < shdr_off:
        push_byte(out_bytes, 0 as u8)

    // 8. Write Section Headers
    // Section 0: SHT_NULL
    mut sh_pad := 0 as i64
    while sh_pad < 64:
        push_byte(out_bytes, 0 as u8)
        sh_pad = sh_pad + 1

    // Section 1: .text
    push_u32_le(out_bytes, sec_offsets[0])
    push_u32_le(out_bytes, SHT_PROGBITS)
    push_u64_le(out_bytes, SHF_ALLOC | SHF_EXECINSTR)
    push_u64_le(out_bytes, 0 as u64) // sh_addr = 0
    push_u64_le(out_bytes, text_off as u64)
    push_u64_le(out_bytes, text_size as u64)
    push_u32_le(out_bytes, 0 as u32) // sh_link = 0
    push_u32_le(out_bytes, 0 as u32) // sh_info = 0
    push_u64_le(out_bytes, 16 as u64) // sh_addralign = 16
    push_u64_le(out_bytes, 0 as u64) // sh_entsize = 0

    // Section 2: .rodata (string literals; may be zero-sized)
    push_u32_le(out_bytes, sec_offsets[1])
    push_u32_le(out_bytes, SHT_PROGBITS)
    push_u64_le(out_bytes, SHF_ALLOC)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, rodata_off as u64)
    push_u64_le(out_bytes, rodata_size as u64)
    push_u32_le(out_bytes, 0 as u32)
    push_u32_le(out_bytes, 0 as u32)
    push_u64_le(out_bytes, 8 as u64)
    push_u64_le(out_bytes, 0 as u64)

    // Section 3: .data (RFC 0017 module globals; may be zero-sized)
    push_u32_le(out_bytes, sec_offsets[2])
    push_u32_le(out_bytes, SHT_PROGBITS)
    push_u64_le(out_bytes, SHF_ALLOC | SHF_WRITE)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, data_off as u64)
    push_u64_le(out_bytes, data_size as u64)
    push_u32_le(out_bytes, 0 as u32)
    push_u32_le(out_bytes, 0 as u32)
    push_u64_le(out_bytes, 8 as u64)
    push_u64_le(out_bytes, 0 as u64)

    // Section 4: .symtab
    push_u32_le(out_bytes, sec_offsets[3])
    push_u32_le(out_bytes, SHT_SYMTAB)
    push_u64_le(out_bytes, 0 as u64) // sh_flags = 0
    push_u64_le(out_bytes, 0 as u64) // sh_addr = 0
    push_u64_le(out_bytes, symtab_off as u64)
    push_u64_le(out_bytes, symtab_size as u64)
    push_u32_le(out_bytes, 5 as u32) // sh_link -> .strtab (section 5)
    push_u32_le(out_bytes, 1 as u32) // sh_info -> first global symbol
    push_u64_le(out_bytes, 8 as u64) // sh_addralign = 8
    push_u64_le(out_bytes, sym_ent_size as u64)

    // Section 5: .strtab
    push_u32_le(out_bytes, sec_offsets[4])
    push_u32_le(out_bytes, SHT_STRTAB)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, strtab_off as u64)
    push_u64_le(out_bytes, strtab_size as u64)
    push_u32_le(out_bytes, 0 as u32)
    push_u32_le(out_bytes, 0 as u32)
    push_u64_le(out_bytes, 1 as u64)
    push_u64_le(out_bytes, 0 as u64)

    // Section 6: .rela.text (may be zero-sized)
    push_u32_le(out_bytes, sec_offsets[5])
    push_u32_le(out_bytes, SHT_RELA)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, 0 as u64)
    push_u64_le(out_bytes, rela_off as u64)
    push_u64_le(out_bytes, rela_size as u64)
    push_u32_le(out_bytes, 4 as u32) // sh_link -> .symtab (section 4)
    push_u32_le(out_bytes, 1 as u32) // sh_info -> .text (section 1)
    push_u64_le(out_bytes, 8 as u64)
    push_u64_le(out_bytes, rela_ent_size as u64)

    // Section 7: .bss â€” RFC 0030 P4. SHT_NOBITS occupies NO file bytes; sh_size carries the
    // extent and the loader zero-fills it. Always emitted (zero-sized when unused) so the
    // section count stays constant and the layout deterministic, matching the rationale for
    // the other possibly-empty sections above.
    push_u32_le(out_bytes, sec_offsets[6])
    push_u32_le(out_bytes, SHT_NOBITS)
    push_u64_le(out_bytes, 3 as u64) // sh_flags = SHF_ALLOC | SHF_WRITE
    push_u64_le(out_bytes, 0 as u64) // sh_addr
    push_u64_le(out_bytes, shdr_off as u64) // sh_offset (conventional; no bytes are read)
    push_u64_le(out_bytes, bss_size as u64) // sh_size = the reserved extent
    push_u32_le(out_bytes, 0 as u32)
    push_u32_le(out_bytes, 0 as u32)
    push_u64_le(out_bytes, 16 as u64) // sh_addralign
    push_u64_le(out_bytes, 0 as u64)

    // Free resources
    @free(sec_names as ptr[u8])
    @free(sec_offsets as ptr[u8])
    @free(sym_offsets as ptr[u8])
    if strtab.data != null as ptr[u8]:
        @free(strtab.data)

pub fn elf64_write_object_file(filename: str, code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[RelocationVec], symbols: ptr[ELF64SymVec]) -> bool:
    mut out_bytes := new_byte_vec()
    elf64_serialize(code, rdata, data, bss_size, relocs, symbols, &out_bytes)
    
    let filename_nt = x86_str_to_null_terminated(filename)
    let file = fopen(filename_nt as ptr[void], get_str_ptr("wb"))
    @free(filename_nt)
    if file == null as ptr[void]:
        if out_bytes.data != null as ptr[u8]:
            @free(out_bytes.data)
        return false
        
    fwrite(out_bytes.data as ptr[void], 1, out_bytes.len, file)
    fclose(file)
    
    if out_bytes.data != null as ptr[u8]:
        @free(out_bytes.data)
    return true
// bootstrap/stage1/x86_coff.ax
// PE/COFF Object File Writer for x86-64 Windows targets in self-hosted AXIOM.


pub const IMAGE_REL_AMD64_ADDR64: u16 = 1
pub const IMAGE_REL_AMD64_REL32:  u16 = 4

pub const IMAGE_SYM_CLASS_EXTERNAL: u8 = 2
pub const IMAGE_SYM_CLASS_STATIC:   u8 = 3

pub struct COFFReloc:
    pub virt_addr: u32
    pub sym_table_idx: u32
    pub reloc_type: u16

pub struct COFFRelocVec:
    pub data: ptr[COFFReloc]
    pub len: i64
    pub cap: i64

pub fn new_coff_reloc_vec() -> COFFRelocVec:
    return COFFRelocVec(data: null as ptr[COFFReloc], len: 0, cap: 0)

pub fn push_coff_reloc(mut self: ptr[COFFRelocVec], r: COFFReloc):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 12) as ptr[COFFReloc]
        if self.data != null as ptr[COFFReloc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 12)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = r
    self.len = self.len + 1

pub struct COFFSymbol:
    pub name_str: str
    pub value: u32
    pub section_num: i16
    pub sym_type: u16
    pub storage_class: u8
    pub num_aux: u8

pub struct COFFSymbolVec:
    pub data: ptr[COFFSymbol]
    pub len: i64
    pub cap: i64

pub fn new_coff_symbol_vec() -> COFFSymbolVec:
    return COFFSymbolVec(data: null as ptr[COFFSymbol], len: 0, cap: 0)

pub fn push_coff_symbol(mut self: ptr[COFFSymbolVec], s: COFFSymbol) -> i32:
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 32) as ptr[COFFSymbol]
        if self.data != null as ptr[COFFSymbol]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 32)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    let idx = self.len as i32
    self.data[self.len] = s
    self.len = self.len + 1
    return idx

extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fwrite(buffer: ptr[void], size: i64, count: i64, stream: ptr[void]) -> i64
extern "C" fn fclose(stream: ptr[void]) -> i32

pub fn coff_serialize(code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[COFFRelocVec], symbols: ptr[COFFSymbolVec], out_bytes: ptr[ByteVec]):
    // 1. Build string table
    mut strtab := new_byte_vec()
    push_u32_le(&strtab, 4 as u32) // length placeholder
    
    let string_offsets = @alloc(symbols.len * 4) as ptr[u32]
    mut si := 0 as i64
    while si < symbols.len:
        let name = symbols.data[si].name_str
        let name_len = std.string.len(name)
        if name_len > 8:
            string_offsets[si] = strtab.len as u32
            push_bytes(&strtab, name as ptr[u8], name_len)
            push_byte(&strtab, 0 as u8)
        else:
            string_offsets[si] = 0 as u32
        si = si + 1
        
    // Patch string table length
    if strtab.len > 4 as i64:
        let total_len = strtab.len as u32
        strtab.data[0] = (total_len & 0xFF as u32) as u8
        strtab.data[1] = ((total_len >> 8 as u32) & 0xFF as u32) as u8
        strtab.data[2] = ((total_len >> 16 as u32) & 0xFF as u32) as u8
        strtab.data[3] = ((total_len >> 24 as u32) & 0xFF as u32) as u8
        
    // 2. Lay out COFF components
    let text_size = code.len
    let rdata_size = rdata.len
    // RFC 0017 / BUG#82: an optional writable .data section (section 3) holds module-level
    // globals. Emitted ONLY when non-empty, so a program with no globals produces a
    // byte-identical 2-section object (fixpoint-preserving).
    let data_size = data.len
    let has_data = data_size > 0 as i64
    // RFC 0030 P3: an optional .bss (section 4) reserving zero-initialized global storage.
    // It occupies NO file bytes â€” SizeOfRawData 0, PointerToRawData 0 â€” and declares its
    // extent through VirtualSize, which the image loader zero-fills. Emitted only when the
    // emitter routed globals into it, so objects without one stay byte-identical.
    let has_bss = bss_size > 0 as i64
    mut num_sections := 2 as i64
    if has_data:
        num_sections = 3 as i64
    if has_bss:
        num_sections = num_sections + 1 as i64
    let text_raw_ptr = 20 as i64 + num_sections * 40 as i64 // FileHeader(20) + N*SectionHeader(40)
    let rdata_raw_ptr = text_raw_ptr + text_size
    let data_raw_ptr = rdata_raw_ptr + rdata_size
    let relocs_offset = data_raw_ptr + data_size
    let symbol_table_offset = relocs_offset + relocs.len * 10 as i64

    // 3. Write COFF File Header (20 bytes)
    push_u16_le(out_bytes, 0x8664 as u16) // AMD64
    push_u16_le(out_bytes, num_sections as u16) // .text, .rdata [, .data]
    push_u32_le(out_bytes, 0 as u32)      // TimeDateStamp
    push_u32_le(out_bytes, symbol_table_offset as u32)
    push_u32_le(out_bytes, symbols.len as u32)
    push_u16_le(out_bytes, 0 as u16)      // SizeOfOptionalHeader = 0
    push_u16_le(out_bytes, 0 as u16)      // Characteristics = 0
    
    // 4. Write Section Header 1 (.text) (40 bytes)
    push_byte(out_bytes, '.' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 'e' as u8)
    push_byte(out_bytes, 'x' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_u32_le(out_bytes, 0 as u32) // VirtualSize
    push_u32_le(out_bytes, 0 as u32) // VirtualAddress
    push_u32_le(out_bytes, text_size as u32)
    push_u32_le(out_bytes, text_raw_ptr as u32)
    push_u32_le(out_bytes, relocs_offset as u32)
    push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
    push_u16_le(out_bytes, relocs.len as u16)
    push_u16_le(out_bytes, 0 as u16) // NumLineNums
    // CODE | EXECUTE | READ (0x60000020)
    push_u32_le(out_bytes, 0x00000020 as u32 | 0x20000000 as u32 | 0x40000000 as u32)
    
    // 4. Write Section Header 2 (.rdata) (40 bytes)
    push_byte(out_bytes, '.' as u8)
    push_byte(out_bytes, 'r' as u8)
    push_byte(out_bytes, 'd' as u8)
    push_byte(out_bytes, 'a' as u8)
    push_byte(out_bytes, 't' as u8)
    push_byte(out_bytes, 'a' as u8)
    push_byte(out_bytes, 0 as u8)
    push_byte(out_bytes, 0 as u8)
    push_u32_le(out_bytes, 0 as u32) // VirtualSize
    push_u32_le(out_bytes, 0 as u32) // VirtualAddress
    push_u32_le(out_bytes, rdata_size as u32)
    push_u32_le(out_bytes, rdata_raw_ptr as u32)
    push_u32_le(out_bytes, 0 as u32) // RelocsPtr
    push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
    push_u16_le(out_bytes, 0 as u16) // NumRelocs
    push_u16_le(out_bytes, 0 as u16) // NumLineNums
    // INITIALIZED_DATA | READ (0x40000040)
    push_u32_le(out_bytes, 0x00000040 as u32 | 0x40000000 as u32)

    // 4c. Write Section Header 3 (.data) â€” RFC 0017: writable global storage (only when
    // globals exist). INITIALIZED_DATA | READ | WRITE (0xC0000040).
    if has_data:
        push_byte(out_bytes, '.' as u8)
        push_byte(out_bytes, 'd' as u8)
        push_byte(out_bytes, 'a' as u8)
        push_byte(out_bytes, 't' as u8)
        push_byte(out_bytes, 'a' as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_u32_le(out_bytes, 0 as u32) // VirtualSize
        push_u32_le(out_bytes, 0 as u32) // VirtualAddress
        push_u32_le(out_bytes, data_size as u32)
        push_u32_le(out_bytes, data_raw_ptr as u32)
        push_u32_le(out_bytes, 0 as u32) // RelocsPtr
        push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
        push_u16_le(out_bytes, 0 as u16) // NumRelocs
        push_u16_le(out_bytes, 0 as u16) // NumLineNums
        push_u32_le(out_bytes, 0x00000040 as u32 | 0x40000000 as u32 | 0x80000000 as u32) // INIT_DATA|READ|WRITE

    // 4d. Write Section Header 4 (.bss) â€” RFC 0030: zero-initialized global storage.
    // SizeOfRawData and PointerToRawData are 0 (no file bytes); VirtualSize carries the
    // extent. UNINITIALIZED_DATA | READ | WRITE (0xC0000080).
    if has_bss:
        push_byte(out_bytes, '.' as u8)
        push_byte(out_bytes, 'b' as u8)
        push_byte(out_bytes, 's' as u8)
        push_byte(out_bytes, 's' as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_byte(out_bytes, 0 as u8)
        push_u32_le(out_bytes, bss_size as u32) // VirtualSize = the reserved extent
        push_u32_le(out_bytes, 0 as u32) // VirtualAddress
        push_u32_le(out_bytes, 0 as u32) // SizeOfRawData = 0 (occupies no file bytes)
        push_u32_le(out_bytes, 0 as u32) // PointerToRawData = 0
        push_u32_le(out_bytes, 0 as u32) // RelocsPtr
        push_u32_le(out_bytes, 0 as u32) // LineNumsPtr
        push_u16_le(out_bytes, 0 as u16) // NumRelocs
        push_u16_le(out_bytes, 0 as u16) // NumLineNums
        push_u32_le(out_bytes, 0x00000080 as u32 | 0x40000000 as u32 | 0x80000000 as u32) // UNINIT_DATA|READ|WRITE

    // 5. Write raw section data
    push_bytes(out_bytes, code.data, text_size)
    push_bytes(out_bytes, rdata.data, rdata_size)
    if has_data:
        push_bytes(out_bytes, data.data, data_size)

    
    // 6. Write Relocation Table
    mut ri := 0 as i64
    while ri < relocs.len:
        let r = relocs.data[ri]
        push_u32_le(out_bytes, r.virt_addr)
        push_u32_le(out_bytes, r.sym_table_idx)
        push_u16_le(out_bytes, r.reloc_type)
        ri = ri + 1
        
    // 7. Write Symbol Table
    si = 0
    while si < symbols.len:
        let sym = &symbols.data[si]
        let name_len = std.string.len(sym.name_str)
        if name_len <= 8:
            let name_ptr = sym.name_str as ptr[u8]
            let pad8 = @alloc(8) as ptr[u8]
            @memset(pad8 as ptr[void], 0 as u8, 8)
            @memcpy(pad8, name_ptr, name_len)
            push_bytes(out_bytes, pad8, 8)
            @free(pad8)
        else:
            let offset = string_offsets[si]
            push_u32_le(out_bytes, 0 as u32)
            push_u32_le(out_bytes, offset)
            
        push_u32_le(out_bytes, sym.value)
        push_u16_le(out_bytes, sym.section_num as u16)
        push_u16_le(out_bytes, sym.sym_type)
        push_byte(out_bytes, sym.storage_class)
        push_byte(out_bytes, sym.num_aux)
        si = si + 1
        
    // 8. Write String Table
    push_bytes(out_bytes, strtab.data, strtab.len)
    
    // Free resources
    @free(string_offsets as ptr[u8])
    if strtab.data != null as ptr[u8]:
        @free(strtab.data)

pub fn coff_write_object_file(filename: str, code: ptr[ByteVec], rdata: ptr[ByteVec], data: ptr[ByteVec], bss_size: i64, relocs: ptr[COFFRelocVec], symbols: ptr[COFFSymbolVec]) -> bool:
    mut out_bytes := new_byte_vec()
    coff_serialize(code, rdata, data, bss_size, relocs, symbols, &out_bytes)
    
    let filename_nt = x86_str_to_null_terminated(filename)
    let file = fopen(filename_nt as ptr[void], get_str_ptr("wb"))
    @free(filename_nt)
    if file == null as ptr[void]:
        if out_bytes.data != null as ptr[u8]:
            @free(out_bytes.data)
        return false
        
    fwrite(out_bytes.data as ptr[void], 1, out_bytes.len, file)
    fclose(file)
    
    if out_bytes.data != null as ptr[u8]:
        @free(out_bytes.data)
    return true

pub struct CompiledFuncInfo:
    pub name: str
    pub offset: u32
    pub size: u32
    pub is_global: bool
    pub relocs: RelocationVec

pub struct CompiledFuncInfoVec:
    pub data: ptr[CompiledFuncInfo]
    pub len: i64
    pub cap: i64

pub fn new_compiled_func_info_vec() -> CompiledFuncInfoVec:
    return CompiledFuncInfoVec(data: null as ptr[CompiledFuncInfo], len: 0, cap: 0)

pub fn push_compiled_func_info(mut self: ptr[CompiledFuncInfoVec], info: CompiledFuncInfo):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 56) as ptr[CompiledFuncInfo]
        if self.data != null as ptr[CompiledFuncInfo]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 56)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = info
    self.len = self.len + 1

pub fn resolve_binary_sym_name(sym_idx: i64, current_fn_name: str, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable]) -> str:
    if sym_idx == -30 as i64:
        return "ax_str_slice"
    let base: i64 = 3758096384
    if sym_idx >= base:
        let str_id = sym_idx - base
        let sym_name_buf = @alloc(64) as ptr[u8]
        let prefix = "Linfo.string." as ptr[u8]
        mut idx := 0 as i64
        while idx < 13:
            sym_name_buf[idx] = prefix[idx]
            idx = idx + 1
        mut val := str_id as i64
        if val == 0 as i64:
            sym_name_buf[idx] = '0' as u8
            idx = idx + 1
        else:
            mut temp_buf := @alloc(32) as ptr[u8]
            mut temp_len := 0
            while val > 0 as i64:
                temp_buf[temp_len] = ('0' as u8 + (val % 10 as i64) as u8)
                temp_len = temp_len + 1
                val = val / 10 as i64
            mut k := 0
            while k < temp_len:
                sym_name_buf[idx] = temp_buf[temp_len - 1 - k]
                idx = idx + 1
                k = k + 1
            @free(temp_buf)
        sym_name_buf[idx] = 0 as u8
        let res = alloc_str_from_raw(sym_name_buf, strlen(sym_name_buf))
        @free(sym_name_buf)
        return res
    if sym_idx == -1 as i64:
        return "ax_alloc"

    if sym_idx == -2 as i64:
        return "ax_free"
    if sym_idx == -3 as i64:
        return "ax_actor_spawn"
    if sym_idx == -4 as i64:
        return "ax___ax_runtime_init"
    if sym_idx == -5 as i64:
        return "ax___ax_runtime_shutdown"
    if sym_idx == -8 as i64:
        return "abort"
    if sym_idx == -20 as i64:
        return "ExitProcess"
    if sym_idx == -21 as i64:
        return "strlen"
    if sym_idx == -22 as i64:
        return "ax_str_eq"
    if sym_idx == -10 as i64:
        return "ax_println_str"
    if sym_idx == -11 as i64:
        return "ax_println_i64"
    if sym_idx == -12 as i64:
        return "ax_println_f64"
    if sym_idx == -13 as i64:
        return "ax_println_bool"
    if sym_idx == -14 as i64:
        return "ax_print_str"
    if sym_idx == -15 as i64:
        return "ax_print_i64"
    if sym_idx == -16 as i64:
        return "ax_print_f64"
    if sym_idx == -17 as i64:
        return "ax_print_bool"
    if sym_idx <= 0 as i64:
        return current_fn_name
    let name = x86_resolve_sym_name(sym_idx as u32, symbols, pool, table)
    if name == "alloc":
        return "ax_alloc"
    if name == "free":
        return "ax_free"
    if name == "std.string.len" or name == "ax_std.string.len":
        return "ax_str_len"
    // std.string.{concat,replace,slice} are NOT redirected to the C-runtime DLL
    // symbols: those use the C/Win64 ABI (str args by-ref, 16-byte struct return
    // via a hidden sret pointer) which is incompatible with AXIOM's value ABI
    // (str args by pointer, result in RAX:RDX). Each falls through to its
    // value-ABI in-program body in std/string.ax.
    //
    // BUG#29 (self-host fixpoint blocker): the str-RETURNING redirects (replace,
    // slice) were miscompiled by the stage1-built backend. The exact class is the
    // hidden-sret return-pointer setup of a C-ABI call that returns a 16-byte str:
    // stage1's native backend miscompiles the emitter for that sret setup, so
    // stage2 emitted ax_str_replace / ax_str_slice calls with a corrupt sret/ptr
    // -> OOM (bad len) / segfault (bad ptr) when stage3 ran. (len->i64 and
    // eq->bool have NO sret and stayed correct, which is why stage2 itself ran;
    // only the calls stage2 EMITTED into stage3 were broken.) concat was already
    // value-ABI for the same reason. Fix: do not redirect replace or slice; use
    // the value-ABI in-program functions. NB: the `-30` path in
    // resolve_binary_sym_name and the ax_block_size alias below still reference
    // ax_str_slice â€” those are separate machinery, not the std.string.slice call.
    return name




// RFC 0031 (dead function elimination) â€” REPORT-ONLY reachability over the AIR call graph.
// Follows the `-ctgc-free-report` precedent (RFC 0015 P3): measure the set first, emit
// nothing differently, and only activate once the numbers are understood. Output is
// byte-identical with the flag on.
//
// Edges, per the AIR encoding:
//   * direct call    â€” OP_CALL with src1 == 0 carries the callee symbol in type_id
//   * indirect edge  â€” OP_FUNC_ADDR carries the target symbol in src1
// An OP_CALL with src1 != 0 is a call THROUGH a register; its target was necessarily
// materialised by some OP_FUNC_ADDR, which is why taking every funcaddr as a root-ish edge
// is what keeps fn pointers, lambdas and RFC 0029 vtables alive.
//
// NOT visible here, and the reason activation needs more than this pass: OP_FREE/OP_DESTROY
// lower to a MACH_CALL with the magic callee index -2 rather than a symbol, so `ax_free` has
// no edge at all. The linker's runtime-ABI allow-list (linker.ax ~L635) is the other root
// source. Both must be seeded before anything is actually pruned.
// Does this emitted symbol name denote a runtime ABI entry point â€” one the linker
// binds BY NAME, with no call edge anywhere in the AIR?
//
// The allow-list in linker.ax is written in terms of the ABI name (`ax_println_str`),
// but codegen emits AXIOM definitions with its own `ax_` prefix, so the same function
// appears here as `ax_ax_println_str`. Testing the raw name alone therefore matches
// nothing on the one target where it matters most.
//
// It matters most on ELF because there is no ax_runtime.dll on Linux: the whole
// print / str_eq / panic / syscall family is compiled INTO the program as ordinary
// AXIOM functions, and reached only through the magic negative callee indices. On
// COFF those same names are DLL imports, absent from mod.funcs, so the missing
// prefix strip was invisible â€” COFF regression passed 511/511 while every pruned
// ELF binary segfaulted.
fn dfe_is_abi_name(nm: str) -> bool:
    if is_valid_runtime_dll_symbol(nm):
        return true
    let n = std.string.len(nm)
    if n > 3:
        let p = get_str_ptr(nm)
        if p[0] == 'a' as u8 and p[1] == 'x' as u8 and p[2] == '_' as u8:
            if is_valid_runtime_dll_symbol(std.string.slice(nm, 3, n)):
                return true
    return false

// Reachability over the AIR call graph, indexed by sym_id. Returns null when the
// symbol table is empty (nothing to analyse), which every caller must treat as
// "prune nothing" â€” the conservative direction. Pure: it inspects the module and
// allocates a result, and changes no compiler state, so computing it when only
// reporting is exactly as safe as not computing it at all.
fn dfe_compute(mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], verbose: bool) -> ptr[bool]:
    let nsym = symbols.symbols.len
    if nsym <= 0 as i64:
        return null as ptr[bool]
    let reach = @alloc(nsym) as ptr[bool]
    @memset(reach as ptr[void], 0 as u8, nsym)

    // Seed the roots. Three kinds. Only the first is discovered by walking the
    // call graph; the other two are precisely the functions the graph CANNOT see,
    // which is why getting them wrong is a miscompile rather than a size loss.
    //
    //   1. the entry point â€” everything an executable needs hangs off it;
    //
    //   2. every #[export]-ed function (RFC 0009 P2, symbols.export_syms). For a
    //      --shared / --staticlib build the exports ARE the roots: nothing calls
    //      them from inside the module, so a walk from main alone prunes the whole
    //      public surface of the library. Matched on the intern name-id AND on the
    //      resolved name, because export_syms stores plain name-ids while the
    //      emitted symbol may be mangled â€” comparing only one of the two silently
    //      matches nothing, which is how this root first shipped reporting zero;
    //
    //   3. bundled functions whose name collides with a runtime ABI symbol
    //      (std/runtime.ax defines ax_str_len, ax_str_concat, ax_panic, ...).
    //      These are reached by NAME, not by a call edge: x86_resolve_callee_name
    //      rewrites AXIOM `free` to "ax_free" and `std.string.len` to "ax_str_len",
    //      and the magic negative callee indices (-1, -2, -10..-22) resolve to the
    //      same names. The linker then binds by name. A bundled definition
    //      answering to one of those names therefore has callers that leave no
    //      trace whatsoever in the AIR graph.
    //
    // (3) was found by measurement, not by reading: this pass shipped with an
    // audit counter asserting no bundled function shadows an ABI name, and the
    // first run reported ten of them. The allow-list is READ from linker.ax rather
    // than restated here so the two cannot drift apart.
    mut total_funcs := 0 as i64
    mut root_exports := 0 as i64
    mut root_abi := 0 as i64
    mut root_extern := 0 as i64
    mut has_entry := false
    mut fi := 0 as i64
    while fi < mod.funcs.len:
        let f = &mod.funcs.data[fi]
        if not f.is_extern:
            total_funcs = total_funcs + 1 as i64
            let nm = x86_resolve_sym_name(f.sym_id, symbols, pool, table)
            mut is_root := (nm == "main" or nm == "_AX_main_main_v_v")
            if is_root:
                has_entry = true
            if not is_root:
                mut ek := 0 as i64
                while ek < symbols.export_syms.len:
                    let eid = symbols.export_syms.data[ek]
                    if eid == f.name or pool.get(eid) == nm:
                        is_root = true
                        root_exports = root_exports + 1 as i64
                        ek = symbols.export_syms.len
                    else:
                        ek = ek + 1
            if not is_root and dfe_is_abi_name(nm):
                is_root = true
                root_abi = root_abi + 1 as i64
            if not is_root:
                //   4. reached by NAME through an extern-"C" forward declaration.
                //      A module breaks a circular call â€” resolver -> ax_driver_load_module,
                //      whose definition lives in the driver â€” by re-declaring the target as
                //      `extern "C"` and calling THAT. The linker then binds the extern
                //      reference to the definition by name, so, exactly like the ABI-name
                //      shadows above, no OP_CALL edge to the definition exists for the walk
                //      to follow: the definition looks call-less and gets pruned, producing
                //      an `unresolved external symbol` at self-link. A defined function
                //      whose emitted symbol equals an extern declaration's name in this same
                //      module is therefore a root. The C-runtime externs (fopen, printf,
                //      syscall, ...) have no internal definition with a matching mangled
                //      name, so nothing matches them and this over-roots nothing.
                mut xj := 1 as i64
                while xj < nsym:
                    let xs = &symbols.symbols.data[xj]
                    let xs_extern = ((xs.flags & 4 as u16) != 0 as u16)
                    if xs_extern and (xj != (f.sym_id as i64)):
                        let xn = x86_resolve_sym_name(xj as u32, symbols, pool, table)
                        if std.string.len(xn) > 0 as i64 and xn == nm:
                            is_root = true
                            root_extern = root_extern + 1 as i64
                            xj = nsym
                        else:
                            xj = xj + 1
                    else:
                        xj = xj + 1
            if is_root:
                if (f.sym_id as i64) < nsym:
                    reach[f.sym_id as i64] = true
        fi = fi + 1

    // Fixpoint: re-scan until a full pass adds nothing.
    mut changed := true
    while changed:
        changed = false
        mut gi := 0 as i64
        while gi < mod.funcs.len:
            let g = &mod.funcs.data[gi]
            if not g.is_extern and (g.sym_id as i64) < nsym and reach[g.sym_id as i64]:
                mut ii := 0 as i64
                while ii < g.insts.len:
                    let inst = g.insts.data[ii]
                    mut tgt := 0 as u32
                    if inst.opcode == OP_CALL and inst.src1 == 0 as u32:
                        tgt = inst.type_id
                    elif inst.opcode == OP_FUNC_ADDR:
                        tgt = inst.src1
                    elif inst.opcode == OP_SPAWN:
                        // `spawn worker(...)` records the actor/thread entry function's
                        // sym_id in type_id (air_builder.lower_spawn, from the callee
                        // ident's payload); src1 holds the lowered callee reg, not 0, so
                        // the OP_CALL branch above does not fire. The entry is reached ONLY
                        // through this spawn â€” no direct call edge â€” so without following
                        // it here the walk prunes the handler and the spawn relocation is
                        // left dangling (unresolved external, a garbage symbol name).
                        tgt = inst.type_id
                    if tgt != 0 as u32 and (tgt as i64) < nsym:
                        if not reach[tgt as i64]:
                            reach[tgt as i64] = true
                            changed = true
                    ii = ii + 1
            gi = gi + 1

    // No entry point â‡’ this is not an executable, and the reachability walk had
    // nowhere to start. A --staticlib or --shared build with no #[export] would
    // otherwise compute an empty reachable set and prune the ENTIRE library into
    // an empty archive: the analysis would be "correct" and the output useless.
    // Returning null makes every caller fall back to emitting everything, which
    // is the only safe answer when the roots are unknown rather than merely few.
    if not has_entry and root_exports == 0 as i64:
        if verbose:
            ax_printf_local("[dfe] no entry and no exports â€” analysis declined, nothing pruned\n",
                0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            fflush(null as ptr[void])
        @free(reach as ptr[u8])
        return null as ptr[bool]

    if verbose:
        mut reach_funcs := 0 as i64
        mut hi := 0 as i64
        while hi < mod.funcs.len:
            let h = &mod.funcs.data[hi]
            if not h.is_extern and (h.sym_id as i64) < nsym and reach[h.sym_id as i64]:
                reach_funcs = reach_funcs + 1 as i64
            hi = hi + 1
        ax_printf_local("[dfe] reachable %d / %d functions (roots: entry + %d export + %d abi + %d extern-shadow)\n",
            reach_funcs, total_funcs, root_exports, root_abi, root_extern, 0 as i64, 0 as i64, 0 as i64)
        fflush(null as ptr[void])
    return reach

// Bytes, matched back by NAME rather than by position: the emission loop is
// followed by several synthetic entries (ax_Ok, ax_Err, ...) pushed into the same
// vector, so index correspondence with mod.funcs holds only by accident of
// ordering and would break silently the day another stub is appended.
//
// Runs after emission, so under -dfe the pruned functions contribute no info entry
// and their size reads as zero. That is the honest number: with pruning active the
// dead bytes are not in the binary to be counted.
fn dfe_report_bytes(mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], infos: ptr[CompiledFuncInfoVec], reach: ptr[bool]):
    if reach == null as ptr[bool]:
        return
    let nsym = symbols.symbols.len
    mut reach_bytes := 0 as i64
    mut dead_bytes := 0 as i64
    mut hi := 0 as i64
    while hi < mod.funcs.len:
        let h = &mod.funcs.data[hi]
        if not h.is_extern:
            let hn = x86_resolve_sym_name(h.sym_id, symbols, pool, table)
            mut hsz := 0 as i64
            mut ki := 0 as i64
            while ki < infos.len:
                if infos.data[ki].name == hn:
                    hsz = infos.data[ki].size as i64
                    ki = infos.len
                else:
                    ki = ki + 1
            if (h.sym_id as i64) < nsym and reach[h.sym_id as i64]:
                reach_bytes = reach_bytes + hsz
            else:
                dead_bytes = dead_bytes + hsz
        hi = hi + 1

    ax_printf_local("[dfe] text bytes: live %d, dead %d (of %d)\n",
        reach_bytes, dead_bytes, reach_bytes + dead_bytes, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])

pub fn compile_native_binary(output_obj_file: str, mod: AirModule, symbols: ptr[SymbolTable], pool: ptr[InternPool], table: ptr[TypeTable], format_ptr: ptr[u8], self_link: bool, dfe_rep: bool, dfe_on: bool) -> bool:
    let is_elf64 = (format_ptr[0] == 'e' as u8)
    mut abi := "win64"
    if is_elf64:
        abi = "sysv"
        
    mut all_code := new_byte_vec()
    mut func_infos := new_compiled_func_info_vec()
    
    mut coff_syms := new_coff_symbol_vec()
    mut elf_syms := new_elf64_sym_vec()

    mut rdata_buf := new_byte_vec()
    mut str_keys := new_u32_vec()
    mut str_offsets := new_u32_vec()

    // O(1) dedup via boolean seen-array indexed by intern-pool ID.
    // Replaces the O(n) linear search that made the scan O(n^2) overall.
    let str_seen_size = pool.state.count + 2 as i64
    let str_seen = @alloc(str_seen_size) as ptr[bool]
    @memset(str_seen as ptr[void], 0 as u8, str_seen_size)

    // Scan for all string literals across all functions
    mut scan_fi := 0 as i64
    while scan_fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[scan_fi]
        if not fn_ptr.is_extern:
            mut inst_i := 0 as i64
            while inst_i < fn_ptr.insts.len:
                let inst = &fn_ptr.insts.data[inst_i]
                let t_id = inst.type_id as u32
                mut is_str := (t_id == 12 as u32)
                if t_id < table.entries.len as u32:
                    if table.entries.data[t_id].size == 16 as u32:
                        is_str = true
                if inst.opcode == OP_ICONST and is_str:
                    let str_id = inst.src1
                    let str_id_i = str_id as i64
                    mut found := true
                    if str_id_i < str_seen_size:
                        if not str_seen[str_id_i]:
                            str_seen[str_id_i] = true
                            found = false
                    if not found:
                        let offset = rdata_buf.len as u32
                        str_keys.push(str_id)
                        str_offsets.push(offset)
                        let raw_text = pool.get(str_id)
                        let text = unescape_string_literal(raw_text)
                        let len = std.string.len(text)
                        push_bytes(&rdata_buf, text as ptr[u8], len)
                        push_byte(&rdata_buf, 0 as u8)
                        @free(text as ptr[u8])
                inst_i = inst_i + 1
        scan_fi = scan_fi + 1
    @free(str_seen as ptr[u8])

    // Register all unique string symbols in COFF / ELF symbol table
    mut str_i := 0 as i64
    while str_i < str_keys.len:
        let str_id = str_keys.data[str_i]
        let offset = str_offsets.data[str_i]
        let sym_name_buf = @alloc(64) as ptr[u8]
        let prefix = "Linfo.string." as ptr[u8]
        mut idx := 0 as i64
        while idx < 13:
            sym_name_buf[idx] = prefix[idx]
            idx = idx + 1
        mut val := str_id as i64
        if val == 0 as i64:
            sym_name_buf[idx] = '0' as u8
            idx = idx + 1
        else:
            mut temp_buf := @alloc(32) as ptr[u8]
            mut temp_len := 0
            while val > 0 as i64:
                temp_buf[temp_len] = ('0' as u8 + (val % 10 as i64) as u8)
                temp_len = temp_len + 1
                val = val / 10 as i64
            mut k := 0
            while k < temp_len:
                sym_name_buf[idx] = temp_buf[temp_len - 1 - k]
                idx = idx + 1
                k = k + 1
            @free(temp_buf)
        sym_name_buf[idx] = 0 as u8
        let temp_str = alloc_str_from_raw(sym_name_buf, strlen(sym_name_buf))
        let sym_name = pool.intern(temp_str)
        let sym_name_str = pool.get(sym_name)
        @free(temp_str as ptr[u8])
        if is_elf64:
            push_elf64_sym(&elf_syms, ELF64Sym(name_str: sym_name_str, value: offset as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: 2 as u16))
        else:
            push_coff_symbol(&coff_syms, COFFSymbol(name_str: sym_name_str, value: offset, section_num: 2 as i16, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        @free(sym_name_buf)
        str_i = str_i + 1

    
    mut fi := 0 as i64
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        if fn_ptr.is_extern:
            let name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: name, value: 0 as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: 0 as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: name, value: 0 as u32, section_num: 0 as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
        fi = fi + 1
        
    // RFC 0031. Computed once, before emission, and used for two things: the
    // report, and (under -dfe) the decision not to emit. Reporting and pruning
    // therefore cannot disagree about what is reachable â€” the number printed is
    // the number acted on.
    mut dfe_reach := null as ptr[bool]
    if dfe_rep or dfe_on:
        dfe_reach = dfe_compute(mod, symbols, pool, table, dfe_rep)
    // A null result means the analysis declined to run. Pruning must then do
    // nothing rather than fall back to some partial answer.
    let dfe_prune = dfe_on and dfe_reach != null as ptr[bool]
    let dfe_nsym = symbols.symbols.len

    fi = 0
    mut func_done_count := 0 as i64
    mut dfe_pruned := 0 as i64
    while fi < mod.funcs.len:
        let fn_ptr = &mod.funcs.data[fi]
        mut dfe_skip := false
        if dfe_prune and not fn_ptr.is_extern:
            if (fn_ptr.sym_id as i64) < dfe_nsym:
                if not dfe_reach[fn_ptr.sym_id as i64]:
                    dfe_skip = true
                    dfe_pruned = dfe_pruned + 1 as i64
                    // Name every dropped function. Without this the only symptom of
                    // a missing root is a SIGSEGV in the built program, with nothing
                    // to connect it back to what was removed (CLAUDE.md Â§9: the IR
                    // must stay debuggable). Verbose by design â€” the flag is a debug
                    // flag, and the list is the first thing anyone diagnosing a
                    // pruned-binary crash needs.
                    if dfe_rep:
                        ax_printf_local("[dfe] prune %s\n",
                            get_str_ptr(x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)) as i64,
                            0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        if not fn_ptr.is_extern and not dfe_skip:
            let fn_name = x86_resolve_sym_name(fn_ptr.sym_id, symbols, pool, table)

            if func_done_count % 10 as i64 == 0 as i64:
                ax_printf_local("[codegen] func %d / %d | bytes=%d\n",
                    func_done_count, mod.funcs.len, all_code.len as i64,
                    0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                fflush(null as ptr[void])

            let mach_insts = select_all(fn_ptr, abi, table, symbols, pool)
            let intervals = compute_liveness(mach_insts.data, mach_insts.len)
            let alloc_res = allocate_registers_orchestrator(intervals, mach_insts.data, mach_insts.len, abi, fn_ptr, table, symbols)

            mut num_str_lits := 0 as i32
            mut loop_i := 0 as i64
            while loop_i < mach_insts.len:
                let inst = mach_insts.data[loop_i]
                if inst.op == MACH_MOV_IMM and inst.src1.vreg == 2 as u32:
                    num_str_lits = num_str_lits + 1
                loop_i = loop_i + 1

            mut local_bytes := 0 as i32
            if num_str_lits > 0:
                local_bytes = 16 + num_str_lits * 16

            mut cs_len := 0 as i64
            let cs_regs = get_used_callee_saved(abi, alloc_res.allocs, alloc_res.max_vreg, &cs_len)
            let frame = compute_frame(cs_regs, cs_len, alloc_res.spill_count, local_bytes, abi)
            
            let final_insts = insert_spill_code(mach_insts.data, mach_insts.len, alloc_res.allocs, &frame, fn_ptr, table, symbols)
            // Â§9 verification: nothing may still be a virtual register here. See
            // verify_all_operands_allocated â€” the emitter would silently encode an
            // unallocated operand as r15/xmm15 rather than fail.
            let unalloc = verify_all_operands_allocated(final_insts.data, final_insts.len, alloc_res.allocs, alloc_res.max_vreg, fn_name)
            mut emitter := new_mach_emitter()

            let is_windows = not is_elf64
            mut str_lit_counter := 0 as i32
            emit_function_binary(&emitter, fn_name, final_insts.data, final_insts.len, alloc_res.allocs, &frame, is_windows, pool, &str_lit_counter, self_link)
            
            // Align every function entry to 16 bytes (M6). This is a MEASUREMENT FIX, not a
            // speed optimization, and it is important not to confuse the two -- it does not
            // make code faster and can leave a given build slightly slower than a lucky
            // unaligned placement.
            //
            // Without it a function's address depends on the exact byte length of every
            // function emitted before it, so an unrelated change elsewhere silently moves hot
            // code onto a different alignment. Peephole 1e shortened two instructions inside
            // bundled runtime helpers (imul-imm32 -> shl), everything after them shifted 16
            // bytes, and fib -- whose own body was proven byte-identical -- read 5% slower.
            // The same effect produced a phantom "xorshift +4.6%" on 2026-07-29f.
            //
            // MEASURED, on fib, best-of-9, four alternating pairs each:
            //     unaligned:  1e costs  +5.1%   (+3.4 .. +7.3, same sign every pair)
            //     aligned:    1e costs  -0.2%   (-0.84 .. +0.51, straddling zero)
            // So the sensitivity is real and this removes it.
            //
            // âš ï¸ THE FIRST EVALUATION OF THIS CHANGE CONCLUDED "benefit zero" AND REVERTED IT.
            // That compared aligned-with-1e against UNALIGNED-with-1e -- alignment's effect on
            // a single build. The point of the change is to make DIFFERENT builds comparable,
            // so the experiment had to be run on the DELTA between two builds, which is the
            // table above. Judging a determinism fix by whether one number improved is the
            // wrong yardstick.
            //
            // Honest cost: fib now reads ~605 ms deterministically, against 580 for the lucky
            // unaligned placement and 609 for the unlucky one -- so it lands near the middle of
            // a spread it used to sample at random. A consequence worth stating: fib's earlier
            // 1.13x, which passed the 15% M6-codegen gate, was that lottery coming up well. The
            // deterministic figure is ~1.18x, and it MISSES. Better to know that than to keep a
            // number that is right one run in three.
            //
            // Safe by construction: the padding goes in BEFORE current_offset is captured, so
            // every symbol value and every per-function relocation (rebased by info.offset
            // later) already accounts for it. The bytes are 0x90 and sit between functions,
            // which are only ever entered at their recorded symbol -- nothing falls through
            // into them, since each function's last instruction is a ret.
            while (all_code.len % 16 as i64) != 0 as i64:
                push_byte(&all_code, 0x90 as u8)
            let current_offset = all_code.len as u32
            push_bytes(&all_code, emitter.code.data, emitter.code.len)
            
            push_compiled_func_info(&func_infos, CompiledFuncInfo(
                name: fn_name,
                offset: current_offset,
                size: emitter.code.len as u32,
                is_global: true,
                relocs: emitter.relocs
            ))
            
            @free(cs_regs)
            @free(alloc_res.allocs)
            if intervals.data != null as ptr[LiveInterval]:
                @free(intervals.data as ptr[u8])
            if mach_insts.data != null as ptr[MachInst]:
                @free(mach_insts.data as ptr[u8])
            if final_insts.data != null as ptr[MachInst]:
                @free(final_insts.data as ptr[u8])
                
            if emitter.code.data != null as ptr[u8]:
                @free(emitter.code.data)
            if emitter.labels.keys != null as ptr[u32]:
                @free(emitter.labels.keys as ptr[u8])
            if emitter.labels.values != null as ptr[i64]:
                @free(emitter.labels.values as ptr[u8])
            if emitter.fixups.data != null as ptr[Fixup]:
                @free(emitter.fixups.data as ptr[u8])
            func_done_count = func_done_count + 1

        fi = fi + 1

    // Reported AFTER emission, deliberately. Function COUNTS are the cheap number
    // and the misleading one: what RFC 0031 is actually buying is .text bytes, and
    // the two are not proportional â€” the ten runtime-ABI shims and their transitive
    // closure are string machinery, among the largest functions in the bundle. Sum
    // the real emitted sizes rather than inferring the win from a ratio.
    if dfe_rep:
        dfe_report_bytes(mod, symbols, pool, table, &func_infos, dfe_reach)
        if dfe_prune:
            ax_printf_local("[dfe] pruned %d functions\n",
                dfe_pruned, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            fflush(null as ptr[void])
    if dfe_reach != null as ptr[bool]:
        @free(dfe_reach as ptr[u8])

    // Append identity variant constructors for sum types (Ok, Err, Some, None)
    let ok_offset = all_code.len as u32
    // mov rax, rcx -> 48 89 c8
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    // ret -> c3
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Ok",
        offset: ok_offset,
        size: 4 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_Err legacy stub: pointer-layout Err tag â€” mov rax, rcx; or rax, 1; ret.
    // (Normal Err(...) calls are lowered inline by air_builder; this only covers
    // any stray direct call so the tag bit is still observable by is_err.)
    let err_offset = all_code.len as u32
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x83 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0x01 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Err",
        offset: err_offset,
        size: 8 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    let some_offset = all_code.len as u32
    push_byte(&all_code, 0x48 as u8)
    push_byte(&all_code, 0x89 as u8)
    push_byte(&all_code, 0xC8 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_Some",
        offset: some_offset,
        size: 4 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_None: pointer-layout None is the null pointer â€” xor eax, eax; ret.
    let none_offset = all_code.len as u32
    push_byte(&all_code, 0x31 as u8)
    push_byte(&all_code, 0xC0 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_None",
        offset: none_offset,
        size: 3 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // ax_sum_layout_is_pointer: the native backend implements the pointer-layout
    // sum representation (boxed payload, tag bit 0 on Err), matching the C
    // backend built with -DAXIOM_SUMLAYOUT_POINTER. Defining it locally returns
    // TRUE deterministically instead of importing from ax_runtime.dll (which was
    // built without the define and returns FALSE) â€” mov eax, 1; ret.
    let sum_layout_offset = all_code.len as u32
    push_byte(&all_code, 0xB8 as u8)
    push_byte(&all_code, 0x01 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0x00 as u8)
    push_byte(&all_code, 0xC3 as u8)
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_sum_layout_is_pointer",
        offset: sum_layout_offset,
        size: 6 as u32,
        is_global: true,
        relocs: new_relocation_vec()
    ))

    // Append ax_block_size alias jumping to ax_str_slice
    let block_size_offset = all_code.len as u32
    // jmp near relative -> E9 00 00 00 00
    push_byte(&all_code, 0xE9 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)
    push_byte(&all_code, 0 as u8)

    mut block_size_relocs := new_relocation_vec()
    push_reloc(&block_size_relocs, Relocation(
        offset: 1 as i64,
        kind: 0 as u8, // RELOC_PC32
        padding1: 0 as u8,
        padding2: 0 as u16,
        sym_name: 4294967266 as u32, // -30 as i64 represented as u32
        addend: -4 as i64
    ))
    push_compiled_func_info(&func_infos, CompiledFuncInfo(
        name: "ax_block_size",
        offset: block_size_offset,
        size: 5 as u32,
        is_global: true,
        relocs: block_size_relocs
    ))
        
    let text_sec_idx = 1 as i32
    mut i := 0 as i64
    while i < func_infos.len:
        let info = &func_infos.data[i]
        if is_elf64:
            push_elf64_sym(&elf_syms, ELF64Sym(name_str: info.name, value: info.offset as u64, size: info.size as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: text_sec_idx as u16))
        else:
            push_coff_symbol(&coff_syms, COFFSymbol(name_str: info.name, value: info.offset, section_num: text_sec_idx as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
        i = i + 1
        
    // RFC 0017 / BUG#82: emit module-level global storage into a writable .data section
    // (COFF section 3 / ELF section header index 3 â€” the layouts agree by design). Each global's constant-folded init
    // bytes go into `data_buf` at a naturally-aligned offset; a defined data symbol
    // (named via the same x86_resolve_sym_name the OP_GLOBAL_ADDR reloc resolves through)
    // is registered here, BEFORE the sym-map pre-pass, so the reloc binds to it.
    mut data_buf := new_byte_vec()
    // RFC 0030 P3: a global whose image bytes are all zero (`init_lo == 0` â€” an
    // uninitialized declaration, a runtime-initialized aggregate, or a folded constant that
    // happens to be 0) carries no information in the file. Route those to a `.bss` section
    // that reserves address space without occupying bytes.
    //
    // Gated on a 4096-byte total so that small programs keep producing a byte-identical
    // 3-section object â€” that is what keeps the fixpoint argument trivial, and it avoids
    // paying a section header to save a handful of bytes.
    //
    // COFF only for now; the ELF path still emits every global into `.data` (P4). Splitting
    // per format keeps a red gate attributable to one emitter.
    mut bss_total := 0 as i64
    mut init_globals := 0 as i64
    mut gz := 0 as i64
    while gz < mod.globals.len:
        let gzg = mod.globals.data[gz]
        if gzg.init_lo == 0 as i64:
            mut zsz := gzg.size as i64
            if zsz < 1 as i64:
                zsz = 1 as i64
            bss_total = bss_total + zsz
        else:
            init_globals = init_globals + 1 as i64
        gz = gz + 1
    let use_bss = bss_total >= 4096 as i64
    mut bss_size := 0 as i64
    // COFF symbols name their section by 1-based INDEX, and `.data` is emitted only when
    // it has content. So when every global is zero-initialized there IS no `.data` and
    // `.bss` lands at index 3, not 4. Deciding the number here â€” from whether any global
    // will stay in `.data` â€” keeps the symbols consistent with the section table in both
    // shapes; hardcoding 4 silently mislabels every symbol in the all-zero-globals case.
    mut bss_secnum := 3 as i16
    if use_bss and init_globals > 0 as i64:
        bss_secnum = 4 as i16
    // RFC 0030 P4: the ELF object uses a FIXED 8-section layout with `.bss` appended at
    // index 7 (indices 4-6 are referenced by hardcoded sh_link values, so it cannot be
    // inserted after `.data`). The COFF number above is positional; the ELF one is not.
    if is_elf64:
        bss_secnum = 7 as i16
    mut gi := 0 as i64
    while gi < mod.globals.len:
        let g = mod.globals.data[gi]
        mut gsize := g.size as i64
        if gsize < 1 as i64:
            gsize = 1 as i64
        // Align to the global's natural ALIGNMENT, not to its SIZE. The original
        // `data_buf.len % gsize` padded up to a multiple of the whole object, which for a
        // large global rounds the section up to a second full copy of it: a `[i64; 200000]`
        // (1.6 MB) preceded by any other global padded `.data` to 1.6 MB and then wrote
        // 1.6 MB more, so the section â€” and the linked executable â€” carried 3.2 MB for
        // 1.6 MB of storage. Alignment never needs to exceed 16 bytes on x86-64.
        mut gsz32 := 0 as u32
        mut galign32 := 0 as u32
        type_size_and_align(table, g.type_id, &gsz32, &galign32)
        mut galign := galign32 as i64
        if galign < 1 as i64:
            galign = 1 as i64
        if galign > 16 as i64:
            galign = 16 as i64
        let gname = x86_resolve_sym_name(g.sym_id, symbols, pool, table)
        if use_bss and g.init_lo == 0 as i64:
            // .bss (COFF section 4): reserve aligned address space, emit no bytes.
            while (bss_size % galign) != 0 as i64:
                bss_size = bss_size + 1 as i64
            let boff = bss_size as u32
            bss_size = bss_size + gsize
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: gname, value: boff as u64, size: gsize as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: bss_secnum as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: gname, value: boff, section_num: bss_secnum, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        else:
            while (data_buf.len % galign) != 0 as i64:
                push_byte(&data_buf, 0 as u8)
            let goff = data_buf.len as u32
            mut b := 0 as i64
            while b < gsize:
                push_byte(&data_buf, ((g.init_lo >> (b * 8 as i64)) & 0xFF as i64) as u8)
                b = b + 1
            if is_elf64:
                push_elf64_sym(&elf_syms, ELF64Sym(name_str: gname, value: goff as u64, size: gsize as u64, binding: STB_GLOBAL, sym_type: STT_OBJECT, section: 3 as u16))
            else:
                push_coff_symbol(&coff_syms, COFFSymbol(name_str: gname, value: goff, section_num: 3 as i16, sym_type: 0 as u16, storage_class: IMAGE_SYM_CLASS_STATIC, num_aux: 0 as u8))
        gi = gi + 1

    ax_printf_local("[codegen] all funcs done: %d bytes code, building reloc table...\n",
        all_code.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])

    mut coff_relocs := new_coff_reloc_vec()
    mut elf_relocs := new_relocation_vec()

    // Build O(1) symbol nameâ†’index map using intern pool IDs.
    // The previous O(n) linear search per relocation made this O(n^2) total.
    let sym_map_size = pool.state.count + 65536 as i64
    let coff_sym_map = @alloc(sym_map_size * 4) as ptr[i32]
    @memset(coff_sym_map as ptr[void], 0xff as u8, sym_map_size * 4)
    let elf_sym_map = @alloc(sym_map_size * 4) as ptr[i32]
    @memset(elf_sym_map as ptr[void], 0xff as u8, sym_map_size * 4)

    mut pre_i := 0 as i64
    while pre_i < coff_syms.len:
        let sn = coff_syms.data[pre_i].name_str
        let sid = pool.intern_string(sn)
        if (sid as i64) < sym_map_size:
            coff_sym_map[sid as i64] = pre_i as i32
        pre_i = pre_i + 1

    pre_i = 0 as i64
    while pre_i < elf_syms.len:
        let sn = elf_syms.data[pre_i].name_str
        let sid = pool.intern_string(sn)
        if (sid as i64) < sym_map_size:
            // ELF .symtab has a NULL entry at index 0, so elf_syms[i] lands at symtab
            // index i+1. Relocations carry SYMTAB indices â€” store the +1 form (the
            // on-demand path below already does). Storing the raw i made every reloc
            // to a defined symbol resolve one symbol off (latent: never exercised).
            elf_sym_map[sid as i64] = pre_i as i32 + 1 as i32
        pre_i = pre_i + 1

    mut total_relocs := 0 as i64
    i = 0
    while i < func_infos.len:
        let info = &func_infos.data[i]
        let func_offset = info.offset

        mut r_i := 0 as i64
        while r_i < info.relocs.len:
            let r = info.relocs.data[r_i]
            mut sym_idx := r.sym_name as i64
            let limit: i64 = 4026531840
            if sym_idx > limit:
                sym_idx = sym_idx - (1 as i64 << 32)
            let target_name = resolve_binary_sym_name(sym_idx, info.name, symbols, pool, table)
            total_relocs = total_relocs + 1

            let target_id = pool.intern_string(target_name)
            mut target_sym_idx := -1 as i32
            if (target_id as i64) < sym_map_size:
                if is_elf64:
                    target_sym_idx = elf_sym_map[target_id as i64]
                else:
                    target_sym_idx = coff_sym_map[target_id as i64]

            if is_elf64:
                if target_sym_idx == -1 as i32:
                    let new_idx = elf_syms.len as i32 + 1 as i32
                    push_elf64_sym(&elf_syms, ELF64Sym(name_str: target_name, value: 0 as u64, size: 0 as u64, binding: STB_GLOBAL, sym_type: STT_FUNC, section: 0 as u16))
                    target_sym_idx = new_idx
                    if (target_id as i64) < sym_map_size:
                        elf_sym_map[target_id as i64] = new_idx
            else:
                if target_sym_idx == -1 as i32:
                    let new_idx = coff_syms.len as i32
                    push_coff_symbol(&coff_syms, COFFSymbol(name_str: target_name, value: 0 as u32, section_num: 0 as i16, sym_type: 0x20 as u16, storage_class: IMAGE_SYM_CLASS_EXTERNAL, num_aux: 0 as u8))
                    target_sym_idx = new_idx
                    if (target_id as i64) < sym_map_size:
                        coff_sym_map[target_id as i64] = new_idx
                    
            let reloc_offset = func_offset + r.offset as u32
            if is_elf64:
                push_reloc(&elf_relocs, Relocation(offset: reloc_offset as i64, kind: r.kind, padding1: 0 as u8, padding2: 0 as u16, sym_name: target_sym_idx as u32, addend: r.addend))
            else:
                mut reloc_type := IMAGE_REL_AMD64_REL32
                if r.kind == RELOC_ABS64:
                    reloc_type = IMAGE_REL_AMD64_ADDR64
                    let val = r.addend
                    all_code.data[reloc_offset as i64 + 0] = (val & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 1] = ((val >> 8 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 2] = ((val >> 16 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 3] = ((val >> 24 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 4] = ((val >> 32 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 5] = ((val >> 40 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 6] = ((val >> 48 as i64) & 0xFF as i64) as u8
                    all_code.data[reloc_offset as i64 + 7] = ((val >> 56 as i64) & 0xFF as i64) as u8
                else:
                    mut val := (r.addend + 4) as i32
                    all_code.data[reloc_offset as i64 + 0] = (val & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 1] = ((val >> 8 as i32) & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 2] = ((val >> 16 as i32) & 0xFF as i32) as u8
                    all_code.data[reloc_offset as i64 + 3] = ((val >> 24 as i32) & 0xFF as i32) as u8
                push_coff_reloc(&coff_relocs, COFFReloc(virt_addr: reloc_offset, sym_table_idx: target_sym_idx as u32, reloc_type: reloc_type))
                
            r_i = r_i + 1
        i = i + 1

    ax_printf_local("[codegen] reloc table done: %d relocs, %d syms, writing object...\n",
        total_relocs, coff_syms.len as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    @free(coff_sym_map as ptr[u8])
    @free(elf_sym_map as ptr[u8])

    mut success := false
    if is_elf64:
        success = elf64_write_object_file(output_obj_file, &all_code, &rdata_buf, &data_buf, bss_size, &elf_relocs, &elf_syms)
    else:
        success = coff_write_object_file(output_obj_file, &all_code, &rdata_buf, &data_buf, bss_size, &coff_relocs, &coff_syms)

    if all_code.data != null as ptr[u8]:
        @free(all_code.data)
    if rdata_buf.data != null as ptr[u8]:
        @free(rdata_buf.data)
    if data_buf.data != null as ptr[u8]:
        @free(data_buf.data)
    if str_keys.data != null as ptr[u32]:
        @free(str_keys.data as ptr[u8])
    if str_offsets.data != null as ptr[u32]:
        @free(str_offsets.data as ptr[u8])
        
    i = 0
    while i < func_infos.len:
        let info = &func_infos.data[i]
        if info.relocs.data != null as ptr[Relocation]:
            @free(info.relocs.data as ptr[u8])
        i = i + 1
    if func_infos.data != null as ptr[CompiledFuncInfo]:
        @free(func_infos.data as ptr[u8])
        
    if coff_syms.data != null as ptr[COFFSymbol]:
        @free(coff_syms.data as ptr[u8])
    if coff_relocs.data != null as ptr[COFFReloc]:
        @free(coff_relocs.data as ptr[u8])
        
    if elf_syms.data != null as ptr[ELF64Sym]:
        @free(elf_syms.data as ptr[u8])
    if elf_relocs.data != null as ptr[Relocation]:
        @free(elf_relocs.data as ptr[u8])
        
    return success

// bootstrap/stage1/linker.ax
// Custom self-hosted ELF64 & PE/COFF relocations resolver and segment merger.


extern "C" fn fopen(filename: ptr[void], mode: ptr[u8]) -> ptr[void]
extern "C" fn fread(buffer: ptr[void], size: i64, count: i64, stream: ptr[void]) -> i64
extern "C" fn fclose(stream: ptr[void]) -> i32
extern "C" fn fseek(stream: ptr[void], offset: i64, origin: i32) -> i32
extern "C" fn ftell(stream: ptr[void]) -> i64
extern "C" fn rewind(stream: ptr[void])

pub fn x86_slice_to_str(data: ptr[u8], len: i64) -> str:
    let buf = @alloc(len + 1) as ptr[u8]
    @memcpy(buf, data, len)
    buf[len] = 0 as u8
    return buf as str

// --------------------------------------------------------------------------
// Basic Binary Decoding & Encoding Helpers
// --------------------------------------------------------------------------

pub fn read_u16_le(data: ptr[u8], off: i64) -> u16:
    let b0 = data[off] as u16
    let b1 = data[off + 1] as u16
    return b0 | (b1 << 8 as u16)

// BUG#20: the native backend miscompiles an OR-chain of 3+ shifted operands
// (e.g. `b0 | (b1<<8) | (b2<<16) | (b3<<24)`) under register pressure â€” the b0/b1
// terms come back wrong (verified at -O0 and -O1; the 2-operand read_u16_le is
// fine, a single-accumulator form is fine). This corrupted every COFF field read
// at self-link time -> empty symbol names -> "Unresolved external symbol ''".
// Rewrite as a single-accumulator fold (low register pressure) which compiles
// correctly. (Root fix belongs in the selector/regalloc for wide OR trees.)
pub fn read_u32_le(data: ptr[u8], off: i64) -> u32:
    mut r := data[off] as u32
    r = r | ((data[off + 1] as u32) << 8 as u32)
    r = r | ((data[off + 2] as u32) << 16 as u32)
    r = r | ((data[off + 3] as u32) << 24 as u32)
    return r

pub fn read_u64_le(data: ptr[u8], off: i64) -> u64:
    mut r := data[off] as u64
    r = r | ((data[off + 1] as u64) << 8 as u64)
    r = r | ((data[off + 2] as u64) << 16 as u64)
    r = r | ((data[off + 3] as u64) << 24 as u64)
    r = r | ((data[off + 4] as u64) << 32 as u64)
    r = r | ((data[off + 5] as u64) << 40 as u64)
    r = r | ((data[off + 6] as u64) << 48 as u64)
    r = r | ((data[off + 7] as u64) << 56 as u64)
    return r

pub fn write_u32_le(data: ptr[u8], off: i64, val: u32):
    data[off] = (val & 0xFF as u32) as u8
    data[off + 1] = ((val >> 8 as u32) & 0xFF as u32) as u8
    data[off + 2] = ((val >> 16 as u32) & 0xFF as u32) as u8
    data[off + 3] = ((val >> 24 as u32) & 0xFF as u32) as u8

pub fn write_u64_le(data: ptr[u8], off: i64, val: u64):
    data[off] = (val & 0xFF as u64) as u8
    data[off + 1] = ((val >> 8 as u64) & 0xFF as u64) as u8
    data[off + 2] = ((val >> 16 as u64) & 0xFF as u64) as u8
    data[off + 3] = ((val >> 24 as u64) & 0xFF as u64) as u8
    data[off + 4] = ((val >> 32 as u64) & 0xFF as u64) as u8
    data[off + 5] = ((val >> 40 as u64) & 0xFF as u64) as u8
    data[off + 6] = ((val >> 48 as u64) & 0xFF as u64) as u8
    data[off + 7] = ((val >> 56 as u64) & 0xFF as u64) as u8
// --------------------------------------------------------------------------
// Linker Structures and Dynamic Vectors
// --------------------------------------------------------------------------

pub struct LinkerSymbol:
    pub name: str
    pub section: i64
    pub offset: u64
    pub size: u64
    pub defined: bool

pub struct LinkerSymbolVec:
    pub data: ptr[LinkerSymbol]
    pub len: i64
    pub cap: i64

pub fn new_linker_symbol_vec() -> LinkerSymbolVec:
    return LinkerSymbolVec(data: null as ptr[LinkerSymbol], len: 0, cap: 0)

pub fn push_linker_symbol(mut self: ptr[LinkerSymbolVec], s: LinkerSymbol):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 48) as ptr[LinkerSymbol]
        if self.data != null as ptr[LinkerSymbol]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 48)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = s
    self.len = self.len + 1

pub struct ParsedReloc:
    pub offset: i64
    pub sym_idx: u32
    pub is_pc: bool
    pub addend: i64

pub struct ParsedRelocVec:
    pub data: ptr[ParsedReloc]
    pub len: i64
    pub cap: i64

pub fn new_parsed_reloc_vec() -> ParsedRelocVec:
    return ParsedRelocVec(data: null as ptr[ParsedReloc], len: 0, cap: 0)

pub fn push_parsed_reloc(mut self: ptr[ParsedRelocVec], r: ParsedReloc):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[ParsedReloc]
        if self.data != null as ptr[ParsedReloc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = r
    self.len = self.len + 1

pub struct LinkerStrVec:
    pub data: ptr[str]
    pub len: i64
    pub cap: i64

pub fn new_linker_str_vec() -> LinkerStrVec:
    return LinkerStrVec(data: null as ptr[str], len: 0, cap: 0)

pub fn push_linker_str(mut self: ptr[LinkerStrVec], s: str):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 16) as ptr[str]
        if self.data != null as ptr[str]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 16)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = s
    self.len = self.len + 1

pub struct ParsedObject:
    pub text: ByteVec
    pub rdata: ByteVec
    pub symbols: LinkerSymbolVec
    pub sym_names: LinkerStrVec
    pub relocs: ParsedRelocVec
    pub va: u64
    // RFC 0017 / BUG#82: writable module-level global storage (COFF section 3). `data_va`
    // is the image virtual address assigned to this object's data block during layout.
    pub data: ByteVec
    pub data_va: u64
    // RFC 0030 P3: zero-initialized global storage (`.bss`, logical section 4). There is no
    // byte vector â€” the whole point is that these bytes are absent from the file. Only the
    // EXTENT travels, and the image reserves it as virtual-only space that the loader zeroes.
    pub bss_size: i64
    pub bss_va: u64

pub struct ParsedObjectPtrVec:
    pub data: ptr[ptr[ParsedObject]]
    pub len: i64
    pub cap: i64

pub fn new_parsed_object_ptr_vec() -> ParsedObjectPtrVec:
    return ParsedObjectPtrVec(data: null as ptr[ptr[ParsedObject]], len: 0, cap: 0)

pub fn push_parsed_object_ptr(mut self: ptr[ParsedObjectPtrVec], p: ptr[ParsedObject]):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 8) as ptr[ptr[ParsedObject]]
        if self.data != null as ptr[ptr[ParsedObject]]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 8)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = p
    self.len = self.len + 1

// --------------------------------------------------------------------------
// ELF64 parser
// --------------------------------------------------------------------------

pub fn linker_parse_elf(data: ptr[u8], data_len: i64) -> ptr[ParsedObject]:
    let shoff = read_u64_le(data, 40) as i64
    let shnum = read_u16_le(data, 60) as i64

    mut text_off := 0 as i64
    mut text_size := 0 as i64

    // RFC 0017 ELF globals: .rodata (string literals) and writable .data (module
    // globals) are SHT_PROGBITS too â€” route by sh_flags (EXECINSTR -> .text,
    // WRITE -> .data, neither -> .rodata) instead of "last PROGBITS wins".
    mut rodata_off := 0 as i64
    mut rodata_size := 0 as i64
    mut gdata_off := 0 as i64
    mut gdata_size := 0 as i64
    mut text_hdr_idx := -1 as i64
    mut rodata_hdr_idx := -1 as i64
    mut gdata_hdr_idx := -1 as i64

    mut symtab_off := 0 as i64
    mut symtab_size := 0 as i64

    mut strtab_off := 0 as i64
    mut strtab_size := 0 as i64

    mut rela_off := 0 as i64
    mut rela_size := 0 as i64

    // RFC 0030 P4: .bss (SHT_NOBITS). Tracked by header index so its symbols can be
    // remapped to the LOGICAL section 4, the same normalisation the COFF path does â€” the
    // physical index differs between the two emitters (7 for ELF, 3 or 4 for COFF).
    mut elf_bss_size := 0 as i64
    mut elf_bss_hdr_idx := -1 as i64

    mut i := 0 as i64
    while i < shnum:
        let off = shoff + i * 64
        let sh_type = read_u32_le(data, off + 4)
        let sh_flags = read_u64_le(data, off + 8)
        let sh_offset = read_u64_le(data, off + 24) as i64
        let sh_size = read_u64_le(data, off + 32) as i64

        if sh_type == 1 as u32: // SHT_PROGBITS
            if (sh_flags & 4 as u64) != 0 as u64: // SHF_EXECINSTR -> .text
                text_off = sh_offset
                text_size = sh_size
                text_hdr_idx = i
            elif (sh_flags & 1 as u64) != 0 as u64: // SHF_WRITE -> .data (globals)
                gdata_off = sh_offset
                gdata_size = sh_size
                gdata_hdr_idx = i
            else: // read-only, non-exec -> .rodata (string literals)
                rodata_off = sh_offset
                rodata_size = sh_size
                rodata_hdr_idx = i
        elif sh_type == 2 as u32: // SHT_SYMTAB
            symtab_off = sh_offset
            symtab_size = sh_size
        elif sh_type == 3 as u32: // SHT_STRTAB
            strtab_off = sh_offset
            strtab_size = sh_size
        elif sh_type == 4 as u32: // SHT_RELA
            rela_off = sh_offset
            rela_size = sh_size
        elif sh_type == 8 as u32: // SHT_NOBITS -> .bss (RFC 0030 P4)
            // No file bytes: sh_size is the extent to reserve, sh_offset is meaningless.
            elf_bss_size = sh_size
            elf_bss_hdr_idx = i
        i = i + 1
        
    mut sym_names := new_linker_str_vec()
    if symtab_size > 0:
        let num_syms = symtab_size / 24
        mut sym_i := 0 as i64
        while sym_i < num_syms:
            let off = symtab_off + sym_i * 24
            let name_offset = read_u32_le(data, off) as i64
            
            mut name_str := ""
            if name_offset < strtab_size:
                let str_ptr = (data as i64 + strtab_off + name_offset) as ptr[u8]
                let max_len = strtab_size - name_offset
                mut char_len := 0 as i64
                while char_len < max_len and str_ptr[char_len] != 0 as u8:
                    char_len = char_len + 1
                name_str = x86_slice_to_str(str_ptr, char_len)
            push_linker_str(&sym_names, name_str)
            sym_i = sym_i + 1
            
    mut symbols := new_linker_symbol_vec()
    if symtab_size > 0:
        let num_syms = symtab_size / 24
        mut sym_i := 1 as i64 // skip first NULL symbol
        while sym_i < num_syms:
            let off = symtab_off + sym_i * 24
            let sec_idx = read_u16_le(data, off + 6)
            let val64 = read_u64_le(data, off + 8)
            let size = read_u64_le(data, off + 16)

            let name = sym_names.data[sym_i]
            let is_defined = sec_idx != 0 as u16

            // Normalize ELF section-header indices to the linker's canonical scheme
            // (1=.text, 2=.rodata/.rdata, 3=.data) so all downstream `section == N`
            // logic is format-agnostic. (The AXIOM ELF writer emits exactly this
            // layout already; the remap keeps foreign objects working too.)
            mut mapped_sec := sec_idx as i64
            if sec_idx as i64 == text_hdr_idx:
                mapped_sec = 1 as i64
            elif sec_idx as i64 == rodata_hdr_idx:
                mapped_sec = 2 as i64
            elif elf_bss_hdr_idx >= 0 as i64 and sec_idx as i64 == elf_bss_hdr_idx:
                mapped_sec = 4 as i64
            elif sec_idx as i64 == gdata_hdr_idx:
                mapped_sec = 3 as i64

            push_linker_symbol(&symbols, LinkerSymbol(
                name: name,
                section: mapped_sec,
                offset: val64,
                size: size,
                defined: is_defined
            ))
            sym_i = sym_i + 1
            
    mut relocs := new_parsed_reloc_vec()
    if rela_size > 0:
        let num_relocs = rela_size / 24
        mut rel_i := 0 as i64
        while rel_i < num_relocs:
            let off = rela_off + rel_i * 24
            let r_offset = read_u64_le(data, off) as i64
            let r_info = read_u64_le(data, off + 8)
            let r_addend = read_u64_le(data, off + 16) as i64
            
            let sym_idx = (r_info >> 32 as u64) as u32
            let r_type = (r_info & 0xFFFFFFFF as u64) as u32
            let is_pc = r_type == 2 as u32 or r_type == 4 as u32 // PC32 or PLT32
            
            push_parsed_reloc(&relocs, ParsedReloc(
                offset: r_offset,
                sym_idx: sym_idx,
                is_pc: is_pc,
                addend: r_addend
            ))
            rel_i = rel_i + 1
            
    mut text_vec := new_byte_vec()
    if text_size > 0:
        push_bytes(&text_vec, (data as i64 + text_off) as ptr[u8], text_size)

    // .rodata rides along exactly like COFF .rdata: the merge appends it right after
    // .text, and section-2 symbols resolve at text.len + offset.
    mut rodata_vec := new_byte_vec()
    if rodata_size > 0:
        push_bytes(&rodata_vec, (data as i64 + rodata_off) as ptr[u8], rodata_size)

    // RFC 0017 ELF globals: writable .data content; placed by the ELF exe emitter.
    mut gdata_vec := new_byte_vec()
    if gdata_size > 0:
        push_bytes(&gdata_vec, (data as i64 + gdata_off) as ptr[u8], gdata_size)

    let obj = @alloc(@compiler_intrinsic("size_of")[ParsedObject]()) as ptr[ParsedObject]
    obj.text = text_vec
    obj.rdata = rodata_vec
    obj.symbols = symbols
    obj.sym_names = sym_names
    obj.relocs = relocs
    obj.va = 0 as u64
    obj.data = gdata_vec
    obj.data_va = 0 as u64
    // RFC 0030 P4 will populate these from SHT_NOBITS; zeroed for now so the ELF path is
    // unchanged and the field is never read uninitialised.
    obj.bss_size = elf_bss_size
    obj.bss_va = 0 as u64
    return obj

// --------------------------------------------------------------------------
// PE/COFF parser
// --------------------------------------------------------------------------

pub fn linker_parse_coff(data: ptr[u8], data_len: i64) -> ptr[ParsedObject]:
    let num_sections = read_u16_le(data, 2) as i64
    let symtab_off = read_u32_le(data, 8) as i64
    let sym_count = read_u32_le(data, 12) as i64
    
    mut text_off := 0 as i64
    mut text_size := 0 as i64
    mut relocs_off := 0 as i64
    mut num_relocs := 0 as i64
    
    mut rdata_off := 0 as i64
    mut rdata_size := 0 as i64

    // RFC 0017 / BUG#82: optional writable .data section (module-level globals).
    mut data_sec_off := 0 as i64
    mut data_sec_size := 0 as i64
    // RFC 0030 P3: `.bss` extent and its 1-based COFF section number. The number is needed
    // because `.bss` is index 4 when `.data` exists but index 3 when every global is
    // zero-initialized, so symbols must be remapped by the header they actually name
    // rather than by a hardcoded constant.
    mut bss_sec_size := 0 as i64
    mut bss_hdr_num := 0 as i64

    mut i := 0 as i64
    while i < num_sections:
        let off = 20 + i * 40

        // Read section name (first 8 bytes)
        mut is_text := false
        if data[off] == '.' as u8 and data[off + 1] == 't' as u8 and data[off + 2] == 'e' as u8 and data[off + 3] == 'x' as u8 and data[off + 4] == 't' as u8:
            is_text = true

        mut is_rdata := false
        if data[off] == '.' as u8 and data[off + 1] == 'r' as u8 and data[off + 2] == 'd' as u8 and data[off + 3] == 'a' as u8 and data[off + 4] == 't' as u8 and data[off + 5] == 'a' as u8:
            is_rdata = true

        // `.data` (writable globals). Distinguished from `.rdata` by the leading char.
        mut is_data := false
        if data[off] == '.' as u8 and data[off + 1] == 'd' as u8 and data[off + 2] == 'a' as u8 and data[off + 3] == 't' as u8 and data[off + 4] == 'a' as u8 and data[off + 5] == 0 as u8:
            is_data = true

        // RFC 0030 P3: `.bss` â€” zero-initialized globals. Its SizeOfRawData is 0 by
        // construction, so the extent must be read from VirtualSize (+8) rather than the
        // +16 field every other section here uses.
        mut is_bss := false
        if data[off] == '.' as u8 and data[off + 1] == 'b' as u8 and data[off + 2] == 's' as u8 and data[off + 3] == 's' as u8 and data[off + 4] == 0 as u8:
            is_bss = true

        if is_text:
            text_size = read_u32_le(data, off + 16) as i64
            text_off = read_u32_le(data, off + 20) as i64
            relocs_off = read_u32_le(data, off + 24) as i64
            num_relocs = read_u16_le(data, off + 32) as i64
        elif is_rdata:
            rdata_size = read_u32_le(data, off + 16) as i64
            rdata_off = read_u32_le(data, off + 20) as i64
        elif is_data:
            data_sec_size = read_u32_le(data, off + 16) as i64
            data_sec_off = read_u32_le(data, off + 20) as i64
        elif is_bss:
            bss_sec_size = read_u32_le(data, off + 8) as i64
            bss_hdr_num = (i + 1 as i64) as i64 // COFF section numbers are 1-based

        i = i + 1
        
    let strtab_off = symtab_off + sym_count * 18
    let strtab_size = data_len - strtab_off
    
    mut sym_names := new_linker_str_vec()
    mut symbols := new_linker_symbol_vec()
    
    mut sym_i := 0 as i64
    while sym_i < sym_count:
        let off = symtab_off + sym_i * 18
        mut name_str := ""
        
        let first4 = read_u32_le(data, off)
        if first4 == 0 as u32:
            let str_off = read_u32_le(data, off + 4) as i64
            if str_off < strtab_size:
                let str_ptr = (data as i64 + strtab_off + str_off) as ptr[u8]
                let max_len = strtab_size - str_off
                mut char_len := 0 as i64
                while char_len < max_len and str_ptr[char_len] != 0 as u8:
                    char_len = char_len + 1
                name_str = x86_slice_to_str(str_ptr, char_len)
        else:
            let name_ptr = (data as i64 + off) as ptr[u8]
            mut char_len := 0 as i64
            while char_len < 8 and name_ptr[char_len] != 0 as u8:
                char_len = char_len + 1
            name_str = x86_slice_to_str(name_ptr, char_len)
            
        let val = read_u32_le(data, off + 8)
        let sec_num = read_u16_le(data, off + 12) as i16
        let aux_count = data[off + 17]
        
        let is_def_sym = sec_num > 0 as i16
        if name_str == "ax_pathbuf_new" or name_str == "ax_parse_proc_cmdline" or name_str == "ax_Ok" or name_str == "ax_Err" or name_str == "ax_Some" or name_str == "ax_get_global_state_internal" or name_str == "ax_SEGMENT_SIZE" or name_str == "ax_pathbuf_new" or name_str == "ax_parse_proc_cmdline":
            let name_nt = x86_str_to_null_terminated(name_str)
            ax_printf_local("[Debug Linker Parse Symbol] name=%s, sec_num=%d, offset=%d, defined=%d\n", name_nt as i64, sec_num as i64, val as i64, is_def_sym as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            @free(name_nt)

        push_linker_str(&sym_names, name_str)
        // BUG#21: lower_struct_constructor_call (native air_builder) assigns
        // named args POSITIONALLY, ignoring field names. Omitting `size` here
        // made `defined` land in the `size` slot and left `defined` zeroed ->
        // every parsed symbol read as undefined -> defined funcs never entered
        // func_names -> "Unresolved external symbol" for all internal calls.
        // List ALL fields in declaration order so positional lowering is correct.
        // RFC 0030 P3: normalise `.bss` to the LOGICAL section 4 regardless of the index it
        // occupies in this object, so every downstream `section == 4` test is stable. The
        // other three already coincide with their logical numbers (.text 1, .rdata 2,
        // .data 3), so this is the identity for them.
        mut mapped_sec_num := sec_num as i64
        if bss_hdr_num > 0 as i64 and mapped_sec_num == bss_hdr_num:
            mapped_sec_num = 4 as i64

        push_linker_symbol(&symbols, LinkerSymbol(
            name: name_str,
            section: mapped_sec_num,
            offset: val as u64,
            size: 0 as u64,
            defined: is_def_sym
        ))

        sym_i = sym_i + 1
        
        mut k := 0 as u8
        while k < aux_count:
            push_linker_str(&sym_names, "")
            push_linker_symbol(&symbols, LinkerSymbol(name: "", section: 0, offset: 0 as u64, size: 0 as u64, defined: false))
            sym_i = sym_i + 1
            k = k + 1 as u8
            
    mut relocs := new_parsed_reloc_vec()
    mut rel_idx := 0 as i64
    while rel_idx < num_relocs:
        let off = relocs_off + rel_idx * 10
        let virt_addr = read_u32_le(data, off) as i64
        let sym_idx = read_u32_le(data, off + 4)
        let rel_type = read_u16_le(data, off + 8)
        
        let is_pc = rel_type == 4 as u16 // IMAGE_REL_AMD64_REL32
        mut addend := 0 as i64
        if is_pc:
            addend = -4 as i64
            
        push_parsed_reloc(&relocs, ParsedReloc(
            offset: virt_addr,
            sym_idx: sym_idx,
            is_pc: is_pc,
            addend: addend
        ))
        rel_idx = rel_idx + 1
        
    mut text_vec := new_byte_vec()
    if text_size > 0:
        push_bytes(&text_vec, (data as i64 + text_off) as ptr[u8], text_size)
        
    mut rdata_vec := new_byte_vec()
    if rdata_size > 0:
        push_bytes(&rdata_vec, (data as i64 + rdata_off) as ptr[u8], rdata_size)

    mut data_vec := new_byte_vec()
    if data_sec_size > 0:
        push_bytes(&data_vec, (data as i64 + data_sec_off) as ptr[u8], data_sec_size)

    let obj = @alloc(@compiler_intrinsic("size_of")[ParsedObject]()) as ptr[ParsedObject]
    obj.text = text_vec
    obj.rdata = rdata_vec
    obj.symbols = symbols
    obj.sym_names = sym_names
    obj.relocs = relocs
    obj.va = 0 as u64
    obj.data = data_vec
    obj.data_va = 0 as u64
    obj.bss_size = bss_sec_size
    obj.bss_va = 0 as u64
    return obj

// --------------------------------------------------------------------------
// Unified Linker Implementation
// --------------------------------------------------------------------------

// RFC 0009: per-DLL import bucket for user `extern "C" from "x.dll"` symbols.
// Built-in DLLs (kernel32/ax_runtime/ucrtbase) keep their dedicated code path;
// user DLLs are handled additively via a vector of these buckets.
pub struct UserDllBucket:
    pub name: str            // DLL filename, e.g. "anylib.dll"
    pub imports: LinkerStrVec // imported symbol names
    pub iat_offset: i64      // offset within idata_buf (computed during layout)
    pub ilt_offset: i64
    pub name_offset: i64
    pub hn_rvas: ptr[u32]    // hint-name RVAs, one per import

pub struct UserDllBucketVec:
    pub data: ptr[UserDllBucket]
    pub len: i64
    pub cap: i64

pub fn new_user_dll_bucket_vec() -> UserDllBucketVec:
    return UserDllBucketVec(data: null as ptr[UserDllBucket], len: 0, cap: 0)

pub fn push_user_dll_bucket(mut self: ptr[UserDllBucketVec], b: UserDllBucket):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let esize = @compiler_intrinsic("size_of")[UserDllBucket]()
        let new_data = @alloc(new_cap * esize) as ptr[UserDllBucket]
        if self.data != null as ptr[UserDllBucket]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * esize)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = b
    self.len = self.len + 1

// Find the bucket index for dll_name, creating a new empty bucket if absent.
pub fn user_bucket_find_or_add(mut buckets: ptr[UserDllBucketVec], dll_name: str) -> i64:
    mut i := 0 as i64
    while i < buckets.len:
        if buckets.data[i].name == dll_name:
            return i
        i = i + 1
    push_user_dll_bucket(buckets, UserDllBucket(name: dll_name, imports: new_linker_str_vec(), iat_offset: 0, ilt_offset: 0, name_offset: 0, hn_rvas: null as ptr[u32]))
    return buckets.len - 1

pub struct AxiomLinker:
    pub input_files: LinkerStrVec
    pub output_path: str
    // RFC 0009: parallel arrays mapping a user extern symbol name -> its DLL name.
    pub user_dll_syms: LinkerStrVec
    pub user_dll_names: LinkerStrVec
    // RFC 0009 P2: clean names of #[export] functions + DLL (--shared) mode.
    pub export_names: LinkerStrVec
    pub is_shared: bool

pub fn new_axiom_linker() -> AxiomLinker:
    return AxiomLinker(input_files: new_linker_str_vec(), output_path: "", user_dll_syms: new_linker_str_vec(), user_dll_names: new_linker_str_vec(), export_names: new_linker_str_vec(), is_shared: false)


pub fn align_byte_vec(vec: ptr[ByteVec], alignment: i64):
    while vec.len % alignment != 0:
        push_byte(vec, 0 as u8)

// LINK-TIME COLLISION DIAGNOSTIC (Â§8 â€” diagnostics are a product feature).
//
// Every symbol lookup in this linker is a LINEAR FIRST-MATCH scan over func_names
// (see the reloc resolution loops). So when two objects both DEFINE the same emitted
// name, the first one parsed wins and the second definition is silently discarded â€”
// calls meant for it are bound to the other body. That is the mechanism behind the
// whole cross-library name-collision family: a user `fn worker` colliding with a
// bundled `struct worker`'s emitted symbol mis-links with no message at all.
//
// Detection is exact (two DEFINED text symbols with byte-identical emitted names),
// not heuristic. Report-only for now: promoting it to a hard error is safe only once
// we know no legitimate duplicate definitions exist on the normal build paths, which
// this report is what establishes. Capped so a systemic break cannot flood the build.
//
// Cost is O(n^2) string compares, which is immaterial next to the reloc resolution
// this runs beside â€” that is O(relocs x names), an order of magnitude more work.
pub fn report_duplicate_definitions(func_names: ptr[LinkerStrVec]) -> i64:
    mut dups := 0 as i64
    mut a := 0 as i64
    while a < func_names.len:
        let na = func_names.data[a]
        if na != "":
            mut b := a + 1 as i64
            while b < func_names.len:
                if func_names.data[b] == na:
                    dups = dups + 1 as i64
                    if dups <= 10 as i64:
                        ax_puts_local("warning[E0501]: symbol defined more than once at link time; the first definition wins and the rest are silently dropped:")
                        ax_puts_local(na)
                    break
                b = b + 1 as i64
        a = a + 1 as i64
    return dups

pub fn is_valid_symbol_name(name: str) -> bool:
    let len = std.string.len(name)
    if len == 0:
        return false
    let ptr = get_str_ptr(name)
    mut idx := 0 as i64
    while idx < len:
        let c = ptr[idx]
        if c <= 32 as u8 or c >= 127 as u8:
            return false
        idx = idx + 1
    return true

pub fn is_valid_runtime_dll_symbol(name: str) -> bool:
    if (name == "__ax_runtime_init" or name == "__ax_runtime_shutdown" or
        name == "ax___ax_runtime_init" or name == "ax___ax_runtime_shutdown" or
        name == "ax_actor_spawn" or name == "ax_actor_step" or
        name == "ax_actor_is_running" or name == "ax_actor_has_messages" or
        name == "ax_str_eq" or name == "ax_str_len" or
        name == "ax_str_concat" or name == "ax_str_replace" or
        name == "ax_str_slice" or name == "ax_str_char_count" or
        name == "ax_str_contains" or name == "ax_str_ends_with" or
        name == "ax_str_index_of" or name == "ax_str_starts_with" or
        name == "ax_str_trim" or name == "ax_free" or
        name == "ax_alloc" or name == "ax_realloc" or
        name == "ax_println_str" or name == "ax_println_i64" or
        name == "ax_println_f64" or name == "ax_println_bool" or
        name == "ax_print_str" or name == "ax_print_i64" or
        name == "ax_print_f64" or name == "ax_print_bool" or
        name == "ax_assert_axiom" or name == "ax_panic" or
        name == "ax_time_now_ns" or name == "ax_timer_after" or
        name == "ax_scheduler_stats" or name == "ax_scheduler_submit" or
        name == "ax_scheduler_init" or name == "ax_scheduler_run" or
        name == "ax_scheduler_shutdown" or name == "ax_compiler_intrinsic" or
        name == "ax_get_global_state_internal" or name == "ax_str_parse_i64" or
        name == "ax_str_parse_f64" or name == "ax_sum_layout_is_pointer" or
        name == "ax_actor_stop" or name == "ax_actor_ref_to_u64" or
        name == "ax_i64_to_str"):
        return true
    return false

pub fn get_dll_for_symbol(name: str) -> str:
    if (name == "steals_attempted" or name == "steals_succeeded" or name == "tasks_executed" or
        name == "running" or name == "head" or name == "total_executed" or
        name == "worker_count" or name == "total_submitted" or name == "total_steals" or
        name == "alloc" or name == "q" or name == "msg" or name == "actor" or name == "SEGMENT_MAGIC" or
        name == "ax_steals_attempted" or name == "ax_steals_succeeded" or name == "ax_tasks_executed" or
        name == "ax_running" or name == "ax_head" or name == "ax_total_executed" or
        name == "ax_worker_count" or name == "ax_total_submitted" or name == "ax_total_steals" or
        name == "ax_q" or name == "ax_msg" or name == "ax_actor" or name == "ax_total_executed" or name == "ax_SEGMENT_MAGIC" or
        name == "syscall"):
        return "none"

    if (name == "VirtualAlloc" or name == "VirtualFree" or name == "ExitProcess" or name == "TerminateProcess" or 
        name == "GetLastError" or name == "GetStdHandle" or name == "WriteFile" or
        name == "CreateFileA" or name == "ReadFile" or name == "CloseHandle" or
        name == "CreateDirectoryA" or name == "RemoveDirectoryA" or name == "DeleteFileA" or
        name == "MoveFileA" or name == "CopyFileA" or name == "GetFileAttributesA" or
        name == "GetCommandLineA" or name == "GetEnvironmentVariableA" or name == "SetEnvironmentVariableA" or
        name == "GetCommandLineW" or
        // RFC 0033 timer/thread (kernel32, not ucrtbase): Sleep + monotonic clock + threads.
        name == "Sleep" or name == "QueryPerformanceCounter" or name == "QueryPerformanceFrequency" or
        name == "GetSystemTimeAsFileTime" or name == "CreateThread" or name == "WaitForSingleObject"):
        return "kernel32.dll"
        
    let ptr = get_str_ptr(name)
    let len = std.string.len(name)
    if len >= 3 and ptr[0] == 'a' as u8 and ptr[1] == 'x' as u8 and ptr[2] == '_' as u8:
        if is_valid_runtime_dll_symbol(name):
            return "ax_runtime.dll"
        return "none"
    if len >= 5 and ptr[0] == '_' as u8 and ptr[1] == '_' as u8 and ptr[2] == 'a' as u8 and ptr[3] == 'x' as u8 and ptr[4] == '_' as u8:
        if is_valid_runtime_dll_symbol(name):
            return "ax_runtime.dll"
        return "none"
        
    return "ucrtbase.dll"

pub fn add_unique_import(imports: ptr[LinkerStrVec], name: str):
    mut found := false
    mut i := 0 as i64
    while i < imports.len:
        if imports.data[i] == name:
            found = true
            break
        i = i + 1
    if not found:
        push_linker_str(imports, name)

// RFC 0009: return the user-declared DLL for `name` (from `extern "C" from`),
// or "" if the symbol has no explicit binding (falls back to whitelist).
pub fn user_dll_for_symbol(self: ptr[AxiomLinker], name: str) -> str:
    mut i := 0 as i64
    while i < self.user_dll_syms.len:
        if self.user_dll_syms.data[i] == name:
            return self.user_dll_names.data[i]
        i = i + 1
    return ""

pub fn write_buf_u32_le(data: ptr[u8], off: i64, val: u32):
    data[off] = (val & 0xFF as u32) as u8
    data[off + 1] = ((val >> 8 as u32) & 0xFF as u32) as u8
    data[off + 2] = ((val >> 16 as u32) & 0xFF as u32) as u8
    data[off + 3] = ((val >> 24 as u32) & 0xFF as u32) as u8

pub fn write_buf_u64_le(data: ptr[u8], off: i64, val: u64):
    write_buf_u32_le(data, off, (val & 0xFFFFFFFF as u64) as u32)
    write_buf_u32_le(data, off + 4, ((val >> 32 as u64) & 0xFFFFFFFF as u64) as u32)

pub fn linker_build_pe_headers(
    out: ptr[ByteVec],
    code_raw_size: u32,
    idata_raw_size: u32,
    entry_rva: u32,
    idata_rva: u32,
    idata_size: u32,
    iat_rva: u32,
    iat_size: u32,
    export_rva: u32,      // RFC 0009 P2: .edata RVA (0 = no export section)
    export_size: u32,     // export directory virtual size (data dir 0)
    edata_raw_size: u32,  // file-aligned .edata size (0 = EXE, byte-identical path)
    edata_file_off: u32,  // .edata PointerToRawData
    is_dll: bool,         // set IMAGE_FILE_DLL characteristic
    idata_virt_size: u32  // RFC 0030: writable-region VirtualSize incl. the .bss tail
):
    // RFC 0009 P2: when edata_raw_size == 0 this function is byte-identical to the
    // original 2-section EXE emitter; export params only take effect for --shared.
    mut num_sections := 2 as u16
    if edata_raw_size > 0 as u32:
        num_sections = 3 as u16
    mut coff_chars := 0x0026 as u16
    if is_dll:
        coff_chars = 0x2026 as u16 // + IMAGE_FILE_DLL (0x2000)
    // 1. DOS Header
    push_byte(out, 0x4D as u8) // 'M'
    push_byte(out, 0x5A as u8) // 'Z'
    mut i := 2 as i64
    while i < 0x3C:
        push_byte(out, 0 as u8)
        i = i + 1
    push_u32_le(out, 0x80 as u32) // e_lfanew
    i = 0x40
    while i < 0x80:
        push_byte(out, 0 as u8)
        i = i + 1
        
    // 2. PE Signature
    push_byte(out, 0x50 as u8) // 'P'
    push_byte(out, 0x45 as u8) // 'E'
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    
    // 3. COFF File Header
    push_u16_le(out, 0x8664 as u16) // Machine (AMD64)
    push_u16_le(out, num_sections) // NumberOfSections (2 EXE / 3 DLL)
    push_u32_le(out, 0 as u32) // TimeDateStamp
    push_u32_le(out, 0 as u32) // PointerToSymbolTable
    push_u32_le(out, 0 as u32) // NumberOfSymbols
    push_u16_le(out, 240 as u16) // SizeOfOptionalHeader
    push_u16_le(out, coff_chars) // Characteristics (+IMAGE_FILE_DLL for --shared)
    
    // 4. Optional Header (PE32+)
    push_u16_le(out, 0x020B as u16) // Magic
    push_byte(out, 1 as u8) // MajorLinkerVersion
    push_byte(out, 0 as u8) // MinorLinkerVersion
    push_u32_le(out, code_raw_size) // SizeOfCode
    push_u32_le(out, idata_raw_size) // SizeOfInitializedData
    mut uninit_size := 0 as u32
    if idata_virt_size > idata_raw_size:
        uninit_size = idata_virt_size - idata_raw_size
    push_u32_le(out, uninit_size) // SizeOfUninitializedData (RFC 0030)
    push_u32_le(out, entry_rva) // AddressOfEntryPoint
    push_u32_le(out, 0x1000 as u32) // BaseOfCode
    push_u64_le(out, 0x140000000 as u64) // ImageBase
    push_u32_le(out, 0x1000 as u32) // SectionAlignment
    push_u32_le(out, 0x200 as u32) // FileAlignment
    push_u16_le(out, 6 as u16) // MajorOperatingSystemVersion
    push_u16_le(out, 0 as u16) // MinorOperatingSystemVersion
    push_u16_le(out, 0 as u16) // MajorImageVersion
    push_u16_le(out, 0 as u16) // MinorImageVersion
    push_u16_le(out, 6 as u16) // MajorSubsystemVersion
    push_u16_le(out, 0 as u16) // MinorSubsystemVersion
    push_u32_le(out, 0 as u32) // Win32VersionValue
    
    mut last_sec_end := idata_rva + idata_virt_size
    if edata_raw_size > 0 as u32:
        last_sec_end = export_rva + edata_raw_size
    let size_of_image = (last_sec_end + 0xFFF as u32) & (0xFFFFF000 as u32)
    push_u32_le(out, size_of_image) // SizeOfImage
    push_u32_le(out, 0x400 as u32) // SizeOfHeaders
    push_u32_le(out, 0 as u32) // CheckSum
    push_u16_le(out, 3 as u16) // Subsystem (Console)
    push_u16_le(out, 0x0160 as u16) // DllCharacteristics
    push_u64_le(out, 0x1000000 as u64) // SizeOfStackReserve (16MB) â€” BUG#28: 1MB
                                       // overflowed when stage2 typechecks the
                                       // full compiler (deep recursion); stage1
                                       // had 2MB. 16MB gives ample headroom.
    push_u64_le(out, 0x1000 as u64) // SizeOfStackCommit (OS auto-grows to reserve)
    push_u64_le(out, 0x100000 as u64) // SizeOfHeapReserve
    push_u64_le(out, 0x1000 as u64) // SizeOfHeapCommit
    push_u32_le(out, 0 as u32) // LoaderFlags
    push_u32_le(out, 16 as u32) // NumberOfRvaAndSizes
    
    // Data Directories
    // Dir 0: Export (RFC 0009 P2 â€” only for --shared; 0/0 for EXE)
    push_u32_le(out, export_rva)
    push_u32_le(out, export_size)
    // Dir 1: Import
    push_u32_le(out, idata_rva)
    push_u32_le(out, idata_size)
    // Dir 2 to 11 (10 entries = 80 bytes)
    mut dir_i := 2 as i64
    while dir_i < 12:
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        dir_i = dir_i + 1
    // Dir 12: IAT
    push_u32_le(out, iat_rva)
    push_u32_le(out, iat_size)
    // Dir 13 to 15 (3 entries = 24 bytes)
    dir_i = 13
    while dir_i < 16:
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        dir_i = dir_i + 1
        
    // 5. Section Headers
    // Section 1: .text
    push_byte(out, '.' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 'e' as u8)
    push_byte(out, 'x' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_u32_le(out, code_raw_size) // VirtualSize
    push_u32_le(out, 0x1000 as u32) // VirtualAddress
    push_u32_le(out, code_raw_size) // SizeOfRawData
    push_u32_le(out, 0x400 as u32) // PointerToRawData
    push_u32_le(out, 0 as u32) // PointerToRelocations
    push_u32_le(out, 0 as u32) // PointerToLinenumbers
    push_u16_le(out, 0 as u16) // NumberOfRelocations
    push_u16_le(out, 0 as u16) // NumberOfLinenumbers
    push_u32_le(out, 0x60000020 as u32) // Characteristics
    
    // Section 2: .idata
    push_byte(out, '.' as u8)
    push_byte(out, 'i' as u8)
    push_byte(out, 'd' as u8)
    push_byte(out, 'a' as u8)
    push_byte(out, 't' as u8)
    push_byte(out, 'a' as u8)
    push_byte(out, 0 as u8)
    push_byte(out, 0 as u8)
    push_u32_le(out, idata_virt_size) // VirtualSize (RFC 0030: includes the zero-filled .bss tail)
    push_u32_le(out, idata_rva) // VirtualAddress
    push_u32_le(out, idata_raw_size) // SizeOfRawData (file bytes only)
    push_u32_le(out, 0x400 as u32 + code_raw_size) // PointerToRawData
    push_u32_le(out, 0 as u32)
    push_u32_le(out, 0 as u32)
    push_u16_le(out, 0 as u16)
    push_u16_le(out, 0 as u16)
    push_u32_le(out, 0xC0000040 as u32) // Characteristics

    // Section 3: .edata (RFC 0009 P2 â€” only when exporting)
    if edata_raw_size > 0 as u32:
        push_byte(out, '.' as u8)
        push_byte(out, 'e' as u8)
        push_byte(out, 'd' as u8)
        push_byte(out, 'a' as u8)
        push_byte(out, 't' as u8)
        push_byte(out, 'a' as u8)
        push_byte(out, 0 as u8)
        push_byte(out, 0 as u8)
        push_u32_le(out, export_size) // VirtualSize
        push_u32_le(out, export_rva) // VirtualAddress
        push_u32_le(out, edata_raw_size) // SizeOfRawData
        push_u32_le(out, edata_file_off) // PointerToRawData
        push_u32_le(out, 0 as u32)
        push_u32_le(out, 0 as u32)
        push_u16_le(out, 0 as u16)
        push_u16_le(out, 0 as u16)
        push_u32_le(out, 0x40000040 as u32) // Characteristics: init data, read-only

    align_byte_vec(out, 0x400 as i64)

pub fn linker_build_elf_headers(out: ptr[ByteVec], code_raw_size: u32, entry_va: u64, dynamic_offset: u32, dynamic_size: u32, bss_extent: u32, is_shared: bool):
    // 1. e_ident
    push_byte(out, 0x7F as u8)
    push_byte(out, 'E' as u8)
    push_byte(out, 'L' as u8)
    push_byte(out, 'F' as u8)
    push_byte(out, 2 as u8) // ELFCLASS64
    push_byte(out, 1 as u8) // ELFDATA2LSB
    push_byte(out, 1 as u8) // EV_CURRENT
    push_byte(out, 0 as u8) // ELFOSABI_NONE
    mut i := 8 as i64
    while i < 16:
        push_byte(out, 0 as u8)
        i = i + 1
        
    // 2. Type, Machine, Version
    // RFC 0032 P1: a --shared object must be ET_DYN (3) so ld.so/dlopen relocates it to an
    // arbitrary base. All AXIOM codegen is already RIP-relative (globals/func-addr = lea
    // [rip+disp32], calls = rel32), so the image is position-independent as emitted; only the
    // container type changes. An ET_EXEC .so is refused by dlopen ("cannot dynamically load
    // executable"). The executable path (is_shared=false) stays ET_EXEC â€” byte-identical.
    mut e_type := 2 as u16 // ET_EXEC
    if is_shared:
        e_type = 3 as u16 // ET_DYN
    push_u16_le(out, e_type)
    push_u16_le(out, 62 as u16) // EM_X86_64
    push_u32_le(out, 1 as u32) // EV_CURRENT
    
    // 3. Entry point virtual address
    push_u64_le(out, entry_va)
    
    // 4. Program header offset
    push_u64_le(out, 64 as u64) // immediately follows ELF header
    
    // 5. Section header offset
    push_u64_le(out, 0 as u64) // no section headers
    
    if dynamic_size > 0:
        // 6. Flags, Header Sizes
        push_u32_le(out, 0 as u32) // e_flags
        push_u16_le(out, 64 as u16) // e_ehsize
        push_u16_le(out, 56 as u16) // e_phentsize
        push_u16_le(out, 3 as u16) // e_phnum (3 program headers)
        push_u16_le(out, 0 as u16) // e_shentsize
        push_u16_le(out, 0 as u16) // e_shnum
        push_u16_le(out, 0 as u16) // e_shstrndx
        
        // 7. Program Header Table
        // PHDR 1: PT_INTERP for an executable; PT_GNU_STACK for a --shared object (RFC 0032 P1).
        // A dlopen'd .so does NOT use an interpreter (the loader is already running), and a
        // shared object with NO PT_GNU_STACK is assumed by glibc to require an EXECUTABLE stack â€”
        // it then tries to remap the stack RWX, which modern kernels refuse:
        //   "cannot enable executable stack as shared object requires: Invalid argument".
        // Emitting PT_GNU_STACK with PF_R|PF_W (6, non-exec) declares a non-executable stack and
        // lets dlopen succeed. Keeping the slot count at 3 preserves the 512-byte header layout
        // (the interp string region below just stays zero padding for a .so).
        if is_shared:
            push_u32_le(out, 0x6474e551 as u32) // p_type: PT_GNU_STACK
            push_u32_le(out, 6 as u32) // p_flags: PF_R | PF_W (non-executable stack)
            push_u64_le(out, 0 as u64) // p_offset
            push_u64_le(out, 0 as u64) // p_vaddr
            push_u64_le(out, 0 as u64) // p_paddr
            push_u64_le(out, 0 as u64) // p_filesz
            push_u64_le(out, 0 as u64) // p_memsz
            push_u64_le(out, 0x10 as u64) // p_align
        else:
            push_u32_le(out, 3 as u32) // p_type: PT_INTERP
            push_u32_le(out, 4 as u32) // p_flags: PF_R
            push_u64_le(out, 232 as u64) // p_offset: starts immediately after PHDRs (64 + 3*56 = 232)
            push_u64_le(out, 0x400000 as u64 + 232 as u64) // p_vaddr
            push_u64_le(out, 0x400000 as u64 + 232 as u64) // p_paddr
            push_u64_le(out, 28 as u64) // p_filesz: "/lib64/ld-linux-x86-64.so.2\0" is 28 bytes
            push_u64_le(out, 28 as u64) // p_memsz
            push_u64_le(out, 1 as u64) // p_align

        // PHDR 2: PT_LOAD
        push_u32_le(out, 1 as u32) // p_type: PT_LOAD
        push_u32_le(out, 7 as u32) // p_flags: PF_R | PF_W | PF_X
        push_u64_le(out, 0 as u64) // p_offset: starts at beginning of file
        push_u64_le(out, 0x400000 as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64) // p_paddr
        push_u64_le(out, 512 as u64 + code_raw_size as u64) // p_filesz
        push_u64_le(out, 512 as u64 + code_raw_size as u64 + bss_extent as u64) // p_memsz (RFC 0030 P4)
        push_u64_le(out, 4096 as u64) // p_align
        
        // PHDR 3: PT_DYNAMIC
        push_u32_le(out, 2 as u32) // p_type: PT_DYNAMIC
        push_u32_le(out, 6 as u32) // p_flags: PF_R | PF_W
        push_u64_le(out, dynamic_offset as u64) // p_offset
        push_u64_le(out, 0x400000 as u64 + dynamic_offset as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64 + dynamic_offset as u64) // p_paddr
        push_u64_le(out, dynamic_size as u64) // p_filesz
        push_u64_le(out, dynamic_size as u64) // p_memsz
        push_u64_le(out, 8 as u64) // p_align
        
        // Write the interpreter path at offset 232
        let interp_str = "/lib64/ld-linux-x86-64.so.2" as ptr[u8]
        mut c_i := 0 as i64
        while c_i < 27:
            push_byte(out, interp_str[c_i])
            c_i = c_i + 1
        push_byte(out, 0 as u8) // null-terminate
        
        align_byte_vec(out, 512 as i64)
    else:
        // 6. Flags, Header Sizes
        push_u32_le(out, 0 as u32) // e_flags
        push_u16_le(out, 64 as u16) // e_ehsize
        push_u16_le(out, 56 as u16) // e_phentsize
        push_u16_le(out, 1 as u16) // e_phnum (1 PT_LOAD segment)
        push_u16_le(out, 0 as u16) // e_shentsize
        push_u16_le(out, 0 as u16) // e_shnum
        push_u16_le(out, 0 as u16) // e_shstrndx
        
        // 7. Program Header Table (1 entry: PT_LOAD segment)
        push_u32_le(out, 1 as u32) // p_type: PT_LOAD
        // PF_R | PF_W | PF_X: the RFC 0017 globals region (writable .data) lives inside
        // this single LOAD segment, so it must be writable. (Splitting into separate
        // RX/RW segments is a follow-up refinement; the dynamic case below is RWX too.)
        push_u32_le(out, 7 as u32) // p_flags: PF_R | PF_W | PF_X
        push_u64_le(out, 0 as u64) // p_offset: starts at beginning of file
        push_u64_le(out, 0x400000 as u64) // p_vaddr
        push_u64_le(out, 0x400000 as u64) // p_paddr
        push_u64_le(out, 128 as u64 + code_raw_size as u64) // p_filesz: maps entire executable file!
        // RFC 0030 P4: p_memsz exceeds p_filesz by the .bss extent; the kernel supplies
        // zero pages for the difference. Equal when bss_extent is 0, so unchanged output.
        push_u64_le(out, 128 as u64 + code_raw_size as u64 + bss_extent as u64) // p_memsz
        push_u64_le(out, 0x1000 as u64) // p_align
        
        align_byte_vec(out, 128 as i64)

pub fn axiom_linker_add_input(mut self: ptr[AxiomLinker], file: str):
    push_linker_str(&self.input_files, file)

// RFC 0009 P2: byte-wise lexicographic string ordering (PE export name table
// must be sorted so the loader's binary search resolves imports).
pub fn linker_str_less(a: str, b: str) -> bool:
    let la = std.string.len(a)
    let lb = std.string.len(b)
    let pa = get_str_ptr(a)
    let pb = get_str_ptr(b)
    mut n := la
    if lb < la:
        n = lb
    mut i := 0 as i64
    while i < n:
        if pa[i] != pb[i]:
            return pa[i] < pb[i]
        i = i + 1
    return la < lb

// Return the filename portion of a path (after the last '/' or '\\').
pub fn linker_basename(path: str) -> str:
    let len = std.string.len(path)
    let p = get_str_ptr(path)
    mut start := 0 as i64
    mut i := 0 as i64
    while i < len:
        if p[i] == '/' as u8 or p[i] == 92 as u8: // '\\'
            start = i + 1
        i = i + 1
    return alloc_str_from_raw((p as i64 + start) as ptr[u8], len - start)

// RFC 0009 P2: build a PE .edata (IMAGE_EXPORT_DIRECTORY + EAT + name-pointer +
// ordinal tables + strings). export_names are sorted in place. Each export "foo"
// resolves to the defined symbol "ax_foo" (AXIOM's uniform mangling prefix).
pub fn build_export_edata(export_names: ptr[LinkerStrVec], func_names: ptr[LinkerStrVec], func_offsets: ptr[ParsedRelocVec], edata_rva: u32, dll_name: str, out: ptr[ByteVec]):
    let n = export_names.len
    // 1. Insertion-sort names lexicographically (in place)
    mut a := 1 as i64
    while a < n:
        let key = export_names.data[a]
        mut b := a - 1
        while b >= 0 and linker_str_less(key, export_names.data[b]):
            export_names.data[b + 1] = export_names.data[b]
            b = b - 1
        export_names.data[b + 1] = key
        a = a + 1

    // 2. Layout offsets within .edata
    let eat_off = 40 as i64
    let enpt_off = eat_off + n * 4
    let ord_off = enpt_off + n * 4
    let str_off = ord_off + n * 2

    // 3. Build string blob: DLL name first, then each export name
    mut strbuf := new_byte_vec()
    let dll_name_rva = (edata_rva as i64 + str_off) as u32
    let dnp = get_str_ptr(dll_name)
    let dnl = std.string.len(dll_name)
    mut ci := 0 as i64
    while ci < dnl:
        push_byte(&strbuf, dnp[ci])
        ci = ci + 1
    push_byte(&strbuf, 0 as u8)

    let name_rvas = @alloc(n * 4) as ptr[u32]
    mut k := 0 as i64
    while k < n:
        name_rvas[k] = (edata_rva as i64 + str_off + strbuf.len) as u32
        let nm = export_names.data[k]
        let np = get_str_ptr(nm)
        let nl = std.string.len(nm)
        mut c2 := 0 as i64
        while c2 < nl:
            push_byte(&strbuf, np[c2])
            c2 = c2 + 1
        push_byte(&strbuf, 0 as u8)
        k = k + 1

    // 4. Resolve each export to its defined-symbol RVA (mangled "ax_" + name)
    let eat_rvas = @alloc(n * 4) as ptr[u32]
    k = 0
    while k < n:
        let mangled = std.string.concat("ax_", export_names.data[k])
        mut rva := 0 as u32
        mut fi := 0 as i64
        while fi < func_names.len:
            if func_names.data[fi] == mangled:
                rva = (0x1000 as i64 + func_offsets.data[fi].offset) as u32
                break
            fi = fi + 1
        @free(get_str_ptr(mangled))
        eat_rvas[k] = rva
        k = k + 1

    // 5. Emit export directory table
    push_u32_le(out, 0 as u32) // ExportFlags
    push_u32_le(out, 0 as u32) // TimeDateStamp
    push_u16_le(out, 0 as u16) // MajorVersion
    push_u16_le(out, 0 as u16) // MinorVersion
    push_u32_le(out, dll_name_rva) // Name RVA
    push_u32_le(out, 1 as u32) // OrdinalBase
    push_u32_le(out, n as u32) // NumberOfFunctions
    push_u32_le(out, n as u32) // NumberOfNames
    push_u32_le(out, (edata_rva as i64 + eat_off) as u32) // EAT RVA
    push_u32_le(out, (edata_rva as i64 + enpt_off) as u32) // Name-pointer table RVA
    push_u32_le(out, (edata_rva as i64 + ord_off) as u32) // Ordinal table RVA

    k = 0
    while k < n:
        push_u32_le(out, eat_rvas[k]) // Export Address Table
        k = k + 1
    k = 0
    while k < n:
        push_u32_le(out, name_rvas[k]) // Name Pointer Table
        k = k + 1
    k = 0
    while k < n:
        push_u16_le(out, k as u16) // Ordinal Table (0-based into EAT)
        k = k + 1
    push_bytes(out, strbuf.data, strbuf.len)

    if strbuf.data != null as ptr[u8]:
        @free(strbuf.data)
    @free(name_rvas as ptr[u8])
    @free(eat_rvas as ptr[u8])

// RFC 0011 P1: static-library (`.lib`) writer â€” standard COFF `!<arch>` format.
pub fn push_u32_be(out: ptr[ByteVec], val: u32):
    push_byte(out, ((val >> 24 as u32) & 0xFF as u32) as u8)
    push_byte(out, ((val >> 16 as u32) & 0xFF as u32) as u8)
    push_byte(out, ((val >> 8 as u32) & 0xFF as u32) as u8)
    push_byte(out, (val & 0xFF as u32) as u8)

// Left-justified, space-padded ASCII field of exactly `width` bytes.
fn ar_field_str(out: ptr[ByteVec], s: str, width: i64):
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < width:
        if i < n:
            push_byte(out, p[i])
        else:
            push_byte(out, ' ' as u8)
        i = i + 1

// Decimal ASCII, left-justified, space-padded to `width` bytes.
fn ar_field_decimal(out: ptr[ByteVec], val: i64, width: i64):
    let buf = @alloc(24) as ptr[u8]
    mut m := val
    mut k := 0 as i64
    if m == 0:
        buf[0] = '0' as u8
        k = 1
    else:
        while m > 0:
            buf[k] = ('0' as u8) + (m % 10 as i64) as u8
            k = k + 1
            m = m / 10 as i64
    mut i := 0 as i64
    while i < width:
        if i < k:
            push_byte(out, buf[k - 1 - i])
        else:
            push_byte(out, ' ' as u8)
        i = i + 1
    @free(buf)

// A 60-byte `ar` member header.
fn ar_write_header(out: ptr[ByteVec], name: str, size: i64):
    ar_field_str(out, name, 16)     // Name (slash-terminated for COFF)
    ar_field_str(out, "0", 12)      // Date
    ar_field_str(out, "", 6)        // UID
    ar_field_str(out, "", 6)        // GID
    ar_field_str(out, "0", 8)       // Mode
    ar_field_decimal(out, size, 10) // Size
    push_byte(out, 0x60 as u8)      // end marker "`\n"
    push_byte(out, 0x0A as u8)

// RFC 0011 P4 (increment 2): append a raw string's bytes to a ByteVec.
fn iface_push_str(out: ptr[ByteVec], s: str):
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < n:
        push_byte(out, p[i])
        i = i + 1

// RFC 0011 P4 (increment 2): append a base-10 integer to a ByteVec.
fn iface_push_int(out: ptr[ByteVec], val: i64):
    if val == 0:
        push_byte(out, '0' as u8)
        return
    let buf = @alloc(24) as ptr[u8]
    mut m := val
    mut k := 0 as i64
    while m > 0:
        buf[k] = ('0' as u8) + (m % 10 as i64) as u8
        k = k + 1
        m = m / 10 as i64
    while k > 0:
        k = k - 1
        push_byte(out, buf[k])
    @free(buf)

// RFC 0011 P4 (increment 2): canonical, compilation-stable token for a type in the
// interface. Primitive TypeIDs are fixed constants (portable across builds); pointer /
// slice recurse; everything else (structs, generics, sums) is a "?" placeholder until a
// later increment teaches the interface to carry those declarations. The token must be
// derivable identically by producer and consumer from the same primitive-ID contract.
fn iface_type_token(types: ptr[TypeTable], type_id: u32, pool: ptr[InternPool]) -> str:
    if type_id == TYPE_I8:
        return "i8"
    if type_id == TYPE_I16:
        return "i16"
    if type_id == TYPE_I32:
        return "i32"
    if type_id == TYPE_I64:
        return "i64"
    if type_id == TYPE_U8:
        return "u8"
    if type_id == TYPE_U16:
        return "u16"
    if type_id == TYPE_U32:
        return "u32"
    if type_id == TYPE_U64:
        return "u64"
    if type_id == TYPE_F32:
        return "f32"
    if type_id == TYPE_F64:
        return "f64"
    if type_id == TYPE_BOOL:
        return "bool"
    if type_id == TYPE_STRING:
        return "string"
    if type_id == TYPE_CHAR8:
        return "char8"
    if type_id == TYPE_VOID:
        return "void"
    if type_id == TYPE_ISIZE:
        return "isize"
    if type_id == TYPE_USIZE:
        return "usize"
    if type_id == TYPE_UNKNOWN:
        return "?"
    if (type_id as i64) >= types.entries.len:
        return "?"
    let ekind = types.entries.data[type_id].kind
    if ekind == TYPE_KIND_POINTER:
        return "ptr"
    if ekind == TYPE_KIND_SLICE:
        return "slice"
    // RFC 0011 P4 inc4b: a struct type round-trips by NAME. The consumer re-registers the
    // struct (from its `S` line) and maps the name back to a type_id, so functions/consts
    // that reference the struct resolve exactly. Requires the pool to fetch the name.
    if ekind == TYPE_KIND_STRUCT and pool != null as ptr[InternPool]:
        let snid = types.entries.data[type_id].name_id
        if snid != 0 as u32:
            let sname = pool.get(snid)
            if std.string.len(sname) > 0:
                return sname
    return "?"

// RFC 0011 P4 (increment 2): serialize the public interface of a translation unit into
// the `__axiom_iface` text payload. One `F` line per public function:
//   F <name> <nparams> <p0> <p1> ... -> <ret>
// where each type is an `iface_type_token`. The linker symbol is `ax_<name>` (uniform
// mangling), so the consumer re-derives it â€” the interface stays source-level. Structs,
// consts, and generics are future increments; only functions appear today.
pub fn build_lib_iface_text(symtable: ptr[SymbolTable], pool: ptr[InternPool], types: ptr[TypeTable], tree: ptr[AstTree]) -> str:
    mut bv := new_byte_vec()
    iface_push_str(&bv, "AXIFACE1\n")
    // RFC 0011 P4 inc4b: emit `S <name> <nfields> <fname> <ftok> ...` for each public struct
    // whose fields are ALL primitive, BEFORE the F/C lines that may reference it by name. The
    // consumer recomputes size/align from the same fields, so the layout matches exactly.
    // Structs with pointer/nested-struct fields are a later slice (field-access typing needs
    // the pointee/struct, which the token drops today).
    mut ss := 0 as i64
    while ss < symtable.symbols.len:
        if symtable.symbols.data[ss].kind == SYM_STRUCT and (symtable.symbols.data[ss].flags & SYM_FLAG_PUB) != 0 as u16:
            let st_tid = symtable.symbols.data[ss].type_id
            if st_tid != 0 as u32 and (st_tid as i64) < types.entries.len and types.entries.data[st_tid].kind == TYPE_KIND_STRUCT:
                let s_extra = types.entries.data[st_tid].extra
                if (s_extra as i64) < types.structs.len:
                    let sinfo = &types.structs.data[s_extra]
                    mut all_prim := sinfo.fields.len > 0
                    mut fk := 0 as i64
                    while fk < sinfo.fields.len:
                        if iface_token_to_type(iface_type_token(types, sinfo.fields.data[fk].type_id, pool)) == TYPE_UNKNOWN:
                            all_prim = false
                        fk = fk + 1
                    if all_prim:
                        let st_name = pool.get(symtable.symbols.data[ss].name_id)
                        if std.string.len(st_name) > 0:
                            iface_push_str(&bv, "S ")
                            iface_push_str(&bv, st_name)
                            push_byte(&bv, ' ' as u8)
                            iface_push_int(&bv, sinfo.fields.len)
                            mut fm := 0 as i64
                            while fm < sinfo.fields.len:
                                push_byte(&bv, ' ' as u8)
                                iface_push_str(&bv, pool.get(sinfo.fields.data[fm].name_id))
                                push_byte(&bv, ' ' as u8)
                                iface_push_str(&bv, iface_type_token(types, sinfo.fields.data[fm].type_id, pool))
                                fm = fm + 1
                            push_byte(&bv, 0x0A as u8)
        ss = ss + 1
    mut si := 0 as i64
    while si < symtable.symbols.len:
        let sym_kind = symtable.symbols.data[si].kind
        let sym_flags = symtable.symbols.data[si].flags
        let sym_tid = symtable.symbols.data[si].type_id
        // RFC 0011 P4 inc4a: export a public integer const as `C <name> <type> <value>` so a
        // consumer can inline it without the library source. Only INT_LIT initializers of a
        // primitive-int type round-trip today (non-negative, <2^32); anything else is skipped.
        if sym_kind == SYM_CONST and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            let c_decl = symtable.symbols.data[si].decl_node
            let c_tok = iface_type_token(types, sym_tid, pool)
            if c_decl != 0 as u32 and (c_decl as i64) < tree.nodes.len and c_tok != "?":
                mut c_init := 0 as u32
                mut c_child := tree.nodes.data[c_decl as i64].first_child
                while c_child != 0 as u32 and (c_child as i64) < tree.nodes.len:
                    let ccn = tree.nodes.data[c_child as i64]
                    if ccn.kind != NODE_TYPE_EXPR and ccn.kind != NODE_GENERIC_TYPE:
                        c_init = c_child
                    c_child = ccn.next_sibling
                if c_init != 0 as u32 and tree.nodes.data[c_init as i64].kind == NODE_INT_LIT:
                    let c_tok_idx = tree.nodes.data[c_init as i64].token_idx
                    let c_ltok = tree.tokens.data[c_tok_idx as i64]
                    if c_ltok.len != 0 as u16:
                        let c_sp = ((get_str_ptr(tree.src)) as i64 + c_ltok.offset as i64) as ptr[u8]
                        let c_txt = alloc_str_from_raw(c_sp, c_ltok.len as i64)
                        let c_val = parse_int_from_str(c_txt)
                        @free(get_str_ptr(c_txt))
                        let c_name = pool.get(symtable.symbols.data[si].name_id)
                        if std.string.len(c_name) > 0:
                            iface_push_str(&bv, "C ")
                            iface_push_str(&bv, c_name)
                            push_byte(&bv, ' ' as u8)
                            iface_push_str(&bv, c_tok)
                            push_byte(&bv, ' ' as u8)
                            iface_push_int(&bv, c_val)
                            push_byte(&bv, 0x0A as u8)
        if sym_kind == SYM_FUNC and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            if (sym_tid as i64) < types.entries.len and types.entries.data[sym_tid].kind == TYPE_KIND_FUNC:
                let f_idx = types.entries.data[sym_tid].extra
                if (f_idx as i64) < types.funcs.len:
                    let fi = &types.funcs.data[f_idx]
                    let name = pool.get(symtable.symbols.data[si].name_id)
                    if std.string.len(name) > 0:
                        iface_push_str(&bv, "F ")
                        iface_push_str(&bv, name)
                        push_byte(&bv, ' ' as u8)
                        iface_push_int(&bv, fi.params.len)
                        mut pi := 0 as i64
                        while pi < fi.params.len:
                            push_byte(&bv, ' ' as u8)
                            iface_push_str(&bv, iface_type_token(types, fi.params.data[pi], pool))
                            pi = pi + 1
                        iface_push_str(&bv, " -> ")
                        iface_push_str(&bv, iface_type_token(types, fi.ret, pool))
                        push_byte(&bv, 0x0A as u8)
        si = si + 1
    return alloc_str_from_raw(bv.data, bv.len)

// RFC 0011 P4 (increment 3f): generate an FFI wrapper module for a produced DLL. For each
// `#[export]`ed function it emits `pub extern "C" from "<dll>" fn <name>(p0: T0, â€¦) -> T`,
// so a consumer `import`s ONE wrapper instead of hand-writing an extern per function. Types
// use the interface tokens (primitive sigs today). `dll_filename` is the bare DLL name used
// in the `from` clause (resolved by the OS loader at runtime). When `export_all` is true
// (a `library`-marked module) every pub fn is bound so the wrapper matches the DLL's full
// public API; otherwise only `#[export]`ed functions are bound (RFC 0009 P2 behavior).
pub fn build_dll_wrapper_text(symtable: ptr[SymbolTable], pool: ptr[InternPool], types: ptr[TypeTable], dll_filename: str, export_all: bool) -> str:
    mut bv := new_byte_vec()
    iface_push_str(&bv, "// Auto-generated FFI bindings for ")
    iface_push_str(&bv, dll_filename)
    iface_push_str(&bv, " (RFC 0011 P4). `import` this module to call the DLL by name.\n")
    mut si := 0 as i64
    while si < symtable.symbols.len:
        let sym_kind = symtable.symbols.data[si].kind
        let sym_flags = symtable.symbols.data[si].flags
        let sym_tid = symtable.symbols.data[si].type_id
        let sym_nid = symtable.symbols.data[si].name_id
        if sym_kind == SYM_FUNC and (sym_flags & SYM_FLAG_PUB) != 0 as u16 and sym_tid != 0 as u32:
            mut is_exp := export_all
            if not export_all:
                mut ek := 0 as i64
                while ek < symtable.export_syms.len:
                    if symtable.export_syms.data[ek] == sym_nid:
                        is_exp = true
                    ek = ek + 1
            if is_exp and (sym_tid as i64) < types.entries.len and types.entries.data[sym_tid].kind == TYPE_KIND_FUNC:
                let f_idx = types.entries.data[sym_tid].extra
                if (f_idx as i64) < types.funcs.len:
                    let fi = &types.funcs.data[f_idx]
                    let name = pool.get(sym_nid)
                    if std.string.len(name) > 0:
                        iface_push_str(&bv, "pub extern \"C\" from \"")
                        iface_push_str(&bv, dll_filename)
                        iface_push_str(&bv, "\" fn ")
                        iface_push_str(&bv, name)
                        push_byte(&bv, '(' as u8)
                        mut pi := 0 as i64
                        while pi < fi.params.len:
                            if pi > 0:
                                iface_push_str(&bv, ", ")
                            iface_push_str(&bv, "p")
                            iface_push_int(&bv, pi)
                            iface_push_str(&bv, ": ")
                            iface_push_str(&bv, iface_type_token(types, fi.params.data[pi], pool))
                            pi = pi + 1
                        push_byte(&bv, ')' as u8)
                        if fi.ret != TYPE_VOID:
                            iface_push_str(&bv, " -> ")
                            iface_push_str(&bv, iface_type_token(types, fi.ret, pool))
                        push_byte(&bv, 0x0A as u8)
        si = si + 1
    return alloc_str_from_raw(bv.data, bv.len)

// Wrap a compiled `.obj` into a single-member COFF archive with a first-linker-member
// symbol index (all defined symbols â†’ the one object member). Also writes a binary
// staleness manifest `<out>.manifest` (RFC 0011 Â§3.4). `iface_text`, when non-empty,
// is written verbatim as the `__axiom_iface` member (RFC 0011 P4); empty falls back to
// the exported-symbol list (increment-1 behavior).
pub fn axiom_write_static_lib(obj_path: str, out_path: str, src_hash: u64, iface_text: str) -> bool:
    let path_nt = x86_str_to_null_terminated(obj_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        ax_puts_local("error: staticlib could not open object file")
        return false
    fseek(f, 0, 2)
    let osize = ftell(f)
    rewind(f)
    let obuf = @alloc(osize) as ptr[u8]
    fread(obuf as ptr[void], 1, osize, f)
    fclose(f)

    // Collect defined symbol names (the archive's exports).
    let obj = linker_parse_coff(obuf, osize)
    mut symnames := new_linker_str_vec()
    mut si := 0 as i64
    while si < obj.symbols.len:
        let sym = &obj.symbols.data[si]
        if sym.defined and is_valid_symbol_name(sym.name):
            add_unique_import(&symnames, sym.name)
        si = si + 1

    // Layout: [8 magic][60 idx-hdr][idx-data(+pad)][60 obj-hdr][obj-data(+pad)]
    mut idx_data := 4 as i64 + symnames.len * 4
    mut sn := 0 as i64
    while sn < symnames.len:
        idx_data = idx_data + std.string.len(symnames.data[sn]) + 1
        sn = sn + 1
    mut idx_pad := 0 as i64
    if idx_data % 2 != 0:
        idx_pad = 1
    let obj_member_off = 8 as i64 + 60 + idx_data + idx_pad

    mut ar := new_byte_vec()
    let magic = "!<arch>\n"
    let mp = get_str_ptr(magic)
    mut mi := 0 as i64
    while mi < 8:
        push_byte(&ar, mp[mi])
        mi = mi + 1
    // First linker member: symbol index (name "/").
    ar_write_header(&ar, "/", idx_data)
    push_u32_be(&ar, symnames.len as u32)
    sn = 0
    while sn < symnames.len:
        push_u32_be(&ar, obj_member_off as u32)
        sn = sn + 1
    sn = 0
    while sn < symnames.len:
        let nm = symnames.data[sn]
        let np = get_str_ptr(nm)
        let nl = std.string.len(nm)
        mut c := 0 as i64
        while c < nl:
            push_byte(&ar, np[c])
            c = c + 1
        push_byte(&ar, 0 as u8)
        sn = sn + 1
    if idx_pad == 1:
        push_byte(&ar, 0x0A as u8)
    // Object member.
    ar_write_header(&ar, "axiom.o/", osize)
    push_bytes(&ar, obuf, osize)
    if osize % 2 != 0:
        push_byte(&ar, 0x0A as u8)

    // RFC 0011 P4 (increment 1): self-describing interface member. Placed LAST so the
    // symbol-index offsets (which point at the object member) are unaffected. The `ar`
    // member name begins with "__" so the P2 consumer loop skips it (not linkable code).
    // v1 payload is the archive's exported-symbol list; real type signatures land in
    // increment 2. The member is additive â€” omitting/ignoring it changes nothing.
    mut iface := new_byte_vec()
    if std.string.len(iface_text) > 0:
        // P4 inc2: real signatures built by the caller (build_lib_iface_text).
        let itp = get_str_ptr(iface_text)
        let itl = std.string.len(iface_text)
        mut iti := 0 as i64
        while iti < itl:
            push_byte(&iface, itp[iti])
            iti = iti + 1
    else:
        // inc1 fallback: exported-symbol list.
        let ihdr = "AXIFACE1\n"
        let ihp = get_str_ptr(ihdr)
        mut ihi := 0 as i64
        while ihi < std.string.len(ihdr):
            push_byte(&iface, ihp[ihi])
            ihi = ihi + 1
        mut isn := 0 as i64
        while isn < symnames.len:
            push_byte(&iface, 'S' as u8)
            push_byte(&iface, ' ' as u8)
            let inm = symnames.data[isn]
            let inp = get_str_ptr(inm)
            let inl = std.string.len(inm)
            mut ic := 0 as i64
            while ic < inl:
                push_byte(&iface, inp[ic])
                ic = ic + 1
            push_byte(&iface, 0x0A as u8)
            isn = isn + 1
    ar_write_header(&ar, "__axiom_iface/", iface.len)
    push_bytes(&ar, iface.data, iface.len)
    if iface.len % 2 != 0:
        push_byte(&ar, 0x0A as u8)
    if iface.data != null as ptr[u8]:
        @free(iface.data)

    let out_nt = x86_str_to_null_terminated(out_path)
    let of = fopen(out_nt as ptr[void], get_str_ptr("wb"))
    @free(out_nt)
    if of == null as ptr[void]:
        ax_puts_local("error: staticlib could not write output file")
        return false
    fwrite(ar.data as ptr[void], 1, ar.len, of)
    fclose(of)

    // Staleness manifest: hash of the SOURCE (passed in) so an unchanged source
    // reuses the .lib (RFC 0011 Â§3.4). Falls back to the object hash if 0.
    mut h := src_hash
    if h == 0 as u64:
        h = 5381 as u64
        mut hi := 0 as i64
        while hi < osize:
            h = ((h << 5 as u64) + h) + obuf[hi] as u64
            hi = hi + 1
    let man_path = std.string.concat(out_path, ".manifest")
    let man_nt = x86_str_to_null_terminated(man_path)
    let mf = fopen(man_nt as ptr[void], get_str_ptr("wb"))
    @free(man_nt)
    if mf != null as ptr[void]:
        mut man := new_byte_vec()
        let hdr = "AXLIB1\n"
        let hp = get_str_ptr(hdr)
        mut hj := 0 as i64
        while hj < std.string.len(hdr):
            push_byte(&man, hp[hj])
            hj = hj + 1
        push_u32_le(&man, (h & 0xFFFFFFFF as u64) as u32)
        push_u32_le(&man, ((h >> 32 as u64) & 0xFFFFFFFF as u64) as u32)
        fwrite(man.data as ptr[void], 1, man.len, mf)
        fclose(mf)
        if man.data != null as ptr[u8]:
            @free(man.data)

    @free(obuf)
    if ar.data != null as ptr[u8]:
        @free(ar.data)
    return true

// RFC 0011 P4 (increment 1): locate the `__axiom_iface` member in a `.lib` archive and
// print its raw payload to stdout. Round-trip verifier for the interface writer above;
// later increments replace the printing with in-memory interface reconstruction. Returns
// false if the file is unreadable, not an archive, or carries no interface member.
pub fn axiom_read_lib_iface(lib_path: str) -> bool:
    let path_nt = x86_str_to_null_terminated(lib_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        ax_puts_local("error: iface could not open .lib")
        return false
    fseek(f, 0, 2)
    let size = ftell(f)
    rewind(f)
    let buf = @alloc(size) as ptr[u8]
    fread(buf as ptr[void], 1, size, f)
    fclose(f)
    if size < 8 or buf[0] != '!' as u8 or buf[1] != '<' as u8:
        ax_puts_local("error: not a COFF !<arch> library")
        @free(buf)
        return false
    mut apos := 8 as i64
    mut found := false
    while apos + 60 <= size:
        mut msize := 0 as i64
        mut dd := 0 as i64
        while dd < 10:
            let ch = buf[apos + 48 as i64 + dd]
            if ch >= '0' as u8 and ch <= '9' as u8:
                msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
            dd = dd + 1
        let data_off = apos + 60 as i64
        // Member name (offset 0, slash-terminated) â€” match "__axiom_iface".
        if buf[apos] == '_' as u8 and buf[apos + 1 as i64] == '_' as u8:
            print_raw_ptr((buf as i64 + data_off) as ptr[u8], msize)
            found = true
        apos = data_off + msize
        if msize % 2 as i64 != 0:
            apos = apos + 1
    @free(buf)
    if not found:
        ax_puts_local("error: no __axiom_iface member in library")
    return found

// â”€â”€ RFC 0011 P4 (increment 3a): the interface READER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Inverse of build_lib_iface_text â€” parses the `__axiom_iface` payload back into an
// in-memory signature list. This is what the import-driven resolver (inc3b) will consume
// to typecheck an app against a precompiled `.lib` without touching the library source.

// One parsed public function signature. `params`/`ret` are reconstructed TypeIDs.
pub struct IfaceFunc:
    name: str
    params: U32Vec
    ret: u32

pub struct IfaceFuncVec:
    data: ptr[IfaceFunc]
    len: i64
    cap: i64

pub fn new_iface_func_vec() -> IfaceFuncVec:
    return IfaceFuncVec(data: null as ptr[IfaceFunc], len: 0, cap: 0)

pub fn push_iface_func(mut self: ptr[IfaceFuncVec], f: IfaceFunc):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[IfaceFunc]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[IfaceFunc]
        if self.data != null as ptr[IfaceFunc]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = f
    self.len = self.len + 1

// RFC 0011 P4 inc4a: one parsed public integer constant (`C <name> <type> <value>`).
pub struct IfaceConst:
    name: str
    type_id: u32
    value: i64

pub struct IfaceConstVec:
    data: ptr[IfaceConst]
    len: i64
    cap: i64

pub fn new_iface_const_vec() -> IfaceConstVec:
    return IfaceConstVec(data: null as ptr[IfaceConst], len: 0, cap: 0)

pub fn push_iface_const(mut self: ptr[IfaceConstVec], c: IfaceConst):
    if self.len == self.cap:
        mut new_cap := 8 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[IfaceConst]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[IfaceConst]
        if self.data != null as ptr[IfaceConst]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = c
    self.len = self.len + 1

// Inverse of iface_type_token: map an interface token back to a stable primitive TypeID.
// Non-primitive tokens ("ptr"/"slice"/"?") reconstruct to TYPE_UNKNOWN for now â€” inc4
// will carry the pointee/struct so they round-trip exactly.
pub fn iface_token_to_type(tok: str) -> u32:
    if tok == "i8":
        return TYPE_I8
    if tok == "i16":
        return TYPE_I16
    if tok == "i32":
        return TYPE_I32
    if tok == "i64":
        return TYPE_I64
    if tok == "u8":
        return TYPE_U8
    if tok == "u16":
        return TYPE_U16
    if tok == "u32":
        return TYPE_U32
    if tok == "u64":
        return TYPE_U64
    if tok == "f32":
        return TYPE_F32
    if tok == "f64":
        return TYPE_F64
    if tok == "bool":
        return TYPE_BOOL
    if tok == "string":
        return TYPE_STRING
    if tok == "char8":
        return TYPE_CHAR8
    if tok == "void":
        return TYPE_VOID
    if tok == "isize":
        return TYPE_ISIZE
    if tok == "usize":
        return TYPE_USIZE
    return TYPE_UNKNOWN

// Parse a base-10 token to i64 (defensive: stops at first non-digit).
fn iface_atoi(s: str) -> i64:
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut v := 0 as i64
    mut i := 0 as i64
    while i < n:
        if p[i] >= '0' as u8 and p[i] <= '9' as u8:
            v = v * 10 as i64 + (p[i] as i64 - '0' as i64)
        i = i + 1
    return v

// Split a byte range [start,end) into whitespace-delimited token strings.
fn iface_line_tokens(p: ptr[u8], start: i64, end: i64) -> LinkerStrVec:
    mut toks := new_linker_str_vec()
    mut k := start
    while k < end:
        while k < end and p[k] == ' ' as u8:
            k = k + 1
        if k >= end:
            break
        let ts = k
        while k < end and p[k] != ' ' as u8:
            k = k + 1
        push_linker_str(&toks, alloc_str_from_raw((p as i64 + ts) as ptr[u8], k - ts))
    return toks

// Read the raw `__axiom_iface` payload of a .lib as a heap string ("" if absent).
pub fn read_lib_iface_bytes(lib_path: str) -> str:
    let path_nt = x86_str_to_null_terminated(lib_path)
    let f = fopen(path_nt as ptr[void], get_str_ptr("rb"))
    @free(path_nt)
    if f == null as ptr[void]:
        return ""
    fseek(f, 0, 2)
    let size = ftell(f)
    rewind(f)
    let buf = @alloc(size) as ptr[u8]
    fread(buf as ptr[void], 1, size, f)
    fclose(f)
    if size < 8 or buf[0] != '!' as u8 or buf[1] != '<' as u8:
        @free(buf)
        return ""
    mut apos := 8 as i64
    mut out := ""
    while apos + 60 <= size:
        mut msize := 0 as i64
        mut dd := 0 as i64
        while dd < 10:
            let ch = buf[apos + 48 as i64 + dd]
            if ch >= '0' as u8 and ch <= '9' as u8:
                msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
            dd = dd + 1
        let data_off = apos + 60 as i64
        if buf[apos] == '_' as u8 and buf[apos + 1 as i64] == '_' as u8:
            out = alloc_str_from_raw((buf as i64 + data_off) as ptr[u8], msize)
        apos = data_off + msize
        if msize % 2 as i64 != 0:
            apos = apos + 1
    @free(buf)
    return out

// Parse a `.lib`'s interface member into a signature list. Recognizes "F <name> <n>
// <p0>..<pn-1> -> <ret>" lines; ignores the AXIFACE1 header and the inc1 "S" fallback.
pub fn parse_lib_iface(lib_path: str) -> IfaceFuncVec:
    mut result := new_iface_func_vec()
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    if n == 0:
        return result
    let p = get_str_ptr(text)
    mut i := 0 as i64
    while i < n:
        mut j := i
        while j < n and p[j] != 0x0A as u8:
            j = j + 1
        let toks = iface_line_tokens(p, i, j)
        if toks.len >= 4 and toks.data[0] == "F":
            let name = toks.data[1]
            let nparams = iface_atoi(toks.data[2])
            mut fn_params := new_u32_vec()
            mut t := 3 as i64
            mut pc := 0 as i64
            while pc < nparams and t < toks.len:
                fn_params.push(iface_token_to_type(toks.data[t]))
                t = t + 1
                pc = pc + 1
            mut ret := TYPE_VOID
            if t < toks.len and toks.data[t] == "->":
                t = t + 1
            if t < toks.len:
                ret = iface_token_to_type(toks.data[t])
            push_iface_func(&result, IfaceFunc(name: name, params: fn_params, ret: ret))
        i = j + 1
    return result

// RFC 0011 P4 inc4a: parse the `C <name> <type> <value>` const lines of a `.lib` interface
// into a value list, so a consumer can register + inline library constants without source.
pub fn parse_lib_iface_consts(lib_path: str) -> IfaceConstVec:
    mut result := new_iface_const_vec()
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    if n == 0:
        return result
    let p = get_str_ptr(text)
    mut i := 0 as i64
    while i < n:
        mut j := i
        while j < n and p[j] != 0x0A as u8:
            j = j + 1
        let toks = iface_line_tokens(p, i, j)
        if toks.len >= 4 and toks.data[0] == "C":
            let name = toks.data[1]
            let type_id = iface_token_to_type(toks.data[2])
            let value = iface_atoi(toks.data[3])
            push_iface_const(&result, IfaceConst(name: name, type_id: type_id, value: value))
        i = j + 1
    return result

// Round-trip self-check for the `iface` verb: dump the raw payload, then re-emit the
// signatures FROM the parsed in-memory form (via iface_type_token) so a match proves the
// reader reconstructs what the writer produced.
pub fn axiom_check_lib_iface(lib_path: str, types: ptr[TypeTable]) -> bool:
    let ok = axiom_read_lib_iface(lib_path)
    if not ok:
        return false
    ax_puts_local("=== parsed (reader round-trip) ===")
    let funcs = parse_lib_iface(lib_path)
    mut i := 0 as i64
    while i < funcs.len:
        let f = &funcs.data[i]
        mut line := new_byte_vec()
        iface_push_str(&line, "F ")
        iface_push_str(&line, f.name)
        push_byte(&line, ' ' as u8)
        iface_push_int(&line, f.params.len)
        mut pi := 0 as i64
        while pi < f.params.len:
            push_byte(&line, ' ' as u8)
            iface_push_str(&line, iface_type_token(types, f.params.data[pi], null as ptr[InternPool]))
            pi = pi + 1
        iface_push_str(&line, " -> ")
        iface_push_str(&line, iface_type_token(types, f.ret, null as ptr[InternPool]))
        push_byte(&line, 0x0A as u8)
        print_raw_ptr(line.data, line.len)
        if line.data != null as ptr[u8]:
            @free(line.data)
        i = i + 1
    return true

pub fn axiom_linker_link(self: ptr[AxiomLinker]) -> bool:
    mut objects := new_parsed_object_ptr_vec()
    mut format := "coff"
    mut kernel32_iat_offset := 0 as i64
    mut iat_offset := 0 as i64
    mut total_iat_size := 0 as i64
    
    // 1. Load and parse all object files
    mut i := 0 as i64
    while i < self.input_files.len:
        let path = self.input_files.data[i]
        let path_nt = x86_str_to_null_terminated(path)
        let file = fopen(path_nt as ptr[void], get_str_ptr("rb"))
        @free(path_nt)
        if file == null as ptr[void]:
            ax_puts_local("error: Linker could not open input file: ")
            ax_puts_local(path)
            return false
            
        fseek(file, 0, 2)
        let size = ftell(file)
        rewind(file)
        
        if size <= 4:
            ax_puts_local("error: Input file too small: ")
            ax_puts_local(path)
            fclose(file)
            return false
            
        let buffer = @alloc(size) as ptr[u8]
        fread(buffer as ptr[void], 1, size, file)
        fclose(file)
        
        mut obj := null as ptr[ParsedObject]
        if buffer[0] == '!' as u8 and buffer[1] == '<' as u8:
            // RFC 0011 P2: COFF !<arch> static library â€” pull all member objects.
            // (Single-member archives today; whole-archive inclusion, dead-strip later.)
            format = "coff"
            mut apos := 8 as i64
            while apos + 60 <= size:
                mut msize := 0 as i64
                mut dd := 0 as i64
                while dd < 10:
                    let ch = buffer[apos + 48 as i64 + dd]
                    if ch >= '0' as u8 and ch <= '9' as u8:
                        msize = msize * 10 as i64 + (ch as i64 - '0' as i64)
                    dd = dd + 1
                let data_off = apos + 60 as i64
                // Skip special members: "/" (symbol index), "//" (long names), and any
                // "__"-prefixed AXIOM metadata member (e.g. "__axiom_iface") â€” not code.
                if buffer[apos] != '/' as u8 and not (buffer[apos] == '_' as u8 and buffer[apos + 1 as i64] == '_' as u8):
                    let mobj = linker_parse_coff((buffer as i64 + data_off) as ptr[u8], msize)
                    push_parsed_object_ptr(&objects, mobj)
                apos = data_off + msize
                if msize % 2 as i64 != 0:
                    apos = apos + 1
        elif buffer[0] == 0x7F as u8 and buffer[1] == 'E' as u8 and buffer[2] == 'L' as u8 and buffer[3] == 'F' as u8:
            obj = linker_parse_elf(buffer, size)
            format = "elf64"
        elif read_u16_le(buffer, 0) == 0x8664 as u16:
            obj = linker_parse_coff(buffer, size)
            format = "coff"
        else:
            ax_puts_local("error: Unsupported object format in: ")
            ax_puts_local(path)
            @free(buffer)
            return false

        @free(buffer)
        if obj != null as ptr[ParsedObject]:
            push_parsed_object_ptr(&objects, obj)
        i = i + 1
        
    // 2. Pre-scan defined functions and dynamic imports (to determine base address & stubs early)
    mut func_names := new_linker_str_vec()
    
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut sym_i := 0 as i64
        while sym_i < obj.symbols.len:
            let sym = &obj.symbols.data[sym_i]
            // RFC 0017 / BUG#82: section-3 (.data global) symbols are added to
            // func_names/func_offsets LATER, after the writable data region is laid out
            // (their image RVA is not known yet). Skip here to keep the two arrays parallel.
            // RFC 0030 P3: section 4 (.bss) is excluded here for the same reason section 3
            // is â€” these passes treat a symbol's offset as a TEXT offset, and a global's
            // offset is relative to its own region. Letting .bss through resolved every
            // OP_GLOBAL_ADDR to a code address and segfaulted on first access.
            if sym.defined and sym.section != 3 as i64 and sym.section != 4 as i64:
                push_linker_str(&func_names, sym.name)
            sym_i = sym_i + 1
        i = i + 1

    // Â§8: two objects defining the same emitted name is a silent mis-link here, because
    // every lookup below takes the FIRST match. Surface it. See
    // report_duplicate_definitions. Covers the TEXT symbols, which is where the known
    // collision holes live (fn-vs-fn across modules, fn-vs-struct); .data/.bss globals
    // join func_names later, once their region is laid out.
    //
    // Gated on a MULTI-object link, on correctness grounds rather than measured cost: a
    // duplicate needs two definitions, and a single compilation cannot emit one name
    // twice (the frontend rejects same-name clashes before codegen), so with one object
    // the scan can only ever come up empty. Running it there is pure waste even if the
    // waste is small. (Timed honestly: gated vs ungated self-builds both land at
    // 8.3-8.5s with overlapping spread, i.e. the O(n^2) scan over ~2.4k symbols is NOT
    // measurable next to the reloc resolution beside it, which is O(relocs x names).
    // An earlier 7.3 -> 8.1s reading that looked like this scan was box noise.)
    mut dup_defs := 0 as i64
    if objects.len > 1 as i64:
        dup_defs = report_duplicate_definitions(&func_names)

    mut kernel32_imports := new_linker_str_vec()
    mut ax_runtime_imports := new_linker_str_vec()
    mut ucrtbase_imports := new_linker_str_vec()
    mut user_buckets := new_user_dll_bucket_vec() // RFC 0009: per-DLL user extern imports

    // RFC 0017 / BUG#82: names of module-level global data symbols (COFF section 3). A
    // reloc targeting one of these is a DEFINED reference (its VA is resolved later, once
    // the writable data region is laid out inside .idata), NOT a dynamic import â€” so the
    // import classifier below must skip them.
    mut global_names := new_linker_str_vec()
    mut gi_scan := 0 as i64
    while gi_scan < objects.len:
        let gobj = objects.data[gi_scan]
        mut gs := 0 as i64
        while gs < gobj.symbols.len:
            let gsym = &gobj.symbols.data[gs]
            if gsym.defined and gsym.section == 3 as i64:
                push_linker_str(&global_names, gsym.name)
            gs = gs + 1
        gi_scan = gi_scan + 1

    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut r_i := 0 as i64
        while r_i < obj.relocs.len:
            let r = &obj.relocs.data[r_i]
            if r.sym_idx < obj.sym_names.len as u32:
                let target_name = obj.sym_names.data[r.sym_idx]
                if target_name != "" and target_name != "main" and target_name != "_AX_main_main_v_v" and is_valid_symbol_name(target_name):
                    mut is_defined := false
                    mut search := 0 as i64
                    while search < func_names.len:
                        if func_names.data[search] == target_name:
                            is_defined = true
                            break
                        search = search + 1

                    if not is_defined:
                        mut gsearch := 0 as i64
                        while gsearch < global_names.len:
                            if global_names.data[gsearch] == target_name:
                                is_defined = true
                                break
                            gsearch = gsearch + 1

                    if not is_defined:
                        let user_dll = user_dll_for_symbol(self, target_name)
                        if user_dll != "":
                            // RFC 0009: explicit `extern "C" from "x.dll"` binding.
                            let ub = user_bucket_find_or_add(&user_buckets, user_dll)
                            add_unique_import(&user_buckets.data[ub].imports, target_name)
                        else:
                            let dll = get_dll_for_symbol(target_name)
                            let name_nt = x86_str_to_null_terminated(target_name)
                            ax_printf_local("[Debug Linker Import] DLL=%s, symbol=%s\n", get_str_ptr(dll) as i64, name_nt as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                            @free(name_nt)
                            if dll == "kernel32.dll":
                                add_unique_import(&kernel32_imports, target_name)
                            elif dll == "ax_runtime.dll":
                                add_unique_import(&ax_runtime_imports, target_name)
                            elif dll == "none" or dll == "":
                                // Skip dynamic import for dummy/clashed field symbols
                                is_defined = true
                            else:
                                add_unique_import(&ucrtbase_imports, target_name)

            r_i = r_i + 1
        i = i + 1
        
    // RFC 0009 P3 Linux: the kernel32 bucket (dead code behind folded is_windows
    // branches) and the ax_runtime.dll bucket (freestanding AXIOM twins are bundled
    // in-program and bound by the ax_-twin fallback in the resolve pass) must NOT become
    // ELF dynamic imports â€” the PLT here has no lazy-resolver stub, so .dynamic carries
    // DT_BIND_NOW and ld.so would abort the load on any unresolvable name. Only the
    // libc bucket (ucrtbase on Windows) is a real DT_NEEDED dependency on Linux.
    if format == "elf64":
        kernel32_imports.len = 0
        ax_runtime_imports.len = 0

    mut thunk_count := kernel32_imports.len + ax_runtime_imports.len + ucrtbase_imports.len
    // RFC 0009: user-DLL imports also get thunks + IAT slots
    mut user_total_imports := 0 as i64
    mut ubc_i := 0 as i64
    while ubc_i < user_buckets.len:
        user_total_imports = user_total_imports + user_buckets.data[ubc_i].imports.len
        ubc_i = ubc_i + 1
    thunk_count = thunk_count + user_total_imports
    
    // 3. Section Layout
    mut merged_code := new_byte_vec()
    mut base_addr := 0x140001000 as u64 // code starts at 0x140001000 for PE
    if format == "elf64":
        if thunk_count > 0:
            base_addr = 0x400200 as u64 // ELF code starts at 0x400200 if we have 512 bytes headers
        else:
            base_addr = 0x400080 as u64 // ELF code starts at 0x400080 if 128 bytes headers
            
    mut func_offsets := new_parsed_reloc_vec() // piggyback on ParsedReloc to store offsets
    
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        obj.va = base_addr + merged_code.len as u64
        
        mut sym_i := 0 as i64
        while sym_i < obj.symbols.len:
            let sym = &obj.symbols.data[sym_i]
            // RFC 0017 / BUG#82: skip section-3 globals (added after data-region layout).
            // RFC 0030 P3: section 4 (.bss) is excluded here for the same reason section 3
            // is â€” these passes treat a symbol's offset as a TEXT offset, and a global's
            // offset is relative to its own region. Letting .bss through resolved every
            // OP_GLOBAL_ADDR to a code address and segfaulted on first access.
            if sym.defined and sym.section != 3 as i64 and sym.section != 4 as i64:
                mut offset_va := sym.offset
                if sym.section == 2: // .rdata
                    offset_va = obj.text.len as u64 + sym.offset
                push_parsed_reloc(&func_offsets, ParsedReloc(offset: (merged_code.len as u64 + offset_va) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
            sym_i = sym_i + 1

        push_bytes(&merged_code, obj.text.data, obj.text.len)
        push_bytes(&merged_code, obj.rdata.data, obj.rdata.len)
        i = i + 1
        
    mut thunks_offset := (merged_code.len + 15) & ~15
    mut thunks_rva := 0x1000 as u32 + thunks_offset as u32
    mut thunks_size := thunk_count * 6
    
    mut idata_rva := (0x1000 as i64 + thunks_offset + thunks_size as i64 + 4095) & ~4095
    
    // Construct .idata and thunks for COFF
    mut idata_buf := new_byte_vec()
    // RFC 0030 P3: total virtual extent of the writable region INCLUDING the zero-filled
    // .bss tail. Stays 0 when no object carries .bss, which is what keeps existing output
    // byte-identical (the header code then falls back to the raw size, exactly as before).
    mut bss_virt_extent := 0 as i64
    mut dyn_sym_names := new_linker_str_vec()
    mut dyn_sym_rvas := null as ptr[u32]
    
    mut kernel32_hn_rvas := null as ptr[u32]
    mut ax_runtime_hn_rvas := null as ptr[u32]
    mut ucrtbase_hn_rvas := null as ptr[u32]
    
    if format == "coff" and thunk_count > 0:
        dyn_sym_rvas = @alloc(thunk_count * 4) as ptr[u32]
        
        let has_kernel32 = kernel32_imports.len > 0
        let has_ax_runtime = ax_runtime_imports.len > 0
        let has_ucrtbase = ucrtbase_imports.len > 0
        mut K := 0 as i64
        if has_kernel32:
            K = K + 1
        if has_ax_runtime:
            K = K + 1
        if has_ucrtbase:
            K = K + 1
        K = K + user_buckets.len // RFC 0009: one IDT descriptor per user DLL

        let idt_size = (K + 1) * 20
        iat_offset = (idt_size + 7) & ~7
        
        mut kernel32_iat_offset := 0 as i64
        mut kernel32_iat_size := 0 as i64
        mut ax_runtime_iat_offset := iat_offset
        mut ax_runtime_iat_size := 0 as i64
        mut ucrtbase_iat_offset := iat_offset
        mut ucrtbase_iat_size := 0 as i64
        
        mut cur_iat_offset := iat_offset
        
        if has_kernel32:
            kernel32_iat_offset = cur_iat_offset
            kernel32_iat_size = (kernel32_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + kernel32_iat_size
            
        if has_ax_runtime:
            ax_runtime_iat_offset = cur_iat_offset
            ax_runtime_iat_size = (ax_runtime_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + ax_runtime_iat_size
            
        if has_ucrtbase:
            ucrtbase_iat_offset = cur_iat_offset
            ucrtbase_iat_size = (ucrtbase_imports.len + 1) * 8
            cur_iat_offset = cur_iat_offset + ucrtbase_iat_size

        mut ub_i := 0 as i64
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].iat_offset = cur_iat_offset
            cur_iat_offset = cur_iat_offset + (user_buckets.data[ub_i].imports.len + 1) * 8
            ub_i = ub_i + 1

        total_iat_size = cur_iat_offset - iat_offset
        let ilt_offset = iat_offset + total_iat_size
        mut cur_ilt_offset := ilt_offset
        
        mut kernel32_ilt_offset := 0 as i64
        mut kernel32_ilt_size := 0 as i64
        if has_kernel32:
            kernel32_ilt_offset = cur_ilt_offset
            kernel32_ilt_size = (kernel32_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + kernel32_ilt_size
            
        mut ax_runtime_ilt_offset := 0 as i64
        mut ax_runtime_ilt_size := 0 as i64
        if has_ax_runtime:
            ax_runtime_ilt_offset = cur_ilt_offset
            ax_runtime_ilt_size = (ax_runtime_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + ax_runtime_ilt_size
            
        mut ucrtbase_ilt_offset := 0 as i64
        mut ucrtbase_ilt_size := 0 as i64
        if has_ucrtbase:
            ucrtbase_ilt_offset = cur_ilt_offset
            ucrtbase_ilt_size = (ucrtbase_imports.len + 1) * 8
            cur_ilt_offset = cur_ilt_offset + ucrtbase_ilt_size

        ub_i = 0
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].ilt_offset = cur_ilt_offset
            cur_ilt_offset = cur_ilt_offset + (user_buckets.data[ub_i].imports.len + 1) * 8
            ub_i = ub_i + 1

        let total_ilt_size = cur_ilt_offset - ilt_offset
        let dll_names_offset = ilt_offset + total_ilt_size
        mut cur_offset := dll_names_offset
        
        mut kernel32_name_offset := 0 as i64
        if has_kernel32:
            kernel32_name_offset = cur_offset
            cur_offset = cur_offset + 13
            
        mut ax_runtime_name_offset := 0 as i64
        if has_ax_runtime:
            ax_runtime_name_offset = cur_offset
            cur_offset = cur_offset + 15
            
        mut ucrtbase_name_offset := 0 as i64
        if has_ucrtbase:
            ucrtbase_name_offset = cur_offset
            cur_offset = cur_offset + 13

        ub_i = 0
        while ub_i < user_buckets.len:
            user_buckets.data[ub_i].name_offset = cur_offset
            cur_offset = cur_offset + std.string.len(user_buckets.data[ub_i].name) + 1
            ub_i = ub_i + 1

        mut hint_name_start_offset := cur_offset
        if hint_name_start_offset % 2 != 0:
            hint_name_start_offset = hint_name_start_offset + 1
        
        
        // Pre-fill idata_buf with zeros
        mut zero_i := 0 as i64
        while zero_i < hint_name_start_offset as i64:
            push_byte(&idata_buf, 0 as u8)
            zero_i = zero_i + 1
            
        if has_kernel32:
            kernel32_hn_rvas = @alloc(kernel32_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < kernel32_imports.len:
                kernel32_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = kernel32_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
                
        if has_ax_runtime:
            ax_runtime_hn_rvas = @alloc(ax_runtime_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < ax_runtime_imports.len:
                ax_runtime_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = ax_runtime_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
                
        if has_ucrtbase:
            ucrtbase_hn_rvas = @alloc(ucrtbase_imports.len * 4) as ptr[u32]
            mut j := 0 as i64
            while j < ucrtbase_imports.len:
                ucrtbase_hn_rvas[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = ucrtbase_imports.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1

        // RFC 0009: hint-name entries for user-DLL imports
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let nimp = imp.len
            let hn = @alloc(nimp * 4) as ptr[u32]
            user_buckets.data[ub_i].hn_rvas = hn
            mut j := 0 as i64
            while j < nimp:
                hn[j] = (idata_rva as i64 + idata_buf.len) as u32
                push_byte(&idata_buf, 0 as u8)
                push_byte(&idata_buf, 0 as u8)
                let name = imp.data[j]
                let len = std.string.len(name)
                let ptr = get_str_ptr(name)
                mut c_i := 0 as i64
                while c_i < len:
                    push_byte(&idata_buf, ptr[c_i])
                    c_i = c_i + 1
                push_byte(&idata_buf, 0 as u8)
                if (len + 3) % 2 != 0:
                    push_byte(&idata_buf, 0 as u8)
                j = j + 1
            ub_i = ub_i + 1

        // Write active DLL names
        if has_kernel32:
            let name_ptr = "kernel32.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 12:
                idata_buf.data[kernel32_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[kernel32_name_offset as i64 + 12] = 0 as u8
            
        if has_ax_runtime:
            let name_ptr = "ax_runtime.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 14:
                idata_buf.data[ax_runtime_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[ax_runtime_name_offset as i64 + 14] = 0 as u8
            
        if has_ucrtbase:
            let name_ptr = "ucrtbase.dll" as ptr[u8]
            mut c_i := 0 as i64
            while c_i < 12:
                idata_buf.data[ucrtbase_name_offset as i64 + c_i] = name_ptr[c_i]
                c_i = c_i + 1
            idata_buf.data[ucrtbase_name_offset as i64 + 12] = 0 as u8

        // RFC 0009: write user DLL name strings
        ub_i = 0
        while ub_i < user_buckets.len:
            let nm = user_buckets.data[ub_i].name
            let noff = user_buckets.data[ub_i].name_offset
            let nlen = std.string.len(nm)
            let np = get_str_ptr(nm)
            mut c_i := 0 as i64
            while c_i < nlen:
                idata_buf.data[noff + c_i] = np[c_i]
                c_i = c_i + 1
            idata_buf.data[noff + nlen] = 0 as u8
            ub_i = ub_i + 1

        // Write ILT and IAT entries
        if has_kernel32:
            mut j := 0 as i64
            while j < kernel32_imports.len:
                let val = kernel32_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, kernel32_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, kernel32_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, kernel32_iat_offset as i64 + kernel32_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, kernel32_ilt_offset as i64 + kernel32_imports.len * 8, 0 as u64)
            
        if has_ax_runtime:
            mut j := 0 as i64
            while j < ax_runtime_imports.len:
                let val = ax_runtime_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, ax_runtime_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, ax_runtime_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, ax_runtime_iat_offset as i64 + ax_runtime_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ax_runtime_ilt_offset as i64 + ax_runtime_imports.len * 8, 0 as u64)
            
        if has_ucrtbase:
            mut j := 0 as i64
            while j < ucrtbase_imports.len:
                let val = ucrtbase_hn_rvas[j] as u64
                write_buf_u64_le(idata_buf.data, ucrtbase_iat_offset as i64 + j * 8, val)
                write_buf_u64_le(idata_buf.data, ucrtbase_ilt_offset as i64 + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, ucrtbase_iat_offset as i64 + ucrtbase_imports.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ucrtbase_ilt_offset as i64 + ucrtbase_imports.len * 8, 0 as u64)

        // RFC 0009: write user-DLL ILT/IAT entries
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let hn = user_buckets.data[ub_i].hn_rvas
            let iato = user_buckets.data[ub_i].iat_offset
            let ilto = user_buckets.data[ub_i].ilt_offset
            mut j := 0 as i64
            while j < imp.len:
                let val = hn[j] as u64
                write_buf_u64_le(idata_buf.data, iato + j * 8, val)
                write_buf_u64_le(idata_buf.data, ilto + j * 8, val)
                j = j + 1
            write_buf_u64_le(idata_buf.data, iato + imp.len * 8, 0 as u64)
            write_buf_u64_le(idata_buf.data, ilto + imp.len * 8, 0 as u64)
            ub_i = ub_i + 1

        // Write IDT entries
        mut entry_idx := 0 as i64
        if has_kernel32:
            let ilt_rva = (idata_rva as i64 + kernel32_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + kernel32_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + kernel32_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1
            
        if has_ax_runtime:
            let ilt_rva = (idata_rva as i64 + ax_runtime_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + ax_runtime_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + ax_runtime_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1
            
        if has_ucrtbase:
            let ilt_rva = (idata_rva as i64 + ucrtbase_ilt_offset as i64) as u32
            let name_rva = (idata_rva as i64 + ucrtbase_name_offset as i64) as u32
            let iat_rva = (idata_rva as i64 + ucrtbase_iat_offset as i64) as u32
            let off = entry_idx * 20
            write_buf_u32_le(idata_buf.data, off, ilt_rva)
            write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, off + 12, name_rva)
            write_buf_u32_le(idata_buf.data, off + 16, iat_rva)
            entry_idx = entry_idx + 1

        // RFC 0009: IDT descriptors for user DLLs
        ub_i = 0
        while ub_i < user_buckets.len:
            let u_ilt_rva = (idata_rva as i64 + user_buckets.data[ub_i].ilt_offset) as u32
            let u_name_rva = (idata_rva as i64 + user_buckets.data[ub_i].name_offset) as u32
            let u_iat_rva = (idata_rva as i64 + user_buckets.data[ub_i].iat_offset) as u32
            let uoff = entry_idx * 20
            write_buf_u32_le(idata_buf.data, uoff, u_ilt_rva)
            write_buf_u32_le(idata_buf.data, uoff + 4, 0 as u32)
            write_buf_u32_le(idata_buf.data, uoff + 8, 0 as u32)
            write_buf_u32_le(idata_buf.data, uoff + 12, u_name_rva)
            write_buf_u32_le(idata_buf.data, uoff + 16, u_iat_rva)
            entry_idx = entry_idx + 1
            ub_i = ub_i + 1

        let off = entry_idx * 20
        write_buf_u32_le(idata_buf.data, off, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 4, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 8, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 12, 0 as u32)
        write_buf_u32_le(idata_buf.data, off + 16, 0 as u32)

        // RFC 0017 / BUG#82: place module-level global storage at the END of the writable
        // .idata section, after the import directory. Every write_buf into idata_buf above
        // uses fixed offsets computed earlier, so appending here perturbs nothing. Each
        // object's .data block is appended (8-byte aligned) and its section-3 symbols are
        // registered into func_names/func_offsets (parallel â€” both skip section 3 in the
        // earlier passes) so OP_GLOBAL_ADDR PC32 relocs resolve to the global's image VA.
        mut gobj_i := 0 as i64
        while gobj_i < objects.len:
            let gobj = objects.data[gobj_i]
            if gobj.data.len > 0:
                while (idata_buf.len % 8 as i64) != 0 as i64:
                    push_byte(&idata_buf, 0 as u8)
                let region_rva = (idata_rva as i64 + idata_buf.len) as u64
                gobj.data_va = region_rva
                mut db := 0 as i64
                while db < gobj.data.len:
                    push_byte(&idata_buf, gobj.data.data[db])
                    db = db + 1
                mut gsym_i := 0 as i64
                while gsym_i < gobj.symbols.len:
                    let gsym = &gobj.symbols.data[gsym_i]
                    if gsym.defined and gsym.section == 3 as i64:
                        push_linker_str(&func_names, gsym.name)
                        let sym_rva = region_rva + gsym.offset
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (sym_rva - 0x1000 as u64) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    gsym_i = gsym_i + 1
            gobj_i = gobj_i + 1

        // RFC 0030 P3: reserve zero-initialized global storage AFTER every file-backed
        // block. These bytes exist only in the image: they extend the section's VirtualSize
        // while SizeOfRawData keeps covering just idata_buf, and the loader zero-fills the
        // difference. Doing this in a SECOND pass is what guarantees the file-backed prefix
        // stays contiguous â€” interleaving it with the .data pass would strand real bytes
        // beyond the raw size and truncate them.
        mut bss_cursor := idata_buf.len as i64
        mut bobj_i := 0 as i64
        while bobj_i < objects.len:
            let bobj = objects.data[bobj_i]
            if bobj.bss_size > 0 as i64:
                while (bss_cursor % 16 as i64) != 0 as i64:
                    bss_cursor = bss_cursor + 1 as i64
                let brva = (idata_rva as i64 + bss_cursor) as u64
                bobj.bss_va = brva
                bss_cursor = bss_cursor + bobj.bss_size
                mut bsym_i := 0 as i64
                while bsym_i < bobj.symbols.len:
                    let bsym = &bobj.symbols.data[bsym_i]
                    if bsym.defined and bsym.section == 4 as i64:
                        push_linker_str(&func_names, bsym.name)
                        let bsym_rva = brva + bsym.offset
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (bsym_rva - 0x1000 as u64) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    bsym_i = bsym_i + 1
            bobj_i = bobj_i + 1
        bss_virt_extent = bss_cursor

        // Pad merged_code to thunks_offset
        while merged_code.len < thunks_offset:
            push_byte(&merged_code, 0 as u8)
            
        // Append all thunks
        mut thunk_i := 0 as i64
        
        mut k_j := 0 as i64
        while k_j < kernel32_imports.len:
            let sym_name = kernel32_imports.data[k_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + kernel32_iat_offset as u32 + k_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva
            
            thunk_i = thunk_i + 1
            k_j = k_j + 1
            
        mut ax_j := 0 as i64
        while ax_j < ax_runtime_imports.len:
            let sym_name = ax_runtime_imports.data[ax_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + ax_runtime_iat_offset as u32 + ax_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva
            
            thunk_i = thunk_i + 1
            ax_j = ax_j + 1
            
        mut u_j := 0 as i64
        while u_j < ucrtbase_imports.len:
            let sym_name = ucrtbase_imports.data[u_j]
            let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
            let iat_rva_sym = idata_rva as u32 + ucrtbase_iat_offset as u32 + u_j as u32 * 8 as u32
            let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = th_rva

            thunk_i = thunk_i + 1
            u_j = u_j + 1

        // RFC 0009: thunks for user-DLL imports (name-based reloc resolves via dyn_sym_names)
        ub_i = 0
        while ub_i < user_buckets.len:
            let imp = user_buckets.data[ub_i].imports
            let iato = user_buckets.data[ub_i].iat_offset
            mut j := 0 as i64
            while j < imp.len:
                let sym_name = imp.data[j]
                let th_rva = thunks_rva + thunk_i as u32 * 6 as u32
                let iat_rva_sym = idata_rva as u32 + iato as u32 + j as u32 * 8 as u32
                let disp32 = (iat_rva_sym as i32 - (th_rva + 6 as u32) as i32) as u32

                push_byte(&merged_code, 0xFF as u8)
                push_byte(&merged_code, 0x25 as u8)
                push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
                push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)

                push_linker_str(&dyn_sym_names, sym_name)
                dyn_sym_rvas[thunk_i] = th_rva

                thunk_i = thunk_i + 1
                j = j + 1
            ub_i = ub_i + 1

    // Construct dyn_buf for ELF64
    mut dyn_buf := new_byte_vec()
    mut offset_dynamic := 0 as i64
    mut size_dynamic := 0 as i64
    // Code-start-relative offset where dyn_buf is placed in the image (align16 of the
    // thunks end). The emit path needs it to compute PT_DYNAMIC's FILE offset â€” the
    // original `512 + offset_dynamic` forgot the code in between, pointing PT_DYNAMIC
    // into .text (ld.so read machine code as dynamic tags and crashed).
    mut dyn_file_off := 0 as i64
    if format == "elf64" and thunk_count > 0:
        dyn_sym_rvas = @alloc(thunk_count * 4) as ptr[u32]
        
        mut dyn_imports := new_linker_str_vec()
        mut dyn_libs := new_linker_str_vec()
        
        mut has_ax_lib := false
        mut has_c_lib := false
        
        mut scan_j := 0 as i64
        while scan_j < kernel32_imports.len:
            push_linker_str(&dyn_imports, kernel32_imports.data[scan_j])
            has_ax_lib = true
            scan_j = scan_j + 1
            
        scan_j = 0
        while scan_j < ax_runtime_imports.len:
            push_linker_str(&dyn_imports, ax_runtime_imports.data[scan_j])
            has_ax_lib = true
            scan_j = scan_j + 1
            
        scan_j = 0
        while scan_j < ucrtbase_imports.len:
            push_linker_str(&dyn_imports, ucrtbase_imports.data[scan_j])
            has_c_lib = true
            scan_j = scan_j + 1
            
        if has_ax_lib:
            push_linker_str(&dyn_libs, "libax_runtime.so")
        if has_c_lib:
            push_linker_str(&dyn_libs, "libc.so.6")
            
        // 1. Build .dynstr
        mut dynstr_buf := new_byte_vec()
        push_byte(&dynstr_buf, 0 as u8)
        
        let lib_str_offsets = @alloc(dyn_libs.len * 8) as ptr[u64]
        mut lib_i := 0 as i64
        while lib_i < dyn_libs.len:
            lib_str_offsets[lib_i] = dynstr_buf.len as u64
            let name = dyn_libs.data[lib_i]
            let name_len = std.string.len(name)
            let name_ptr = get_str_ptr(name)
            mut char_i := 0 as i64
            while char_i < name_len:
                push_byte(&dynstr_buf, name_ptr[char_i])
                char_i = char_i + 1
            push_byte(&dynstr_buf, 0 as u8)
            lib_i = lib_i + 1
            
        let sym_str_offsets = @alloc(dyn_imports.len * 8) as ptr[u64]
        mut sym_i := 0 as i64
        while sym_i < dyn_imports.len:
            sym_str_offsets[sym_i] = dynstr_buf.len as u64
            let name = dyn_imports.data[sym_i]
            let name_len = std.string.len(name)
            let name_ptr = get_str_ptr(name)
            mut char_i := 0 as i64
            while char_i < name_len:
                push_byte(&dynstr_buf, name_ptr[char_i])
                char_i = char_i + 1
            push_byte(&dynstr_buf, 0 as u8)
            sym_i = sym_i + 1

        // RFC 0032 P1: resolve #[export] functions to DEFINED symbols and append their names to
        // .dynstr. The exported name is `self.export_names.data[k]` (the consumer-facing name,
        // e.g. `ax_add`, exactly what dlsym looks up); its defined address is the RVA of the
        // mangled symbol `ax_<name>` in func_names â€” identical resolution to the COFF export path
        // (build_export_edata). st_value is the as-linked absolute VA `base_addr + (rva-0x1000)`;
        // under ET_DYN the loader adds the load bias uniformly to it, DT_* pointers, and RELA, so
        // keeping base_addr=0x400200 stays consistent (RIP-relative code is bias-independent).
        let n_exports = self.export_names.len
        let export_str_offsets = @alloc((n_exports + 1) * 8) as ptr[u64]
        let export_vas = @alloc((n_exports + 1) * 8) as ptr[u64]
        mut exp_k := 0 as i64
        while exp_k < n_exports:
            export_str_offsets[exp_k] = dynstr_buf.len as u64
            let enm = self.export_names.data[exp_k]
            let enm_len = std.string.len(enm)
            let enm_ptr = get_str_ptr(enm)
            mut ec := 0 as i64
            while ec < enm_len:
                push_byte(&dynstr_buf, enm_ptr[ec])
                ec = ec + 1
            push_byte(&dynstr_buf, 0 as u8)
            // Resolve mangled "ax_<name>" -> RVA in func_names/func_offsets.
            let mangled = std.string.concat("ax_", enm)
            mut e_va := 0 as u64
            mut efi := 0 as i64
            while efi < func_names.len:
                if func_names.data[efi] == mangled:
                    e_va = base_addr + (func_offsets.data[efi].offset as u64)
                    break
                efi = efi + 1
            @free(get_str_ptr(mangled))
            export_vas[exp_k] = e_va
            exp_k = exp_k + 1

        // 2. Build .dynsym
        mut dynsym_buf := new_byte_vec()
        mut zero_idx := 0 as i64
        while zero_idx < 24:
            push_byte(&dynsym_buf, 0 as u8)
            zero_idx = zero_idx + 1
            
        sym_i = 0
        while sym_i < dyn_imports.len:
            push_u32_le(&dynsym_buf, sym_str_offsets[sym_i] as u32)
            push_byte(&dynsym_buf, 0x12 as u8) // STB_GLOBAL << 4 | STT_FUNC = 0x12
            push_byte(&dynsym_buf, 0 as u8)
            push_u16_le(&dynsym_buf, 0 as u16) // SHN_UNDEF = 0
            push_u64_le(&dynsym_buf, 0 as u64)
            push_u64_le(&dynsym_buf, 0 as u64)
            sym_i = sym_i + 1

        // RFC 0032 P1: DEFINED export symbols, after the imports. st_shndx=1 (a normal, non-UNDEF
        // section index) marks them defined so dlsym returns them AND so ld.so adds the load bias
        // to st_value (SHN_ABS would suppress the bias and break under relocation). There is no
        // section header table (e_shnum=0), but dynamic-symbol resolution never consults it â€” only
        // st_shndx==SHN_UNDEF(0) is treated specially.
        exp_k = 0
        while exp_k < n_exports:
            push_u32_le(&dynsym_buf, export_str_offsets[exp_k] as u32)
            push_byte(&dynsym_buf, 0x12 as u8) // STB_GLOBAL << 4 | STT_FUNC = 0x12
            push_byte(&dynsym_buf, 0 as u8)     // st_other
            push_u16_le(&dynsym_buf, 1 as u16)  // st_shndx = 1 (defined, text)
            push_u64_le(&dynsym_buf, export_vas[exp_k]) // st_value = as-linked VA
            push_u64_le(&dynsym_buf, 0 as u64)  // st_size
            exp_k = exp_k + 1

        // 3. Build .hash â€” one bucket, so every dynsym entry (imports + exports) is on the single
        // chain; dlsym walks it comparing names and returns the defined exports.
        let total_dyn_syms = dyn_imports.len + n_exports
        mut hash_buf := new_byte_vec()
        push_u32_le(&hash_buf, 1 as u32) // nbucket = 1
        push_u32_le(&hash_buf, (1 as i64 + total_dyn_syms) as u32) // nchain = dynsym count
        push_u32_le(&hash_buf, 1 as u32) // bucket[0] = 1
        push_u32_le(&hash_buf, 0 as u32) // chain[0] = 0
        mut chain_idx := 2 as i64
        while chain_idx <= 1 as i64 + total_dyn_syms:
            if chain_idx == 1 as i64 + total_dyn_syms:
                push_u32_le(&hash_buf, 0 as u32)
            else:
                push_u32_le(&hash_buf, chain_idx as u32)
            chain_idx = chain_idx + 1
            
        // 4. Build .got.plt
        mut got_plt_buf := new_byte_vec()
        push_u64_le(&got_plt_buf, 0 as u64) // link to _DYNAMIC
        push_u64_le(&got_plt_buf, 0 as u64)
        push_u64_le(&got_plt_buf, 0 as u64)
        sym_i = 0
        while sym_i < dyn_imports.len:
            push_u64_le(&got_plt_buf, 0 as u64)
            sym_i = sym_i + 1
            
        // 5. Calculate offsets of sections inside dyn_buf
        let offset_dynstr = 0 as i64
        let size_dynstr = dynstr_buf.len
        
        let offset_dynsym = (size_dynstr + 7) & ~7
        let size_dynsym = dynsym_buf.len
        
        let offset_hash = (offset_dynsym + size_dynsym + 7) & ~7
        let size_hash = hash_buf.len
        
        let offset_got_plt = (offset_hash + size_hash + 7) & ~7
        let size_got_plt = got_plt_buf.len
        
        let offset_rela_plt = (offset_got_plt + size_got_plt + 7) & ~7
        let size_rela_plt = dyn_imports.len * 24
        
        offset_dynamic = (offset_rela_plt + size_rela_plt + 7) & ~7
        size_dynamic = (dyn_libs.len + 15) * 16 // 15 fixed tags (incl. DT_JMPREL) + one DT_NEEDED per lib
        
        // 6. Compute virtual addresses
        let dyn_offset = (thunks_offset + thunks_size + 15) & ~15
        dyn_file_off = dyn_offset
        let dyn_base_va = base_addr + dyn_offset as u64
        
        let dynstr_va = dyn_base_va + offset_dynstr as u64
        let dynsym_va = dyn_base_va + offset_dynsym as u64
        let hash_va = dyn_base_va + offset_hash as u64
        let got_plt_va = dyn_base_va + offset_got_plt as u64
        let rela_plt_va = dyn_base_va + offset_rela_plt as u64
        let dynamic_va = dyn_base_va + offset_dynamic as u64
        
        // 7. Build .rela.plt
        mut rela_plt_buf := new_byte_vec()
        sym_i = 0
        while sym_i < dyn_imports.len:
            let r_offset = got_plt_va + 24 as u64 + sym_i as u64 * 8 as u64
            let r_info = ((1 as u64 + sym_i as u64) << 32 as u64) | 7 as u64 // R_X86_64_JUMP_SLOT = 7
            push_u64_le(&rela_plt_buf, r_offset)
            push_u64_le(&rela_plt_buf, r_info)
            push_u64_le(&rela_plt_buf, 0 as u64)
            sym_i = sym_i + 1
            
        // 8. Build .dynamic
        mut dynamic_buf := new_byte_vec()
        mut lib_idx := 0 as i64
        while lib_idx < dyn_libs.len:
            push_u64_le(&dynamic_buf, 1 as u64) // DT_NEEDED
            push_u64_le(&dynamic_buf, lib_str_offsets[lib_idx])
            lib_idx = lib_idx + 1
            
        push_u64_le(&dynamic_buf, 2 as u64) // DT_PLTRELSZ
        push_u64_le(&dynamic_buf, rela_plt_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 20 as u64) // DT_PLTREL
        push_u64_le(&dynamic_buf, 7 as u64) // DT_RELA
        
        push_u64_le(&dynamic_buf, 3 as u64) // DT_PLTGOT
        push_u64_le(&dynamic_buf, got_plt_va)
        
        push_u64_le(&dynamic_buf, 4 as u64) // DT_HASH
        push_u64_le(&dynamic_buf, hash_va)
        
        push_u64_le(&dynamic_buf, 5 as u64) // DT_STRTAB
        push_u64_le(&dynamic_buf, dynstr_va)
        
        push_u64_le(&dynamic_buf, 6 as u64) // DT_SYMTAB
        push_u64_le(&dynamic_buf, dynsym_va)
        
        push_u64_le(&dynamic_buf, 10 as u64) // DT_STRSZ
        push_u64_le(&dynamic_buf, dynstr_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 11 as u64) // DT_SYMENT
        push_u64_le(&dynamic_buf, 24 as u64)
        
        push_u64_le(&dynamic_buf, 7 as u64) // DT_RELA
        push_u64_le(&dynamic_buf, rela_plt_va)
        
        push_u64_le(&dynamic_buf, 8 as u64) // DT_RELASZ
        push_u64_le(&dynamic_buf, rela_plt_buf.len as u64)
        
        push_u64_le(&dynamic_buf, 9 as u64) // DT_RELAENT
        push_u64_le(&dynamic_buf, 24 as u64)
        
        // DT_JMPREL: VA of the PLT relocation table. glibc pairs DT_PLTRELSZ/DT_PLTREL
        // with this tag; leaving it out while PLTRELSZ != 0 made ld.so walk a NULL
        // Elf64_Rela array during BIND_NOW relocation processing (segfault at 8 = the
        // r_info field of entry 0).
        push_u64_le(&dynamic_buf, 23 as u64) // DT_JMPREL
        push_u64_le(&dynamic_buf, rela_plt_va)

        push_u64_le(&dynamic_buf, 24 as u64) // DT_BIND_NOW
        push_u64_le(&dynamic_buf, 1 as u64)

        push_u64_le(&dynamic_buf, 30 as u64) // DT_FLAGS
        push_u64_le(&dynamic_buf, 8 as u64) // DF_BIND_NOW
        
        push_u64_le(&dynamic_buf, 0 as u64) // DT_NULL
        push_u64_le(&dynamic_buf, 0 as u64)
        
        // 9. Assemble dyn_buf
        push_bytes(&dyn_buf, dynstr_buf.data, dynstr_buf.len)
        
        while dyn_buf.len < offset_dynsym:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, dynsym_buf.data, dynsym_buf.len)
        
        while dyn_buf.len < offset_hash:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, hash_buf.data, hash_buf.len)
        
        while dyn_buf.len < offset_got_plt:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, got_plt_buf.data, got_plt_buf.len)
        
        while dyn_buf.len < offset_rela_plt:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, rela_plt_buf.data, rela_plt_buf.len)
        
        while dyn_buf.len < offset_dynamic:
            push_byte(&dyn_buf, 0 as u8)
        push_bytes(&dyn_buf, dynamic_buf.data, dynamic_buf.len)
        
        // 10. Generate ELF PLT stubs inside merged_code
        // Pad merged_code to thunks_offset
        while merged_code.len < thunks_offset:
            push_byte(&merged_code, 0 as u8)
            
        mut thunk_i := 0 as i64
        
        // Generate for kernel32
        mut k_j := 0 as i64
        while k_j < kernel32_imports.len:
            let sym_name = kernel32_imports.data[k_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            k_j = k_j + 1
            
        // Generate for ax_runtime
        mut ax_j := 0 as i64
        while ax_j < ax_runtime_imports.len:
            let sym_name = ax_runtime_imports.data[ax_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            ax_j = ax_j + 1
            
        // Generate for ucrtbase
        mut u_j := 0 as i64
        while u_j < ucrtbase_imports.len:
            let sym_name = ucrtbase_imports.data[u_j]
            let th_va = base_addr + thunks_offset as u64 + thunk_i as u64 * 6 as u64
            let got_slot_va = got_plt_va + 24 as u64 + thunk_i as u64 * 8 as u64
            let disp32 = (got_slot_va - (th_va + 6 as u64)) as u32
            
            push_byte(&merged_code, 0xFF as u8)
            push_byte(&merged_code, 0x25 as u8)
            push_byte(&merged_code, (disp32 & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 8 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 16 as u32) & 0xFF as u32) as u8)
            push_byte(&merged_code, ((disp32 >> 24 as u32) & 0xFF as u32) as u8)
            
            push_linker_str(&dyn_sym_names, sym_name)
            dyn_sym_rvas[thunk_i] = (thunks_offset as u32 + thunk_i as u32 * 6 as u32) + 0x1000 as u32
            
            thunk_i = thunk_i + 1
            u_j = u_j + 1

        // Pad merged_code to dyn_offset so dyn_buf lands in the file exactly at the
        // VA (base_addr + dyn_offset) all the DT_* pointers above were computed with.
        while merged_code.len < dyn_offset:
            push_byte(&merged_code, 0 as u8)

        // Clean up temporary buffers
        if dynstr_buf.data != null as ptr[u8]:
            @free(dynstr_buf.data)
        if dynsym_buf.data != null as ptr[u8]:
            @free(dynsym_buf.data)
        if hash_buf.data != null as ptr[u8]:
            @free(hash_buf.data)
        if got_plt_buf.data != null as ptr[u8]:
            @free(got_plt_buf.data)
        if rela_plt_buf.data != null as ptr[u8]:
            @free(rela_plt_buf.data)
        if dynamic_buf.data != null as ptr[u8]:
            @free(dynamic_buf.data)
        @free(lib_str_offsets as ptr[u8])
        @free(sym_str_offsets as ptr[u8])
        @free(dyn_imports.data as ptr[u8])
        @free(dyn_libs.data as ptr[u8])

    // RFC 0017 ELF globals: lay out each object's writable .data block in a region that
    // follows merged_code + dyn_buf in the emitted image (code-start-relative offsets, so
    // the standard `target_va = base_addr + offset` resolution below applies unchanged).
    // Mirrors the COFF path, which appends globals to the end of .idata. Registered into
    // func_names/func_offsets BEFORE relocation resolution so OP_GLOBAL_ADDR relocs bind.
    mut elf_data_buf := new_byte_vec()
    // RFC 0030 P4: bytes of zero-initialized global storage that exist in memory only.
    // Stays 0 for PE and for ELF programs without large zero globals, so p_memsz keeps
    // equalling p_filesz and the emitted headers are unchanged.
    mut elf_bss_extent := 0 as i64
    if format == "elf64":
        let elf_data_base = merged_code.len + dyn_buf.len
        // 8-align the region base within the image.
        mut edb_pad := (8 as i64 - (elf_data_base % 8 as i64)) % 8 as i64
        while edb_pad > 0:
            push_byte(&elf_data_buf, 0 as u8)
            edb_pad = edb_pad - 1
        mut gobj_e := 0 as i64
        while gobj_e < objects.len:
            let gobj = objects.data[gobj_e]
            if gobj.data.len > 0:
                while ((elf_data_base + elf_data_buf.len) % 8 as i64) != 0 as i64:
                    push_byte(&elf_data_buf, 0 as u8)
                let region_off = elf_data_base + elf_data_buf.len
                gobj.data_va = base_addr + region_off as u64
                mut edb := 0 as i64
                while edb < gobj.data.len:
                    push_byte(&elf_data_buf, gobj.data.data[edb])
                    edb = edb + 1
                mut gsym_e := 0 as i64
                while gsym_e < gobj.symbols.len:
                    let gsym = &gobj.symbols.data[gsym_e]
                    if gsym.defined and gsym.section == 3 as i64:
                        push_linker_str(&func_names, gsym.name)
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (region_off as u64 + gsym.offset) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    gsym_e = gsym_e + 1
            gobj_e = gobj_e + 1
        // RFC 0030 P4: reserve .bss AFTER every file-backed block, virtual-only. The PT_LOAD
        // segment's p_memsz grows to cover it while p_filesz stays at the file size, so the
        // kernel maps the tail as anonymous zero pages. Mirrors the PE path exactly.
        mut ebss_cursor := elf_data_base + elf_data_buf.len
        mut ebobj_i := 0 as i64
        while ebobj_i < objects.len:
            let ebobj = objects.data[ebobj_i]
            if ebobj.bss_size > 0 as i64:
                while (ebss_cursor % 16 as i64) != 0 as i64:
                    ebss_cursor = ebss_cursor + 1 as i64
                ebobj.bss_va = base_addr + ebss_cursor as u64
                let ebase = ebss_cursor
                ebss_cursor = ebss_cursor + ebobj.bss_size
                mut ebsym_i := 0 as i64
                while ebsym_i < ebobj.symbols.len:
                    let ebsym = &ebobj.symbols.data[ebsym_i]
                    if ebsym.defined and ebsym.section == 4 as i64:
                        push_linker_str(&func_names, ebsym.name)
                        push_parsed_reloc(&func_offsets, ParsedReloc(offset: (ebase as u64 + ebsym.offset) as i64, sym_idx: 0 as u32, is_pc: false, addend: 0 as i64))
                    ebsym_i = ebsym_i + 1
            ebobj_i = ebobj_i + 1
        elf_bss_extent = ebss_cursor - (elf_data_base + elf_data_buf.len)

    // 3. Resolve & Apply Relocations
    mut has_reloc_error := false
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        mut r_i := 0 as i64
        while r_i < obj.relocs.len:
            let r = &obj.relocs.data[r_i]
            if r.sym_idx >= obj.sym_names.len as u32:
                r_i = r_i + 1
                continue
                
            let target_name = obj.sym_names.data[r.sym_idx]
            mut target_offset := -1 as i64
            
            mut search := 0 as i64
            while search < func_names.len:
                if func_names.data[search] == target_name:
                    target_offset = func_offsets.data[search].offset
                    break
                search = search + 1
                
            mut target_va := 0 as u64
            if target_offset == -1 as i64 and target_name == "syscall":
                mut search_ax := 0 as i64
                while search_ax < func_names.len:
                    if func_names.data[search_ax] == "ax_syscall":
                        target_offset = func_offsets.data[search_ax].offset
                        break
                    search_ax = search_ax + 1

            // RFC 0009 P3 Linux: an unresolved C-ABI runtime name X (extern decl or a
            // DLL redirect like ax_panic / ax_get_global_state_internal) binds to its
            // bundled AXIOM twin `ax_X` (the mangled symbol of `pub fn X`). Generalizes
            // the syscall -> ax_syscall mapping above. ELF-only: on COFF these names
            // are genuine ax_runtime.dll imports and must stay dynamic.
            if target_offset == -1 as i64 and format == "elf64":
                let twin_name = std.string.concat("ax_", target_name)
                mut search_tw := 0 as i64
                while search_tw < func_names.len:
                    if func_names.data[search_tw] == twin_name:
                        target_offset = func_offsets.data[search_tw].offset
                        break
                    search_tw = search_tw + 1
                @free(get_str_ptr(twin_name))

            if target_offset != -1 as i64:
                target_va = base_addr + target_offset as u64
            else:
                // Check if it is a dynamic import
                mut dyn_search := 0 as i64
                mut found_dyn := false
                while dyn_search < dyn_sym_names.len:
                    if dyn_sym_names.data[dyn_search] == target_name:
                        target_va = base_addr + (dyn_sym_rvas[dyn_search] - 0x1000 as u32) as u64
                        found_dyn = true
                        break
                    dyn_search = dyn_search + 1
                    
                if not found_dyn:
                    // RFC 0009 P3 Linux: Windows-API / ax_runtime.dll names with no
                    // bundled twin sit in dead code (their is_windows branches folded
                    // away, but whole-function DCE does not exist yet, so the emitted-
                    // but-unreachable bodies still carry the relocs). Patch 0 with a
                    // warning instead of failing the link. Everything else stays a
                    // hard error on both formats.
                    mut dead_win_import := false
                    if format == "elf64":
                        let dll_home = get_dll_for_symbol(target_name)
                        if dll_home == "kernel32.dll" or is_valid_runtime_dll_symbol(target_name):
                            dead_win_import = true
                    if dead_win_import:
                        ax_printf_local("warning: linker (elf64): dead Windows/runtime import '%s' patched to 0\n", (get_str_ptr(target_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        target_va = 0 as u64
                    else:
                        ax_printf_local("error: linker: unresolved external symbol '%s'\n", (get_str_ptr(target_name)) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
                        has_reloc_error = true
                        target_va = 0 as u64
                
            let rel_offset = (obj.va - base_addr) as i64 + r.offset
            if rel_offset + 4 as i64 > merged_code.len:
                r_i = r_i + 1
                continue
                
            if r.is_pc:
                let pc = base_addr + rel_offset as u64
                let val = (target_va as i64 - pc as i64 + r.addend) as u32
                write_u32_le(merged_code.data, rel_offset, val)
            else:
                if rel_offset + 8 as i64 <= merged_code.len:
                    let val = target_va + r.addend as u64
                    write_u64_le(merged_code.data, rel_offset, val)
                    
            r_i = r_i + 1
        i = i + 1
        
    // Find entry point RVA
    mut entry_rva := 0x1000 as u32
    mut entry_search := 0 as i64
    while entry_search < func_names.len:
        let fn_name = func_names.data[entry_search]
        if fn_name == "main" or fn_name == "_AX_main_main_v_v":
            let name_nt = x86_str_to_null_terminated(fn_name)
            let offset_val = func_offsets.data[entry_search].offset
            ax_printf_local("[Debug Linker Entry] Found entry fn=%s, offset=%d, RVA=%d\n", name_nt as i64, offset_val as i64, (0x1000 as i64 + offset_val) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            @free(name_nt)
            entry_rva = (0x1000 as i64 + offset_val) as u32
            break
        entry_search = entry_search + 1

    // RFC 0009 P2: a --shared DLL has no DllMain â†’ AddressOfEntryPoint = 0.
    if self.is_shared:
        entry_rva = 0 as u32
        
    // 4. Emit Executable
    let output_path_nt = x86_str_to_null_terminated(self.output_path)
    let file = fopen(output_path_nt as ptr[void], get_str_ptr("wb"))
    @free(output_path_nt)
    if file == null as ptr[void]:
        ax_puts_local("error: Linker could not write output file")
        return false
        
    if format == "coff":
        // Align code to FileAlignment (0x200)
        let orig_code_len = merged_code.len
        align_byte_vec(&merged_code, 0x200 as i64)
        
        let code_raw_size = merged_code.len as u32
        let idata_raw_size = (idata_buf.len as i64 + 0x1FF) as u32 & 0xFFFFFE00 as u32
        // VirtualSize must cover the .bss tail; SizeOfRawData still covers only the file
        // bytes. When there is no .bss this stays equal to idata_raw_size, so the emitted
        // headers are unchanged for every program that does not use the feature.
        mut idata_virt_size := idata_raw_size
        if bss_virt_extent as u32 > idata_virt_size:
            idata_virt_size = bss_virt_extent as u32
        align_byte_vec(&idata_buf, 0x200 as i64)
        
        let iat_rva = idata_rva as u32 + iat_offset as u32
        let iat_size = total_iat_size as u32
        
        mut K_count := 0 as u32
        if kernel32_imports.len > 0:
            K_count = K_count + 1 as u32
        if ax_runtime_imports.len > 0:
            K_count = K_count + 1 as u32
        if ucrtbase_imports.len > 0:
            K_count = K_count + 1 as u32
        let idt_size = (K_count + 1 as u32) * 20 as u32

        // RFC 0009 P2: build the export table (.edata) after .idata, when exporting.
        mut edata_buf := new_byte_vec()
        mut export_rva := 0 as u32
        mut export_virt_size := 0 as u32
        mut edata_raw_size := 0 as u32
        mut edata_file_off := 0 as u32
        let is_dll = self.is_shared
        if self.export_names.len > 0:
            export_rva = ((idata_rva as i64 + idata_raw_size as i64 + 0xFFF) & ~0xFFF) as u32
            let dll_base = linker_basename(self.output_path)
            build_export_edata(&self.export_names, &func_names, &func_offsets, export_rva, dll_base, &edata_buf)
            @free(get_str_ptr(dll_base))
            export_virt_size = edata_buf.len as u32
            edata_file_off = 0x400 as u32 + code_raw_size + idata_raw_size
            align_byte_vec(&edata_buf, 0x200 as i64)
            edata_raw_size = edata_buf.len as u32
            // NOT `is_dll = true` here. Having an export directory and BEING a DLL
            // are different facts: a PE executable is allowed to export symbols,
            // and Windows keys "is this a library" off IMAGE_FILE_DLL (0x2000) in
            // Characteristics alone. Forcing that bit on because exports exist made
            // every #[export]-containing EXECUTABLE unloadable â€” the loader rejects
            // it with "not a valid application for this OS platform" before main
            // ever runs. Only --shared decides the image kind.

        mut pe_headers := new_byte_vec()
        linker_build_pe_headers(&pe_headers, code_raw_size, idata_raw_size, entry_rva, idata_rva as u32, idata_raw_size, iat_rva, iat_size, export_rva, export_virt_size, edata_raw_size, edata_file_off, is_dll, idata_virt_size)

        fwrite(pe_headers.data as ptr[void], 1, pe_headers.len, file)
        fwrite(merged_code.data as ptr[void], 1, merged_code.len, file)
        if idata_buf.len > 0:
            fwrite(idata_buf.data as ptr[void], 1, idata_buf.len, file)
        if edata_buf.len > 0:
            fwrite(edata_buf.data as ptr[void], 1, edata_buf.len, file)

        @free(pe_headers.data)
        if edata_buf.data != null as ptr[u8]:
            @free(edata_buf.data)
    else:
        // elf64
        let entry_va = base_addr + (entry_rva - 0x1000 as u32) as u64
        mut elf_headers := new_byte_vec()
        
        mut dynamic_offset := 0 as u32
        mut dynamic_size := 0 as u32
        if dyn_buf.len > 0:
            // File offset of the .dynamic array = headers(512) + code up to dyn_buf
            // (dyn_file_off) + offset of .dynamic inside dyn_buf.
            dynamic_offset = (512 as i64 + dyn_file_off + offset_dynamic) as u32
            dynamic_size = size_dynamic as u32
            
        linker_build_elf_headers(&elf_headers, (merged_code.len + dyn_buf.len + elf_data_buf.len) as u32, entry_va, dynamic_offset, dynamic_size, elf_bss_extent as u32, self.is_shared)

        fwrite(elf_headers.data as ptr[void], 1, elf_headers.len, file)
        fwrite(merged_code.data as ptr[void], 1, merged_code.len, file)
        if dyn_buf.len > 0:
            fwrite(dyn_buf.data as ptr[void], 1, dyn_buf.len, file)
        // RFC 0017 ELF globals: writable data region (offsets registered pre-relocation).
        if elf_data_buf.len > 0:
            fwrite(elf_data_buf.data as ptr[void], 1, elf_data_buf.len, file)

        @free(elf_headers.data)
        
    fclose(file)
    
    // Free structures
    if merged_code.data != null as ptr[u8]:
        @free(merged_code.data)
    if idata_buf.data != null as ptr[u8]:
        @free(idata_buf.data)
    if dyn_buf.data != null as ptr[u8]:
        @free(dyn_buf.data)
    if elf_data_buf.data != null as ptr[u8]:
        @free(elf_data_buf.data)
        
    if dyn_sym_rvas != null as ptr[u32]:
        @free(dyn_sym_rvas as ptr[u8])
    if kernel32_hn_rvas != null as ptr[u32]:
        @free(kernel32_hn_rvas as ptr[u8])
    if ax_runtime_hn_rvas != null as ptr[u32]:
        @free(ax_runtime_hn_rvas as ptr[u8])
    if ucrtbase_hn_rvas != null as ptr[u32]:
        @free(ucrtbase_hn_rvas as ptr[u8])
        
    if kernel32_imports.data != null as ptr[str]:
        @free(kernel32_imports.data as ptr[u8])
    if ax_runtime_imports.data != null as ptr[str]:
        @free(ax_runtime_imports.data as ptr[u8])
    if ucrtbase_imports.data != null as ptr[str]:
        @free(ucrtbase_imports.data as ptr[u8])
    if dyn_sym_names.data != null as ptr[str]:
        @free(dyn_sym_names.data as ptr[u8])
        
    i = 0
    while i < objects.len:
        let obj = objects.data[i]
        if obj.text.data != null as ptr[u8]:
            @free(obj.text.data)
        if obj.rdata.data != null as ptr[u8]:
            @free(obj.rdata.data)
        if obj.symbols.data != null as ptr[LinkerSymbol]:
            @free(obj.symbols.data as ptr[u8])
        if obj.sym_names.data != null as ptr[str]:
            @free(obj.sym_names.data as ptr[u8])
        if obj.relocs.data != null as ptr[ParsedReloc]:
            @free(obj.relocs.data as ptr[u8])
        @free(obj as ptr[u8])
        i = i + 1
        
    @free(objects.data as ptr[u8])
    @free(func_names.data as ptr[u8])
    @free(func_offsets.data as ptr[u8])
    if has_reloc_error:
        return false
    return true
// bootstrap/stage1/fmt.ax
// AXIOM canonical source code formatter written in AXIOM itself.


pub const FMT_TOKEN_EOF: u8 = 0
pub const FMT_TOKEN_NEWLINE: u8 = 1
pub const FMT_TOKEN_WHITESPACE: u8 = 2
pub const FMT_TOKEN_COMMENT: u8 = 3
pub const FMT_TOKEN_STRING: u8 = 4
pub const FMT_TOKEN_CHAR: u8 = 5
pub const FMT_TOKEN_NUMBER: u8 = 6
pub const FMT_TOKEN_OPERATOR: u8 = 7
pub const FMT_TOKEN_PUNCTUATION: u8 = 8
pub const FMT_TOKEN_IDENT: u8 = 9

pub struct FmtToken:
    kind: u8
    text: str

pub struct FmtTokenVec:
    data: ptr[FmtToken]
    len: i64
    cap: i64

pub fn new_fmt_token_vec() -> FmtTokenVec:
    return FmtTokenVec(data: null as ptr[FmtToken], len: 0, cap: 0)

pub fn push(mut self: FmtTokenVec, t: FmtToken):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 24) as ptr[FmtToken] // FmtToken is 24 bytes (1B kind, 7B padding, 16B str (8B ptr + 8B len))
        if self.data != null as ptr[FmtToken]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 24)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = t
    self.len = self.len + 1

fn fmt_is_digit(b: u8) -> bool:
    return b >= 48 as u8 and b <= 57 as u8

fn fmt_is_hex_digit(b: u8) -> bool:
    return fmt_is_digit(b) or (b >= 97 as u8 and b <= 102 as u8) or (b >= 65 as u8 and b <= 70 as u8)

fn fmt_is_oct_digit(b: u8) -> bool:
    return b >= 48 as u8 and b <= 55 as u8

fn fmt_is_ident_start(b: u8) -> bool:
    return (b >= 97 as u8 and b <= 122 as u8) or (b >= 65 as u8 and b <= 90 as u8) or b == 95 as u8 or b == 64 as u8 // '@'

fn fmt_is_ident_part(b: u8) -> bool:
    return fmt_is_ident_start(b) or fmt_is_digit(b)

fn is_punctuation(s: str) -> bool:
    if s == "." or s == "," or s == ":" or s == ";" or s == "(" or s == ")" or s == "[" or s == "]" or s == "{" or s == "}" or s == "..":
        return true
    return false

fn match_operator_or_punct(src: str, i: i64, n: i64) -> i64:
    // Try two-character operators first
    if i + 1 < n:
        let two = std.string.slice(src, i, i + 2)
        if two == "**" or two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "<<" or two == ">>" or two == ":=" or two == "+=" or two == "-=" or two == "*=" or two == "/=" or two == "%=" or two == "->" or two == "..":
            return 2 as i64

    // Single-character operators/punctuations
    let b = src[i] as u8
    if b == 43 or b == 45 or b == 42 or b == 47 or b == 37 or b == 60 or b == 62 or b == 61 or b == 38 or b == 124 or b == 94 or b == 126 or b == 33 or b == 46 or b == 44 or b == 58 or b == 59 or b == 40 or b == 41 or b == 91 or b == 93 or b == 123 or b == 125:
        return 1 as i64

    return 0 as i64

pub fn scan_tokens(src: str) -> FmtTokenVec:
    mut tokens := new_fmt_token_vec()
    let n = std.string.len(src)
    mut i := 0 as i64

    while i < n:
        let b = src[i] as u8

        // 1. Newline
        if b == 10 as u8:
            tokens.push(FmtToken(kind: FMT_TOKEN_NEWLINE, text: "\n"))
            i = i + 1
            continue

        // 2. Line Comment
        if b == 47 as u8 and i + 1 < n and (src[i + 1] as u8 == 47 as u8):
            let start = i
            i = i + 2
            while i < n and (src[i] as u8 != 10 as u8):
                i = i + 1
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_COMMENT, text: text))
            continue

        // 3. Whitespace
        if b == 32 as u8 or b == 9 as u8 or b == 13 as u8:
            let start = i
            while i < n:
                let ws = src[i] as u8
                if ws == 32 as u8 or ws == 9 as u8 or ws == 13 as u8:
                    i = i + 1
                else:
                    break
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_WHITESPACE, text: text))
            continue

        // 4. String Literal
        if b == 34 as u8: // '"'
            let start = i
            i = i + 1
            mut escaped := false
            while i < n:
                if escaped:
                    escaped = false
                elif src[i] as u8 == 92 as u8: // '\\'
                    escaped = true
                elif src[i] as u8 == 34 as u8:
                    i = i + 1
                    break
                i = i + 1
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_STRING, text: text))
            continue

        // 5. Character Literal
        if b == 39 as u8: // '\''
            let start = i
            i = i + 1
            mut escaped := false
            while i < n:
                if escaped:
                    escaped = false
                elif src[i] as u8 == 92 as u8:
                    escaped = true
                elif src[i] as u8 == 39 as u8:
                    i = i + 1
                    break
                i = i + 1
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_CHAR, text: text))
            continue

        // 6. Number Literal
        if fmt_is_digit(b):
            let start = i
            if b == 48 as u8 and i + 1 < n: // '0'
                let next = src[i + 1] as u8
                if next == 120 as u8 or next == 88 as u8: // 'x' / 'X'
                    i = i + 2
                    while i < n and (fmt_is_hex_digit(src[i] as u8) or (src[i] as u8 == 95 as u8)):
                        i = i + 1
                    let text = std.string.slice(src, start, i)
                    tokens.push(FmtToken(kind: FMT_TOKEN_NUMBER, text: text))
                    continue
                elif next == 111 as u8 or next == 79 as u8: // 'o' / 'O'
                    i = i + 2
                    while i < n and (fmt_is_oct_digit(src[i] as u8) or (src[i] as u8 == 95 as u8)):
                        i = i + 1
                    let text = std.string.slice(src, start, i)
                    tokens.push(FmtToken(kind: FMT_TOKEN_NUMBER, text: text))
                    continue
                elif next == 98 as u8 or next == 66 as u8: // 'b' / 'B'
                    i = i + 2
                    while i < n:
                        let bin = src[i] as u8
                        if bin == 48 as u8 or bin == 49 as u8 or bin == 95 as u8:
                            i = i + 1
                        else:
                            break
                    let text = std.string.slice(src, start, i)
                    tokens.push(FmtToken(kind: FMT_TOKEN_NUMBER, text: text))
                    continue

            while i < n:
                let num = src[i] as u8
                if fmt_is_digit(num) or num == 95 as u8:
                    i = i + 1
                else:
                    break

            if i < n and (src[i] as u8 == 46 as u8) and i + 1 < n and fmt_is_digit(src[i + 1] as u8):
                i = i + 1 // consume '.'
                while i < n:
                    let num = src[i] as u8
                    if fmt_is_digit(num) or num == 95 as u8:
                        i = i + 1
                    else:
                        break

            if i < n:
                let exp = src[i] as u8
                if exp == 101 as u8 or exp == 69 as u8:
                    i = i + 1
                    if i < n:
                        let sign = src[i] as u8
                        if sign == 43 as u8 or sign == 45 as u8:
                            i = i + 1
                    while i < n and fmt_is_digit(src[i] as u8):
                        i = i + 1
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_NUMBER, text: text))
            continue

        // 7. Operators & Punctuations
        let op_len = match_operator_or_punct(src, i, n)
        if op_len > 0:
            let text = std.string.slice(src, i, i + op_len)
            mut tk := FMT_TOKEN_OPERATOR
            if is_punctuation(text):
                tk = FMT_TOKEN_PUNCTUATION
            tokens.push(FmtToken(kind: tk, text: text))
            i = i + op_len
            continue

        // 8. Identifiers
        if fmt_is_ident_start(b):
            let start = i
            while i < n and fmt_is_ident_part(src[i] as u8):
                i = i + 1
            let text = std.string.slice(src, start, i)
            tokens.push(FmtToken(kind: FMT_TOKEN_IDENT, text: text))
            continue

        // Fallback
        let text = std.string.slice(src, i, i + 1)
        tokens.push(FmtToken(kind: FMT_TOKEN_IDENT, text: text))
        i = i + 1

    return tokens

pub struct Formatter:
    indent_width: i64

pub fn new_formatter() -> Formatter:
    return Formatter(indent_width: 4 as i64)

pub fn format(self: Formatter, src: str) -> str:
    // Core formatting pipeline in pure AXIOM
    mut raw_tokens := scan_tokens(src)
    mut tokens := new_fmt_token_vec()
    
    // Filter inline whitespace, keeping only structural indentation whitespace
    mut k := 0 as i64
    while k < raw_tokens.len:
        let tok = raw_tokens.data[k]
        if tok.kind == FMT_TOKEN_WHITESPACE:
            mut is_indent := false
            if k == 0:
                is_indent = true
            elif k > 0 and raw_tokens.data[k - 1].kind == FMT_TOKEN_NEWLINE:
                is_indent = true
                
            if is_indent:
                tokens.push(tok)
        else:
            tokens.push(tok)
        k = k + 1
    if raw_tokens.data != null as ptr[FmtToken]:
        @free(raw_tokens.data as ptr[u8])

    if tokens.len == 0:
        return ""

    // Calculate dynamic buffer size with padding for injected spacing
    mut total_size := 0 as i64
    k = 0
    while k < tokens.len:
        total_size = total_size + std.string.len(tokens.data[k].text) + 2 as i64
        k = k + 1

    let out_buf = @alloc(total_size + 16 as i64) as ptr[u8]
    mut out_idx := 0 as i64
    k = 0
    while k < tokens.len:
        let tok = tokens.data[k]
        let t_len = std.string.len(tok.text)
        @memcpy(((out_buf as i64) + out_idx) as ptr[u8], tok.text as ptr[u8], t_len)
        out_idx = out_idx + t_len
        
        if k + 1 < tokens.len:
            let next_tok = tokens.data[k + 1]
            
            // Check if spacing is between regular semantic tokens
            let is_regular_tok = (tok.kind != FMT_TOKEN_NEWLINE and tok.kind != FMT_TOKEN_WHITESPACE and tok.kind != FMT_TOKEN_COMMENT)
            let is_regular_next = (next_tok.kind != FMT_TOKEN_NEWLINE and next_tok.kind != FMT_TOKEN_WHITESPACE and next_tok.kind != FMT_TOKEN_COMMENT)
            
            if is_regular_tok and is_regular_next:
                mut space := false
                
                if tok.kind == FMT_TOKEN_IDENT or tok.kind == FMT_TOKEN_NUMBER:
                    if next_tok.kind == FMT_TOKEN_IDENT or next_tok.kind == FMT_TOKEN_NUMBER:
                        space = true
                    elif next_tok.kind == FMT_TOKEN_OPERATOR:
                        if next_tok.text != "." and next_tok.text != "(" and next_tok.text != "[" and next_tok.text != ")" and next_tok.text != "]":
                            space = true
                            
                elif tok.kind == FMT_TOKEN_OPERATOR:
                    if tok.text != "." and tok.text != "!" and tok.text != "~" and next_tok.text != ")" and next_tok.text != "]" and next_tok.text != "," and next_tok.text != ":":
                        // Check for unary minus context
                        mut is_unary_minus := false
                        if tok.text == "-":
                            if k == 0 as i64:
                                is_unary_minus = true
                            else:
                                let prev_tok = tokens.data[k - 1]
                                if prev_tok.kind == FMT_TOKEN_OPERATOR or prev_tok.text == "=" or prev_tok.text == "," or prev_tok.text == "(" or prev_tok.text == "[" or prev_tok.text == ":" or prev_tok.text == "return":
                                    is_unary_minus = true
                        if not is_unary_minus:
                            space = true
                            
                elif next_tok.kind == FMT_TOKEN_OPERATOR:
                    if next_tok.text != "." and tok.text != "(" and tok.text != "[" and next_tok.text != ")" and next_tok.text != "]":
                        space = true
                        
                if tok.text == "," or tok.text == ":":
                    space = true
                    
                if space:
                    out_buf[out_idx] = 32 as u8 // space
                    out_idx = out_idx + 1
        k = k + 1

    out_buf[out_idx] = 0 as u8
    
    // Clean up tokens
    if tokens.data != null as ptr[FmtToken]:
        @free(tokens.data as ptr[u8])

    return out_buf as str
// bootstrap/stage1/lsp.ax
// AXIOM Language Server Protocol (LSP) server implemented 100% in AXIOM.
// Supports standard JSON-RPC framing, initialize, shutdown, hover, and definition stubs.


extern "C" fn exit(code: i32)
extern "C" fn fflush(stream: ptr[void]) -> i32
extern "C" fn puts(s: str) -> i32
extern "C" fn ax_i64_to_str(val: i64) -> str

// Global active documents cache pointer (stored as u64 to bypass CGen global type bugs)
mut g_documents: u64 = 0 as u64

fn lsp_send_message(msg: str):
    let out = std.io.stdout()
    let len = msg.len
    
    // Convert len to string using ax_i64_to_str
    let len_str = ax_i64_to_str(len)
    
    // Headers
    let header = std.string.concat("Content-Length: ", std.string.concat(std.string.concat("", len_str), "\r\n\r\n"))
    let r1 = out.write_all(header)
    let r2 = out.write_all(msg)
    
    @free(get_str_ptr(header))
    fflush(null as ptr[void])

fn lsp_parse_content_length(header: str) -> i64:
    let prefix = "Content-Length:"
    if std.string.starts_with(header, prefix):
        let val_part = std.string.slice(header, std.string.len(prefix), std.string.len(header))
        let trimmed = std.string.trim(val_part)
        let len_res = std.string.to_i64(trimmed)
        mut len := 0 as i64
        if len_res.is_ok():
            len = len_res.unwrap()
        @free(get_str_ptr(val_part))
        @free(get_str_ptr(trimmed))
        return len
    return 0 as i64

fn lsp_read_message(mut in_file: File) -> str:
    // Read Content-Length header
    let buf = @alloc(1024) as ptr[u8]
    mut idx := 0 as i64
    mut content_len := 0 as i64
    
    mut loop := true
    while loop:
        let r = in_file.read((buf as i64 + idx) as ptr[u8], 1)
        if r.is_err() or r.unwrap() == 0 as i64:
            @free(buf)
            return ""
        
        let c = buf[idx]
        if c == 10 as u8 and idx > 0 as i64 and buf[idx - 1] == 13 as u8:
            // End of line
            buf[idx + 1] = 0 as u8
            let line = buf as str
            let line_len = lsp_parse_content_length(line)
            if line_len > 0 as i64:
                content_len = line_len
            
            let trimmed_line = std.string.trim(line)
            if std.string.len(trimmed_line) == 0 as i64:
                // End of headers (\r\n\r\n)
                loop = false
            @free(get_str_ptr(trimmed_line))
            idx = 0 as i64
        else:
            idx = idx + 1 as i64
            if idx >= 1024 as i64:
                @free(buf)
                return ""
    
    @free(buf)
    
    if content_len <= 0 as i64:
        return ""
    
    // Read body
    let body_buf = @alloc(content_len + 1) as ptr[u8]
    mut read_bytes := 0 as i64
    while read_bytes < content_len:
        let r = in_file.read((body_buf as i64 + read_bytes) as ptr[u8], content_len - read_bytes)
        if r.is_err() or r.unwrap() == 0 as i64:
            @free(body_buf)
            return ""
        read_bytes = read_bytes + r.unwrap()
    body_buf[content_len] = 0 as u8
    
    let body = body_buf as str
    return body

fn lsp_json_get_field(json: str, key: str) -> str:
    let search = std.string.concat("\"", std.string.concat(key, "\":"))
    let idx = std.string.index_of(json, search)
    @free(get_str_ptr(search))
    if idx == -1 as i64:
        return ""
    
    let start = idx + std.string.len(search)
    let remains = std.string.slice(json, start, std.string.len(json))
    let trimmed = std.string.trim(remains)
    @free(get_str_ptr(remains))
    
    if std.string.len(trimmed) == 0 as i64:
        @free(get_str_ptr(trimmed))
        return ""
        
    // If string literal
    if trimmed[0] as u8 == 34 as u8: // '"'
        mut i := 1 as i64
        mut escaped := false
        while i < std.string.len(trimmed):
            let c = trimmed[i] as u8
            if escaped:
                escaped = false
            elif c == 92 as u8: // '\\'
                escaped = true
            elif c == 34 as u8: // '"'
                let val = std.string.slice(trimmed, 1 as i64, i)
                @free(get_str_ptr(trimmed))
                return val
            i = i + 1 as i64
            
    // If number or raw value
    mut end_idx := 0 as i64
    while end_idx < std.string.len(trimmed):
        let c = trimmed[end_idx] as u8
        if c == 44 as u8 or c == 125 as u8 or c == 93 as u8 or c == 13 as u8 or c == 10 as u8: // ',' or '}' or ']'
            break
        end_idx = end_idx + 1 as i64
        
    let val = std.string.slice(trimmed, 0 as i64, end_idx)
    let clean = std.string.trim(val)
    @free(get_str_ptr(trimmed))
    @free(get_str_ptr(val))
    return clean

pub fn lsp_start_server():
    // Initialize global documents HashMap on the heap (size of HashMap is 6 fields * 8 bytes = 48)
    let size = 48 as u64
    let map_ptr = @alloc(size) as ptr[HashMap[str, str]]
    map_ptr.* = new_hashmap[str, str]()
    g_documents = map_ptr as u64

    let in_file = std.io.stdin()
    
    mut loop := true
    while loop:
        let msg_str = lsp_read_message(in_file)
        if std.string.len(msg_str) == 0 as i64:
            loop = false
            continue
        
        let req_id = lsp_json_get_field(msg_str, "id")
        let method = lsp_json_get_field(msg_str, "method")
        
        if method == "initialize":
            let resp = std.string.concat(
                "{\"jsonrpc\":\"2.0\",\"id\":",
                std.string.concat(req_id, ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true}}}")
            )
            lsp_send_message(resp)
            @free(get_str_ptr(resp))
        
        elif method == "shutdown":
            let resp = std.string.concat(
                "{\"jsonrpc\":\"2.0\",\"id\":",
                std.string.concat(req_id, ",\"result\":{}}")
            )
            lsp_send_message(resp)
            @free(get_str_ptr(resp))
        
        elif method == "exit":
            @free(get_str_ptr(req_id))
            @free(get_str_ptr(method))
            @free(get_str_ptr(msg_str))
            exit(0 as i32)
        
        elif method == "textDocument/didOpen":
            let uri = lsp_json_get_field(msg_str, "uri")
            let text = lsp_json_get_field(msg_str, "text")
            if std.string.len(uri) > 0 as i64:
                let docs = g_documents as ptr[HashMap[str, str]]
                (docs.*).insert(uri, text)
                
                // Publish empty diagnostics for now to satisfy client
                let diag = std.string.concat(
                    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"",
                    std.string.concat(uri, "\",\"diagnostics\":[]}}")
                )
                lsp_send_message(diag)
                @free(get_str_ptr(diag))
            else:
                @free(get_str_ptr(text))
            @free(get_str_ptr(uri))
        
        elif method == "textDocument/didChange":
            let uri = lsp_json_get_field(msg_str, "uri")
            let text = lsp_json_get_field(msg_str, "text")
            if std.string.len(uri) > 0 as i64:
                let docs = g_documents as ptr[HashMap[str, str]]
                (docs.*).insert(uri, text)
                
                // Publish empty diagnostics
                let diag = std.string.concat(
                    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"",
                    std.string.concat(uri, "\",\"diagnostics\":[]}}")
                )
                lsp_send_message(diag)
                @free(get_str_ptr(diag))
            else:
                @free(get_str_ptr(text))
            @free(get_str_ptr(uri))
        
        elif method == "textDocument/hover":
            let resp = std.string.concat(
                "{\"jsonrpc\":\"2.0\",\"id\":",
                std.string.concat(req_id, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```axiom\\n(hover) self-hosted\\n```\"}}}")
            )
            lsp_send_message(resp)
            @free(get_str_ptr(resp))
        
        elif method == "textDocument/definition":
            let resp = std.string.concat(
                "{\"jsonrpc\":\"2.0\",\"id\":",
                std.string.concat(req_id, ",\"result\":null}")
            )
            lsp_send_message(resp)
            @free(get_str_ptr(resp))
        
        else:
            if std.string.len(req_id) > 0 as i64:
                let resp = std.string.concat(
                    "{\"jsonrpc\":\"2.0\",\"id\":",
                    std.string.concat(req_id, ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}")
                )
                lsp_send_message(resp)
                @free(get_str_ptr(resp))
        
        @free(get_str_ptr(req_id))
        @free(get_str_ptr(method))
        @free(get_str_ptr(msg_str))
// bootstrap/stage1/main_air.ax
// Test harness entry point for AXIOM self-hosted compiler & driver


// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
extern "C" fn puts(s: ptr[u8]) -> i32
extern "C" fn system(command: ptr[void]) -> i32
// extern "C" fn snprintf(buf: ptr[void], size: i64, format: ptr[u8], a1: ptr[void], a2: ptr[void]) -> i32
extern "C" fn remove(filename: ptr[void]) -> i32
extern "C" fn fflush(stream: ptr[void]) -> i32
// --time: CLOCKS_PER_SEC=1000 on Windows, so clock() ~ wall-clock ms since start.
extern "C" fn clock() -> i64

// --time helper: print "[time] <label>: <ms>" and return the current tick to reset
// the caller's running marker. `on` gates the whole thing so it is inert without --time.
fn time_phase(on: bool, label: str, prev: i64) -> i64:
    if not on:
        return prev
    let now = clock()
    ax_printf_local("[time] %s: %d ms\n", get_str_ptr(label) as i64, (now - prev) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    return now
extern "C" fn fputs(s: ptr[u8], stream: ptr[void]) -> i32


fn print_inst(mut inst: AirInst, call_count_ptr: ptr[u32]):
    let op = inst.opcode
    if op == OP_NOP:
        return

    if op == OP_RETURN:
        if inst.src1 != 0 as u32:
            ax_printf_local("    ret %%%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_puts_local("    ret")
    elif op == OP_JUMP:
        ax_printf_local("    jump block_%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == OP_BRANCH:
        ax_printf_local("    branch %%%d block_%d block_%d\n", inst.src1 as i64, inst.src2 as i64, inst.dest as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        let mnemonic = opcode_mnemonic(op)
        let has_dest = (inst.dest != 0 as u32)
        let has_src1 = (inst.src1 != 0 as u32)
        let has_src2 = (inst.src2 != 0 as u32)
        let is_binary = opcode_is_binary_alu(op)

        if has_dest:
            mut type_id := inst.type_id
            if op == OP_CALL or op == OP_INDEX or op == OP_DEREF or op == OP_CAST or op == OP_AWAIT:
                type_id = 0 as u16

            if type_id != 0 as u16:
                ax_printf_local("    %%%d: t%d = %s", inst.dest as i64, type_id as i64, (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_printf_local("    %%%d = %s", inst.dest as i64, (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_printf_local("    %s", (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        if is_binary and has_src1 and has_src2:
            ax_printf_local(" %%%d, %%%d\n", inst.src1 as i64, inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src1 and has_src2:
            ax_printf_local(" %%%d, %%%d\n", inst.src1 as i64, inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src1:
            ax_printf_local(" %%%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src2:
            ax_printf_local(" %%%d\n", inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_puts_local("")

fn print_block(f: AirFunc, mut bb: BasicBlock, call_count_ptr: ptr[u32]):
    ax_printf_local("  block_%d:", bb.id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    if bb.is_entry and bb.is_exit:
        ax_puts_local("  ; entry exit")
    elif bb.is_entry:
        ax_puts_local("  ; entry")
    elif bb.is_exit:
        ax_puts_local("  ; exit")
    else:
        ax_puts_local("")

    mut i := 0 as i64
    while i < bb.instrs_len as i64:
        let inst_idx = f.block_instrs.data[bb.instrs_start as i64 + i]
        if inst_idx < f.insts.len as u32:
            let inst = f.insts.data[inst_idx as i64]
            print_inst(inst, call_count_ptr)
        i = i + 1

fn print_func(f: AirFunc):
    ax_printf_local("fn @%d(", f.name as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut i := 0 as i64
    while i < f.params.len:
        if i > 0:
            ax_printf_local(", ", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_printf_local("t%d", f.params.data[i] as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        i = i + 1
    ax_printf_local(")", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    if f.ret_type != 0 as u32:
        ax_printf_local(" -> t%d", f.ret_type as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    ax_puts_local(":")

    mut call_count := 0 as u32

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let bb = f.blocks.data[bi]
        print_block(f, bb, &call_count)
        bi = bi + 1

fn print_module(mod: AirModule):
    mut i := 0 as i64
    while i < mod.funcs.len:
        if i > 0:
            ax_puts_local("")
        print_func(mod.funcs.data[i])
        i = i + 1

// A file the build CANNOT proceed without. read_file_content returns "" on
// failure, which is indistinguishable from an empty file, so every caller of it
// for a required input silently compiled against nothing. Counting the failures
// here lets the driver halt for the same reason BUG#53 made parse errors halt:
// a pipeline fed garbage produces garbage far from the real cause.
fn read_required_file(path: str, fails: ptr[i64]) -> str:
    let content = read_file_content(path)
    if std.string.len(content) == 0:
        fails[0] = fails[0] + 1 as i64
    return content

fn read_file_content(path: str) -> str:
    let r = std.io.open(path)
    if r.is_ok():
        let file = r.unwrap()
        let r2 = file.read_all()
        if r2.is_ok():
            // NOTE: returning the generic .unwrap() directly (not via an
            // intermediate `let content = ...`) sidesteps a stage0 (Go) inference
            // bug where a let-bound generic-method-call result is typed as 0 in
            // the check pass once the type table grows â€” which otherwise caps how
            // much code can be added to stage1 ("stage0 ceiling"). See knowledge/bugs.md.
            return r2.unwrap()
        else:
            // Name the FILE. Both arms used to print only the errno-ish string, so a
            // failed stdlib bundle produced eight identical anonymous lines --
            // `Error: open failed:` with nothing after it -- which says neither what
            // was being opened nor why. CLAUDE.md Â§8: diagnostics must be actionable.
            ax_puts_local("error: cannot read source file:")
            ax_puts_local(path)
            ax_puts_local(r2.unwrap_err())
    else:
        ax_puts_local("error: cannot open source file:")
        ax_puts_local(path)
        ax_puts_local(r.unwrap_err())
        // The CWD note belongs ONLY on paths the COMPILER resolved for itself. For a
        // path the user typed, the file simply does not exist and the note points at
        // a cause that is not there -- and a misleading note is worse than none, which
        // is the exact failure it was added to prevent. `axc build typo.ax` printing
        // "run it from the repository root" would send someone hunting a directory
        // problem instead of reading the filename.
        let n = std.string.len(path)
        if n > 4:
            let p = get_str_ptr(path)
            let is_std = (p[0] == 's' as u8 and p[1] == 't' as u8 and p[2] == 'd' as u8 and p[3] == '/' as u8)
            let is_boot = (p[0] == 'b' as u8 and p[1] == 'o' as u8 and p[2] == 'o' as u8 and p[3] == 't' as u8)
            if is_std or is_boot:
                ax_puts_local("note: the compiler resolves std/*.ax and imported modules relative to the CURRENT DIRECTORY -- run it from the repository root")
    return ""

fn write_file_content(path: str, content: str) -> bool:
    let r = std.io.create(path)
    if r.is_ok():
        let file = r.unwrap()
        let r2 = file.write_all(content)
        if r2.is_ok():
            return true
    return false

fn match_prefix(s: str, i: i64, prefix: str) -> bool:
    let s_ptr = get_str_ptr(s)
    let p_ptr = get_str_ptr(prefix)
    let s_len = std.string.len(s)
    let p_len = std.string.len(prefix)
    if i + p_len > s_len:
        return false
    mut j := 0 as i64
    while j < p_len:
        if s_ptr[i + j] != p_ptr[j]:
            return false
        j = j + 1 as i64
    return true

fn strip_imports(s: str) -> str:
    let s_len = std.string.len(s)
    ax_printf_local("[Debug strip_imports] Entering, len=%d\n", s_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    let s_ptr = get_str_ptr(s)
    let out_buf = @alloc(s_len + 1 as i64) as ptr[u8]
    mut out_idx := 0 as i64
    mut i := 0 as i64
    
    while i < s_len:
        mut is_line_start := false
        if i == 0 as i64:
            is_line_start = true
        elif s_ptr[i - 1 as i64] == 10 as u8:
            is_line_start = true
            
        mut skip_line := false
        if is_line_start:
            if match_prefix(s, i, "import std"):
                skip_line = true
                
        if skip_line:
            while i < s_len and s_ptr[i] != 10 as u8:
                i = i + 1 as i64
            if i < s_len and s_ptr[i] == 10 as u8:
                i = i + 1 as i64
        else:
            out_buf[out_idx] = s_ptr[i]
            out_idx = out_idx + 1 as i64
            i = i + 1 as i64
            
    out_buf[out_idx] = 0 as u8
    ax_puts_local("[Debug strip_imports] Finished loop")
    fflush(null as ptr[void])
    let res = out_buf as str
    ax_puts_local("[Debug strip_imports] Cast finished")
    fflush(null as ptr[void])
    return res

fn strip_package_prefixes(s: str) -> str:
    // BUG#26: the prefix patterns are built at runtime via concat so this
    // function's OWN source never contains the literal qualified prefixes (e.g.
    // "std.string."). Otherwise, when the self-hosting driver strips THIS file to
    // build the next stage, it would blank these very patterns (replace(r, "", "")
    // is a no-op), breaking all prefix stripping in stage2 -> every std.* call
    // would survive as an unresolved field-expr and become a self-call.
    // "std." / ".rest." / ":" pieces do not match any prefix pattern, so they
    // survive the self-strip, and concat reconstitutes the real patterns at runtime.
    let p = "std."
    let r0 = std.string.replace(s, std.string.concat(":", ":"), ".")
    let r1 = std.string.replace(r0, std.string.concat(p, "mem.alloc."), "")
    let r2 = std.string.replace(r1, std.string.concat(p, "scheduler."), "")
    let r3 = std.string.replace(r2, std.string.concat(p, "os.win32."), "")
    let r4 = std.string.replace(r3, std.string.concat(p, "os.linux_sys."), "")
    let r5 = std.string.replace(r4, std.string.concat(p, "os."), "")
    let r6 = std.string.replace(r5, std.string.concat(p, "string."), "")
    let r7 = std.string.replace(r6, std.string.concat(p, "io."), "")
    let r8 = std.string.replace(r7, std.string.concat(p, "net."), "")
    return r8



extern "C" fn GetCommandLineA() -> ptr[u8]
// Linux argv acquisition (RFC 0009 P3): the ELF `main` IS the entry, so the kernel's
// stack-passed argc/argv is clobbered by main's prologue before get_freestanding_args
// runs. Read /proc/self/cmdline instead (NUL-separated argv). syscall is already bundled
// (std/os.ax); redeclared here so this module typechecks the Linux else branch.
extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64

fn local_slice_to_ptr(data: ptr[u8], len: i64) -> ptr[u8]:
    let res = @alloc(len + 1) as ptr[u8]
    @memcpy(res, data, len)
    res[len] = 0 as u8
    return res

fn populate_str_in_place(s_ptr: ptr[u8], s_len: i64, dest: ptr[str]):
    let out_bytes = dest as ptr[u8]
    let ptr_val = s_ptr as i64
    out_bytes[0] = (ptr_val & 0xFF) as u8
    out_bytes[1] = ((ptr_val >> 8) & 0xFF) as u8
    out_bytes[2] = ((ptr_val >> 16) & 0xFF) as u8
    out_bytes[3] = ((ptr_val >> 24) & 0xFF) as u8
    out_bytes[4] = ((ptr_val >> 32) & 0xFF) as u8
    out_bytes[5] = ((ptr_val >> 40) & 0xFF) as u8
    out_bytes[6] = ((ptr_val >> 48) & 0xFF) as u8
    out_bytes[7] = ((ptr_val >> 56) & 0xFF) as u8

    out_bytes[8] = (s_len & 0xFF) as u8
    out_bytes[9] = ((s_len >> 8) & 0xFF) as u8
    out_bytes[10] = ((s_len >> 16) & 0xFF) as u8
    out_bytes[11] = ((s_len >> 24) & 0xFF) as u8
    out_bytes[12] = ((s_len >> 32) & 0xFF) as u8
    out_bytes[13] = ((s_len >> 40) & 0xFF) as u8
    out_bytes[14] = ((s_len >> 48) & 0xFF) as u8
    out_bytes[15] = ((s_len >> 56) & 0xFF) as u8

fn is_space_ansi(c: u8) -> bool:
    if c == ' ' as u8:
        return true
    if c == '\t' as u8:
        return true
    if c == '\r' as u8:
        return true
    if c == '\n' as u8:
        return true
    return false

fn get_freestanding_args(mut out_argc: ptr[i32]) -> ptr[str]:
    let args = @alloc(64 * 16) as ptr[str]
    mut count := 0 as i64
    if @compiler_intrinsic("is_windows"):
        let cmdline = GetCommandLineA()
        if cmdline != null as ptr[u8]:
            mut i := 0 as i64
            while cmdline[i] != 0 as u8 and count < 64:
                while is_space_ansi(cmdline[i]):
                    i = i + 1
                if cmdline[i] == 0 as u8:
                    break
                let start = i
                mut in_quotes := false
                while cmdline[i] != 0 as u8:
                    let ch = cmdline[i]
                    if ch == '"' as u8:
                        in_quotes = not in_quotes
                    else:
                        if not in_quotes:
                            if is_space_ansi(ch):
                                break
                    i = i + 1
                let arg_len = i - start
                mut final_ptr := ((cmdline as i64) + start) as ptr[u8]
                mut final_len := arg_len
                
                mut is_quoted := false
                if arg_len >= 2:
                    if cmdline[start] == '"' as u8:
                        if cmdline[i - 1] == '"' as u8:
                            is_quoted = true
                if is_quoted:
                    final_ptr = ((cmdline as i64) + start + 1) as ptr[u8]
                    final_len = arg_len - 2
                let s_ptr = local_slice_to_ptr(final_ptr, final_len)
                populate_str_in_place(s_ptr, final_len, ((args as i64) + count * 16) as ptr[str])
                count = count + 1
    else:
        // Linux: read /proc/self/cmdline (NUL-separated argv). SYS_open=2 (O_RDONLY=0),
        // SYS_read=0, SYS_close=3. Mirrors std/os.ax::linux_read_file. "/proc/self/cmdline"
        // is 18 bytes; local_slice_to_ptr NUL-terminates it for the open() path arg.
        let path_c = local_slice_to_ptr(get_str_ptr("/proc/self/cmdline"), 18 as i64)
        let fd = syscall(2 as u64, path_c as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        @free(path_c)
        if fd >= 0:
            let buf = @alloc(8192) as ptr[u8]
            let n = syscall(0 as u64, fd as u64, buf as u64, 8192 as u64, 0 as u64, 0 as u64, 0 as u64)
            syscall(3 as u64, fd as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
            if n > 0 as i64:
                mut start := 0 as i64
                mut p := 0 as i64
                while p < n and count < 64:
                    if buf[p] == 0 as u8:
                        if p > start:
                            let s_ptr = local_slice_to_ptr(((buf as i64) + start) as ptr[u8], p - start)
                            populate_str_in_place(s_ptr, p - start, ((args as i64) + count * 16 as i64) as ptr[str])
                            count = count + 1 as i64
                        start = p + 1 as i64
                    p = p + 1 as i64
    out_argc[0] = count as i32
    return args




fn concatenate_stdlib(src: str, fails: ptr[i64]) -> str:
    ax_puts_local("[Debug] Reading result.ax...")
    fflush(null as ptr[void])
    let raw_res = read_required_file("std/result.ax", fails)
    ax_puts_local("[Debug] Reading alloc.ax...")
    fflush(null as ptr[void])
    let raw_alloc = read_required_file("std/mem/alloc.ax", fails)
    ax_puts_local("[Debug] Reading scheduler.ax...")
    fflush(null as ptr[void])
    let raw_sched = read_required_file("std/scheduler.ax", fails)
    ax_puts_local("[Debug] Reading runtime.ax...")
    fflush(null as ptr[void])
    let raw_rt = read_required_file("std/runtime.ax", fails)
    ax_puts_local("[Debug] Reading os.ax...")
    fflush(null as ptr[void])
    let raw_os = read_required_file("std/os.ax", fails)
    ax_puts_local("[Debug] Reading string.ax...")
    fflush(null as ptr[void])
    let raw_str = read_required_file("std/string.ax", fails)
    ax_puts_local("[Debug] Reading io.ax...")
    fflush(null as ptr[void])
    let raw_io = read_required_file("std/io.ax", fails)
    // BUG#61b: std/collections.ax (Vec/HashMap/HashSet) was NOT in this bundle, so
    // `import std.collections` was silently dropped on the native build path and
    // Vec methods dispatched into garbage at runtime. It only needs std.result
    // (bundled above) + builtins, so bundle it like the rest.
    ax_puts_local("[Debug] Reading collections.ax...")
    fflush(null as ptr[void])
    let raw_coll = read_required_file("std/collections.ax", fails)

    ax_puts_local("[Debug] Stripping imports from result.ax...")
    let res_src_raw = strip_imports(raw_res)
    let res_src = strip_package_prefixes(res_src_raw)

    ax_puts_local("[Debug] Stripping imports from alloc.ax...")
    fflush(null as ptr[void])
    let alloc_src_raw = strip_imports(raw_alloc)
    let alloc_src = strip_package_prefixes(alloc_src_raw)

    ax_puts_local("[Debug] Stripping imports from scheduler.ax...")
    fflush(null as ptr[void])
    let sched_src_raw = strip_imports(raw_sched)
    let sched_src = strip_package_prefixes(sched_src_raw)

    ax_puts_local("[Debug] Stripping imports from runtime.ax...")
    fflush(null as ptr[void])
    let rt_src_raw = strip_imports(raw_rt)
    let rt_src = strip_package_prefixes(rt_src_raw)

    ax_puts_local("[Debug] Stripping imports from os.ax...")
    fflush(null as ptr[void])
    let os_src_raw = strip_imports(raw_os)
    let os_src = strip_package_prefixes(os_src_raw)

    ax_puts_local("[Debug] Stripping imports from string.ax...")
    fflush(null as ptr[void])
    let str_src_raw = strip_imports(raw_str)
    let str_src = strip_package_prefixes(str_src_raw)

    ax_puts_local("[Debug] Stripping imports from io.ax...")
    fflush(null as ptr[void])
    let io_src_raw = strip_imports(raw_io)
    let io_src = strip_package_prefixes(io_src_raw)

    ax_puts_local("[Debug] Stripping imports from collections.ax...")
    fflush(null as ptr[void])
    let coll_src_raw = strip_imports(raw_coll)
    let coll_src = strip_package_prefixes(coll_src_raw)

    ax_puts_local("[Debug] Stripping imports from src...")
    fflush(null as ptr[void])
    let clean_src_raw = strip_imports(src)
    let clean_src = strip_package_prefixes(clean_src_raw)
    
    ax_puts_local("[Debug] Concatenating buffers...")
    fflush(null as ptr[void])
    let len_src = std.string.len(clean_src)
    let len_res = std.string.len(res_src)
    let len_alloc = std.string.len(alloc_src)
    let len_sched = std.string.len(sched_src)
    let len_rt = std.string.len(rt_src)
    let len_os = std.string.len(os_src)
    let len_str = std.string.len(str_src)
    let len_io = std.string.len(io_src)
    let len_coll = std.string.len(coll_src)

    let total_len = len_res + 1 as i64 + len_alloc + 1 as i64 + len_sched + 1 as i64 + len_rt + 1 as i64 + len_os + 1 as i64 + len_str + 1 as i64 + len_io + 1 as i64 + len_coll + 1 as i64 + len_src
    ax_printf_local("[Debug] len_res=%d, len_alloc=%d, len_sched=%d, len_rt=%d, len_os=%d, len_str=%d, len_io=%d, len_src=%d, ", len_res, len_alloc, len_sched, len_rt, len_os, len_str, len_io, len_src)
    ax_printf_local("total_len=%d\n", total_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    let new_buf = @alloc(total_len + 1 as i64) as ptr[u8]

    @memcpy(new_buf, res_src as ptr[u8], len_res)
    new_buf[len_res] = 10 as u8

    let off_alloc = len_res + 1 as i64
    @memcpy(((new_buf as i64) + off_alloc) as ptr[u8], alloc_src as ptr[u8], len_alloc)
    new_buf[off_alloc + len_alloc] = 10 as u8

    let off_sched = off_alloc + len_alloc + 1 as i64
    @memcpy(((new_buf as i64) + off_sched) as ptr[u8], sched_src as ptr[u8], len_sched)
    new_buf[off_sched + len_sched] = 10 as u8

    let off_rt = off_sched + len_sched + 1 as i64
    @memcpy(((new_buf as i64) + off_rt) as ptr[u8], rt_src as ptr[u8], len_rt)
    new_buf[off_rt + len_rt] = 10 as u8

    let off_os = off_rt + len_rt + 1 as i64
    @memcpy(((new_buf as i64) + off_os) as ptr[u8], os_src as ptr[u8], len_os)
    new_buf[off_os + len_os] = 10 as u8

    let off_str = off_os + len_os + 1 as i64
    @memcpy(((new_buf as i64) + off_str) as ptr[u8], str_src as ptr[u8], len_str)
    new_buf[off_str + len_str] = 10 as u8

    let off_io = off_str + len_str + 1 as i64
    @memcpy(((new_buf as i64) + off_io) as ptr[u8], io_src as ptr[u8], len_io)
    new_buf[off_io + len_io] = 10 as u8

    let off_coll = off_io + len_io + 1 as i64
    @memcpy(((new_buf as i64) + off_coll) as ptr[u8], coll_src as ptr[u8], len_coll)
    new_buf[off_coll + len_coll] = 10 as u8

    let off_src = off_coll + len_coll + 1 as i64
    @memcpy(((new_buf as i64) + off_src) as ptr[u8], clean_src as ptr[u8], len_src)
    new_buf[total_len] = 0 as u8

    let _ = write_file_content("scratch/stage2_preprocessed.ax", new_buf as str)

    ax_puts_local("[Debug] Cleaning up...")
    fflush(null as ptr[void])
    // Commented out to prevent double-free crashes under compiler's CTGC system
    // if std.string.len(raw_res) > 0 as i64:
    //     @free(raw_res as ptr[u8])
    // if std.string.len(raw_alloc) > 0 as i64:
    //     @free(raw_alloc as ptr[u8])
    // if std.string.len(raw_sched) > 0 as i64:
    //     @free(raw_sched as ptr[u8])
    // if std.string.len(raw_rt) > 0 as i64:
    //     @free(raw_rt as ptr[u8])
    // if std.string.len(raw_os) > 0 as i64:
    //     @free(raw_os as ptr[u8])
    // if std.string.len(raw_str) > 0 as i64:
    //     @free(raw_str as ptr[u8])
    // if std.string.len(raw_io) > 0 as i64:
    //     @free(raw_io as ptr[u8])
    //     
    // if res_src as ptr[u8] != res_src_raw as ptr[u8]:
    //     @free(res_src as ptr[u8])
    // @free(res_src_raw as ptr[u8])
    // 
    // if alloc_src as ptr[u8] != alloc_src_raw as ptr[u8]:
    //     @free(alloc_src as ptr[u8])
    // @free(alloc_src_raw as ptr[u8])
    // 
    // if sched_src as ptr[u8] != sched_src_raw as ptr[u8]:
    //     @free(sched_src as ptr[u8])
    // @free(sched_src_raw as ptr[u8])
    // 
    // if rt_src as ptr[u8] != rt_src_raw as ptr[u8]:
    //     @free(rt_src as ptr[u8])
    // @free(rt_src_raw as ptr[u8])
    // 
    // if os_src as ptr[u8] != os_src_raw as ptr[u8]:
    //     @free(os_src as ptr[u8])
    // @free(os_src_raw as ptr[u8])
    // 
    // if str_src as ptr[u8] != str_src_raw as ptr[u8]:
    //     @free(str_src as ptr[u8])
    // @free(str_src_raw as ptr[u8])
    // 
    // if io_src as ptr[u8] != io_src_raw as ptr[u8]:
    //     @free(io_src as ptr[u8])
    // @free(io_src_raw as ptr[u8])
    // 
    // if clean_src as ptr[u8] != clean_src_raw as ptr[u8]:
    //     @free(clean_src as ptr[u8])
    // @free(clean_src_raw as ptr[u8])
        
    let result_str = new_buf as str
    ax_puts_local("[Debug] Concatenation finished successfully!")
    fflush(null as ptr[void])
    
    let success_w = write_file_content("scratch/self_linked_concatenated.ax", result_str)
    if not success_w:
        ax_puts_local("error: could not write self_linked_concatenated.ax")
    return result_str
fn print_num(val: i64):
    if val == 0:
        print_raw("0")
        return
    mut v := val
    if v < 0:
        print_raw("-")
        v = -v
    mut temp := v
    mut digits := 0 as i64
    while temp > 0:
        digits = digits + 1
        temp = temp / 10
    let buf = @alloc(digits + 1) as ptr[u8]
    mut i := digits - 1
    temp = v
    while i >= 0:
        buf[i] = '0' as u8 + (temp % 10) as u8
        temp = temp / 10
        i = i - 1
    buf[digits] = 0 as u8
    print_raw(buf as str)
    @free(buf)

// RFC 0011 P3: djb2 hash of a source string, for .lib staleness detection.
fn djb2_hash_str(s: str) -> u64:
    mut h := 5381 as u64
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < n:
        h = ((h << 5 as u64) + h) + p[i] as u64
        i = i + 1
    return h

// RFC 0011 Â§3.4 / RFC 0035 Â§9 â€” identity of the LINK-TIME CONTRACT a `.lib` was built under.
// The staleness manifest hashes only the library SOURCE, so a `.lib` produced by a compiler
// that emitted different symbol names is considered fresh and is linked as-is. RFC 0035 P2
// made that concrete: libraries built before it export `ax_helper` while callers built after
// it reference `ax_libpa_helper`, and nothing in the build detects the mismatch â€” the user
// sees an unresolved external naming a function they can see is defined, or worse, a silent
// first-match bind to the wrong body.
//
// Folding this into the stored hash makes every `.lib` from an older scheme mismatch and be
// rebuilt, which is the correct and quiet outcome. BUMP IT whenever the emitted symbol name
// for a library's public surface changes â€” i.e. whenever x86_resolve_sym_name's output moves
// for a `--staticlib` build, or the `__axiom_iface` format changes.
//   1 = pre-RFC-0035 (plain `ax_<name>`)
//   2 = RFC 0035 P2 (module-qualified `ax_<unit>_<name>`)
pub const AX_LIB_SCHEME_ID: u64 = 2

// The value stored in, and compared against, a `.lib` staleness manifest: the source hash
// mixed with the scheme id, using the same djb2 step as the hash itself so the mixing adds
// no new arithmetic to reason about. Every producer and consumer of the manifest must go
// through here â€” a site that compares a raw djb2(src) would see every library as stale
// forever, which is why there is one function rather than the constant inlined at each site.
fn lib_manifest_hash(src: str) -> u64:
    let h = djb2_hash_str(src)
    return ((h << 5 as u64) + h) + AX_LIB_SCHEME_ID

// Read the u64 hash from a lib manifest ("AXLIB1\n" + 8 bytes LE). 0 if absent/invalid.
fn read_lib_manifest_hash(path: str) -> u64:
    let nt = str_to_null_terminated(path)
    let f = fopen(nt as ptr[void], get_str_ptr("rb"))
    @free(nt)
    if f == null as ptr[void]:
        return 0 as u64
    let bufm = @alloc(16) as ptr[u8]
    let got = fread(bufm as ptr[void], 1, 15, f)
    fclose(f)
    if got < 15 as i64:
        @free(bufm)
        return 0 as u64
    // Verify magic "AXLIB1\n"
    if bufm[0] != 'A' as u8 or bufm[1] != 'X' as u8 or bufm[2] != 'L' as u8 or bufm[3] != 'I' as u8 or bufm[4] != 'B' as u8 or bufm[5] != '1' as u8:
        @free(bufm)
        return 0 as u64
    mut h := 0 as u64
    mut i := 0 as i64
    while i < 8:
        h = h | ((bufm[7 + i] as u64) << (i * 8 as i64) as u64)
        i = i + 1
    @free(bufm)
    return h

fn file_exists(path: str) -> bool:
    let nt = str_to_null_terminated(path)
    let f = fopen(nt as ptr[void], get_str_ptr("rb"))
    @free(nt)
    if f == null as ptr[void]:
        return false
    fclose(f)
    return true

// RFC 0011 P4 (increment 3e): strip a trailing `.lib`/`.dll` from an output name, so one
// `--staticlib --shared` build can emit `<base>.lib` + `<base>.dll` for the same library.
// Always returns a fresh heap string (a copy when there is no such extension).
fn strip_lib_dll_ext(path: str) -> str:
    let n = std.string.len(path)
    if n >= 4:
        let p = get_str_ptr(path)
        if p[n - 4] == '.' as u8:
            let is_lib = p[n - 3] == 'l' as u8 and p[n - 2] == 'i' as u8 and p[n - 1] == 'b' as u8
            let is_dll = p[n - 3] == 'd' as u8 and p[n - 2] == 'l' as u8 and p[n - 1] == 'l' as u8
            if is_lib or is_dll:
                return std.string.slice(path, 0, n - 4)
    return std.string.slice(path, 0, n)

// RFC 0035 P2: the canonical qualifier for a module, as a PURE function of its canonical
// name â€” the property Â§4 requires and the reverted `sym_idx` scheme lacked. It must map the
// two spellings of the same module to one string, because the library and the app reach it
// from opposite directions and never share a table:
//   library side, from the source path passed to `--staticlib`:  "pkg/mod.ax" -> "pkg_mod"
//   app side, from the import name in `import pkg.mod`:          "pkg.mod"    -> "pkg_mod"
// `ensure_import_libs` builds the library path as `replace(mod_name, ".", "/") + ".ax"`, so
// the two inputs are the same name in different separators by construction, and this
// collapses both. Determinism (Â§3) holds: no hashing, no ordering, no table index.
// Returns a fresh heap string. Written as one explicit mapping loop rather than a chain of
// std.string.replace calls: `replace` returns its INPUT unchanged when there is no match, so
// freeing each intermediate is a use-after-free on exactly the inputs that need no
// substitution â€” which is most module names, and which segfaulted the resolver on the first
// attempt here.
fn module_qualifier(spec: str) -> str:
    mut n := std.string.len(spec)
    let p = get_str_ptr(spec)
    if n > 3:
        if p[n - 3] == '.' as u8 and p[n - 2] == 'a' as u8 and p[n - 1] == 'x' as u8:
            n = n - 3
    if n > 4:
        if p[n - 4] == '.' as u8 and p[n - 3] == 'l' as u8 and p[n - 2] == 'i' as u8 and p[n - 1] == 'b' as u8:
            n = n - 4
    mut buf := @alloc(n + 1) as ptr[u8]
    mut i := 0 as i64
    while i < n:
        let c = p[i]
        if c == '/' as u8 or c == 92 as u8 or c == '.' as u8:
            buf[i] = '_' as u8
        else:
            buf[i] = c
        i = i + 1
    buf[n] = 0 as u8
    let res = alloc_str_from_raw(buf, n)
    @free(buf)
    return res

// RFC 0011 P4 (increment 3d): does this source file declare itself a `library`? Scans the
// first meaningful (non-blank, non-`//`) line for a `library <name>` marker. A module that
// opts in this way is treated as a separately-compilable library (import-driven `.lib`)
// WITHOUT the global --auto-lib flag â€” the safe, self-describing default (the user's model).
fn source_is_library(ax_path: str) -> bool:
    let src = read_file_content(ax_path)
    let n = std.string.len(src)
    if n == 0:
        return false
    let p = get_str_ptr(src)
    mut i := 0 as i64
    mut result := false
    mut scanning := true
    while scanning and i < n:
        // skip leading spaces/tabs on the line
        while i < n and (p[i] == ' ' as u8 or p[i] == 9 as u8):
            i = i + 1
        if i >= n:
            scanning = false
        elif p[i] == 0x0A as u8:
            i = i + 1  // blank line â€” keep scanning
        elif i + 1 < n and p[i] == '/' as u8 and p[i + 1] == '/' as u8:
            while i < n and p[i] != 0x0A as u8:  // comment line â€” skip to EOL
                i = i + 1
        else:
            // first meaningful line: match `library` followed by whitespace
            if i + 7 <= n and p[i] == 'l' as u8 and p[i + 1] == 'i' as u8 and p[i + 2] == 'b' as u8 and p[i + 3] == 'r' as u8 and p[i + 4] == 'a' as u8 and p[i + 5] == 'r' as u8 and p[i + 6] == 'y' as u8:
                if i + 7 >= n or p[i + 7] == ' ' as u8 or p[i + 7] == 9 as u8:
                    result = true
            scanning = false
    @free(get_str_ptr(src))
    return result

// RFC 0011 P4 (increment 3c): auto-build / refresh a precompiled library per import.
// Before resolution, for each non-`std.` `import x` whose source `x.ax` exists, ensure a
// fresh `x.lib`: (re)build it via a self-invocation when the lib is missing or its manifest
// hash no longer matches djb2(x.ax). The import-driven resolver (register_module_from_lib)
// then binds x from the fresh interface and the linker pulls its code â€” so an unchanged
// library is compiled ONCE and merely linked afterwards (the user's model: cÃ³â†’dÃ¹ng,
// khÃ´ng/Ä‘á»•iâ†’biÃªn dá»‹ch vÃ  táº¡o lib). Libraries must be stdlib-free today (--no-stdlib);
// stdlib-using libs await the separate-compilation stdlib cache (RFC 0011 Â§6).
fn ensure_import_libs(tree: ptr[AstTree], pool: ptr[InternPool], self_exe: str, force_all: bool):
    mut i := 0 as i64
    while i < tree.nodes.len:
        if tree.nodes.data[i].kind == NODE_IMPORT_DECL:
            let name_id = tree.nodes.data[i].payload
            let mod_name = pool.get(name_id)
            if not std.string.starts_with(mod_name, "std."):
                let rel = std.string.replace(mod_name, ".", "/")
                let ax_path = std.string.concat(rel, ".ax")
                let lib_path = std.string.concat(rel, ".lib")
                // Only auto-build modules that opt in via a `library` marker, unless
                // --auto-lib forces every non-std import.
                if file_exists(ax_path) and (force_all or source_is_library(ax_path)):
                    let src_x = read_file_content(ax_path)
                    let h = lib_manifest_hash(src_x)
                    mut need_build := true
                    if file_exists(lib_path):
                        let man = std.string.concat(lib_path, ".manifest")
                        let prev = read_lib_manifest_hash(man)
                        @free(get_str_ptr(man))
                        if prev == h:
                            need_build = false
                    if need_build:
                        let p1 = std.string.concat("\"", self_exe)
                        let p2 = std.string.concat(p1, "\" build \"")
                        let p3 = std.string.concat(p2, ax_path)
                        let p4 = std.string.concat(p3, "\" -o \"")
                        let p5 = std.string.concat(p4, lib_path)
                        let inner = std.string.concat(p5, "\" --staticlib --no-stdlib -self-link -O1")
                        // Windows `cmd /c` strips the first/last quote of the command string
                        // when it starts with a quote; wrap the whole thing in an outer pair
                        // so the quoted exe/path arguments survive (cmd /c "â€¦" convention).
                        let wrapped = std.string.concat(std.string.concat("\"", inner), "\"")
                        @free(get_str_ptr(p1))
                        @free(get_str_ptr(p2))
                        @free(get_str_ptr(p3))
                        @free(get_str_ptr(p4))
                        @free(get_str_ptr(p5))
                        @free(get_str_ptr(inner))
                        ax_puts_local("[import] building library from source:")
                        ax_puts_local(ax_path)
                        let cmd_nt = str_to_null_terminated(wrapped)
                        let rc = system(cmd_nt as ptr[void])
                        @free(cmd_nt)
                        @free(get_str_ptr(wrapped))
                        if rc != 0:
                            ax_puts_local("[import] warning: library build failed; using source fallback")
                    @free(get_str_ptr(src_x))
                @free(get_str_ptr(ax_path))
                @free(get_str_ptr(lib_path))
                @free(get_str_ptr(rel))
        i = i + 1

pub fn main() -> i32:
    let argc_ptr = @alloc(4) as ptr[i32]
    argc_ptr[0] = 0 as i32
    let args = get_freestanding_args(argc_ptr)
    let argc = argc_ptr[0]
    @free(argc_ptr as ptr[u8])

    if argc < 2:
        ax_puts_local("Usage: axc <command> [args]")
        ax_puts_local("Commands:")
        ax_puts_local("  dump-air <file.ax> [-O0|-O1|-O2|-O3]")
        ax_puts_local("  emit-c <file.ax> [-o <out.c>] [-O0|-O1|-O2|-O3]")
        ax_puts_local("  build <file.ax> [-o <out.exe>] [-O0|-O1|-O2|-O3] [--target <wasm32|wasm32-unknown-unknown>]")
        ax_puts_local("  fmt <file.ax>")
        ax_puts_local("  lsp")
        fflush(null as ptr[void])
        return 1

    mut is_dump_air := false
    mut is_emit_c := false
    mut is_build := false
    mut is_fmt := false
    mut file_arg_idx := 1
    mut output_file := ""
    mut target_wasm32 := false
    // RFC 0009 P3 / Linux target: `--target linux` (or x86_64-linux) emits an ELF64
    // executable using the SysV ABI + inline syscalls instead of Windows COFF/PE.
    mut target_linux := false
    mut self_link := false
    mut optimize := false
    mut opt_level := 1 as u8
    mut no_stdlib := false
    mut show_time := false  // --time: print per-phase wall-clock timing
    mut is_shared := false  // RFC 0009 P2: --shared â€” emit a DLL with export table
    mut is_staticlib := false // RFC 0011 P1: --staticlib â€” emit a COFF .lib archive
    mut extra_libs := new_linker_str_vec() // RFC 0011 P2: -l <path> extra link inputs
    mut auto_lib := false // RFC 0011 P4 inc3c: --auto-lib â€” auto-build/cache each non-std
                          // import as a .lib. Opt-in: AXIOM can't yet tell an app-module
                          // (may collide/need stdlib) from a standalone library.
    mut ctgc_free := true  // RFC 0015 P3: compile-time free is now ON BY DEFAULT â€” inject
                           // OP_DESTROY (+ container free-glue / drop-glue) for provably
                           // non-escaping, single-owner local aggregates at block fall-through.
                           // Gated on a SOUND escape analysis (self-host freeable set = 0, so
                           // the compiler self-build stays byte-identical). Use -no-ctgc-free
                           // to opt OUT (debugging / a program that trips a missed escape edge).
    mut jumptable := false // RFC 0028: -jumptable â€” dense int match -> O(log N) compare tree
                           // for provably non-escaping, single-owner local aggregates.
    mut dfe_report_flag := false // RFC 0031: -dfe-report (measurement only)
    mut dfe_enabled := true       // RFC 0031: dead-function elimination is now ON BY DEFAULT â€”
                                  // skip emitting functions unreachable from the root set (entry +
                                  // #[export] + indirect-call/vtable roots). Every exe drops the
                                  // ~75KB fixed stdlib overhead (return 42: 77,824 -> 22,016 B, -71.7%).
                                  // Evidence base for flipping on: the compiler self-compiles
                                  // byte-identically under prune (pruned generation reaches B==C), the
                                  // full regression + ELF suite run green with pruning, and --staticlib
                                  // is guarded off (a library must keep its whole public surface). Use
                                  // -no-dfe to opt OUT (debugging a suspected missing root -> wild call).
    mut ctgc_report := false // RFC 0015 P3 precursor: -ctgc-free-report â€” dump the freeable
                             // set (print, no OP_DESTROY, byte-identical output). Measurement only.
                           // OFF by default so the self-host build stays byte-identical.

    // Parse commands
    let cmd = args[1]
    if cmd == "dump-air":
        is_dump_air = true
        file_arg_idx = 2
    elif cmd == "emit-c":
        is_emit_c = true
        file_arg_idx = 2
    elif cmd == "build":
        is_build = true
        self_link = true
        file_arg_idx = 2
    elif cmd == "fmt":
        is_fmt = true
        file_arg_idx = 2
    elif cmd == "lsp":
        lsp_start_server()
        return 0
    elif cmd == "iface":
        // RFC 0011 P4: dump the `__axiom_iface` member of a .lib and re-emit it from the
        // reader's parsed form (round-trip check for the interface reader, inc3a).
        if argc < 3:
            ax_puts_local("Usage: axc iface <library.lib>")
            return 1
        let iface_types = new_type_table()
        if axiom_check_lib_iface(args[2], iface_types):
            return 0
        return 1
    else:
        is_dump_air = true
        file_arg_idx = 1

    // Parse options starting after the file argument
    mut opt_idx := file_arg_idx + 1
    while opt_idx < argc:
        let opt = args[opt_idx as i64]
        if opt == "-o" or opt == "--output":
            if opt_idx + 1 < argc:
                output_file = args[opt_idx as i64 + 1 as i64]
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for -o option")
                return 1
        elif opt == "--target" or opt == "-target":
            if opt_idx + 1 < argc:
                let target_triple = args[opt_idx as i64 + 1 as i64]
                if target_triple == "wasm32" or target_triple == "wasm32-unknown-unknown" or target_triple == "wasm":
                    target_wasm32 = true
                elif target_triple == "linux" or target_triple == "x86_64-linux" or target_triple == "x86_64-unknown-linux" or target_triple == "x86_64-linux-gnu":
                    target_linux = true
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for --target option")
                return 1
        elif opt == "-self-link" or opt == "--self-link":
            self_link = true
        elif opt == "-use-gcc" or opt == "--use-gcc":
            self_link = false
        elif opt == "-O0":
            optimize = false
        elif opt == "-O1":
            optimize = true
            opt_level = 1 as u8
        elif opt == "-O2" or opt == "-O" or opt == "--opt":
            optimize = true
            opt_level = 2 as u8
        elif opt == "-O3":
            optimize = true
            opt_level = 3 as u8
        elif opt == "--no-stdlib":
            no_stdlib = true
        elif opt == "--shared":
            is_shared = true
        elif opt == "--staticlib":
            is_staticlib = true
        elif opt == "--auto-lib":
            auto_lib = true
        elif opt == "-l" or opt == "--link":
            if opt_idx + 1 < argc:
                push_linker_str(&extra_libs, args[opt_idx as i64 + 1 as i64])
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for -l option")
                return 1
        elif opt == "--time":
            show_time = true
        elif opt == "-ctgc-free" or opt == "--ctgc-free":
            ctgc_free = true
        elif opt == "-no-ctgc-free" or opt == "--no-ctgc-free":
            // RFC 0015 P3: opt OUT of the now-default compile-time free. Escape hatch for
            // debugging a suspected early-free / for a program whose aliasing the escape
            // analysis under-approximates (would become a UAF instead of a safe leak).
            ctgc_free = false
        elif opt == "-jumptable" or opt == "--jumptable":
            jumptable = true
        elif opt == "-dfe-report" or opt == "--dfe-report":
            // RFC 0031: print the reachable-function count, emit nothing differently.
            dfe_report_flag = true
        elif opt == "-dfe" or opt == "--dfe":
            // RFC 0031: actually skip emitting unreachable functions. OPT-IN, and
            // it stays opt-in until the root set has been exercised by something
            // more demanding than the oracles â€” the failure mode is a call into an
            // address that was never emitted, which no size check can detect.
            // Quiet by default. It first shipped implying -dfe-report, on the
            // reasoning that a build which drops functions should say which ones.
            // In practice that is ~123 lines on a hello-world and buries whatever
            // the user was actually building â€” a real barrier for the one thing
            // this flag now needs, which is being used. Pair it with -dfe-report
            // when diagnosing; that combination is what turned the ELF SIGSEGV
            // into a named function in a single build.
            dfe_enabled = true
        elif opt == "-no-dfe" or opt == "--no-dfe":
            // RFC 0031: opt OUT of the now-default dead-function elimination. Escape hatch for
            // debugging a suspected incomplete root set (a call into an address that was never
            // emitted), or to compare byte output against the un-pruned image.
            dfe_enabled = false
        elif opt == "-ctgc-free-report" or opt == "--ctgc-free-report":
            ctgc_report = true
        opt_idx = opt_idx + 1

    let filename = args[file_arg_idx as i64]
    mut src := read_file_content(filename)
    if std.string.len(src) == 0 as i64:
        // read_file_content has ALREADY printed a precise, named diagnostic if the
        // open or read failed, so this must not restate it in different words -- two
        // messages in two styles for one problem reads like two problems. It also has
        // to stay honest about the case read_file_content cannot distinguish: a file
        // that opened perfectly well and is simply empty, where "could not open or
        // read file" was flatly wrong.
        ax_puts_local("error: no source to compile (missing or empty):")
        ax_puts_local(filename)
        fflush(null as ptr[void])
        return 1

    if is_fmt:
        ax_puts_local("[Debug] Running pure-AXIOM Formatter...")
        mut formatter := new_formatter()
        let formatted = formatter.format(src)
        
        let success_f = write_file_content(filename, formatted)
        if success_f:
            ax_puts_local("[Debug] Formatted file successfully!")
        else:
            ax_puts_local("error: could not write formatted file")
        
        @free(get_str_ptr(formatted))
        return 0

    mut t_mark := clock()  // --time running marker (inert unless show_time)
    if self_link and not no_stdlib:
        // RFC 0009 P3 Linux: bundle the freestanding runtime shims (syscall-based
        // ax_get_global_state_internal / ax_panic / ax_compiler_intrinsic) so the
        // program needs no libax_runtime.so â€” the ELF linker binds the raw C-ABI
        // names to these bundled `ax_`-mangled twins. Windows keeps ax_runtime.dll.
        if target_linux:
            let raw_panic_rt = read_file_content("bootstrap/runtime/panic.ax")
            if std.string.len(raw_panic_rt) > 0:
                let src_nl = std.string.concat(src, "\n")
                src = std.string.concat(src_nl, raw_panic_rt)
                @free(get_str_ptr(src_nl))
            // The freestanding allocator (std/runtime.ax malloc â†’ __ax_runtime_init â†’
            // ax_os_alloc) uses sys_mmap/sys_munmap/sys_exit from bootstrap/runtime/syscall.ax,
            // which the import graph does NOT pull in. Bundle it so those resolve on Linux.
            let raw_syscall_rt = read_file_content("bootstrap/runtime/syscall.ax")
            if std.string.len(raw_syscall_rt) > 0:
                let src_nl2 = std.string.concat(src, "\n")
                src = std.string.concat(src_nl2, raw_syscall_rt)
                @free(get_str_ptr(src_nl2))
        // BUG#53's rule applied one stage earlier: bad INPUT must halt the pipeline
        // exactly as bad parse output does. read_file_content returns "" when it
        // cannot open a file, so a missing stdlib used to bundle as empty text and
        // flow all the way into codegen -- which then reported eight anonymous
        // `open failed` lines followed by a ~2 KB executable that segfaults. The
        // real cause (wrong working directory) was several screens above the
        // symptom the user actually met.
        mut stdlib_fails := 0 as i64
        src = concatenate_stdlib(src, &stdlib_fails)
        if stdlib_fails > 0 as i64:
            ax_printf_local("error: %d stdlib source file(s) could not be read; aborting before code generation\n", stdlib_fails, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            fflush(null as ptr[void])
            return 1
        t_mark = time_phase(show_time, "concat-stdlib", t_mark)

    // RFC 0011 P3: for --staticlib, skip the whole pipeline when the source is
    // unchanged (its hash matches the manifest) and the .lib still exists.
    mut lib_src_hash := 0 as u64
    if is_staticlib:
        lib_src_hash = lib_manifest_hash(src)
        if std.string.len(output_file) > 0 and file_exists(output_file):
            let man_check = std.string.concat(output_file, ".manifest")
            let prev_hash = read_lib_manifest_hash(man_check)
            @free(get_str_ptr(man_check))
            if prev_hash != 0 as u64 and prev_hash == lib_src_hash:
                ax_puts_local("[lib] up to date â€” skipping rebuild")
                return 0

    if not is_dump_air:
        ax_puts_local("[Debug] Stage 1: Starting compilation...")
        fflush(null as ptr[void])
    // 1. Lex
    mut lexer := new_lexer(src)
    let tokens = lexer.tokenize()
    t_mark = time_phase(show_time, "lex", t_mark)
    if not is_dump_air:
        ax_puts_local("[Debug] Finished Lexing.")
        fflush(null as ptr[void])

    // 2. Parse
    mut pool := new_intern_pool()
    mut parser := new_parser(tokens, src, pool)
    parser.parse_program()
    // BUG#53 fix (CLAUDE.md Â§8): parse errors must HALT the pipeline. Previously the
    // driver ignored parser.diags_count, so a malformed parse (e.g. an inline `if COND:
    // <stmt>` suite, which parse_block cannot represent) flowed into codegen and emitted
    // corrupt symbols ("Unresolved external symbol ''") instead of a clean error.
    if parser.diags_count > 0 as i64:
        ax_printf_local("error: %d parse error(s); aborting before code generation\n", parser.diags_count, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        fflush(null as ptr[void])
        return 1
    t_mark = time_phase(show_time, "parse", t_mark)
    if not is_dump_air:
        ax_puts_local("[Debug] Finished Parsing.")
        fflush(null as ptr[void])

    // RFC 0008: lambda-lift closures to top-level functions before resolution, so
    // they resolve/typecheck/lower as ordinary functions (reusing fn-ptr lowering).
    // BUG#73: lift_closures rejects captured-variable closures (RFC 0008 P2 is not
    // implemented) instead of silently lifting them into a miscompile; halt here
    // exactly like the parser.diags_count gate above (BUG#53).
    let lift_errors = lift_closures(parser.tree, parser.pool)
    if lift_errors > 0 as i64:
        ax_printf_local("error: %d closure capture error(s); aborting before code generation\n", lift_errors, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        fflush(null as ptr[void])
        return 1

    // RFC 0011 P4 (increment 3c/3d): auto-(re)build the `.lib` of each imported LIBRARY
    // (a module whose source carries a `library` marker) from source when missing/stale, so
    // `import x` resolves against a fresh library instead of recompiling x every time.
    // `library`-marked modules opt in by default; --auto-lib forces every non-std import.
    // Unmarked app-modules stay on the source path (safe for name-colliding / stdlib users).
    if is_build:
        ensure_import_libs(parser.tree, parser.pool, args[0], auto_lib)

    // 3. Resolve
    if not is_dump_air:
        ax_puts_local("[Debug] Creating symbol table...")
        fflush(null as ptr[void])
    mut symtable := new_symbol_table(parser.pool)
    // RFC 0035 P2: when this compilation IS a library, its own public functions carry the
    // unit's name into their emitted symbols. Scoped to --staticlib deliberately: that is
    // the only path whose output is linked into a DIFFERENT compilation, so it is the only
    // path where two units can collide, and an ordinary program build stays byte-identical.
    // `filename`, not `args[0]` â€” args[0] is argv[0], the compiler's own exe path (which
    // ensure_import_libs passes as `self_exe`). Using it produced the qualifier
    // `D:_projects_compiler_Axiom_axA_exe`, which is how this was caught.
    if is_staticlib:
        symtable.unit_qualifier = module_qualifier(filename)
    if not is_dump_air:
        ax_puts_local("[Debug] Creating type table...")
        fflush(null as ptr[void])
    mut typetable := new_type_table()
    
    if not is_dump_air:
        ax_puts_local("[Debug] Creating lazy resolver...")
        fflush(null as ptr[void])
    let lazy = new_lazy_resolver(symtable, parser.pool as ptr[void])
    lazy.typetable = typetable as ptr[void]
    lazy.auto_lib = auto_lib // RFC 0011 P4 inc3c: enable importâ†’.lib resolution (opt-in)
    symtable.lazy_resolver = lazy as ptr[void]
    
    if not self_link and not is_dump_air:
        let prelude_name = "std.result"
        let prelude_name_id = parser.pool.intern_string(prelude_name)
        let prelude_path = "std/result.ax"
        ax_puts_local("[Debug] Registering std.result import...")
        fflush(null as ptr[void])
        lazy.lazy_resolver_register_import(prelude_name_id, prelude_path, 0 as u32)
        ax_puts_local("[Debug] Preloading std.result module...")
        fflush(null as ptr[void])
        lazy.lazy_resolver_preload_module(prelude_name_id)
    
    if not is_dump_air:
        ax_puts_local("[Debug] Creating name resolver...")
        fflush(null as ptr[void])
    mut resolver := new_name_resolver(parser.tree, parser.pool, symtable)
    if not is_dump_air:
        ax_puts_local("[Debug] Resolver created. Pre-defining top levels...")
        fflush(null as ptr[void])
    resolver.pre_define_top_levels()
    if not is_dump_air:
        ax_puts_local("[Debug] Pre-defining finished. Resolving root...")
        fflush(null as ptr[void])
    resolver.resolve_node(0 as u32)
    if not is_dump_air:
        ax_puts_local("[Debug] Resolving finished.")
        fflush(null as ptr[void])
    parser.pool = resolver.intern
    if not is_dump_air:
        t_mark = time_phase(show_time, "resolve", t_mark)
        ax_puts_local("[Debug] Finished Resolving.")
        fflush(null as ptr[void])

    // 4. Typecheck
    mut checker := new_type_checker(parser.tree, parser.pool, resolver.symtable, typetable)
    checker.run_type_checker()
    // BUG#64-diag fix (CLAUDE.md Â§8, same class as BUG#53's parser-diag halt):
    // typecheck errors (currently: calling a non-function struct FIELD, e.g.
    // `v.len()` on a Vec whose `len` is a data field not a method) must HALT the
    // pipeline instead of flowing into codegen, where the untyped call fell back
    // to `getfld` + an INDIRECT CALL through the field's scalar value â€” a segfault
    // or jump to a garbage address with no compile-time signal.
    if checker.diags_count > 0 as i64:
        ax_printf_local("error: %d type error(s); aborting before code generation\n", checker.diags_count, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        fflush(null as ptr[void])
        return 1
    if not is_dump_air:
        t_mark = time_phase(show_time, "typecheck", t_mark)
        ax_puts_local("[Debug] Finished Typechecking.")
        fflush(null as ptr[void])

    if not is_dump_air:
        ax_puts_local("[Debug] Running Ownership Checker...")
        fflush(null as ptr[void])
        mut ownership_chk := new_ownership_checker(parser.tree, parser.pool, resolver.symtable, typetable)
        ownership_chk.check()

        ax_puts_local("[Debug] Running Escape Analyser...")
        fflush(null as ptr[void])
        mut escape_an := new_escape_analyser(parser.tree, parser.pool, resolver.symtable, typetable, checker.node_types, checker.node_types_cap)
        escape_an.run()

        ax_puts_local("[Debug] Running CTGC Injector...")
        fflush(null as ptr[void])
        mut ctgc_inj := new_ctgc_injector(parser.tree, parser.pool, resolver.symtable, typetable)
        ctgc_inj.free_enabled = ctgc_free
        ctgc_inj.report_only = ctgc_report
        ctgc_inj.run()

        ax_puts_local("[Debug] Running Alias Reuse Optimizer...")
        fflush(null as ptr[void])
        mut alias_opt := new_alias_reuse_optimizer(parser.tree, parser.pool, resolver.symtable, typetable)
        alias_opt.run()

        ax_puts_local("[Debug] Running AIR Builder...")
        fflush(null as ptr[void])

    // 6. Build AIR
    checker.ensure_capacity(parser.tree.nodes.len)
    mut air_builder := new_air_module_builder(parser.tree, resolver.symtable, typetable, parser.pool, checker.node_types)
    // Linux target: drive the compile-time `is_windows`/`is_linux`/`os_name` fold so the
    // bundled platform runtime picks the syscall path. Set BEFORE build_module().
    air_builder.target_is_windows = not target_linux
    air_builder.jumptable_enabled = jumptable
    air_builder.build_module()
    
    // Build AIR for all lazy loaded modules and append their functions
    if lazy != null as ptr[LazyResolver]:
        mut mod_idx := 0 as i64
        while mod_idx < lazy.modules.len:
            let mod = lazy.modules.data[mod_idx]
            if mod != null as ptr[ModuleInfo] and mod.status == MODULE_LOADED and mod.ast_tree != null as ptr[AstTree] and mod.node_types != null as ptr[void]:
                mut mod_air_builder := new_air_module_builder(mod.ast_tree, resolver.symtable, typetable, parser.pool, mod.node_types as ptr[u32])
                mod_air_builder.target_is_windows = not target_linux
                mod_air_builder.build_module()
                
                // Append functions to main air_builder.module
                mut f_idx := 0 as i64
                while f_idx < mod_air_builder.module.funcs.len:
                    let f = mod_air_builder.module.funcs.data[f_idx]
                    (&air_builder.module.funcs).push(f)
                    f_idx = f_idx + 1 as i64

                // RFC 0017 / BUG#82: append this module's global variables too, so their
                // static storage + data symbols are emitted alongside the merged funcs.
                mut g_idx := 0 as i64
                while g_idx < mod_air_builder.module.globals.len:
                    (&air_builder.module.globals).push(mod_air_builder.module.globals.data[g_idx])
                    g_idx = g_idx + 1 as i64
                
                // Free mod_air_builder itself but NOT the inner functions (since they were merged)
                @free(mod_air_builder as ptr[u8])
            mod_idx = mod_idx + 1 as i64

    parser.pool = air_builder.pool
    if not is_dump_air:
        t_mark = time_phase(show_time, "air-build", t_mark)
        ax_puts_local("[Debug] Stage 2: Finished building AIR module.")
        fflush(null as ptr[void])

    if optimize:
        if not is_dump_air:
            ax_puts_local("[Debug] Stage 2.1: Running SSA optimizer...")
            fflush(null as ptr[void])
        mut optimizer := new_ssa_optimizer()
        optimizer.level = opt_level
        optimizer.run(&(air_builder.module), typetable)
        if not is_dump_air:
            t_mark = time_phase(show_time, "ssa-opt", t_mark)
            ax_puts_local("[Debug] Stage 2.2: Finished SSA optimizer.")
            fflush(null as ptr[void])

    // 7. Handle output phase
    if is_dump_air:
        print_module(air_builder.module)
    elif is_emit_c:
        mut cgen := new_c_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
        if std.string.len(output_file) == 0:
            output_file = "output.c"
        let success = cgen.generate(output_file)
        if not success:
            ax_puts_local("error: could not generate C code")
            return 1
    elif is_build:
        if target_wasm32:
            mut wasm_gen := new_wasm_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
            if std.string.len(output_file) == 0:
                output_file = "output.wat"
            let success = wasm_gen.generate(output_file)
            if not success:
                ax_puts_local("error: could not generate Wasm Text code")
                return 1
            
            @free(get_str_ptr(src))
            if tokens.data != null as ptr[Token]:
                @free(tokens.data as ptr[u8])
            if lexer.tokens.data != null as ptr[Token]:
                @free(lexer.tokens.data as ptr[u8])
            if lexer.indent_stack.data != null as ptr[i32]:
                @free(lexer.indent_stack.data as ptr[u8])
            if lexer.newline_offsets.data != null as ptr[i32]:
                @free(lexer.newline_offsets.data as ptr[u8])

            if parser.tree.nodes.data != null as ptr[AstNode]:
                @free(parser.tree.nodes.data as ptr[u8])
            if parser.tree.extras.data != null as ptr[i32]:
                @free(parser.tree.extras.data as ptr[u8])

            free_air_module_builder(air_builder)
            free_type_checker(checker)
            free_typetable(typetable)
            free_symtable(resolver.symtable)
            free_pool(parser.pool)
            return 0

        if std.string.len(output_file) == 0:
            output_file = "output.exe"

        if self_link:
            let temp_obj = "axiom_temp.obj"
            ax_puts_local("[Debug] Stage 3: Starting native code generation...")
            // Linux target emits an ELF object; the self-linker auto-detects the format
            // from the object magic and produces an ELF64 executable. Default is COFF/PE.
            mut obj_format := "coff"
            if target_linux:
                obj_format = "elf"
            // RFC 0031: NEVER prune into a static library, even when the module has
            // #[export] functions. For an executable or a DLL the roots really are
            // the whole entry surface -- nothing outside can call an unexported
            // function. A .lib is the opposite: the CONSUMER decides what to link,
            // and every `pub` function is a legitimate entry point whether or not it
            // is exported.
            //
            // The `no entry and no exports` guard inside dfe_compute already covers a
            // library with no exports at all, which is why this looked safe. It is
            // not: adding ONE #[export] flips the module onto the other branch, and a
            // probe of exactly that shape pruned a `pub` function that a consumer
            // would then fail to link against -- an archive silently missing part of
            // its public surface, with no diagnostic anywhere.
            let dfe_for_output = dfe_enabled and not is_staticlib
            let success = compile_native_binary(temp_obj, air_builder.module, resolver.symtable, parser.pool, typetable, get_str_ptr(obj_format), self_link, dfe_report_flag, dfe_for_output)
            if not success:
                ax_puts_local("error: could not generate native binary code")
                return 1
            t_mark = time_phase(show_time, "codegen", t_mark)
            ax_puts_local("[Debug] Stage 4: Finished native code generation.")

            // RFC 0011 P1: --staticlib wraps the compiled object into a .lib archive
            // instead of linking an executable.
            if is_staticlib:
                // RFC 0011 P4: serialize the TU's public interface into the .lib.
                let iface_text = build_lib_iface_text(resolver.symtable, parser.pool, typetable, parser.tree)
                // RFC 0011 P4 (inc3e): `--staticlib --shared` emits BOTH `<base>.lib` and
                // `<base>.dll` for one library. Name the archive `<base>.lib`; the DLL is
                // produced by falling through to the linker with output = `<base>.dll`.
                mut lib_out := output_file
                if is_shared:
                    let base = strip_lib_dll_ext(output_file)
                    lib_out = std.string.concat(base, ".lib")
                    output_file = std.string.concat(base, ".dll")
                    @free(get_str_ptr(base))
                let lib_ok = axiom_write_static_lib(temp_obj, lib_out, lib_src_hash, iface_text)
                if is_shared:
                    @free(get_str_ptr(lib_out))
                let temp_obj_nt2 = str_to_null_terminated(temp_obj)
                @free(temp_obj_nt2)
                if not lib_ok:
                    ax_puts_local("error: static library generation failed")
                    return 1
                ax_puts_local("[Debug] Static library written.")
                if not is_shared:
                    free_air_module_builder(air_builder)
                    free_type_checker(checker)
                    free_typetable(typetable)
                    free_symtable(resolver.symtable)
                    free_pool(parser.pool)
                    return 0
                // is_shared too: continue to the linker to also emit the DLL.
                ax_puts_local("[Debug] Also emitting shared library (.dll)...")

            ax_puts_local("[Debug] Stage 5: Starting self-linking...")
            mut linker := new_axiom_linker()
            axiom_linker_add_input(&linker, temp_obj)
            // RFC 0011 P2: additional static-lib / object inputs from -l.
            mut lib_i := 0 as i64
            while lib_i < extra_libs.len:
                axiom_linker_add_input(&linker, extra_libs.data[lib_i])
                lib_i = lib_i + 1
            // RFC 0011 P4 (increment 3b): import-driven auto-libraries. Each module that
            // was satisfied from a `<module>.lib` (register_module_from_lib) must have that
            // archive linked so its code is present. Re-derive the path from the module
            // name and add it when the file exists â€” mirrors the load-time decision.
            if lazy != null as ptr[LazyResolver]:
                mut ml_i := 0 as i64
                while ml_i < lazy.modules.len:
                    let lmod = lazy.modules.data[ml_i]
                    if lmod != null as ptr[ModuleInfo]:
                        let lmod_name = parser.pool.get(lmod.name_id)
                        let lmod_rel = std.string.replace(lmod_name, ".", "/")
                        let lmod_lib = std.string.concat(lmod_rel, ".lib")
                        let lmod_ax = std.string.concat(lmod_rel, ".ax")
                        // Link the archive only for modules actually resolved FROM a lib
                        // (marked `library`, or forced by --auto-lib) â€” matches the loader.
                        if file_exists(lmod_lib) and (auto_lib or source_is_library(lmod_ax)):
                            axiom_linker_add_input(&linker, lmod_lib)
                        @free(get_str_ptr(lmod_ax))
                        ml_i = ml_i + 1
            linker.output_path = output_file
            // RFC 0009: resolve extern-from-DLL bindings (name_id pairs) into string
            // pairs for the linker's per-symbol DLL attribution.
            mut bind_i := 0 as i64
            while bind_i < resolver.symtable.dll_bind_syms.len:
                let sym_id = resolver.symtable.dll_bind_syms.data[bind_i]
                let dll_id = resolver.symtable.dll_bind_dlls.data[bind_i]
                push_linker_str(&linker.user_dll_syms, parser.pool.get(sym_id))
                push_linker_str(&linker.user_dll_names, parser.pool.get(dll_id))
                bind_i = bind_i + 1
            // RFC 0009 P2: thread #[export] names + --shared mode into the linker.
            // RFC 0011 P4: a `library`-marked module exports its FULL public API when
            // built as a DLL, so the .dll surface matches the .lib (and the auto FFI
            // wrapper). Unmarked --shared keeps the #[export]-only behavior.
            linker.is_shared = is_shared
            let export_all_pub = source_is_library(filename)
            if export_all_pub:
                mut es_i := 0 as i64
                while es_i < resolver.symtable.symbols.len:
                    let es_kind = resolver.symtable.symbols.data[es_i].kind
                    let es_flags = resolver.symtable.symbols.data[es_i].flags
                    let es_tid = resolver.symtable.symbols.data[es_i].type_id
                    if es_kind == SYM_FUNC and (es_flags & SYM_FLAG_PUB) != 0 as u16 and es_tid != 0 as u32:
                        let es_name = parser.pool.get(resolver.symtable.symbols.data[es_i].name_id)
                        if std.string.len(es_name) > 0:
                            push_linker_str(&linker.export_names, es_name)
                    es_i = es_i + 1
            else:
                mut exp_i := 0 as i64
                while exp_i < resolver.symtable.export_syms.len:
                    push_linker_str(&linker.export_names, parser.pool.get(resolver.symtable.export_syms.data[exp_i]))
                    exp_i = exp_i + 1
            let link_success = axiom_linker_link(&linker)
            t_mark = time_phase(show_time, "self-link", t_mark)
            ax_puts_local("[Debug] Stage 6: Finished self-linking.")
            // (Removed a dead temp_obj_nt alloc+free here â€” the file-removal it fed was
            //  commented out, so it was a pure post-Stage-6 heap op with no effect.)

            if not link_success:
                // Delete the half-written output. The linker streams headers and code
                // to disk BEFORE it discovers an unresolved relocation, so a failed
                // link still leaves a complete-looking executable behind. The exit
                // code is already 1, but a user who sees both an error and an .exe
                // reasonably runs the .exe -- and meets a SEGFAULT instead of a build
                // failure. That is how "Unresolved external symbol" was mistaken for a
                // .bss addressing bug during an RFC 0031 probe: the diagnostic was
                // correct and right there, and the runnable artifact next to it was
                // more persuasive than the text.
                //
                // Failing to remove it is not itself fatal -- the build has already
                // failed and says so -- but say which file is stale so a stale binary
                // is never silently trusted.
                let rm = std.os.remove_file(output_file)
                if rm.is_err():
                    ax_puts_local("warning: could not remove the incomplete output; do NOT run:")
                    ax_puts_local(output_file)
                ax_puts_local("error: Self-linking failed")
                return 1
            // RFC 0011 P4 (inc3f): for a DLL, emit an FFI wrapper module `<base>_ffi.ax`
            // (pub extern bindings for every #[export]ed fn) so a consumer imports one file
            // instead of hand-writing an `extern "C" from` per function.
            if is_shared:
                let dll_base = strip_lib_dll_ext(output_file)
                let wrap_path = std.string.concat(dll_base, "_ffi.ax")
                @free(get_str_ptr(dll_base))
                let dll_bn = linker_basename(output_file)
                let wrap_text = build_dll_wrapper_text(resolver.symtable, parser.pool, typetable, dll_bn, export_all_pub)
                if write_file_content(wrap_path, wrap_text):
                    ax_puts_local("[Debug] FFI wrapper written:")
                    ax_puts_local(wrap_path)
                @free(get_str_ptr(wrap_text))
                @free(get_str_ptr(wrap_path))
            // Self-link build is complete: the output executable/DLL is fully written.
            // Skip the process-teardown free chain and exit immediately. This is a
            // standard compiler pattern (the OS reclaims all memory on exit) and it
            // deterministically avoids a rare, output-invisible teardown SIGSEGV: a
            // program that monomorphizes 3+ distinct hash containers (HashMap/HashSet)
            // intermittently corrupts a compiler-heap pointer during generic mono, which
            // only faults later when the teardown free chain walks the clobbered pointer.
            // Output is always correct; skipping teardown makes the exit code reliably 0.
            // Root cause (an OOB/indexed write in hash-container mono) is tracked in
            // knowledge/bug-3hashmap-mono-teardown-crash.md for a future ASAN session;
            // the std/mem/alloc.ax AX_CANARY infra (disabled) is committed for it.
            fflush(null as ptr[void])
            return 0
        else:
            // Generate C code first
            ax_puts_local("[Debug] Stage 2.3: Starting C code generation...")
            fflush(null as ptr[void])
            mut cgen := new_c_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
            let gen_success = cgen.generate("axiom_temp.c")
            if not gen_success:
                ax_puts_local("error: C code generation failed")
                fflush(null as ptr[void])
                return 1
            ax_puts_local("[Debug] Stage 2.4: Finished C code generation successfully.")
            fflush(null as ptr[void])

            mut opt_str := "-O1"
            if optimize:
                if opt_level == 1 as u8:
                    opt_str = "-O1"
                elif opt_level == 2 as u8:
                    opt_str = "-O2"
                elif opt_level == 3 as u8:
                    opt_str = "-O3"

            let cmd_buf = @alloc(2048) as ptr[u8]
            let output_file_nt = str_to_null_terminated(output_file)

            // Compile C to executable using gcc.
            // -g is omitted intentionally: debug info triples compile time and binary size.
            ax_snprintf_local(cmd_buf as ptr[void], 2048, "gcc %s -DAXIOM_SUMLAYOUT_POINTER -fno-strict-aliasing -Wno-int-conversion -Wno-incompatible-pointer-types -Wl,--no-insert-timestamp -o %s axiom_temp.c -Iruntime runtime/axalloc/axalloc_compiled.c runtime/axalloc/platform_ext.c runtime/panic/panic.c runtime/ax_assert.c runtime/ax_collections.c runtime/ax_math.c runtime/ax_print.c runtime/ax_string_ops.c runtime/actor/actor.c runtime/actor/async.c runtime/actor/ioloop.c runtime/actor/isolated.c runtime/actor/msgqueue.c runtime/actor/runtime_init.c runtime/actor/scheduler.c runtime/actor/supervisor.c" as ptr[u8], get_str_ptr(opt_str) as ptr[void], output_file_nt as ptr[void])
            let link_status = system(cmd_buf as ptr[void])

            // Clean up
            @free(output_file_nt)
            @free(cmd_buf)

            if link_status != 0:
                ax_puts_local("error: C compilation failed")
                fflush(null as ptr[void])
                return link_status

    // Free resources
    @free(get_str_ptr(src))
    if tokens.data != null as ptr[Token]:
        @free(tokens.data as ptr[u8])
    if lexer.tokens.data != null as ptr[Token]:
        @free(lexer.tokens.data as ptr[u8])
    if lexer.indent_stack.data != null as ptr[i32]:
        @free(lexer.indent_stack.data as ptr[u8])
    if lexer.newline_offsets.data != null as ptr[i32]:
        @free(lexer.newline_offsets.data as ptr[u8])

    if parser.tree.nodes.data != null as ptr[AstNode]:
        @free(parser.tree.nodes.data as ptr[u8])
    if parser.tree.extras.data != null as ptr[i32]:
        @free(parser.tree.extras.data as ptr[u8])

    let dummy_len = typetable.entries.len + air_builder.tree.nodes.len + checker.tree.nodes.len
    if dummy_len == -9999 as i64:
        ax_puts_local("dummy")

    free_air_module_builder(air_builder)
    free_type_checker(checker)
    free_typetable(typetable)
    free_lazy_resolver(lazy)
    free_symtable(resolver.symtable)
    free_pool(parser.pool)



    return 0

// Bind a body-less lib symbol under its qualified `mod.NAME` in the global scope and record
// it as a module export, so the resolver's field lookup finds it (shared by fn/const/struct).
fn register_lib_symbol(st: ptr[SymbolTable], intern: ptr[InternPool], mod: ptr[ModuleInfo], mod_name: str, local_name: str, local_name_id: u32, sym_idx: u32):
    let dot_name = std.string.concat(".", local_name)
    let full_name = std.string.concat(mod_name, dot_name)
    let full_name_id = intern.intern_string(full_name)
    @free(get_str_ptr(dot_name))
    @free(get_str_ptr(full_name))
    let gscope = &st.scopes.data[0]
    gscope.scope_put(full_name_id, sym_idx)
    (&mod.exports).push(ModuleExport(name_id: local_name_id, symbol_idx: sym_idx))

// Resolve an interface type token to a TypeID: a primitive by name, else a struct registered
// earlier in this module (nameâ†’id map from the `S` lines), else TYPE_UNKNOWN.
fn iface_resolve_tok(tok: str, names: ptr[LinkerStrVec], ids: ptr[U32Vec]) -> u32:
    let prim = iface_token_to_type(tok)
    if prim != TYPE_UNKNOWN:
        return prim
    mut k := 0 as i64
    while k < names.len:
        if names.data[k] == tok:
            return ids.data[k]
        k = k + 1
    return TYPE_UNKNOWN

// RFC 0011 P4 (increment 3b/4a/4b): register a module's public symbols from a precompiled
// `.lib`'s `__axiom_iface` â€” WITHOUT parsing/typechecking/codegen'ing the library source.
// Each public function becomes a body-less SYM_FUNC (decl_node 0, ast_tree stays null â‡’
// build_module never emits it â€” its body comes from the `.lib` at link time). The symbol
// carries only SYM_FLAG_PUB, so cgen mangles the call target as plain `ax_<name>`, which
// matches the library's exported symbol. Qualified `mod.fn` resolves via the global-scope
// full-name binding and the module export list, exactly like the source-loaded path.
// inc4b: structs (`S` lines) are registered FIRST â€” recomputing their layout from the same
// fields â€” so function/const signatures can reference them by name.
fn register_module_from_lib(mod: ptr[ModuleInfo], st: ptr[SymbolTable], tt: ptr[TypeTable], intern: ptr[InternPool], lib_path: str, mod_name: str) -> i32:
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    let p = get_str_ptr(text)
    // Struct nameâ†’type_id map built as we register `S` lines (pass 1).
    mut smap_names := new_linker_str_vec()
    mut smap_ids := new_u32_vec()
    // PASS 1: register public structs so later function/const lines can name them.
    mut li := 0 as i64
    while li < n:
        mut lj := li
        while lj < n and p[lj] != 0x0A as u8:
            lj = lj + 1
        let stoks = iface_line_tokens(p, li, lj)
        if stoks.len >= 3 and stoks.data[0] == "S":
            let sname = stoks.data[1]
            let nfields = iface_atoi(stoks.data[2])
            mut fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
            mut ft := 3 as i64
            mut fcount := 0 as i64
            while fcount < nfields and ft + 1 as i64 < stoks.len:
                let f_name_id = intern.intern_string(stoks.data[ft])
                let f_type = iface_token_to_type(stoks.data[ft + 1 as i64])
                (&fields).push(StructField(name_id: f_name_id, type_id: f_type))
                ft = ft + 2 as i64
                fcount = fcount + 1
            let s_name_id = intern.intern_string(sname)
            let s_type_id = tt.register_struct(s_name_id, fields)
            push_linker_str(&smap_names, sname)
            smap_ids.push(s_type_id)
            let s_sym_idx = st.symbols.len as u32
            (&st.symbols).push(Symbol(
                name_id: s_name_id,
                kind: SYM_STRUCT,
                padding: 0 as u8,
                flags: SYM_FLAG_PUB,
                type_id: s_type_id,
                decl_node: 0 as u32,
                scope_id: 0 as u32,
                next_overload: 0 as u32,
            ))
            (&st.symbol_trees).push(null as ptr[AstTree])
            register_lib_symbol(st, intern, mod, mod_name, sname, s_name_id, s_sym_idx)
        li = lj + 1
    // PASS 2: register public functions, resolving struct-typed params/returns via the map.
    li = 0 as i64
    while li < n:
        mut lj := li
        while lj < n and p[lj] != 0x0A as u8:
            lj = lj + 1
        let toks = iface_line_tokens(p, li, lj)
        if toks.len >= 4 and toks.data[0] == "F":
            let fname = toks.data[1]
            let nparams = iface_atoi(toks.data[2])
            mut params := new_u32_vec()
            mut t := 3 as i64
            mut pc := 0 as i64
            while pc < nparams and t < toks.len:
                params.push(iface_resolve_tok(toks.data[t], &smap_names, &smap_ids))
                t = t + 1
                pc = pc + 1
            mut ret := TYPE_VOID
            if t < toks.len and toks.data[t] == "->":
                t = t + 1
            if t < toks.len:
                ret = iface_resolve_tok(toks.data[t], &smap_names, &smap_ids)
            let func_type = tt.register_function(params, ret)
            let local_name_id = intern.intern_string(fname)
            // RFC 0035 P2: the symbol's NAME is the module-qualified base, so cgen emits the
            // very name the library emitted for itself (`ax_libpa_helper`) instead of the
            // bare `ax_<name>` that makes two libraries indistinguishable â€” the defect this
            // function's own comment describes. The LOCAL name still drives every lookup:
            // register_lib_symbol binds `libpa.helper` in the global scope and records the
            // export under `local_name_id`, so source-level resolution is unchanged.
            // Distinct names also stop SYM_FLAG_MODDUP from firing on two same-named
            // imports, which is what produced the call to `ax_helper__m<sym_idx>` that no
            // library ever defined.
            //
            // Derived from `lib_path`, NOT from the `mod_name` parameter: a probe here
            // showed mod_name arriving EMPTY on this path (`intern.get(mod.name_id)` in
            // ax_driver_load_module), while lib_path is provably intact â€” file_exists()
            // just opened it. lib_path is `replace(mod_name, ".", "/") + ".lib"` computed
            // in the caller, so it carries the same canonical name in the same separator
            // form the library itself was compiled under, which is what makes the two
            // sides agree. (mod_name being empty is pre-existing and separate: the
            // `mod.NAME` binding register_lib_symbol writes from it is dead weight, since
            // resolution reaches these symbols through the ModuleExport list instead.)
            let q_mod = module_qualifier(lib_path)
            let q_sep = std.string.concat(q_mod, "_")
            let q_full = std.string.concat(q_sep, fname)
            let qual_name_id = intern.intern_string(q_full)
            @free(get_str_ptr(q_mod))
            @free(get_str_ptr(q_sep))
            @free(get_str_ptr(q_full))
            let sym_idx = st.symbols.len as u32
            (&st.symbols).push(Symbol(
                name_id: qual_name_id,
                kind: SYM_FUNC,
                padding: 0 as u8,
                flags: SYM_FLAG_PUB | SYM_FLAG_MODQUAL,
                type_id: func_type,
                decl_node: 0 as u32,
                scope_id: 0 as u32,
                next_overload: 0 as u32,
            ))
            (&st.symbol_trees).push(null as ptr[AstTree])
            register_lib_symbol(st, intern, mod, mod_name, fname, local_name_id, sym_idx)
        li = lj + 1
    // RFC 0011 P4 inc4a: register the library's public integer constants. Each becomes a
    // body-less SYM_CONST (decl_node 0, no AST initializer); its value is stashed in
    // next_overload (unused for consts) and inlined by lower_field_expr at each `mod.NAME`
    // use site â€” mirroring the function registration above.
    let consts = parse_lib_iface_consts(lib_path)
    mut ci := 0 as i64
    while ci < consts.len:
        let c = &consts.data[ci]
        let c_local_name_id = intern.intern_string(c.name)
        let c_sym_idx = st.symbols.len as u32
        (&st.symbols).push(Symbol(
            name_id: c_local_name_id,
            kind: SYM_CONST,
            padding: 0 as u8,
            flags: SYM_FLAG_PUB,
            type_id: c.type_id,
            decl_node: 0 as u32,
            scope_id: 0 as u32,
            next_overload: c.value as u32,
        ))
        (&st.symbol_trees).push(null as ptr[AstTree])
        let c_dot_name = std.string.concat(".", c.name)
        let c_full_name = std.string.concat(mod_name, c_dot_name)
        let c_full_name_id = intern.intern_string(c_full_name)
        @free(get_str_ptr(c_dot_name))
        @free(get_str_ptr(c_full_name))
        let c_gscope = &st.scopes.data[0]
        c_gscope.scope_put(c_full_name_id, c_sym_idx)
        (&mod.exports).push(ModuleExport(name_id: c_local_name_id, symbol_idx: c_sym_idx))
        ci = ci + 1
    mod.status = MODULE_LOADED
    mod.ast_tree = null as ptr[AstTree]
    return 0 as i32

pub fn ax_driver_load_module(mod_void: ptr[void], st: ptr[SymbolTable], tt: ptr[void]) -> i32:
    let mod = mod_void as ptr[ModuleInfo]
    let lazy = st.lazy_resolver as ptr[LazyResolver]
    let intern = lazy.intern as ptr[InternPool]
    let mod_name = intern.get(mod.name_id)

    let rel_path = std.string.replace(mod_name, ".", "/")
    mut file_path := std.string.concat(rel_path, ".ax")

    // RFC 0011 P4 (increment 3b/3d): prefer a precompiled `<module>.lib` when the module is
    // a library (source carries a `library` marker) or --auto-lib forces it. Import-driven
    // separate compilation â€” the library's code is pulled in by the linker (its path is
    // threaded from lazy.modules), so its source is never recompiled.
    let lib_path = std.string.concat(rel_path, ".lib")
    if (lazy.auto_lib or source_is_library(file_path)) and file_exists(lib_path):
        @free(get_str_ptr(rel_path))
        @free(get_str_ptr(file_path))
        let rc = register_module_from_lib(mod, st, tt as ptr[TypeTable], intern, lib_path, mod_name)
        @free(get_str_ptr(lib_path))
        return rc
    @free(get_str_ptr(lib_path))
    @free(get_str_ptr(rel_path))

    mut opened := false
    mut actual_path := ""

    let r = std.io.open(file_path)
    if r.is_ok():
        let file = r.unwrap()
        let _ = file.close()
        opened = true
        actual_path = std.string.concat("", file_path)
    else:
        let path1 = std.string.concat("../", file_path)
        let r1 = std.io.open(path1)
        if r1.is_ok():
            let file1 = r1.unwrap()
            let _ = file1.close()
            opened = true
            actual_path = path1
        else:
            @free(get_str_ptr(path1))
            let path2 = std.string.concat("../../", file_path)
            let r2 = std.io.open(path2)
            if r2.is_ok():
                let file2 = r2.unwrap()
                let _ = file2.close()
                opened = true
                actual_path = path2
            else:
                @free(get_str_ptr(path2))

    if not opened:
        ax_printf_local("error: could not open module file '%s'\n", get_str_ptr(file_path) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        @free(get_str_ptr(file_path))
        @free(get_str_ptr(mod_name))
        return 1 as i32

    mut src := read_file_content(actual_path)
    ax_printf_local("[Debug] read_file_content len=%d\n", src.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    @free(get_str_ptr(actual_path))

    // 1. Lex
    ax_printf_local("[Debug] Lexing...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    mut lexer := new_lexer(src)
    let tokens = lexer.tokenize()
    ax_printf_local("[Debug] Lexing finished, tokens len=%d\n", tokens.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])

    // 2. Parse
    ax_printf_local("[Debug] Parsing...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    let parser_ptr = new_parser(tokens, src, intern)
    parser_ptr.parse_program()
    let mod_tree = parser_ptr.tree
    ax_printf_local("[Debug] Parsing finished, nodes count=%d\n", mod_tree.nodes.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    mod.ast_tree = mod_tree

    // Save scope stack and reset to global scope (0)
    let saved_len = st.stack.len
    let saved_cap = st.stack.cap
    let saved_data = st.stack.data
    st.stack = new_u32_vec()
    (&st.stack).push(0 as u32)

    // 3. Resolve
    ax_printf_local("[Debug] Resolving...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    mut mod_resolver := new_name_resolver(mod_tree, intern, st)
    mod_resolver.resolve()
    ax_printf_local("[Debug] Resolving finished\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])

    // 4. Typecheck
    ax_printf_local("[Debug] Typechecking...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    mut mod_checker := new_type_checker(mod_tree, intern, st, tt as ptr[TypeTable])
    mod_checker.run_type_checker()
    ax_printf_local("[Debug] Typechecking finished\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    fflush(null as ptr[void])
    mod_checker.ensure_capacity(mod_tree.nodes.len)
    mod.node_types = mod_checker.node_types as ptr[void]


    // Restore scope stack
    if st.stack.data != null as ptr[u32]:
        @free(st.stack.data as ptr[u8])
    st.stack.len = saved_len
    st.stack.cap = saved_cap
    st.stack.data = saved_data

    // 5. Export top-level public symbols
    if mod_tree.nodes.len > 0:
        let root = &mod_tree.nodes.data[0]
        mut child := root.first_child
        while child != 0 as u32:
            let child_node = &mod_tree.nodes.data[child]
            let kind = child_node.kind
            let flags = child_node.flags
            if kind == NODE_FUNC_DECL or kind == NODE_STRUCT_DECL or kind == NODE_CONST_DECL or kind == NODE_TYPE_ALIAS_DECL:
                if (flags & FLAG_IS_PUB) != 0 as u16 or (flags & FLAG_IS_EXTERN) != 0 as u16:
                    let sym_idx = child_node.payload
                    if sym_idx != 0 as u32:
                        let sym = &st.symbols.data[sym_idx]
                        let local_name_id = sym.name_id
                        let local_name = intern.get(local_name_id)
                        let full_name = std.string.concat(mod_name, std.string.concat(".", local_name))
                        let full_name_id = intern.intern_string(full_name)
                        
                        @free(get_str_ptr(full_name))
                        @free(get_str_ptr(local_name))
                        
                        // Flat define in global scope (0)
                        let global_scope = &st.scopes.data[0]
                        global_scope.scope_put(full_name_id, sym_idx)
                        
                        // Register export
                        let exp = ModuleExport(name_id: local_name_id, symbol_idx: sym_idx)
                        (&mod.exports).push(exp)

                        if kind == NODE_TYPE_ALIAS_DECL:
                            mut sum_child := child_node.first_child
                            mut sum_type_idx := 0 as u32
                            while sum_child != 0 as u32:
                                if mod_tree.nodes.data[sum_child].kind == NODE_SUM_TYPE:
                                    sum_type_idx = sum_child
                                    break
                                sum_child = mod_tree.nodes.data[sum_child].next_sibling
                            
                            if sum_type_idx != 0 as u32:
                                let sum_type_node = &mod_tree.nodes.data[sum_type_idx]
                                mut variant_idx := sum_type_node.first_child
                                while variant_idx != 0 as u32:
                                    let variant_node = &mod_tree.nodes.data[variant_idx]
                                    if variant_node.kind == NODE_VARIANT_DECL:
                                        let v_sym_idx = variant_node.payload
                                        if v_sym_idx != 0 as u32:
                                            let v_sym = &st.symbols.data[v_sym_idx]
                                            let v_local_name_id = v_sym.name_id
                                            let v_local_name = intern.get(v_local_name_id)
                                            let v_full_name = std.string.concat(mod_name, std.string.concat(".", v_local_name))
                                            let v_full_name_id = intern.intern_string(v_full_name)
                                            
                                            @free(get_str_ptr(v_full_name))
                                            @free(get_str_ptr(v_local_name))
                                            
                                            let global_scope_inner = &st.scopes.data[0]
                                            global_scope_inner.scope_put(v_full_name_id, v_sym_idx)
                                            
                                            let v_exp = ModuleExport(name_id: v_local_name_id, symbol_idx: v_sym_idx)
                                            (&mod.exports).push(v_exp)
                                    variant_idx = variant_node.next_sibling
            child = child_node.next_sibling

    // Cleanup resources
    mod.src_leak = src
    mod.tokens_leak = tokens
    mod.tokens_data = tokens.data as ptr[void]
    if lexer.tokens.data != null as ptr[Token]:
        @free(lexer.tokens.data as ptr[u8])
    if lexer.indent_stack.data != null as ptr[i32]:
        @free(lexer.indent_stack.data as ptr[u8])
    if lexer.newline_offsets.data != null as ptr[i32]:
        @free(lexer.newline_offsets.data as ptr[u8])
    mod.src_buffer = get_str_ptr(src) as ptr[void]
    @free(get_str_ptr(file_path))
    @free(get_str_ptr(mod_name))
    @free(mod_resolver as ptr[u8])
    @free(mod_checker as ptr[u8])
    @free(parser_ptr as ptr[u8])

    return 0 as i32