// ---- RFC 0006: single-precision (f32) SSE family. Mirrors the sd encoders but
// scalar-single uses the F3 prefix (vs F2 for scalar-double); comiss/movd drop
// the F2/F3 and use 66 (or none for comiss). These feed f32 codegen. ----

pub fn x86_encode_movss(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(dst, src, &modrm, &rex, &need_rex)
    push_byte(buf, 0xF3 as u8)
