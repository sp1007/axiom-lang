// bootstrap/stage1/print_helpers.ax
// Natively implemented safe formatting and console output functions.

import std.string

extern "C" fn fputs(s: ptr[u8], stream: ptr[void]) -> i32

// libc-free process exit (audit-libc-dependencies-2026-08-05 step 2), shared by
// every stage1 module that has to abort. Windows: ExitProcess (kernel32,
// whitelisted linker.ax:708). Linux: SYS_EXIT = 60. The `is_windows` intrinsic
// is a compile-time constant, so -O1 folds the dead side away; `syscall` maps to
// "none" in the linker (linker.ax:705) so the Windows image emits no import for it.
extern "C" fn ExitProcess(uExitCode: u32)
extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64

pub fn ax_exit_process(code: i32):
    if @compiler_intrinsic("is_windows"):
        ExitProcess(code as u32)
    else:
        syscall(60 as u64, code as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)

pub struct AxiomString:
    pub ptr: ptr[u8]
    pub len: i64

extern "C" fn ax_string_get_ptr_val(s: AxiomString) -> ptr[u8]

pub fn get_str_ptr(s: str) -> ptr[u8]:
    return s as ptr[u8]

pub fn safe_free_str(s: str):
    if std.string.len(s) > 0 as i64:
        @free(get_str_ptr(s))


pub fn unescape_string_literal(s: str) -> str:
    let s_len = std.string.len(s)
    if s_len < 2:
        let res = @alloc(1) as ptr[u8]
        res[0] = 0 as u8
        return res as str

    let s_ptr = s as ptr[u8]
    mut start := 0 as i64
    mut end := s_len
    // RFC 0024: a block string literal is delimited by `"""` (3 chars) each side.
    // Only a block token begins with three literal quotes (a normal string escapes
    // any interior quote), so this is unambiguous.
    if s_len >= 6 and s_ptr[0] == '"' as u8 and s_ptr[1] == '"' as u8 and s_ptr[2] == '"' as u8 and s_ptr[s_len - 1] == '"' as u8 and s_ptr[s_len - 2] == '"' as u8 and s_ptr[s_len - 3] == '"' as u8:
        start = 3
        end = s_len - 3
    elif s_ptr[0] == '"' as u8 and s_ptr[s_len - 1] == '"' as u8:
        start = 1
        end = s_len - 1

    let res_buf = @alloc(end - start + 1) as ptr[u8]
    mut res_len := 0 as i64
    mut i := start
    while i < end:
        let ch = s_ptr[i]
        if ch == '\\' as u8 and i + 1 < end:
            let next_ch = s_ptr[i + 1]
            if next_ch == 'n' as u8:
                res_buf[res_len] = 10 as u8
            elif next_ch == 't' as u8:
                res_buf[res_len] = 9 as u8
            elif next_ch == 'r' as u8:
                res_buf[res_len] = 13 as u8
            elif next_ch == '"' as u8:
                res_buf[res_len] = 34 as u8
            elif next_ch == '\\' as u8:
                res_buf[res_len] = 92 as u8
            else:
                res_buf[res_len] = next_ch
            res_len = res_len + 1
            i = i + 2
        else:
            res_buf[res_len] = ch
            res_len = res_len + 1
            i = i + 1

    res_buf[res_len] = 0 as u8
    return res_buf as str


fn print_raw(s: str):
    print(s)

fn print_raw_ptr(c_ptr: ptr[u8], len: i64):
    let s = AxiomString(ptr: c_ptr, len: len)
    let s_str = (&s as ptr[str])[0]
    print(s_str)


fn check_prefix(s_ptr: ptr[u8], s_len: i64, prefix: str) -> bool:
    let p_ptr = prefix as ptr[u8]
    let p_len = std.string.len(prefix)
    if s_len < p_len:
        return false
    mut i := 0 as i64
    while i < p_len:
        if s_ptr[i] != p_ptr[i]:
            return false
        i = i + 1
    return true


fn is_verbose_debug(s: str) -> bool:
    let s_len = std.string.len(s)
    if s_len < 2:
        return false
    let s_ptr = s as ptr[u8]
    
    // Skip leading spaces
    mut start_idx := 0 as i64
    while start_idx < s_len and s_ptr[start_idx] == ' ' as u8:
        start_idx = start_idx + 1
        
    if start_idx >= s_len - 1:
        return false
        
    if s_ptr[start_idx] == '[' as u8:
        let ch = s_ptr[start_idx + 1]
        // Check standard prefixes first
        if ch == 'M' as u8 or ch == 'T' as u8 or ch == 'C' as u8:
            // Matches [MONO-DEBUG], [TC-DEBUG], [CGEN-DEBUG] etc
            return true
        if ch == 'f' as u8:
            // Matches [field_offset]
            if check_prefix((s_ptr as i64 + start_idx) as ptr[u8], s_len - start_idx, "[field_offset]"):
                return true
        if ch == 'D' as u8:
            // Matches [Debug ...] or [DEBUG ...]
            // Check if it's one of the high-level progress prints starting with [Debug] or [DEBUG]
            let p_ptr = (s_ptr as i64 + start_idx) as ptr[u8]
            let p_len = s_len - start_idx
            if check_prefix(p_ptr, p_len, "[Debug] Stage"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Finished"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Creating"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Registering"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Preloading"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Resolver"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Pre-defining"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Resolving"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Typechecking"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Running"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Stripping"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Concatenating"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Cleaning up"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Concatenation"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] read_file_content"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Lexing"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Parsing"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Format"):
                return false
            if check_prefix(p_ptr, p_len, "[Debug] Reading"):
                return false
            // Any other [Debug ...] or [DEBUG ...] should be silenced
            return true
    else:
        // Silences ", arg_count=" print
        if s_ptr[start_idx] == ',' as u8:
            if check_prefix((s_ptr as i64 + start_idx) as ptr[u8], s_len - start_idx, ", arg_count="):
                return true
    return false

pub fn ax_puts_local(s: str) -> i32:
    if is_verbose_debug(s):
        return 0
    print_raw(s)
    print_raw("\n")
    return 0

fn print_i64_raw(val: i64):
    if val == -9223372036854775808 as i64:
        print_raw("-9223372036854775808")
        return
    if val == 0:
        print_raw("0")
        return
        
    mut v := val
    mut is_neg := false
    if v < 0:
        is_neg = true
        v = -v
        
    mut buf := @alloc(32) as ptr[u8]
    mut len := 0
    while v > 0:
        let digit = (v % 10) as u8
        buf[len] = '0' as u8 + digit
        len = len + 1
        v = v / 10
        
    if is_neg:
        buf[len] = '-' as u8
        len = len + 1
        
    // Reverse buffer
    mut i := 0
    while i < len / 2:
        let tmp = buf[i]
        buf[i] = buf[len - 1 - i]
        buf[len - 1 - i] = tmp
        i = i + 1
        
    buf[len] = 0 as u8
    
    print_raw_ptr(buf, len as i64)
    @free(buf)

pub fn ax_printf_local(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32:
    if is_verbose_debug(fmt):
        return 0
    let s_ptr = get_str_ptr(fmt)
    let s_len = std.string.len(fmt)
    mut arg_idx := 0
    mut i := 0 as i64
    mut start := 0 as i64
    
    while i < s_len:
        if s_ptr[i] == '%' as u8:
            if i > start:
                print_raw(std.string.slice(fmt, start, i))
                
            if i + 1 < s_len:
                if s_ptr[i + 1] == '%' as u8:
                    print_raw("%")
                    i = i + 1
                elif s_ptr[i + 1] == 'd' as u8:
                    mut val := 0 as i64
                    if arg_idx == 0:
                        val = a1
                    elif arg_idx == 1:
                        val = a2
                    elif arg_idx == 2:
                        val = a3
                    elif arg_idx == 3:
                        val = a4
                    elif arg_idx == 4:
                        val = a5
                    elif arg_idx == 5:
                        val = a6
                    elif arg_idx == 6:
                        val = a7
                    elif arg_idx == 7:
                        val = a8
                    
                    print_i64_raw(val)
                    arg_idx = arg_idx + 1
                    i = i + 1
                elif s_ptr[i + 1] == 's' as u8:
                    mut val_ptr_raw := 0 as i64
                    if arg_idx == 0:
                        val_ptr_raw = a1
                    elif arg_idx == 1:
                        val_ptr_raw = a2
                    elif arg_idx == 2:
                        val_ptr_raw = a3
                    elif arg_idx == 3:
                        val_ptr_raw = a4
                    elif arg_idx == 4:
                        val_ptr_raw = a5
                    elif arg_idx == 5:
                        val_ptr_raw = a6
                    elif arg_idx == 6:
                        val_ptr_raw = a7
                    elif arg_idx == 7:
                        val_ptr_raw = a8
                    
                    if val_ptr_raw != 0:
                        let c_ptr = val_ptr_raw as ptr[u8]
                        mut len := 0 as i64
                        while c_ptr[len] != 0 as u8:
                            len = len + 1
                        print_raw_ptr(c_ptr, len)
                    arg_idx = arg_idx + 1
                    i = i + 1
                start = i + 1
        i = i + 1
        
    if i > start:
        print_raw(std.string.slice(fmt, start, i))
        
    return 0

pub fn ax_snprintf_local(buf: ptr[void], size: i64, format: ptr[u8], a1: ptr[void], a2: ptr[void]) -> i32:
    let dest = buf as ptr[u8]
    mut dest_idx := 0 as i64
    mut fmt_idx := 0 as i64
    mut arg_idx := 0
    
    while format[fmt_idx] != 0 as u8 and dest_idx < size - 1:
        if format[fmt_idx] == '%' as u8 and format[fmt_idx + 1] == 's' as u8:
            mut val_ptr := null as ptr[u8]
            if arg_idx == 0:
                val_ptr = a1 as ptr[u8]
            else:
                val_ptr = a2 as ptr[u8]
            
            if val_ptr != null as ptr[u8]:
                mut k := 0 as i64
                while val_ptr[k] != 0 as u8 and dest_idx < size - 1:
                    dest[dest_idx] = val_ptr[k]
                    dest_idx = dest_idx + 1
                    k = k + 1
            arg_idx = arg_idx + 1
            fmt_idx = fmt_idx + 2
        else:
            dest[dest_idx] = format[fmt_idx]
            dest_idx = dest_idx + 1
            fmt_idx = fmt_idx + 1
            
    dest[dest_idx] = 0 as u8
    return dest_idx as i32

fn print_to_file(stream: ptr[void], s: str):
    let s_ptr = get_str_ptr(s)
    let s_len = std.string.len(s)
    if s_len <= 0:
        return
    let buf = @alloc(s_len + 1) as ptr[u8]
    @memcpy(buf, s_ptr, s_len)
    buf[s_len] = 0 as u8
    fputs(buf, stream)
    @free(buf)

fn print_i64_to_file(stream: ptr[void], val: i64):
    if val == -9223372036854775808 as i64:
        print_to_file(stream, "-9223372036854775808")
        return
    if val == 0:
        print_to_file(stream, "0")
        return
        
    mut v := val
    mut is_neg := false
    if v < 0:
        is_neg = true
        v = -v
        
    mut buf := @alloc(32) as ptr[u8]
    mut len := 0
    while v > 0:
        let digit = (v % 10) as u8
        buf[len] = '0' as u8 + digit
        len = len + 1
        v = v / 10
        
    if is_neg:
        buf[len] = '-' as u8
        len = len + 1
        
    // Reverse buffer
    mut i := 0
    while i < len / 2:
        let tmp = buf[i]
        buf[i] = buf[len - 1 - i]
        buf[len - 1 - i] = tmp
        i = i + 1
        
    buf[len] = 0 as u8
    
    fputs(buf, stream)
    @free(buf)

pub fn ax_fprintf_local(stream: ptr[void], fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32:
    if is_verbose_debug(fmt):
        return 0
    let s_ptr = get_str_ptr(fmt)
    let s_len = std.string.len(fmt)
    mut arg_idx := 0
    mut i := 0 as i64
    mut start := 0 as i64
    
    while i < s_len:
        if s_ptr[i] == '%' as u8:
            if i > start:
                print_to_file(stream, std.string.slice(fmt, start, i))
                
            if i + 1 < s_len:
                if s_ptr[i + 1] == '%' as u8:
                    print_to_file(stream, "%")
                    i = i + 1
                elif s_ptr[i + 1] == 'd' as u8:
                    mut val := 0 as i64
                    if arg_idx == 0:
                        val = a1
                    elif arg_idx == 1:
                        val = a2
                    elif arg_idx == 2:
                        val = a3
                    elif arg_idx == 3:
                        val = a4
                    elif arg_idx == 4:
                        val = a5
                    elif arg_idx == 5:
                        val = a6
                    elif arg_idx == 6:
                        val = a7
                    elif arg_idx == 7:
                        val = a8
                    
                    print_i64_to_file(stream, val)
                    arg_idx = arg_idx + 1
                    i = i + 1
                elif s_ptr[i + 1] == 's' as u8:
                    mut val_ptr_raw := 0 as i64
                    if arg_idx == 0:
                        val_ptr_raw = a1
                    elif arg_idx == 1:
                        val_ptr_raw = a2
                    elif arg_idx == 2:
                        val_ptr_raw = a3
                    elif arg_idx == 3:
                        val_ptr_raw = a4
                    elif arg_idx == 4:
                        val_ptr_raw = a5
                    elif arg_idx == 5:
                        val_ptr_raw = a6
                    elif arg_idx == 6:
                        val_ptr_raw = a7
                    elif arg_idx == 7:
                        val_ptr_raw = a8
                    
                    if val_ptr_raw != 0:
                        let c_ptr = val_ptr_raw as ptr[u8]
                        fputs(c_ptr, stream)
                    arg_idx = arg_idx + 1
                    i = i + 1
                start = i + 1
        i = i + 1
        
    if i > start:
        print_to_file(stream, std.string.slice(fmt, start, i))
        
    return 0

pub fn ax_sprintf_local(buf: ptr[u8], format: ptr[u8], val: f64) -> i32:
    mut dest := buf
    mut v := val
    mut prefix_len := 0 as i64
    if v < 0.0:
        dest[0] = '-' as u8
        dest = ((dest as u64) + 1 as u64) as ptr[u8]
        v = -v
        prefix_len = 1
        
    // Integer part
    let int_part = v as i64
    let frac = v - int_part as f64
    
    // Format integer part
    mut temp_buf := @alloc(32) as ptr[u8]
    mut temp_len := 0
    mut temp_val := int_part
    if temp_val == 0:
        temp_buf[0] = '0' as u8
        temp_len = 1
    else:
        while temp_val > 0:
            let digit = (temp_val % 10) as u8
            temp_buf[temp_len] = '0' as u8 + digit
            temp_len = temp_len + 1
            temp_val = temp_val / 10
            
    // Reverse integer part into dest
    mut i := 0
    while i < temp_len:
        dest[i] = temp_buf[temp_len - 1 - i]
        i = i + 1
    @free(temp_buf)
    
    mut dest_idx := temp_len as i64
    dest[dest_idx] = '.' as u8
    dest_idx = dest_idx + 1
    
    // Fractional part (6 digits precision)
    mut frac_val := (frac * 1000000.0 + 0.5) as i64
    if frac_val >= 1000000:
        frac_val = 999999
        
    // Format fractional part with leading zeros
    mut frac_buf := @alloc(32) as ptr[u8]
    mut j := 0
    mut f_val := frac_val
    while j < 6:
        let digit = (f_val % 10) as u8
        frac_buf[5 - j] = '0' as u8 + digit
        f_val = f_val / 10
        j = j + 1
        
    j = 0
    while j < 6:
        dest[dest_idx] = frac_buf[j]
        dest_idx = dest_idx + 1
        j = j + 1
    @free(frac_buf)
    
    // Strip trailing zeros and the dot if all fractional digits are zero
    while dest_idx > 0 and dest[dest_idx - 1] == '0' as u8:
        dest_idx = dest_idx - 1
    if dest_idx > 0 and dest[dest_idx - 1] == '.' as u8:
        dest_idx = dest_idx - 1
        
    if dest_idx == 0:
        dest[0] = '0' as u8
        dest_idx = 1
        
    dest[dest_idx] = 0 as u8
    return (dest_idx + prefix_len) as i32

pub fn extract_qualified_base_name(name: str) -> str:
    let length = std.string.len(name)
    if length < 1:
        return std.string.concat("", "")
        
    let name_ptr = get_str_ptr(name)
    if length >= 4 and name_ptr[0] == '_' as u8 and name_ptr[1] == 'A' as u8 and name_ptr[2] == 'X' as u8 and name_ptr[3] == '_' as u8:
        return extract_base_name(name)
        
    // Find last '.'
    mut last_dot := -1 as i64
    mut i := length - 1 as i64
    while i >= 0 as i64:
        if name_ptr[i] == '.' as u8:
            last_dot = i
            break
        i = i - 1 as i64
        
    mut base := name
    if last_dot != -1 as i64:
        base = std.string.slice(name, last_dot + 1, length)
        
    let base_len = std.string.len(base)
    let base_ptr = get_str_ptr(base)
    mut d_idx := -1 as i64
    mut j := 0 as i64
    while j < base_len - 1 as i64:
        if base_ptr[j] == '_' as u8 and base_ptr[j + 1] == '_' as u8:
            d_idx = j
            break
        j = j + 1
        
    if d_idx != -1 as i64:
        return std.string.slice(base, 0, d_idx)
    return std.string.concat("", base)

// RFC 0018 P2: strip the module qualifier AND the generic-argument suffix so a
// monomorphized container type resolves to its bare constructor name, e.g.
// "std.collections.Vec[i64]" -> "Vec". Used to recognize `Vec[T]` for `for x in vec`.
pub fn extract_base_type_name(name: str) -> str:
    let q = extract_qualified_base_name(name)
    let length = std.string.len(q)
    let p = get_str_ptr(q)
    mut br := length
    mut i := 0 as i64
    while i < length:
        if p[i] == '[' as u8:
            br = i
            break
        i = i + 1
    if br == length:
        return q
    return std.string.slice(q, 0, br)


pub fn extract_base_name(name: str) -> str:
    let length = std.string.len(name)
    if length < 4:
        return std.string.concat("", name)
        
    let name_ptr = get_str_ptr(name)
    if name_ptr[0] != '_' as u8 or name_ptr[1] != 'A' as u8 or name_ptr[2] != 'X' as u8 or name_ptr[3] != '_' as u8:
        return std.string.concat("", name)
        
    // Find first occurrence of "__"
    mut d_idx := -1 as i64
    mut i := 4 as i64
    while i < length - 1 as i64:
        if name_ptr[i] == '_' as u8 and name_ptr[i + 1] == '_' as u8:
            d_idx = i
            break
        i = i + 1
        
    // The prefix is name[0..d_idx] (or name[0..length] if no "__")
    mut prefix_len := length
    if d_idx != -1 as i64:
        prefix_len = d_idx
        
    // Find last "_" in the prefix
    mut last_u_idx := -1 as i64
    i = prefix_len - 1 as i64
    while i >= 0 as i64:
        if name_ptr[i] == '_' as u8:
            last_u_idx = i
            break
        i = i - 1 as i64
        
    // The base starts after the last "_" in prefix, and ends at prefix_len
    mut start_idx := 0 as i64
    if last_u_idx != -1 as i64 and last_u_idx < prefix_len - 1 as i64:
        start_idx = last_u_idx + 1
        
    let base_len = prefix_len - start_idx
    if base_len <= 0:
        return std.string.concat("", "")
        
    // Allocate the fresh base string and copy characters
    let base_ptr = @alloc(base_len + 1) as ptr[u8]
    @memcpy(base_ptr, (name_ptr as i64 + start_idx) as ptr[u8], base_len)
    base_ptr[base_len] = 0 as u8
    return base_ptr as str


// ─── Diagnostic source locations (CLAUDE.md §8) ──────────────────────────────────────
// The driver hands the frontend ONE concatenated buffer (std/*.ax bundled ahead of the
// user's own file), so a raw byte offset into it — `at offset 142042` for a nine-line
// program — is meaningless to the person who wrote the mistake. A SourceMap records the
// half-open byte region each ORIGINAL file occupies inside that buffer, which is all that
// is needed to recover `file.ax:LINE` exactly: strip_imports is length-preserving (it
// blanks an `import std...` line to spaces and keeps its newline instead of deleting the
// line), so both byte offsets and line counts survive preprocessing untouched.
//
// Regions are built ONCE by the driver (main_air.ax) where every boundary is already a
// live local, and threaded to the passes through AstTree.srcmap — no global state
// (CLAUDE.md §3). A null map, or an offset in no region at all, degrades to a byte offset
// rather than guessing a file: a WRONG file name is worse than no file name.
pub struct SourceRegion:
    path: str
    start: i64   // inclusive
    end: i64     // EXCLUSIVE

pub struct SourceMap:
    data: ptr[SourceRegion]
    len: i64
    cap: i64

// Fixed capacity by construction: the driver bundles 8 stdlib files, the user's file, and
// at most 2 Linux runtime shims = 12 regions. Capacity 32 leaves headroom without a
// growth path that would never be exercised (and so never be tested).
pub fn new_source_map() -> ptr[SourceMap]:
    let m = @alloc(@compiler_intrinsic("size_of")[SourceMap]()) as ptr[SourceMap]
    m.data = @alloc(32 * @compiler_intrinsic("size_of")[SourceRegion]()) as ptr[SourceRegion]
    m.len = 0 as i64
    m.cap = 32 as i64
    return m

pub fn srcmap_add(mut self: ptr[SourceMap], path: str, start: i64, end: i64):
    if self == null as ptr[SourceMap] or self.len >= self.cap:
        return
    if end <= start:
        return
    self.data[self.len] = SourceRegion(path: path, start: start, end: end)
    self.len = self.len + 1 as i64

// Index of the region containing `off`, or -1 when there is none. -1 is the honest answer
// for three distinct situations, and all three must degrade the same way:
//   * srcmap is null      — an imported module's tree, which the driver never mapped;
//   * `--no-stdlib` gaps  — nothing was concatenated (the driver still maps the whole
//                           buffer in that case, so this is belt-and-braces);
//   * SYNTHETIC offsets   — ast.ax::clone_subtree_from appends a cloned token's text to
//                           tree.src and gives the clone `offset = len(old_src)`, so a
//                           monomorphized node's offset lands PAST every region and
//                           genuinely corresponds to no file.
pub fn srcmap_find(srcmap: ptr[SourceMap], off: i64) -> i64:
    if srcmap == null as ptr[SourceMap]:
        return -1 as i64
    mut i := 0 as i64
    while i < srcmap.len:
        if off >= srcmap.data[i].start and off < srcmap.data[i].end:
            return i
        i = i + 1 as i64
    return -1 as i64

// THE single renderer for a diagnostic's location block (CLAUDE.md §8):
//
//     --> file.ax:12
//       |
//    12 | let x: i32 = "hello"
//       |        ^^^ expected i32, found string
//       |
//
// parser.ax, typecheck.ax and ownership.ax ALL render through this one function. Before
// this there were THREE copies of the idea and they had already drifted: only the
// typechecker's printed a source snippet, and none of them could print a file or a line.
// "One rule, two copies" is this repository's most expensive recurring defect class (the
// interface-return miscompile, the lower_int_lit/lower_float_lit divergence, the
// resolve_method_overload arity split, P6) — do not add a fourth. Callers keep only what
// is genuinely theirs: the `error[Exxxx]: ...` headline, and the caret SPAN (the
// typechecker widens it from a leading unary `-` to the end of the literal).
//
// ⚠️ LINE ONLY — the absence of a COLUMN is deliberate, not an oversight. The driver's
// strip_package_prefixes rewrites lines IN PLACE before the lexer ever runs (deleting e.g.
// `std.string.` = 11 bytes, and one byte per `::` → `.`), so a column recovered from the
// preprocessed buffer is shifted left by however much was stripped ahead of it on that
// line, and would be silently wrong. A correct `file.ax:12` beats a wrong `file.ax:12:8`.
// Recovering true columns requires replaying that rewrite in lockstep and is a separate
// change; do NOT "helpfully" add a column here before that exists.
pub fn print_diag_location(srcmap: ptr[SourceMap], src: str, off: i64, span_in: i64, caret_msg: str):
    let srclen = std.string.len(src)
    let ri = srcmap_find(srcmap, off)
    if ri < 0 as i64 or off < 0 as i64 or off >= srclen:
        // No mapped file (see srcmap_find). Report the raw offset — the same information
        // every diagnostic carried before source maps existed — instead of naming a file
        // that may not be the one the offset belongs to.
        if std.string.len(caret_msg) > 0 as i64:
            ax_printf_local("   = %s (at byte offset %d of the compilation unit)\n", get_str_ptr(caret_msg) as i64, off, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_printf_local("   = at byte offset %d of the compilation unit\n", off, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        return
    let reg_start = srcmap.data[ri].start
    mut reg_end := srcmap.data[ri].end
    if reg_end > srclen:
        reg_end = srclen
    // ONE forward scan yields BOTH the 1-based line number and the start of that line.
    // (lexer.ax::find_line_start scans BACKWARD for the line start alone; calling it here
    // would add a second full pass over the region and still leave the line number to
    // count. It stays where it is, serving the lexer's indentation logic — this is not a
    // second copy of that rule, it is the one loop that has to run anyway.)
    mut line := 1 as i64
    mut ls := reg_start
    mut i := reg_start
    while i < off:
        if src[i] as u8 == 10:
            line = line + 1 as i64
            ls = i + 1 as i64
        i = i + 1 as i64
    ax_printf_local(" --> %s:%d\n", get_str_ptr(srcmap.data[ri].path) as i64, line, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // End of the offending line, clamped to the region so a snippet can never bleed into
    // the next bundled file.
    mut le := off
    while le < reg_end and src[le] as u8 != 10:
        le = le + 1 as i64
    // Gutter width tracks the line number's own width so the `|` column stays aligned:
    // `12 | ...` renders against a blank `   |`, exactly as CLAUDE.md §8 shows.
    mut w := 1 as i64
    mut nn := line
    while nn >= 10 as i64:
        w = w + 1 as i64
        nn = nn / 10 as i64
    let gut = @alloc(w + 3 as i64) as ptr[u8]
    mut gi := 0 as i64
    while gi < w + 1 as i64:
        gut[gi] = ' ' as u8
        gi = gi + 1 as i64
    gut[w + 1 as i64] = '|' as u8
    gut[w + 2 as i64] = 0 as u8
    ax_printf_local("%s\n", gut as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    ax_printf_local("%d | ", line, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    let base = (src as ptr[u8]) as i64
    print_raw_ptr((base + ls) as ptr[u8], le - ls)
    print_raw("\n")
    // Caret line: pad to the offending column, then one '^' per source byte of the span.
    mut span := span_in
    if span < 1 as i64:
        span = 1 as i64
    if off + span > le:
        span = le - off
    if span < 1 as i64:
        span = 1 as i64
    let pad = off - ls
    let cbuf = @alloc(pad + span + 1 as i64) as ptr[u8]
    mut ci := 0 as i64
    while ci < pad:
        cbuf[ci] = ' ' as u8
        ci = ci + 1 as i64
    mut cj := 0 as i64
    while cj < span:
        cbuf[pad + cj] = '^' as u8
        cj = cj + 1 as i64
    cbuf[pad + span] = 0 as u8
    if std.string.len(caret_msg) > 0 as i64:
        ax_printf_local("%s %s %s\n", gut as i64, cbuf as i64, get_str_ptr(caret_msg) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        ax_printf_local("%s %s\n", gut as i64, cbuf as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    @free(cbuf)
    ax_printf_local("%s\n", gut as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    @free(gut)

