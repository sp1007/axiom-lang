// bootstrap/stage1/escape.ax
// EscapeAnalyser performs escape analysis using ConnectionGraph.

import std.string

// extern "C" fn printf(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i32
// extern "C" fn puts(s: str) -> i32

pub struct EscapeAnalyser:
    pub tree: ptr[AstTree]
    pub pool: ptr[InternPool]
    pub symtable: ptr[SymbolTable]
    pub typetable: ptr[TypeTable]
    pub curr_cg: ConnectionGraph
    pub escape_node_idx: u32
    // RFC 0015 P3: per-node resolved result types (from TypeChecker.node_types), used
    // to tell a scalar field/index read (value copy, base does not escape) from an
    // aggregate read (aliases the base). node_types_cap bounds the array.
    pub node_types: ptr[u32]
    pub node_types_cap: i64

pub fn new_escape_analyser(tree: ptr[AstTree], pool: ptr[InternPool], symtable: ptr[SymbolTable], typetable: ptr[TypeTable], node_types: ptr[u32], node_types_cap: i64) -> ptr[EscapeAnalyser]:
    let ea = @alloc(@compiler_intrinsic("size_of")[EscapeAnalyser]()) as ptr[EscapeAnalyser]
    ea.tree = tree
    ea.pool = pool
    ea.symtable = symtable
    ea.typetable = typetable
    ea.curr_cg = new_connection_graph()
    ea.escape_node_idx = 0 as u32
    ea.node_types = node_types
    ea.node_types_cap = node_types_cap
    return ea

// RFC 0015 P3: true iff `expr_idx`'s resolved result type is a scalar PRIMITIVE.
// Unresolved (0 / out of range) => false (treat conservatively as aggregate).
pub fn ea_result_is_scalar(self: ptr[EscapeAnalyser], expr_idx: u32) -> bool:
    if self.node_types == null as ptr[u32]:
        return false
    if (expr_idx as i64) >= self.node_types_cap:
        return false
    let rt = self.node_types[expr_idx as i64]
    if rt == 0 as u32 or (rt as i64) >= self.typetable.entries.len:
        return false
    return self.typetable.entries.data[rt].kind == TYPE_KIND_PRIMITIVE

pub fn run(mut self: ptr[EscapeAnalyser]):
    self.curr_cg = new_connection_graph()
    self.escape_node_idx = 0 as u32
    self.traverse_nodes(0 as u32)
    // curr_cg is a valid (empty) graph here: every NODE_FUNC_DECL frees its own
    // per-function graph and resets curr_cg back to an empty one, so this final
    // free never touches dangling buffers.
    free_connection_graph(self.curr_cg)

pub fn traverse_nodes(mut self: ptr[EscapeAnalyser], node_idx: u32):
    // RFC 0015 P2: guard fixed to allow traversal of the real root (node 0).
    // Recursive descent already filters `!= 0` at every call site, so only the
    // 0xffffffff sentinel is needed here (node 0 is the real NODE_PROGRAM root).
    if node_idx == 0xffffffff as u32:
        return

    let node = self.tree.nodes.data[node_idx]
    let kind = node.kind

    if kind == NODE_FUNC_DECL:
        // Build a fresh connection graph for this function. Functions are never
        // nested in AXIOM, so there is no outer graph to save/restore -- the old
        // `let old_cg = self.curr_cg; ...; self.curr_cg = old_cg` dance was written
        // for value-copy semantics, but AXIOM aggregates ALIAS (RFC 0010), so it
        // left curr_cg pointing at just-freed buffers and crashed the final free.
        self.curr_cg = new_connection_graph()
        self.escape_node_idx = self.curr_cg.add_value_node(0 as u32, 0 as u32, 0 as u32)

        // Register parameters
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_PARAM_DECL:
                let sym_idx = child.payload
                if sym_idx != 0 as u32:
                    let sym = self.symtable.symbols.data[sym_idx]
                    self.curr_cg.add_value_node(sym_idx, sym.type_id, 0 as u32)
            child_idx = child.next_sibling

        // Analyze function body
        child_idx = node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            child_idx = child.next_sibling

        // Tag local variables that escape
        mut idx := 0 as i64
        while idx < self.curr_cg.nodes.len:
            let cg_node = self.curr_cg.nodes.data[idx]
            if cg_node.sym_id != 0 as u32:
                let sym_idx = cg_node.sym_id
                let is_escaping = self.curr_cg.escapes(cg_node.id)
                if is_escaping:
                    // RFC 0015 P2: mark the escaping local in the SYM-flag space at
                    // SYM_FLAG_ESCAPES (4096), NOT the node-space FLAG_ESCAPES_TO_HEAP
                    // (128) -- that value collides with SYM_FLAG_MOVED and would make
                    // ownership.ax emit E4001 on every use. This flag has no consumer
                    // yet (CTGC free = P3), so setting it stays fixpoint-neutral (A==B);
                    // it is the substrate the P3 whitelist will read.
                    self.symtable.symbols.data[sym_idx].flags = self.symtable.symbols.data[sym_idx].flags | SYM_FLAG_ESCAPES
            idx = idx + 1

        // Free this function's graph and reset curr_cg to a valid empty graph so
        // the next function (and run()'s final free) never see dangling buffers.
        free_connection_graph(self.curr_cg)
        self.curr_cg = new_connection_graph()

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.traverse_nodes(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn analyze_block(mut self: ptr[EscapeAnalyser], block_idx: u32):
    if block_idx == 0 as u32 or block_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[block_idx]
    mut child_idx := node.first_child
    while child_idx != 0 as u32:
        self.analyze_stmt(child_idx)
        child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn analyze_stmt(mut self: ptr[EscapeAnalyser], stmt_idx: u32):
    if stmt_idx == 0 as u32 or stmt_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[stmt_idx]
    let kind = node.kind

    if kind == NODE_VAR_DECL:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let sym = self.symtable.symbols.data[sym_idx]
            let cg_idx = self.curr_cg.add_value_node(sym_idx, sym.type_id, 0 as u32)
            let init_idx = node.first_child
            if init_idx != 0 as u32:
                // RFC 0015 P2/P3 (ownership-origin soundness, prerequisite for P3 free):
                // a local only OWNS fresh, single-owner memory when its initialiser
                // constructs a new aggregate. Owning initialisers:
                //   * a struct/array literal (NODE_STRUCT_LIT / NODE_ARRAY_LIT), and
                //   * a constructor call `Name(...)` where `Name` resolves to a struct
                //     type (SYM_STRUCT) -- in AXIOM `Box(f: v)` parses as a CALL_EXPR,
                //     not a STRUCT_LIT, so without this every struct construction would
                //     be treated as a borrow and P3 would free nothing.
                // Any OTHER initialiser makes the local BORROW/ALIAS longer-lived memory
                // that CTGC must never free (ident=alias, INDEX/FIELD=borrow into a
                // longer-lived aggregate RFC 0010 §9, ordinary call=maybe a borrow, no
                // interprocedural analysis). Flow such locals to the escape node so
                // escapes()=true and P3 refuses to free them.
                let init_kind = self.tree.nodes.data[init_idx].kind
                mut is_owning := init_kind == NODE_STRUCT_LIT or init_kind == NODE_ARRAY_LIT
                if init_kind == NODE_CALL_EXPR:
                    let callee_idx = self.tree.nodes.data[init_idx].first_child
                    if callee_idx != 0 as u32:
                        let callee = self.tree.nodes.data[callee_idx]
                        if callee.kind == NODE_IDENT and callee.payload != 0 as u32:
                            if self.symtable.symbols.data[callee.payload].kind == SYM_STRUCT:
                                is_owning = true
                if not is_owning:
                    self.curr_cg.add_edge(cg_idx, self.escape_node_idx, EDGE_FLOWS_TO)
                self.analyze_expr(init_idx, cg_idx)

    elif kind == NODE_ASSIGN_STMT:
        let lhs_idx = node.first_child
        let rhs_idx = self.tree.nodes.data[lhs_idx].next_sibling
        if lhs_idx != 0 as u32:
            let lhs_kind = self.tree.nodes.data[lhs_idx].kind
            if lhs_kind == NODE_IDENT:
                let sym_idx = self.tree.nodes.data[lhs_idx].payload
                if sym_idx != 0 as u32:
                    let lhs_cg_idx = self.curr_cg.node_of_sym(sym_idx)
                    if lhs_cg_idx != 0xffffffff as u32:
                        self.analyze_expr(rhs_idx, lhs_cg_idx)
                    else:
                        // RFC 0015 P3 soundness: the LHS ident is NOT a tracked local
                        // (a module global, or a binding outside this function's graph),
                        // which outlives the function -- so the RHS ESCAPES. Without this
                        // `g = x` let `x` look non-escaping and CTGC would free memory the
                        // global still points at (UAF).
                        self.analyze_expr(rhs_idx, self.escape_node_idx)
                else:
                    self.analyze_expr(rhs_idx, self.escape_node_idx)
            else:
                // non-ident LHS means struct field or indexing, RHS escapes to heap
                self.analyze_expr(rhs_idx, self.escape_node_idx)

    elif kind == NODE_RETURN_STMT:
        let val_idx = node.first_child
        if val_idx != 0 as u32:
            self.analyze_expr(val_idx, self.escape_node_idx)

    elif kind == NODE_CALL_EXPR:
        // RFC 0015 P3 soundness (container-store escape): a bare call statement
        // (`container.push(local)`, `vec.insert(x)`, `emit(inst)`) discards its value
        // but may STORE an argument into a receiver that outlives the call. Route it
        // through analyze_expr's CALL_EXPR case so the callee + every by-value argument
        // flow to the escape node -> a ctor local handed to a container mutator is marked
        // escaping and CTGC never frees memory the container still aliases. Without this
        // the call sits at statement position and the else-branch (mis)visits its arg
        // nodes as STATEMENTS (analyze_stmt has no NODE_IDENT case) so they never flow ->
        // the missed-escape that made v_exp/exp/init_inst wrongly freeable (would UAF at
        // -ctgc-free activation, e.g. `(&mod.exports).push(v_exp)`). Inert on the default
        // build (SYM_FLAG_ESCAPES is only consumed by the gated-off CTGC free pass).
        self.analyze_expr(stmt_idx, self.escape_node_idx)

    elif kind == NODE_IF_STMT:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            else:
                self.analyze_stmt(child_idx)
            child_idx = child.next_sibling

    elif kind == NODE_WHILE_STMT or kind == NODE_FOR_STMT:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            if child.kind == NODE_BLOCK:
                self.analyze_block(child_idx)
            child_idx = child.next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.analyze_stmt(child_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling

pub fn analyze_expr(mut self: ptr[EscapeAnalyser], expr_idx: u32, flow_dest: u32):
    if expr_idx == 0 as u32 or expr_idx == 0xffffffff as u32:
        return
    let node = self.tree.nodes.data[expr_idx]
    let kind = node.kind

    if kind == NODE_IDENT:
        let sym_idx = node.payload
        if sym_idx != 0 as u32:
            let cg_src = self.curr_cg.node_of_sym(sym_idx)
            if cg_src != 0xffffffff as u32 and flow_dest != 0xffffffff as u32:
                self.curr_cg.add_edge(cg_src, flow_dest, EDGE_FLOWS_TO)

    elif kind == NODE_CALL_EXPR:
        // Function call: arguments flow to return/escape
        mut child_idx := node.first_child
        if child_idx != 0 as u32:
            // First is callee
            self.analyze_expr(child_idx, self.escape_node_idx)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
            while child_idx != 0 as u32:
                self.analyze_expr(child_idx, self.escape_node_idx)
                child_idx = self.tree.nodes.data[child_idx].next_sibling

    elif kind == NODE_STRUCT_LIT:
        // Struct literal fields flow to the struct dest
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            let child = self.tree.nodes.data[child_idx]
            let val_idx = child.first_child
            if val_idx != 0 as u32:
                self.analyze_expr(val_idx, flow_dest)
            child_idx = child.next_sibling

    elif kind == NODE_FIELD_EXPR or kind == NODE_INDEX_EXPR:
        // RFC 0015 P3 flow refinement: a SCALAR (PRIMITIVE) field/element read of a
        // simple local yields a VALUE COPY -- the base aggregate does NOT escape
        // through it, so P3 may still free the base. Only an aggregate-typed (or
        // unresolved) read aliases into the base and must propagate escape.
        // Conservative on two axes (worst case = free LESS, never a UAF):
        //   * unresolved result type -> treated as aggregate (propagate), and
        //   * only a base that is a plain IDENT is exempted; a complex base
        //     (e.g. `f().field`) falls through to normal propagation.
        let base_idx = node.first_child
        mut base_is_ident := false
        if base_idx != 0 as u32:
            base_is_ident = self.tree.nodes.data[base_idx].kind == NODE_IDENT
        if self.ea_result_is_scalar(expr_idx) and base_is_ident:
            // scalar read of `local.field` / `local[i]`: do NOT flow the base to
            // dest. Still analyse an index operand (it may contain escaping calls).
            if kind == NODE_INDEX_EXPR:
                let idx_operand = self.tree.nodes.data[base_idx].next_sibling
                self.analyze_expr(idx_operand, flow_dest)
        else:
            mut child_idx := node.first_child
            while child_idx != 0 as u32:
                self.analyze_expr(child_idx, flow_dest)
                child_idx = self.tree.nodes.data[child_idx].next_sibling

    else:
        mut child_idx := node.first_child
        while child_idx != 0 as u32:
            self.analyze_expr(child_idx, flow_dest)
            child_idx = self.tree.nodes.data[child_idx].next_sibling
