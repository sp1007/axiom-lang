// --time monotonic clock, libc-free (audit-libc-dependencies-2026-08-05 step 2).
// Windows: QueryPerformanceCounter/Frequency (kernel32, whitelisted linker.ax:716).
// Linux:   clock_gettime(CLOCK_MONOTONIC=1) = syscall 228.
// This replaces libc `clock()`, which additionally MIS-reported on Linux: there
// CLOCKS_PER_SEC is 1000000 and clock() measures CPU (not wall) time, so the
// "ms" the driver printed were microseconds of CPU time.
extern "C" fn QueryPerformanceCounter(lpPerformanceCount: ptr[i64]) -> i32
extern "C" fn QueryPerformanceFrequency(lpFrequency: ptr[i64]) -> i32

struct DriverTimespec:
    tv_sec: i64
    tv_nsec: i64

fn time_now_ms() -> i64:
    if @compiler_intrinsic("is_windows"):
        mut counter := 0 as i64
        mut freq := 0 as i64
        QueryPerformanceCounter(&counter)
        QueryPerformanceFrequency(&freq)
        if freq == 0 as i64:
            return 0 as i64
        // Split to avoid overflow: whole seconds * 1000 + fractional ticks * 1000 / freq.
        return counter / freq * 1000 as i64 + (counter % freq) * 1000 as i64 / freq
    else:
        mut ts := DriverTimespec(tv_sec: 0 as i64, tv_nsec: 0 as i64)
        let pts = &ts
        syscall(228 as u64, 1 as u64, pts as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        return ts.tv_sec * 1000 as i64 + ts.tv_nsec / 1000000 as i64

// --time helper: print "[time] <label>: <ms>" and return the current tick to reset
// the caller's running marker. `on` gates the whole thing so it is inert without --time.
fn time_phase(on: bool, label: str, prev: i64) -> i64:
    if not on:
        return prev
    let now = time_now_ms()
    ax_printf_local("[time] %s: %d ms\n", get_str_ptr(label) as i64, (now - prev) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    return now
extern "C" fn fputs(s: ptr[u8], stream: ptr[void]) -> i32


fn print_inst(mut inst: AirInst, call_count_ptr: ptr[u32]):
    let op = inst.opcode
    if op == OP_NOP:
        return

    if op == OP_RETURN:
        if inst.src1 != 0 as u32:
            ax_printf_local("    ret %%%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_puts_local("    ret")
    elif op == OP_JUMP:
        ax_printf_local("    jump block_%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    elif op == OP_BRANCH:
        ax_printf_local("    branch %%%d block_%d block_%d\n", inst.src1 as i64, inst.src2 as i64, inst.dest as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    else:
        let mnemonic = opcode_mnemonic(op)
        let has_dest = (inst.dest != 0 as u32)
        let has_src1 = (inst.src1 != 0 as u32)
        let has_src2 = (inst.src2 != 0 as u32)
        let is_binary = opcode_is_binary_alu(op)

        if has_dest:
            mut type_id := inst.type_id
            if op == OP_CALL or op == OP_INDEX or op == OP_DEREF or op == OP_CAST or op == OP_AWAIT:
                type_id = 0 as u16

            if type_id != 0 as u16:
                ax_printf_local("    %%%d: t%d = %s", inst.dest as i64, type_id as i64, (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            else:
                ax_printf_local("    %%%d = %s", inst.dest as i64, (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_printf_local("    %s", (mnemonic as ptr[u8]) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

        if is_binary and has_src1 and has_src2:
            ax_printf_local(" %%%d, %%%d\n", inst.src1 as i64, inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src1 and has_src2:
            ax_printf_local(" %%%d, %%%d\n", inst.src1 as i64, inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src1:
            ax_printf_local(" %%%d\n", inst.src1 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        elif has_src2:
            ax_printf_local(" %%%d\n", inst.src2 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        else:
            ax_puts_local("")

fn print_block(f: AirFunc, mut bb: BasicBlock, call_count_ptr: ptr[u32]):
    ax_printf_local("  block_%d:", bb.id as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    if bb.is_entry and bb.is_exit:
        ax_puts_local("  ; entry exit")
    elif bb.is_entry:
        ax_puts_local("  ; entry")
    elif bb.is_exit:
        ax_puts_local("  ; exit")
    else:
        ax_puts_local("")

    mut i := 0 as i64
    while i < bb.instrs_len as i64:
        let inst_idx = f.block_instrs.data[bb.instrs_start as i64 + i]
        if inst_idx < f.insts.len as u32:
            let inst = f.insts.data[inst_idx as i64]
            print_inst(inst, call_count_ptr)
        i = i + 1

fn print_func(f: AirFunc):
    ax_printf_local("fn @%d(", f.name as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut i := 0 as i64
    while i < f.params.len:
        if i > 0:
            ax_printf_local(", ", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        ax_printf_local("t%d", f.params.data[i] as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        i = i + 1
    ax_printf_local(")", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    if f.ret_type != 0 as u32:
        ax_printf_local(" -> t%d", f.ret_type as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    ax_puts_local(":")

    mut call_count := 0 as u32

    mut bi := 0 as i64
    while bi < f.blocks.len:
        let bb = f.blocks.data[bi]
        print_block(f, bb, &call_count)
        bi = bi + 1

fn print_module(mod: AirModule):
    mut i := 0 as i64
    while i < mod.funcs.len:
        if i > 0:
            ax_puts_local("")
        print_func(mod.funcs.data[i])
        i = i + 1

// A file the build CANNOT proceed without. read_file_content returns "" on
// failure, which is indistinguishable from an empty file, so every caller of it
// for a required input silently compiled against nothing. Counting the failures
// here lets the driver halt for the same reason BUG#53 made parse errors halt:
// a pipeline fed garbage produces garbage far from the real cause.
fn read_required_file(path: str, fails: ptr[i64]) -> str:
    let content = read_file_content(path)
    if std.string.len(content) == 0:
        fails[0] = fails[0] + 1 as i64
    return content

fn read_file_content(path: str) -> str:
    let r = std.io.open(path)
    if r.is_ok():
        let file = r.unwrap()
        let r2 = file.read_all()
        if r2.is_ok():
            // NOTE: returning the generic .unwrap() directly (not via an
            // intermediate `let content = ...`) sidesteps a stage0 (Go) inference
            // bug where a let-bound generic-method-call result is typed as 0 in
            // the check pass once the type table grows — which otherwise caps how
            // much code can be added to stage1 ("stage0 ceiling"). See knowledge/bugs.md.
            return r2.unwrap()
        else:
            // Name the FILE. Both arms used to print only the errno-ish string, so a
            // failed stdlib bundle produced eight identical anonymous lines --
            // `Error: open failed:` with nothing after it -- which says neither what
            // was being opened nor why. CLAUDE.md §8: diagnostics must be actionable.
            ax_puts_local("error: cannot read source file:")
            ax_puts_local(path)
            ax_puts_local(r2.unwrap_err())
    else:
        ax_puts_local("error: cannot open source file:")
        ax_puts_local(path)
        ax_puts_local(r.unwrap_err())
        // The CWD note belongs ONLY on paths the COMPILER resolved for itself. For a
        // path the user typed, the file simply does not exist and the note points at
        // a cause that is not there -- and a misleading note is worse than none, which
        // is the exact failure it was added to prevent. `axc build typo.ax` printing
        // "run it from the repository root" would send someone hunting a directory
        // problem instead of reading the filename.
        let n = std.string.len(path)
        if n > 4:
            let p = get_str_ptr(path)
            let is_std = (p[0] == 's' as u8 and p[1] == 't' as u8 and p[2] == 'd' as u8 and p[3] == '/' as u8)
            let is_boot = (p[0] == 'b' as u8 and p[1] == 'o' as u8 and p[2] == 'o' as u8 and p[3] == 't' as u8)
            if is_std or is_boot:
                ax_puts_local("note: the compiler resolves std/*.ax and imported modules relative to the CURRENT DIRECTORY -- run it from the repository root")
    return ""

fn write_file_content(path: str, content: str) -> bool:
    let r = std.io.create(path)
    if r.is_ok():
        let file = r.unwrap()
        let r2 = file.write_all(content)
        if r2.is_ok():
            return true
    return false

fn match_prefix(s: str, i: i64, prefix: str) -> bool:
    let s_ptr = get_str_ptr(s)
    let p_ptr = get_str_ptr(prefix)
    let s_len = std.string.len(s)
    let p_len = std.string.len(prefix)
    if i + p_len > s_len:
        return false
    mut j := 0 as i64
    while j < p_len:
        if s_ptr[i + j] != p_ptr[j]:
            return false
        j = j + 1 as i64
    return true

fn strip_imports(s: str) -> str:
    let s_len = std.string.len(s)
    ax_printf_local("[Debug strip_imports] Entering, len=%d\n", s_len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    let s_ptr = get_str_ptr(s)
    let out_buf = @alloc(s_len + 1 as i64) as ptr[u8]
    mut out_idx := 0 as i64
    mut i := 0 as i64
    
    while i < s_len:
        mut is_line_start := false
        if i == 0 as i64:
            is_line_start = true
        elif s_ptr[i - 1 as i64] == 10 as u8:
            is_line_start = true
            
        mut skip_line := false
        if is_line_start:
            if match_prefix(s, i, "import std"):
                skip_line = true
                
        if skip_line:
            // BLANK the line to spaces and KEEP its newline, rather than deleting it.
            // Deleting used to shift every later byte AND drop a line, so a diagnostic's
            // offset could not be mapped back to a line of the user's own file: the line
            // number came out low by exactly the number of `import std` lines above it
            // (measured: a 3-import file reported line 7 for line 10). Space-filling is
            // length-preserving, so offsets AND line numbers now both survive intact --
            // which is what lets a later stage print `--> file.ax:12:8` (CLAUDE.md §8).
            //
            // Safe because a whitespace-only line is indent-NEUTRAL, not an INDENT: it
            // lexes to a single TK_NEWLINE (lexer.ax:534,543-547), and process_indentation
            // resolves depth via find_next_content_offset (lexer.ax:571-582), which skips
            // NEWLINE tokens and measures the next CONTENT line. Blank lines are already
            // pervasive in the bundled source, so this produces nothing the lexer has not
            // been handling all along.
            while i < s_len and s_ptr[i] != 10 as u8:
                out_buf[out_idx] = 32 as u8
                out_idx = out_idx + 1 as i64
                i = i + 1 as i64
            if i < s_len and s_ptr[i] == 10 as u8:
                out_buf[out_idx] = 10 as u8
                out_idx = out_idx + 1 as i64
                i = i + 1 as i64
        else:
            out_buf[out_idx] = s_ptr[i]
            out_idx = out_idx + 1 as i64
            i = i + 1 as i64
            
    out_buf[out_idx] = 0 as u8
    ax_puts_local("[Debug strip_imports] Finished loop")
    let res = out_buf as str
    ax_puts_local("[Debug strip_imports] Cast finished")
    return res

fn strip_package_prefixes(s: str) -> str:
    // BUG#26: the prefix patterns are built at runtime via concat so this
    // function's OWN source never contains the literal qualified prefixes (e.g.
    // "std.string."). Otherwise, when the self-hosting driver strips THIS file to
    // build the next stage, it would blank these very patterns (replace(r, "", "")
    // is a no-op), breaking all prefix stripping in stage2 -> every std.* call
    // would survive as an unresolved field-expr and become a self-call.
    // "std." / ".rest." / ":" pieces do not match any prefix pattern, so they
    // survive the self-strip, and concat reconstitutes the real patterns at runtime.
    let p = "std."
    let r0 = std.string.replace(s, std.string.concat(":", ":"), ".")
    let r1 = std.string.replace(r0, std.string.concat(p, "mem.alloc."), "")
    let r2 = std.string.replace(r1, std.string.concat(p, "scheduler."), "")
    let r3 = std.string.replace(r2, std.string.concat(p, "os.win32."), "")
    let r4 = std.string.replace(r3, std.string.concat(p, "os.linux_sys."), "")
    let r5 = std.string.replace(r4, std.string.concat(p, "os."), "")
    let r6 = std.string.replace(r5, std.string.concat(p, "string."), "")
    let r7 = std.string.replace(r6, std.string.concat(p, "io."), "")
    let r8 = std.string.replace(r7, std.string.concat(p, "net."), "")
    return r8



extern "C" fn GetCommandLineA() -> ptr[u8]
// Linux argv acquisition (RFC 0009 P3): the ELF `main` IS the entry, so the kernel's
// stack-passed argc/argv is clobbered by main's prologue before get_freestanding_args
// runs. Read /proc/self/cmdline instead (NUL-separated argv). syscall is already bundled
// (std/os.ax); redeclared here so this module typechecks the Linux else branch.
extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64

fn local_slice_to_ptr(data: ptr[u8], len: i64) -> ptr[u8]:
    let res = @alloc(len + 1) as ptr[u8]
    @memcpy(res, data, len)
    res[len] = 0 as u8
    return res

fn populate_str_in_place(s_ptr: ptr[u8], s_len: i64, dest: ptr[str]):
    let out_bytes = dest as ptr[u8]
    let ptr_val = s_ptr as i64
    out_bytes[0] = (ptr_val & 0xFF) as u8
    out_bytes[1] = ((ptr_val >> 8) & 0xFF) as u8
    out_bytes[2] = ((ptr_val >> 16) & 0xFF) as u8
    out_bytes[3] = ((ptr_val >> 24) & 0xFF) as u8
    out_bytes[4] = ((ptr_val >> 32) & 0xFF) as u8
    out_bytes[5] = ((ptr_val >> 40) & 0xFF) as u8
    out_bytes[6] = ((ptr_val >> 48) & 0xFF) as u8
    out_bytes[7] = ((ptr_val >> 56) & 0xFF) as u8

    out_bytes[8] = (s_len & 0xFF) as u8
    out_bytes[9] = ((s_len >> 8) & 0xFF) as u8
    out_bytes[10] = ((s_len >> 16) & 0xFF) as u8
    out_bytes[11] = ((s_len >> 24) & 0xFF) as u8
    out_bytes[12] = ((s_len >> 32) & 0xFF) as u8
    out_bytes[13] = ((s_len >> 40) & 0xFF) as u8
    out_bytes[14] = ((s_len >> 48) & 0xFF) as u8
    out_bytes[15] = ((s_len >> 56) & 0xFF) as u8

fn is_space_ansi(c: u8) -> bool:
    if c == ' ' as u8:
        return true
    if c == '\t' as u8:
        return true
    if c == '\r' as u8:
        return true
    if c == '\n' as u8:
        return true
    return false

fn get_freestanding_args(mut out_argc: ptr[i32]) -> ptr[str]:
    let args = @alloc(64 * 16) as ptr[str]
    mut count := 0 as i64
    if @compiler_intrinsic("is_windows"):
        let cmdline = GetCommandLineA()
        if cmdline != null as ptr[u8]:
            mut i := 0 as i64
            while cmdline[i] != 0 as u8 and count < 64:
                while is_space_ansi(cmdline[i]):
                    i = i + 1
                if cmdline[i] == 0 as u8:
                    break
                let start = i
                mut in_quotes := false
                while cmdline[i] != 0 as u8:
                    let ch = cmdline[i]
                    if ch == '"' as u8:
                        in_quotes = not in_quotes
                    else:
                        if not in_quotes:
                            if is_space_ansi(ch):
                                break
                    i = i + 1
                let arg_len = i - start
                mut final_ptr := ((cmdline as i64) + start) as ptr[u8]
                mut final_len := arg_len
                
                mut is_quoted := false
                if arg_len >= 2:
                    if cmdline[start] == '"' as u8:
                        if cmdline[i - 1] == '"' as u8:
                            is_quoted = true
                if is_quoted:
                    final_ptr = ((cmdline as i64) + start + 1) as ptr[u8]
                    final_len = arg_len - 2
                let s_ptr = local_slice_to_ptr(final_ptr, final_len)
                populate_str_in_place(s_ptr, final_len, ((args as i64) + count * 16) as ptr[str])
                count = count + 1
    else:
        // Linux: read /proc/self/cmdline (NUL-separated argv). SYS_open=2 (O_RDONLY=0),
        // SYS_read=0, SYS_close=3. Mirrors std/os.ax::linux_read_file. "/proc/self/cmdline"
        // is 18 bytes; local_slice_to_ptr NUL-terminates it for the open() path arg.
        let path_c = local_slice_to_ptr(get_str_ptr("/proc/self/cmdline"), 18 as i64)
        let fd = syscall(2 as u64, path_c as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        @free(path_c)
        if fd >= 0:
            let buf = @alloc(8192) as ptr[u8]
            let n = syscall(0 as u64, fd as u64, buf as u64, 8192 as u64, 0 as u64, 0 as u64, 0 as u64)
            syscall(3 as u64, fd as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
            if n > 0 as i64:
                mut start := 0 as i64
                mut p := 0 as i64
                while p < n and count < 64:
                    if buf[p] == 0 as u8:
                        if p > start:
                            let s_ptr = local_slice_to_ptr(((buf as i64) + start) as ptr[u8], p - start)
                            populate_str_in_place(s_ptr, p - start, ((args as i64) + count * 16 as i64) as ptr[str])
                            count = count + 1 as i64
                        start = p + 1 as i64
                    p = p + 1 as i64
    out_argc[0] = count as i32
    return args




// Length of `s` after the SAME preprocessing concatenate_stdlib applies to every piece.
// Used only to place a region boundary INSIDE the trailing block on the Linux path (where
// the runtime shims were appended to the user's source before preprocessing).
//
// Exact because both passes are piece-local: strip_imports rewrites whole LINES in place,
// and strip_package_prefixes replaces substrings that contain no newline — so for pieces
// joined by "\n", preprocess(A + "\n" + B) == preprocess(A) + "\n" + preprocess(B), and no
// pattern can straddle a join.
fn preprocessed_len(s: str) -> i64:
    let a = strip_imports(s)
    let b = strip_package_prefixes(a)
    return std.string.len(b)

// `smap` (may be null) receives one region per BUNDLED stdlib file, in buffer order, so a
// diagnostic can name `std/string.ax:412` instead of a byte offset into a ~142 KB bundle.
// The trailing user block is mapped by the caller, which is the only place that knows
// whether the Linux runtime shims were appended to it.
fn concatenate_stdlib(src: str, fails: ptr[i64], smap: ptr[SourceMap]) -> str:
    ax_puts_local("[Debug] Reading result.ax...")
    let raw_res = read_required_file("std/result.ax", fails)
    ax_puts_local("[Debug] Reading alloc.ax...")
    let raw_alloc = read_required_file("std/mem/alloc.ax", fails)
    ax_puts_local("[Debug] Reading scheduler.ax...")
    let raw_sched = read_required_file("std/scheduler.ax", fails)
    ax_puts_local("[Debug] Reading runtime.ax...")
    let raw_rt = read_required_file("std/runtime.ax", fails)
    ax_puts_local("[Debug] Reading os.ax...")
    let raw_os = read_required_file("std/os.ax", fails)
    ax_puts_local("[Debug] Reading string.ax...")
    let raw_str = read_required_file("std/string.ax", fails)
    ax_puts_local("[Debug] Reading io.ax...")
    let raw_io = read_required_file("std/io.ax", fails)
    // BUG#61b: std/collections.ax (Vec/HashMap/HashSet) was NOT in this bundle, so
    // `import std.collections` was silently dropped on the native build path and
    // Vec methods dispatched into garbage at runtime. It only needs std.result
    // (bundled above) + builtins, so bundle it like the rest.
    ax_puts_local("[Debug] Reading collections.ax...")
    let raw_coll = read_required_file("std/collections.ax", fails)

    ax_puts_local("[Debug] Stripping imports from result.ax...")
    let res_src_raw = strip_imports(raw_res)
    let res_src = strip_package_prefixes(res_src_raw)

    ax_puts_local("[Debug] Stripping imports from alloc.ax...")
    let alloc_src_raw = strip_imports(raw_alloc)
    let alloc_src = strip_package_prefixes(alloc_src_raw)

    ax_puts_local("[Debug] Stripping imports from scheduler.ax...")
    let sched_src_raw = strip_imports(raw_sched)
    let sched_src = strip_package_prefixes(sched_src_raw)

    ax_puts_local("[Debug] Stripping imports from runtime.ax...")
    let rt_src_raw = strip_imports(raw_rt)
    let rt_src = strip_package_prefixes(rt_src_raw)

    ax_puts_local("[Debug] Stripping imports from os.ax...")
    let os_src_raw = strip_imports(raw_os)
    let os_src = strip_package_prefixes(os_src_raw)

    ax_puts_local("[Debug] Stripping imports from string.ax...")
    let str_src_raw = strip_imports(raw_str)
    let str_src = strip_package_prefixes(str_src_raw)

    ax_puts_local("[Debug] Stripping imports from io.ax...")
    let io_src_raw = strip_imports(raw_io)
    let io_src = strip_package_prefixes(io_src_raw)

    ax_puts_local("[Debug] Stripping imports from collections.ax...")
    let coll_src_raw = strip_imports(raw_coll)
    let coll_src = strip_package_prefixes(coll_src_raw)

    ax_puts_local("[Debug] Stripping imports from src...")
    let clean_src_raw = strip_imports(src)
    let clean_src = strip_package_prefixes(clean_src_raw)
    
    ax_puts_local("[Debug] Concatenating buffers...")
    let len_src = std.string.len(clean_src)
    let len_res = std.string.len(res_src)
    let len_alloc = std.string.len(alloc_src)
    let len_sched = std.string.len(sched_src)
    let len_rt = std.string.len(rt_src)
    let len_os = std.string.len(os_src)
    let len_str = std.string.len(str_src)
    let len_io = std.string.len(io_src)
    let len_coll = std.string.len(coll_src)

    let total_len = len_res + 1 as i64 + len_alloc + 1 as i64 + len_sched + 1 as i64 + len_rt + 1 as i64 + len_os + 1 as i64 + len_str + 1 as i64 + len_io + 1 as i64 + len_coll + 1 as i64 + len_src
    // CLAUDE.md §8: user-facing output carries no untagged debug noise. The `[Debug] `
    // prefix above is what routes a line through is_verbose_debug()'s silencer; the
    // former companion `total_len=%d` line started with 't', escaped that filter, and so
    // printed on EVERY successful compile. Deleted rather than merged -- the line above
    // is already silenced, so merging would only have hidden the same value.
    ax_printf_local("[Debug] len_res=%d, len_alloc=%d, len_sched=%d, len_rt=%d, len_os=%d, len_str=%d, len_io=%d, len_src=%d, ", len_res, len_alloc, len_sched, len_rt, len_os, len_str, len_io, len_src)
    let new_buf = @alloc(total_len + 1 as i64) as ptr[u8]

    @memcpy(new_buf, res_src as ptr[u8], len_res)
    new_buf[len_res] = 10 as u8

    let off_alloc = len_res + 1 as i64
    @memcpy(((new_buf as i64) + off_alloc) as ptr[u8], alloc_src as ptr[u8], len_alloc)
    new_buf[off_alloc + len_alloc] = 10 as u8

    let off_sched = off_alloc + len_alloc + 1 as i64
    @memcpy(((new_buf as i64) + off_sched) as ptr[u8], sched_src as ptr[u8], len_sched)
    new_buf[off_sched + len_sched] = 10 as u8

    let off_rt = off_sched + len_sched + 1 as i64
    @memcpy(((new_buf as i64) + off_rt) as ptr[u8], rt_src as ptr[u8], len_rt)
    new_buf[off_rt + len_rt] = 10 as u8

    let off_os = off_rt + len_rt + 1 as i64
    @memcpy(((new_buf as i64) + off_os) as ptr[u8], os_src as ptr[u8], len_os)
    new_buf[off_os + len_os] = 10 as u8

    let off_str = off_os + len_os + 1 as i64
    @memcpy(((new_buf as i64) + off_str) as ptr[u8], str_src as ptr[u8], len_str)
    new_buf[off_str + len_str] = 10 as u8

    let off_io = off_str + len_str + 1 as i64
    @memcpy(((new_buf as i64) + off_io) as ptr[u8], io_src as ptr[u8], len_io)
    new_buf[off_io + len_io] = 10 as u8

    let off_coll = off_io + len_io + 1 as i64
    @memcpy(((new_buf as i64) + off_coll) as ptr[u8], coll_src as ptr[u8], len_coll)
    new_buf[off_coll + len_coll] = 10 as u8

    let off_src = off_coll + len_coll + 1 as i64
    @memcpy(((new_buf as i64) + off_src) as ptr[u8], clean_src as ptr[u8], len_src)
    new_buf[total_len] = 0 as u8

    // Record the bundled regions in buffer order. Deliberately NOT the trailing user
    // block: on the Linux target the driver appended bootstrap/runtime/{panic,syscall}.ax
    // to the user's source BEFORE calling us, so only the driver can split that block —
    // and mapping it here would name the user's file for a line of panic.ax, which is a
    // wrong answer rather than a missing one.
    srcmap_add(smap, "std/result.ax", 0 as i64, len_res)
    srcmap_add(smap, "std/mem/alloc.ax", off_alloc, off_alloc + len_alloc)
    srcmap_add(smap, "std/scheduler.ax", off_sched, off_sched + len_sched)
    srcmap_add(smap, "std/runtime.ax", off_rt, off_rt + len_rt)
    srcmap_add(smap, "std/os.ax", off_os, off_os + len_os)
    srcmap_add(smap, "std/string.ax", off_str, off_str + len_str)
    srcmap_add(smap, "std/io.ax", off_io, off_io + len_io)
    srcmap_add(smap, "std/collections.ax", off_coll, off_coll + len_coll)

    let _ = write_file_content("scratch/stage2_preprocessed.ax", new_buf as str)

    ax_puts_local("[Debug] Cleaning up...")
    // Commented out to prevent double-free crashes under compiler's CTGC system
    // if std.string.len(raw_res) > 0 as i64:
    //     @free(raw_res as ptr[u8])
    // if std.string.len(raw_alloc) > 0 as i64:
    //     @free(raw_alloc as ptr[u8])
    // if std.string.len(raw_sched) > 0 as i64:
    //     @free(raw_sched as ptr[u8])
    // if std.string.len(raw_rt) > 0 as i64:
    //     @free(raw_rt as ptr[u8])
    // if std.string.len(raw_os) > 0 as i64:
    //     @free(raw_os as ptr[u8])
    // if std.string.len(raw_str) > 0 as i64:
    //     @free(raw_str as ptr[u8])
    // if std.string.len(raw_io) > 0 as i64:
    //     @free(raw_io as ptr[u8])
    //     
    // if res_src as ptr[u8] != res_src_raw as ptr[u8]:
    //     @free(res_src as ptr[u8])
    // @free(res_src_raw as ptr[u8])
    // 
    // if alloc_src as ptr[u8] != alloc_src_raw as ptr[u8]:
    //     @free(alloc_src as ptr[u8])
    // @free(alloc_src_raw as ptr[u8])
    // 
    // if sched_src as ptr[u8] != sched_src_raw as ptr[u8]:
    //     @free(sched_src as ptr[u8])
    // @free(sched_src_raw as ptr[u8])
    // 
    // if rt_src as ptr[u8] != rt_src_raw as ptr[u8]:
    //     @free(rt_src as ptr[u8])
    // @free(rt_src_raw as ptr[u8])
    // 
    // if os_src as ptr[u8] != os_src_raw as ptr[u8]:
    //     @free(os_src as ptr[u8])
    // @free(os_src_raw as ptr[u8])
    // 
    // if str_src as ptr[u8] != str_src_raw as ptr[u8]:
    //     @free(str_src as ptr[u8])
    // @free(str_src_raw as ptr[u8])
    // 
    // if io_src as ptr[u8] != io_src_raw as ptr[u8]:
    //     @free(io_src as ptr[u8])
    // @free(io_src_raw as ptr[u8])
    // 
    // if clean_src as ptr[u8] != clean_src_raw as ptr[u8]:
    //     @free(clean_src as ptr[u8])
    // @free(clean_src_raw as ptr[u8])
        
    let result_str = new_buf as str
    ax_puts_local("[Debug] Concatenation finished successfully!")
    
    let success_w = write_file_content("scratch/self_linked_concatenated.ax", result_str)
    if not success_w:
        ax_puts_local("error: could not write self_linked_concatenated.ax")
    return result_str
fn print_num(val: i64):
    if val == 0:
        print_raw("0")
        return
    mut v := val
    if v < 0:
        print_raw("-")
        v = -v
    mut temp := v
    mut digits := 0 as i64
    while temp > 0:
        digits = digits + 1
        temp = temp / 10
    let buf = @alloc(digits + 1) as ptr[u8]
    mut i := digits - 1
    temp = v
    while i >= 0:
        buf[i] = '0' as u8 + (temp % 10) as u8
        temp = temp / 10
        i = i - 1
    buf[digits] = 0 as u8
    print_raw(buf as str)
    @free(buf)

// RFC 0011 P3: djb2 hash of a source string, for .lib staleness detection.
fn djb2_hash_str(s: str) -> u64:
    mut h := 5381 as u64
    let p = get_str_ptr(s)
    let n = std.string.len(s)
    mut i := 0 as i64
    while i < n:
        h = ((h << 5 as u64) + h) + p[i] as u64
        i = i + 1
    return h

// RFC 0011 §3.4 / RFC 0035 §9 — identity of the LINK-TIME CONTRACT a `.lib` was built under.
// The staleness manifest hashes only the library SOURCE, so a `.lib` produced by a compiler
// that emitted different symbol names is considered fresh and is linked as-is. RFC 0035 P2
// made that concrete: libraries built before it export `ax_helper` while callers built after
// it reference `ax_libpa_helper`, and nothing in the build detects the mismatch — the user
// sees an unresolved external naming a function they can see is defined, or worse, a silent
// first-match bind to the wrong body.
//
// Folding this into the stored hash makes every `.lib` from an older scheme mismatch and be
// rebuilt, which is the correct and quiet outcome. BUMP IT whenever the emitted symbol name
// for a library's public surface changes — i.e. whenever x86_resolve_sym_name's output moves
// for a `--staticlib` build, or the `__axiom_iface` format changes.
//   1 = pre-RFC-0035 (plain `ax_<name>`)
//   2 = RFC 0035 P2 (module-qualified `ax_<unit>_<name>`)
pub const AX_LIB_SCHEME_ID: u64 = 2

// The value stored in, and compared against, a `.lib` staleness manifest: the source hash
// mixed with the scheme id, using the same djb2 step as the hash itself so the mixing adds
// no new arithmetic to reason about. Every producer and consumer of the manifest must go
// through here — a site that compares a raw djb2(src) would see every library as stale
// forever, which is why there is one function rather than the constant inlined at each site.
fn lib_manifest_hash(src: str) -> u64:
    let h = djb2_hash_str(src)
    return ((h << 5 as u64) + h) + AX_LIB_SCHEME_ID

// Read the u64 hash from a lib manifest ("AXLIB1\n" + 8 bytes LE). 0 if absent/invalid.
fn read_lib_manifest_hash(path: str) -> u64:
    let nt = str_to_null_terminated(path)
    let f = fopen(nt as ptr[void], get_str_ptr("rb"))
    @free(nt)
    if f == null as ptr[void]:
        return 0 as u64
    let bufm = @alloc(16) as ptr[u8]
    let got = fread(bufm as ptr[void], 1, 15, f)
    fclose(f)
    if got < 15 as i64:
        @free(bufm)
        return 0 as u64
    // Verify magic "AXLIB1\n"
    if bufm[0] != 'A' as u8 or bufm[1] != 'X' as u8 or bufm[2] != 'L' as u8 or bufm[3] != 'I' as u8 or bufm[4] != 'B' as u8 or bufm[5] != '1' as u8:
        @free(bufm)
        return 0 as u64
    mut h := 0 as u64
    mut i := 0 as i64
    while i < 8:
        h = h | ((bufm[7 + i] as u64) << (i * 8 as i64) as u64)
        i = i + 1
    @free(bufm)
    return h

fn file_exists(path: str) -> bool:
    let nt = str_to_null_terminated(path)
    let f = fopen(nt as ptr[void], get_str_ptr("rb"))
    @free(nt)
    if f == null as ptr[void]:
        return false
    fclose(f)
    return true

// RFC 0011 P4 (increment 3e): strip a trailing `.lib`/`.dll` from an output name, so one
// `--staticlib --shared` build can emit `<base>.lib` + `<base>.dll` for the same library.
// Always returns a fresh heap string (a copy when there is no such extension).
fn strip_lib_dll_ext(path: str) -> str:
    let n = std.string.len(path)
    if n >= 4:
        let p = get_str_ptr(path)
        if p[n - 4] == '.' as u8:
            let is_lib = p[n - 3] == 'l' as u8 and p[n - 2] == 'i' as u8 and p[n - 1] == 'b' as u8
            let is_dll = p[n - 3] == 'd' as u8 and p[n - 2] == 'l' as u8 and p[n - 1] == 'l' as u8
            if is_lib or is_dll:
                return std.string.slice(path, 0, n - 4)
    return std.string.slice(path, 0, n)

// RFC 0035 P2: the canonical qualifier for a module, as a PURE function of its canonical
// name — the property §4 requires and the reverted `sym_idx` scheme lacked. It must map the
// two spellings of the same module to one string, because the library and the app reach it
// from opposite directions and never share a table:
//   library side, from the source path passed to `--staticlib`:  "pkg/mod.ax" -> "pkg_mod"
//   app side, from the import name in `import pkg.mod`:          "pkg.mod"    -> "pkg_mod"
// `ensure_import_libs` builds the library path as `replace(mod_name, ".", "/") + ".ax"`, so
// the two inputs are the same name in different separators by construction, and this
// collapses both. Determinism (§3) holds: no hashing, no ordering, no table index.
// Returns a fresh heap string. Written as one explicit mapping loop rather than a chain of
// std.string.replace calls: `replace` returns its INPUT unchanged when there is no match, so
// freeing each intermediate is a use-after-free on exactly the inputs that need no
// substitution — which is most module names, and which segfaulted the resolver on the first
// attempt here.
fn module_qualifier(spec: str) -> str:
    mut n := std.string.len(spec)
    let p = get_str_ptr(spec)
    if n > 3:
        if p[n - 3] == '.' as u8 and p[n - 2] == 'a' as u8 and p[n - 1] == 'x' as u8:
            n = n - 3
    if n > 4:
        if p[n - 4] == '.' as u8 and p[n - 3] == 'l' as u8 and p[n - 2] == 'i' as u8 and p[n - 1] == 'b' as u8:
            n = n - 4
    mut buf := @alloc(n + 1) as ptr[u8]
    mut i := 0 as i64
    while i < n:
        let c = p[i]
        if c == '/' as u8 or c == 92 as u8 or c == '.' as u8:
            buf[i] = '_' as u8
        else:
            buf[i] = c
        i = i + 1
    buf[n] = 0 as u8
    let res = alloc_str_from_raw(buf, n)
    @free(buf)
    return res

// RFC 0011 P4 (increment 3d): does this source file declare itself a `library`? Scans the
// first meaningful (non-blank, non-`//`) line for a `library <name>` marker. A module that
// opts in this way is treated as a separately-compilable library (import-driven `.lib`)
// WITHOUT the global --auto-lib flag — the safe, self-describing default (the user's model).
fn source_is_library(ax_path: str) -> bool:
    let src = read_file_content(ax_path)
    let n = std.string.len(src)
    if n == 0:
        return false
    let p = get_str_ptr(src)
    mut i := 0 as i64
    mut result := false
    mut scanning := true
    while scanning and i < n:
        // skip leading spaces/tabs on the line
        while i < n and (p[i] == ' ' as u8 or p[i] == 9 as u8):
            i = i + 1
        if i >= n:
            scanning = false
        elif p[i] == 0x0A as u8:
            i = i + 1  // blank line — keep scanning
        elif i + 1 < n and p[i] == '/' as u8 and p[i + 1] == '/' as u8:
            while i < n and p[i] != 0x0A as u8:  // comment line — skip to EOL
                i = i + 1
        else:
            // first meaningful line: match `library` followed by whitespace
            if i + 7 <= n and p[i] == 'l' as u8 and p[i + 1] == 'i' as u8 and p[i + 2] == 'b' as u8 and p[i + 3] == 'r' as u8 and p[i + 4] == 'a' as u8 and p[i + 5] == 'r' as u8 and p[i + 6] == 'y' as u8:
                if i + 7 >= n or p[i + 7] == ' ' as u8 or p[i + 7] == 9 as u8:
                    result = true
            scanning = false
    @free(get_str_ptr(src))
    return result

// RFC 0011 P4 (increment 3c): auto-build / refresh a precompiled library per import.
// Before resolution, for each non-`std.` `import x` whose source `x.ax` exists, ensure a
// fresh `x.lib`: (re)build it via a self-invocation when the lib is missing or its manifest
// hash no longer matches djb2(x.ax). The import-driven resolver (register_module_from_lib)
// then binds x from the fresh interface and the linker pulls its code — so an unchanged
// library is compiled ONCE and merely linked afterwards (the user's model: có→dùng,
// không/đổi→biên dịch và tạo lib). Libraries must be stdlib-free today (--no-stdlib);
// stdlib-using libs await the separate-compilation stdlib cache (RFC 0011 §6).
fn ensure_import_libs(tree: ptr[AstTree], pool: ptr[InternPool], self_exe: str, force_all: bool):
    mut i := 0 as i64
    while i < tree.nodes.len:
        if tree.nodes.data[i].kind == NODE_IMPORT_DECL:
            let name_id = tree.nodes.data[i].payload
            let mod_name = pool.get(name_id)
            if not std.string.starts_with(mod_name, "std."):
                let rel = std.string.replace(mod_name, ".", "/")
                let ax_path = std.string.concat(rel, ".ax")
                let lib_path = std.string.concat(rel, ".lib")
                // Only auto-build modules that opt in via a `library` marker, unless
                // --auto-lib forces every non-std import.
                if file_exists(ax_path) and (force_all or source_is_library(ax_path)):
                    let src_x = read_file_content(ax_path)
                    let h = lib_manifest_hash(src_x)
                    mut need_build := true
                    if file_exists(lib_path):
                        let man = std.string.concat(lib_path, ".manifest")
                        let prev = read_lib_manifest_hash(man)
                        @free(get_str_ptr(man))
                        if prev == h:
                            need_build = false
                    if need_build:
                        let p1 = std.string.concat("\"", self_exe)
                        let p2 = std.string.concat(p1, "\" build \"")
                        let p3 = std.string.concat(p2, ax_path)
                        let p4 = std.string.concat(p3, "\" -o \"")
                        let p5 = std.string.concat(p4, lib_path)
                        let inner = std.string.concat(p5, "\" --staticlib --no-stdlib -self-link -O1")
                        // Windows `cmd /c` strips the first/last quote of the command string
                        // when it starts with a quote; wrap the whole thing in an outer pair
                        // so the quoted exe/path arguments survive (cmd /c "…" convention).
                        let wrapped = std.string.concat(std.string.concat("\"", inner), "\"")
                        @free(get_str_ptr(p1))
                        @free(get_str_ptr(p2))
                        @free(get_str_ptr(p3))
                        @free(get_str_ptr(p4))
                        @free(get_str_ptr(p5))
                        @free(get_str_ptr(inner))
                        ax_puts_local("[import] building library from source:")
                        ax_puts_local(ax_path)
                        let cmd_nt = str_to_null_terminated(wrapped)
                        let rc = system(cmd_nt as ptr[void])
                        @free(cmd_nt)
                        @free(get_str_ptr(wrapped))
                        if rc != 0:
                            ax_puts_local("[import] warning: library build failed; using source fallback")
                    @free(get_str_ptr(src_x))
                @free(get_str_ptr(ax_path))
                @free(get_str_ptr(lib_path))
                @free(get_str_ptr(rel))
        i = i + 1

pub fn main() -> i32:
    let argc_ptr = @alloc(4) as ptr[i32]
    argc_ptr[0] = 0 as i32
    let args = get_freestanding_args(argc_ptr)
    let argc = argc_ptr[0]
    @free(argc_ptr as ptr[u8])

    if argc < 2:
        ax_puts_local("Usage: axc <command> [args]")
        ax_puts_local("Commands:")
        ax_puts_local("  dump-air <file.ax> [-O0|-O1|-O2|-O3]")
        ax_puts_local("  emit-c <file.ax> [-o <out.c>] [-O0|-O1|-O2|-O3]")
        ax_puts_local("  build <file.ax> [-o <out.exe>] [-O0|-O1|-O2|-O3] [--target <wasm32|wasm32-unknown-unknown>]")
        ax_puts_local("  fmt <file.ax>")
        ax_puts_local("  lsp")
        return 1

    mut is_dump_air := false
    mut is_emit_c := false
    mut is_build := false
    mut is_fmt := false
    mut file_arg_idx := 1
    mut output_file := ""
    mut target_wasm32 := false
    // RFC 0009 P3 / Linux target: `--target linux` (or x86_64-linux) emits an ELF64
    // executable using the SysV ABI + inline syscalls instead of Windows COFF/PE.
    mut target_linux := false
    mut self_link := false
    mut optimize := false
    mut opt_level := 1 as u8
    mut no_stdlib := false
    mut show_time := false  // --time: print per-phase wall-clock timing
    mut is_shared := false  // RFC 0009 P2: --shared — emit a DLL with export table
    mut is_staticlib := false // RFC 0011 P1: --staticlib — emit a COFF .lib archive
    mut extra_libs := new_linker_str_vec() // RFC 0011 P2: -l <path> extra link inputs
    mut auto_lib := false // RFC 0011 P4 inc3c: --auto-lib — auto-build/cache each non-std
                          // import as a .lib. Opt-in: AXIOM can't yet tell an app-module
                          // (may collide/need stdlib) from a standalone library.
    mut ctgc_free := true  // RFC 0015 P3: compile-time free is now ON BY DEFAULT — inject
                           // OP_DESTROY (+ container free-glue / drop-glue) for provably
                           // non-escaping, single-owner local aggregates at block fall-through.
                           // Gated on a SOUND escape analysis (self-host freeable set = 0, so
                           // the compiler self-build stays byte-identical). Use -no-ctgc-free
                           // to opt OUT (debugging / a program that trips a missed escape edge).
    mut jumptable := false // RFC 0028: -jumptable — dense int match -> O(log N) compare tree
                           // for provably non-escaping, single-owner local aggregates.
    mut dfe_report_flag := false // RFC 0031: -dfe-report (measurement only)
    mut dfe_enabled := true       // RFC 0031: dead-function elimination is now ON BY DEFAULT —
                                  // skip emitting functions unreachable from the root set (entry +
                                  // #[export] + indirect-call/vtable roots). Every exe drops the
                                  // ~75KB fixed stdlib overhead (return 42: 77,824 -> 22,016 B, -71.7%).
                                  // Evidence base for flipping on: the compiler self-compiles
                                  // byte-identically under prune (pruned generation reaches B==C), the
                                  // full regression + ELF suite run green with pruning, and --staticlib
                                  // is guarded off (a library must keep its whole public surface). Use
                                  // -no-dfe to opt OUT (debugging a suspected missing root -> wild call).
    mut ctgc_report := false // RFC 0015 P3 precursor: -ctgc-free-report — dump the freeable
                             // set (print, no OP_DESTROY, byte-identical output). Measurement only.
                           // OFF by default so the self-host build stays byte-identical.

    // Parse commands
    let cmd = args[1]
    if cmd == "dump-air":
        is_dump_air = true
        file_arg_idx = 2
    elif cmd == "emit-c":
        is_emit_c = true
        file_arg_idx = 2
    elif cmd == "build":
        is_build = true
        self_link = true
        file_arg_idx = 2
    elif cmd == "fmt":
        is_fmt = true
        file_arg_idx = 2
    elif cmd == "lsp":
        lsp_start_server()
        return 0
    elif cmd == "iface":
        // RFC 0011 P4: dump the `__axiom_iface` member of a .lib and re-emit it from the
        // reader's parsed form (round-trip check for the interface reader, inc3a).
        if argc < 3:
            ax_puts_local("Usage: axc iface <library.lib>")
            return 1
        let iface_types = new_type_table()
        if axiom_check_lib_iface(args[2], iface_types):
            return 0
        return 1
    else:
        is_dump_air = true
        file_arg_idx = 1

    // Parse options starting after the file argument
    mut opt_idx := file_arg_idx + 1
    while opt_idx < argc:
        let opt = args[opt_idx as i64]
        if opt == "-o" or opt == "--output":
            if opt_idx + 1 < argc:
                output_file = args[opt_idx as i64 + 1 as i64]
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for -o option")
                return 1
        elif opt == "--target" or opt == "-target":
            if opt_idx + 1 < argc:
                let target_triple = args[opt_idx as i64 + 1 as i64]
                if target_triple == "wasm32" or target_triple == "wasm32-unknown-unknown" or target_triple == "wasm":
                    target_wasm32 = true
                elif target_triple == "linux" or target_triple == "x86_64-linux" or target_triple == "x86_64-unknown-linux" or target_triple == "x86_64-linux-gnu":
                    target_linux = true
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for --target option")
                return 1
        elif opt == "-self-link" or opt == "--self-link":
            self_link = true
        elif opt == "-use-gcc" or opt == "--use-gcc":
            self_link = false
        elif opt == "-O0":
            optimize = false
        elif opt == "-O1":
            optimize = true
            opt_level = 1 as u8
        elif opt == "-O2" or opt == "-O" or opt == "--opt":
            optimize = true
            opt_level = 2 as u8
        elif opt == "-O3":
            optimize = true
            opt_level = 3 as u8
        elif opt == "--no-stdlib":
            no_stdlib = true
        elif opt == "--shared":
            is_shared = true
        elif opt == "--staticlib":
            is_staticlib = true
        elif opt == "--auto-lib":
            auto_lib = true
        elif opt == "-l" or opt == "--link":
            if opt_idx + 1 < argc:
                push_linker_str(&extra_libs, args[opt_idx as i64 + 1 as i64])
                opt_idx = opt_idx + 1
            else:
                ax_puts_local("error: missing value for -l option")
                return 1
        elif opt == "--time":
            show_time = true
        elif opt == "-ctgc-free" or opt == "--ctgc-free":
            ctgc_free = true
        elif opt == "-no-ctgc-free" or opt == "--no-ctgc-free":
            // RFC 0015 P3: opt OUT of the now-default compile-time free. Escape hatch for
            // debugging a suspected early-free / for a program whose aliasing the escape
            // analysis under-approximates (would become a UAF instead of a safe leak).
            ctgc_free = false
        elif opt == "-jumptable" or opt == "--jumptable":
            jumptable = true
        elif opt == "-dfe-report" or opt == "--dfe-report":
            // RFC 0031: print the reachable-function count, emit nothing differently.
            dfe_report_flag = true
        elif opt == "-dfe" or opt == "--dfe":
            // RFC 0031: actually skip emitting unreachable functions. OPT-IN, and
            // it stays opt-in until the root set has been exercised by something
            // more demanding than the oracles — the failure mode is a call into an
            // address that was never emitted, which no size check can detect.
            // Quiet by default. It first shipped implying -dfe-report, on the
            // reasoning that a build which drops functions should say which ones.
            // In practice that is ~123 lines on a hello-world and buries whatever
            // the user was actually building — a real barrier for the one thing
            // this flag now needs, which is being used. Pair it with -dfe-report
            // when diagnosing; that combination is what turned the ELF SIGSEGV
            // into a named function in a single build.
            dfe_enabled = true
        elif opt == "-no-dfe" or opt == "--no-dfe":
            // RFC 0031: opt OUT of the now-default dead-function elimination. Escape hatch for
            // debugging a suspected incomplete root set (a call into an address that was never
            // emitted), or to compare byte output against the un-pruned image.
            dfe_enabled = false
        elif opt == "-ctgc-free-report" or opt == "--ctgc-free-report":
            ctgc_report = true
        opt_idx = opt_idx + 1

    let filename = args[file_arg_idx as i64]
    mut src := read_file_content(filename)
    if std.string.len(src) == 0 as i64:
        // read_file_content has ALREADY printed a precise, named diagnostic if the
        // open or read failed, so this must not restate it in different words -- two
        // messages in two styles for one problem reads like two problems. It also has
        // to stay honest about the case read_file_content cannot distinguish: a file
        // that opened perfectly well and is simply empty, where "could not open or
        // read file" was flatly wrong.
        ax_puts_local("error: no source to compile (missing or empty):")
        ax_puts_local(filename)
        return 1

    if is_fmt:
        ax_puts_local("[Debug] Running pure-AXIOM Formatter...")
        mut formatter := new_formatter()
        let formatted = formatter.format(src)
        
        let success_f = write_file_content(filename, formatted)
        if success_f:
            ax_puts_local("[Debug] Formatted file successfully!")
        else:
            ax_puts_local("error: could not write formatted file")
        
        @free(get_str_ptr(formatted))
        return 0

    mut t_mark := time_now_ms()  // --time running marker (inert unless show_time)
    // Diagnostics stage 2b (CLAUDE.md §8): map every byte of the buffer the frontend will
    // see back to the file it came from, so a diagnostic can print `--> file.ax:LINE`.
    // Built here because this is the only place where all the boundaries are known.
    mut srcmap := new_source_map()
    mut user_pp_len := 0 as i64      // preprocessed length of the USER's own source
    mut lx_panic_pp := 0 as i64      // ... of bootstrap/runtime/panic.ax   (Linux only)
    mut lx_syscall_pp := 0 as i64    // ... of bootstrap/runtime/syscall.ax (Linux only)
    if self_link and not no_stdlib:
        // RFC 0009 P3 Linux: bundle the freestanding runtime shims (syscall-based
        // ax_get_global_state_internal / ax_panic / ax_compiler_intrinsic) so the
        // program needs no libax_runtime.so — the ELF linker binds the raw C-ABI
        // names to these bundled `ax_`-mangled twins. Windows keeps ax_runtime.dll.
        if target_linux:
            // Measure the user's own text BEFORE anything is appended to it — that is the
            // only moment at which the user region's end can still be established.
            user_pp_len = preprocessed_len(src)
            let raw_panic_rt = read_file_content("bootstrap/runtime/panic.ax")
            if std.string.len(raw_panic_rt) > 0:
                lx_panic_pp = preprocessed_len(raw_panic_rt)
                let src_nl = std.string.concat(src, "\n")
                src = std.string.concat(src_nl, raw_panic_rt)
                @free(get_str_ptr(src_nl))
            // The freestanding allocator (std/runtime.ax malloc → __ax_runtime_init →
            // ax_os_alloc) uses sys_mmap/sys_munmap/sys_exit from bootstrap/runtime/syscall.ax,
            // which the import graph does NOT pull in. Bundle it so those resolve on Linux.
            let raw_syscall_rt = read_file_content("bootstrap/runtime/syscall.ax")
            if std.string.len(raw_syscall_rt) > 0:
                lx_syscall_pp = preprocessed_len(raw_syscall_rt)
                let src_nl2 = std.string.concat(src, "\n")
                src = std.string.concat(src_nl2, raw_syscall_rt)
                @free(get_str_ptr(src_nl2))
        // BUG#53's rule applied one stage earlier: bad INPUT must halt the pipeline
        // exactly as bad parse output does. read_file_content returns "" when it
        // cannot open a file, so a missing stdlib used to bundle as empty text and
        // flow all the way into codegen -- which then reported eight anonymous
        // `open failed` lines followed by a ~2 KB executable that segfaults. The
        // real cause (wrong working directory) was several screens above the
        // symptom the user actually met.
        mut stdlib_fails := 0 as i64
        src = concatenate_stdlib(src, &stdlib_fails, srcmap)
        if stdlib_fails > 0 as i64:
            ax_printf_local("error: %d stdlib source file(s) could not be read; aborting before code generation\n", stdlib_fails, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
            return 1
        t_mark = time_phase(show_time, "concat-stdlib", t_mark)

    // Map the TRAILING block, which concatenate_stdlib deliberately left alone (only this
    // scope knows whether the Linux shims were appended to the user's source).
    let src_total = std.string.len(src)
    if srcmap.len > 0 as i64:
        // The user's text begins one '\n' past the last bundled stdlib region.
        let off_user = srcmap.data[srcmap.len - 1 as i64].end + 1 as i64
        if lx_panic_pp == 0 as i64 and lx_syscall_pp == 0 as i64:
            // Common case: nothing was appended, so the block IS the user's file.
            srcmap_add(srcmap, filename, off_user, src_total)
        else:
            mut cut := off_user + user_pp_len
            srcmap_add(srcmap, filename, off_user, cut)
            if lx_panic_pp > 0 as i64:
                srcmap_add(srcmap, "bootstrap/runtime/panic.ax", cut + 1 as i64, cut + 1 as i64 + lx_panic_pp)
                cut = cut + 1 as i64 + lx_panic_pp
            if lx_syscall_pp > 0 as i64:
                srcmap_add(srcmap, "bootstrap/runtime/syscall.ax", cut + 1 as i64, cut + 1 as i64 + lx_syscall_pp)
                cut = cut + 1 as i64 + lx_syscall_pp
    else:
        // Concatenation was skipped entirely — `--no-stdlib`, or a subcommand that does
        // not self-link (`dump-air`, `emit-c`). The whole buffer is then the user's file.
        // Without this entry those paths would fall back to a raw byte offset even though
        // the offset already IS a plain offset into the user's own file.
        srcmap_add(srcmap, filename, 0 as i64, src_total)

    // RFC 0011 P3: for --staticlib, skip the whole pipeline when the source is
    // unchanged (its hash matches the manifest) and the .lib still exists.
    mut lib_src_hash := 0 as u64
    if is_staticlib:
        lib_src_hash = lib_manifest_hash(src)
        if std.string.len(output_file) > 0 and file_exists(output_file):
            let man_check = std.string.concat(output_file, ".manifest")
            let prev_hash = read_lib_manifest_hash(man_check)
            @free(get_str_ptr(man_check))
            if prev_hash != 0 as u64 and prev_hash == lib_src_hash:
                ax_puts_local("[lib] up to date — skipping rebuild")
                return 0

    if not is_dump_air:
        ax_puts_local("[Debug] Stage 1: Starting compilation...")
    // 1. Lex
    mut lexer := new_lexer(src)
    let tokens = lexer.tokenize()
    t_mark = time_phase(show_time, "lex", t_mark)
    if not is_dump_air:
        ax_puts_local("[Debug] Finished Lexing.")

    // 2. Parse
    mut pool := new_intern_pool()
    mut parser := new_parser(tokens, src, pool)
    // Thread the source map onto the tree BEFORE parsing, so parse diagnostics can locate
    // themselves too. Both Parser and TypeChecker reach it through `self.tree` — one owner,
    // no globals (CLAUDE.md §3).
    parser.tree.srcmap = srcmap
    parser.parse_program()
    // BUG#53 fix (CLAUDE.md §8): parse errors must HALT the pipeline. Previously the
    // driver ignored parser.diags_count, so a malformed parse (e.g. an inline `if COND:
    // <stmt>` suite, which parse_block cannot represent) flowed into codegen and emitted
    // corrupt symbols ("Unresolved external symbol ''") instead of a clean error.
    if parser.diags_count > 0 as i64:
        ax_printf_local("error: %d parse error(s); aborting before code generation\n", parser.diags_count, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        return 1
    t_mark = time_phase(show_time, "parse", t_mark)
    if not is_dump_air:
        ax_puts_local("[Debug] Finished Parsing.")

    // RFC 0008: lambda-lift closures to top-level functions before resolution, so
    // they resolve/typecheck/lower as ordinary functions (reusing fn-ptr lowering).
    // BUG#73: lift_closures rejects captured-variable closures (RFC 0008 P2 is not
    // implemented) instead of silently lifting them into a miscompile; halt here
    // exactly like the parser.diags_count gate above (BUG#53).
    let lift_errors = lift_closures(parser.tree, parser.pool)
    if lift_errors > 0 as i64:
        ax_printf_local("error: %d closure capture error(s); aborting before code generation\n", lift_errors, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        return 1

    // RFC 0011 P4 (increment 3c/3d): auto-(re)build the `.lib` of each imported LIBRARY
    // (a module whose source carries a `library` marker) from source when missing/stale, so
    // `import x` resolves against a fresh library instead of recompiling x every time.
    // `library`-marked modules opt in by default; --auto-lib forces every non-std import.
    // Unmarked app-modules stay on the source path (safe for name-colliding / stdlib users).
    if is_build:
        ensure_import_libs(parser.tree, parser.pool, args[0], auto_lib)

    // 3. Resolve
    if not is_dump_air:
        ax_puts_local("[Debug] Creating symbol table...")
    mut symtable := new_symbol_table(parser.pool)
    // RFC 0035 P2: when this compilation IS a library, its own public functions carry the
    // unit's name into their emitted symbols. Scoped to --staticlib deliberately: that is
    // the only path whose output is linked into a DIFFERENT compilation, so it is the only
    // path where two units can collide, and an ordinary program build stays byte-identical.
    // `filename`, not `args[0]` — args[0] is argv[0], the compiler's own exe path (which
    // ensure_import_libs passes as `self_exe`). Using it produced the qualifier
    // `D:_projects_compiler_Axiom_axA_exe`, which is how this was caught.
    if is_staticlib:
        symtable.unit_qualifier = module_qualifier(filename)
    if not is_dump_air:
        ax_puts_local("[Debug] Creating type table...")
    mut typetable := new_type_table()
    
    if not is_dump_air:
        ax_puts_local("[Debug] Creating lazy resolver...")
    let lazy = new_lazy_resolver(symtable, parser.pool as ptr[void])
    lazy.typetable = typetable as ptr[void]
    lazy.auto_lib = auto_lib // RFC 0011 P4 inc3c: enable import→.lib resolution (opt-in)
    symtable.lazy_resolver = lazy as ptr[void]
    
    if not self_link and not is_dump_air:
        let prelude_name = "std.result"
        let prelude_name_id = parser.pool.intern_string(prelude_name)
        let prelude_path = "std/result.ax"
        ax_puts_local("[Debug] Registering std.result import...")
        lazy.lazy_resolver_register_import(prelude_name_id, prelude_path, 0 as u32)
        ax_puts_local("[Debug] Preloading std.result module...")
        lazy.lazy_resolver_preload_module(prelude_name_id)
    
    if not is_dump_air:
        ax_puts_local("[Debug] Creating name resolver...")
    mut resolver := new_name_resolver(parser.tree, parser.pool, symtable)
    if not is_dump_air:
        ax_puts_local("[Debug] Resolver created. Pre-defining top levels...")
    resolver.pre_define_top_levels()
    if not is_dump_air:
        ax_puts_local("[Debug] Pre-defining finished. Resolving root...")
    resolver.resolve_node(0 as u32)
    if not is_dump_air:
        ax_puts_local("[Debug] Resolving finished.")
    parser.pool = resolver.intern
    if not is_dump_air:
        t_mark = time_phase(show_time, "resolve", t_mark)
        ax_puts_local("[Debug] Finished Resolving.")

    // 4. Typecheck
    mut checker := new_type_checker(parser.tree, parser.pool, resolver.symtable, typetable)
    checker.run_type_checker()
    // BUG#64-diag fix (CLAUDE.md §8, same class as BUG#53's parser-diag halt):
    // typecheck errors (currently: calling a non-function struct FIELD, e.g.
    // `v.len()` on a Vec whose `len` is a data field not a method) must HALT the
    // pipeline instead of flowing into codegen, where the untyped call fell back
    // to `getfld` + an INDIRECT CALL through the field's scalar value — a segfault
    // or jump to a garbage address with no compile-time signal.
    if checker.diags_count > 0 as i64:
        ax_printf_local("error: %d type error(s); aborting before code generation\n", checker.diags_count, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        return 1
    if not is_dump_air:
        t_mark = time_phase(show_time, "typecheck", t_mark)
        ax_puts_local("[Debug] Finished Typechecking.")

    if not is_dump_air:
        ax_puts_local("[Debug] Running Ownership Checker...")
        mut ownership_chk := new_ownership_checker(parser.tree, parser.pool, resolver.symtable, typetable)
        ownership_chk.check()

        ax_puts_local("[Debug] Running Escape Analyser...")
        mut escape_an := new_escape_analyser(parser.tree, parser.pool, resolver.symtable, typetable, checker.node_types, checker.node_types_cap)
        escape_an.run()

        ax_puts_local("[Debug] Running CTGC Injector...")
        mut ctgc_inj := new_ctgc_injector(parser.tree, parser.pool, resolver.symtable, typetable)
        ctgc_inj.free_enabled = ctgc_free
        ctgc_inj.report_only = ctgc_report
        ctgc_inj.run()

        ax_puts_local("[Debug] Running Alias Reuse Optimizer...")
        mut alias_opt := new_alias_reuse_optimizer(parser.tree, parser.pool, resolver.symtable, typetable)
        alias_opt.run()

        ax_puts_local("[Debug] Running AIR Builder...")

    // 6. Build AIR
    checker.ensure_capacity(parser.tree.nodes.len)
    mut air_builder := new_air_module_builder(parser.tree, resolver.symtable, typetable, parser.pool, checker.node_types)
    // Linux target: drive the compile-time `is_windows`/`is_linux`/`os_name` fold so the
    // bundled platform runtime picks the syscall path. Set BEFORE build_module().
    air_builder.target_is_windows = not target_linux
    air_builder.jumptable_enabled = jumptable
    air_builder.build_module()
    
    // Build AIR for all lazy loaded modules and append their functions
    if lazy != null as ptr[LazyResolver]:
        mut mod_idx := 0 as i64
        while mod_idx < lazy.modules.len:
            let mod = lazy.modules.data[mod_idx]
            if mod != null as ptr[ModuleInfo] and mod.status == MODULE_LOADED and mod.ast_tree != null as ptr[AstTree] and mod.node_types != null as ptr[void]:
                mut mod_air_builder := new_air_module_builder(mod.ast_tree, resolver.symtable, typetable, parser.pool, mod.node_types as ptr[u32])
                mod_air_builder.target_is_windows = not target_linux
                mod_air_builder.build_module()
                
                // Append functions to main air_builder.module
                mut f_idx := 0 as i64
                while f_idx < mod_air_builder.module.funcs.len:
                    let f = mod_air_builder.module.funcs.data[f_idx]
                    (&air_builder.module.funcs).push(f)
                    f_idx = f_idx + 1 as i64

                // RFC 0017 / BUG#82: append this module's global variables too, so their
                // static storage + data symbols are emitted alongside the merged funcs.
                mut g_idx := 0 as i64
                while g_idx < mod_air_builder.module.globals.len:
                    (&air_builder.module.globals).push(mod_air_builder.module.globals.data[g_idx])
                    g_idx = g_idx + 1 as i64
                
                // Free mod_air_builder itself but NOT the inner functions (since they were merged)
                @free(mod_air_builder as ptr[u8])
            mod_idx = mod_idx + 1 as i64

    parser.pool = air_builder.pool
    if not is_dump_air:
        t_mark = time_phase(show_time, "air-build", t_mark)
        ax_puts_local("[Debug] Stage 2: Finished building AIR module.")

    if optimize:
        if not is_dump_air:
            ax_puts_local("[Debug] Stage 2.1: Running SSA optimizer...")
        mut optimizer := new_ssa_optimizer()
        optimizer.level = opt_level
        optimizer.run(&(air_builder.module), typetable)
        if not is_dump_air:
            t_mark = time_phase(show_time, "ssa-opt", t_mark)
            ax_puts_local("[Debug] Stage 2.2: Finished SSA optimizer.")

    // 7. Handle output phase
    if is_dump_air:
        print_module(air_builder.module)
    elif is_emit_c:
        mut cgen := new_c_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
        if std.string.len(output_file) == 0:
            output_file = "output.c"
        let success = cgen.generate(output_file)
        if not success:
            ax_puts_local("error: could not generate C code")
            return 1
    elif is_build:
        if target_wasm32:
            mut wasm_gen := new_wasm_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
            if std.string.len(output_file) == 0:
                output_file = "output.wat"
            let success = wasm_gen.generate(output_file)
            if not success:
                ax_puts_local("error: could not generate Wasm Text code")
                return 1
            
            @free(get_str_ptr(src))
            if tokens.data != null as ptr[Token]:
                @free(tokens.data as ptr[u8])
            if lexer.tokens.data != null as ptr[Token]:
                @free(lexer.tokens.data as ptr[u8])
            if lexer.indent_stack.data != null as ptr[i32]:
                @free(lexer.indent_stack.data as ptr[u8])
            if lexer.newline_offsets.data != null as ptr[i32]:
                @free(lexer.newline_offsets.data as ptr[u8])

            if parser.tree.nodes.data != null as ptr[AstNode]:
                @free(parser.tree.nodes.data as ptr[u8])
            if parser.tree.extras.data != null as ptr[i32]:
                @free(parser.tree.extras.data as ptr[u8])

            free_air_module_builder(air_builder)
            free_type_checker(checker)
            free_typetable(typetable)
            free_symtable(resolver.symtable)
            free_pool(parser.pool)
            return 0

        if std.string.len(output_file) == 0:
            output_file = "output.exe"

        if self_link:
            let temp_obj = "axiom_temp.obj"
            ax_puts_local("[Debug] Stage 3: Starting native code generation...")
            // Linux target emits an ELF object; the self-linker auto-detects the format
            // from the object magic and produces an ELF64 executable. Default is COFF/PE.
            mut obj_format := "coff"
            if target_linux:
                obj_format = "elf"
            // RFC 0031: NEVER prune into a static library, even when the module has
            // #[export] functions. For an executable or a DLL the roots really are
            // the whole entry surface -- nothing outside can call an unexported
            // function. A .lib is the opposite: the CONSUMER decides what to link,
            // and every `pub` function is a legitimate entry point whether or not it
            // is exported.
            //
            // The `no entry and no exports` guard inside dfe_compute already covers a
            // library with no exports at all, which is why this looked safe. It is
            // not: adding ONE #[export] flips the module onto the other branch, and a
            // probe of exactly that shape pruned a `pub` function that a consumer
            // would then fail to link against -- an archive silently missing part of
            // its public surface, with no diagnostic anywhere.
            let dfe_for_output = dfe_enabled and not is_staticlib
            let success = compile_native_binary(temp_obj, air_builder.module, resolver.symtable, parser.pool, typetable, get_str_ptr(obj_format), self_link, dfe_report_flag, dfe_for_output)
            if not success:
                ax_puts_local("error: could not generate native binary code")
                return 1
            t_mark = time_phase(show_time, "codegen", t_mark)
            ax_puts_local("[Debug] Stage 4: Finished native code generation.")

            // RFC 0011 P1: --staticlib wraps the compiled object into a .lib archive
            // instead of linking an executable.
            if is_staticlib:
                // RFC 0011 P4: serialize the TU's public interface into the .lib.
                let iface_text = build_lib_iface_text(resolver.symtable, parser.pool, typetable, parser.tree)
                // RFC 0011 P4 (inc3e): `--staticlib --shared` emits BOTH `<base>.lib` and
                // `<base>.dll` for one library. Name the archive `<base>.lib`; the DLL is
                // produced by falling through to the linker with output = `<base>.dll`.
                mut lib_out := output_file
                if is_shared:
                    let base = strip_lib_dll_ext(output_file)
                    lib_out = std.string.concat(base, ".lib")
                    output_file = std.string.concat(base, ".dll")
                    @free(get_str_ptr(base))
                let lib_ok = axiom_write_static_lib(temp_obj, lib_out, lib_src_hash, iface_text)
                if is_shared:
                    @free(get_str_ptr(lib_out))
                let temp_obj_nt2 = str_to_null_terminated(temp_obj)
                @free(temp_obj_nt2)
                if not lib_ok:
                    ax_puts_local("error: static library generation failed")
                    return 1
                ax_puts_local("[Debug] Static library written.")
                if not is_shared:
                    free_air_module_builder(air_builder)
                    free_type_checker(checker)
                    free_typetable(typetable)
                    free_symtable(resolver.symtable)
                    free_pool(parser.pool)
                    return 0
                // is_shared too: continue to the linker to also emit the DLL.
                ax_puts_local("[Debug] Also emitting shared library (.dll)...")

            ax_puts_local("[Debug] Stage 5: Starting self-linking...")
            mut linker := new_axiom_linker()
            axiom_linker_add_input(&linker, temp_obj)
            // RFC 0011 P2: additional static-lib / object inputs from -l.
            mut lib_i := 0 as i64
            while lib_i < extra_libs.len:
                axiom_linker_add_input(&linker, extra_libs.data[lib_i])
                lib_i = lib_i + 1
            // RFC 0011 P4 (increment 3b): import-driven auto-libraries. Each module that
            // was satisfied from a `<module>.lib` (register_module_from_lib) must have that
            // archive linked so its code is present. Re-derive the path from the module
            // name and add it when the file exists — mirrors the load-time decision.
            if lazy != null as ptr[LazyResolver]:
                mut ml_i := 0 as i64
                while ml_i < lazy.modules.len:
                    let lmod = lazy.modules.data[ml_i]
                    if lmod != null as ptr[ModuleInfo]:
                        let lmod_name = parser.pool.get(lmod.name_id)
                        let lmod_rel = std.string.replace(lmod_name, ".", "/")
                        let lmod_lib = std.string.concat(lmod_rel, ".lib")
                        let lmod_ax = std.string.concat(lmod_rel, ".ax")
                        // Link the archive only for modules actually resolved FROM a lib
                        // (marked `library`, or forced by --auto-lib) — matches the loader.
                        if file_exists(lmod_lib) and (auto_lib or source_is_library(lmod_ax)):
                            axiom_linker_add_input(&linker, lmod_lib)
                        @free(get_str_ptr(lmod_ax))
                        ml_i = ml_i + 1
            linker.output_path = output_file
            // RFC 0009: resolve extern-from-DLL bindings (name_id pairs) into string
            // pairs for the linker's per-symbol DLL attribution.
            mut bind_i := 0 as i64
            while bind_i < resolver.symtable.dll_bind_syms.len:
                let sym_id = resolver.symtable.dll_bind_syms.data[bind_i]
                let dll_id = resolver.symtable.dll_bind_dlls.data[bind_i]
                push_linker_str(&linker.user_dll_syms, parser.pool.get(sym_id))
                push_linker_str(&linker.user_dll_names, parser.pool.get(dll_id))
                bind_i = bind_i + 1
            // RFC 0009 P2: thread #[export] names + --shared mode into the linker.
            // RFC 0011 P4: a `library`-marked module exports its FULL public API when
            // built as a DLL, so the .dll surface matches the .lib (and the auto FFI
            // wrapper). Unmarked --shared keeps the #[export]-only behavior.
            linker.is_shared = is_shared
            let export_all_pub = source_is_library(filename)
            if export_all_pub:
                mut es_i := 0 as i64
                while es_i < resolver.symtable.symbols.len:
                    let es_kind = resolver.symtable.symbols.data[es_i].kind
                    let es_flags = resolver.symtable.symbols.data[es_i].flags
                    let es_tid = resolver.symtable.symbols.data[es_i].type_id
                    if es_kind == SYM_FUNC and (es_flags & SYM_FLAG_PUB) != 0 as u16 and es_tid != 0 as u32:
                        let es_name = parser.pool.get(resolver.symtable.symbols.data[es_i].name_id)
                        if std.string.len(es_name) > 0:
                            push_linker_str(&linker.export_names, es_name)
                    es_i = es_i + 1
            else:
                mut exp_i := 0 as i64
                while exp_i < resolver.symtable.export_syms.len:
                    push_linker_str(&linker.export_names, parser.pool.get(resolver.symtable.export_syms.data[exp_i]))
                    exp_i = exp_i + 1
            let link_success = axiom_linker_link(&linker)
            t_mark = time_phase(show_time, "self-link", t_mark)
            ax_puts_local("[Debug] Stage 6: Finished self-linking.")
            // (Removed a dead temp_obj_nt alloc+free here — the file-removal it fed was
            //  commented out, so it was a pure post-Stage-6 heap op with no effect.)

            if not link_success:
                // Delete the half-written output. The linker streams headers and code
                // to disk BEFORE it discovers an unresolved relocation, so a failed
                // link still leaves a complete-looking executable behind. The exit
                // code is already 1, but a user who sees both an error and an .exe
                // reasonably runs the .exe -- and meets a SEGFAULT instead of a build
                // failure. That is how "Unresolved external symbol" was mistaken for a
                // .bss addressing bug during an RFC 0031 probe: the diagnostic was
                // correct and right there, and the runnable artifact next to it was
                // more persuasive than the text.
                //
                // Failing to remove it is not itself fatal -- the build has already
                // failed and says so -- but say which file is stale so a stale binary
                // is never silently trusted.
                let rm = std.os.remove_file(output_file)
                if rm.is_err():
                    ax_puts_local("warning: could not remove the incomplete output; do NOT run:")
                    ax_puts_local(output_file)
                ax_puts_local("error: Self-linking failed")
                return 1
            // RFC 0011 P4 (inc3f): for a DLL, emit an FFI wrapper module `<base>_ffi.ax`
            // (pub extern bindings for every #[export]ed fn) so a consumer imports one file
            // instead of hand-writing an `extern "C" from` per function.
            if is_shared:
                let dll_base = strip_lib_dll_ext(output_file)
                let wrap_path = std.string.concat(dll_base, "_ffi.ax")
                @free(get_str_ptr(dll_base))
                let dll_bn = linker_basename(output_file)
                let wrap_text = build_dll_wrapper_text(resolver.symtable, parser.pool, typetable, dll_bn, export_all_pub)
                if write_file_content(wrap_path, wrap_text):
                    ax_puts_local("[Debug] FFI wrapper written:")
                    ax_puts_local(wrap_path)
                @free(get_str_ptr(wrap_text))
                @free(get_str_ptr(wrap_path))
            // Self-link build is complete: the output executable/DLL is fully written.
            // Skip the process-teardown free chain and exit immediately. This is a
            // standard compiler pattern (the OS reclaims all memory on exit) and it
            // deterministically avoids a rare, output-invisible teardown SIGSEGV: a
            // program that monomorphizes 3+ distinct hash containers (HashMap/HashSet)
            // intermittently corrupts a compiler-heap pointer during generic mono, which
            // only faults later when the teardown free chain walks the clobbered pointer.
            // Output is always correct; skipping teardown makes the exit code reliably 0.
            // Root cause (an OOB/indexed write in hash-container mono) is tracked in
            // knowledge/bug-3hashmap-mono-teardown-crash.md for a future ASAN session;
            // the std/mem/alloc.ax AX_CANARY infra (disabled) is committed for it.
            return 0
        else:
            // Generate C code first
            ax_puts_local("[Debug] Stage 2.3: Starting C code generation...")
            mut cgen := new_c_generator(air_builder.module, parser.tree, air_builder.pool, resolver.symtable, typetable)
            let gen_success = cgen.generate("axiom_temp.c")
            if not gen_success:
                ax_puts_local("error: C code generation failed")
                return 1
            ax_puts_local("[Debug] Stage 2.4: Finished C code generation successfully.")

            mut opt_str := "-O1"
            if optimize:
                if opt_level == 1 as u8:
                    opt_str = "-O1"
                elif opt_level == 2 as u8:
                    opt_str = "-O2"
                elif opt_level == 3 as u8:
                    opt_str = "-O3"

            let cmd_buf = @alloc(2048) as ptr[u8]
            let output_file_nt = str_to_null_terminated(output_file)

            // Compile C to executable using gcc.
            // -g is omitted intentionally: debug info triples compile time and binary size.
            ax_snprintf_local(cmd_buf as ptr[void], 2048, "gcc %s -DAXIOM_SUMLAYOUT_POINTER -fno-strict-aliasing -Wno-int-conversion -Wno-incompatible-pointer-types -Wl,--no-insert-timestamp -o %s axiom_temp.c -Iruntime runtime/axalloc/axalloc_compiled.c runtime/axalloc/platform_ext.c runtime/panic/panic.c runtime/ax_assert.c runtime/ax_collections.c runtime/ax_math.c runtime/ax_print.c runtime/ax_string_ops.c runtime/actor/actor.c runtime/actor/async.c runtime/actor/ioloop.c runtime/actor/isolated.c runtime/actor/msgqueue.c runtime/actor/runtime_init.c runtime/actor/scheduler.c runtime/actor/supervisor.c" as ptr[u8], get_str_ptr(opt_str) as ptr[void], output_file_nt as ptr[void])
            let link_status = system(cmd_buf as ptr[void])

            // Clean up
            @free(output_file_nt)
            @free(cmd_buf)

            if link_status != 0:
                ax_puts_local("error: C compilation failed")
                return link_status

    // Free resources
    @free(get_str_ptr(src))
    if tokens.data != null as ptr[Token]:
        @free(tokens.data as ptr[u8])
    if lexer.tokens.data != null as ptr[Token]:
        @free(lexer.tokens.data as ptr[u8])
    if lexer.indent_stack.data != null as ptr[i32]:
        @free(lexer.indent_stack.data as ptr[u8])
    if lexer.newline_offsets.data != null as ptr[i32]:
        @free(lexer.newline_offsets.data as ptr[u8])

    if parser.tree.nodes.data != null as ptr[AstNode]:
        @free(parser.tree.nodes.data as ptr[u8])
    if parser.tree.extras.data != null as ptr[i32]:
        @free(parser.tree.extras.data as ptr[u8])

    let dummy_len = typetable.entries.len + air_builder.tree.nodes.len + checker.tree.nodes.len
    if dummy_len == -9999 as i64:
        ax_puts_local("dummy")

    free_air_module_builder(air_builder)
    free_type_checker(checker)
    free_typetable(typetable)
    free_lazy_resolver(lazy)
    free_symtable(resolver.symtable)
    free_pool(parser.pool)



    return 0

// Bind a body-less lib symbol under its qualified `mod.NAME` in the global scope and record
// it as a module export, so the resolver's field lookup finds it (shared by fn/const/struct).
fn register_lib_symbol(st: ptr[SymbolTable], intern: ptr[InternPool], mod: ptr[ModuleInfo], mod_name: str, local_name: str, local_name_id: u32, sym_idx: u32):
    let dot_name = std.string.concat(".", local_name)
    let full_name = std.string.concat(mod_name, dot_name)
    let full_name_id = intern.intern_string(full_name)
    @free(get_str_ptr(dot_name))
    @free(get_str_ptr(full_name))
    let gscope = &st.scopes.data[0]
    gscope.scope_put(full_name_id, sym_idx)
    (&mod.exports).push(ModuleExport(name_id: local_name_id, symbol_idx: sym_idx))

// Resolve an interface type token to a TypeID: a primitive by name, else a struct registered
// earlier in this module (name→id map from the `S` lines), else TYPE_UNKNOWN.
fn iface_resolve_tok(tok: str, names: ptr[LinkerStrVec], ids: ptr[U32Vec]) -> u32:
    let prim = iface_token_to_type(tok)
    if prim != TYPE_UNKNOWN:
        return prim
    mut k := 0 as i64
    while k < names.len:
        if names.data[k] == tok:
            return ids.data[k]
        k = k + 1
    return TYPE_UNKNOWN

// RFC 0011 P4 (increment 3b/4a/4b): register a module's public symbols from a precompiled
// `.lib`'s `__axiom_iface` — WITHOUT parsing/typechecking/codegen'ing the library source.
// Each public function becomes a body-less SYM_FUNC (decl_node 0, ast_tree stays null ⇒
// build_module never emits it — its body comes from the `.lib` at link time). The symbol
// carries only SYM_FLAG_PUB, so cgen mangles the call target as plain `ax_<name>`, which
// matches the library's exported symbol. Qualified `mod.fn` resolves via the global-scope
// full-name binding and the module export list, exactly like the source-loaded path.
// inc4b: structs (`S` lines) are registered FIRST — recomputing their layout from the same
// fields — so function/const signatures can reference them by name.
fn register_module_from_lib(mod: ptr[ModuleInfo], st: ptr[SymbolTable], tt: ptr[TypeTable], intern: ptr[InternPool], lib_path: str, mod_name: str) -> i32:
    let text = read_lib_iface_bytes(lib_path)
    let n = std.string.len(text)
    let p = get_str_ptr(text)
    // Struct name→type_id map built as we register `S` lines (pass 1).
    mut smap_names := new_linker_str_vec()
    mut smap_ids := new_u32_vec()
    // PASS 1: register public structs so later function/const lines can name them.
    mut li := 0 as i64
    while li < n:
        mut lj := li
        while lj < n and p[lj] != 0x0A as u8:
            lj = lj + 1
        let stoks = iface_line_tokens(p, li, lj)
        if stoks.len >= 3 and stoks.data[0] == "S":
            let sname = stoks.data[1]
            let nfields = iface_atoi(stoks.data[2])
            mut fields := StructFieldVec(data: null as ptr[StructField], len: 0, cap: 0)
            mut ft := 3 as i64
            mut fcount := 0 as i64
            while fcount < nfields and ft + 1 as i64 < stoks.len:
                let f_name_id = intern.intern_string(stoks.data[ft])
                let f_type = iface_token_to_type(stoks.data[ft + 1 as i64])
                (&fields).push(StructField(name_id: f_name_id, type_id: f_type))
                ft = ft + 2 as i64
                fcount = fcount + 1
            let s_name_id = intern.intern_string(sname)
            let s_type_id = tt.register_struct(s_name_id, fields)
            push_linker_str(&smap_names, sname)
            smap_ids.push(s_type_id)
            let s_sym_idx = st.symbols.len as u32
            (&st.symbols).push(Symbol(
                name_id: s_name_id,
                kind: SYM_STRUCT,
                padding: 0 as u8,
                flags: SYM_FLAG_PUB,
                type_id: s_type_id,
                decl_node: 0 as u32,
                scope_id: 0 as u32,
                next_overload: 0 as u32,
            ))
            (&st.symbol_trees).push(null as ptr[AstTree])
            register_lib_symbol(st, intern, mod, mod_name, sname, s_name_id, s_sym_idx)
        li = lj + 1
    // PASS 2: register public functions, resolving struct-typed params/returns via the map.
    li = 0 as i64
    while li < n:
        mut lj := li
        while lj < n and p[lj] != 0x0A as u8:
            lj = lj + 1
        let toks = iface_line_tokens(p, li, lj)
        if toks.len >= 4 and toks.data[0] == "F":
            let fname = toks.data[1]
            let nparams = iface_atoi(toks.data[2])
            mut params := new_u32_vec()
            mut t := 3 as i64
            mut pc := 0 as i64
            while pc < nparams and t < toks.len:
                params.push(iface_resolve_tok(toks.data[t], &smap_names, &smap_ids))
                t = t + 1
                pc = pc + 1
            mut ret := TYPE_VOID
            if t < toks.len and toks.data[t] == "->":
                t = t + 1
            if t < toks.len:
                ret = iface_resolve_tok(toks.data[t], &smap_names, &smap_ids)
            let func_type = tt.register_function(params, ret)
            let local_name_id = intern.intern_string(fname)
            // RFC 0035 P2: the symbol's NAME is the module-qualified base, so cgen emits the
            // very name the library emitted for itself (`ax_libpa_helper`) instead of the
            // bare `ax_<name>` that makes two libraries indistinguishable — the defect this
            // function's own comment describes. The LOCAL name still drives every lookup:
            // register_lib_symbol binds `libpa.helper` in the global scope and records the
            // export under `local_name_id`, so source-level resolution is unchanged.
            // Distinct names also stop SYM_FLAG_MODDUP from firing on two same-named
            // imports, which is what produced the call to `ax_helper__m<sym_idx>` that no
            // library ever defined.
            //
            // Derived from `lib_path`, NOT from the `mod_name` parameter: a probe here
            // showed mod_name arriving EMPTY on this path (`intern.get(mod.name_id)` in
            // ax_driver_load_module), while lib_path is provably intact — file_exists()
            // just opened it. lib_path is `replace(mod_name, ".", "/") + ".lib"` computed
            // in the caller, so it carries the same canonical name in the same separator
            // form the library itself was compiled under, which is what makes the two
            // sides agree. (mod_name being empty is pre-existing and separate: the
            // `mod.NAME` binding register_lib_symbol writes from it is dead weight, since
            // resolution reaches these symbols through the ModuleExport list instead.)
            let q_mod = module_qualifier(lib_path)
            let q_sep = std.string.concat(q_mod, "_")
            let q_full = std.string.concat(q_sep, fname)
            let qual_name_id = intern.intern_string(q_full)
            @free(get_str_ptr(q_mod))
            @free(get_str_ptr(q_sep))
            @free(get_str_ptr(q_full))
            let sym_idx = st.symbols.len as u32
            (&st.symbols).push(Symbol(
                name_id: qual_name_id,
                kind: SYM_FUNC,
                padding: 0 as u8,
                flags: SYM_FLAG_PUB | SYM_FLAG_MODQUAL,
                type_id: func_type,
                decl_node: 0 as u32,
                scope_id: 0 as u32,
                next_overload: 0 as u32,
            ))
            (&st.symbol_trees).push(null as ptr[AstTree])
            register_lib_symbol(st, intern, mod, mod_name, fname, local_name_id, sym_idx)
        li = lj + 1
    // RFC 0011 P4 inc4a: register the library's public integer constants. Each becomes a
    // body-less SYM_CONST (decl_node 0, no AST initializer); its value is stashed in
    // next_overload (unused for consts) and inlined by lower_field_expr at each `mod.NAME`
    // use site — mirroring the function registration above.
    let consts = parse_lib_iface_consts(lib_path)
    mut ci := 0 as i64
    while ci < consts.len:
        let c = &consts.data[ci]
        let c_local_name_id = intern.intern_string(c.name)
        let c_sym_idx = st.symbols.len as u32
        (&st.symbols).push(Symbol(
            name_id: c_local_name_id,
            kind: SYM_CONST,
            padding: 0 as u8,
            flags: SYM_FLAG_PUB,
            type_id: c.type_id,
            decl_node: 0 as u32,
            scope_id: 0 as u32,
            next_overload: c.value as u32,
        ))
        (&st.symbol_trees).push(null as ptr[AstTree])
        let c_dot_name = std.string.concat(".", c.name)
        let c_full_name = std.string.concat(mod_name, c_dot_name)
        let c_full_name_id = intern.intern_string(c_full_name)
        @free(get_str_ptr(c_dot_name))
        @free(get_str_ptr(c_full_name))
        let c_gscope = &st.scopes.data[0]
        c_gscope.scope_put(c_full_name_id, c_sym_idx)
        (&mod.exports).push(ModuleExport(name_id: c_local_name_id, symbol_idx: c_sym_idx))
        ci = ci + 1
    mod.status = MODULE_LOADED
    mod.ast_tree = null as ptr[AstTree]
    return 0 as i32

pub fn ax_driver_load_module(mod_void: ptr[void], st: ptr[SymbolTable], tt: ptr[void]) -> i32:
    let mod = mod_void as ptr[ModuleInfo]
    let lazy = st.lazy_resolver as ptr[LazyResolver]
    let intern = lazy.intern as ptr[InternPool]
    let mod_name = intern.get(mod.name_id)

    let rel_path = std.string.replace(mod_name, ".", "/")
    mut file_path := std.string.concat(rel_path, ".ax")

    // RFC 0011 P4 (increment 3b/3d): prefer a precompiled `<module>.lib` when the module is
    // a library (source carries a `library` marker) or --auto-lib forces it. Import-driven
    // separate compilation — the library's code is pulled in by the linker (its path is
    // threaded from lazy.modules), so its source is never recompiled.
    let lib_path = std.string.concat(rel_path, ".lib")
    if (lazy.auto_lib or source_is_library(file_path)) and file_exists(lib_path):
        @free(get_str_ptr(rel_path))
        @free(get_str_ptr(file_path))
        let rc = register_module_from_lib(mod, st, tt as ptr[TypeTable], intern, lib_path, mod_name)
        @free(get_str_ptr(lib_path))
        return rc
    @free(get_str_ptr(lib_path))
    @free(get_str_ptr(rel_path))

    mut opened := false
    mut actual_path := ""

    let r = std.io.open(file_path)
    if r.is_ok():
        let file = r.unwrap()
        let _ = file.close()
        opened = true
        actual_path = std.string.concat("", file_path)
    else:
        let path1 = std.string.concat("../", file_path)
        let r1 = std.io.open(path1)
        if r1.is_ok():
            let file1 = r1.unwrap()
            let _ = file1.close()
            opened = true
            actual_path = path1
        else:
            @free(get_str_ptr(path1))
            let path2 = std.string.concat("../../", file_path)
            let r2 = std.io.open(path2)
            if r2.is_ok():
                let file2 = r2.unwrap()
                let _ = file2.close()
                opened = true
                actual_path = path2
            else:
                @free(get_str_ptr(path2))

    if not opened:
        ax_printf_local("error: could not open module file '%s'\n", get_str_ptr(file_path) as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
        @free(get_str_ptr(file_path))
        @free(get_str_ptr(mod_name))
        return 1 as i32

    mut src := read_file_content(actual_path)
    ax_printf_local("[Debug] read_file_content len=%d\n", src.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    // NOTE: `actual_path` is deliberately NOT freed here any more. It becomes the single
    // region of this module's source map below, and srcmap_add stores the `str` BY
    // REFERENCE (print_helpers.ax: `SourceRegion(path: path, ...)` — no copy), so freeing
    // it would leave every diagnostic in this module printing a dangling path. The map
    // and the path now live as long as the module's AST, which is the whole compilation.

    // 1. Lex
    ax_printf_local("[Debug] Lexing...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut lexer := new_lexer(src)
    let tokens = lexer.tokenize()
    ax_printf_local("[Debug] Lexing finished, tokens len=%d\n", tokens.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 2. Parse
    ax_printf_local("[Debug] Parsing...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    let parser_ptr = new_parser(tokens, src, intern)
    parser_ptr.parse_program()
    let mod_tree = parser_ptr.tree
    // An imported module is lexed and parsed on its OWN buffer -- it is never spliced into
    // the concatenated unit -- so an offset here is already a plain offset into this file
    // and one region covering the whole buffer maps it exactly. Without this the tree kept
    // `srcmap == null` and every diagnostic raised inside an imported module degraded to a
    // bare byte offset, even though the path was known right here all along.
    let mod_map = new_source_map()
    srcmap_add(mod_map, actual_path, 0 as i64, std.string.len(src))
    mod_tree.srcmap = mod_map
    ax_printf_local("[Debug] Parsing finished, nodes count=%d\n", mod_tree.nodes.len, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mod.ast_tree = mod_tree

    // Save scope stack and reset to global scope (0)
    let saved_len = st.stack.len
    let saved_cap = st.stack.cap
    let saved_data = st.stack.data
    st.stack = new_u32_vec()
    (&st.stack).push(0 as u32)

    // 3. Resolve
    ax_printf_local("[Debug] Resolving...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut mod_resolver := new_name_resolver(mod_tree, intern, st)
    mod_resolver.resolve()
    ax_printf_local("[Debug] Resolving finished\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)

    // 4. Typecheck
    ax_printf_local("[Debug] Typechecking...\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mut mod_checker := new_type_checker(mod_tree, intern, st, tt as ptr[TypeTable])
    mod_checker.run_type_checker()
    ax_printf_local("[Debug] Typechecking finished\n", 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 0 as i64)
    mod_checker.ensure_capacity(mod_tree.nodes.len)
    mod.node_types = mod_checker.node_types as ptr[void]


    // Restore scope stack
    if st.stack.data != null as ptr[u32]:
        @free(st.stack.data as ptr[u8])
    st.stack.len = saved_len
    st.stack.cap = saved_cap
    st.stack.data = saved_data

    // 5. Export top-level public symbols
    if mod_tree.nodes.len > 0:
        let root = &mod_tree.nodes.data[0]
        mut child := root.first_child
        while child != 0 as u32:
            let child_node = &mod_tree.nodes.data[child]
            let kind = child_node.kind
            let flags = child_node.flags
            if kind == NODE_FUNC_DECL or kind == NODE_STRUCT_DECL or kind == NODE_CONST_DECL or kind == NODE_TYPE_ALIAS_DECL:
                if (flags & FLAG_IS_PUB) != 0 as u16 or (flags & FLAG_IS_EXTERN) != 0 as u16:
                    let sym_idx = child_node.payload
                    if sym_idx != 0 as u32:
                        let sym = &st.symbols.data[sym_idx]
                        let local_name_id = sym.name_id
                        let local_name = intern.get(local_name_id)
                        let full_name = std.string.concat(mod_name, std.string.concat(".", local_name))
                        let full_name_id = intern.intern_string(full_name)
                        
                        @free(get_str_ptr(full_name))
                        @free(get_str_ptr(local_name))
                        
                        // Flat define in global scope (0)
                        let global_scope = &st.scopes.data[0]
                        global_scope.scope_put(full_name_id, sym_idx)
                        
                        // Register export
                        let exp = ModuleExport(name_id: local_name_id, symbol_idx: sym_idx)
                        (&mod.exports).push(exp)

                        if kind == NODE_TYPE_ALIAS_DECL:
                            mut sum_child := child_node.first_child
                            mut sum_type_idx := 0 as u32
                            while sum_child != 0 as u32:
                                if mod_tree.nodes.data[sum_child].kind == NODE_SUM_TYPE:
                                    sum_type_idx = sum_child
                                    break
                                sum_child = mod_tree.nodes.data[sum_child].next_sibling
                            
                            if sum_type_idx != 0 as u32:
                                let sum_type_node = &mod_tree.nodes.data[sum_type_idx]
                                mut variant_idx := sum_type_node.first_child
                                while variant_idx != 0 as u32:
                                    let variant_node = &mod_tree.nodes.data[variant_idx]
                                    if variant_node.kind == NODE_VARIANT_DECL:
                                        let v_sym_idx = variant_node.payload
                                        if v_sym_idx != 0 as u32:
                                            let v_sym = &st.symbols.data[v_sym_idx]
                                            let v_local_name_id = v_sym.name_id
                                            let v_local_name = intern.get(v_local_name_id)
                                            let v_full_name = std.string.concat(mod_name, std.string.concat(".", v_local_name))
                                            let v_full_name_id = intern.intern_string(v_full_name)
                                            
                                            @free(get_str_ptr(v_full_name))
                                            @free(get_str_ptr(v_local_name))
                                            
                                            let global_scope_inner = &st.scopes.data[0]
                                            global_scope_inner.scope_put(v_full_name_id, v_sym_idx)
                                            
                                            let v_exp = ModuleExport(name_id: v_local_name_id, symbol_idx: v_sym_idx)
                                            (&mod.exports).push(v_exp)
                                    variant_idx = variant_node.next_sibling
            child = child_node.next_sibling

    // Cleanup resources
    mod.src_leak = src
    mod.tokens_leak = tokens
    mod.tokens_data = tokens.data as ptr[void]
    if lexer.tokens.data != null as ptr[Token]:
        @free(lexer.tokens.data as ptr[u8])
    if lexer.indent_stack.data != null as ptr[i32]:
        @free(lexer.indent_stack.data as ptr[u8])
    if lexer.newline_offsets.data != null as ptr[i32]:
        @free(lexer.newline_offsets.data as ptr[u8])
    mod.src_buffer = get_str_ptr(src) as ptr[void]
    @free(get_str_ptr(file_path))
    @free(get_str_ptr(mod_name))
    @free(mod_resolver as ptr[u8])
    @free(mod_checker as ptr[u8])
    @free(parser_ptr as ptr[u8])

    return 0 as i32
