# ============================================================
# AXIOM Compiler — .gitignore
# ============================================================

# ----------------------------------------------------------
# Binaries & Executables
# ----------------------------------------------------------
# bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ----------------------------------------------------------
# Build Artifacts (object files, assembly, def files)
# ----------------------------------------------------------
*.obj
*.o
*.asm
*.def

# ----------------------------------------------------------
# Test Binaries
# ----------------------------------------------------------
*.test

# ----------------------------------------------------------
# Go Coverage
# ----------------------------------------------------------
*.out
coverage.html

# ----------------------------------------------------------
# Log Files
# ----------------------------------------------------------
*.log

# ----------------------------------------------------------
# Build Output Text Files
# ----------------------------------------------------------
stdout.txt
stderr.txt
stdout_stage2.txt
stderr_stage2.txt
out.txt
out.log
err.txt
compile_out.txt
compile_stage2.log

# ----------------------------------------------------------
# Dump / Trace Files
# ----------------------------------------------------------
*_dump.txt
trace*.txt
*_debug_dump.txt

# ----------------------------------------------------------
# AIR Output Files
# ----------------------------------------------------------
air.txt
air_stage0.txt
air_stage1.txt
test_malloc_air*.txt

# ----------------------------------------------------------
# Test Output Files
# ----------------------------------------------------------
test_out*.txt
test_run*.log
test_dump*.log
test_stage*.log
sema_test*.log
test_output.log
out_test.txt

# ----------------------------------------------------------
# Generated C Files (build intermediates in root)
# ----------------------------------------------------------
stage1.c
stage1_debug.c
stage1_utf8.c
axiom_temp.c
temp_*.c
test_malloc.c
test_simple_self.c
test_print.c

# ----------------------------------------------------------
# Debug C Files (test harness outputs in root)
# ----------------------------------------------------------
allocator_test_debug.c
scheduler_test_debug.c
sync_test_debug.c
sync_err.txt

# ----------------------------------------------------------
# Debug / compile dump txt (cleaned 2026-07-03; keep repo free of these)
# ----------------------------------------------------------
compile_err*.txt
compile_log*.txt
compile_out*.txt
compile_stage*.txt
build_stage*.txt
gdb_*.txt
emi*.txt
*_air.txt
*_out.txt
*.out.txt
ast_dump*.txt
axiom_temp*.txt
bug*_status.txt

# ----------------------------------------------------------
# Python cache
# ----------------------------------------------------------
__pycache__/
*.pyc

# ----------------------------------------------------------
# Generated Scratch / Temp Directories
# ----------------------------------------------------------
scratch/

# ----------------------------------------------------------
# IDE & Editor Files
# ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ----------------------------------------------------------
# OS Files
# ----------------------------------------------------------
.DS_Store
Thumbs.db
bin/_regtmp/
bin/_sizetmp/
# Scratch files written BY the oracles themselves while they run (t_nolibcstdio,
# t_ionativefile round-trip a file through std.io to prove the native handle path
# works). They are outputs, not fixtures -- the .ax sources that produce them are
# tracked, these are regenerated on every run.
bin/_t_*.tmp
# elf_linux_check.sh build outputs
bin/*.elf

# Compiler-generated side artifacts of a --staticlib / FFI build. Both appear next
# to the output, so probing library consumption leaves a scatter of them across
# bin/ and tests/ffi/ that is easy to commit by accident.
*.lib.manifest
bin/*_ffi.ax
tests/ffi/*_ffi.ax
# Build outputs of the tests/ffi README walkthrough
tests/ffi/*.lib
tests/ffi/app_static.exe

# Debug dump of the self-linked concatenated source, rewritten by EVERY -self-link
# build and read by nothing (bootstrap/stage1/main_air.ax only writes it). Tracking
# it meant a normal build always left the tree dirty, so `git status` carried a
# permanent false positive that real uncommitted work could hide behind -- session
# notes back to 2026-07-09 record working around it.
scratch/self_linked_concatenated.ax

# Generated by scripts/perf_suite.ps1 (sources are embedded in the script itself)
# plus ad-hoc bisect programs; nothing here is a source of truth.
bin/bench/
