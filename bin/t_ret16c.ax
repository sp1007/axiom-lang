extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn zpn(tag: i64, v: i64):
    putchar(tag as i32)
    putchar('=' as i32)
    mut x := v
    if x == 0 as i64:
        putchar('0' as i32)
    mut buf := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        buf[n] = ('0' as u8) + (x % 10 as i64) as u8
        n = n + 1 as i64
        x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        putchar(buf[j] as i32)
        j = j - 1 as i64
    putchar(' ' as i32)
    fflush(null as ptr[void])

struct Fx:
    off: i64
    lbl: u32
    sz: i32
    pad: i64

struct FxVec:
    data: ptr[Fx]
    len: i64
    cap: i64

// mirrors push_fixup exactly: 16-byte struct literal passed by value
fn pushit(mut self: ptr[FxVec], f: Fx):
    if self.len == self.cap:
        mut nc := 16 as i64
        if self.cap != 0 as i64:
            nc = self.cap * 2 as i64
        let nd = @alloc(nc * 24) as ptr[Fx]
        if self.data != null as ptr[Fx]:
            @memcpy(nd as ptr[u8], self.data as ptr[u8], self.len * 24)
        self.data = nd
        self.cap = nc
    self.data[self.len] = f
    self.len = self.len + 1

pub fn main() -> i32:
    mut v := FxVec(data: null as ptr[Fx], len: 0 as i64, cap: 0 as i64)
    pushit(&v, Fx(off: 100 as i64, lbl: 7 as u32, sz: 5 as i32, pad: 0 as i64))
    pushit(&v, Fx(off: 200 as i64, lbl: 9 as u32, sz: 6 as i32, pad: 0 as i64))
    let g0 = v.data[0]
    zpn('O' as i64, g0.off)        // expect 100
    zpn('L' as i64, g0.lbl as i64) // expect 7
    zpn('S' as i64, g0.sz as i64)  // expect 5
    let g1 = v.data[1]
    zpn('P' as i64, g1.off)        // expect 200
    zpn('Q' as i64, g1.lbl as i64) // expect 9
    putchar(10 as i32)
    fflush(null as ptr[void])
    return 0
