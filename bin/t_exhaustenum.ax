// Oracle (exit 3): an EXHAUSTIVE no-payload-enum match (all variants as bare
// binding-pattern arms) must still compile and run -- guards the exhaustiveness
// fix against a false positive that would reject valid total matches.
type Color = Red | Green | Blue

fn f(c: Color) -> i32:
    match c:
        Red:
            return 1
        Green:
            return 2
        Blue:
            return 3

fn main() -> i32:
    return f(Blue)
