// OPEN BUG repro (2026-07-30): a user function whose name collides with a
// builtin-intercepted method (get/len/find/push) AND which takes an INTERFACE
// parameter is not called at all -- the call is intercepted as a builtin on the
// interface value. Renaming the function to anything non-builtin returns 36.
// `fn len(sh: Shape)` returns 8, the interface value's size, which is the tell.
// Expected 36; currently returns 0. See knowledge/bug-user-fn-builtin-name-iface-param.md
interface Shape:
    fn area(self: Self) -> i64

struct Sq:
    s: i64
    fn area(self: Sq) -> i64:
        return self.s * self.s

fn get(sh: Shape) -> i64:
    return sh.area()

fn main() -> i64:
    return get(Sq(s: 6))
