// Oracle (exit=42): RFC 0017 P2 — method call (mut + read) on a module-level struct global receiver.
struct Counter:
    n: i64
fn inc(mut self: Counter):
    self.n = self.n + 1
fn get(self: Counter) -> i64:
    return self.n
mut g: Counter = Counter(n: 40)
fn main() -> i32:
    g.inc()
    g.inc()
    return g.get() as i32   // 42
