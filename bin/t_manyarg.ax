import std.string

fn manyargs(fmt: str, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i64:
    return std.string.len(fmt) + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8

pub fn main() -> i32:
    let r = manyargs("hello", 1 as i64, 2 as i64, 3 as i64, 4 as i64, 5 as i64, 6 as i64, 7 as i64, 8 as i64)
    // expect len("hello")=5 + (1+2+3+4+5+6+7+8=36) = 41
    return r as i32
