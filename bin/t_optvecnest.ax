// nested generic Option[Vec[i64]]
fn build(n: i64) -> Option[Vec[i64]]:
    if n <= 0:
        return None
    mut v := Vec[i64]()
    v.push(n)
    v.push(n * 2)
    return Some(v)
fn main() -> i64:
    let o = build(14)
    match o:
        Some(vec):
            mut s := 0
            for e in vec:
                s = s + e
            return s
        None:
            return 0
