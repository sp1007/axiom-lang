// Regression: read a builtin Option element out of a fixed array and match it.
// Was a silent SIGSEGV (element typed i32, truncating the 8-byte box pointer).
fn main() -> i64:
    let arr: [Option[i64]; 2] = [Some(40), Some(2)]
    match arr[0]:
        Some(v):
            return v
        None:
            return 1
