import std.result

fn ok_str(flag: i64) -> Result[str, str]:
    if flag > 0:
        return Ok("payload-ok")
    return Err("payload-err")

pub fn main() -> i32:
    let s2 = ok_str(0)
    let raw = (&s2) as ptr[u64]
    mut code := 0
    if (raw[0] & (1 as u64)) == (1 as u64):
        code = code + 1
    if s2.is_err():
        code = code + 2
    if not s2.is_ok():
        code = code + 4
    // expect 7
    return code as i32
