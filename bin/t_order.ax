import std.string

// 8-byte param BEFORE 16-byte str param
fn f_first(a: i64, b: str) -> i64:
    return a * 100 + std.string.len(b)

// 16-byte str param BEFORE 8-byte param
fn g_first(b: str, a: i64) -> i64:
    return a * 100 + std.string.len(b)

pub fn main() -> i32:
    let r1 = f_first(7 as i64, "hello")
    let r2 = g_first("hello", 9 as i64)
    // expect r1 = 7*100+5 = 705 ; r2 = 9*100+5 = 905
    return (r1 * 10000 + r2) as i32
