// Companion negative for t_stdmath: now that a non-bundled std module really is LOADED,
// a typo in a member name must be a compile error and not a runtime jump. This is the
// FIELD_EXPR shape of B4 (`std.math` is itself a field-expr receiver carrying the
// "payload is a symbol index" flag), where t_modnomember pins the IDENT shape.
import std.math

fn main() -> i64:
    println("không được biên dịch tới đây: ", std.math.no_such_thing(1.0))
    return 0
