// Regression repro: sort_quick_f64 + binary_search_i64 (mirrors std.sort).
// Self-contained. Exit 5 = all 5 oracle checks pass.
extern "C" fn putchar(c: i32) -> i32

fn qsort_f64(arr: ptr[f64], lo: i64, hi: i64, less: fn(f64, f64) -> bool):
    if lo >= hi:
        return
    let pivot = arr[hi]
    mut i := lo - 1 as i64
    mut j := lo
    while j < hi:
        if less(arr[j], pivot):
            i = i + 1 as i64
            let t = arr[i]
            arr[i] = arr[j]
            arr[j] = t
        j = j + 1 as i64
    let p = i + 1 as i64
    let tp = arr[p]
    arr[p] = arr[hi]
    arr[hi] = tp
    qsort_f64(arr, lo, p - 1 as i64, less)
    qsort_f64(arr, p + 1 as i64, hi, less)

fn sort_quick_f64(arr: ptr[f64], n: i64, less: fn(f64, f64) -> bool):
    qsort_f64(arr, 0 as i64, n - 1 as i64, less)

fn binary_search_i64(arr: ptr[i64], n: i64, key: i64) -> i64:
    mut lo := 0 as i64
    mut hi := n - 1 as i64
    while lo <= hi:
        let mid = lo + (hi - lo) / 2 as i64
        let v = arr[mid]
        if v == key:
            return mid
        if v < key:
            lo = mid + 1 as i64
        else:
            hi = mid - 1 as i64
    return -1 as i64

fn fasc(a: f64, b: f64) -> bool:
    return a < b

fn fsorted(arr: ptr[f64], n: i64) -> bool:
    mut i := 1 as i64
    while i < n:
        if arr[i] < arr[i - 1 as i64]:
            return false
        i = i + 1
    return true

pub fn main() -> i32:
    mut pass := 0 as i32
    let n = 6 as i64
    let f = @alloc(n * 8 as i64) as ptr[f64]
    f[0] = 3.5
    f[1] = 0.0 - 1.5
    f[2] = 2.0
    f[3] = 0.0 - 4.0
    f[4] = 1.25
    f[5] = 0.5
    sort_quick_f64(f, n, fasc)
    if fsorted(f, n):
        pass = pass + 1
    if f[0] < (0.0 - 3.9) and f[0] > (0.0 - 4.1):
        pass = pass + 1
    if f[5] > 3.4 and f[5] < 3.6:
        pass = pass + 1

    // binary search over ascending i64 [1,3,5,7,9,11,13]
    let m = 7 as i64
    let a = @alloc(m * 8 as i64) as ptr[i64]
    a[0] = 1 as i64
    a[1] = 3 as i64
    a[2] = 5 as i64
    a[3] = 7 as i64
    a[4] = 9 as i64
    a[5] = 11 as i64
    a[6] = 13 as i64
    if binary_search_i64(a, m, 9 as i64) == 4 as i64:
        pass = pass + 1
    if binary_search_i64(a, m, 8 as i64) == (0 as i64 - 1 as i64):
        pass = pass + 1

    return pass as i32
