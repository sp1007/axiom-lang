// Vec.enumerate stdlib method: yields (index, element) tuples
fn main() -> i64:
    mut v: Vec[i64] = Vec.new()
    v.push(10)
    v.push(20)
    v.push(30)
    let pairs = v.enumerate()
    mut acc := 0 as i64
    mut j := 0 as i64
    while j < pairs.len:
        let p = pairs.get(j).unwrap()
        acc = acc + p.0 + p.1
        j = j + 1
    return acc
