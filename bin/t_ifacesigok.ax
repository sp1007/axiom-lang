// RFC 0029: exact-signature interface impl must still compile+run. Expect 15.
interface Shape:
    fn area(self: Self) -> i64
    fn scale(self: Self, f: i64) -> i64
struct Sq:
    side: i64
    fn area(self: Sq) -> i64:
        return self.side * self.side
    fn scale(self: Sq, f: i64) -> i64:
        return self.side * f
fn main() -> i64:
    let s: Shape = Sq(side: 3)
    return s.area() + s.scale(2)
