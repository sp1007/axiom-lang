// RFC 0007 §2.2: a struct lhs with NO `lt` method must be a typecheck ERROR.
// MUST BE REJECTED (no executable).
//
// Same shape as t_opnooverload.ax for the ORDERING operator: `total_lt` ends in
// "_lt", which the retired rank-1 loose window (RFC 0037) accepted as `lt`, so
// `a < b` was answered by a method the user never named.
struct Num:
    v: i64
    fn total_lt(self, o: Num) -> bool:
        return true

fn main() -> i64:
    let a = Num(v: 10)
    let b = Num(v: 2)
    if a < b:
        return 7
    return 42
