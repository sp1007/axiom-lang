// KNOWN-FAIL repro (NOT in regression until fixed) — see knowledge/bug-global-write-param-return-lost.md
// A function that has (a param) AND (a non-void return) AND (writes a module global) LOSES the
// global write. Removing ANY of the three makes it correct. O-level independent (fails at O0),
// so NOT a DCE issue — a selector/regalloc miscompile of OP_STORE→OP_GLOBAL_ADDR when a param
// register and a return value are both live. Expected 42; actual 0.
mut g: i64 = 0

fn worker(n: i64) -> i64:
    g = 42 as i64
    return 0 as i64

fn main() -> i32:
    let r = worker(5 as i64)
    return g as i32   // want 42, gets 0 (global write lost)
