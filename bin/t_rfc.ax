import std.io
import std.result
import std.string

fn read_file_content(path: str) -> str:
    let r = std.io.open(path)
    if r.is_ok():
        let file = r.unwrap()
        let r2 = file.read_all()
        if r2.is_ok():
            let content = r2.unwrap()
            return content
    return ""

pub fn main() -> i32:
    let src = read_file_content("trivial.ax")
    if std.string.len(src) == 0 as i64:
        return 99
    return std.string.len(src) as i32
