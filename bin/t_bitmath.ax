fn b_rotate_right(x: u64, k: u64) -> u64:
    if k == 0 as u64:
        return x
    return (x >> k) | (x << (64 as u64 - k))

fn b_reverse_bits(x: u64) -> u64:
    mut r := 0 as u64
    mut v := x
    mut i := 0 as i32
    while i < 64:
        r = (r << 1) | (v & 1 as u64)
        v = v >> 1
        i = i + 1
    return r

fn b_bit_floor(x: u64) -> u64:
    if x == 0 as u64:
        return 0 as u64
    mut p := (1 as u64) << 63
    while p > x:
        p = p >> 1
    return p

fn b_bit_ceil(x: u64) -> u64:
    if x <= 1 as u64:
        return 1 as u64
    let f = b_bit_floor(x)
    if f == x:
        return x
    return f << 1

fn b_parity(x: u64) -> u64:
    mut v := x
    mut c := 0 as u64
    while v != 0 as u64:
        c = c + (v & 1 as u64)
        v = v >> 1
    return c & 1 as u64

pub fn main() -> i32:
    mut s := 0 as i32
    if b_rotate_right(1 as u64, 1 as u64) == (9223372036854775808 as u64):
        s = s + 1
    if b_reverse_bits(1 as u64) == (9223372036854775808 as u64):
        s = s + 2
    if b_reverse_bits(9223372036854775808 as u64) == 1 as u64:
        s = s + 4
    if b_bit_floor(100 as u64) == 64 as u64 and b_bit_floor(64 as u64) == 64 as u64:
        s = s + 8
    if b_bit_ceil(100 as u64) == 128 as u64 and b_bit_ceil(64 as u64) == 64 as u64:
        s = s + 16
    if b_parity(7 as u64) == 1 as u64 and b_parity(10 as u64) == 0 as u64:
        s = s + 32
    if b_bit_ceil(1 as u64) == 1 as u64 and b_bit_floor(1 as u64) == 1 as u64:
        s = s + 64
    return s   // expect 127
