// bin/t_vec.ax — 3D vectors (struct f64 fields + operator overload).
// add/sub operators, dot, cross, length, normalize -> exit 63.
fn sqrtf(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut g := x
    mut i := 0 as i32
    while i < 80:
        let ng = (g + x / g) * 0.5
        mut d := ng - g
        if d < 0.0:
            d = 0.0 - d
        if d < 0.000000000001:
            return ng
        g = ng
        i = i + 1
    return g

struct Vec3:
    x: f64
    y: f64
    z: f64

    fn add(self, o: Vec3) -> Vec3:
        return Vec3(x: self.x + o.x, y: self.y + o.y, z: self.z + o.z)

    fn sub(self, o: Vec3) -> Vec3:
        return Vec3(x: self.x - o.x, y: self.y - o.y, z: self.z - o.z)

fn v3(x: f64, y: f64, z: f64) -> Vec3:
    return Vec3(x: x, y: y, z: z)

fn v_dot(a: Vec3, b: Vec3) -> f64:
    return a.x * b.x + a.y * b.y + a.z * b.z

fn v_cross(a: Vec3, b: Vec3) -> Vec3:
    return Vec3(x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x)

fn v_len(a: Vec3) -> f64:
    return sqrtf(a.x * a.x + a.y * a.y + a.z * a.z)

fn v_scale(a: Vec3, k: f64) -> Vec3:
    return Vec3(x: a.x * k, y: a.y * k, z: a.z * k)

fn v_normalize(a: Vec3) -> Vec3:
    let l = v_len(a)
    if l == 0.0:
        return a
    return Vec3(x: a.x / l, y: a.y / l, z: a.z / l)

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.00001

pub fn main() -> i32:
    mut s := 0 as i32
    let a = v3(1.0, 2.0, 3.0)
    let b = v3(4.0, 5.0, 6.0)
    let sum = a + b
    if near(sum.x, 5.0) and near(sum.y, 7.0) and near(sum.z, 9.0):
        s = s + 1
    if near(v_dot(a, b), 32.0):
        s = s + 2
    let cr = v_cross(v3(1.0, 0.0, 0.0), v3(0.0, 1.0, 0.0))   // (0,0,1)
    if near(cr.x, 0.0) and near(cr.y, 0.0) and near(cr.z, 1.0):
        s = s + 4
    if near(v_len(v3(3.0, 4.0, 0.0)), 5.0):
        s = s + 8
    let n = v_normalize(v3(3.0, 4.0, 0.0))                   // (0.6,0.8,0)
    if near(n.x, 0.6) and near(n.y, 0.8) and near(v_len(n), 1.0):
        s = s + 16
    let d = a - b                                            // (-3,-3,-3)
    if near(d.x, 0.0 - 3.0) and near(d.z, 0.0 - 3.0):
        s = s + 32
    return s   // expect 63
