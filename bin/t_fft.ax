// bin/t_fft.ax — regression for std.fft (radix-2 Cooley-Tukey, #26).
// Self-contained. Exit 18 = all checks pass:
//   impulse x=[1,0..] -> every bin (1,0)           : 8
//   round-trip fft+ifft of [1..8] recovers input   : 8
//   DC x=[1x8] -> X[0]=(8,0)                        : 1
//   DC other bins all ~0                            : 1
//
// Build: axc_stage1 build bin/t_fft.ax -o t_fft && ./t_fft ; echo $? (=>18)

const PI:      f64 = 3.14159265358979323846
const HALF_PI: f64 = 1.57079632679489661923
const TAU:     f64 = 6.28318530717958647692

fn abs(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x

fn sin(x: f64) -> f64:
    mut a := x
    let q = (a / TAU) as i64
    a = a - (q as f64) * TAU
    if a > PI:
        a = a - TAU
    if a < (0.0 - PI):
        a = a + TAU
    let a2 = a * a
    mut term := a
    mut s := a
    mut n := 1 as i32
    while n < 12:
        let d = ((2 * n) * (2 * n + 1)) as f64
        term = (0.0 - term) * a2 / d
        s = s + term
        n = n + 1
    return s

fn cos(x: f64) -> f64:
    return sin(x + HALF_PI)

fn fft_bit_reverse(re: ptr[f64], im: ptr[f64], n: i64):
    mut j := 0 as i64
    mut i := 1 as i64
    while i < n:
        mut bit := n >> 1 as i64
        while bit > 0 as i64 and (j & bit) != 0 as i64:
            j = j - bit
            bit = bit >> 1 as i64
        j = j + bit
        if i < j:
            let tr = re[i]
            re[i] = re[j]
            re[j] = tr
            let ti = im[i]
            im[i] = im[j]
            im[j] = ti
        i = i + 1

fn fft(re: ptr[f64], im: ptr[f64], n: i64, inverse: bool):
    if n <= 1 as i64:
        return
    fft_bit_reverse(re, im, n)
    mut len := 2 as i64
    while len <= n:
        mut base := (0.0 - TAU) / (len as f64)
        if inverse:
            base = TAU / (len as f64)
        let half = len >> 1 as i64
        mut start := 0 as i64
        while start < n:
            mut k := 0 as i64
            while k < half:
                let ang = base * (k as f64)
                let wr = cos(ang)
                let wi = sin(ang)
                let a = start + k
                let b = start + k + half
                let tr = wr * re[b] - wi * im[b]
                let ti = wr * im[b] + wi * re[b]
                let ur = re[a]
                let ui = im[a]
                re[a] = ur + tr
                im[a] = ui + ti
                re[b] = ur - tr
                im[b] = ui - ti
                k = k + 1
            start = start + len
        len = len << 1 as i64
    if inverse:
        let inv = 1.0 / (n as f64)
        mut m := 0 as i64
        while m < n:
            re[m] = re[m] * inv
            im[m] = im[m] * inv
            m = m + 1

fn near(got: f64, want: f64) -> bool:
    return abs(got - want) < 0.0001

pub fn main() -> i32:
    mut pass := 0 as i32
    let n = 8 as i64

    // --- impulse: x=[1,0,0,0,0,0,0,0] -> every bin = (1,0)
    let re = @alloc(n * 8 as i64) as ptr[f64]
    let im = @alloc(n * 8 as i64) as ptr[f64]
    mut i := 0 as i64
    while i < n:
        re[i] = 0.0
        im[i] = 0.0
        i = i + 1
    re[0 as i64] = 1.0
    fft(re, im, n, false)
    i = 0 as i64
    while i < n:
        if near(re[i], 1.0) and near(im[i], 0.0):
            pass = pass + 1
        i = i + 1

    // --- round-trip: [1..8] -> fft -> ifft -> recovers
    let r2 = @alloc(n * 8 as i64) as ptr[f64]
    let i2 = @alloc(n * 8 as i64) as ptr[f64]
    i = 0 as i64
    while i < n:
        r2[i] = (i + 1 as i64) as f64
        i2[i] = 0.0
        i = i + 1
    fft(r2, i2, n, false)
    fft(r2, i2, n, true)
    i = 0 as i64
    while i < n:
        if near(r2[i], (i + 1 as i64) as f64) and near(i2[i], 0.0):
            pass = pass + 1
        i = i + 1

    // --- DC: x=[1x8] -> X[0]=(8,0), rest ~0
    let r3 = @alloc(n * 8 as i64) as ptr[f64]
    let i3 = @alloc(n * 8 as i64) as ptr[f64]
    i = 0 as i64
    while i < n:
        r3[i] = 1.0
        i3[i] = 0.0
        i = i + 1
    fft(r3, i3, n, false)
    if near(r3[0 as i64], 8.0) and near(i3[0 as i64], 0.0):
        pass = pass + 1
    mut zero_ok := true
    i = 1 as i64
    while i < n:
        if abs(r3[i]) > 0.001 or abs(i3[i]) > 0.001:
            zero_ok = false
        i = i + 1
    if zero_ok:
        pass = pass + 1

    return pass
