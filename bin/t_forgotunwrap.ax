// Oracle (reject): accessing a field on an Option/Result value WITHOUT unwrapping
// (`o.v` where o: Option[Cell]) silently read the box/tag as garbage instead of the
// payload -> now a clean compile-time REJECT (post-typecheck "forgot to unwrap" pass).
struct Cell:
    v: i64
pub fn main() -> i32:
    let o: Option[Cell] = Some(Cell(v: 42 as i64))
    return o.v as i32
