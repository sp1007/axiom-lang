// Oracle (reject): a METHOD call with too FEW args was silently accepted
// (missing args read uninitialized registers) -> now rejected.
struct Pt:
    x: i64
    fn add(self, a: i64, b: i64) -> i64:
        return self.x + a + b
pub fn main() -> i32:
    let p = Pt(x: 7 as i64)
    return p.add(3 as i64) as i32
