// Oracle (exit 75): unary float negation `-x` was miscompiled -- sign dropped at
// -O0 (GPR xor on an XMM reg) and folded to 0.0 at -O1 (integer const-fold of a
// float bit pattern). Now correct at both levels.
fn main() -> i32:
    let a = 2.5
    let h = -a
    let b = -(1.0)
    return (h * 10.0 + 100.0 + b) as i32
