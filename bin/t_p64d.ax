extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn show(c_ptr: ptr[u8], len: i64):
    putchar('S' as i32)
    fflush(null as ptr[void])
    mut k := 0 as i64
    while k < len:
        putchar(c_ptr[k] as i32)
        k = k + 1
    putchar(10 as i32)
    fflush(null as ptr[void])

pub fn main() -> i32:
    mut buf := @alloc(8) as ptr[u8]
    buf[0] = 'h' as u8
    buf[1] = 'i' as u8
    putchar('M' as i32)
    fflush(null as ptr[void])
    show(buf, 2 as i64)
    putchar('Z' as i32)
    fflush(null as ptr[void])
    return 0
