// Oracle (exit 67): RFC 0026 §2b — tail-self-recursion -> loop.
// sumto: accumulator tail recursion. gcd: swap-style tail recursion (the tail
// call gcd(b, a%b) reads BOTH params, so the two-phase arg->temp->param staging
// is exercised — a naive direct param=arg would clobber). Deep recursion (sumto
// n=100000) would STACK-OVERFLOW without the loop transform, so this also proves
// the transform actually fires.
fn sumto(n: i64, acc: i64) -> i64:
    if n == 0:
        return acc
    return sumto(n - 1, acc + n)
fn gcd(a: i64, b: i64) -> i64:
    if b == 0:
        return a
    return gcd(b, a % b)
fn main() -> i32:
    let s = sumto(100000, 0)      // 100000*100001/2 = 5000050000; & 0xFF path not used (added below)
    let g = gcd(48, 36)           // 12
    // s is huge; reduce deterministically: (s % 1000) = 0? 5000050000 % 1000 = 0. use gcd + small sum
    let s2 = sumto(10, 0)         // 55
    return (s2 + g) as i32        // 67  (and sumto(100000) must not stack-overflow)
