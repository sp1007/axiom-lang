// Oracle (reject): a concrete struct passed where an interface is expected must
// structurally implement it. `Bad` has no `area` method, so `total(Bad(..))` must be
// REJECTED (else RFC 0029 dispatch builds a vtable slot from a 0 method-symbol and
// calls through a null pointer — accept-then-miscompile, BUG#53 class).
interface Shape:
    fn area(self: Self) -> i64
struct Bad:
    x: i64
fn total(s: Shape) -> i64:
    return s.area()
fn main() -> i64:
    return total(Bad(x: 5))
