import std.result
// Oracle 42: Option carrying struct payload across fn boundary + unwrap
struct P:
    x: i64
    y: i64
fn find(k: i64) -> Option[P]:
    if k > 0:
        return Some(P(x: 30, y: 12))
    return None
fn main() -> i32:
    let r: Option[P] = find(1)
    mut acc: i64 = 0
    if r.is_some():
        let p: P = r.unwrap()
        acc = p.x + p.y
    let n: Option[P] = find(0)
    if n.is_none():
        acc = acc + 0
    return acc as i32
