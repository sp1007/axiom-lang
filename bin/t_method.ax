// RFC 0002: untyped self receiver
struct Pt:
    x: i64
    fn getx(self) -> i64:
        return self.x
    fn bump(mut self, d: i64):
        self.x = self.x + d
pub fn main() -> i32:
    mut p = Pt(x: 7 as i64)
    let a = p.getx()      // 7
    p.bump(10 as i64)     // p.x = 17
    return (a + p.getx()) as i32   // 7 + 17 = 24
