// RFC 0006 §4 (E3032): a call argument against a DECLARED `f32` parameter. Every parameter
// carries a user-written type, so the f64 argument has an explicit narrow target exactly
// like a `let` annotation.
fn takes(v: f32) -> f32:
    return v

fn main() -> i64:
    let d: f64 = 3.5
    return takes(d) as i64
