import std.result

fn ok_i64(x: i64) -> Result[i64, str]:
    if x > 0:
        return Ok(x)
    return Err("neg")

pub fn main() -> i32:
    let r1 = ok_i64(42)
    let raw = (&r1) as ptr[u64]
    let p = raw[0]
    if p == 42 as u64:
        return 42
    if p > 65536 as u64:
        return 1
    return 99
