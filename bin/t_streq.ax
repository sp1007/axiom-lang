import std.string

extern "C" fn putchar(c: i32) -> i32

fn pc(c: i64):
    putchar(c as i32)

fn check(a: str, b: str, expect_eq: bool):
    let r = (a == b)
    if r == expect_eq:
        pc('.' as i64)
    else:
        pc('X' as i64)

pub fn main() -> i32:
    check("val", "struct", false)
    check("val", "val", true)
    check("arg_idx", "struct", false)
    check("struct", "struct", true)
    check("if", "if", true)
    check("a1", "as", false)
    check("elif", "else", false)
    check("elif", "elif", true)
    pc(10 as i64)
    return 0
