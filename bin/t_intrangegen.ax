// RFC 0006 §6.1 (E3030): the EXPLICIT type-argument call form. `pick[u8](300, 1)` names the
// narrow type as plainly as an annotation does, but its callee is a NODE_INDEX_EXPR and it
// bypasses the generic instantiation path, so the plain per-param reject did not see it --
// the literal still bound 300 (bin/probe2/w3.ax measured exactly that). Covered separately.
fn pick[T](a: T, b: T) -> T:
    return a
fn main() -> i64:
    return pick[u8](300, 1) as i64
