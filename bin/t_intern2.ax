extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32
extern "C" fn strlen(s: ptr[u8]) -> i64

fn zpc(c: i64):
    putchar(c as i32)
    fflush(null as ptr[void])

fn zpn(tag: i64, v: i64):
    zpc(tag)
    zpc('=' as i64)
    mut x := v
    if x == 0 as i64:
        zpc('0' as i64)
    mut buf := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        buf[n] = ('0' as u8) + (x % 10 as i64) as u8
        n = n + 1 as i64
        x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        zpc(buf[j] as i64)
        j = j - 1 as i64
    zpc(' ' as i64)

struct ZIE:
    hash: u32
    padding: u32
    start: u32
    len: u32
    id: u32
    dummy: u32

struct ZIP:
    arena: ptr[u8]
    table: ptr[ZIE]
    arena_len: i64
    arena_cap: i64
    table_size: i64
    count: i64

fn zfnv(s: str) -> u32:
    mut h := 2166136261 as u32
    let length = std.string.len(s)
    mut i := 0
    while i < length:
        h = h ^ (s[i] as u32)
        h = h * 16777619 as u32
        i = i + 1
    return h & 4294967295 as u32

fn zmk() -> ptr[ZIP]:
    let table_size = 512 as i64
    let table = @alloc(table_size * 24) as ptr[ZIE]
    mut i := 0 as i64
    while i < table_size:
        table[i] = ZIE(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1
    let p = @alloc(48) as ptr[ZIP]
    p.arena = null as ptr[u8]
    p.table = table
    p.arena_len = 0
    p.arena_cap = 0
    p.table_size = table_size
    p.count = 0
    return p

fn zgrow(mut self: ptr[ZIP]):
    let old_size = self.table_size
    let new_size = old_size * 2
    let new_table = @alloc(new_size * 24) as ptr[ZIE]
    mut i := 0 as i64
    while i < new_size:
        new_table[i] = ZIE(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1
    let mask = new_size - 1
    i = 0
    while i < old_size:
        let entry = self.table[i]
        if entry.id != 0 as u32:
            mut idx = (entry.hash as i64) & mask
            while new_table[idx].id != 0 as u32:
                idx = (idx + 1) & mask
            new_table[idx] = entry
        i = i + 1
    self.table = new_table
    self.table_size = new_size

fn zinsert(mut self: ptr[ZIP], slot: i64, s: str, h: u32) -> u32:
    let length = std.string.len(s)
    if self.arena_len + length >= self.arena_cap:
        mut new_cap := 1024 as i64
        if self.arena_cap != 0:
            new_cap = self.arena_cap * 2
        if new_cap < self.arena_len + length:
            new_cap = self.arena_len + length + 1024
        let new_arena = @alloc(new_cap) as ptr[u8]
        if self.arena != null as ptr[u8]:
            @memcpy(new_arena, self.arena, self.arena_len)
        self.arena = new_arena
        self.arena_cap = new_cap
    let start = self.arena_len
    mut i := 0
    while i < length:
        self.arena[start + i] = s[i] as u8
        i = i + 1
    self.arena_len = self.arena_len + length
    let new_id = (self.count + 1) as u32
    let entry = ZIE(hash: h, padding: 0 as u32, start: start as u32, len: length as u32, id: new_id, dummy: 0 as u32)
    self.table[slot] = entry
    self.count = self.count + 1
    if (self.count * 100) / self.table_size > 70:
        self.zgrow()
    return new_id

fn zintern(mut self: ptr[ZIP], s: str) -> u32:
    let length = std.string.len(s)
    if length == 0:
        return 0 as u32
    let h = zfnv(s)
    let mask = self.table_size - 1
    mut idx = (h as i64) & mask
    while true:
        let entry = self.table[idx]
        if entry.id == 0 as u32:
            return self.zinsert(idx, s, h)
        if entry.hash == h and entry.len as i64 == length:
            mut is_match := true
            mut i := 0
            while i < length:
                if self.arena[entry.start as i64 + i] != s[i] as u8:
                    is_match = false
                    break
                i = i + 1
            if is_match:
                return entry.id
        idx = (idx + 1) & mask
    return 0 as u32

// distinct 3-char string for n
fn makekey(n: i64) -> str:
    let b = @alloc(8) as ptr[u8]
    b[0] = ('a' as u8) + (n % 26) as u8
    b[1] = ('a' as u8) + ((n / 26) % 26) as u8
    b[2] = ('a' as u8) + ((n / 676) % 26) as u8
    b[3] = 0 as u8
    return b as str

pub fn main() -> i32:
    let p = zmk()
    let ids = @alloc(601 * 4) as ptr[u32]
    mut k := 1 as i64
    while k < 601:
        ids[k] = zintern(p, makekey(k))
        k = k + 1
    zpn('C' as i64, p.count)
    zpn('T' as i64, p.table_size)
    // re-intern same keys: must return SAME id, no new inserts
    mut bad := 0 as i64
    k = 1
    while k < 601:
        let again = zintern(p, makekey(k))
        if again != ids[k]:
            bad = bad + 1
        k = k + 1
    zpn('D' as i64, p.count)   // expect 600
    zpn('B' as i64, bad)        // expect 0
    zpc(10 as i64)
    return 0
