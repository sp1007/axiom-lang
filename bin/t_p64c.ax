extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

pub fn main() -> i32:
    putchar('A' as i32)
    fflush(null as ptr[void])
    mut v := 12345 as i64
    mut buf := @alloc(32) as ptr[u8]
    mut len := 0
    while v > 0:
        let digit = (v % 10) as u8
        buf[len] = '0' as u8 + digit
        len = len + 1
        v = v / 10
    putchar('B' as i32)
    fflush(null as ptr[void])
    mut k := 0 as i64
    while k < len as i64:
        putchar(buf[k] as i32)
        k = k + 1
    putchar(10 as i32)
    fflush(null as ptr[void])
    return 0
