// p1: tuple as a HashMap VALUE (concrete). insert + get + read both fields.
fn main() -> i64:
    mut m: HashMap[i64, (i64, i64)] = new_hashmap()
    m.insert(1, (10, 20))
    m.insert(2, (3, 9))
    let a = m.get(1).unwrap()
    let b = m.get(2).unwrap()
    return a.0 + a.1 + b.0 + b.1     // want 42
