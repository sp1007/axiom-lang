import std.result

fn some_i64(x: i64) -> Option[i64]:
    if x > 0:
        return Some(x)
    return None

pub fn main() -> i32:
    let o1 = some_i64(7)
    if not o1.is_some():
        return 10
    let o2 = some_i64(0 - 1)
    if not o2.is_none():
        return 11
    if o1.unwrap() != 7:
        return 12
    return 0
