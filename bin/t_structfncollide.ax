// Oracle (REJECT): the mirror of t_fnstructcollide -- a user TYPE named after a
// BUNDLED FUNCTION. `concat` is a function in std/string.ax, bundled into every
// program, and SymbolTable.define hands the struct decl that function's symbol.
// Pre-fix this reported "'concat' expects 2 argument(s), found 1" for a plain
// struct construction, naming the wrong problem entirely. Must be REJECTED with a
// diagnostic that names the collision.
struct concat:
    v: i64

fn main() -> i32:
    let c = concat(v: 42 as i64)
    return c.v as i32
