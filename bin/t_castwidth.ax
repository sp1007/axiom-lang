fn main() -> i64:
    let a: u8 = 300 as u8
    let b: u8 = 44 as u8
    mut r := 0 as i64
    if a == b:
        r = r + 1
    if b == (300 as u8):
        r = r + 2
    let c: u16 = 70000 as u16
    if c == (4464 as u16):
        r = r + 4
    let d: i8 = 300 as i8
    if d == (44 as i8):
        r = r + 8
    return r
