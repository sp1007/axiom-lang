pub fn main() -> i32:
    println("Hello from AXIOM on Linux!")
    print("2 + 3 = ")
    println(2 + 3)
    print("fib(10) = ")
    mut a: i64 = 0
    mut b: i64 = 1
    mut i: i64 = 0
    while i < 9:
        let c: i64 = a + b
        a = b
        b = c
        i = i + 1
    println(b)
    println(true)
    return 0
