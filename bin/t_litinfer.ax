// RFC 0005: int literals adopt the other operand's concrete type — no `as` needed
pub fn main() -> i32:
    mut b: u32 = 10            // literal adopts u32 from annotation
    let c = b + 5             // 5 adopts u32 (arith, var+literal)
    let d = 100 - b           // 100 adopts u32 (literal+var)
    mut total: u32 = 0
    if b < 20:                // 20 adopts u32 (comparison)
        total = total + 1     // 1 adopts u32
    if c == 15:               // 15 adopts u32
        total = total + 10
    if d > 80:                // 80 adopts u32 ; d = 90
        total = total + 100
    return total as i32        // 1 + 10 + 100 = 111
