const PI: f64 = 3.14159265358979323846
const TAU: f64 = 6.28318530717958647692

fn expf(x: f64) -> f64:
    mut term := 1.0
    mut sum := 1.0
    mut n := 1 as i32
    while n < 60:
        term = term * x / (n as f64)
        sum = sum + term
        n = n + 1
    return sum

fn lnf(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut m := x
    mut e := 0 as i64
    while m >= 2.0:
        m = m * 0.5
        e = e + 1 as i64
    while m < 1.0:
        m = m * 2.0
        e = e - 1 as i64
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    mut term := t
    mut sum := 0.0
    mut n := 0 as i32
    while n < 20:
        sum = sum + term / ((2 * n + 1) as f64)
        term = term * t2
        n = n + 1
    return (e as f64) * 0.69314718055994530942 + 2.0 * sum

fn floorf(x: f64) -> f64:
    let i = x as i64
    mut f := i as f64
    if f > x:
        f = f - 1.0
    return f

fn roundf(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - floorf(0.0 - x + 0.5)
    return floorf(x + 0.5)

fn m_expm1(x: f64) -> f64:
    return expf(x) - 1.0

fn m_log_base(b: f64, x: f64) -> f64:
    return lnf(x) / lnf(b)

fn m_normalize_angle(a: f64) -> f64:
    return a - TAU * floorf((a + PI) / TAU)

fn m_copysign(mag: f64, sgn: f64) -> f64:
    mut m := mag
    if m < 0.0:
        m = 0.0 - m
    if sgn < 0.0:
        return 0.0 - m
    return m

fn m_pow10(d: i64) -> f64:
    mut p := 1.0
    mut i := 0 as i64
    while i < d:
        p = p * 10.0
        i = i + 1
    return p

fn m_round_to(x: f64, d: i64) -> f64:
    let p = m_pow10(d)
    return roundf(x * p) / p

fn near(v: f64, w: f64) -> bool:
    mut e := v - w
    if e < 0.0:
        e = 0.0 - e
    return e < 0.00001

pub fn main() -> i32:
    mut s := 0 as i32
    if near(m_expm1(0.5), 0.64872127) and near(m_expm1(0.001), 0.0010005):
        s = s + 1
    if near(m_log_base(2.0, 8.0), 3.0) and near(m_log_base(10.0, 1000.0), 3.0):
        s = s + 2
    if near(m_normalize_angle(5.0), 0.0 - 1.283185):
        s = s + 4
    if near(m_normalize_angle(0.0 - 5.0), 1.283185):
        s = s + 8
    if near(m_copysign(3.0, 0.0 - 2.0), 0.0 - 3.0) and near(m_copysign(0.0 - 3.0, 2.0), 3.0):
        s = s + 16
    if near(m_round_to(3.14159, 2 as i64), 3.14):
        s = s + 32
    if near(m_round_to(2.71828, 3 as i64), 2.718):
        s = s + 64
    return s   // expect 127
