// Oracle (exit=25): signed division/modulo with a negative dividend must
// truncate toward zero (q=-3, r=-2 for -17/5). Guards the sign handling of
// the IDIV lowering.
fn main() -> i32:
    let a: i64 = -17
    let b: i64 = 5
    let q = a / b      // -3
    let r = a % b      // -2
    return ((0 - q) * 5 + (0 - r) * 5) as i32  // 15 + 10 = 25
