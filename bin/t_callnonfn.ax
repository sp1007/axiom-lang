// Oracle: calling a plain VALUE variable `x(3)` (x is an i64, not a function)
// must be REJECTED. Previously accepted with UNKNOWN result type → air_builder
// lowered an INDIRECT `call reg` through the scalar → SIGSEGV.
// See knowledge/bug-malformed-input-robustness-cluster.md (m2)
fn main() -> i32:
    let x: i64 = 5
    let y: i64 = x(3)
    return y
