struct MyVec:
    data: ptr[i32]
    len: i64
    cap: i64

struct Lexlike:
    src: i64
    len: i64
    pos: i64
    a: MyVec
    b: MyVec
    c: MyVec

fn new_myvec() -> MyVec:
    return MyVec(data: null as ptr[i32], len: 0, cap: 0)

fn push(mut self: MyVec, val: i32):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 4 as i64) as ptr[i32]
        if self.data != null as ptr[i32]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 4 as i64)
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = val
    self.len = self.len + 1

pub fn main() -> i32:
    let lx = @alloc(512) as ptr[Lexlike]
    lx[0] = Lexlike(src: 5, len: 5, pos: 0, a: new_myvec(), b: new_myvec(), c: new_myvec())
    mut i := 0 as i64
    while i < 20 as i64:
        lx.c.push(i as i32)
        lx.b.push((i + 100 as i64) as i32)
        i = i + 1 as i64
    if lx.c.len != 20 as i64 or lx.b.len != 20 as i64:
        return 100
    return lx.c.data[19] as i32
