mut g_counter: i64 = 100

fn add(a: i64, b: i64) -> i64:
    return a + b

fn fib(n: i64) -> i64:
    if n < 2:
        return n
    mut a: i64 = 0
    mut b: i64 = 1
    mut i: i64 = 2
    while i <= n:
        let c: i64 = add(a, b)
        a = b
        b = c
        i = i + 1
    return b

pub fn main() -> i32:
    g_counter = g_counter + fib(10)
    return (g_counter - 100) as i32
