// RFC 0006 §4 (E3031): the EXPLICIT type-argument call form. `pick[i64](3.0, 1)` names the
// integer type as plainly as an annotation does, but its callee is a NODE_INDEX_EXPR that
// bypasses the generic instantiation path, so the per-param reject never sees it -- the
// same separate hook E3030 needed (bin/probe2/w3.ax measured that gap for integers).
fn pick[T](a: T, b: T) -> T:
    return a

fn main() -> i64:
    return pick[i64](3.0, 1)
