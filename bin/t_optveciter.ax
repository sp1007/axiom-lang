// Oracle (exit=6): Option wrapping a Vec[i64]; unwrap the container then
// iterate it. Crosses container-in-Option x unwrap x for-in.
import std.collections
fn build() -> Option[Vec[i64]]:
    mut v = Vec[i64].new()
    v.push(1)
    v.push(2)
    v.push(3)
    return Some(v)
fn main() -> i32:
    let ov = build()
    let v = ov.unwrap()
    mut t: i64 = 0
    for x in v:
        t = t + x
    return t as i32   // 1+2+3 = 6
