struct Logger:
    factor: i64
    fn actor(self: Logger, n: i64) -> i64:
        return n * self.factor
fn main() -> i64:
    let a: Logger = Logger(factor: 2)
    mut s := 0 as i64
    mut i := 0 as i64
    while i < 2:
        let x = a.actor(10)
        s = s + 1 as i64
        i = i + 1 as i64
    return s + 40
