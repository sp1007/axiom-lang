// P6 MINIMAL REPRO — pristine tree, no std edits.
// In-struct method whose NAME collides with an identifier already interned by the
// bundled stdlib ("actor" comes from std/scheduler.ax). Both operands are i64.
struct Logger:
    factor: i64
    fn actor(self: Logger, n: i64) -> i64:
        return n * self.factor

fn main() -> i64:
    let a: Logger = Logger(factor: 2)
    let x = a.actor(8)
    return x + 30
