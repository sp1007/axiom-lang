// same as t_ifaceconsumer but split the + into lets
interface Sink:
    fn emit(self: Self, n: i64) -> i64

struct Doubler:
    factor: i64
    fn emit(self: Doubler, n: i64) -> i64:
        return n * self.factor

struct AddTen:
    base: i64
    fn emit(self: AddTen, n: i64) -> i64:
        return n + self.base

struct Logger:
    sink: Sink
    fn run(self: Logger, n: i64) -> i64:
        return self.sink.emit(n)

fn make_logger(s: Sink) -> Logger:
    return Logger(sink: s)

fn main() -> i64:
    let a: Logger = make_logger(Doubler(factor: 2))
    let b: Logger = make_logger(AddTen(base: 10))
    let x = a.run(8)
    let y = b.run(20)
    return x + y
