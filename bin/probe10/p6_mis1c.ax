// control: same but method name has no stdlib collision
struct Buf:
    len: i64
    data: i64
    cap: i64

struct Logger:
    factor: i64
    fn zorkzork(self: Logger, n: i64) -> Buf:
        return Buf(len: 42 as i64, data: 7 as i64, cap: 9 as i64)

fn main() -> i64:
    let a: Logger = Logger(factor: 2)
    let p = a.zorkzork(1)
    return p.len
