// CONTROL for p6_oracle.ax — identical except the method name does NOT collide with
// any identifier interned by the bundled stdlib. MUST print: Kết quả P6 control: 46
struct Logger:
    factor: i64
    fn zorkzork(self: Logger, n: i64) -> i64:
        return n * self.factor

fn main() -> i64:
    let a: Logger = Logger(factor: 2)
    let x = a.zorkzork(8)
    println("Kết quả P6 control: ", x + 30)
    return 0
