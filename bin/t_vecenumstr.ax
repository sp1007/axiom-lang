// Vec.enumerate with T = str: the monomorphized element is a tuple holding a
// 16-byte inline {ptr,len}, the shape that used to need the aa419a2 __tup fix.
fn main() -> i64:
    mut v: Vec[str] = Vec.new()
    v.push("ab")
    v.push("cde")
    let pairs = v.enumerate()
    mut acc := 0 as i64
    mut j := 0 as i64
    while j < pairs.len:
        let p = pairs.get(j).unwrap()
        acc = acc + p.0 * 10 + p.1.len
        j = j + 1
    return acc   // (0*10+2) + (1*10+3) = 15
