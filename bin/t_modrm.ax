// Faithful repro of x86_encode_mov_rr's register-allocation bug: an addr-taken
// local `modrm` cached in a callee-saved reg, with OTHER values live across the
// call (forcing modrm into a callee-saved reg), then READ at the tail after the
// callee wrote through the pointer. If the stale reg copy is used -> BUG (0).
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn emit_modrm(reg: u8, rm: u8, out_modrm: ptr[u8], out_rex: ptr[u8], out_need: ptr[bool]):
    out_modrm[0] = (0b11 as u8 << 6 as u8) | ((reg & 7 as u8) << 3 as u8) | (rm & 7 as u8)
    out_rex[0] = 0 as u8
    if reg >= 8 as u8 or rm >= 8 as u8:
        out_need[0] = true
    else:
        out_need[0] = false

fn use2(buf: ptr[u8], a: u8):
    buf[0] = a

fn enc(dst: u8, src: u8, buf: ptr[u8]) -> u8:
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need := false
    emit_modrm(src, dst, &modrm, &rex, &need)
    // keep dst/src/buf live across more calls (register pressure, mirrors mov_rr)
    if need:
        rex = rex | (8 as u8)
        use2(buf, rex)
    else:
        use2(buf, 0 as u8)
    use2(buf, 0x89 as u8)
    use2(buf, modrm)   // <-- the read that must reload modrm from memory
    return modrm

pub fn main() -> i32:
    mut b := @alloc(8) as ptr[u8]
    // src=4(rsp),dst=5(rbp): modrm = 0xC0|(4<<3)|5 = 0xE5 = 229
    let m = enc(5 as u8, 4 as u8, b)
    putchar(('0' as i32) + ((m as i32) / 100))
    putchar(('0' as i32) + (((m as i32) / 10) % 10))
    putchar(('0' as i32) + ((m as i32) % 10))
    putchar(10 as i32); fflush(null as ptr[void])
    return 0
