// Regression repro for std.numtheory + BUG#47 (unsigned %/÷ in loop clobber).
// Self-contained (own helpers). Expect exit 127.

fn nt_gcd(a: u64, b: u64) -> u64:
    mut x := a
    mut y := b
    while y != 0 as u64:
        let t = x % y
        x = y
        y = t
    return x

fn nt_lcm(a: u64, b: u64) -> u64:
    let g = nt_gcd(a, b)
    return (a / g) * b

fn nt_is_prime(n: u64) -> bool:
    if n < 2 as u64:
        return false
    if n < 4 as u64:
        return true
    if n % (2 as u64) == 0 as u64:
        return false
    mut i := 3 as u64
    while i * i <= n:
        if n % i == 0 as u64:
            return false
        i = i + (2 as u64)
    return true

fn nt_next_prime(n: u64) -> u64:
    mut c := n + (1 as u64)
    while nt_is_prime(c) == false:
        c = c + (1 as u64)
    return c

fn nt_mod_exp(base: u64, exp: u64, m: u64) -> u64:
    if m == 1 as u64:
        return 0 as u64
    mut result := 1 as u64
    mut b := base % m
    mut e := exp
    while e > 0 as u64:
        if e % (2 as u64) == 1 as u64:
            result = (result * b) % m
        e = e / (2 as u64)
        b = (b * b) % m
    return result

fn nt_totient(n: u64) -> u64:
    mut result := n
    mut nn := n
    mut p := 2 as u64
    while p * p <= nn:
        if nn % p == 0 as u64:
            while nn % p == 0 as u64:
                nn = nn / p
            result = result - (result / p)
        p = p + (1 as u64)
    if nn > 1 as u64:
        result = result - (result / nn)
    return result

fn nt_divisor_count(n: u64) -> u64:
    mut cnt := 0 as u64
    mut i := 1 as u64
    while i * i <= n:
        if n % i == 0 as u64:
            if i * i == n:
                cnt = cnt + (1 as u64)
            else:
                cnt = cnt + (2 as u64)
        i = i + (1 as u64)
    return cnt

pub fn main() -> i32:
    mut s := 0 as i32
    if nt_gcd(48 as u64, 36 as u64) == 12 as u64:
        s = s + 1
    if nt_lcm(4 as u64, 6 as u64) == 12 as u64:
        s = s + 2
    // BUG#47 guard: 91 and 25 are composite but need >1 loop iteration
    if nt_is_prime(97 as u64) and (nt_is_prime(91 as u64) == false) and (nt_is_prime(25 as u64) == false):
        s = s + 4
    if nt_next_prime(89 as u64) == 97 as u64:
        s = s + 8
    if nt_mod_exp(2 as u64, 10 as u64, 1000 as u64) == 24 as u64:
        s = s + 16
    if nt_totient(36 as u64) == 12 as u64:
        s = s + 32
    if nt_divisor_count(28 as u64) == 6 as u64:
        s = s + 64
    return s   // expect 127
