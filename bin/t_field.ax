// Verify GET_FIELD sign/zero extension correctness
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32
fn zpn(tag: i64, v: i64):
    putchar(tag as i32); putchar('=' as i32)
    mut x := v
    if x < 0 as i64:
        putchar('-' as i32); x = 0 as i64 - x
    if x == 0 as i64:
        putchar('0' as i32)
    mut b := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        b[n] = ('0' as u8) + (x % 10 as i64) as u8; n = n + 1 as i64; x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        putchar(b[j] as i32); j = j - 1 as i64
    putchar(' ' as i32); fflush(null as ptr[void])

struct S:
    a: i32      // signed: -1 must read as -1
    b: u32      // unsigned: 0xFFFFFFFF must read as 4294967295
    c: i16      // signed: -1 must read as -1

pub fn main() -> i32:
    mut s := S(a: -1 as i32, b: 4294967295 as u32, c: -1 as i16)
    zpn('A' as i64, s.a as i64)     // expect -1
    zpn('B' as i64, s.b as i64)     // expect 4294967295
    zpn('C' as i64, s.c as i64)     // expect -1
    mut eq := 0 as i64
    if s.a == -1 as i32:
        eq = 1 as i64
    zpn('Q' as i64, eq)            // expect 1
    putchar(10 as i32); fflush(null as ptr[void])
    return 0
