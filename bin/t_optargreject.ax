// Oracle: an Option value passed where a plain scalar is expected (forgot .unwrap()) must be
// REJECTED (was accept-then-miscompile: the 8-byte box read raw as i64 returned garbage).
// See knowledge/bug-option-as-call-arg-not-rejected.md. Reject-path test.
fn f(x: i64) -> i64:
    return x + 1
fn main() -> i64:
    let o: Option[i64] = Some(41)
    return f(o)
