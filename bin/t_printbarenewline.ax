// RFC 0038 section 2 rule 5: `println()` with NO arguments is exactly `println("")`.
// Before the AIR desugar the selector picked `ax_println_str` with no argument at all and
// the runtime dereferenced whatever was in RCX -- this program exited 139 (SIGSEGV).
fn main() -> i32:
    print("x")
    println()
    print("y")
    println()
    return 42
