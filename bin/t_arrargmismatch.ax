// Oracle (reject): an unannotated array literal defaults to [i32;3]; passing it to an
// [i64;3] parameter is a genuine element-type mismatch that would silently miscompile the
// callee's OP_INDEX stride (read exit 8, not 40). Must be REJECTED cleanly. Workaround:
// annotate `let a: [i64;3] = ..` or pass the literal directly (which coerces).
fn rd(a: [i64;3]) -> i64:
    return a[0] + a[2]

fn main() -> i64:
    let a = [10, 20, 30]
    return rd(a)
