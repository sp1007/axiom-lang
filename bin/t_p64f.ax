extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn pc(c: i64):
    putchar(c as i32)
    fflush(null as ptr[void])

pub fn main() -> i32:
    mut buf := @alloc(32) as ptr[u8]
    buf[0] = '5' as u8
    buf[1] = '4' as u8
    buf[2] = '3' as u8
    buf[3] = '2' as u8
    buf[4] = '1' as u8
    mut len := 5
    mut i := 0
    while i < len / 2:
        pc('[' as i64)
        pc('0' as i64 + i as i64)         // print i
        pc(':' as i64)
        pc('0' as i64 + len as i64)       // print len (should stay 5)
        let tmp = buf[i]
        buf[i] = buf[len - 1 - i]
        buf[len - 1 - i] = tmp
        pc(']' as i64)
        i = i + 1
    pc('!' as i64)
    return 0
