fn main() -> i64:
    let v = Vec[i64].new()
    v.push(2)
    v.push(4)
    v.push(7)
    v.push(8)
    v.push(10)
    // drop leading evens [2,4], keep [7,8,10] → sum 25, len 3
    let w = v.skip_while(|x: i64| -> bool x % 2 == 0)
    let s = w.fold(0 as i64, |acc: i64, x: i64| -> i64 acc + x)
    if w.len == 3:
        return s
    return 0
