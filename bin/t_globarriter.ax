// Oracle (exit=119): RFC 0017 P2 — for-in over an array global, plus an element
// write between the two passes.
mut g: [i64; 4] = [1, 2, 3, 4]
fn main() -> i32:
    mut t: i64 = 0
    for x in g:
        t = t + x            // +10
    g[0] = 100
    for x in g:
        t = t + x            // +109
    return t as i32          // 119
