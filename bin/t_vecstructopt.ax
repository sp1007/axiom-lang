// Vec of a struct that has an Option field; for-in + match the field.
import std.collections
struct Item:
    id: i64
    tag: Option[i64]
fn main() -> i64:
    mut v = Vec[Item].new()
    v.push(Item(id: 10, tag: Some(30)))
    v.push(Item(id: 2, tag: None))
    mut t: i64 = 0
    for it in v:
        t = t + it.id
        match it.tag:
            Some(x):
                t = t + x
            None:
                t = t + 0
    return t
