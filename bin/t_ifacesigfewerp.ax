// RFC 0029 signature-conformance reject oracle. See knowledge/bug-iface-conformance-signature-not-checked.md
interface Scaler:
    fn scale(self: Self, f: i64) -> i64
struct Sq:
    side: i64
    fn scale(self: Sq) -> i64:
        return self.side
fn main() -> i64:
    let s: Scaler = Sq(side: 3)
    return 0
