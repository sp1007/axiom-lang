// t_intlitfloatctx.ax — an INTEGER literal adopted into a FLOAT type (RFC 0005 /
// RFC 0006) must hold its numeric value everywhere.
//
// It did not. air_builder's lower_int_lit read the adopted type_id (9=f32, 10=f64)
// and still emitted OP_ICONST with it, so the constant was materialized as `mov imm`
// into a GPR-classed vreg while the float ops read the aliasing XMM: `let a: f64 = 3`
// evaluated to exactly 0.0 (or a stale float). Accepted by typecheck, wrong at
// runtime, invisible to every gate — BUG#53 class, and broad: let / assign / field /
// element / arg / return / cast / arithmetic / compare were ALL affected.
//
// Rules this oracle obeys (learned the hard way):
//   * every comparison is INLINE against a literal — never route the value under test
//     through a parameter of the same float type, because the arg site coerces it and
//     hides the defect. Row 10 tests the arg path itself; there the check lives in
//     the callee.
//   * one DISTINCT small exit code per row, so a failure names the row.
//   * every expected value < 256 (exit codes are masked to 8 bits).
//   * 42 == every row correct.
//
// DELIBERATELY ABSENT (a DIFFERENT root cause, still OPEN — do not add here until it
// is fixed; the row numbers 4, 8, 9, 11 are reserved for them):
//   4  `H(a: 3)` into an f64 struct field    -> probe bin/probe4/i1.ax (f32 twin: i2.ax)
//   8  `let c: f64 = 3 + 1` (int EXPR)       -> probe bin/probe4/g5.ax bit 64
//   9  `argf(3)` into an f64 fn param        -> probe bin/probe4/h4.ax
//   11 `mm.m(3)` into an f64 method param    -> probe bin/probe4/g6.ax bit 1
// In all four the literal's node type is still an INTEGER (measured: `%2: t3 = iconst
// %3` feeding an f64 setfld), i.e. typecheck never hinted the float type at that
// position, so there is no float constant for air_builder to materialize. The f32
// twins pass because typecheck.ax:5208 hints F32 there and was "scoped to F32 only".
// Fixing it means propagating the hint / inserting a coercion at those POSITIONS —
// the open follow-up in knowledge/bugs.md (int VARIABLE/EXPR -> float at
// let/assign/arg), not a literal-materialization change.
struct H:
    a: f64
    b: f32
mut gd: f64 = 3
fn retf() -> f64:
    return 3
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
fn argf32(a: f32) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0

fn main() -> i64:
    // 1: annotated let, f64
    let a: f64 = 3
    if a < 2.99 or a > 3.01:
        return 1
    // 2: annotated let, f32
    let e: f32 = 3
    if e < 2.99 or e > 3.01:
        return 2
    // 3: assignment to a mut f64
    mut b: f64 = 0.0
    b = 3
    if b < 2.99 or b > 3.01:
        return 3
    // 5: struct field initializer, f32 (the f64 twin is row 4 — see header)
    let h = H(a: 3.0, b: 3)
    if h.b < 2.99 or h.b > 3.01:
        return 5
    // 6: module-level global initializer
    if gd < 2.99 or gd > 3.01:
        return 6
    // 7: return position of a float-returning fn
    let r = retf()
    if r < 2.99 or r > 3.01:
        return 7
    // 10: parameter position, f32 (checked inside the callee; f64 twins are rows
    //     9 and 11 — see header)
    if argf32(3) != 1:
        return 10
    // 12/13: array literal elements
    mut arr: [f64; 2] = [3, 4]
    if arr[0] < 2.99 or arr[0] > 3.01:
        return 12
    if arr[1] < 3.99 or arr[1] > 4.01:
        return 13
    // 14: element ASSIGNED an int literal
    arr[0] = 5
    if arr[0] < 4.99 or arr[0] > 5.01:
        return 14
    // 15: explicit cast of an int literal (the once-"documented workaround",
    //     which was equally broken — the cast is a no-op over the same constant)
    let w: f64 = 3 as f64
    if w < 2.99 or w > 3.01:
        return 15
    // 16: float variable + int literal
    let ctl: f64 = 3.0
    let f = ctl + 3
    if f < 5.99 or f > 6.01:
        return 16
    // 17: int literal / float literal
    let g = 3 / 2.0
    if g < 1.49 or g > 1.51:
        return 17
    // 18: comparison of a float against an int literal
    mut ok18 := 0 as i64
    if ctl > 2:
        ok18 = 1
    if ok18 != 1:
        return 18
    // 19/20: CONTROL — float literals in the same positions must still work
    if argf(3.0) != 1:
        return 19
    if argf32(3.0) != 1:
        return 20
    // 21/22: GUARD — plain integer literals must be untouched by the float clause
    let i32v: i32 = 3
    if i32v != 3:
        return 21
    let i64v: i64 = 200
    if i64v != 200:
        return 22
    // 23: GUARD — a genuine (negative, fractional) float literal is unchanged
    let neg: f64 = 0.0 - 2.5
    if neg > (0.0 - 2.49) or neg < (0.0 - 2.51):
        return 23
    return 42
