// t_intlitfloatctx.ax — an INTEGER literal adopted into a FLOAT type (RFC 0005 /
// RFC 0006) must hold its numeric value everywhere.
//
// It did not. air_builder's lower_int_lit read the adopted type_id (9=f32, 10=f64)
// and still emitted OP_ICONST with it, so the constant was materialized as `mov imm`
// into a GPR-classed vreg while the float ops read the aliasing XMM: `let a: f64 = 3`
// evaluated to exactly 0.0 (or a stale float). Accepted by typecheck, wrong at
// runtime, invisible to every gate — BUG#53 class, and broad: let / assign / field /
// element / arg / return / cast / arithmetic / compare were ALL affected.
//
// Rules this oracle obeys (learned the hard way):
//   * every comparison is INLINE against a literal — never route the value under test
//     through a parameter of the same float type, because the arg site coerces it and
//     hides the defect. Row 10 tests the arg path itself; there the check lives in
//     the callee.
//   * one DISTINCT small exit code per row, so a failure names the row.
//   * every expected value < 256 (exit codes are masked to 8 bits).
//   * 42 == every row correct.
//
// ROWS 4 / 8 / 9 / 11 (2026-07-31) had a SECOND, different root cause and were held back
// until it was fixed. There the literal's node type stayed an INTEGER (measured: `%2: t3
// = iconst %3` feeding an f64 setfld) because typecheck only ever hinted the float type
// for f32 — so there was no float constant for air_builder to materialize, and the raw
// integer register was handed to the float slot. The same hole covered int VARIABLES and
// int EXPRESSIONS, which a typecheck hint can never fix (an ident's storage is already
// built). Fix: `air_builder.coerce_int_to_float` — RFC 0006 §4's int->float widening
// emitted as a real OP_ITOF, at EVERY value site, exactly like coerce_struct_to_interface.
// Rows 24-32 below cover the non-literal half (int VARIABLE / int expression), which the
// previous round could not have fixed at all. Calibrated: this file exits 4 on the
// compiler before that change and 42 after, at -O0, -O1 AND -O2.
struct H:
    a: f64
    b: f32
struct Mixed:
    f: f64
    n: i64
mut gd: f64 = 3
fn retf() -> f64:
    return 3
fn retf_var() -> f64:
    let n: i64 = 7
    return n
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
fn argf32(a: f32) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
fn takes_f64(x: f64) -> i64:
    if x > 8.99 and x < 9.01:
        return 1
    return 0
fn takes_f64_var(x: f64) -> i64:
    if x > 5.99 and x < 6.01:
        return 1
    return 0
struct MM:
    k: i64
    // Distinct expected value per callee, so a row cannot pass because an earlier
    // float compare happened to leave the right value in an XMM register.
    fn m(self: MM, a: f64) -> i64:
        if a > 12.99 and a < 13.01:
            return 1
        return 0

fn main() -> i64:
    // 1: annotated let, f64
    let a: f64 = 3
    if a < 2.99 or a > 3.01:
        return 1
    // 2: annotated let, f32
    let e: f32 = 3
    if e < 2.99 or e > 3.01:
        return 2
    // 3: assignment to a mut f64
    mut b: f64 = 0.0
    b = 3
    if b < 2.99 or b > 3.01:
        return 3
    // 4: struct field initializer, f64 — an INT LITERAL into an `a: f64` field. The
    //    f32 twin (row 5) always worked; only f64 was hinted-less and stored raw.
    let h4 = H(a: 6, b: 0.5)
    if h4.a < 5.99 or h4.a > 6.01:
        return 4
    // 5: struct field initializer, f32
    let h = H(a: 3.0, b: 3)
    if h.b < 2.99 or h.b > 3.01:
        return 5
    // 6: module-level global initializer
    if gd < 2.99 or gd > 3.01:
        return 6
    // 7: return position of a float-returning fn
    let r = retf()
    if r < 2.99 or r > 3.01:
        return 7
    // 8: a folded int EXPRESSION at an f64 target (not a bare literal)
    let c8: f64 = 3 + 1
    if c8 < 3.99 or c8 > 4.01:
        return 8
    // 9: parameter position, f64 — an int literal at an f64 free-fn param. Checked
    //    INSIDE the callee: comparing here would route the value through a second
    //    f64 parameter and coerce it, hiding the very defect under test.
    if takes_f64(9) != 1:
        return 9
    // 10: parameter position, f32 (checked inside the callee)
    if argf32(3) != 1:
        return 10
    // 11: parameter position, f64 METHOD — a separate lowering path from row 9
    //     (the receiver occupies param slot 0).
    let mm = MM(k: 0)
    if mm.m(13) != 1:
        return 11
    // 12/13: array literal elements
    mut arr: [f64; 2] = [3, 4]
    if arr[0] < 2.99 or arr[0] > 3.01:
        return 12
    if arr[1] < 3.99 or arr[1] > 4.01:
        return 13
    // 14: element ASSIGNED an int literal
    arr[0] = 5
    if arr[0] < 4.99 or arr[0] > 5.01:
        return 14
    // 15: explicit cast of an int literal (the once-"documented workaround",
    //     which was equally broken — the cast is a no-op over the same constant)
    let w: f64 = 3 as f64
    if w < 2.99 or w > 3.01:
        return 15
    // 16: float variable + int literal
    let ctl: f64 = 3.0
    let f = ctl + 3
    if f < 5.99 or f > 6.01:
        return 16
    // 17: int literal / float literal
    let g = 3 / 2.0
    if g < 1.49 or g > 1.51:
        return 17
    // 18: comparison of a float against an int literal
    mut ok18 := 0 as i64
    if ctl > 2:
        ok18 = 1
    if ok18 != 1:
        return 18
    // 19/20: CONTROL — float literals in the same positions must still work
    if argf(3.0) != 1:
        return 19
    if argf32(3.0) != 1:
        return 20
    // 21/22: GUARD — plain integer literals must be untouched by the float clause
    let i32v: i32 = 3
    if i32v != 3:
        return 21
    let i64v: i64 = 200
    if i64v != 200:
        return 22
    // 23: GUARD — a genuine (negative, fractional) float literal is unchanged
    let neg: f64 = 0.0 - 2.5
    if neg > (0.0 - 2.49) or neg < (0.0 - 2.51):
        return 23

    // ---- 24..31: the NON-LITERAL half of RFC 0006 §4's int->float row. A typecheck
    // hint cannot reach these: an ident's storage is already built at its own width, so
    // the conversion has to be a real OP_ITOF at the value site. Each row uses its own
    // value so it cannot pass on a stale XMM.
    let n17: i64 = 17
    // 24: annotated let taking an int VARIABLE
    let v24: f64 = n17
    if v24 < 16.99 or v24 > 17.01:
        return 24
    // 25: assignment of an int VARIABLE to a mut f64
    let n19: i64 = 19
    mut v25: f64 = 0.0
    v25 = n19
    if v25 < 18.99 or v25 > 19.01:
        return 25
    // 26: int VARIABLE as an f64 argument (checked inside the callee)
    let n6: i64 = 6
    if takes_f64_var(n6) != 1:
        return 26
    // 27: an f64 field taking an int literal in a MIXED struct — the neighbouring
    //     i64 field must be untouched (fields are assigned POSITIONALLY, BUG#21)
    let mx = Mixed(f: 5, n: 7)
    if mx.f < 4.99 or mx.f > 5.01:
        return 27
    if mx.n != 7:
        return 28
    // 29: an int-VARIABLE expression at an f64 target
    let n20: i64 = 20
    let v29: f64 = n20 + 1
    if v29 < 20.99 or v29 > 21.01:
        return 29
    // 30: `return <int variable>` from a fn declared `-> f64`
    let r30 = retf_var()
    if r30 < 6.99 or r30 > 7.01:
        return 30
    // 31: array element ASSIGNED an int variable
    let n23: i64 = 23
    mut arr31: [f64; 2] = [1.0, 2.0]
    arr31[1] = n23
    if arr31[1] < 22.99 or arr31[1] > 23.01:
        return 31
    // 32: an f64 METHOD param taking an int VARIABLE
    let n13: i64 = 13
    if mm.m(n13) != 1:
        return 32
    return 42
