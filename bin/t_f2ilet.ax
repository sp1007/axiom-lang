// RFC 0006 §4/§6.2 (E3031): a FLOAT value written where the programmer ANNOTATED an
// INTEGER type must be REJECTED. Before the reject this compiled and `a` held the raw
// IEEE bit pattern of 3.0 (0x4008000000000000 = 4611686018427387904), so `a > 4000000000`
// was TRUE -- an `i64` holding a float, with no diagnostic at all (bin/probe4/g13.ax).
// `3.0 as i64` is the spelling for "I intend to truncate" (guarded by t_f2iok).
fn main() -> i64:
    let a: i64 = 3.0
    return a
