extern "C" fn puts(s: ptr[u8]) -> i32

fn test_open() -> i32:
    let r = check_val(42)
    if r.is_ok():
        return 0
    else:
        return 1

fn check_val(x: i64) -> Result[i64, str]:
    if x > 0:
        return Ok(x)
    else:
        return Err("negative")

pub fn main() -> i32:
    return test_open()
