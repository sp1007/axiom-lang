// p2: int VARIABLE -> float at let / assign / arg (g7.ax shape).
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0

fn main() -> i64:
    mut bits := 0 as i64
    let n: i64 = 3
    // 1: let with an int variable at an f64 target
    let a: f64 = n
    if a < 2.99 or a > 3.01:
        bits = bits + 1
    // 2: assignment of an int variable to a mut f64
    mut b: f64 = 0.0
    b = n
    if b < 2.99 or b > 3.01:
        bits = bits + 2
    // 4: int variable as an f64 argument
    if argf(n) != 1:
        bits = bits + 4
    return bits
