// KNOWN-FAIL repro (SEGFAULT), NOT a regression oracle -- do not add it to
// regression_repros.sh until the bug below is fixed.
//
// BUG: a concrete struct placed into an INTERFACE-typed VARIANT PAYLOAD is stored
// raw, with no vtable box built. The later method call dispatches on struct bytes
// as if they were a box pointer, so it jumps through a wild pointer.
//
// Build and run: expect 9, get SIGSEGV (exit 139).
//
//   axc build bin/known_fail_iface_variant_payload.ax -o /tmp/t.exe -O1 && /tmp/t.exe
//
// SCOPE (narrowed 2026-07-23) -- only the Option/Result constructors still fail:
//     Option[Shape] = Some(Sq(..))            SEGV  <-- this file
//     Result[Shape, i64] = Ok(Sq(..))         SEGV
//     fn take(o: Option[Shape]); take(Some(Sq(..)))   SEGV
//
// FIXED and now covered by regression oracles (do NOT expect these to fail):
//     user sum   Wrap = Box(Sq(..))           FIXED 0E1D6F31  (t_ifacesumpayload)
//     tuple      (Shape, i64) = (Sq(..), 7)   FIXED 909e9e5   (t_ifacetuple)
//
// Always FINE (never needed the fix):
//     Vec[Shape] + v.push(Sq(..)) ; struct field s: Shape ; let s: Shape = Sq(..)
//
// WORKAROUND for the remaining Option/Result case: coerce through a typed local.
//     let s: Shape = Sq(side: 3)
//     let o: Option[Shape] = Some(s)          // works, returns 9
//
// WHY Option/Result is the leftover: user sums lower through
// lower_variant_construct, which has the declared payload type from
// find_variant_info; Some/Ok lower through lower_call_expr, which does not, and
// needs the declared Option[Shape] threaded to the ctor. Neither the OOM nor the
// "ordering conflict" once feared still applies (cap raised; conflict disproven).
// See knowledge/bug-iface-variant-payload-no-vtable-box.md.

interface Shape:
    fn area(self: Self) -> i64

struct Sq:
    side: i64
    fn area(self: Sq) -> i64:
        return self.side * self.side

fn main() -> i64:
    let o: Option[Shape] = Some(Sq(side: 3))
    if o.is_some():
        return o.unwrap().area()
    return -1 as i64
