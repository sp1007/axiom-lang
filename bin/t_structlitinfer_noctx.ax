// RFC 0039 §2.3 — a parenthesized named-field list with NO expected type has nothing to
// infer from, and must be REJECTED with error[E3034], not accepted and pointed at some
// arbitrary struct. Phase 1 supplies an expected type ONLY from an annotated `let`/`mut`;
// `let e = ...` has no annotation, so the literal's type is genuinely unknown here.
// This is a `reject|` row: it pins the E-code and the fact that the build HALTS.
struct TmpStruct:
    a: i64
    b: f64

fn main() -> i32:
    let e = (a: 64, b: 64)
    return 0
