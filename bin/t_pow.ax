// RFC 0006 #38.3 — `**` exponentiation repro.
// Exercises: constant int exponent (unroll), exponent 0 and 1 special cases,
// variable int exponent (runtime loop), and float base ** int exponent.
// Expected exit code: 59.
fn main() -> i32:
    let a = 2 ** 10        // 1024 (constant unroll)
    let b = 5 ** 0         // 1    (exponent 0)
    let c = 7 ** 1         // 7    (exponent 1)
    mut n := 5 as i32
    let d = 3 ** n         // 243  (variable exponent -> loop)
    let f = 2.0 ** 3       // 8.0  (float base, int exponent)
    let fi = f as i32      // 8
    let total = (a / 64) + b + c + (d / 9) + fi  // 16 + 1 + 7 + 27 + 8 = 59
    return total
