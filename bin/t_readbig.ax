import std.io
import std.result
import std.string

pub fn main() -> i32:
    let r = std.io.open("bootstrap/stage1/tmp_concatenated_air.ax")
    if not r.is_ok():
        return 200
    let f = r.unwrap()
    let r2 = f.read_all()
    if not r2.is_ok():
        return 201
    let content = r2.unwrap()
    // full file ~1105851 bytes -> expect ~1105
    return (std.string.len(content) / 1000 as i64) as i32
