// Oracle (reject mode): a generic type param that NO argument can determine (`A`
// is supplied only by a bare `None`) in a CONCRETE calling context must REJECT
// cleanly, not silently segfault. Add explicit type args / annotate to fix.
fn combine[A, B](a: Option[A], b: Option[B]) -> i64:
    match b:
        Some(y):
            return y
        None:
            return 0
fn main() -> i64:
    return combine(None, Some(42))
