// next-step-14 acceptance: mutable str reassignment must not write through .rdata.
// Discriminating: "hi"(2) -> "worldwide"(9). exit=9 proves reassignment took; 2=stale.
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32
fn puts_ax(s: str):
    mut i := 0 as i64
    while i < s.len:
        putchar(s.ptr[i] as i32)
        i = i + 1 as i64
    putchar(10 as i32)
    fflush(null as ptr[void])
pub fn main() -> i32:
    mut s := "hi"
    puts_ax(s)            // hi
    s = "worldwide"       // reassign (next-step-14 crash trigger)
    puts_ax(s)            // worldwide
    return s.len as i32   // 9
