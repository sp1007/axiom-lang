// Oracle (exit=5): struct with a `str` field; concatenate into the field and
// read its byte length back. Crosses aggregate field x str concat x .len.
struct Rec:
    name: str
    n: i64
fn main() -> i32:
    mut r := Rec(name: "ab", n: 0)
    r.name = r.name + "cde"
    return r.name.len as i32   // "abcde" = 5
