fn ip_clamp01(x: f64) -> f64:
    if x < 0.0:
        return 0.0
    if x > 1.0:
        return 1.0
    return x

fn ip_unlerp(a: f64, b: f64, v: f64) -> f64:
    if b == a:
        return 0.0
    return (v - a) / (b - a)

fn ip_remap(a1: f64, b1: f64, a2: f64, b2: f64, v: f64) -> f64:
    let t = (v - a1) / (b1 - a1)
    return a2 + (b2 - a2) * t

fn ip_smootherstep(e0: f64, e1: f64, x: f64) -> f64:
    mut t := (x - e0) / (e1 - e0)
    t = ip_clamp01(t)
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

fn ip_catmull_rom(p0: f64, p1: f64, p2: f64, p3: f64, t: f64) -> f64:
    let t2 = t * t
    let t3 = t2 * t
    let a = 2.0 * p1
    let b = (0.0 - p0 + p2) * t
    let c = (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2
    let d = (0.0 - p0 + 3.0 * p1 - 3.0 * p2 + p3) * t3
    return 0.5 * (a + b + c + d)

fn ip_bezier3(p0: f64, p1: f64, p2: f64, p3: f64, t: f64) -> f64:
    let u = 1.0 - t
    let u2 = u * u
    let t2 = t * t
    return u2 * u * p0 + 3.0 * u2 * t * p1 + 3.0 * u * t2 * p2 + t2 * t * p3

fn ip_bilerp(c00: f64, c10: f64, c01: f64, c11: f64, tx: f64, ty: f64) -> f64:
    let x0 = c00 + (c10 - c00) * tx
    let x1 = c01 + (c11 - c01) * tx
    return x0 + (x1 - x0) * ty

fn ip_ease_inout_quad(t: f64) -> f64:
    if t < 0.5:
        return 2.0 * t * t
    let u = 0.0 - 2.0 * t + 2.0
    return 1.0 - u * u / 2.0

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.00001

pub fn main() -> i32:
    mut s := 0 as i32
    if near(ip_clamp01(1.5), 1.0):
        s = s + 1
    if near(ip_unlerp(10.0, 20.0, 15.0), 0.5):
        s = s + 2
    if near(ip_remap(0.0, 10.0, 0.0, 100.0, 5.0), 50.0):
        s = s + 4
    if near(ip_smootherstep(0.0, 1.0, 0.5), 0.5):
        s = s + 8
    if near(ip_catmull_rom(0.0, 0.0, 1.0, 1.0, 0.5), 0.5):
        s = s + 16
    if near(ip_bezier3(0.0, 0.0, 1.0, 1.0, 0.5), 0.5) and near(ip_bilerp(0.0, 1.0, 2.0, 3.0, 0.5, 0.5), 1.5):
        s = s + 32
    if near(ip_ease_inout_quad(0.5), 0.5):
        s = s + 64
    return s   // expect 127
