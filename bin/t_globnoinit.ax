// Oracle (exit=7): a module-level scalar global declared WITHOUT an initializer
// defaults to a zeroed .data slot (RFC 0017). Parser fix: the no-initializer form
// `mut g: i64` used to desync ("expected newline") because the newline-skipping
// initializer probe consumed the terminating newline.
mut g: i64
fn main() -> i32:
    g = g + 7      // 0 + 7
    return g as i32
