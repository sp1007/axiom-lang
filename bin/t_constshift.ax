// Oracle (exit 35): `const << const` / `const >> const` were miscompiled at -O1
// (folded to 0 -> garbage) and crashed codegen on some `>>`. Now correct at both
// levels (the buggy fold is disabled; shifts lower at runtime).
fn main() -> i32:
    let a = 5 << 1      // 10
    let b = 100 >> 2    // 25
    return (a + b) as i32
