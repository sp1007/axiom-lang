fn main() -> i64:
    let v = Vec[i64].new()
    v.push(2)
    v.push(4)
    v.push(6)
    v.push(7)
    v.push(8)
    // leading run of even numbers: [2,4,6] → sum 12, plus first taken element
    let w = v.take_while(|x: i64| -> bool x % 2 == 0)
    let s = w.fold(0 as i64, |acc: i64, x: i64| -> i64 acc + x)
    // 2+4+6 = 12, len should be 3
    if w.len == 3:
        return s
    return 0
