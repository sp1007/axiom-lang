const SQRT2: f64 = 1.4142135623730951

fn expf(x: f64) -> f64:
    mut term := 1.0
    mut sum := 1.0
    mut n := 1 as i32
    while n < 60:
        term = term * x / (n as f64)
        sum = sum + term
        n = n + 1
    return sum

fn lnf(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut y := (x - 1.0) / (x + 1.0)
    let y2 = y * y
    mut term := y
    mut sum := y
    mut k := 1 as i32
    while k < 80:
        let d = (2 * k + 1) as f64
        term = term * y2
        sum = sum + term / d
        k = k + 1
    return 2.0 * sum

fn erff(x: f64) -> f64:
    mut sign := 1.0
    mut xx := x
    if xx < 0.0:
        sign = 0.0 - 1.0
        xx = 0.0 - xx
    let t = 1.0 / (1.0 + 0.3275911 * xx)
    let e = expf(0.0 - xx * xx)
    let poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
    return sign * (1.0 - poly * e)

fn ml_gelu(x: f64) -> f64:
    let r = erff(x / SQRT2)
    return 0.5 * x * (1.0 + r)

fn ml_mse(p: ptr[f64], t: ptr[f64], n: i64) -> f64:
    mut acc := 0.0
    mut i := 0 as i64
    while i < n:
        let d = p[i] - t[i]
        acc = acc + d * d
        i = i + 1
    return acc / (n as f64)

fn ml_mae(p: ptr[f64], t: ptr[f64], n: i64) -> f64:
    mut acc := 0.0
    mut i := 0 as i64
    while i < n:
        mut d := p[i] - t[i]
        if d < 0.0:
            d = 0.0 - d
        acc = acc + d
        i = i + 1
    return acc / (n as f64)

fn ml_bce(pred: f64, target: f64) -> f64:
    return 0.0 - target * lnf(pred) - (1.0 - target) * lnf(1.0 - pred)

fn ml_softmax(x: ptr[f64], n: i64, out: ptr[f64]):
    mut mx := x[0]
    mut i := 0 as i64
    while i < n:
        if x[i] > mx:
            mx = x[i]
        i = i + 1
    mut sum := 0.0
    mut k := 0 as i64
    while k < n:
        let e = expf(x[k] - mx)
        out[k] = e
        sum = sum + e
        k = k + 1
    mut j := 0 as i64
    while j < n:
        out[j] = out[j] / sum
        j = j + 1

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.0001

pub fn main() -> i32:
    let p = @alloc(3 * 8 as i64) as ptr[f64]
    p[0] = 1.0
    p[1] = 2.0
    p[2] = 3.0
    let t = @alloc(3 * 8 as i64) as ptr[f64]
    t[0] = 1.5
    t[1] = 2.5
    t[2] = 2.5
    let o = @alloc(3 * 8 as i64) as ptr[f64]
    mut s := 0 as i32
    if near(ml_gelu(1.0), 0.841345) and near(ml_gelu(0.0), 0.0):
        s = s + 1
    if near(ml_gelu(0.0 - 1.0), 0.0 - 0.158655):
        s = s + 2
    if near(ml_mse(p, t, 3 as i64), 0.25):
        s = s + 4
    if near(ml_mae(p, t, 3 as i64), 0.5):
        s = s + 8
    if near(ml_bce(0.9, 1.0), 0.105361):
        s = s + 16
    ml_softmax(p, 3 as i64, o)
    if near(o[0], 0.090031) and near(o[1], 0.244728) and near(o[2], 0.665241):
        s = s + 32
    if near(o[0] + o[1] + o[2], 1.0):
        s = s + 64
    return s   // expect 127
