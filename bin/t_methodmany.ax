// Oracle (reject): a METHOD call with too MANY args was silently accepted
// (the extra arg was dropped) -> now rejected. Twin of the free-fn arity check.
struct Pt:
    x: i64
    fn getx(self) -> i64:
        return self.x
pub fn main() -> i32:
    let p = Pt(x: 7 as i64)
    return p.getx(99 as i64) as i32
