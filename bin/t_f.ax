import std.result

fn ok_i64(x: i64) -> Result[i64, str]:
    if x > 0:
        return Ok(x)
    return Err("neg")

pub fn main() -> i32:
    let r1 = ok_i64(42)
    if not r1.is_ok():
        return 5
    let raw = (&r1) as ptr[u64]
    let boxptr = raw[0] & (0xfffffffffffffffe as u64)
    let v = (boxptr as ptr[i64]).*
    if v != 42:
        return 6
    return 0
