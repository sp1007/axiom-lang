fn main() -> i64:
    mut grid := Vec[Vec[i64]]()
    mut row0 := Vec[i64]()
    row0.push(10)
    row0.push(20)
    mut row1 := Vec[i64]()
    row1.push(5)
    row1.push(7)
    grid.push(row0)
    grid.push(row1)
    mut s := 0
    for r in grid:
        for v in r:
            s = s + v
    return s
