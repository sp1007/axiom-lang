// C: CONCRETE tuple element Vec[(i64,i64)] but inside a GENERIC body. If this
// works, the crash is specifically the generic param T *inside* the Vec element.
fn mk2[T](x: T) -> i64:
    mut out: Vec[(i64, i64)] = Vec.new()
    out.push((99 as i64, 7 as i64))
    return out.len

fn main() -> i64:
    return mk2(3 as i64)     // want 1
