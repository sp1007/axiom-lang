import std.result

pub fn main() -> i32:
    let a: Option[i64] = Some(7 as i64)
    let b: Option[i64] = None
    mut total := 0 as i64
    if a.is_some():
        total = total + a.unwrap()    // 7
    if b.is_none():
        total = total + 3 as i64       // 3
    let r: Result[i64, i64] = Ok(5 as i64)
    if r.is_ok():
        total = total + r.unwrap()     // 5
    return total as i32                 // 15
