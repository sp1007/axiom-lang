// plain sum-type syntax + wildcard + payload-in-body (non-builtin names)
type Box = Wrap(i64) | Empty

fn val(o: Box) -> i64:
    match o:
        Wrap(x):
            return x + 100 as i64
        _:
            return -1 as i64

pub fn main() -> i32:
    let a = val(Wrap(5 as i64))   // 105
    let b = val(Empty)            // -1 (wildcard)
    return (a + b) as i32         // 104
