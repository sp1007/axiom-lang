struct TmpStruct:
  a: i64
  b: f64

fn main() -> i32:
  let c: TmpStruct = (a: 64, b: 64)
  println("Suy diễn từ annotation: ", c.a)
  println("Field f64: ", c.b)
  mut d: TmpStruct := (a: 7, b: 1.5)
  println("Dạng mut: ", d.a)
  let e = TmpStruct(a: 64, b: 64)
  println("Dạng cũ vẫn chạy: ", e.a)
  println("Bằng nhau: ", c.a == e.a)
  return 42
