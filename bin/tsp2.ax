// struct returned, fields read in caller; struct passed through 2 calls
extern "C" fn putchar(c: i32) -> i32
struct P:
    a: i64
    b: i64
fn mk(x: i64, y: i64) -> P:
    return P(a: x, b: y)
fn add1(p: P) -> P:
    return P(a: p.a + 1, b: p.b + 1)
pub fn main() -> i32:
    let q = mk(3 as i64, 4 as i64)
    let r = add1(q)            // 4,5
    return (r.a + r.b) as i32  // expect 9
