// Vec.zip stdlib HOF: element-wise pairs
fn main() -> i64:
    mut a: Vec[i64] = Vec.new()
    a.push(10)
    a.push(20)
    mut b: Vec[i64] = Vec.new()
    b.push(30)
    b.push(2)
    let z = a.zip(b)
    mut acc := 0 as i64
    mut i := 0 as i64
    while i < z.len:
        let p = z.get(i).unwrap()
        acc = acc + p.0 + p.1
        i = i + 1
    return acc
