fn chk(cond: bool, acc: i64) -> i64:
    if cond:
        return acc + 1
    return acc

fn main() -> i64:
    mut ok := 0
    ok = chk(100 / 4 == 25, ok)
    ok = chk(100 % 8 == 4, ok)
    ok = chk(7 / 2 == 3, ok)
    ok = chk(7 % 2 == 1, ok)
    let a := 0 - 7
    ok = chk(a / 2 == 0 - 3, ok)
    ok = chk(a % 2 == 0 - 1, ok)
    let b := 0 - 8
    ok = chk(b / 2 == 0 - 4, ok)
    ok = chk(b % 2 == 0, ok)
    let c := 0 - 100
    ok = chk(c / 16 == 0 - 6, ok)
    ok = chk(c % 16 == 0 - 4, ok)
    ok = chk(1024 / 64 == 16, ok)
    ok = chk(1000 % 64 == 40, ok)
    let u := 250 as u64
    ok = chk(u / 4 == 62, ok)
    ok = chk(u % 8 == 2, ok)
    ok = chk(100 / 3 == 33, ok)
    ok = chk(100 % 7 == 2, ok)
    return ok
