// G6: remaining positions -- fn arg, method arg, array element, int VARIABLE -> f64.
struct M:
    k: i64
    fn m(self: M, a: f64) -> i64:
        if a > 2.99 and a < 3.01:
            return 1
        return 0
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
fn argf32(a: f32) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0

fn main() -> i64:
    mut m: i64 = 0
    // 1: free-fn f64 param from an int literal
    if argf(3) == 1:
        m = m + 1
    // 2: free-fn f32 param from an int literal
    if argf32(3) == 1:
        m = m + 2
    // 3: static method f64 param
    let mm = M(k: 0)
    if mm.m(3) == 1:
        m = m + 4
    // 4: array element from an int literal
    mut arr: [f64; 2] = [3, 4]
    if arr[0] > 2.99 and arr[0] < 3.01:
        m = m + 8
    if arr[1] > 3.99 and arr[1] < 4.01:
        m = m + 16
    // 5: element ASSIGNED an int literal
    arr[0] = 5
    if arr[0] > 4.99 and arr[0] < 5.01:
        m = m + 32
    // 6: control -- float literals in the same positions
    if argf(3.0) == 1:
        m = m + 64
    if argf32(3.0) == 1:
        m = m + 128
    return m       // 255 => all correct
