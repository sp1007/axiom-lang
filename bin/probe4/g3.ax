// G3: same question for a free-function f64 parameter fed an int literal.
fn probe(a: f64) -> i64:
    mut code: i64 = 0
    if a > 2.99 and a < 3.01:
        code = code + 1
    if (a as i64) == 3:
        code = code + 2
    if (a as i64) == 0:
        code = code + 4
    if a == 0.0:
        code = code + 8
    if a > 0.0 and a < 0.000001:
        code = code + 16
    return code
fn main() -> i64:
    return 100 + probe(3)
