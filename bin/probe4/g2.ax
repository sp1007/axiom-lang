// G2: `let a: f64 = 3` -- what is actually in `a`? DIRECT in-program comparisons only,
// no helper call (a helper's f64 param could coerce and hide it).
fn main() -> i64:
    let a: f64 = 3
    mut code: i64 = 0
    if a > 2.99 and a < 3.01:
        code = code + 1        // holds 3.0 (correct)
    if (a as i64) == 3:
        code = code + 2        // reads back as 3
    if (a as i64) == 0:
        code = code + 4        // reads back as 0 (raw int bits => denormal)
    if a == 0.0:
        code = code + 8        // exactly zero
    if a > 0.0 and a < 0.000001:
        code = code + 16       // tiny/denormal => the i64 bit pattern leaked
    return 100 + code
