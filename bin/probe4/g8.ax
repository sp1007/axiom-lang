// G8: verify the two CORRECT rows in isolation (no preceding float traffic that could
// leave a lucky stale value in an XMM register).
fn retf() -> f64:
    return 3
fn main() -> i64:
    let r = retf()
    if r > 2.99 and r < 3.01:
        return 42
    if r == 0.0:
        return 1
    return 2
