// B2: generic FREE functions returning T, at each type class, inferred AND explicit.
fn idf[T](x: T) -> T:
    return x
fn pick[T](a: T, b: T, useA: bool) -> T:
    if useA:
        return a
    return b
fn pair2[A, B](a: A, b: B) -> A:
    return a

fn main() -> i64:
    // control: i64 inferred + explicit
    if idf(7) != 7:
        return 1
    if idf[i64](7) != 7:
        return 2
    // f64 inferred
    let a = idf(2.5)
    if a < 2.49 or a > 2.51:
        return 3
    // f64 explicit
    let b = idf[f64](2.5)
    if b < 2.49 or b > 2.51:
        return 4
    // f32 explicit (the class fixed on 07-30)
    let c = idf[f32](2.5)
    if c < 2.49 or c > 2.51:
        return 5
    // str inferred + explicit
    let d = idf("hi")
    if d != "hi":
        return 6
    let e = idf[str]("hi")
    if e != "hi":
        return 7
    // two-arg generic at float
    let f = pick(1.5, 3.5, true)
    if f < 1.49 or f > 1.51:
        return 8
    let g = pick[f64](1.5, 3.5, false)
    if g < 3.49 or g > 3.51:
        return 9
    let h = pick[f32](1.5, 3.5, true)
    if h < 1.49 or h > 1.51:
        return 10
    let i2 = pick[str]("a", "b", false)
    if i2 != "b":
        return 11
    // mixed type params: return the FIRST when the second is a different class
    let j = pair2(2.5, 7)
    if j < 2.49 or j > 2.51:
        return 12
    let k = pair2(7, 2.5)
    if k != 7:
        return 13
    let l = pair2("s", 2.5)
    if l != "s":
        return 14
    let m = pair2[f32, str](1.5, "z")
    if m < 1.49 or m > 1.51:
        return 15
    return 42
