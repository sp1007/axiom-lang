// E1: user ADT (sum type) with NON-i64 payloads -- f64, f32, str, struct.
// The i64 payload is the only class the suite exercises (t_adt2).
struct Pt:
    x: i64
    y: f64
type V = Fl(f64) | Sm(f32) | Txt(str) | Agg(Pt) | Nil

fn kindf(v: V) -> i64:
    match v:
        Fl(x):
            if x > 2.49 and x < 2.51:
                return 1
            return 91
        Sm(x):
            if x > 1.49 and x < 1.51:
                return 2
            return 92
        Txt(s):
            if s == "abc":
                return 3
            return 93
        Agg(p):
            if p.x == 7 and p.y > 0.49 and p.y < 0.51:
                return 4
            return 94
        Nil:
            return 5

fn mkfl() -> V:
    return Fl(2.5)
fn mktxt() -> V:
    return Txt("abc")

fn main() -> i64:
    // 1: constructed inline, matched in a callee
    if kindf(Fl(2.5)) != 1:
        return 1
    if kindf(Sm(1.5 as f32)) != 2:
        return 2
    if kindf(Txt("abc")) != 3:
        return 3
    if kindf(Agg(Pt(x: 7, y: 0.5))) != 4:
        return 4
    if kindf(Nil) != 5:
        return 5
    // 2: bound to a let first, then matched locally
    let a = Fl(2.5)
    mut hit: i64 = 0
    match a:
        Fl(x):
            if x > 2.49 and x < 2.51:
                hit = 1
        _:
            hit = 9
    if hit != 1:
        return 6
    // 3: returned from a function, then matched
    let b = mkfl()
    if kindf(b) != 1:
        return 7
    let c = mktxt()
    if kindf(c) != 3:
        return 8
    // 4: payload extracted into a let outside the match arm's compare
    mut got: f64 = 0.0
    match b:
        Fl(x):
            got = x
        _:
            got = -1.0
    if got < 2.49 or got > 2.51:
        return 9
    mut gots: str = ""
    match c:
        Txt(s):
            gots = s
        _:
            gots = "no"
    if gots != "abc":
        return 10
    return 42
