// G7: int VARIABLE -> f64 (RFC 0006 says implicit int->float at let/assign/arg/return).
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
fn main() -> i64:
    let n: i64 = 3
    mut m: i64 = 0
    let a: f64 = n
    if a > 2.99 and a < 3.01:
        m = m + 1
    if argf(n) == 1:
        m = m + 2
    mut b: f64 = 0.0
    b = n
    if b > 2.99 and b < 3.01:
        m = m + 4
    return 100 + m      // 107 => all correct
