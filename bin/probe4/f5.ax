// F4: generalize -- through DYNAMIC DISPATCH, is the declared parameter type applied to
// the argument at all? Only classes that need a COERCION can show it:
//   f32 param  <- float literal (default f64)   -> needs narrowing
//   f64 param  <- int literal (default i64)     -> needs int->float
//   i32/u8 param <- int literal                 -> needs narrowing
//   f32 param  <- f64 variable                  -> needs narrowing
// Each impl returns a code describing what it received; mask bit set = row CORRECT.
interface I:
    fn f32lit(self: Self, a: f32) -> i64
    fn f64int(self: Self, a: f64) -> i64
    fn i32lit(self: Self, a: i32) -> i64
    fn u8lit(self: Self, a: u8) -> i64
    fn f32var(self: Self, a: f32) -> i64
    fn f32arith(self: Self, a: f32) -> i64
    fn f32ret(self: Self, a: f32) -> f32

struct S:
    k: i64
    fn f32lit(self: S, a: f32) -> i64:
        if a > 1.49 and a < 1.51:
            return 1
        return 0
    fn f64int(self: S, a: f64) -> i64:
        if a > 2.99 and a < 3.01:
            return 1
        return 0
    fn i32lit(self: S, a: i32) -> i64:
        if (a as i64) == 5:
            return 1
        return 0
    fn u8lit(self: S, a: u8) -> i64:
        if (a as i64) == 200:
            return 1
        return 0
    fn f32var(self: S, a: f32) -> i64:
        if a > 1.49 and a < 1.51:
            return 1
        return 0
    fn f32arith(self: S, a: f32) -> i64:
        if a > 3.99 and a < 4.01:
            return 1
        return 0
    fn f32ret(self: S, a: f32) -> f32:
        return a * 2.0

fn main() -> i64:
    let s = S(k: 0)
    let dv: f64 = 1.5
    // STATIC controls first -- if any of these fail the defect is not dispatch-specific
    mut sm: i64 = 0
    if s.f32lit(1.5) == 1:
        sm = sm + 1
    if s.f64int(3) == 1:
        sm = sm + 2
    if s.i32lit(5) == 1:
        sm = sm + 4
    if s.u8lit(200) == 1:
        sm = sm + 8
    if s.f32var(dv as f32) == 1:
        sm = sm + 16
    if s.f32arith(2.0 + 2.0) == 1:
        sm = sm + 32
    if (s.f32ret(1.5) as i64) == 3:
        sm = sm + 64
    if sm != 125:
        return 128 + sm       // 128..254 => a STATIC row is broken too
    // DYNAMIC rows
    let i: I = S(k: 0)
    mut m: i64 = 0
    if i.f32lit(1.5) == 1:
        m = m + 1
    if i.f64int(3) == 1:
        m = m + 2
    if i.i32lit(5) == 1:
        m = m + 4
    if i.u8lit(200) == 1:
        m = m + 8
    if i.f32var(dv as f32) == 1:
        m = m + 16
    if i.f32arith(2.0 + 2.0) == 1:
        m = m + 32
    if (i.f32ret(1.5) as i64) == 3:
        m = m + 64
    return m                  // 127 => all dynamic rows correct
