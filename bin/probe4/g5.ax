// G5: breadth of "int literal in a float context". DIRECT inline comparisons only.
// Bit set = row CORRECT (holds 3.0). RFC 0006/BUG#35 says every one of these must be 3.0.
struct H:
    a: f64
    b: f32
mut gd: f64 = 3
fn retf() -> f64:
    return 3
fn argf(a: f64) -> i64:
    if a > 2.99 and a < 3.01:
        return 1
    return 0
struct M:
    k: i64
    fn m(self: M, a: f64) -> i64:
        if a > 2.99 and a < 3.01:
            return 1
        return 0

fn main() -> i64:
    mut m: i64 = 0
    // 1: annotated let
    let a: f64 = 3
    if a > 2.99 and a < 3.01:
        m = m + 1
    // 2: assignment to a mut f64
    mut b: f64 = 0.0
    b = 3
    if b > 2.99 and b < 3.01:
        m = m + 2
    // 3: struct field initializer
    let h = H(a: 3, b: 3)
    if h.a > 2.99 and h.a < 3.01:
        m = m + 4
    if h.b > 2.99 and h.b < 3.01:
        m = m + 8
    // 4: global initializer
    if gd > 2.99 and gd < 3.01:
        m = m + 16
    // 5: return position
    let r = retf()
    if r > 2.99 and r < 3.01:
        m = m + 32
    // 6: int-literal arithmetic adopted into f64
    let c: f64 = 3 + 1
    if c > 3.99 and c < 4.01:
        m = m + 64
    // 7: f32 annotated let
    let e: f32 = 3
    if e > 2.99 and e < 3.01:
        m = m + 128
    return m       // 255 => all correct
