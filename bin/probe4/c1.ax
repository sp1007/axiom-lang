// C1: arrays of floats and of structs -- element read/write, loop accumulate,
// pass to fn, return from fn, array field inside a struct.
struct FP:
    x: f64
    y: f32

fn sumarr(a: [f64; 4]) -> f64:
    mut s: f64 = 0.0
    mut i: i64 = 0
    while i < 4:
        s = s + a[i]
        i = i + 1
    return s

fn mkarr() -> [f64; 3]:
    mut a: [f64; 3] = [0.0, 0.0, 0.0]
    a[0] = 1.5
    a[1] = 2.5
    a[2] = 3.5
    return a

fn main() -> i64:
    // 1: f64 array literal + element read, direct compare
    mut a: [f64; 4] = [1.5, 2.5, 3.5, 4.5]
    if a[0] < 1.49 or a[0] > 1.51:
        return 1
    if a[3] < 4.49 or a[3] > 4.51:
        return 2
    // 2: element write then read
    a[1] = 10.5
    if a[1] < 10.49 or a[1] > 10.51:
        return 3
    // 3: loop accumulate (1.5+10.5+3.5+4.5 = 20.0)
    mut s: f64 = 0.0
    mut i: i64 = 0
    while i < 4:
        s = s + a[i]
        i = i + 1
    if s < 19.99 or s > 20.01:
        return 4
    // 4: array passed to a function
    let s2 = sumarr(a)
    if s2 < 19.99 or s2 > 20.01:
        return 5
    // 5: array returned from a function
    let b = mkarr()
    if b[0] < 1.49 or b[0] > 1.51:
        return 6
    if b[2] < 3.49 or b[2] > 3.51:
        return 7
    // 6: f32 array
    mut f: [f32; 3] = [1.5, 2.5, 3.5]
    f[1] = 0.5
    if f[1] < 0.49 or f[1] > 0.51:
        return 8
    mut fs: f32 = 0.0
    mut j: i64 = 0
    while j < 3:
        fs = fs + f[j]
        j = j + 1
    if fs < 5.49 or fs > 5.51:            // 1.5+0.5+3.5 = 5.5
        return 9
    // 7: array of structs with float fields
    mut ps: [FP; 2] = [FP(x: 1.5, y: 2.5), FP(x: 3.5, y: 4.5)]
    if ps[0].x < 1.49 or ps[0].x > 1.51:
        return 10
    if ps[1].y < 4.49 or ps[1].y > 4.51:
        return 11
    ps[0].x = 9.5
    if ps[0].x < 9.49 or ps[0].x > 9.51:
        return 12
    return 42
