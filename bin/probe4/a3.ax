// A3: Option[str] / Result[str, i64] -- payload > 8 bytes class.
fn makes() -> Option[str]:
    return Some("hello")
fn makesr() -> Result[str, i64]:
    return Ok("world")

fn main() -> i64:
    let o = Some("hello")
    let v = o.unwrap()
    if v != "hello":
        return 1
    if len(v) != 5:
        return 2
    let o2 = makes()
    let v2 = o2.unwrap()
    if v2 != "hello":
        return 3
    let r = makesr()
    let rv = r.unwrap()
    if rv != "world":
        return 4
    mut hit: i64 = 0
    match o:
        Some(s):
            if s == "hello":
                hit = 1
        None:
            hit = 9
    if hit != 1:
        return 5
    let cat = v + " " + rv
    if cat != "hello world":
        return 6
    return 42
