// C2: module-level globals x float x aggregate, read-modify-write across functions.
mut gd: f64 = 1.5
mut gf: f32 = 2.5
mut gi: i64 = 7

struct GS:
    a: f64
    b: f32
mut gs: GS = GS(a: 1.0, b: 2.0)
mut ga: [f64; 3] = [1.5, 2.5, 3.5]

fn bumpd():
    gd = gd + 1.0

fn readd() -> f64:
    return gd

fn bumpstruct():
    gs.a = gs.a + 0.5

fn bumparr():
    ga[1] = ga[1] + 1.0

fn main() -> i64:
    // 1: global f64 initial value, direct compare
    if gd < 1.49 or gd > 1.51:
        return 1
    // 2: global f32 initial value
    if gf < 2.49 or gf > 2.51:
        return 2
    // 3: read-modify-write across a call boundary
    bumpd()
    if gd < 2.49 or gd > 2.51:
        return 3
    let v = readd()
    if v < 2.49 or v > 2.51:
        return 4
    // 4: global f32 write then read
    gf = gf + 1.0
    if gf < 3.49 or gf > 3.51:
        return 5
    // 5: global struct with float fields
    if gs.a < 0.99 or gs.a > 1.01:
        return 6
    if gs.b < 1.99 or gs.b > 2.01:
        return 7
    bumpstruct()
    if gs.a < 1.49 or gs.a > 1.51:
        return 8
    // 6: global array of floats
    if ga[0] < 1.49 or ga[0] > 1.51:
        return 9
    bumparr()
    if ga[1] < 3.49 or ga[1] > 3.51:
        return 10
    // 7: control -- global i64 still fine
    gi = gi + 1
    if gi != 8:
        return 11
    // 8: global float feeding arithmetic with a local
    let loc: f64 = 0.5
    let t = gd + loc
    if t < 2.99 or t > 3.01:
        return 12
    return 42
