// Oracle (exit=20): RFC 0017 P2 — struct global field read-modify-write across a for-range loop.
struct Acc:
    sum: i64
    cnt: i64
mut g: Acc = Acc(sum: 0, cnt: 0)
fn main() -> i32:
    for i in 1..6:
        g.sum = g.sum + i
        g.cnt = g.cnt + 1
    return (g.sum + g.cnt) as i32   // (1+2+3+4+5)=15 + 5 = 20
