// RFC 0006 §4 (E3031): assignment to a binding whose type the programmer ANNOTATED.
// Shares the annotation gate with E3030, so an INFERRED `mut x := 0; x = 3.0` is NOT
// covered -- recorded as an out-of-scope item in the RFC, not an oversight.
fn main() -> i64:
    mut x: i32 = 1
    x = 2.5
    return x as i64
