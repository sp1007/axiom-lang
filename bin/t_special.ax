const LN2: f64 = 0.69314718055994530942

fn lnf(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut m := x
    mut e := 0 as i64
    while m >= 2.0:
        m = m * 0.5
        e = e + 1 as i64
    while m < 1.0:
        m = m * 2.0
        e = e - 1 as i64
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    mut term := t
    mut sum := 0.0
    mut n := 0 as i32
    while n < 20:
        sum = sum + term / ((2 * n + 1) as f64)
        term = term * t2
        n = n + 1
    return (e as f64) * LN2 + 2.0 * sum

// digamma psi(x) via recurrence up to >=6 then asymptotic expansion.
fn digamma(x: f64) -> f64:
    mut xx := x
    mut r := 0.0
    while xx < 6.0:
        r = r - 1.0 / xx
        xx = xx + 1.0
    let inv = 1.0 / xx
    let inv2 = inv * inv
    let tail = lnf(xx) - 0.5 * inv - inv2 * (1.0 / 12.0 - inv2 * (1.0 / 120.0 - inv2 / 252.0))
    return r + tail

// Bessel J0 via the ascending power series.
fn bessel_j0(x: f64) -> f64:
    let h2 = x * x * 0.25
    mut term := 1.0
    mut sum := 1.0
    mut m := 1 as i32
    while m < 40:
        term = term * (0.0 - h2) / ((m * m) as f64)
        sum = sum + term
        m = m + 1
    return sum

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.00001

pub fn main() -> i32:
    mut s := 0 as i32
    if near(digamma(1.0), 0.0 - 0.5772157):
        s = s + 1
    if near(digamma(2.0), 0.4227843):
        s = s + 2
    if near(digamma(5.0), 1.5061177):
        s = s + 4
    if near(bessel_j0(0.0), 1.0):
        s = s + 8
    if near(bessel_j0(1.0), 0.7651977):
        s = s + 16
    if near(bessel_j0(2.0), 0.2238908):
        s = s + 32
    if near(bessel_j0(5.0), 0.0 - 0.1775968):
        s = s + 64
    return s   // expect 127
