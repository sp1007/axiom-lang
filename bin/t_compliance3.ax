// ============================================================================
// AXIOM COMPLIANCE SUITE (M4) — part 3: language surface not covered by
// bin/t_compliance.ax (core, 60) or bin/t_compliance2.ax (stdlib/control, 28).
// Together the three reach the M4 gate of 100 compliance tests on the REAL
// shipped grammar.
//
// Chosen to cover shipped features that had NO compliance coverage at all
// (interfaces/vtable dispatch, module globals, defer, enums, multi-field
// variants, Self-chaining, the wider Vec HOF set, Option combinators, f32),
// and where possible to double as a pin on a bug family that has actually
// bitten: f32-vs-float-literal comparison and generic inference through a
// ptr-self parameter were both silent miscompiles.
//
// All real-grammar, builds + runs on the native self-host driver.
// Exit code == number of passing tests (12). Gated as t_compliance3|exit|12.
// ============================================================================
import std.collections

// ---------------- interfaces / dynamic dispatch (RFC 0029) ----------------
interface Shape:
    fn area(self: Self) -> i64

struct Sq:
    s: i64
    fn area(self: Sq) -> i64:
        return self.s * self.s

struct Rect:
    w: i64
    h: i64
    fn area(self: Rect) -> i64:
        return self.w * self.h

fn i01_interface_dispatch() -> i32:
    let a: Shape = Sq(s: 3)
    let b: Shape = Rect(w: 2, h: 5)
    assert(a.area() == 9 and b.area() == 10)
    return 1

fn i02_interface_vec_poly() -> i32:
    mut v: Vec[Shape] = Vec.new()
    v.push(Sq(s: 4))
    v.push(Rect(w: 3, h: 6))
    mut total := 0 as i64
    mut i := 0 as i64
    while i < v.len:
        let sh = v.data[i]
        total = total + sh.area()
        i = i + 1
    assert(total == 34)
    return 1

// ---------------- module-level globals (RFC 0017) ----------------
mut g_counter: i64 = 0
let g_flag: bool = true

fn bump_counter() -> i64:
    g_counter = g_counter + 1
    return g_counter

fn g01_global_scalar_rmw() -> i32:
    let a = bump_counter()
    let b = bump_counter()
    assert(a == 1 and b == 2 and g_counter == 2 and g_flag)
    return 1

// ---------------- defer ----------------
mut g_defer: i64 = 0

fn defer_bump() -> i64:
    g_defer = g_defer + 1
    return 0

fn with_defers() -> i64:
    defer defer_bump()
    defer defer_bump()
    return g_defer

fn d01_defer_lifo() -> i32:
    let seen = with_defers()
    // defers run AFTER the return value is captured, so `seen` is the pre-defer 0
    assert(seen == 0 and g_defer == 2)
    return 1

// ---------------- enums (RFC 0003) ----------------
enum Color:
    Red
    Green
    Blue

fn rank(c: Color) -> i64:
    match c:
        Red:
            return 1
        Green:
            return 2
        Blue:
            return 3
    return 0

fn e01_enum_unit_variants() -> i32:
    assert(rank(Red) == 1 and rank(Green) == 2 and rank(Blue) == 3)
    return 1

// ---------------- multi-field variants (RFC 0019) ----------------
enum Geom:
    Point(i64, i64)
    Scalar(i64)

fn geom_sum(g: Geom) -> i64:
    match g:
        Point(x, y):
            return x + y
        Scalar(v):
            return v
    return 0

fn e02_multifield_variant() -> i32:
    assert(geom_sum(Point(20, 22)) == 42 and geom_sum(Scalar(7)) == 7)
    return 1

// ---------------- Self type + method chaining ----------------
struct Counter:
    n: i64

fn inc(self: Counter) -> Self:
    return Counter(n: self.n + 1)

fn addk(self: Counter, k: i64) -> Self:
    return Counter(n: self.n + k)

fn s01_self_chaining() -> i32:
    let c = Counter(n: 0)
    assert(c.inc().inc().addk(10).inc().n == 13)
    return 1

// ---------------- wider Vec HOF surface ----------------
fn is_big(x: i64) -> bool:
    return x > 10

fn h01_vec_any_all_find() -> i32:
    mut v = Vec[i64].new()
    v.push(4)
    v.push(12)
    v.push(20)
    assert(v.any(is_big) and not v.all(is_big))
    assert(v.count(is_big) == 2)
    return 1

fn h02_vec_reverse_len() -> i32:
    mut v = Vec[i64].new()
    v.push(1)
    v.push(2)
    v.push(3)
    let r = v.reverse()
    assert(r.len == 3 and r[0] == 3 and r[2] == 1)
    return 1

// ---------------- Option combinators ----------------
fn o01_option_some_none() -> i32:
    let a: Option[i64] = Some(41)
    let b: Option[i64] = None
    mut got := 0 as i64
    match a:
        Some(v):
            got = v + 1
        None:
            got = 0
    mut none_seen := 0 as i64
    match b:
        Some(v2):
            none_seen = v2
        None:
            none_seen = 99
    assert(got == 42 and none_seen == 99)
    return 1

// ---------------- f32 (pins the float-literal comparison family) ----------------
fn f01_f32_arith_compare() -> i32:
    let a: f32 = 2.0
    let b = a * 2.0
    // `b == 4.0` compares an f32 against a float LITERAL, which used to be
    // evaluated at mixed precision and take the FALSE branch.
    assert(b == 4.0)
    let c: f32 = 1.5
    assert(c + 0.5 == 2.0)
    return 1

// ---------------- generics through a ptr-self parameter ----------------
struct Hold[T]:
    v: T

fn fetch_held[T](self: ptr[Hold[T]]) -> T:
    return self.v

fn t01_generic_ptr_self() -> i32:
    // T here must bind to i64 through the ptr[Hold[T]] parameter; it used to
    // default to i32 and TRUNCATE a value above 2^32.
    let h = Hold[i64](v: 5000000123)
    assert(fetch_held(h) == 5000000123)
    return 1

// ---------------- entry ----------------
fn main() -> i32:
    mut n := 0
    n = n + i01_interface_dispatch()
    n = n + i02_interface_vec_poly()
    n = n + g01_global_scalar_rmw()
    n = n + d01_defer_lifo()
    n = n + e01_enum_unit_variants()
    n = n + e02_multifield_variant()
    n = n + s01_self_chaining()
    n = n + h01_vec_any_all_find()
    n = n + h02_vec_reverse_len()
    n = n + o01_option_some_none()
    n = n + f01_f32_arith_compare()
    n = n + t01_generic_ptr_self()
    return n
