struct MyVec:
    data: ptr[i32]
    len: i64
    cap: i64

struct Holder:
    pad: i64
    vec: MyVec
    tag: i64

fn new_myvec() -> MyVec:
    return MyVec(data: null as ptr[i32], len: 0, cap: 0)

fn push(mut self: MyVec, val: i32):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap * 4 as i64) as ptr[i32]
        if self.data != null as ptr[i32]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * 4 as i64)
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = val
    self.len = self.len + 1

pub fn main() -> i32:
    let h = @alloc(64) as ptr[Holder]
    h[0] = Holder(pad: 111, vec: new_myvec(), tag: 222)
    mut i := 0 as i64
    while i < 20 as i64:
        h.vec.push(i as i32)
        i = i + 1 as i64
    if h.vec.len != 20 as i64:
        return 100
    if h.pad != 111 as i64 or h.tag != 222 as i64:
        return 101
    return h.vec.data[19] as i32
