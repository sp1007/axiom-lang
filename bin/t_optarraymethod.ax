// Regression: is_some()/unwrap() on an Option read from a fixed array (backend-
// intercepted methods on a real OPTION-typed receiver must not be rejected).
fn main() -> i64:
    let arr: [Option[i64]; 2] = [Some(40), Some(2)]
    let o: Option[i64] = arr[0]
    if o.is_some():
        return o.unwrap()
    return 1
