// Oracle (exit=42): correctly unwrapping before field access must still compile & run
// — guards the "forgot to unwrap" pass against a false-positive on `o.unwrap().field`
// (the field-expr's receiver is the CALL `o.unwrap()`, a Cell value, not the Option).
struct Cell:
    v: i64
pub fn main() -> i32:
    let o: Option[Cell] = Some(Cell(v: 42 as i64))
    return o.unwrap().v as i32
