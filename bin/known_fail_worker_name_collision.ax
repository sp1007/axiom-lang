// KNOWN-FAIL repro (NOT in regression until fixed) — see knowledge/bug-user-fn-stdlib-struct-name-collision.md
// A top-level user function whose name matches a bundled stdlib STRUCT name silently mis-links:
// `worker` collides with `struct worker` in std/scheduler.ax (bundled into every program), so
// main's `call worker` resolves to a different (stdlib) symbol — the user worker is never called.
// Rename to a distinctive name → correct. Expected 105; actual 8 (wrong function ran).
mut g: i64 = 0

fn worker(n: i64) -> i64:
    g = 42 as i64
    return n + 100 as i64

fn main() -> i32:
    let r = worker(5 as i64)   // mis-links to a bundled symbol, not this worker
    return r as i32            // want 105, gets 8
