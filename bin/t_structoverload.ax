// Oracle for [[bug-struct-receiver-overload-symbol-collision]] (hole C).
//
// A struct/sum FIRST parameter makes the backend emit `ax_<Struct>_<fn>`. That name carries
// the RECEIVER, never the SIGNATURE, so two same-named overloads on one receiver emitted the
// SAME symbol: they link-merged and every call reached the body that was DECLARED FIRST.
// Phase 3.5's uniquing scan skipped them because free_fn_bare_mangles reported "no collision
// possible" for any struct receiver, so neither overload was ever tagged SYM_FLAG_MODDUP.
//
// Two mechanisms HIDE this, which is why the suite runs this file at BOTH -O0 and -O1, and
// runs the companion t_structoverloaddfe.ax with -no-dfe:
//   * -O1 INLINES the call and gets the right answer even with the symbols merged (the probe
//     read 2 at -O0/default and 42 at -O1 -- measuring only -O1 concludes "no bug"; and
//     "default" is NOT an independent level, `optimize` defaults to false);
//   * dead-function elimination deletes the shadowed body, so a program that calls only ONE
//     of the overloads looks correct until DFE is off.
// Declaration ORDER is what decided the outcome, so both orders are pinned (fa/fb): with the
// 2-param body declared first, the no-arg call ran it and read an uninitialised argument
// register (the probe read 82 = 41+41).
//
// SCOPE -- what this oracle deliberately does NOT cover. Calls written in METHOD SYNTAX
// (`s.k(41)`, an inline `fn k(self, x)` overload, or the static form `S.k(&s, 41)`) still
// bind to the wrong overload, and that is a DIFFERENT defect: resolve_method_overload picks
// the first chain member compatible with the RECEIVER and never looks at arity, while
// resolve_free_call_overload gates on arity + argument types. Attribution is exact rather
// than assumed: the identical declarations reach the right body through free-call syntax
// (check 1) and the wrong one through method syntax, on ONE compiler build, so the emitted
// symbols are the same in both cases and only the binding differs. Fixing that means
// teaching the method path the arity rule the free path already has (or rejecting the call
// outright) -- a language-semantics decision, tracked separately.
//
// Each check returns a distinct small code so a failure names itself; 42 = all clear.
// Companion oracles: t_methnamestrict.ax (name resolution), t_modcollide.ax (cross-module).

struct S:
    n: i64
    fn m(self) -> i64:
        return 1

// A DIFFERENT struct: same method name, and below also a same-named free fn on it. Both live
// in a different mangle group, so neither may be renamed by the S collision.
struct T:
    n: i64
    fn m(self) -> i64:
        return 100

// Free fns on a struct receiver, 1-param declared FIRST.
fn fa(s: S) -> i64:
    return 1

fn fa(s: S, x: i64) -> i64:
    return x

// Same NAME, DIFFERENT receiver: a separate group, must keep its own `ax_T_fa`.
fn fa(t: T) -> i64:
    return 500

// The S pair again with the declaration order REVERSED.
fn fb(s: S, x: i64) -> i64:
    return x

fn fb(s: S) -> i64:
    return 1

// Control: scalar receiver -- these DO bare-mangle, so Phase 3.5 already uniqued them.
fn fc(a: i64) -> i64:
    return 1

fn fc(a: i64, b: i64) -> i64:
    return b

// Control: str receiver.
fn fd(a: str) -> i64:
    return 1

fn fd(a: str, b: i64) -> i64:
    return b

// Control: one method, no overload at all -- must keep its plain `ax_U_only` symbol.
struct U:
    n: i64
    fn only(self) -> i64:
        return 7

// Control: method on a generic struct (instances mangle under their instantiated names).
struct Box[V]:
    v: V
    fn get(self) -> V:
        return self.v

fn main() -> i64:
    let s = S(n: 0)
    if fa(s, 41) + fa(s) != 42:
        return 1
    if fb(s, 41) + fb(s) != 42:
        return 2

    if fc(0, 41) + fc(0) != 42:
        return 3
    if fd("q", 41) + fd("q") != 42:
        return 4

    let t = T(n: 0)
    if fa(t) != 500:
        return 5
    if s.m() + t.m() != 101:
        return 6

    let u = U(n: 0)
    if u.only() != 7:
        return 7

    let bx = Box[i64](v: 40)
    if bx.get() != 40:
        return 8

    return 42
