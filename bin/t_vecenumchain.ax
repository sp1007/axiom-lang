// Chained HOFs: a Vec[T] result feeding straight into enumerate.
fn main() -> i64:
    mut v: Vec[i64] = Vec.new()
    v.push(5)
    v.push(30)
    v.push(3)
    v.push(20)
    let pairs = v.filter(|x: i64| -> bool x > 10).enumerate()
    mut acc := 0 as i64
    mut j := 0 as i64
    while j < pairs.len:
        let p = pairs.get(j).unwrap()
        acc = acc + p.0 + p.1
        j = j + 1
    return acc   // filtered [30,20] -> (0,30),(1,20) -> 0+30+1+20 = 51
