// Oracle (exit 60): RFC 0026 — inlining of a scalar array-element getter.
// at(a, i) = a[i] : OP_INDEX with a scalar (i64) element -> inlinable.
fn at(a: [i64; 4], i: i64) -> i64:
    return a[i]
fn main() -> i32:
    let arr: [i64; 4] = [10, 20, 30, 40]
    mut s := 0 as i64
    mut i := 0 as i64
    while i < 4:
        s = s + at(arr, i)        // 10+20+30+40 = 100
        i = i + 1
    return (s - 40) as i32        // 60
