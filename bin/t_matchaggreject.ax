// Oracle (reject): BUG#53 class — `match` on an AGGREGATE scrutinee.
// A struct/array/tuple (and str/bytes/float) scrutinee hits NEITHER match
// lowering path (sum-tag dispatch, or the integer/bool/char switch), so the
// match lowered to NOTHING and the function fell through returning garbage RAX.
// `match p: _:` silently returned 0 instead of 42. Must be a diagnostic:
// destructuring a tuple/struct scrutinee is RFC 0022 P5, a future feature.
struct P:
    x: i64
fn main() -> i64:
    let p = P(x: 42)
    match p:
        _:
            return p.x
