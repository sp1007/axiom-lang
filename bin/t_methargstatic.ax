// The STATIC call form `Type.m(recv, arg)`: the receiver is spelled as an ordinary first
// argument, so the argument/parameter alignment differs by one from the instance form. A
// wrong alignment here would check `&s` against `u8` (a false reject) or `300` against
// `ptr[S]` (a silent miss); this row pins that the shift is applied.
struct S:
    v: u8

fn setv(mut self: ptr[S], x: u8):
    self.v = x

fn main() -> i64:
    mut s := S(v: 0 as u8)
    S.setv(&s, 300)
    return s.v as i64
