import std.result
import std.io
import std.string

extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn p(v: i64):
    if v == 0 as i64:
        putchar('0' as i32)
        putchar(10 as i32)
        fflush(null as ptr[void])
        return
    mut x := v
    let buf = @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        buf[n] = ('0' as u8) + (x % 10 as i64) as u8
        n = n + 1 as i64
        x = x / 10 as i64
    mut i := n - 1 as i64
    while i >= 0 as i64:
        putchar(buf[i] as i32)
        i = i - 1 as i64
    putchar(10 as i32)
    fflush(null as ptr[void])

fn mki() -> Result[i64, str]:
    return Ok(42 as i64)

pub fn main() -> i32:
    p(1 as i64)
    let r = mki()
    if r.is_ok():
        p(2 as i64)
        let v = r.unwrap()
        p(v)
    p(3 as i64)
    let rf = std.io.open("bin/t_min.ax")
    if rf.is_ok():
        let f = rf.unwrap()
        let r2 = f.read_all()
        if r2.is_ok():
            let content = r2.unwrap()
            p(content.len)
            p(4 as i64)
    return 0
