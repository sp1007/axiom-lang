// Oracle (call-result form): an Option-returning call passed where a scalar param is expected
// must REJECT. `Vec.get` returns Option[i64]; passing it to f(x:i64) without .unwrap() was an
// accept-then-miscompile. Complements t_optargreject (the ident form). See
// knowledge/bug-option-as-call-arg-not-rejected.md.
import std.collections
fn f(x: i64) -> i64:
    return x + 1
fn main() -> i64:
    mut v = new_vec[i64]()
    v.push(41)
    return f(v.get(0))
