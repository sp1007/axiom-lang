extern "C" fn malloc(n: u64) -> ptr[u8]
fn myconcat(a: str, b: str) -> str:
    let total = a.len + b.len
    let buf = malloc((total + 1) as u64) as ptr[u8]
    @memcpy(buf, a.ptr, a.len)
    @memcpy(((buf as i64) + a.len) as ptr[u8], b.ptr, b.len)
    buf[total] = 0 as u8
    return buf as str
pub fn main() -> i32:
    let c = myconcat("hello", "world!")
    return c.len as i32
