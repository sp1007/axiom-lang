fn main() -> i64:
    mut a := Vec[i64].new()
    a.push(1)
    a.push(2)
    mut b := Vec[i64].new()
    b.push(3)
    b.push(4)
    a.extend(b)
    // a = [1,2,3,4], sum = 10, len 4 -> fold
    let s = a.fold(0 as i64, |acc: i64, x: i64| -> i64 acc + x)
    if a.len == 4:
        return s + 32
    return 0
