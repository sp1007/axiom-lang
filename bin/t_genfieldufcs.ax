// Oracle (exit 4): a fully-inferred generic struct Pair(a,b) with i32 fields, then
// numeric-UFCS to_str() on the fields (widening i32 receiver -> i64 free fn).
// "7"=1 + "300"=3 = 4.
import std.string
struct Pair[A, B]:
    a: A
    b: B
fn main() -> i64:
    let p = Pair(a: 7, b: 300)
    return p.a.to_str().len + p.b.to_str().len
