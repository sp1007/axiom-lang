// RFC 0006 §6.1 (E3030): an integer literal that does not fit the type the programmer
// ANNOTATED must be REJECTED, not silently bound at full width. Before the reject this
// compiled and `x` held 300 -- a u8 that was not a u8, with no diagnostic at all.
// `300 as u8` is the spelling for "I intend to truncate" (guarded by t_intrangeok).
fn main() -> i64:
    let x: u8 = 300
    return x as i64
