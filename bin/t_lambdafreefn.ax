fn dbl(n: i64) -> i64:
    return n * 2
fn main() -> i64:
    let v = Vec[i64].new()
    v.push(3)
    v.push(4)
    v.push(14)
    // map via free fn call inside lambda -> [6,8,28]; find first >10 -> 28; +14=42
    let w = v.map(|n: i64| -> i64 dbl(n))
    let f = w.find(|n: i64| -> bool n > 10)
    return f.unwrap() + 14
