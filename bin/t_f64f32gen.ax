// RFC 0006 §4 (E3032): the EXPLICIT type-argument call form. `pick[f32](d, 1.0)` names the
// narrow type as plainly as an annotation does, but its callee is a NODE_INDEX_EXPR that
// bypasses the generic instantiation path, so the per-param reject needs its own hook --
// the same separate site E3030 and E3031 each needed.
fn pick[T](a: T, b: T) -> T:
    return a

fn main() -> i64:
    let d: f64 = 3.5
    return pick[f32](d, 1.0) as i64
