// Oracle (exit 7): HashMap.contains_key membership (present/absent) + HashSet.contains
// contrast in one program (guards that same-named cross-type methods dispatch by self
// type). m has keys 3,5; contains_key(3)=+1, contains_key(4)=absent (+0),
// contains_key(5)=+2. s has 9; contains(9)=+4, contains(8)=absent (+0). 1+2+4 = 7.
import std.collections
fn main() -> i64:
    mut m = new_hashmap[i64, i64]()
    m.insert(3 as i64, 30 as i64)
    m.insert(5 as i64, 50 as i64)
    mut r = 0 as i64
    if m.contains_key(3 as i64):
        r = r + 1
    if m.contains_key(4 as i64):
        r = r + 100
    if m.contains_key(5 as i64):
        r = r + 2
    mut s = new_hashset[i64]()
    s.insert(9 as i64)
    if s.contains(9 as i64):
        r = r + 4
    if s.contains(8 as i64):
        r = r + 100
    return r
