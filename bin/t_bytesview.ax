// Oracle (RFC 0020 P1b): `bytes` is a distinct type sharing str's {ptr,len} repr.
// `s as bytes` / `b as str` are zero-cost reinterpret views; b.len is byte length,
// b[i] is a u8 byte.
fn main() -> i64:
    let s = "ABC"
    let b = s as bytes
    mut sum = b.len            // 3
    mut i = 0 as i64
    while i < b.len:
        sum = sum + (b[i] as i64)
        i = i + 1
    let s2 = b as str          // round-trip view
    return sum + s2.len        // (3 + 65+66+67) + 3 = 204
