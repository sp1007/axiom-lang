// BUG#38.1 regression: compound assignment += -= *= /= %= (was silently `=`).
pub fn main() -> i32:
    mut a := 10 as i32
    a += 5 as i32
    a -= 3 as i32
    a *= 2 as i32
    a /= 4 as i32
    a %= 4 as i32        // a = 2
    mut sum := 0 as i32
    mut i := 0 as i32
    while i < 5 as i32:
        sum += i          // 10
        i += 1 as i32
    return a + sum        // 12
