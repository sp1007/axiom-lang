// Oracle (BUG#84): &a[i] on a SCALAR element must yield the element's lvalue
// address, so writing through the pointer mutates the array and reading past
// index 0 sees the real elements. Before the fix, `&a[i]` lowered as OP_INDEX
// (load the value) + OP_MAKE_REF (address of that temporary), so the pointer
// aliased a stack temp: writes were lost and p[k>0] read zeroed stack.
fn store_at(p: ptr[i32], i: i32, v: i32):
    p[i] = v

fn sum4(p: ptr[i32]) -> i32:
    mut s := 0 as i32
    mut i := 0 as i32
    while i < 4 as i32:
        s = s + p[i] as i32
        i = i + 1 as i32
    return s

fn main() -> i32:
    mut a: [i32; 4] = [3 as i32, 5 as i32, 7 as i32, 9 as i32]
    let p = &a[0]
    store_at(p, 1 as i32, 20 as i32)   // a[1] := 20
    let q = &a[2]
    let via_q = q[0] as i32            // a[2] = 7
    // a is now {3, 20, 7, 9}; sum = 39; + via_q(7) + a[1](20) = 66
    return (sum4(p) + via_q + a[1]) as i32
