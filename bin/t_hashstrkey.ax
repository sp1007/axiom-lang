// Oracle (exit=30): HashMap with STRING keys; insert two entries and read both
// back via get().unwrap(). Crosses str-hashing x Option-returning get.
import std.collections
fn main() -> i32:
    mut m = HashMap[str, i64].new()
    m.insert("x", 10)
    m.insert("y", 20)
    let a = m.get("x").unwrap()
    let b = m.get("y").unwrap()
    return (a + b) as i32   // 30
