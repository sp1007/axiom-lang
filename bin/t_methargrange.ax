// RFC 0006 §6.1 (E3030) at the METHOD-ARGUMENT position. A method call resolves its
// parameter types through the name+receiver symbol scan, not the free-function `fp_data`
// path, so `s.setv(300)` slipped past the rule that already covered `f(300)`: it compiled
// and stored the low byte, 44 (a u8 holding a value that is not a u8, no diagnostic).
struct S:
    v: u8

fn setv(mut self: ptr[S], x: u8):
    self.v = x

fn main() -> i64:
    mut s := S(v: 1 as u8)
    s.setv(300)
    return s.v as i64
