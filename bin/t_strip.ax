import std.io
import std.string

fn strip_pp(s: str) -> str:
    let p = "std."
    let r0 = std.string.replace(s, std.string.concat(":", ":"), ".")
    let r1 = std.string.replace(r0, std.string.concat(p, "mem.alloc."), "")
    let r2 = std.string.replace(r1, std.string.concat(p, "scheduler."), "")
    let r3 = std.string.replace(r2, std.string.concat(p, "os.win32."), "")
    let r4 = std.string.replace(r3, std.string.concat(p, "os.linux_sys."), "")
    let r5 = std.string.replace(r4, std.string.concat(p, "os."), "")
    let r6 = std.string.replace(r5, std.string.concat(p, "string."), "")
    let r7 = std.string.replace(r6, std.string.concat(p, "io."), "")
    let r8 = std.string.replace(r7, std.string.concat(p, "net."), "")
    return r8

fn main() -> i64:
    let src = "a::b std.string.len std.os.exit std.io.print"
    let out = strip_pp(src)
    std.io.println(out)
    return 0
