// RFC 0006 §6.1 (E3030): assignment to a binding whose type the programmer ANNOTATED.
// An INFERRED `mut x := 0; x = 3000000000` is deliberately NOT rejected (no user-written
// type to respect) -- guarded by t_intrangeok row 16.
fn main() -> i64:
    mut x: u8 = 1
    x = 300
    return x as i64
