interface Shape:
    fn area(self: Self) -> f64

struct Sq:
    s: f64
    fn area(self: Sq) -> f64:
        return self.s * self.s

fn useit(sh: Shape) -> i64:
    let a = sh.area()
    if a > 8.99 and a < 9.01:
        return 42
    return (a * 10.0) as i64
fn main() -> i64:
    return useit(Sq(s: 3.0))
