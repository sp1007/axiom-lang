// RFC 0003: `enum` indent-style sugar (desugars to sum type)
enum Shape:
    Circle(i64)
    Rect(i64, i64)
    Unit

fn area(s: Shape) -> i64:
    match s:
        Circle(r):
            return r * r * 3 as i64
        Rect(w, h):
            return w * h
        Unit:
            return 1 as i64

pub fn main() -> i32:
    let a = area(Circle(3 as i64))      // 27
    let b = area(Rect(4 as i64, 5 as i64))  // 20
    let c = area(Unit)                  // 1
    return (a + b + c) as i32           // 48
