import std.string

fn cp(s_ptr: ptr[u8], prefix: str) -> i32:
    let p_ptr = prefix as ptr[u8]
    let pb = p_ptr[0] as i32
    let sb = s_ptr[0] as i32
    let pl = std.string.len(prefix) as i32
    return pb * 1000000 + sb * 1000 + pl

pub fn main() -> i32:
    let s = "[Debug] Stage"
    let sp = s as ptr[u8]
    return cp(sp, "[Debug] Stage")
