struct Acc:
    sum: i64
    cnt: i64
fn go(n: i64, a: Acc) -> Acc:
    if n == 0:
        return a
    return go(n - 1, Acc(sum: a.sum + n, cnt: a.cnt + 1))
fn main() -> i64:
    let z = Acc(sum: 0, cnt: 0)
    let r = go(8, z)
    // sum 1..8 = 36, cnt 8 -> 36+8 = 44 -> -2 = 42
    return r.sum + r.cnt - 2
