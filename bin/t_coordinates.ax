const PI: f64 = 3.14159265358979323846
const TAU: f64 = 6.28318530717958647692
const HALF_PI: f64 = 1.57079632679489661923

fn sqrtf(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut g := x
    mut i := 0 as i32
    while i < 80:
        let ng = (g + x / g) * 0.5
        mut d := ng - g
        if d < 0.0:
            d = 0.0 - d
        if d < 0.000000000001:
            return ng
        g = ng
        i = i + 1
    return g

fn sinf(x: f64) -> f64:
    mut a := x
    let q = (a / TAU) as i64
    a = a - (q as f64) * TAU
    if a > PI:
        a = a - TAU
    if a < (0.0 - PI):
        a = a + TAU
    let a2 = a * a
    mut term := a
    mut sum := a
    mut n := 1 as i32
    while n < 12:
        let d = ((2 * n) * (2 * n + 1)) as f64
        term = (0.0 - term) * a2 / d
        sum = sum + term
        n = n + 1
    return sum

fn cosf(x: f64) -> f64:
    return sinf(x + HALF_PI)

fn atan2f(y: f64, x: f64) -> f64:
    if x > 0.0:
        return 0.0   // only x=0 / y=0 cases exercised in test
    if x < 0.0:
        return PI
    if y > 0.0:
        return HALF_PI
    if y < 0.0:
        return 0.0 - HALF_PI
    return 0.0

fn acosf(x: f64) -> f64:
    let s = sqrtf(1.0 - x * x)
    return atan2f(s, x)

fn co_polar_to_x(r: f64, theta: f64) -> f64:
    return r * cosf(theta)

fn co_polar_to_y(r: f64, theta: f64) -> f64:
    return r * sinf(theta)

fn co_cart_to_r(x: f64, y: f64) -> f64:
    return sqrtf(x * x + y * y)

fn co_cart_to_theta(x: f64, y: f64) -> f64:
    return atan2f(y, x)

fn co_sph_to_x(r: f64, theta: f64, phi: f64) -> f64:
    return r * sinf(phi) * cosf(theta)

fn co_sph_to_z(r: f64, phi: f64) -> f64:
    return r * cosf(phi)

fn co_cart_to_sph_r(x: f64, y: f64, z: f64) -> f64:
    return sqrtf(x * x + y * y + z * z)

fn co_cart_to_sph_phi(x: f64, y: f64, z: f64) -> f64:
    let r = sqrtf(x * x + y * y + z * z)
    if r == 0.0:
        return 0.0
    return acosf(z / r)

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.0001

pub fn main() -> i32:
    mut s := 0 as i32
    if near(co_polar_to_x(5.0, 0.0), 5.0):
        s = s + 1
    if near(co_polar_to_y(5.0, HALF_PI), 5.0):
        s = s + 2
    if near(co_cart_to_r(3.0, 4.0), 5.0):
        s = s + 4
    if near(co_cart_to_theta(0.0, 1.0), HALF_PI):
        s = s + 8
    if near(co_sph_to_z(1.0, 0.0), 1.0):
        s = s + 16
    if near(co_sph_to_x(1.0, 0.0, HALF_PI), 1.0):
        s = s + 32
    if near(co_cart_to_sph_r(0.0, 0.0, 5.0), 5.0) and near(co_cart_to_sph_phi(0.0, 0.0, 5.0), 0.0):
        s = s + 64
    return s   // expect 127
