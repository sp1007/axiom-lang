// RFC 0006 §4 (E3032): an array-literal ELEMENT under an ANNOTATED `f32` element type.
// An UNANNOTATED `let a = [1.0, d]` is deliberately outside the rule (the element type is
// inferred, not written) -- same boundary E3030 and E3031 draw.
fn main() -> i64:
    let d: f64 = 3.5
    let a: [f32; 3] = [1.0, d, 3.0]
    return a[1] as i64
