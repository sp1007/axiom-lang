fn main() -> i64:
    let v = Vec[i64].new()
    v.push(-3)
    v.push(5)
    v.push(-1)
    v.push(40)
    // map: negatives -> 0, else keep; -> [0,5,0,40]; fold sum = 45; -3 = 42
    let w = v.map(|n: i64| -> i64 if n > 0: n else: 0)
    let s = w.fold(0 as i64, |acc: i64, x: i64| -> i64 acc + x)
    return s - 3
