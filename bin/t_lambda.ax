// Regression repro: RFC 0008 zero-capture lambdas via lambda-lifting.
// Self-contained. Exit 5 = all 5 oracle checks pass.
extern "C" fn putchar(c: i32) -> i32

fn apply2(g: fn(i64, i64) -> i64, x: i64, y: i64) -> i64:
    return g(x, y)

fn qsort(arr: ptr[i64], lo: i64, hi: i64, less: fn(i64, i64) -> bool):
    if lo >= hi:
        return
    let pivot = arr[hi]
    mut i := lo - 1 as i64
    mut j := lo
    while j < hi:
        if less(arr[j], pivot):
            i = i + 1 as i64
            let t = arr[i]
            arr[i] = arr[j]
            arr[j] = t
        j = j + 1 as i64
    let p = i + 1 as i64
    let tp = arr[p]
    arr[p] = arr[hi]
    arr[hi] = tp
    qsort(arr, lo, p - 1 as i64, less)
    qsort(arr, p + 1 as i64, hi, less)

pub fn main() -> i32:
    mut pass := 0 as i32

    // 1. lambda passed to higher-order fn
    if apply2(|a: i64, b: i64| -> i64 a + b, 2 as i64, 3 as i64) == 5 as i64:
        pass = pass + 1

    // 2. lambda in a local variable, then called
    let f = |a: i64, b: i64| -> i64 a * b
    if f(4 as i64, 5 as i64) == 20 as i64:
        pass = pass + 1

    // 3. two distinct lambdas in one expression
    let s = apply2(|a: i64, b: i64| -> i64 a - b, 10 as i64, 3 as i64)
    if s == 7 as i64:
        pass = pass + 1

    // 4. inline comparator lambda (bool-returning) driving quicksort
    let n = 6 as i64
    let arr = @alloc(n * 8 as i64) as ptr[i64]
    arr[0] = 5 as i64
    arr[1] = 2 as i64
    arr[2] = 8 as i64
    arr[3] = 1 as i64
    arr[4] = 9 as i64
    arr[5] = 3 as i64
    qsort(arr, 0 as i64, n - 1 as i64, |x: i64, y: i64| -> bool x < y)
    if arr[0] == 1 as i64 and arr[5] == 9 as i64:
        pass = pass + 1

    // 5. descending via reversed inline comparator
    qsort(arr, 0 as i64, n - 1 as i64, |x: i64, y: i64| -> bool x > y)
    if arr[0] == 9 as i64 and arr[5] == 1 as i64:
        pass = pass + 1

    return pass as i32
