// Repro BUG#48: >=8 float-call-results held live simultaneously force some to
// spill; the spilled float dst must be stored/reloaded via XMM+movsd, not GPR.
// id(x) = x. Sum of 1..12 = 78. If any spilled float is corrupted, sum != 78.

fn idf(x: f64) -> f64:
    return x

pub fn main() -> i32:
    let a = idf(1.0)
    let b = idf(2.0)
    let c = idf(3.0)
    let d = idf(4.0)
    let e = idf(5.0)
    let f = idf(6.0)
    let g = idf(7.0)
    let h = idf(8.0)
    let i = idf(9.0)
    let j = idf(10.0)
    let k = idf(11.0)
    let l = idf(12.0)
    let s = a + b + c + d + e + f + g + h + i + j + k + l
    return s as i32
