// H: rank 2 -- the `__` type-arg separator window. `eq__fast` is accepted as
// answering `eq` even though no exact `eq` exists.
struct Num:
    v: i64
    fn eq__fast(self, o: Num) -> bool:
        return true
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
