// F: is conformance checked when the interface value is an Option PAYLOAD?
// S has only `a_r` (loose hit for `r`), arity 2 vs the slot's 1.
interface I:
    fn r(self: Self) -> i64

struct S:
    n: i64
    fn a_r(self: S, x: i64) -> i64:
        return x

fn main() -> i64:
    let o: Option[I] = Some(S(n: 1))
    let i = o.unwrap()
    if i.r() == 42:
        return 42
    return 7
