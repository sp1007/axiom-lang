// control: NO shadowing sibling name at all.
struct Box[T]:
    v: T
    fn get(self) -> T:
        return self.v

fn main() -> i64:
    let a = Box[i64](v: 40 as i64)
    let b = Box[i32](v: 1 as i32)
    let c = Box[f64](v: 1.0)
    let s = a.get() + (b.get() as i64) + (c.get() as i64)
    if s != 42:
        return 100 + s
    return 42
