// A control: exact `eq` present alongside `deep_eq`; the exact one must win.
struct Num:
    v: i64
    fn deep_eq(self, o: Num) -> bool:
        return true
    fn eq(self, o: Num) -> bool:
        return self.v == o.v
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    let c = Num(v: 1)
    if a == c:
        return 42
    return 8
