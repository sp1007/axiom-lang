// E: control for the MECHANISM -- `deepeq` has no `_` boundary before "eq",
// so the loose window must NOT match. Expect a REJECT.
struct Num:
    v: i64
    fn deepeq(self, o: Num) -> bool:
        return true
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
