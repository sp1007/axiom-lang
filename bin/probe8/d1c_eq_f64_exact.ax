// Control for d1: the method is named EXACTLY `eq` but returns f64. If this also
// mis-evaluates, the return-type confusion is a SEPARATE defect from the name hole.
struct Num:
    v: i64
    fn eq(self, o: Num) -> f64:
        return 0.0
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
