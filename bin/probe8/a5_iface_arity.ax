// A: interface conformance + vtable slot fill. Struct declares only `a_r`,
// which the loose window accepts for `r`. Arity differs (extra i64 param).
interface I:
    fn r(self: Self) -> i64

struct S:
    n: i64
    fn a_r(self: S, x: i64) -> i64:
        return x

fn main() -> i64:
    let i: I = S(n: 1)
    if i.r() == 42:
        return 42
    return 7
