// I (overreach): a generic free fn instantiated at 2 types beside a loose
// shadow name.
fn ident[T](x: T) -> T:
    return x
fn safe_ident[T](x: T) -> T:
    return x
fn main() -> i64:
    let a = ident[i64](40 as i64)
    let b = ident[i32](2 as i32)
    let c = safe_ident[i64](0 as i64)
    return a + (b as i64) + c
