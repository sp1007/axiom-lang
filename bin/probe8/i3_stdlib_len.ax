// I (overreach): the stdlib's own namespaced forms must still resolve. `len` is
// the classic case (std.string.len / Vec.len) beside a user `buf_len`.
import std.collections
struct Buf:
    n: i64
fn buf_len(b: Buf) -> i64:
    return 100
fn main() -> i64:
    mut v = Vec[i64].new()
    v.push(1)
    v.push(2)
    let s = "abc"
    let b = Buf(n: 0)
    let total = v.len() + std.string.len(s) + (buf_len(b) / 100)
    if total != 6:
        return 7 + total
    return 42
