// I (overreach): a generic method instantiated at 3 types, with a loosely
// shadowing sibling name present. Every instance must keep its own body.
struct Box[T]:
    v: T
    fn get(self) -> T:
        return self.v
    fn safe_get(self) -> T:
        return self.v

fn main() -> i64:
    let a = Box[i64](v: 40 as i64)
    let b = Box[i32](v: 1 as i32)
    let c = Box[f64](v: 1.0)
    let s = a.get() + (b.get() as i64) + (c.get() as i64)
    if s != 42:
        return 7
    let t = a.safe_get()
    if t != 40:
        return 8
    return 42
