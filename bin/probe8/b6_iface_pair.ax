// B (overreach): interface declares BOTH `r32` and `p32_r32`; the struct
// implements both; both dispatch.
interface I:
    fn p32_r32(self: Self, a: i64) -> i64
    fn r32(self: Self) -> i64

struct S:
    k: i64
    fn p32_r32(self: S, a: i64) -> i64:
        return a
    fn r32(self: S) -> i64:
        return 2

fn main() -> i64:
    let i: I = S(k: 0)
    let x = i.p32_r32(40)
    let y = i.r32()
    return x + y
