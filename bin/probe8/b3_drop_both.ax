// B (overreach): a real `drop` beside a `pre_drop`. Drop glue must run `drop`.
mut d: i64 = 0
mut p: i64 = 0
struct Res:
    id: i64
    fn pre_drop(self):
        p = p + 1
    fn drop(self):
        d = d + 1
fn work():
    mut i = 0
    while i < 6:
        let r = Res(id: i)
        if r.id >= 0:
            i = i + 1
        else:
            i = i + 1
fn main() -> i64:
    work()
    if p != 0:
        return 7
    if d != 6:
        return 8 + d
    return 42
