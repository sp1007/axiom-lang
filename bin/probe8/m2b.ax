struct S:
    v: i64
fn setv(mut self: ptr[S], x: i64):
    self.v = x
fn main() -> i64:
    mut s := S(v: 1 as i64)
    s.setv(3.0)
    if s.v > 4000000000 as i64:
        return 100
    if s.v == 3 as i64:
        return 101
    if s.v == 0 as i64:
        return 102
    if s.v < 0 as i64:
        return 103
    return 104
