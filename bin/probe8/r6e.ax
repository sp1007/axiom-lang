// Same as r6d but the preceding call uses an f32 VARIABLE argument, which needs no
// coercion and therefore already worked BEFORE the fix -- so both compilers reach the
// second call and the comparison is honest.
interface I:
    fn p32_r32(self: Self, a: f32) -> f32
    fn r32(self: Self) -> f32

struct S:
    k: i64
    fn p32_r32(self: S, a: f32) -> f32:
        return a
    fn r32(self: S) -> f32:
        return 2.5

fn main() -> i64:
    let i: I = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p32_r32(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.r32()
    let v = b as i64
    if v != 2:
        return 100 + v
    return 42
