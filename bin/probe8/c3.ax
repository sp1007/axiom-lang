// CONTROL: two structs, SAME method name, DIFFERENT declared param types.
// Proves the params read belong to the receiver's own declaration.
struct Narrow:
    v: u8
struct Wide:
    v: i64

fn setv(mut self: ptr[Narrow], x: u8):
    self.v = x
fn setv(mut self: ptr[Wide], x: i64):
    self.v = x

fn main() -> i64:
    mut w := Wide(v: 0 as i64)
    w.setv(300)
    mut n := Narrow(v: 0 as u8)
    n.setv(200)
    mut r := 0 as i64
    if w.v == 300 as i64:
        r = r + 20 as i64
    if n.v == 200 as u8:
        r = r + 22 as i64
    return r
