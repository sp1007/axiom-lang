// D: `+` looks up `add`; only `checked_add` exists. Realistic name, no exact
// `add` anywhere. If selected, `a + b` silently runs saturating arithmetic.
struct Num:
    v: i64
    fn checked_add(self, o: Num) -> Num:
        return Num(v: 999)
fn main() -> i64:
    let a = Num(v: 10)
    let b = Num(v: 32)
    let c = a + b
    if c.v == 999:
        return 7
    if c.v == 42:
        return 42
    return 8
