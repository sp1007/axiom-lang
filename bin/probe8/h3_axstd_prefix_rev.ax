// H: same as h2 with declaration order reversed -- if this is 42 the defect is a
// rank-3 TIE broken by symbol order, i.e. `_AX_std_eq` is being treated as an
// exact `eq`.
struct Num:
    v: i64
    fn eq(self, o: Num) -> bool:
        return self.v == o.v
    fn _AX_std_eq(self, o: Num) -> bool:
        return true
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
