// CONTROL: generic STRUCT with a method, instantiated at u8 and i64.
struct Box[T]:
    v: T

fn put[T](mut self: ptr[Box[T]], x: T):
    self.v = x

fn main() -> i64:
    mut b64 := Box[i64](v: 0 as i64)
    b64.put(300)
    mut b8 := Box[u8](v: 0 as u8)
    b8.put(200)
    mut r := 0 as i64
    if b64.v == 300 as i64:
        r = r + 20 as i64
    if b8.v == 200 as u8:
        r = r + 22 as i64
    return r
