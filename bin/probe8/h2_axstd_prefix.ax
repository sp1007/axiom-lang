// H (over-reach of the NEW rank): the rank strips an `_AX_std_` prefix and then
// calls the result an EXACT (rank 3) match. A user method literally named
// `_AX_std_eq`, declared BEFORE the real `eq`, therefore ties at rank 3 and can
// steal `==` from the genuine `eq`.
struct Num:
    v: i64
    fn _AX_std_eq(self, o: Num) -> bool:
        return true
    fn eq(self, o: Num) -> bool:
        return self.v == o.v
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
