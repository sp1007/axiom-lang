// B (overreach): `len` and `buf_len` BOTH defined and BOTH called. The tightened
// rank must keep resolving each to itself.
struct Buf:
    n: i64
    fn len(self) -> i64:
        return 40
    fn buf_len(self) -> i64:
        return 2
fn main() -> i64:
    let b = Buf(n: 0)
    return b.len() + b.buf_len()
