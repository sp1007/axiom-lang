// F: conformance at an ASSIGNMENT (not initializer) site.
interface I:
    fn r(self: Self) -> i64

struct S:
    n: i64
    fn a_r(self: S, x: i64) -> i64:
        return x
struct T:
    n: i64
    fn r(self: T) -> i64:
        return 42

fn main() -> i64:
    mut i: I = T(n: 0)
    i = S(n: 1)
    if i.r() == 42:
        return 42
    return 7
