// G: same-name methods differing only in ARITY. air_builder's UFCS loop filters
// on param[0] only -- no arity check -- so if this is legal at all, the loop can
// pick the wrong one.
struct S:
    n: i64
    fn m(self) -> i64:
        return 1
    fn m(self, x: i64) -> i64:
        return x
fn main() -> i64:
    let s = S(n: 0)
    return s.m(41) + s.m()
