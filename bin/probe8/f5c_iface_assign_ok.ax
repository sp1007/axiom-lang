// F control: assignment of a CONFORMING struct into an interface variable.
interface I:
    fn r(self: Self) -> i64

struct S:
    n: i64
    fn r(self: S) -> i64:
        return 42
struct T:
    n: i64
    fn r(self: T) -> i64:
        return 1

fn main() -> i64:
    mut i: I = T(n: 0)
    i = S(n: 1)
    if i.r() == 42:
        return 42
    return 7
