// The other half of c3: the NARROW receiver must still reject.
struct Narrow:
    v: u8
struct Wide:
    v: i64

fn setv(mut self: ptr[Narrow], x: u8):
    self.v = x
fn setv(mut self: ptr[Wide], x: i64):
    self.v = x

fn main() -> i64:
    mut n := Narrow(v: 0 as u8)
    n.setv(300)
    return n.v as i64
