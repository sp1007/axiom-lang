// A: does `==` (RFC 0007 -> method `eq`) get answered by a DIFFERENTLY named
// method via the surviving loose rank-1 window? `deep_eq` contains "_eq" at a
// `_`-bounded position. No exact `eq` exists, so rank 3 never fires.
struct Num:
    v: i64
    fn deep_eq(self, o: Num) -> bool:
        return true
fn main() -> i64:
    let a = Num(v: 1)
    let b = Num(v: 2)
    if a == b:
        return 7
    return 42
