// RFC 0006 §4 (E3032): a NEGATED f64 identifier. `-d` parses as UNARY(-) over IDENT(d), so
// the reject must unwrap the unary exactly as E3030 does for `-128` and E3031 does for
// `-2.5`, otherwise the most obvious negated form slips through the check.
fn main() -> i64:
    let d: f64 = 3.5
    let s: f32 = -d
    return (0.0 - s) as i64
