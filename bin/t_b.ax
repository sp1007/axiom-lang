import std.result

fn ok_str(flag: i64) -> Result[str, str]:
    if flag > 0:
        return Ok("payload-ok")
    return Err("payload-err")

pub fn main() -> i32:
    let s1 = ok_str(1)
    if not s1.is_ok():
        return 6
    let s2 = ok_str(0)
    if not s2.is_err():
        return 7
    let ok_payload = s1.unwrap()
    if ok_payload.len != 10:
        return 8
    let err_payload = s2.unwrap_err()
    if err_payload.len != 11:
        return 9
    return 0
