const PI: f64 = 3.14159265358979323846
const TAU: f64 = 6.28318530717958647692
const HALF_PI: f64 = 1.57079632679489661923

fn sinf(x: f64) -> f64:
    mut a := x
    let q = (a / TAU) as i64
    a = a - (q as f64) * TAU
    if a > PI:
        a = a - TAU
    if a < (0.0 - PI):
        a = a + TAU
    let a2 = a * a
    mut term := a
    mut sum := a
    mut n := 1 as i32
    while n < 14:
        let d = ((2 * n) * (2 * n + 1)) as f64
        term = (0.0 - term) * a2 / d
        sum = sum + term
        n = n + 1
    return sum

fn cosf(x: f64) -> f64:
    return sinf(x + HALF_PI)

fn fabsf(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x

fn sg_hann(i: i64, n: i64) -> f64:
    return 0.5 * (1.0 - cosf(TAU * (i as f64) / ((n - 1 as i64) as f64)))

fn sg_hamming(i: i64, n: i64) -> f64:
    return 0.54 - 0.46 * cosf(TAU * (i as f64) / ((n - 1 as i64) as f64))

fn sg_blackman(i: i64, n: i64) -> f64:
    let t = (i as f64) / ((n - 1 as i64) as f64)
    return 0.42 - 0.5 * cosf(TAU * t) + 0.08 * cosf(2.0 * TAU * t)

fn sg_bartlett(i: i64, n: i64) -> f64:
    return 1.0 - fabsf(2.0 * (i as f64) / ((n - 1 as i64) as f64) - 1.0)

fn sg_welch(i: i64, n: i64) -> f64:
    let h = ((n - 1 as i64) as f64) * 0.5
    let u = ((i as f64) - h) / h
    return 1.0 - u * u

fn near(v: f64, w: f64) -> bool:
    mut d := v - w
    if d < 0.0:
        d = 0.0 - d
    return d < 0.0001

pub fn main() -> i32:
    mut s := 0 as i32
    if near(sg_hann(2 as i64, 8 as i64), 0.611260) and near(sg_hann(0 as i64, 8 as i64), 0.0):
        s = s + 1
    if near(sg_hann(4 as i64, 8 as i64), 0.950484):
        s = s + 2
    if near(sg_hamming(0 as i64, 8 as i64), 0.08) and near(sg_hamming(4 as i64, 8 as i64), 0.954446):
        s = s + 4
    if near(sg_blackman(4 as i64, 8 as i64), 0.920364):
        s = s + 8
    if near(sg_bartlett(2 as i64, 8 as i64), 0.571429):
        s = s + 16
    if near(sg_welch(2 as i64, 8 as i64), 0.816327):
        s = s + 32
    if near(sg_welch(4 as i64, 8 as i64), 0.979592):
        s = s + 64
    return s   // expect 127
