import std.io
import std.result

pub fn main() -> i32:
    let r = std.io.open("trivial.ax")
    if not r.is_ok():
        return 200
    let f = r.unwrap()
    let r2 = f.read_all()
    if not r2.is_ok():
        return 201
    let content = r2.unwrap()
    if content.len == 118:
        return 0
    if content.len > 118:
        return 1
    if content.len > 0:
        return 2
    return 3
