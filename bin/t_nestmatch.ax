// Oracle (exit 15): nested match (sum inside an integer match) + default arm.
type Col = Red | Green | Blue
fn score(n: i64, c: Col) -> i64:
    match n:
        0:
            match c:
                Red:
                    return 1
                Green:
                    return 2
                Blue:
                    return 3
        _:
            return 10
fn main() -> i64:
    return score(0, Green) + score(0, Blue) + score(5, Red)
