fn nt_gcd(a: u64, b: u64) -> u64:
    mut x := a
    mut y := b
    while y != 0 as u64:
        let t = x % y
        x = y
        y = t
    return x

fn nt_is_coprime(a: u64, b: u64) -> bool:
    return nt_gcd(a, b) == 1 as u64

fn nt_mod_inverse(a: u64, m: u64) -> u64:
    if m == 1 as u64:
        return 0 as u64
    let mm = m as i64
    mut t := 0 as i64
    mut newt := 1 as i64
    mut r := mm
    mut newr := (a % m) as i64
    while newr != 0 as i64:
        let q = r / newr
        let tmpt = t - q * newt
        t = newt
        newt = tmpt
        let tmpr = r - q * newr
        r = newr
        newr = tmpr
    if r > 1 as i64:
        return 0 as u64
    if t < 0 as i64:
        t = t + mm
    return t as u64

fn nt_int_log(b: u64, n: u64) -> u64:
    if b < 2 as u64:
        return 0 as u64
    mut c := 0 as u64
    mut v := n
    while v >= b:
        v = v / b
        c = c + (1 as u64)
    return c

fn nt_sum_digits(n: u64, base: u64) -> u64:
    mut s := 0 as u64
    mut v := n
    while v > 0 as u64:
        s = s + (v % base)
        v = v / base
    return s

pub fn main() -> i32:
    mut s := 0 as i32
    if nt_mod_inverse(3 as u64, 11 as u64) == 4 as u64:
        s = s + 1
    if nt_mod_inverse(10 as u64, 17 as u64) == 12 as u64:
        s = s + 2
    if nt_mod_inverse(4 as u64, 8 as u64) == 0 as u64:
        s = s + 4
    if nt_is_coprime(8 as u64, 15 as u64) and (nt_is_coprime(8 as u64, 12 as u64) == false):
        s = s + 8
    if nt_int_log(2 as u64, 1024 as u64) == 10 as u64:
        s = s + 16
    if nt_sum_digits(12345 as u64, 10 as u64) == 15 as u64:
        s = s + 32
    if nt_int_log(10 as u64, 1000 as u64) == 3 as u64 and nt_int_log(10 as u64, 999 as u64) == 2 as u64:
        s = s + 64
    return s   // expect 127
