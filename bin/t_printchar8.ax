// RFC 0038 section 4 (error[E3033]): printing a `char8` must be REJECTED.
// The type-id fall-through in x86_selector.ax:1742 sent char8 (id 13) to the `str` shim,
// which dereferenced the character's VALUE as a string pointer -- measured SEGFAULT.
fn main() -> i32:
    let c = 'A'
    println("c = ", c)
    return 42
