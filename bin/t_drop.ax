// RFC 0014 (drop-glue) oracle. Built WITH -ctgc-free (see ctgc_free_check.sh).
// Each `Res` in work() is an owned, non-escaping struct-ctor local in a loop-body
// block that falls through, so CTGC injects OP_DESTROY and drop-glue calls
// Res.drop(self) before the free -> drop increments a global (observable via exit).
// `keep()` returns its Res (escapes) and main binds a call result (also treated as
// escaping) -> neither is dropped, proving drop does NOT fire on escaping values
// (no over-drop). Without -ctgc-free no destroy is injected, so drop_count stays 0.

mut drop_count: i64 = 0

struct Res:
    id: i64

    fn drop(self):
        drop_count = drop_count + 1

fn keep() -> Res:
    let e = Res(id: 0)   // returned -> escapes -> NOT dropped
    return e

fn work():
    mut i = 0
    while i < 42:
        let r = Res(id: i)   // owned, scalar read only, fall-through -> dropped each iter
        if r.id >= 0:
            i = i + 1
        else:
            i = i + 1

fn main() -> i64:
    let kept = keep()        // call result -> escaping -> not dropped
    work()                   // 42 fall-through drops
    return drop_count        // 42 with -ctgc-free, 0 without
