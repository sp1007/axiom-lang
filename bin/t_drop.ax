// Oracle for RFC 0014 (drop(self) hook). A struct with `drop` should have it
// called exactly once, right before CTGC's own-block free, for a plain local
// that dies at scope exit -- and NOT called when the value escapes (returned).
// Observed via a raw pointer "marker" cell that outlives every Res instance
// (avoids relying on top-level mutable globals, which no existing test uses).
struct Res:
    tag: i32
    marker: ptr[i32]
    fn drop(self):
        self.marker[0] = self.marker[0] + self.tag

fn make_and_drop_local(tag: i32, marker: ptr[i32]):
    let r = Res(tag: tag, marker: marker)
    // r dies at the end of this function -> drop should fire once.

fn make_and_return(tag: i32, marker: ptr[i32]) -> Res:
    let r = Res(tag: tag, marker: marker)
    return r
    // r escapes (moved out via return) -> drop must NOT fire here.

fn main() -> i32:
    mut marker := @alloc(4) as ptr[i32]
    marker[0] = 0 as i32
    make_and_drop_local(5 as i32, marker)
    if marker[0] != 5 as i32:
        return 1
    let escaped = make_and_return(100 as i32, marker)
    if marker[0] != 5 as i32:
        return 2
    // escaped now dies at end of main -> drop fires once more (+100 = 105).
    return marker[0]
