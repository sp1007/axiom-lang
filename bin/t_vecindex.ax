// Oracle (reject): direct subscript `v[i]` on a Vec silently read the {data,len,cap}
// header (c[1] returned the length, wide elements segfaulted) instead of vec.data[i].
// AXIOM has no Index operator; reject and point at v.get(i) / for-in.
import std.collections
fn main() -> i32:
    mut c = Vec[i64].new()
    c.push(70)
    c.push(80)
    return c[1] as i32
