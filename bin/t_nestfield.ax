// BUG#24 repro: read .phys from a nested sub-struct field of a struct.
// Mirrors MachOperand (has i64 -> 8-byte align) nested in MachInst.
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32
fn zpn(tag: i64, v: i64):
    putchar(tag as i32); putchar('=' as i32)
    mut x := v
    if x < 0 as i64:
        putchar('-' as i32); x = 0 as i64 - x
    if x == 0 as i64:
        putchar('0' as i32)
    mut b := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        b[n] = ('0' as u8) + (x % 10 as i64) as u8; n = n + 1 as i64; x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        putchar(b[j] as i32); j = j - 1 as i64
    putchar(' ' as i32); fflush(null as ptr[void])

struct Opnd:
    kind: u8
    phys: u8
    padding: u16
    vreg: u32
    label: u32
    imm: i64

struct Inst:
    op: u16
    cc: u8
    padding: u8
    dst: Opnd
    src1: Opnd
    src2: Opnd

fn read_phys(o: Opnd) -> u8:
    return o.phys

pub fn main() -> i32:
    let inst = Inst(
        op: 1 as u16, cc: 0 as u8, padding: 0 as u8,
        dst:  Opnd(kind: 2 as u8, phys: 5 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64),
        src1: Opnd(kind: 2 as u8, phys: 4 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64),
        src2: Opnd(kind: 0 as u8, phys: 0 as u8, padding: 0 as u16, vreg: 0 as u32, label: 0 as u32, imm: 0 as i64))
    zpn('D' as i64, inst.dst.phys as i64)            // expect 5
    zpn('S' as i64, inst.src1.phys as i64)           // expect 4
    zpn('R' as i64, read_phys(inst.dst) as i64)      // expect 5 (by-value)
    zpn('T' as i64, read_phys(inst.src1) as i64)     // expect 4 (by-value)
    putchar(10 as i32); fflush(null as ptr[void])
    return 0
