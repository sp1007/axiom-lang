// Does putchar output survive in a self-linked AXIOM exe, or is it lost to
// C stdio buffering when the runtime exits via ExitProcess (no CRT flush)?
extern "C" fn putchar(c: i32) -> i32

pub fn main() -> i32:
    putchar(88 as i32)   // 'X'
    putchar(89 as i32)   // 'Y'
    putchar(10 as i32)
    return 0
