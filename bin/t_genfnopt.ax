// Oracle (exit=63): generic free function first[T] returning Option[T] with
// T a 16-byte aggregate; unwrap and sum fields. Crosses generic-fn inference
// x Option x aggregate payload.
struct V2:
    x: i64
    y: i64
fn first[T](a: T, b: T) -> Option[T]:
    return Some(a)
fn main() -> i32:
    let o = first(V2(x: 25, y: 38), V2(x: 0, y: 0))
    let v = o.unwrap()
    return (v.x + v.y) as i32
