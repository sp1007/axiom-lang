// BUG#78 regression: an array literal containing a `None` element. Array elements
// are stored via OP_STORE with the element type; for an Option that is pointer-repr
// (the value IS an 8-byte box pointer, entry.size 16), so it must be stored/loaded
// as an 8-byte pointer -- not block-copied as a 16-byte aggregate. Block-copying a
// `None` (null pointer) read from address 0 and segfaulted at construction. Some(x)/
// None infer to a GENERIC_INST named "Option", so the fix uses type_is_pointer_repr
// (kind 6/11/12, or a kind-8 GENERIC_INST whose base name is Option/Result).
fn main() -> i32:
    let arr = [Some(3 as i32), None, Some(7 as i32)]
    mut sum := 0 as i32
    mut i := 0 as i64
    while i < 3 as i64:
        let o = arr[i]
        match o:
            Some(x):
                sum = sum + x
            None:
                sum = sum + 100 as i32
        i = i + 1 as i64
    return sum     // 3 + 100 + 7 = 110
