// catch-all binding pattern (binds whole scrutinee)
type Color = Red | Green | Blue
fn rank(c: Color) -> i64:
    match c:
        Red:
            return 1 as i64
        other:
            return 9 as i64
pub fn main() -> i32:
    return (rank(Red) + rank(Green) + rank(Blue)) as i32   // 1+9+9 = 19
