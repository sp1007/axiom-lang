// B5: parse errors inside an IMPORTED module must halt the build, exactly as parse errors
// in the main unit do (main_air: `error: N parse error(s); aborting before code
// generation`). Pre-fix this program printed the module's diagnostics and then produced a
// working executable that printed 42 -- errors reported, build "successful".
// The member called here is a perfectly good one; the rejection comes from the module.
import bin.t_modparseerrlib

fn main() -> i64:
    println("không được biên dịch tới đây: ", bin.t_modparseerrlib.ok(41))
    return 0
