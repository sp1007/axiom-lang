// Oracle for [[bug-malformed-input-robustness-cluster]] m5: an explicit
// `let x: <numeric> = <string literal>` (or a numeric literal assigned to a
// str-typed binding) must be REJECTED, not silently miscompiled to garbage.
fn main() -> i64:
    let x: i64 = "hello"    // str literal into an i64 binding -> reject
    return x
