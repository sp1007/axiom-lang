// RFC 0006 §4 (E3032): assignment to a binding whose type the programmer ANNOTATED.
// Shares the annotation gate with E3030/E3031, so an INFERRED `mut x := 1.5; x = d` is
// NOT covered -- recorded as an out-of-scope item in the RFC, not an oversight.
fn main() -> i64:
    let d: f64 = 3.5
    mut x: f32 = 1.0
    x = d
    return x as i64
