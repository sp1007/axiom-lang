// chained Vec HOF: map (double) then fold (sum)
fn dbl(x: i64) -> i64:
    return x * 2

fn add(a: i64, b: i64) -> i64:
    return a + b

fn main() -> i64:
    mut v: Vec[i64] = Vec.new()
    v.push(3)
    v.push(4)
    v.push(7)
    let doubled = v.map(dbl)      // [6,8,14]
    return doubled.fold(0, add)   // 28... want 28
