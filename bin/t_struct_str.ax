struct Foo:
    s: str
    n: i64

pub fn main() -> i32:
    let f = @alloc(64) as ptr[Foo]
    f[0] = Foo(s: "hello world", n: 11 as i64)
    mut sum := 0 as i64
    mut i := 0 as i64
    while i < f.n:
        sum = sum + (f.s[i] as i64)
        i = i + 1 as i64
    return (sum % 100 as i64) as i32
