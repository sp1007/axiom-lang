// RFC 0003: enum no-payload — end-to-end build+run
enum Color:
    Red
    Green
    Blue

fn rank(c: Color) -> i64:
    match c:
        Red:
            return 1 as i64
        Green:
            return 2 as i64
        Blue:
            return 3 as i64

pub fn main() -> i32:
    return (rank(Red) + rank(Green) + rank(Blue)) as i32
