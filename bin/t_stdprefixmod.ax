// B2: a module whose name merely STARTS WITH `std` is not a std module. The import-line
// test is now an EXACT match against the one table of textually-handled module names, so
// there is a name boundary by construction. Pre-fix this line was blanked and the program
// died with `undefined name 'std_util'`; renaming the module to `xstd_util` made it work,
// which is how the over-match was found.
import std_util

fn main() -> i64:
    println("module tên bắt đầu bằng std: ", std_util.answer())
    return 0
