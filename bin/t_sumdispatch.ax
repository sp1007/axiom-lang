// Oracle (exit 31): a sum with 1-field, 2-field, and str-payload variants; match
// binds all and dispatches. 9 (Circle 3*3) + 20 (Rect 4*5) + 2 (len "hi") = 31.
type Shape = Circle(i64) | Rect(i64, i64) | Named(str)
fn area(sh: Shape) -> i64:
    match sh:
        Circle(r):
            return r * r
        Rect(w, h):
            return w * h
        Named(n):
            return n.len
fn main() -> i64:
    return area(Circle(3 as i64)) + area(Rect(4 as i64, 5 as i64)) + area(Named("hi"))
