interface M:
    fn val(self: Self) -> f64
struct A:
    f: f32
    fn val(self: A) -> f64:
        return (self.f as f64) * 2.0
struct B:
    d: f64
    fn val(self: B) -> f64:
        return self.d + 0.5
fn tot(m: M) -> f64:
    let v = m.val()
    return v
fn main() -> i64:
    let a = tot(A(f: 1.5))   // 3.0
    let b = tot(B(d: 2.5))   // 3.0
    let s = a + b            // 6.0
    if s > 5.99 and s < 6.01:
        return 42
    return (s * 10.0) as i64
