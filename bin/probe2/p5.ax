fn main() -> i64:
    mut outer: Vec[Vec[i64]] = Vec[Vec[i64]].new()
    mut i: i64 = 0
    while i < 3:
        mut inner: Vec[i64] = Vec[i64].new()
        inner.push(i * 10)
        inner.push(i * 10 + 1)
        outer.push(inner)
        i = i + 1
    mut sum: i64 = 0
    mut k: i64 = 0
    while k < outer.len:
        let row = outer.get(k).unwrap()
        sum = sum + row.get(0).unwrap() + row.get(1).unwrap()
        k = k + 1
    return sum   // (0+1)+(10+11)+(20+21) = 63
