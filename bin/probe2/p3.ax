fn main() -> i64:
    let a: f32 = 1.5
    let b: f64 = 2.5
    let c: f64 = (a as f64) + b       // 4.0
    let d: f32 = a * 2.0              // 3.0
    mut r: i64 = 0
    if c > 3.99 and c < 4.01:
        r = r + 1
    if d > 2.99 and d < 3.01:
        r = r + 2
    let e = (d as f64) + c            // 7.0
    if e > 6.99 and e < 7.01:
        r = r + 4
    return r   // expect 7
