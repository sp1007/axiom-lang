// HISTORICAL REPRO — this program is now REJECTED on purpose (error[E3030], RFC 0006 §6.1,
// user decision D1 2026-07-30). It measured the OLD behaviour: the out-of-range literal was
// kept at full width (300, not 44) with no diagnostic. A failed build here is the FIX, not a
// regression. See knowledge/question-out-of-range-narrow-int-literal.md.
fn pick[T](a: T, b: T) -> T:
    return a
fn main() -> i64:
    let b = pick[u8](300, 1) as i64
    if b == 300:
        return 42        // b is really 300 -> u8 literal NOT narrowed
    if b == 44:
        return 43        // b is really 44  -> narrowed correctly
    return 99
