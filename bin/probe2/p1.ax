mut log: i64 = 0
fn bump1() -> i64:
    log = log + 1
    return 0
fn bump10() -> i64:
    log = log + 10
    return 0
fn f(n: i64) -> i64:
    defer bump1()
    if n > 5:
        return 10
    defer bump10()
    return 20
fn main() -> i64:
    let a = f(9)     // only first defer -> log += 1
    let b = f(1)     // both -> log += 11
    return a + b + log   // 10 + 20 + 12 = 42
