fn pick(n: i64) -> Option[str]:
    if n > 0:
        return Some("yes")
    return None
fn tryit(n: i64) -> Result[str, str]:
    if n > 0:
        return Ok("okay")
    return Err("bad")
fn main() -> i64:
    mut r: i64 = 0
    let a = pick(1)
    if a.unwrap().len == 3:
        r = r + 1
    let b = tryit(1)
    if b.unwrap().len == 4:
        r = r + 2
    let c = pick(0)
    if c.is_none():
        r = r + 4
    return r   // expect 7
