mut ord: i64 = 0
fn m1() -> i64:
    ord = ord * 10 + 1
    return 0
fn m2() -> i64:
    ord = ord * 10 + 2
    return 0
fn f() -> i64:
    defer m1()
    defer m2()
    return 5
fn main() -> i64:
    let x = f()
    // LIFO defers -> ord = 21 ; x = 5
    let y: i64 = 3
    mut sum: i64 = 0
    if true:
        let y: i64 = 10
        sum = sum + y
    sum = sum + y
    // sum = 13
    return x + ord + sum   // 5 + 21 + 13 = 39
