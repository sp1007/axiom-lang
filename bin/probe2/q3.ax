struct V:
    x: f32
    fn neg(self: V) -> f32:
        return 0.0 - self.x
fn main() -> i64:
    let v = V(x: 2.5)
    let n = v.neg()
    mut r: i64 = 0
    if n == -2.5:
        r = r + 1
    if n < 0.0:
        r = r + 2
    let d: f64 = -3000000000.5
    if d < -2999999999.0:
        r = r + 4
    return r   // expect 7
