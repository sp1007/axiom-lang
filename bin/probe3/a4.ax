fn apply[T](v: T, f: fn(T) -> T) -> T:
    return f(v)
fn dbl(x: i64) -> i64:
    return x * 2
fn main() -> i64:
    mut r: i64 = 0
    if apply[i64](10, dbl) == 20:
        r = r + 1
    if apply(21, dbl) == 42:
        r = r + 2
    mut v: Vec[i64] = Vec[i64].new()
    v.push(1)
    v.push(2)
    v.push(3)
    let s = v.fold(0, |acc: i64, x: i64| -> i64 acc + x)
    if s == 6:
        r = r + 4
    if r == 7:
        return 42
    return r
