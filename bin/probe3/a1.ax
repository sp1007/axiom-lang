fn main() -> i64:
    mut m: HashMap[str, i64] = HashMap[str, i64].new()
    m.insert("one", 1)
    m.insert("two", 2)
    m.insert("one", 10)          // overwrite
    mut r: i64 = 0
    if m.get("one").unwrap() == 10:
        r = r + 1
    if m.get("two").unwrap() == 2:
        r = r + 2
    if m.len == 2:
        r = r + 4
    if m.get("nope").is_none():
        r = r + 8
    mut sum: i64 = 0
    for k in m:
        sum = sum + m.get(k).unwrap()
    if sum == 12:
        r = r + 16
    if r == 31:
        return 42
    return r
