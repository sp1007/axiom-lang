fn main() -> i64:
    let s = "hello"
    mut r: i64 = 0
    if s.len == 5:
        r = r + 1
    let a = s.slice(0, 5)
    if a.len == 5:
        r = r + 2
    let b = s.slice(2, 2)        // empty slice
    if b.len == 0:
        r = r + 4
    let c = s.slice(1, 4)
    if c.len == 3:
        r = r + 8
    if r == 15:
        return 42
    return r
