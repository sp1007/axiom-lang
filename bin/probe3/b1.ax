mut ga: i64 = 5
mut gb: i64 = 0
mut arr: [i64; 3] = [1, 2, 3]
fn bump() -> i64:
    gb = gb + ga
    return gb
fn main() -> i64:
    mut r: i64 = 0
    if ga == 5:
        r = r + 1
    if bump() == 5:
        r = r + 2
    if bump() == 10:
        r = r + 4
    if arr[0] + arr[1] + arr[2] == 6:
        r = r + 8
    arr[1] = 20
    if arr[1] == 20:
        r = r + 16
    if r == 31:
        return 42
    return r
