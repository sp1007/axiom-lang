struct Rec:
    name: str
    n: i64
fn main() -> i64:
    mut v: Vec[Rec] = Vec[Rec].new()
    v.push(Rec(name: "alpha", n: 1))
    v.push(Rec(name: "be", n: 2))
    mut r: i64 = 0
    let a = v.get(0).unwrap()
    if a.name.len == 5 and a.n == 1:
        r = r + 1
    let b = v.get(1).unwrap()
    if b.name.len == 2 and b.n == 2:
        r = r + 2
    mut arr: [Rec; 2] = [Rec(name: "xx", n: 7), Rec(name: "yyy", n: 8)]
    if arr[0].name.len == 2 and arr[1].name.len == 3:
        r = r + 4
    arr[0].n = 70
    if arr[0].n == 70 and arr[1].n == 8:
        r = r + 8
    if r == 15:
        return 42
    return r
