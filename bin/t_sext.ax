// Isolate i32 -> i64 sign-extension bug
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32
fn zpn(tag: i64, v: i64):
    putchar(tag as i32); putchar('=' as i32)
    mut x := v
    if x < 0 as i64:
        putchar('-' as i32); x = 0 as i64 - x
    if x == 0 as i64:
        putchar('0' as i32)
    mut b := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        b[n] = ('0' as u8) + (x % 10 as i64) as u8; n = n + 1 as i64; x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        putchar(b[j] as i32); j = j - 1 as i64
    putchar(' ' as i32); fflush(null as ptr[void])
pub fn main() -> i32:
    // 1) literal i32 -1 -> i64
    let c: i32 = -1 as i32
    zpn('C' as i64, c as i64)          // expect -1

    // 2) i32 var holding -1 from arithmetic
    mut d: i32 = 0 as i32
    d = d - 1 as i32
    zpn('D' as i64, d as i64)          // expect -1

    // 3) i32 loaded from memory (0xFFFFFFFF bytes)
    let p = @alloc(4) as ptr[i32]
    p[0] = -1 as i32
    zpn('M' as i64, p[0] as i64)       // expect -1

    // 4) comparison i32 == -1
    mut f1 := 0 as i64
    if c == -1 as i32:
        f1 = 1 as i64
    zpn('E' as i64, f1)                // expect 1

    mut f2 := 0 as i64
    if p[0] == -1 as i32:
        f2 = 1 as i64
    zpn('P' as i64, f2)                // expect 1

    putchar(10 as i32); fflush(null as ptr[void])
    return 0
