// Vec.zip with U != T: two distinct generic params meeting in one tuple element.
fn main() -> i64:
    mut a: Vec[i64] = Vec.new()
    a.push(7)
    a.push(9)
    mut b: Vec[str] = Vec.new()
    b.push("xy")
    b.push("zzz")
    let z = a.zip(b)
    mut acc := 0 as i64
    mut i := 0 as i64
    while i < z.len:
        let p = z.get(i).unwrap()
        acc = acc + p.0 + p.1.len
        i = i + 1
    return acc   // (7+2) + (9+3) = 21
