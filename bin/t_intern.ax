extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn zpc(c: i64):
    putchar(c as i32)
    fflush(null as ptr[void])

fn zpn(tag: i64, v: i64):
    zpc(tag)
    zpc('=' as i64)
    mut x := v
    if x == 0 as i64:
        zpc('0' as i64)
    mut buf := @alloc(32) as ptr[u8]
    mut n := 0 as i64
    while x > 0 as i64:
        buf[n] = ('0' as u8) + (x % 10 as i64) as u8
        n = n + 1 as i64
        x = x / 10 as i64
    mut j := n - 1 as i64
    while j >= 0 as i64:
        zpc(buf[j] as i64)
        j = j - 1 as i64
    zpc(' ' as i64)

// 24-byte entry like InternEntry
struct ZIE:
    hash: u32
    padding: u32
    start: u32
    len: u32
    id: u32
    dummy: u32

struct ZIP:
    table: ptr[ZIE]
    table_size: i64
    count: i64

fn zmk() -> ptr[ZIP]:
    let table_size = 512 as i64
    let table = @alloc(table_size * 24) as ptr[ZIE]
    mut i := 0 as i64
    while i < table_size:
        table[i] = ZIE(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1
    let p = @alloc(24) as ptr[ZIP]
    p.table = table
    p.table_size = table_size
    p.count = 0
    return p

fn zgrow(mut self: ptr[ZIP]):
    let old_size = self.table_size
    let new_size = old_size * 2
    let new_table = @alloc(new_size * 24) as ptr[ZIE]
    mut i := 0 as i64
    while i < new_size:
        new_table[i] = ZIE(hash: 0 as u32, padding: 0 as u32, start: 0 as u32, len: 0 as u32, id: 0 as u32, dummy: 0 as u32)
        i = i + 1
    let mask = new_size - 1
    i = 0
    while i < old_size:
        let entry = self.table[i]
        if entry.id != 0 as u32:
            mut idx = (entry.hash as i64) & mask
            while new_table[idx].id != 0 as u32:
                idx = (idx + 1) & mask
            new_table[idx] = entry
        i = i + 1
    self.table = new_table
    self.table_size = new_size

// intern by integer key (hash=key); returns id, consistent for same key
fn zintern(mut self: ptr[ZIP], key: u32) -> u32:
    let h = key
    let mask = self.table_size - 1
    mut idx = (h as i64) & mask
    while true:
        let entry = self.table[idx]
        if entry.id == 0 as u32:
            // insert
            let new_id = (self.count + 1) as u32
            self.table[idx] = ZIE(hash: h, padding: 0 as u32, start: 0 as u32, len: key, id: new_id, dummy: 0 as u32)
            self.count = self.count + 1
            if (self.count * 100) / self.table_size > 70:
                self.zgrow()
            return new_id
        if entry.hash == h and entry.len == key:
            return entry.id
        idx = (idx + 1) & mask
    return 0 as u32

pub fn main() -> i32:
    let p = zmk()
    // intern keys 1..600 -> triggers grows; record ids
    let ids = @alloc(601 * 4) as ptr[u32]
    mut k := 1 as u32
    while k < 601 as u32:
        ids[k] = zintern(p, k)
        k = k + 1 as u32
    zpn('C' as i64, p.count)
    zpn('T' as i64, p.table_size)
    // re-intern same keys: must return SAME id (no new inserts)
    mut bad := 0 as i64
    mut k2 := 1 as u32
    while k2 < 601 as u32:
        let again = zintern(p, k2)
        if again != ids[k2]:
            bad = bad + 1
        k2 = k2 + 1 as u32
    zpn('D' as i64, p.count)  // should be unchanged (600)
    zpn('B' as i64, bad)        // should be 0
    zpc(10 as i64)
    return 0
