// HashMap with an aggregate Vec value; get + iterate the value.
import std.collections
fn main() -> i64:
    mut m = HashMap[i64, Vec[i64]].new()
    mut a = Vec[i64].new()
    a.push(40)
    a.push(2)
    m.insert(1, a)
    match m.get(1):
        Some(v):
            mut t: i64 = 0
            for x in v:
                t = t + x
            return t
        None:
            return 0
