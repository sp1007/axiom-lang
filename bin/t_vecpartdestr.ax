// partition's (Vec[T], Vec[T]) return consumed by tuple destructuring (RFC 0022 P3).
fn main() -> i64:
    mut v: Vec[i64] = Vec.new()
    v.push(5)
    v.push(30)
    v.push(3)
    v.push(20)
    let (lo, hi) = v.partition(|x: i64| -> bool x < 10)
    return lo.len * 10 + hi.len + lo.data[0] + hi.data[0]   // 20 + 2 + 5 + 30 = 57
