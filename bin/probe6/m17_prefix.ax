// CONTROL: PREFIX collision (`r32_p32` starts with `r32`) instead of suffix.
interface I:
    fn r32_p32(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S:
    k: i64
    fn r32_p32(self: S) -> i64:
        return 7
    fn r32(self: S) -> i64:
        return 42
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r32()
