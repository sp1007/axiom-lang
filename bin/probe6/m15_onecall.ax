// SMALLEST REPRO: ONE dispatch call, no arguments, no floats. The interface has a
// method whose name ends with "_" + another method's name.
interface I:
    fn p32_r32(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S:
    k: i64
    fn p32_r32(self: S) -> i64:
        return 7
    fn r32(self: S) -> i64:
        return 42
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r32()
