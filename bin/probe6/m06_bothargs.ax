// VARIANT: BOTH dispatch calls take an f32 arg and return f32.
interface I:
    fn p(self: Self, a: f32) -> f32
    fn q(self: Self, a: f32) -> f32
struct S:
    k: i64
    fn p(self: S, a: f32) -> f32:
        return a
    fn q(self: S, a: f32) -> f32:
        return a + 1.0
fn main() -> i64:
    let i: I = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.q(av)
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
