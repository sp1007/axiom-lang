// CONTROL: call #1 takes an f32 arg but returns i64.
interface I:
    fn p(self: Self, a: f32) -> i64
    fn r(self: Self) -> f32
struct S:
    k: i64
    fn p(self: S, a: f32) -> i64:
        return 1
    fn r(self: S) -> f32:
        return 2.5
fn main() -> i64:
    let i: I = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p(av)
    if b3 != 1:
        return 60 + b3
    let b = i.r()
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
