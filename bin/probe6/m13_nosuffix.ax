// CONTROL for m12: same shape, names that do NOT share a suffix.
interface I:
    fn p32_q32(self: Self, a: f32) -> f32
    fn r32(self: Self) -> f32
struct S:
    k: i64
    fn p32_q32(self: S, a: f32) -> f32:
        return a
    fn r32(self: S) -> f32:
        return 2.5
fn main() -> i64:
    let i: I = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p32_q32(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.r32()
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
