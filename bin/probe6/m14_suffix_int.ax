// Is the suffix effect type-independent? All i64, names share a suffix.
interface I:
    fn p32_r32(self: Self, a: i64) -> i64
    fn r32(self: Self) -> i64
struct S:
    k: i64
    fn p32_r32(self: S, a: i64) -> i64:
        return a
    fn r32(self: S) -> i64:
        return 2
fn main() -> i64:
    let i: I = S(k: 0)
    let b3 = i.p32_r32(1)
    if b3 != 1:
        return 60 + b3
    let b = i.r32()
    if b != 2:
        return 100 + b
    return 42
