// TYPE CONFUSION: the wrongly-selected method returns f64 (XMM0) while the call site
// is typed i64 (RAX).
struct S:
    n: i64
    fn a_r(self: S) -> f64:
        return 2.5
    fn r(self: S) -> i64:
        return 42
fn main() -> i64:
    let s = S(n: 0)
    let v = s.r()
    if v != 42:
        return 100
    return 42
