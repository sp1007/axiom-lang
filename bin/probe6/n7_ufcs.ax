// Replica of the ONE collision inside the compiler's own sources:
// TypeChecker.interface_method_ret_type (declared first) vs TypeChecker.method_ret_type.
// Module-level UFCS form (self as an explicit ptr param), NOT an inline struct method.
struct T:
    n: i64

pub fn interface_method_ret_type(self: ptr[T], a: u32, b: u32) -> i64:
    return 7

pub fn method_ret_type(self: ptr[T], a: u32, b: u32) -> i64:
    return 42

fn main() -> i64:
    mut t := T(n: 0)
    return (&t).method_ret_type(1 as u32, 2 as u32)
