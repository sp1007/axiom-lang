// CONTROL: identical shape but f64 throughout.
interface I:
    fn p(self: Self, a: f64) -> f64
    fn r(self: Self) -> f64
struct S:
    k: i64
    fn p(self: S, a: f64) -> f64:
        return a
    fn r(self: S) -> f64:
        return 2.5
fn main() -> i64:
    let i: I = S(k: 0)
    let av: f64 = 1.5
    let b3 = i.p(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.r()
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
