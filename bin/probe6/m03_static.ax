// CONTROL: same shape, STATIC method calls (no interface).
struct S:
    k: i64
    fn p(self: S, a: f32) -> f32:
        return a
    fn r(self: S) -> f32:
        return 2.5
fn main() -> i64:
    let i: S = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.r()
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
