// Same pair but declared INLINE inside the struct block (mangled `T.name`).
struct T:
    n: i64
    fn interface_method_ret_type(self: T, a: u32, b: u32) -> i64:
        return 7
    fn method_ret_type(self: T, a: u32, b: u32) -> i64:
        return 42
fn main() -> i64:
    let t = T(n: 0)
    return t.method_ret_type(1 as u32, 2 as u32)
