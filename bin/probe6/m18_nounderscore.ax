// CONTROL: suffix WITHOUT the `_` separator (`pxxr32` ends with `r32`, prev char 'x').
interface I:
    fn pxxr32(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S:
    k: i64
    fn pxxr32(self: S) -> i64:
        return 7
    fn r32(self: S) -> i64:
        return 42
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r32()
