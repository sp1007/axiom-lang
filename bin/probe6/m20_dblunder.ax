// CONTROL: `__`-bounded MIDDLE match (`r32__z` contains `r32` followed by `__`).
interface I:
    fn r32__z(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S:
    k: i64
    fn r32__z(self: S) -> i64:
        return 7
    fn r32(self: S) -> i64:
        return 42
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r32()
