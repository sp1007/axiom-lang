fn ret_f64_from_int() -> f64:
    return 7
struct Mixed:
    i: i32
    f: f64
fn main() -> i64:
    if ret_f64_from_int() != 7.0:
        return 8
    let farr: [f64; 3] = [1, 2.5, 3]
    if farr[0] != 1.0:
        return 9
    let mx = Mixed(i: 4, f: 5)
    if mx.f != 5.0:
        return 12
    return 42
