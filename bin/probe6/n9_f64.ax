// BREADTH: f64 return through dispatch, colliding names.
interface I:
    fn p_r(self: Self) -> f64
    fn r(self: Self) -> f64
struct S:
    k: i64
    fn p_r(self: S) -> f64:
        return 7.0
    fn r(self: S) -> f64:
        return 42.0
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r() as i64
