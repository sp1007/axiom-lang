// CONTROL: call #1 takes an i64 arg (not float) and returns f32.
interface I:
    fn p(self: Self, a: i64) -> f32
    fn r(self: Self) -> f32
struct S:
    k: i64
    fn p(self: S, a: i64) -> f32:
        return 1.5
    fn r(self: S) -> f32:
        return 2.5
fn main() -> i64:
    let i: I = S(k: 0)
    let b3 = i.p(7)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    let b = i.r()
    if (b as i64) != 2:
        return 100 + (b as i64)
    return 42
