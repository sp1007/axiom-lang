// BREADTH: does the same wrong-slot selection reach a `str` return through dispatch?
interface I:
    fn p32_r32(self: Self) -> str
    fn r32(self: Self) -> str
struct S:
    k: i64
    fn p32_r32(self: S) -> str:
        return "wrong"
    fn r32(self: S) -> str:
        return "right"
fn main() -> i64:
    let i: I = S(k: 0)
    let s = i.r32()
    if s == "right":
        return 42
    return 7
