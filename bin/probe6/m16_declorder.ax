// CONTROL for m15: identical, but the SHORT-named method is declared FIRST.
interface I:
    fn r32(self: Self) -> i64
    fn p32_r32(self: Self) -> i64
struct S:
    k: i64
    fn r32(self: S) -> i64:
        return 42
    fn p32_r32(self: S) -> i64:
        return 7
fn main() -> i64:
    let i: I = S(k: 0)
    return i.r32()
