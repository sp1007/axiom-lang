// VARIANT: second dispatch result consumed IMMEDIATELY (no let binding).
interface I:
    fn p(self: Self, a: f32) -> f32
    fn r(self: Self) -> f32
struct S:
    k: i64
    fn p(self: S, a: f32) -> f32:
        return a
    fn r(self: S) -> f32:
        return 2.5
fn main() -> i64:
    let i: I = S(k: 0)
    let av: f32 = 1.5
    let b3 = i.p(av)
    if (b3 as i64) != 1:
        return 60 + (b3 as i64)
    if (i.r() as i64) != 2:
        return 100 + (i.r() as i64)
    return 42
