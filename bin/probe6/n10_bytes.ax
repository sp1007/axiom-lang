// BREADTH: bytes return through dispatch, colliding names.
interface I:
    fn p_r(self: Self) -> bytes
    fn r(self: Self) -> bytes
struct S:
    k: i64
    fn p_r(self: S) -> bytes:
        return "A" as bytes
    fn r(self: S) -> bytes:
        return "B" as bytes
fn main() -> i64:
    let i: I = S(k: 0)
    let b = i.r()
    if b[0] == 'B' as u8:
        return 42
    return 7
