// Oracle (exit 112): the CORRECT counterpart to the Option-arith miscompile — values
// must be .unwrap()'d before arithmetic. 5+7=12, +100 (is_some true) = 112.
import std.collections
fn main() -> i64:
    mut a = new_vec[i64]()
    a.push(5 as i64)
    a.push(7 as i64)
    mut r = a.get(0).unwrap() + a.get(1).unwrap()
    if a.get(0).is_some():
        r = r + 100
    return r
