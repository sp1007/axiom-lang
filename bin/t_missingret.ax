// Oracle: a non-void function whose body falls off the end (bare tail expression,
// no `return`) MUST be rejected. AXIOM has no implicit last-expression return, so
// without this diagnostic the function silently returns a garbage register.
// Expected: compile ERROR (no executable emitted).
fn f(n: i64) -> i64:
    n + 1

fn main() -> i64:
    return f(41)
