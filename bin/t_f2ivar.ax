// RFC 0006 §4 (E3031): the same rule when the float is a VARIABLE rather than a literal.
// `let a: i64 = f` with `f: f64` reinterpreted f's bits as an integer just like the literal
// form did (measured: returned the >4e9 branch). A plain IDENT's declared type is ground
// truth read straight from its symbol, so no inference is involved in this reject.
fn main() -> i64:
    let f: f64 = 3.0
    let a: i64 = f
    return a
