// -O2/-O3 structural-pass guard: function call inside a loop body (exercises
// caller-save/clobber interaction with strength_reduction/loop_unroll).
fn sq(x: i64) -> i64:
    return x * x
fn main() -> i64:
    mut s := 0
    mut i := 0
    while i < 20:
        s = s + sq(i)
        i = i + 1
    return s % 233
