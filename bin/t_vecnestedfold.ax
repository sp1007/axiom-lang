fn main() -> i64:
    mut outer := Vec[Vec[i64]].new()
    mut a := Vec[i64].new()
    a.push(1)
    a.push(2)
    mut b := Vec[i64].new()
    b.push(3)
    outer.push(a)
    outer.push(b)
    // sum of inner lens = 2+1 = 3 ... use *14 = 42
    let s = outer.fold(0 as i64, |acc: i64, inner: Vec[i64]| -> i64 acc + inner.len)
    return s * 14
