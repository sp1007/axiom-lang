// Standalone copy of the REAL x86_encode_mov_rr + its full call chain, to repro
// BUG#31 (addr-taken `modrm` read stale) in isolation. Emits `mov %rsp,%rbp`
// which must be 48 89 e5. If modrm reads stale 0 -> third byte 00.
extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

const MOD_REG_DIRECT: u8 = 0b11
const REX_BASE: u8 = 0x40
const REX_W:    u8 = 0x08
const REX_R:    u8 = 0x04
const REX_B:    u8 = 0x01

struct ByteVec:
    data: ptr[u8]
    len: i64
    cap: i64

fn push_byte(mut self: ptr[ByteVec], b: u8):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let new_data = @alloc(new_cap) as ptr[u8]
        if self.data != null as ptr[u8]:
            @memcpy(new_data, self.data, self.len)
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = b
    self.len = self.len + 1

fn reg_hw_reg(r: u8) -> u8:
    return r & 15 as u8

fn reg_needs_rex(r: u8) -> bool:
    return reg_hw_reg(r) >= 8 as u8

fn encode_rex(w: bool, r: bool, x: bool, b: bool) -> u8:
    mut rex := REX_BASE
    if w:
        rex = rex | REX_W
    if r:
        rex = rex | REX_R
    if x:
        rex = rex | REX_B
    return rex

fn x86_encode_modrm_rr(reg: u8, rm: u8, out_modrm: ptr[u8], out_rex: ptr[u8], out_need_rex: ptr[bool]):
    let reg_field = reg_hw_reg(reg)
    let rm_field = reg_hw_reg(rm)
    out_modrm[0] = (MOD_REG_DIRECT << 6 as u8) | ((reg_field & 7 as u8) << 3 as u8) | (rm_field & 7 as u8)
    let reg_need = reg_needs_rex(reg)
    let rm_need = reg_needs_rex(rm)
    if reg_need or rm_need:
        out_need_rex[0] = true
        mut rex := REX_BASE
        if reg_need:
            rex = rex | REX_R
        if rm_need:
            rex = rex | REX_B
        out_rex[0] = rex
    else:
        out_need_rex[0] = false
        out_rex[0] = 0 as u8

fn x86_encode_mov_rr(dst: u8, src: u8, buf: ptr[ByteVec]):
    mut modrm := 0 as u8
    mut rex := 0 as u8
    mut need_rex := false
    x86_encode_modrm_rr(src, dst, &modrm, &rex, &need_rex)
    if need_rex:
        rex = rex | REX_W
        push_byte(buf, rex)
    else:
        push_byte(buf, encode_rex(true, false, false, false))
    push_byte(buf, 0x89 as u8)
    push_byte(buf, modrm)

fn pb(v: i64):
    mut x := v
    putchar(('0' as i32) + ((x as i32) / 100))
    putchar(('0' as i32) + (((x as i32) / 10) % 10))
    putchar(('0' as i32) + ((x as i32) % 10))
    putchar(' ' as i32)

pub fn main() -> i32:
    mut bv := ByteVec(data: null as ptr[u8], len: 0, cap: 0)
    // mov %rsp(4),%rbp(5) -> 48 89 e5 (72 137 229)
    x86_encode_mov_rr(5 as u8, 4 as u8, &bv)
    mut k := 0 as i64
    while k < bv.len:
        pb(bv.data[k] as i64)
        k = k + 1
    putchar(10 as i32); fflush(null as ptr[void])
    return 0
