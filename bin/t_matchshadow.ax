// Nested match where the inner payload var shadows the outer.
fn main() -> i64:
    let a: Option[i64] = Some(40)
    let b: Option[i64] = Some(2)
    match a:
        Some(x):
            match b:
                Some(x):
                    return x + 40
                None:
                    return x
        None:
            return 0
