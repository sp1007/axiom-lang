// RFC 0006 §4 (E3031): an array-literal ELEMENT under an ANNOTATED integer element type.
// An UNANNOTATED `let a = [1, 2.5]` is deliberately outside the rule (the element type is
// inferred, not written) -- same boundary E3030 draws.
fn main() -> i64:
    let a: [i32; 3] = [1, 2.5, 3]
    return a[1] as i64
