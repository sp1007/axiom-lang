extern "C" fn putchar(c: i32) -> i32
extern "C" fn fflush(s: ptr[void]) -> i32

fn pc(c: i64):
    putchar(c as i32)
    fflush(null as ptr[void])

pub fn main() -> i32:
    mut v := 12345 as i64
    mut buf := @alloc(32) as ptr[u8]
    mut len := 0
    while v > 0:
        buf[len] = '0' as u8 + (v % 10) as u8
        len = len + 1
        v = v / 10
    pc('L' as i64)
    pc('0' as i64 + len as i64)   // len after digit loop
    mut i := 0
    while i < len / 2:
        pc('<' as i64)
        pc('0' as i64 + i as i64)
        pc('=' as i64)
        pc('0' as i64 + len as i64)
        let tmp = buf[i]
        buf[i] = buf[len - 1 - i]
        buf[len - 1 - i] = tmp
        pc('>' as i64)
        i = i + 1
    pc('!' as i64)
    return 0
