// Oracle (exit=3): match on Result[str, str] with a str payload on BOTH arms;
// the payload length is read from the taken arm.
fn pick(k: i64) -> Result[str, str]:
    if k == 0:
        return Ok("yes")
    return Err("no")
fn main() -> i32:
    match pick(0):
        Ok(s):
            return s.len as i32   // "yes" = 3
        Err(e):
            return e.len as i32
