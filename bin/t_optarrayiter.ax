// Regression: for-in over a fixed array of Option, including a None, summing Some.
fn main() -> i64:
    let arr: [Option[i64]; 4] = [Some(100), None, Some(20), Some(3)]
    mut total: i64 = 0
    for o in arr:
        match o:
            Some(v):
                total = total + v
            None:
                total = total + 0
    return total
