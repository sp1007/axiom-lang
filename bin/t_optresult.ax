// Option[Result[i64,i64]] nested generic payload, doubly matched.
fn f(b: bool) -> Option[Result[i64, i64]]:
    if b:
        return Some(Ok(42))
    return None
fn main() -> i64:
    match f(true):
        Some(r):
            match r:
                Ok(v):
                    return v
                Err(e):
                    return e
        None:
            return 0
