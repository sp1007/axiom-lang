// RFC 0029 §9: dynamic dispatch must coerce ARGUMENTS to the interface method's declared
// parameter types, exactly as a static call does. Before the fix every dispatch argument
// that needed a conversion instruction was passed unconverted -- an f64 literal handed to
// an f32 parameter left the callee reading the double's zero low half, so `i.one32(1.5)`
// delivered exactly 0.0 (accept-then-miscompile, BUG#53 class).
//
// Every check is made INSIDE the program (exit codes are 8-bit; see
// knowledge/lesson-exit-code-8bit-masking) and every row has a distinct small code, so a
// failure names the row. Rows from the already-CORRECT column are included on purpose: a
// new argument-coercion path can overreach, and on the last three float fixes it was the
// already-correct rows that caught the bad assertion.
//
// Each callee VERIFIES its own parameters and returns an integer code built from distinct
// per-slot contributions, so a dropped argument, a zero argument and a swapped pair are all
// distinguishable. Values are exact in binary (1.5, 2.25, 3.75, 0.5, 6.5) so no comparison
// depends on rounding. Returns are i64 throughout: this oracle pins PARAMETER passing, and
// an f32 return would drag in an unrelated dispatch-return defect.
interface I:
    fn one32(self: Self, a: f32) -> i64
    fn one64(self: Self, a: f64) -> i64
    fn two32(self: Self, a: f32, b: f32) -> i64
    fn afteri(self: Self, n: i64, a: f32) -> i64
    fn after64(self: Self, d: f64, a: f32) -> i64
    fn mix(self: Self, a: f32, d: f64, n: i64, b: f32) -> i64
    fn i32p(self: Self, a: i32) -> i64
    fn u8p(self: Self, a: u8) -> i64

struct S:
    k: i64

    // a == 1.5 -> 1
    fn one32(self: S, a: f32) -> i64:
        if a > 1.49 and a < 1.51:
            return 1
        return 0

    // d == 1.5 -> 1
    fn one64(self: S, d: f64) -> i64:
        if d > 1.49 and d < 1.51:
            return 1
        return 0

    // a == 1.5 -> +1, b == 2.25 -> +2  (swap gives 0, dropped b gives 1)
    fn two32(self: S, a: f32, b: f32) -> i64:
        mut r := 0 as i64
        if a > 1.49 and a < 1.51:
            r = r + 1 as i64
        if b > 2.24 and b < 2.26:
            r = r + 2 as i64
        return r

    // n == 7 -> +1, a == 3.75 -> +2  (the f32 sits in slot 2, after an integer)
    fn afteri(self: S, n: i64, a: f32) -> i64:
        mut r := 0 as i64
        if n == 7 as i64:
            r = r + 1 as i64
        if a > 3.74 and a < 3.76:
            r = r + 2 as i64
        return r

    // d == 0.5 -> +1, a == 6.5 -> +2  (the f32 sits in slot 2, after an f64)
    fn after64(self: S, d: f64, a: f32) -> i64:
        mut r := 0 as i64
        if d > 0.49 and d < 0.51:
            r = r + 1 as i64
        if a > 6.49 and a < 6.51:
            r = r + 2 as i64
        return r

    // four slots, a distinct value in each: 1 + 2 + 4 + 8 = 15 when all arrive intact
    fn mix(self: S, a: f32, d: f64, n: i64, b: f32) -> i64:
        mut r := 0 as i64
        if a > 1.49 and a < 1.51:
            r = r + 1 as i64
        if d > 0.49 and d < 0.51:
            r = r + 2 as i64
        if n == 7 as i64:
            r = r + 4 as i64
        if b > 6.49 and b < 6.51:
            r = r + 8 as i64
        return r

    fn i32p(self: S, a: i32) -> i64:
        if (a as i64) == 5 as i64:
            return 1
        return 0

    fn u8p(self: S, a: u8) -> i64:
        if (a as i64) == 200 as i64:
            return 1
        return 0

fn main() -> i64:
    let s = S(k: 0)
    let fv: f32 = 1.5
    let dv: f64 = 1.5

    // ---- STATIC controls (the CORRECT column: these already worked; they must stay correct)
    if s.one32(1.5) != 1 as i64:
        return 1
    if s.one64(1.5) != 1 as i64:
        return 2
    if s.two32(1.5, 2.25) != 3 as i64:
        return 3
    if s.afteri(7, 3.75) != 3 as i64:
        return 4
    if s.after64(0.5, 6.5) != 3 as i64:
        return 5
    if s.mix(1.5, 0.5, 7, 6.5) != 15 as i64:
        return 6
    if s.one32(fv) != 1 as i64:
        return 7
    if s.one64(fv) != 1 as i64:          // f32 variable widened into an f64 parameter
        return 8
    if s.one32(dv as f32) != 1 as i64:
        return 9
    if s.one32(2.0 + 2.0 - 2.5) != 1 as i64:
        return 10
    if s.i32p(5) != 1 as i64:
        return 11
    if s.u8p(200) != 1 as i64:
        return 12

    // ---- DYNAMIC rows through an interface-typed receiver
    let i: I = S(k: 0)

    // already-correct dynamic rows (no conversion instruction required)
    if i.one32(fv) != 1 as i64:
        return 20
    if i.one32(dv as f32) != 1 as i64:   // explicit cast
        return 21
    if i.one64(1.5) != 1 as i64:         // f64 parameter, float literal: same width
        return 22
    if i.i32p(5) != 1 as i64:            // int narrowing (correct via sub-register overlap)
        return 23
    if i.u8p(200) != 1 as i64:
        return 24

    // bitmask variant: 1 lit->f32, 2 f32var->f64, 4 folded, 8 two32, 16 afteri, 32 after64, 64 mix
    mut m := 0 as i64
    if i.one32(1.5) == 1 as i64:
        m = m + 1 as i64
    if i.one64(fv) == 1 as i64:
        m = m + 2 as i64
    if i.one32(2.0 + 2.0 - 2.5) == 1 as i64:
        m = m + 4 as i64
    if i.two32(1.5, 2.25) == 3 as i64:
        m = m + 8 as i64
    if i.afteri(7, 3.75) == 3 as i64:
        m = m + 16 as i64
    if i.after64(0.5, 6.5) == 3 as i64:
        m = m + 32 as i64
    if i.mix(1.5, 0.5, 7, 6.5) == 15 as i64:
        m = m + 64 as i64
    return 100 + m
