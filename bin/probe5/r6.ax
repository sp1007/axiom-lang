// R6 isolation: a NO-PARAM interface method returning f32, through dynamic dispatch.
// (f1.ax row R6; it was never reached before because R1 failed first.)
interface I:
    fn r32(self: Self) -> f32

struct S:
    k: i64
    fn r32(self: S) -> f32:
        return 2.5

fn main() -> i64:
    let s = S(k: 0)
    // static control
    if (s.r32() as i64) != 2:
        return 10
    let i: I = S(k: 0)
    let b = i.r32()
    if (b as i64) != 2:
        return 20 + (b as i64)
    return 42
