// Characterize the pre-existing f32-return-through-dispatch defect a bit further:
// two consecutive NO-PARAM f32-returning dispatch calls with distinct values.
interface I:
    fn a(self: Self) -> f32
    fn b(self: Self) -> f32

struct S:
    k: i64
    fn a(self: S) -> f32:
        return 3.5
    fn b(self: S) -> f32:
        return 2.5

fn main() -> i64:
    let i: I = S(k: 0)
    let x = i.a()
    if (x as i64) != 3:
        return 60 + (x as i64)
    let y = i.b()
    if (y as i64) != 2:
        return 100 + (y as i64)
    return 42
