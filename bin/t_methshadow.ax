// REGRESSION ORACLE: a method name must be matched by NAME EQUALITY, never by a
// `_`-bounded SUBSTRING of another method's name on the same receiver.
//
// The defect (air_builder.ax match_mangled_method_raw_bytes): the resolution loops
// took the FIRST symbol whose name merely CONTAINED the called name, `.`/`_`-bounded
// on the left. So `S.p32_r32`, declared before `S.r32`, answered every `r32()` call —
// silently, at AIR-build time, for static calls AND interface vtable slots. RFC 0029
// requires slot k to hold the method whose name EQUALS the interface method name.
// Fixed by RANKING candidates (exact plain name > `__`-mangled instance > loose hit)
// instead of taking the first loose hit.
//
// Rows 1-6 are the defect; rows 7-11 are CONTROLS that were already correct and must
// STAY correct — this change re-decides symbol selection, so overreach is the risk.
// Each failing row returns its own small code (see the returns) so a failure names itself.

// --- row 1: static call, longer name declared FIRST -------------------------
struct S1:
    k: i64
    fn p32_r32(self: S1) -> i64:
        return 7
    fn r32(self: S1) -> i64:
        return 42

// --- row 2: interface dispatch, i64 ----------------------------------------
interface I2:
    fn p_val(self: Self) -> i64
    fn val(self: Self) -> i64
struct S2:
    k: i64
    fn p_val(self: S2) -> i64:
        return 7
    fn val(self: S2) -> i64:
        return 42

// --- row 3: interface dispatch, str return ---------------------------------
interface I3:
    fn p_s(self: Self) -> str
    fn s(self: Self) -> str
struct S3:
    k: i64
    fn p_s(self: S3) -> str:
        return "wrong"
    fn s(self: S3) -> str:
        return "right"

// --- row 4: static call, plain english names (x_get / get) -----------------
struct S4:
    n: i64
    fn x_get(self: S4) -> i64:
        return 7
    fn get(self: S4) -> i64:
        return 42

// --- row 5: `__`-bounded INFIX (the mangled-generic separator shape) --------
interface I5:
    fn r32__z(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S5:
    k: i64
    fn r32__z(self: S5) -> i64:
        return 7
    fn r32(self: S5) -> i64:
        return 42

// --- row 6: module-level UFCS form (explicit self param), the shape the
//            compiler's own sources use (interface_method_ret_type/method_ret_type)
struct S6:
    n: i64
pub fn long_pick(self: ptr[S6], a: u32) -> i64:
    return 7
pub fn pick(self: ptr[S6], a: u32) -> i64:
    return 42

// --- row 7 (CONTROL): PREFIX collision, not a suffix -----------------------
interface I7:
    fn r32_p32(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S7:
    k: i64
    fn r32_p32(self: S7) -> i64:
        return 7
    fn r32(self: S7) -> i64:
        return 42

// --- row 8 (CONTROL): shared suffix with NO `_` separator ------------------
interface I8:
    fn pxxr32(self: Self) -> i64
    fn r32(self: Self) -> i64
struct S8:
    k: i64
    fn pxxr32(self: S8) -> i64:
        return 7
    fn r32(self: S8) -> i64:
        return 42

// --- row 9 (CONTROL): SHORT name declared first ----------------------------
interface I9:
    fn r32(self: Self) -> i64
    fn p32_r32(self: Self) -> i64
struct S9:
    k: i64
    fn r32(self: S9) -> i64:
        return 42
    fn p32_r32(self: S9) -> i64:
        return 7

// --- row 10 (CONTROL): the colliding names live on DIFFERENT receivers -----
struct SA:
    n: i64
    fn p32_r32(self: SA) -> i64:
        return 7
struct SB:
    n: i64
    fn r32(self: SB) -> i64:
        return 42

// --- row 11 (CONTROL): plain free functions, no receiver at all ------------
fn p32_ff() -> i64:
    return 7
fn ff() -> i64:
    return 42

fn main() -> i64:
    let a = S1(k: 0)
    if a.r32() != 42:
        return 1
    let b: I2 = S2(k: 0)
    if b.val() != 42:
        return 2
    let c: I3 = S3(k: 0)
    if c.s() != "right":
        return 3
    let d = S4(n: 0)
    if d.get() != 42:
        return 4
    let e: I5 = S5(k: 0)
    if e.r32() != 42:
        return 5
    mut f := S6(n: 0)
    if (&f).pick(1 as u32) != 42:
        return 6
    let g: I7 = S7(k: 0)
    if g.r32() != 42:
        return 7
    let h: I8 = S8(k: 0)
    if h.r32() != 42:
        return 8
    let i: I9 = S9(k: 0)
    if i.r32() != 42:
        return 9
    let j = SB(n: 0)
    if j.r32() != 42:
        return 10
    if ff() != 42:
        return 11
    return 42
