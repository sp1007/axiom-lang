import std.string

fn check_prefix(s_ptr: ptr[u8], s_len: i64, prefix: str) -> bool:
    let p_ptr = prefix as ptr[u8]
    let p_len = std.string.len(prefix)
    if s_len < p_len:
        return false
    mut i := 0 as i64
    while i < p_len:
        if s_ptr[i] != p_ptr[i]:
            return false
        i = i + 1
    return true

pub fn main() -> i32:
    let s = "[Debug] Stage 1: Starting compilation..."
    let sp = s as ptr[u8]
    let sl = std.string.len(s)
    if check_prefix(sp, sl, "[Debug] Stage"):
        return 11
    return 22
