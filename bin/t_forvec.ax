// Oracle (RFC 0018 P2): `for x in vec` element iteration over a Vec[T]. Iterates
// vec.data[i] for i in 0..vec.len (runtime length). Exits with the element sum.
import std.collections

fn main() -> i64:
    mut v = Vec[i64].new()
    v.push(10)
    v.push(20)
    v.push(30)
    mut sum = 0 as i64
    for x in v:
        sum = sum + x
    return sum   // 10+20+30 = 60
