// Oracle (exit=118): RFC 0017 P2 — array-of-struct global; element field write + for-in.
struct P:
    x: i64
    y: i64
mut g: [P; 3] = [P(x: 1, y: 2), P(x: 3, y: 4), P(x: 5, y: 6)]
fn main() -> i32:
    g[1].x = 100
    mut t: i64 = 0
    for p in g:
        t = t + p.x + p.y
    return t as i32   // (1+2)+(100+4)+(5+6) = 3+104+11 = 118
