// Nested Vec[Vec[i64]] with doubly-nested for-in.
import std.collections
fn main() -> i64:
    mut outer = Vec[Vec[i64]].new()
    mut a = Vec[i64].new()
    a.push(10)
    a.push(30)
    outer.push(a)
    mut b = Vec[i64].new()
    b.push(2)
    outer.push(b)
    mut t: i64 = 0
    for inner in outer:
        for x in inner:
            t = t + x
    return t
