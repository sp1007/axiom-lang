// Regression (BUG#57, native backend): `match` on a builtin Option scrutinee.
// Option is pointer-tagged (None = null, Some = box pointer, payload at [box+0]),
// NOT the user-sum "tag@field0, payload@field1" box, so it needs a dedicated
// null-test dispatch. Before the RFC 0012 fix, lower_match returned early for
// Option/Result scrutinees and the match emitted no code — `match Some(42)`
// silently returned whatever was left in the register (usually 0).
//
// The fix lives entirely in the backend (air_builder): the Some/None constructor
// boxes are typed with a real Option type (kind 11) instead of `str`, and the
// match is classified by its arm names (Some/None) into a pointer-tagged dispatch.
// No type-checker/ABI change, so the stdlib's generic Option methods are untouched.
fn make(b: bool) -> Option[i32]:
    if b:
        return Some(7)
    return None

fn main() -> i32:
    // bare constructor scrutinee
    match Some(42):
        Some(v):
            println("some-42")
        None:
            println("none-bare")
    // function-returned Some
    match make(true):
        Some(v):
            if v == 7:
                println("some-7")
            else:
                println("some-wrong")
        None:
            println("none-wrong")
    // function-returned None
    match make(false):
        Some(v):
            println("some-wrong2")
        None:
            println("none-ok")
    return 0
