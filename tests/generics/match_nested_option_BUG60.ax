// Regression (BUG#60 FIXED, native backend). `match` on a nested
// Option[Option[i32]]. `Some(Some(42))` boxes the inner Option (an 8-byte box
// pointer) as the outer payload; the outer arm `Some(inner)` binds it via OP_DEREF
// typed Option (entry.size 16) and the inner arm `Some(x)` should yield 42.
//
// Root cause (x86_selector.ax regalloc_is_16byte, OP_DEREF case): a deref whose
// result type is a size-16 tagged aggregate (Option/Result/sum) was reported
// 16-byte-INLINE, missing the BUG#56 `not type_is_aggregate` exclusion the COPY /
// CALL / else cases already had. So `inner` (an 8-byte box pointer) got a 16-byte
// inline home; every use — the inner match's discriminant test and its payload
// OP_DEREF — spill-reloaded with LEA(&slot) instead of MOV(slot→reg), reading the
// slot ADDRESS as the box, so the double-deref returned garbage (exit 8 not 42).
// Single-level Option/Result match always worked (match_option_BUG57.ax); only a
// nested Option payload matched again tripped the missing guard.
fn wrap(b: bool) -> Option[Option[i32]]:
    if b:
        return Some(Some(42))
    return None

fn main() -> i32:
    match wrap(true):
        Some(inner):
            match inner:
                Some(x):
                    if x == 42:
                        println("nested-42")
                    else:
                        println("nested-wrong")
                None:
                    println("inner-none-wrong")
        None:
            println("outer-none-wrong")
    return 0
