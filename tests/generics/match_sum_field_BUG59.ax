// HARNESS: SKIP — KNOWN FAIL (BUG#59, native backend). Tracks a crash.
//
// Matching on a SUM-typed FIELD of a struct (`match bx.c:` where `c: Color`)
// segfaults on the native backend, whether matched directly or via a local
// (`let col = bx.c; match col:`). A standalone sum value matches fine
// (sum_type_color.ax) — only a sum read out of a struct field crashes.
//
// Cause (uninvestigated in full): the sum-as-struct-field representation. A sum
// field is stored/read inconsistently — `field_is_aggregate` reports a sum/option/
// result field as by-address so GET_FIELD returns the field ADDRESS (LEA), while a
// sum VALUE elsewhere is an 8-byte box pointer; the match then dereferences the
// wrong level. Same BUG#51/56 family (native by-address vs pointer-repr for tagged
// types). Needs a careful, dedicated fix (dump-air + objdump), not a quick patch —
// a wrong guess here is a silent miscompile the self-host fixpoint may not catch.
//
// Found 2026-07-04 while fixing BUG#54/55/56/58. Remove SKIP when fixed.
type Color = Red | Green | Blue

struct Box:
    tag: i32
    c: Color

fn main() -> i32:
    let bx = Box(tag: 5, c: Blue)
    match bx.c:
        Red:
            return 1
        Green:
            return 2
        Blue:
            return bx.tag + 3
