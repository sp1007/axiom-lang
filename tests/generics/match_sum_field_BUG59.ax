// Regression (BUG#59, native backend): `match` on a SUM-typed FIELD of a struct
// (`match bx.c` where `c: Color`). Segfaulted before the fix: a sum value is an
// 8-byte box pointer, but GET_FIELD/SET_FIELD treated a sum field by its entry
// size (16) — the 16-byte-inline path wrote 16 bytes into the sum-typed dest's
// 8-byte pointer home (regalloc homes kinds 6/11/12 as 8-byte pointers), corrupting
// the stack. Same by-address-vs-pointer-repr tension as BUG#51/56.
//
// Fix (x86_selector field_is_pointer_sum): a sum/option/result field is loaded and
// stored as an 8-byte box pointer, consistent with how sum VALUES are represented
// everywhere else. A standalone sum matches fine (sum_type_color.ax); this covers
// the sum-read-from-a-struct-field path specifically.
type Color = Red | Green | Blue

struct Box:
    tag: i32
    c: Color

fn label(col: Color) -> str:
    match col:
        Red:
            return "red"
        Green:
            return "green"
        Blue:
            return "blue"

fn main() -> i32:
    let bx = Box(tag: 5, c: Blue)
    // direct field match
    match bx.c:
        Red:
            println("direct-red")
        Green:
            println("direct-green")
        Blue:
            println("direct-blue")
    // via a local, and pass the field to a function
    let col = bx.c
    println(label(col))
    // an earlier field still reads correctly after the sum field
    if bx.tag == 5:
        println("tag-ok")
    return 0
