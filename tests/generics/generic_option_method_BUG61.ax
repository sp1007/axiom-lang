// Regression (BUG#61, native backend): calling a method on a value returned by a
// GENERIC FUNCTION. Root cause was that a generic function call's result was left
// UNTYPED (node_types=0), so `result.method()` had an UNKNOWN receiver, method
// dispatch failed, and air_builder fell back to field-access-as-call -> segfault.
// Fix (typecheck NODE_CALL_EXPR): recover the call's result type from the
// instantiated callee's (freshly inferred) signature when it is a structured
// (struct/sum/option/result/generic-inst) return.
//
// NOTE: a generic METHOD on a generic TYPE that returns Option[T] (e.g.
// Vec[T].get(i).unwrap()) is a SEPARATE, still-open case where the return resolves
// to `void` — tracked by generic_method_vecget_BUG61.ax (SKIP).
struct Counter:
    n: i32

fn bump(self: Counter) -> i32:
    return self.n + 1

fn wrapc[T](v: T) -> Counter:
    return Counter(n: 10)

fn myget[T](x: T) -> Option[T]:
    return Some(x)

fn main() -> i32:
    // method on a generic-function-returned struct
    let c = wrapc(0)
    if c.bump() == 11:
        println("struct-ok")
    else:
        println("struct-wrong")
    // method (unwrap) on a generic-function-returned Option
    let o = myget(7)
    if o.unwrap() == 7:
        println("option-ok")
    else:
        println("option-wrong")
    // is_some too
    if o.is_some():
        println("is-some-ok")
    return 0
