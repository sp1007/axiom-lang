// HARNESS: SKIP — a --shared/--staticlib library source, not a runnable program
// tests/ffi/axmath.ax — RFC 0009 P2: export functions into a DLL.
// Build:  axc build --shared axmath.ax -o axmath.dll -self-link -O1
// Produces a PE with an IMAGE_EXPORT_DIRECTORY exporting `ax_add` / `ax_mul`.
// Consumed by host.c (LoadLibrary/GetProcAddress) and t_useaxmath.ax.
#[export] pub fn ax_add(a: i32, b: i32) -> i32:
    return a + b

#[export] pub fn ax_mul(a: i32, b: i32) -> i32:
    return a * b
