// HARNESS: SKIP — a library source compiled to imp_mymath.lib, not a runnable program.
// tests/ffi/imp_mymath.ax — RFC 0011 P4 inc3b: import-driven auto-libraries.
// Build:  axc build imp_mymath.ax -o imp_mymath.lib --staticlib --no-stdlib -self-link -O1
// The .lib carries an __axiom_iface member (F triple 1 i32 -> i32) so an importer can
// typecheck against it without recompiling this source.
pub fn triple(x: i32) -> i32:
    return x * 3
