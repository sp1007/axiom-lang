// tests/ffi/t_ffi.ax — RFC 0009 P1: import symbols from a third-party DLL.
// Two symbols from ONE user DLL exercise the N-DLL `.idata` user-bucket path.
// Expected process exit code: (40 + 2) * 2 == 84.
extern "C" from "axffi_lib.dll" fn ffi_add(a: i32, b: i32) -> i32
extern "C" from "axffi_lib.dll" fn ffi_mul(a: i32, b: i32) -> i32

fn main() -> i32:
    let s = ffi_add(40, 2)
    let p = ffi_mul(s, 2)
    return p as i32
