// HARNESS: SKIP — a `library`-marked module; imported by libmark_app.ax (see README).
// tests/ffi/libmark_mod.ax — RFC 0011 P4 inc3d: the `library` marker declares this file a
// separately-compilable library, so an importer auto-builds/uses libmark_mod.lib WITHOUT
// the --auto-lib flag (self-describing opt-in — the safe default).
library libmark_mod

pub fn quad(x: i32) -> i32:
    return x * 4
