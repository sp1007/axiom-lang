// tests/ffi/t_useaxmath.ax — RFC 0009 P1+P2 interop: an AXIOM binary importing
// the AXIOM-produced axmath.dll (see axmath.ax). Expected exit code 84 = (40+2)*2.
extern "C" from "axmath.dll" fn ax_add(a: i32, b: i32) -> i32
extern "C" from "axmath.dll" fn ax_mul(a: i32, b: i32) -> i32

fn main() -> i32:
    let s = ax_add(40, 2)
    return ax_mul(s, 2)
