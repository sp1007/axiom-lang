struct MyVec:
    data: ptr[i32]
    len: i64
    cap: i64

struct H:
    x: i64
    v: MyVec

fn new_myvec() -> MyVec:
    return MyVec(data: null as ptr[i32], len: 0, cap: 0)

fn push(mut self: MyVec, val: i32):
    if self.len == self.cap:
        let new_data = @alloc(16 * 4 as i64) as ptr[i32]
        self.data = new_data
        self.cap = 16 as i64
    self.data[self.len] = val
    self.len = self.len + 1

fn fill(h: ptr[H]):
    h.v.push(7 as i32)

pub fn main() -> i32:
    let h = @alloc(32) as ptr[H]
    h[0] = H(x: 0, v: new_myvec())
    fill(h)
    return h.v.len as i32
