import std.string

fn cp(s_ptr: ptr[u8], prefix: str) -> i32:
    let sb1 = s_ptr[0] as i32
    let p_ptr = prefix as ptr[u8]
    let sb2 = s_ptr[0] as i32
    let pb = p_ptr[0] as i32
    // expect sb1=91, sb2=91, pb=91
    return sb1 * 1000000 + sb2 * 1000 + pb

pub fn main() -> i32:
    let s = "[Debug] Stage"
    let sp = s as ptr[u8]
    return cp(sp, "[Debug] Stage")
