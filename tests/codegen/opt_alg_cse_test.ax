// tests/codegen/opt_alg_cse_test.ax
// Tests for new optimizer passes: algebraic simplification and per-block CSE.

// Algebraic identity: x + 0 = x
pub fn test_add_zero(x: i32) -> i32:
    return x + 0

// Algebraic identity: x * 1 = x
pub fn test_mul_one(x: i32) -> i32:
    return x * 1

// Algebraic zero: x * 0 = 0
pub fn test_mul_zero(x: i32) -> i32:
    return x * 0

// Algebraic identity: x - 0 = x
pub fn test_sub_zero(x: i32) -> i32:
    return x - 0

// Self-subtraction: x - x = 0
pub fn test_sub_self(x: i32) -> i32:
    return x - x

// Self-XOR: x ^ x = 0
pub fn test_xor_self(x: i32) -> i32:
    return x ^ x

// Comparison tautology: x == x = true
pub fn test_eq_self(x: i32) -> bool:
    return x == x

// Comparison tautology: x != x = false
pub fn test_ne_self(x: i32) -> bool:
    return x != x

// Division by 1: x / 1 = x
pub fn test_div_one(x: i32) -> i32:
    return x / 1

// CSE: two identical additions
pub fn test_cse(a: i32, b: i32) -> i32:
    let r1 = a + b
    let r2 = a + b
    return r1 + r2

pub fn main() -> i32:
    return 0
