import std.string

fn cp(s_ptr: ptr[u8], prefix: str) -> i64:
    return s_ptr as i64

fn cp2(s_ptr: ptr[u8], other: i64) -> i64:
    return s_ptr as i64

pub fn main() -> i32:
    let s = "[Debug] Stage"
    let sp = s as ptr[u8]
    let want = sp as i64
    let got_str = cp(sp, "abc")      // 2nd arg is str (16-byte)
    let got_i64 = cp2(sp, 5 as i64)  // 2nd arg is i64 (8-byte)
    mut code := 0 as i32
    if got_str != want:
        code = code + 1
    if got_i64 != want:
        code = code + 2
    return code
