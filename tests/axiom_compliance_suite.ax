// ============================================================================
// AXIOM COMPLIANCE SUITE (M4) — POINTER
//
// M4 was redefined 2026-07-18: "compliance" now means the suite runs on the
// REAL, shipped AXIOM grammar rather than the aspirational spec dialect.
//
// The authoritative, RUNNABLE, gated compliance suite lives at:
//
//     bin/t_compliance.ax
//
// It contains 60 tests across the shipped language surface (primitive types,
// control flow, functions/lambdas/tuples, structs & methods, generics &
// collections, sum types & error handling). It is built + run on every
// regression pass via scripts/regression_repros.sh as the oracle
// `t_compliance|exit|60` (exit code == number of passing tests).
//
// The previous aspirational version — written in a spec dialect the compiler
// does NOT parse (`=>` match arms, `impl Trait for Type`, `.length()`,
// `import std.gpu/quantum/net/compiler.ai`, `#run`, `async/await/spawn`,
// `@SOA`, `Arena` regions) — is preserved for reference at:
//
//     tests/axiom_compliance_suite_aspirational.ax
//
// Those features are milestone-scale and partly contradict AXIOM's real design
// (structural duck typing instead of `impl Trait`; `Pattern:` arms instead of
// `=>`); see knowledge/m4-compliance-suite-spec-vs-impl-gap.md.
// ============================================================================

fn main() -> i32:
    // This file is documentation only. Run the real suite:
    //   bin/axc_native.exe build bin/t_compliance.ax -o out.exe -O1 && ./out.exe
    //   (exit code 60 == all 60 compliance tests passed)
    return 0
