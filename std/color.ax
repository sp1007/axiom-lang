// AXIOM Standard Library — std.color
//
// RGB <-> HSV color conversions + relative luminance. Multi-component results
// are written through a caller-provided `ptr[f64]` of length 3 (out-param), so
// no aggregate return — scalar/pointer only → BUG#45/46-immune. r,g,b and s,v
// are in [0,1]; h is in [0,360). Pure arithmetic (no std.math dependency).

fn cl_fabs(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x

fn cl_fmax(a: f64, b: f64) -> f64:
    if a > b:
        return a
    return b

fn cl_fmin(a: f64, b: f64) -> f64:
    if a < b:
        return a
    return b

// out[0]=h [0,360), out[1]=s [0,1], out[2]=v [0,1]
pub fn cl_rgb_to_hsv(r: f64, g: f64, b: f64, out: ptr[f64]):
    let mx = cl_fmax(r, cl_fmax(g, b))
    let mn = cl_fmin(r, cl_fmin(g, b))
    let delta = mx - mn
    out[2] = mx
    if mx == 0.0:
        out[1] = 0.0
    else:
        out[1] = delta / mx
    mut h := 0.0
    if delta == 0.0:
        h = 0.0
    elif mx == r:
        h = 60.0 * ((g - b) / delta)
    elif mx == g:
        h = 60.0 * ((b - r) / delta + 2.0)
    else:
        h = 60.0 * ((r - g) / delta + 4.0)
    if h < 0.0:
        h = h + 360.0
    out[0] = h

// out[0]=r, out[1]=g, out[2]=b
pub fn cl_hsv_to_rgb(h: f64, s: f64, v: f64, out: ptr[f64]):
    let c = v * s
    let hh = h / 60.0
    let k = (hh / 2.0) as i64
    let hmod2 = hh - (k as f64) * 2.0
    let x = c * (1.0 - cl_fabs(hmod2 - 1.0))
    let m = v - c
    let sext = hh as i64
    mut r1 := 0.0
    mut g1 := 0.0
    mut b1 := 0.0
    if sext == 0 as i64:
        r1 = c
        g1 = x
    elif sext == 1 as i64:
        r1 = x
        g1 = c
    elif sext == 2 as i64:
        g1 = c
        b1 = x
    elif sext == 3 as i64:
        g1 = x
        b1 = c
    elif sext == 4 as i64:
        r1 = x
        b1 = c
    else:
        r1 = c
        b1 = x
    out[0] = r1 + m
    out[1] = g1 + m
    out[2] = b1 + m

// Relative luminance (Rec. 709 coefficients).
pub fn cl_luminance(r: f64, g: f64, b: f64) -> f64:
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

// Per-channel linear blend of two colors into out (length 3).
pub fn cl_lerp(r0: f64, g0: f64, b0: f64, r1: f64, g1: f64, b1: f64, t: f64, out: ptr[f64]):
    out[0] = r0 + (r1 - r0) * t
    out[1] = g0 + (g1 - g0) * t
    out[2] = b0 + (b1 - b0) * t

// RGB -> HSL. out[0]=h [0,360), out[1]=s [0,1], out[2]=l [0,1].
pub fn cl_rgb_to_hsl(r: f64, g: f64, b: f64, out: ptr[f64]):
    let mx = cl_fmax(r, cl_fmax(g, b))
    let mn = cl_fmin(r, cl_fmin(g, b))
    let delta = mx - mn
    let l = (mx + mn) * 0.5
    out[2] = l
    if delta == 0.0:
        out[0] = 0.0
        out[1] = 0.0
        return
    out[1] = delta / (1.0 - cl_fabs(2.0 * l - 1.0))
    mut h := 0.0
    if mx == r:
        h = 60.0 * ((g - b) / delta)
    elif mx == g:
        h = 60.0 * ((b - r) / delta + 2.0)
    else:
        h = 60.0 * ((r - g) / delta + 4.0)
    if h < 0.0:
        h = h + 360.0
    out[0] = h

// HSL -> RGB. out[0..2] = r,g,b.
pub fn cl_hsl_to_rgb(h: f64, s: f64, l: f64, out: ptr[f64]):
    let c = (1.0 - cl_fabs(2.0 * l - 1.0)) * s
    let hh = h / 60.0
    let k = (hh / 2.0) as i64
    let hmod2 = hh - (k as f64) * 2.0
    let x = c * (1.0 - cl_fabs(hmod2 - 1.0))
    let m = l - c * 0.5
    let sext = hh as i64
    mut r1 := 0.0
    mut g1 := 0.0
    mut b1 := 0.0
    if sext == 0 as i64:
        r1 = c
        g1 = x
    elif sext == 1 as i64:
        r1 = x
        g1 = c
    elif sext == 2 as i64:
        g1 = c
        b1 = x
    elif sext == 3 as i64:
        g1 = x
        b1 = c
    elif sext == 4 as i64:
        r1 = x
        b1 = c
    else:
        r1 = c
        b1 = x
    out[0] = r1 + m
    out[1] = g1 + m
    out[2] = b1 + m
