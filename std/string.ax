// AXIOM Standard Library — std.string
//
// String operations and StringBuilder.

import std.collections
import std.result

extern "C" fn malloc(n: u64) -> ptr[u8]

/// Returns the length in bytes.
pub fn len(s: str) -> i64:
    return s.len

/// Returns the number of UTF-8 codepoints (characters) in `s`.
///
/// Implemented in AXIOM (value ABI). The `str_char_count` intrinsic is only
/// lowered by the C backend; on the native/self-link path it returned 0 (garbage
/// RAX). Counts UTF-8 LEADING bytes — every byte that is not a `10xxxxxx`
/// continuation byte begins a new codepoint.
pub fn char_count(s: str) -> i64:
    let sp = s.ptr
    mut count := 0 as i64
    mut i := 0 as i64
    while i < s.len:
        if (sp[i] & 0xC0 as u8) != 0x80 as u8:
            count = count + 1 as i64
        i = i + 1 as i64
    return count

/// RFC 0020: decode the UTF-8 codepoint that starts at byte offset `off`, returning
/// a packed i64 — low 32 bits = the Unicode codepoint, high 32 bits = the byte width
/// (1..4). Assumes valid UTF-8 and `off < s.len` (the caller bounds the loop). This
/// is the per-iteration helper the compiler emits for `for c in str` (RFC 0020 P2b).
pub fn utf8_decode(s: str, off: i64) -> i64:
    // NB: the width is packed into the HIGH 32 bits, so the shift must be i64 —
    // `1 << 32` with a default-i32 literal shifts in 32-bit (count masked to 0).
    let b0 = s[off] as i64
    if b0 < 0x80:
        return ((1 as i64) << 32) | b0
    if b0 < 0xE0:
        let b1 = s[off + 1] as i64
        let cp2 = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        return ((2 as i64) << 32) | cp2
    if b0 < 0xF0:
        let b1 = s[off + 1] as i64
        let b2 = s[off + 2] as i64
        let cp3 = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
        return ((3 as i64) << 32) | cp3
    let b1 = s[off + 1] as i64
    let b2 = s[off + 2] as i64
    let b3 = s[off + 3] as i64
    let cp4 = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    return ((4 as i64) << 32) | cp4

/// Concatenates two strings.
///
/// Implemented in AXIOM (value ABI) rather than via the `str_concat` intrinsic:
/// the intrinsic routes to the C-runtime `ax_str_concat` whose Win64 C ABI
/// (args by reference, 16-byte return via hidden pointer) is incompatible with
/// the native backend's value ABI (str args by pointer, result in RAX:RDX). A
/// real body makes the compiled `concat` itself the correct value-ABI function
/// for both the native and C backends.
pub fn concat(a: str, b: str) -> str:
    let total = a.len + b.len
    let buf = malloc((total + 1) as u64) as ptr[u8]
    @memcpy(buf, a.ptr, a.len)
    @memcpy(((buf as i64) + a.len) as ptr[u8], b.ptr, b.len)
    buf[total] = 0 as u8
    return buf as str

/// Formats a signed 64-bit integer as its base-10 decimal string.
///
/// Implemented in AXIOM (value ABI). Integer formatting otherwise lives only in
/// std.fmt's `to_str` (out-of-grammar brace dialect + `@compiler_intrinsic
/// ("i64_to_str")`, which the native/self-link backend never lowers), so a plain
/// `to_str(n)` crashed on native. Mirrors the compiler's own `format_int`.
pub fn to_str(n: i64) -> str:
    if n == 0 as i64:
        let z = malloc(2 as u64) as ptr[u8]
        z[0] = '0' as u8
        z[1] = 0 as u8
        return z as str
    // i64::MIN has no positive negation — emit its literal directly.
    if n == -9223372036854775808 as i64:
        return concat("-9223372036854775808", "")
    mut neg := false
    mut v := n
    if n < 0 as i64:
        neg = true
        v = 0 as i64 - n
    // Build the digits least-significant-first, then reverse into the result.
    let rev = malloc(24 as u64) as ptr[u8]
    mut rl := 0 as i64
    while v > 0 as i64:
        let d = (v % 10 as i64) as u8
        rev[rl] = ('0' as u8 + d)
        rl = rl + 1 as i64
        v = v / 10 as i64
    mut total := rl
    if neg:
        total = total + 1 as i64
    let buf = malloc((total + 1 as i64) as u64) as ptr[u8]
    mut pos := 0 as i64
    if neg:
        buf[0] = '-' as u8
        pos = 1 as i64
    mut k := 0 as i64
    while k < rl:
        buf[pos + k] = rev[rl - 1 as i64 - k]
        k = k + 1 as i64
    buf[total] = 0 as u8
    @free(rev as ptr[u8])
    return buf as str

/// Formats an f64 as a decimal string with up to 6 fractional digits (trailing
/// zeros and a bare '.' stripped). Overload of `to_str` resolved by arg type.
///
/// Implemented in AXIOM (value ABI). std.fmt's `f64` formatter uses
/// `@compiler_intrinsic("f64_to_str")`, which the native/self-link backend never
/// lowers -> `to_str(3.14)` printed garbage. Mirrors the compiler's own
/// `ax_sprintf_local` fixed-precision formatter (NOT shortest-round-trip; NaN/Inf
/// and |value| beyond i64 range are out of scope, matching that formatter).
pub fn to_str(f: f64) -> str:
    let buf = malloc(40 as u64) as ptr[u8]
    mut idx := 0 as i64
    mut v := f
    if v < 0.0:
        buf[idx] = '-' as u8
        idx = idx + 1 as i64
        v = 0.0 - v
    let int_part = v as i64
    let frac = v - (int_part as f64)
    // Integer part: digits least-significant-first, then reversed into buf.
    let tmp = malloc(24 as u64) as ptr[u8]
    mut tl := 0 as i64
    mut iv := int_part
    if iv == 0 as i64:
        tmp[0] = '0' as u8
        tl = 1 as i64
    else:
        while iv > 0 as i64:
            let dg = (iv % 10 as i64) as u8
            tmp[tl] = ('0' as u8 + dg)
            tl = tl + 1 as i64
            iv = iv / 10 as i64
    mut i := 0 as i64
    while i < tl:
        buf[idx] = tmp[tl - 1 as i64 - i]
        idx = idx + 1 as i64
        i = i + 1 as i64
    @free(tmp as ptr[u8])
    // Fractional part: 6 digits, rounded, clamped to avoid a carry into int part.
    buf[idx] = '.' as u8
    idx = idx + 1 as i64
    mut fv := (frac * 1000000.0 + 0.5) as i64
    if fv >= 1000000 as i64:
        fv = 999999 as i64
    let fbuf = malloc(8 as u64) as ptr[u8]
    mut j := 0 as i64
    mut fval := fv
    while j < 6 as i64:
        let dg = (fval % 10 as i64) as u8
        fbuf[5 as i64 - j] = ('0' as u8 + dg)
        fval = fval / 10 as i64
        j = j + 1 as i64
    j = 0 as i64
    while j < 6 as i64:
        buf[idx] = fbuf[j]
        idx = idx + 1 as i64
        j = j + 1 as i64
    @free(fbuf as ptr[u8])
    // Strip trailing zeros, then a bare trailing '.'.
    while idx > 0 as i64 and buf[idx - 1 as i64] == '0' as u8:
        idx = idx - 1 as i64
    if idx > 0 as i64 and buf[idx - 1 as i64] == '.' as u8:
        idx = idx - 1 as i64
    if idx == 0 as i64:
        buf[0] = '0' as u8
        idx = 1 as i64
    buf[idx] = 0 as u8
    return buf as str

/// Formats an integer as a lowercase base-16 (hexadecimal) string, no "0x"
/// prefix and no leading zeros ("0" for zero). The value is interpreted as an
/// unsigned 64-bit pattern, so `to_hex(-1)` yields "ffffffffffffffff".
///
/// Implemented in AXIOM (value ABI). Like the decimal `to_str`, hex formatting
/// otherwise lives only in out-of-grammar std.fmt behind an intrinsic the
/// native/self-link backend never lowers.
pub fn to_hex(n: i64) -> str:
    if n == 0 as i64:
        let z = malloc(2 as u64) as ptr[u8]
        z[0] = '0' as u8
        z[1] = 0 as u8
        return z as str
    // Unsigned interpretation: cast to u64 so negative i64 formats as its
    // two's-complement bit pattern (and to use unsigned div/mod).
    mut v := n as u64
    // At most 16 hex digits for a 64-bit value; build least-significant-first.
    let rev = malloc(16 as u64) as ptr[u8]
    mut rl := 0 as i64
    while v > 0 as u64:
        let d = (v % 16 as u64) as u8
        if d < 10 as u8:
            rev[rl] = ('0' as u8 + d)
        else:
            rev[rl] = ('a' as u8 + (d - 10 as u8))
        rl = rl + 1 as i64
        v = v / 16 as u64
    let buf = malloc((rl + 1 as i64) as u64) as ptr[u8]
    mut k := 0 as i64
    while k < rl:
        buf[k] = rev[rl - 1 as i64 - k]
        k = k + 1 as i64
    buf[rl] = 0 as u8
    @free(rev as ptr[u8])
    return buf as str

/// Returns a substring [start, end).
///
/// Implemented in AXIOM (value ABI); the `str_slice` intrinsic is not lowered
/// by the native backend.
pub fn slice(s: str, start: i64, end: i64) -> str:
    mut st := start
    mut en := end
    if st < 0 as i64:
        st = 0 as i64
    if en > s.len:
        en = s.len
    mut n := en - st
    if n < 0 as i64:
        n = 0 as i64
    let buf = malloc((n + 1 as i64) as u64) as ptr[u8]
    if n > 0 as i64:
        @memcpy(buf, ((s.ptr as i64) + st) as ptr[u8], n)
    buf[n] = 0 as u8
    return buf as str

/// Finds first occurrence of sub, or -1.
///
/// Implemented in AXIOM (value ABI); the `str_index_of` intrinsic is not
/// lowered by the native backend.
pub fn index_of(s: str, sub: str) -> i64:
    let sublen = sub.len
    if sublen == 0 as i64:
        return 0 as i64
    let sp = s.ptr
    let bp = sub.ptr
    mut i := 0 as i64
    while i + sublen <= s.len:
        mut j := 0 as i64
        mut matched := true
        while j < sublen:
            if sp[i + j] != bp[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return i
        i = i + 1 as i64
    return -1 as i64

/// Checks if s contains substring sub.
pub fn contains(s: str, sub: str) -> bool:
    return index_of(s, sub) >= 0 as i64

/// Checks if s starts with prefix.
pub fn starts_with(s: str, prefix: str) -> bool:
    if prefix.len > s.len:
        return false
    let sp = s.ptr
    let pp = prefix.ptr
    mut i := 0 as i64
    while i < prefix.len:
        if sp[i] != pp[i]:
            return false
        i = i + 1 as i64
    return true

/// Checks if s ends with suffix.
pub fn ends_with(s: str, suffix: str) -> bool:
    if suffix.len > s.len:
        return false
    let sp = s.ptr
    let fp = suffix.ptr
    let off = s.len - suffix.len
    mut i := 0 as i64
    while i < suffix.len:
        if sp[off + i] != fp[i]:
            return false
        i = i + 1 as i64
    return true

/// Splits `s` on each (non-overlapping) occurrence of `sep`, left to right.
/// Follows the Rust model: a trailing separator yields a trailing empty piece
/// (`"a,".split(",")` -> `["a", ""]`), and `sep` never matching yields `[s]`.
///
/// Implemented in AXIOM (value ABI). The `str_split` intrinsic is only lowered
/// by the C backend (-> ax_str_split); the native/self-link backend does NOT
/// lower it, so the previous `@compiler_intrinsic("str_split")` returned garbage
/// and segfaulted. Built from the working `slice` primitive + Vec[str], exactly
/// like trim/to_upper/replace above.
pub fn split(s: str, sep: str) -> Vec[str]:
    mut result = Vec[str].new()
    let seplen = sep.len
    // Degenerate separator: no meaningful split point — return the whole string.
    if seplen == 0 as i64:
        result.push(s)
        return result
    let sp = s.ptr
    let bp = sep.ptr
    mut start := 0 as i64
    while start <= s.len:
        // Find the next `sep` at or after `start`.
        mut idx := -1 as i64
        mut i := start
        while i + seplen <= s.len:
            mut j := 0 as i64
            mut matched := true
            while j < seplen:
                if sp[i + j] != bp[j]:
                    matched = false
                    break
                j = j + 1 as i64
            if matched:
                idx = i
                break
            i = i + 1 as i64
        if idx < 0 as i64:
            result.push(slice(s, start, s.len))
            break
        result.push(slice(s, start, idx))
        start = idx + seplen
    return result

/// Trims whitespace (space, tab, CR, LF) from both ends.
///
/// Implemented in AXIOM (value ABI); the `str_trim` intrinsic is not lowered
/// by the native backend.
pub fn trim(s: str) -> str:
    let sp = s.ptr
    mut st := 0 as i64
    while st < s.len:
        let c = sp[st]
        if c != 32 as u8 and c != 9 as u8 and c != 13 as u8 and c != 10 as u8:
            break
        st = st + 1 as i64
    mut en := s.len
    while en > st:
        let c = sp[en - 1 as i64]
        if c != 32 as u8 and c != 9 as u8 and c != 13 as u8 and c != 10 as u8:
            break
        en = en - 1 as i64
    return slice(s, st, en)

/// Converts ASCII letters to uppercase.
///
/// Implemented in AXIOM (value ABI); the `str_to_upper` intrinsic is not
/// lowered by the native backend.
pub fn to_upper(s: str) -> str:
    let n = s.len
    let sp = s.ptr
    let buf = malloc((n + 1 as i64) as u64) as ptr[u8]
    mut i := 0 as i64
    while i < n:
        mut c := sp[i]
        if c >= 97 as u8 and c <= 122 as u8:
            c = (c - 32 as u8) as u8
        buf[i] = c
        i = i + 1 as i64
    buf[n] = 0 as u8
    return buf as str

/// Converts ASCII letters to lowercase.
///
/// Implemented in AXIOM (value ABI); the `str_to_lower` intrinsic is not
/// lowered by the native backend.
pub fn to_lower(s: str) -> str:
    let n = s.len
    let sp = s.ptr
    let buf = malloc((n + 1 as i64) as u64) as ptr[u8]
    mut i := 0 as i64
    while i < n:
        mut c := sp[i]
        if c >= 65 as u8 and c <= 90 as u8:
            c = (c + 32 as u8) as u8
        buf[i] = c
        i = i + 1 as i64
    buf[n] = 0 as u8
    return buf as str

/// Repeats string n times.
///
/// Implemented in AXIOM (value ABI); the `str_repeat` intrinsic is not lowered
/// by the native backend.
pub fn repeat(s: str, n: i64) -> str:
    mut count := n
    if count < 0 as i64:
        count = 0 as i64
    let slen = s.len
    let total = slen * count
    let buf = malloc((total + 1 as i64) as u64) as ptr[u8]
    mut k := 0 as i64
    while k < count:
        @memcpy(((buf as i64) + k * slen) as ptr[u8], s.ptr, slen)
        k = k + 1 as i64
    buf[total] = 0 as u8
    return buf as str

/// Replaces occurrences of old with new.
///
/// Implemented in AXIOM (value ABI) rather than via the `str_replace`
/// intrinsic, which the native backend does not lower (it would return an
/// uninitialised str with a NULL .ptr). A real body works for both backends.
pub fn replace(s: str, old: str, new: str) -> str:
    let slen = s.len
    let olen = old.len
    let nlen = new.len
    if olen == 0 as i64:
        return s
    let sp = s.ptr
    let op = old.ptr
    let np = new.ptr
    // Pass 1: count non-overlapping occurrences of `old` in `s`.
    mut count := 0 as i64
    mut i := 0 as i64
    while i + olen <= slen:
        mut j := 0 as i64
        mut matched := true
        while j < olen:
            if sp[i + j] != op[j]:
                matched = false
                break
            j = j + 1
        if matched:
            count = count + 1 as i64
            i = i + olen
        else:
            i = i + 1 as i64
    if count == 0 as i64:
        return s
    let total = slen + count * (nlen - olen)
    let buf = malloc((total + 1 as i64) as u64) as ptr[u8]
    // Pass 2: copy `s` into `buf`, substituting `new` for each `old`.
    mut out := 0 as i64
    i = 0 as i64
    while i < slen:
        mut matched := false
        if i + olen <= slen:
            mut j := 0 as i64
            matched = true
            while j < olen:
                if sp[i + j] != op[j]:
                    matched = false
                    break
                j = j + 1
        if matched:
            mut k := 0 as i64
            while k < nlen:
                buf[out] = np[k]
                out = out + 1 as i64
                k = k + 1 as i64
            i = i + olen
        else:
            buf[out] = sp[i]
            out = out + 1 as i64
            i = i + 1 as i64
    buf[total] = 0 as u8
    return buf as str

extern "C" fn ax_str_parse_i64(s: str, out_val: ptr[i64]) -> bool
extern "C" fn ax_str_parse_f64(s: str, out_val: ptr[f64]) -> bool

/// Parses string as i64.
pub fn to_i64(s: str) -> Result[i64, str]:
    mut val := 0 as i64
    if ax_str_parse_i64(s, &val):
        return Ok(val)
    else:
        return Err("Invalid integer format")

/// Parses string as f64.
pub fn to_f64(s: str) -> Result[f64, str]:
    mut val := 0.0
    if ax_str_parse_f64(s, &val):
        return Ok(val)
    else:
        return Err("Invalid float format")

/// Checks whether `s` is well-formed UTF-8.
///
/// Implemented in AXIOM (value ABI). The `str_is_valid_utf8` intrinsic is only
/// lowered by the C backend; on the native/self-link path it returned false
/// (garbage RAX). Validates the leading-byte class, that enough continuation
/// bytes follow, and that each continuation byte is `10xxxxxx`.
pub fn is_valid_utf8(s: str) -> bool:
    let sp = s.ptr
    let n = s.len
    mut i := 0 as i64
    while i < n:
        let c = sp[i]
        mut extra := 0 as i64
        if c < 0x80 as u8:                        // 0xxxxxxx (ASCII)
            extra = 0 as i64
        elif (c & 0xE0 as u8) == 0xC0 as u8:      // 110xxxxx
            extra = 1 as i64
        elif (c & 0xF0 as u8) == 0xE0 as u8:      // 1110xxxx
            extra = 2 as i64
        elif (c & 0xF8 as u8) == 0xF0 as u8:      // 11110xxx
            extra = 3 as i64
        else:                                     // continuation/invalid leading byte
            return false
        if i + extra >= n:                        // truncated multibyte sequence
            return false
        mut k := 1 as i64
        while k <= extra:
            if (sp[i + k] & 0xC0 as u8) != 0x80 as u8:
                return false
            k = k + 1 as i64
        i = i + 1 as i64 + extra
    return true
