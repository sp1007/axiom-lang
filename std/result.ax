// AXIOM Standard Library — std.option / std.result
//
// Core error-handling sum types.

pub type Option[T] = Some(T) | None
pub type Result[T, E] = Ok(T) | Err(E)



extern "C" fn ax_sum_layout_is_pointer() -> bool

// --------------------------------------------------------------------------
// Option[T] Methods (Match-Free, Layout-Aware)
// --------------------------------------------------------------------------

pub fn is_some[T](self: Option[T]) -> bool:
    if ax_sum_layout_is_pointer():
        let raw64_ptr = (&self) as ptr[u64]
        return raw64_ptr[0] != 0 as u64
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        let raw64_val = (&self) as ptr[u64]
        return raw64_val[0] != 0 as u64
    let raw32 = (&self) as ptr[u32]
    return raw32[0] == 0 as u32

pub fn is_none[T](self: Option[T]) -> bool:
    if ax_sum_layout_is_pointer():
        let raw64_ptr = (&self) as ptr[u64]
        return raw64_ptr[0] == 0 as u64
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        let raw64_val = (&self) as ptr[u64]
        return raw64_val[0] == 0 as u64
    let raw32 = (&self) as ptr[u32]
    return raw32[0] == 1 as u32

pub fn unwrap[T](self: Option[T]) -> T:
    // Precondition inlined instead of calling self.is_some() — see Result.unwrap.
    if ax_sum_layout_is_pointer():
        let raw64 = (&self) as ptr[u64]
        if raw64[0] == 0 as u64:
            panic("called Option.unwrap() on a None value")
        let masked = raw64[0]
        let typed_ptr = masked as ptr[T]
        return typed_ptr.*
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        let raw8_small = (&self) as ptr[u8]
        let typed_small = raw8_small as ptr[T]
        return typed_small.*
    let raw8_large = (&self) as ptr[u8]
    let payload_ptr = ((raw8_large as i64) + 8 as i64) as ptr[T]
    return payload_ptr.*

pub fn unwrap_or[T](self: Option[T], default: T) -> T:
    if self.is_some():
        return self.unwrap()
    return default

pub fn expect[T](self: Option[T], message: str) -> T:
    if self.is_some():
        return self.unwrap()
    panic(message)

pub fn map[T, U](self: Option[T], f: fn(T) -> U) -> Option[U]:
    if self.is_some():
        return Some(f(self.unwrap()))
    return None

pub fn flat_map[T, U](self: Option[T], f: fn(T) -> Option[U]) -> Option[U]:
    if self.is_some():
        return f(self.unwrap())
    return None

pub fn ok_or[T, E](self: Option[T], err: E) -> Result[T, E]:
    if self.is_some():
        return Ok(self.unwrap())
    return Err(err)

pub fn filter[T](self: Option[T], pred: fn(T) -> bool) -> Option[T]:
    if self.is_some():
        let v = self.unwrap()
        if pred(v):
            return self
    return None

pub fn or_other[T](self: Option[T], other: Option[T]) -> Option[T]:
    if self.is_some():
        return self
    return other


// --------------------------------------------------------------------------
// Result[T, E] Methods (Match-Free, Layout-Aware)
// --------------------------------------------------------------------------

pub fn is_ok[T, E](self: Result[T, E]) -> bool:
    if ax_sum_layout_is_pointer():
        let raw64 = (&self) as ptr[u64]
        return (raw64[0] & 1 as u64) == 0 as u64
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        return true
    let raw32 = (&self) as ptr[u32]
    return raw32[0] == 0 as u32

pub fn is_err[T, E](self: Result[T, E]) -> bool:
    if ax_sum_layout_is_pointer():
        let raw64 = (&self) as ptr[u64]
        return (raw64[0] & 1 as u64) == 1 as u64
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        return false
    let raw32 = (&self) as ptr[u32]
    return raw32[0] == 1 as u32

pub fn unwrap[T, E](self: Result[T, E]) -> T:
    // The Ok/Err precondition is inlined rather than calling self.is_ok():
    // a generic method that calls another generic method on the same type is
    // only correctly monomorphised when the callee is also instantiated by a
    // direct call elsewhere. Inlining removes that fragile dependency so unwrap
    // is self-contained regardless of whether is_ok was specialised.
    if ax_sum_layout_is_pointer():
        let raw64 = (&self) as ptr[u64]
        if (raw64[0] & 1 as u64) != 0 as u64:
            panic("called Result.unwrap() on an Err value")
        let masked = raw64[0] & (0xfffffffffffffffe as u64)
        let typed_ptr = masked as ptr[T]
        return typed_ptr.*
    let size = @compiler_intrinsic("size_of")[T]() * (2 as u64)
    if size <= (8 as u64):
        let raw8_small = (&self) as ptr[u8]
        let typed_small = raw8_small as ptr[T]
        return typed_small.*
    let raw32 = (&self) as ptr[u32]
    if raw32[0] != 0 as u32:
        panic("called Result.unwrap() on an Err value")
    let raw8_large = (&self) as ptr[u8]
    let payload_ptr = ((raw8_large as i64) + 8 as i64) as ptr[T]
    return payload_ptr.*

pub fn unwrap_err[T, E](self: Result[T, E]) -> E:
    // Precondition inlined instead of calling self.is_err() — see unwrap above.
    if ax_sum_layout_is_pointer():
        let raw64 = (&self) as ptr[u64]
        if (raw64[0] & 1 as u64) != 1 as u64:
            panic("called Result.unwrap_err() on an Ok value")
        let masked = raw64[0] & (0xfffffffffffffffe as u64)
        let typed_ptr = masked as ptr[E]
        return typed_ptr.*
    let size = @compiler_intrinsic("size_of")[E]() * (2 as u64)
    if size <= (8 as u64):
        let raw8_small = (&self) as ptr[u8]
        let typed_small = raw8_small as ptr[E]
        return typed_small.*
    let raw8_large = (&self) as ptr[u8]
    let payload_ptr = ((raw8_large as i64) + 8 as i64) as ptr[E]
    return payload_ptr.*

pub fn unwrap_or[T, E](self: Result[T, E], default: T) -> T:
    if self.is_ok():
        return self.unwrap()
    return default

pub fn expect[T, E](self: Result[T, E], message: str) -> T:
    if self.is_ok():
        return self.unwrap()
    panic(message)

pub fn map[T, E, U](self: Result[T, E], f: fn(T) -> U) -> Result[U, E]:
    if self.is_ok():
        return Ok(f(self.unwrap()))
    return Err(self.unwrap_err())

pub fn map_err[T, E, F](self: Result[T, E], f: fn(E) -> F) -> Result[T, F]:
    if self.is_err():
        return Err(f(self.unwrap_err()))
    return Ok(self.unwrap())

pub fn flat_map[T, E, U](self: Result[T, E], f: fn(T) -> Result[U, E]) -> Result[U, E]:
    if self.is_ok():
        return f(self.unwrap())
    return Err(self.unwrap_err())

pub fn ok[T, E](self: Result[T, E]) -> Option[T]:
    if self.is_ok():
        return Some(self.unwrap())
    return None

pub fn err[T, E](self: Result[T, E]) -> Option[E]:
    if self.is_err():
        return Some(self.unwrap_err())
    return None
