// AXIOM Standard Library — std/scheduler_test.ax
//
// Unit tests for AXIOM-native M:N work-stealing scheduler.

import std.string

extern "C" fn GetStdHandle(nStdHandle: u32) -> ptr[void]
extern "C" fn WriteFile(hFile: ptr[void], lpBuffer: ptr[void], nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: ptr[void], lpOverlapped: ptr[void]) -> i32
extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64
extern "C" fn ax_get_mock_child_handler() -> ptr[void]
extern "C" fn ax_println_i64(val: i64)

fn test_print_str(s: str):
    if @compiler_intrinsic("is_windows"):
        let h = GetStdHandle(0xFFFFFFF5 as u32)
        mut written := 0 as u32
        WriteFile(h, s as ptr[void], std.string.len(s) as u32, (&written) as ptr[void], null as ptr[void])
    else:
        syscall(1 as u64, 1 as u64, s as ptr[u8] as u64, std.string.len(s) as u64, 0 as u64, 0 as u64, 0 as u64)

// We will use standard mock actor ID values for testing.
fn test_runq_basic():
    mut q := runq(top: 0, bottom: 0)
    q.init()
    assert(q.empty() == 1)

    // Push 3 actor IDs
    assert(q.push(101 as u64) == 0)
    assert(q.push(102 as u64) == 0)
    assert(q.push(103 as u64) == 0)
    assert(q.empty() == 0)

    // Owner pop should be LIFO (last-in, first-out)
    assert(q.pop() == 103 as u64)
    assert(q.pop() == 102 as u64)
    assert(q.pop() == 101 as u64)
    assert(q.empty() == 1)
    assert(q.pop() == 0 as u64) // Empty pop returns 0
    test_print_str("  PASS: test_runq_basic\n")

fn test_runq_steal():
    mut q := runq(top: 0, bottom: 0)
    q.init()

    assert(q.push(201 as u64) == 0)
    assert(q.push(202 as u64) == 0)
    assert(q.push(203 as u64) == 0)

    // Stealer pop should be FIFO (first-in, first-out) from the top
    assert(q.steal() == 201 as u64)
    assert(q.steal() == 202 as u64)
    assert(q.pop() == 203 as u64) // Owner pops remaining
    assert(q.empty() == 1)
    test_print_str("  PASS: test_runq_steal\n")

fn test_scheduler_lifecycle():
    let sz = @compiler_intrinsic("size_of")[scheduler]()
    let sched = @alloc(sz) as ptr[scheduler]
    assert(sched != null as ptr[scheduler])
    
    // Init with 4 workers
    assert(sched.init(4 as u32) == 0)
    assert(sched.worker_count == 4 as u32)
    assert(sched.running == 0)

    // Submit some mock actors (IDs 1 to 8)
    mut i := 1 as u64
    while i <= 8 as u64:
        assert(sched.submit(i) == 0)
        i = i + 1 as u64

    assert(sched.total_submitted == 8 as u64)

    // Check round-robin distribution to workers (8 tasks among 4 workers)
    // worker 0 should have IDs: 1 (submitted at 0), 5 (submitted at 4)
    // worker 1 should have IDs: 2, 6
    // worker 2 should have IDs: 3, 7
    // worker 3 should have IDs: 4, 8
    assert(sched.workers[0].runq.empty() == 0)
    assert(sched.workers[3].runq.empty() == 0)

    // Check pop from worker 0
    assert(sched.workers[0].runq.pop() == 5 as u64)
    assert(sched.workers[0].runq.pop() == 1 as u64)
    assert(sched.workers[0].runq.empty() == 1)

    // Verify stats
    mut stats := SchedulerStats(worker_count: 0, total_submitted: 0, total_executed: 0, total_steals: 0)
    sched.stats(&stats)
    assert(stats.worker_count == 4 as u32)
    assert(stats.total_submitted == 8 as u64)
    assert(stats.total_executed == 0 as u64) // not run yet

    sched.shutdown()
    @free(sched as ptr[u8])
    test_print_str("  PASS: test_scheduler_lifecycle\n")

mut g_child_runs: u64 = 0 as u64

pub fn mock_child_handler(self: ptr[void], payload: ptr[void], msg_type: u32):
    g_child_runs = g_child_runs + 1 as u64

fn test_supervisor_recovery():
    ax_actor_system_init()
    
    // Create supervisor with strategy ONE_FOR_ONE, max 3 restarts in 5000ms
    let sup_id = ax_supervisor_create(AX_STRATEGY_ONE_FOR_ONE, 3 as u32, 5000 as u32)
    assert(sup_id != 0 as u64)
    
    let sup = ax_supervisor_lookup(sup_id)
    assert(sup != null as ptr[AxSupervisor])
    
    let spec = AxChildSpec(
        handler: ax_get_mock_child_handler(),
        init_data: null as ptr[void],
        data_size: 0 as u64,
        restart: 1 as i32, // AX_RESTART_ALWAYS = 1
        max_restarts: 3 as u32,
        window_ms: 5000 as u32
    )
    
    assert(ax_supervisor_add_child(sup, spec) == 0 as i32)
    assert(sup.child_count == 1 as u32)
    
    // Start children
    assert(ax_supervisor_start_children(sup) == 0 as i32)
    let child_id = sup.children[0]
    assert(child_id != 0 as u64)
    
    test_print_str("  [DEBUG] sup_id: ")
    ax_println_i64(sup_id as i64)
    test_print_str("  [DEBUG] child_id: ")
    ax_println_i64(child_id as i64)
    
    // Verify child is running
    let child_actor = ax_actor_lookup(child_id) as ptr[AxActor]
    assert(child_actor != null as ptr[AxActor])
    assert(child_actor.supervisor_id == sup_id)
    
    // Simulate actor crash/exit
    ax_actor_stop(child_id)
    
    // Execute scheduler steps
    let state = get_global_state()
    let p_g_sched = (state as i64 + 56 as i64) as ptr[ptr[void]]
    let sched = p_g_sched.* as ptr[scheduler]
    
    // Run step loops to process AX_MSG_STOP and trigger AX_MSG_EXIT
    mut steps := 0
    while steps < 20:
        let q = (&sched.workers[0].runq) as ptr[runq]
        mut id := q.pop()
        if id != 0 as u64:
            test_print_str("  [DEBUG] Popped actor ID: ")
            ax_println_i64(id as i64)
            let actor_ptr = ax_actor_lookup(id)
            if actor_ptr != null as ptr[void]:
                while ax_actor_step(actor_ptr) != 0 as i32:
                    steps = steps + 1
        steps = steps + 1
        
    // Assert child was restarted and has a new ID
    let new_child_id = sup.children[0]
    test_print_str("  [DEBUG] new_child_id: ")
    ax_println_i64(new_child_id as i64)
    assert(new_child_id != 0 as u64)
    assert(new_child_id != child_id) // Different ID because it was respawned!
    
    test_print_str("  PASS: test_supervisor_recovery\n")

pub fn main():
    test_print_str("Running AXIOM-native Scheduler unit tests...\n")
    test_runq_basic()
    test_runq_steal()
    test_scheduler_lifecycle()
    test_supervisor_recovery()
    test_print_str("All AXIOM-native Scheduler tests passed!\n")

