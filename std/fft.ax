// AXIOM Standard Library — std.fft
//
// Radix-2 iterative Cooley-Tukey FFT over two separate ptr[f64] arrays
// (real + imaginary parts). n MUST be a power of two. Transform is in-place.
// inverse=true computes the inverse DFT (result divided by n).
//
// The twiddle factor is recomputed with sin/cos every butterfly (no float
// call-result is carried across a loop → BUG#44/#46/#48-immune, and it avoids
// the running-twiddle rounding drift). Composes std.math.sin/cos.
//
// Complex represented as parallel arrays; caller allocates re[n], im[n].

// bit-reversal permutation (in place) using only &,+,-,>> (no XOR).
fn fft_bit_reverse(re: ptr[f64], im: ptr[f64], n: i64):
    mut j := 0 as i64
    mut i := 1 as i64
    while i < n:
        mut bit := n >> 1 as i64
        while bit > 0 as i64 and (j & bit) != 0 as i64:
            j = j - bit
            bit = bit >> 1 as i64
        j = j + bit
        if i < j:
            let tr = re[i]
            re[i] = re[j]
            re[j] = tr
            let ti = im[i]
            im[i] = im[j]
            im[j] = ti
        i = i + 1

pub fn fft(re: ptr[f64], im: ptr[f64], n: i64, inverse: bool):
    if n <= 1 as i64:
        return
    fft_bit_reverse(re, im, n)
    mut len := 2 as i64
    while len <= n:
        // base angle per stage: -2*pi/len (forward), +2*pi/len (inverse)
        mut base := (0.0 - 6.283185307179586) / (len as f64)
        if inverse:
            base = 6.283185307179586 / (len as f64)
        let half = len >> 1 as i64
        mut start := 0 as i64
        while start < n:
            mut k := 0 as i64
            while k < half:
                let ang = base * (k as f64)
                let wr = cos(ang)
                let wi = sin(ang)
                let a = start + k
                let b = start + k + half
                let tr = wr * re[b] - wi * im[b]
                let ti = wr * im[b] + wi * re[b]
                let ur = re[a]
                let ui = im[a]
                re[a] = ur + tr
                im[a] = ui + ti
                re[b] = ur - tr
                im[b] = ui - ti
                k = k + 1
            start = start + len
        len = len << 1 as i64
    if inverse:
        let inv = 1.0 / (n as f64)
        mut m := 0 as i64
        while m < n:
            re[m] = re[m] * inv
            im[m] = im[m] * inv
            m = m + 1
