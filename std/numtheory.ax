// AXIOM Standard Library — std.numtheory
//
// Elementary number theory over u64. All-integer (no float) so immune to the
// float-ABI codegen bugs (BUG#44/45/46). Trial-division loops with `%` exercise
// the unsigned-div register-clobber path fixed in BUG#47 — keep this module's
// repro (bin/t_numtheory.ax) in the regression set as a guard against regression.
//
// nt_mod_exp keeps products within u64; for moduli up to ~2^32 there is no
// overflow. Larger moduli need a 128-bit mulmod (see std.bignum) — out of scope.

pub fn nt_gcd(a: u64, b: u64) -> u64:
    mut x := a
    mut y := b
    while y != 0 as u64:
        let t = x % y
        x = y
        y = t
    return x

pub fn nt_lcm(a: u64, b: u64) -> u64:
    if a == 0 as u64:
        return 0 as u64
    if b == 0 as u64:
        return 0 as u64
    let g = nt_gcd(a, b)
    return (a / g) * b

pub fn nt_is_prime(n: u64) -> bool:
    if n < 2 as u64:
        return false
    if n < 4 as u64:
        return true
    if n % (2 as u64) == 0 as u64:
        return false
    mut i := 3 as u64
    while i * i <= n:
        if n % i == 0 as u64:
            return false
        i = i + (2 as u64)
    return true

pub fn nt_next_prime(n: u64) -> u64:
    mut c := n + (1 as u64)
    while nt_is_prime(c) == false:
        c = c + (1 as u64)
    return c

// (base^exp) mod m. No overflow for m up to ~2^32 (products stay < 2^64).
pub fn nt_mod_exp(base: u64, exp: u64, m: u64) -> u64:
    if m == 1 as u64:
        return 0 as u64
    mut result := 1 as u64
    mut b := base % m
    mut e := exp
    while e > 0 as u64:
        if e % (2 as u64) == 1 as u64:
            result = (result * b) % m
        e = e / (2 as u64)
        b = (b * b) % m
    return result

// Euler's totient phi(n) via trial-division factorisation.
pub fn nt_totient(n: u64) -> u64:
    mut result := n
    mut nn := n
    mut p := 2 as u64
    while p * p <= nn:
        if nn % p == 0 as u64:
            while nn % p == 0 as u64:
                nn = nn / p
            result = result - (result / p)
        p = p + (1 as u64)
    if nn > 1 as u64:
        result = result - (result / nn)
    return result

pub fn nt_divisor_count(n: u64) -> u64:
    if n == 0 as u64:
        return 0 as u64
    mut cnt := 0 as u64
    mut i := 1 as u64
    while i * i <= n:
        if n % i == 0 as u64:
            if i * i == n:
                cnt = cnt + (1 as u64)
            else:
                cnt = cnt + (2 as u64)
        i = i + (1 as u64)
    return cnt

pub fn nt_divisor_sum(n: u64) -> u64:
    if n == 0 as u64:
        return 0 as u64
    mut sm := 0 as u64
    mut i := 1 as u64
    while i * i <= n:
        if n % i == 0 as u64:
            sm = sm + i
            let j = n / i
            if j != i:
                sm = sm + j
        i = i + (1 as u64)
    return sm

pub fn nt_is_perfect(n: u64) -> bool:
    if n < 2 as u64:
        return false
    return nt_divisor_sum(n) == n + n

pub fn nt_is_coprime(a: u64, b: u64) -> bool:
    return nt_gcd(a, b) == 1 as u64

// Modular multiplicative inverse a^-1 mod m via the extended Euclidean
// algorithm. Returns 0 when a and m are not coprime (no inverse exists).
pub fn nt_mod_inverse(a: u64, m: u64) -> u64:
    if m == 1 as u64:
        return 0 as u64
    let mm = m as i64
    mut t := 0 as i64
    mut newt := 1 as i64
    mut r := mm
    mut newr := (a % m) as i64
    while newr != 0 as i64:
        let q = r / newr
        let tmpt = t - q * newt
        t = newt
        newt = tmpt
        let tmpr = r - q * newr
        r = newr
        newr = tmpr
    if r > 1 as i64:
        return 0 as u64
    if t < 0 as i64:
        t = t + mm
    return t as u64

// Floor of log base `b` of `n` (number of times n divides by b). 0 if b < 2.
pub fn nt_int_log(b: u64, n: u64) -> u64:
    if b < 2 as u64:
        return 0 as u64
    mut c := 0 as u64
    mut v := n
    while v >= b:
        v = v / b
        c = c + (1 as u64)
    return c

// Sum of digits of n in the given base.
pub fn nt_sum_digits(n: u64, base: u64) -> u64:
    mut s := 0 as u64
    mut v := n
    while v > 0 as u64:
        s = s + (v % base)
        v = v / base
    return s

// Miller-Rabin witness: true if `a` proves n composite. (n-1 = d·2^s)
fn nt_mr_witness(n: u64, a: u64, d: u64, s: u64) -> bool:
    mut x := nt_mod_exp(a, d, n)
    if x == 1 as u64 or x == n - (1 as u64):
        return false
    mut i := 1 as u64
    while i < s:
        x = (x * x) % n
        if x == n - (1 as u64):
            return false
        i = i + (1 as u64)
    return true

// Deterministic Miller-Rabin primality test. Correct for n < 2^32 (the internal
// modular multiply stays within u64); for larger n it is a strong probable-prime
// test. Detects Carmichael numbers (unlike a Fermat test).
pub fn nt_is_probable_prime(n: u64) -> bool:
    if n < 2 as u64:
        return false
    if n == 2 as u64 or n == 3 as u64 or n == 5 as u64 or n == 7 as u64 or n == 11 as u64 or n == 13 as u64:
        return true
    if n % (2 as u64) == 0 as u64:
        return false
    mut d := n - (1 as u64)
    mut s := 0 as u64
    while d % (2 as u64) == 0 as u64:
        d = d / (2 as u64)
        s = s + (1 as u64)
    if nt_mr_witness(n, 2 as u64, d, s):
        return false
    if nt_mr_witness(n, 3 as u64, d, s):
        return false
    if nt_mr_witness(n, 5 as u64, d, s):
        return false
    if nt_mr_witness(n, 7 as u64, d, s):
        return false
    if nt_mr_witness(n, 11 as u64, d, s):
        return false
    if nt_mr_witness(n, 13 as u64, d, s):
        return false
    return true
