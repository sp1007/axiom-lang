// AXIOM Standard Library — std.io
//
// Input/Output interfaces and File operations, on NATIVE OS handles.
//
// ZERO libc stdio: fopen/fclose/fread/fwrite/fflush are gone, replaced by
// CreateFileA/ReadFile/WriteFile/CloseHandle on Windows and SYS_open/read/write/
// close on Linux — step 3 of `knowledge/audit-libc-dependencies-2026-08-05.md`.
//
// ⚠️ This file is bundled into EVERY native build, including the compiler's own
// (the hardcoded 8-file list in `main_air.ax::concatenate_stdlib`), and
// `main_air.ax::read_file_content` reads every source file the compiler compiles
// through `open`/`read_all` below. Breaking it breaks the compiler that would
// build the fix.
//
// The platform split is `@compiler_intrinsic("is_windows")`, a COMPILE-TIME
// constant (idiom: `std/runtime.ax:17,57,79,111`), so -O1 folds the dead side
// away and -O0 merely leaves it unreachable.
//
// ⚠️ An older comment here blamed "a cross-module extern-C resolver issue with
// win32.CreateFileA". That was measured to be FALSE and it misdirected a whole
// investigation. The resolver and the mangler are correct: `main_air.ax:1875`
// exports extern decls regardless of `pub` (since `a61b19e`, two weeks BEFORE
// that comment was written), `x86_regs.ax:254-256` emits the bare C name for a
// cross-module extern call, and `linker.ax:710` already whitelists
// CreateFileA/ReadFile/CloseHandle into kernel32.
// The REAL limitation lives on the driver's BUNDLING path: `concatenate_stdlib`
// splices a HARDCODED list of 8 files (`main_air.ax:401-426`) which omits
// `std/os/win32.ax`, while `strip_imports` (`main_air.ax:225-254`) deletes every
// `import std...` line — so a call to `std.os.win32.CreateFileA` from here would
// lose its declaration on the native build path. Hence the LOCAL extern decls
// below, which is what every other bundled std module already does
// (`std/runtime.ax:8-10`, `std/mem/alloc.ax:94-95`, `std/os.ax:124-130`);
// duplicate identical extern decls across bundled files are normal here
// (`WriteFile` is declared in all three of those files too).

import std.result
import std.string

// Win32 file I/O (kernel32). ⚠️ `linker.ax::get_dll_for_symbol` is a hard
// whitelist whose LAST line is `return "ucrtbase.dll"` — a name missing from the
// whitelist does not fail to compile, it silently becomes a libc import that
// ucrtbase does not export, i.e. an executable that fails to LAUNCH. All four
// names below are whitelisted into kernel32 at `linker.ax:708-718` (verified).
extern "C" fn CreateFileA(lpFileName: ptr[u8], dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: ptr[void], dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: ptr[void]) -> ptr[void]
extern "C" fn ReadFile(hFile: ptr[void], lpBuffer: ptr[void], nNumberOfBytesToRead: u32, lpNumberOfBytesRead: ptr[void], lpOverlapped: ptr[void]) -> i32
extern "C" fn WriteFile(hFile: ptr[void], lpBuffer: ptr[void], nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: ptr[void], lpOverlapped: ptr[void]) -> i32
extern "C" fn CloseHandle(hObject: ptr[void]) -> i32
// Linux: lowered to an inline `syscall` instruction by AIR (a call whose callee
// IDENT is named `syscall` becomes OP_SYSCALL, `air_builder.ax:2657-2660`), so
// this declaration never becomes a libc import — `get_dll_for_symbol` maps the
// name to "none" (`linker.ax:705`).
extern "C" fn syscall(num: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> i64

// (fseek/ftell/rewind/fputs used to be declared here with zero call sites. They were
// kept alive only because deleting any one of them made an UNRELATED program
// (`bin/t_ifaceconsumer.ax`) fail to compile — the P6 defect, where typecheck read a
// field-expr's interned method NAME as a symbol INDEX, so an alien symbol's return type
// was imposed on an i64 method call and the reported type drifted with the symbol table.
// Fixed 2026-08-06 via `callee_symbol` in typecheck.ax; these four are now deleted, and
// that deletion is P6's regression test.)

/// A readable byte stream.
pub interface Reader:
    fn read(mut self: Self, buf: ptr[u8], count: i64) -> Result[i64, str]

/// A writable byte stream.
pub interface Writer:
    fn write(mut self: Self, buf: ptr[u8], count: i64) -> Result[i64, str]
    fn flush(mut self: Self) -> Result[void, str]

/// File handle. `handle` stores the NATIVE OS object as i64:
///   Windows — the HANDLE returned by CreateFileA;
///   Linux   — the file descriptor returned by SYS_open.
///
/// **-1 means "not backed by an OS object"** (that is what `stdin()`/`stdout()`/
/// `stderr()` return). -1 is the only sentinel that is correct on BOTH platforms:
/// it IS Win32's INVALID_HANDLE_VALUE, and it is never a valid Linux fd. It
/// deliberately replaces the previous `handle == 0` convention, which collides
/// with Linux fd 0 — a REAL descriptor (the process's stdin), not an absence.
pub struct File:
    pub handle: i64
    pub path: str
    pub mode: i32

fn io_str_to_c_str(s: str) -> ptr[u8]:
    let len = s.len
    let buf = @alloc(len + 1) as ptr[u8]
    mut i := 0 as i64
    while i < len:
        ((buf as i64 + i) as ptr[u8]).* = ((s.ptr as i64 + i) as ptr[u8]).*
        i = i + 1
    ((buf as i64 + len) as ptr[u8]).* = 0 as u8
    return buf

// A single OS transfer is capped at 1 GiB because the Win32 count is a u32 and
// silently truncating an i64 into it would corrupt the transfer size. Capping is
// safe for both directions: a SHORT read/write is legal for both APIs, and every
// caller here already loops (`read_all`, `write_all`, `read_buf`).
fn io_clamp_count(count: i64) -> i64:
    if count > 1073741824 as i64:
        return 1073741824 as i64
    return count

pub fn open(path: str) -> Result[File, str]:
    let cpath = io_str_to_c_str(path)
    if @compiler_intrinsic("is_windows"):
        // GENERIC_READ=0x80000000, FILE_SHARE_READ|FILE_SHARE_WRITE=3,
        // OPEN_EXISTING=3, FILE_ATTRIBUTE_NORMAL=0x80.
        // Share mode 3 (not 0) reproduces what fopen did: the CRT opens with
        // _SH_DENYNO, so a file another process holds open stayed readable. Using
        // 0 here would turn "someone else has it open" into a spurious Err — and
        // on this box Defender holds freshly written files open routinely.
        let h = CreateFileA(cpath, 0x80000000 as u32, 3 as u32, null as ptr[void], 3 as u32, 0x80 as u32, null as ptr[void])
        @free(cpath)
        // ⚠️ CreateFileA does NOT signal failure the way fopen did. fopen returned
        // null; CreateFileA returns INVALID_HANDLE_VALUE = -1. Testing for null
        // would make open() of a MISSING file report success and then read garbage.
        // 0 is rejected too: it is never a valid Win32 file handle, and rejecting
        // it keeps the "-1 == unbacked" sentinel unambiguous.
        let hw = h as i64
        if hw == -1 as i64 or hw == 0 as i64:
            return Err("could not open file")
        return Ok(File(handle: hw, path: path, mode: 0 as i32))
    else:
        // SYS_open=2, O_RDONLY=0.
        let fd = syscall(2 as u64, cpath as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        @free(cpath)
        // ⚠️ The raw syscall returns a NEGATIVE ERRNO (-ENOENT = -2), not -1, and
        // fd 0 is VALID. The test must be `< 0` and nothing else.
        if fd < 0 as i64:
            return Err("could not open file")
        return Ok(File(handle: fd, path: path, mode: 0 as i32))

pub fn create(path: str) -> Result[File, str]:
    let cpath = io_str_to_c_str(path)
    if @compiler_intrinsic("is_windows"):
        // GENERIC_WRITE=0x40000000, share 3 (as in `open`), CREATE_ALWAYS=2
        // (create-or-truncate, which is fopen's "wb"), FILE_ATTRIBUTE_NORMAL=0x80.
        let h = CreateFileA(cpath, 0x40000000 as u32, 3 as u32, null as ptr[void], 2 as u32, 0x80 as u32, null as ptr[void])
        @free(cpath)
        let hw = h as i64
        if hw == -1 as i64 or hw == 0 as i64:
            return Err("could not create file")
        return Ok(File(handle: hw, path: path, mode: 1 as i32))
    else:
        // SYS_open=2 with O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577, mode 0644=420.
        let fd = syscall(2 as u64, cpath as u64, 577 as u64, 420 as u64, 0 as u64, 0 as u64, 0 as u64)
        @free(cpath)
        if fd < 0 as i64:
            return Err("could not create file")
        return Ok(File(handle: fd, path: path, mode: 1 as i32))

pub fn close(mut self: File) -> Result[void, str]:
    // -1 = not backed by an OS object (stdin/stdout/stderr) => nothing to close.
    // 0 is ALSO refused: it is what a zero-initialized File carries, it is Win32's
    // NULL handle, and on Linux it is the process's own stdin. Leaking one
    // descriptor is strictly better than closing the process's stdin out from
    // under it — and a real fd 0 only ever reaches here if the program had already
    // closed its stdin before opening a file.
    if self.handle == -1 as i64 or self.handle == 0 as i64:
        return Ok(void)
    if @compiler_intrinsic("is_windows"):
        let res = CloseHandle(self.handle as ptr[void])
        if res == 0:
            return Err("could not close file")
        return Ok(void)
    else:
        // SYS_close=3.
        let res = syscall(3 as u64, self.handle as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64)
        if res < 0 as i64:
            return Err("could not close file")
        return Ok(void)

pub fn read(mut self: File, buf: ptr[u8], count: i64) -> Result[i64, str]:
    if self.handle == -1 as i64:
        return Err("stream is not backed by an OS handle")
    if count <= 0 as i64:
        return Ok(0 as i64)
    let cnt = io_clamp_count(count)
    if @compiler_intrinsic("is_windows"):
        // ⚠️ ReadFile reports the byte count through an OUT-PARAMETER and returns a
        // BOOL; fread returned the count directly. Reading the BOOL as the count
        // would make `read_all`'s `n == 0` terminator either spin forever (BOOL 1
        // every iteration) or truncate. `nread` staying 0 with a TRUE return is
        // EOF, which is exactly the terminator `read_all` wants.
        // (Measured: an address-taken local survives -O1 here — the out-parameter
        // is not const-folded back to its initializer.)
        mut nread := 0 as u32
        let ok = ReadFile(self.handle as ptr[void], buf as ptr[void], cnt as u32, &nread as ptr[void], null as ptr[void])
        if ok == 0:
            return Err("could not read from file")
        return Ok(nread as i64)
    else:
        // SYS_read=0. Returns the count directly, or a negative errno.
        let n = syscall(0 as u64, self.handle as u64, buf as u64, cnt as u64, 0 as u64, 0 as u64, 0 as u64)
        if n < 0 as i64:
            return Err("could not read from file")
        return Ok(n)

pub fn write(mut self: File, buf: ptr[u8], count: i64) -> Result[i64, str]:
    if self.handle == -1 as i64:
        return Err("stream is not backed by an OS handle")
    if count <= 0 as i64:
        return Ok(0 as i64)
    let cnt = io_clamp_count(count)
    if @compiler_intrinsic("is_windows"):
        // Same out-parameter contract as ReadFile above.
        mut nwritten := 0 as u32
        let ok = WriteFile(self.handle as ptr[void], buf as ptr[void], cnt as u32, &nwritten as ptr[void], null as ptr[void])
        if ok == 0:
            return Err("could not write to file")
        return Ok(nwritten as i64)
    else:
        // SYS_write=1.
        let n = syscall(1 as u64, self.handle as u64, buf as u64, cnt as u64, 0 as u64, 0 as u64, 0 as u64)
        if n < 0 as i64:
            return Err("could not write to file")
        return Ok(n)

pub fn flush(mut self: File) -> Result[void, str]:
    // A no-op BY CONSTRUCTION, not by omission: WriteFile / SYS_write hand the
    // bytes straight to the OS, so there is no user-space buffer left to flush.
    // This is where the last `fflush` in std/ went. Kept in the API — and still
    // Ok(void) — because `Writer.flush` is part of the interface contract and
    // `bin/t_nolibcstdio.ax` pins that it returns Ok.
    return Ok(void)

/// Read to end of file. UNCHANGED by the native-handle rewrite, deliberately:
/// the `@memset` + `buf as str` pair is load-bearing, not incidental. `read` may
/// return a SHORT count, and `ptr[u8] as str` measures the string with strlen, so
/// the buffer must be NUL-filled before every fill for the chunk length to equal
/// the byte count actually read. (Consequence, also unchanged: a file containing
/// an embedded NUL byte reads back truncated at that byte.)
pub fn read_all(self: File) -> Result[str, str]:
    let cap = 4096 as i64
    let buf = @alloc(cap + 1) as ptr[u8]
    mut total_read := 0 as i64
    mut result_str := ""
    mut temp_reader := self

    mut loop := true
    while loop:
        @memset(buf as ptr[void], 0 as u8, cap + 1)
        let r = temp_reader.read(buf, cap)
        if r.is_ok():
            let n = r.unwrap()
            if n == 0 as i64:
                loop = false
            else:
                let chunk = buf as str
                result_str = std.string.concat(result_str, chunk)
        else:
            @free(buf)
            let _ = temp_reader.close()
            return Err(r.unwrap_err())
    @free(buf)
    let _ = temp_reader.close()
    return Ok(result_str)

pub fn write_all(mut self: File, data: str) -> Result[void, str]:
    mut written := 0 as i64
    while written < data.len:
        let r = self.write((data.ptr as i64 + written) as ptr[u8], data.len - written)
        if r.is_ok():
            let n = r.unwrap()
            if n == 0 as i64:
                let _ = self.close()
                return Err("failed to write any bytes")
            written = written + n
        else:
            let _ = self.close()
            return Err(r.unwrap_err())
    let _ = self.close()
    return Ok(void)

/// Read to end of file as RAW BYTES — the BINARY counterpart of `read_all`.
///
/// ⚠️ `read_all` is deliberately NOT usable for binary data: it rebuilds each
/// chunk with `buf as str`, which measures the chunk with strlen, so a file
/// containing an embedded NUL byte comes back TRUNCATED at that byte. Object
/// files, archives and executables are full of NUL bytes, so reading one through
/// `read_all` yields a short buffer with no error reported — a silently corrupt
/// link. This function never inspects the bytes; the length is carried out of
/// band through `out_len`.
///
/// Returns the buffer (caller frees with `@free`) and writes the byte count to
/// `out_len[0]`, or `null` on failure. **An EMPTY file returns a non-null buffer
/// with `out_len[0] == 0`** — check the POINTER for failure and the LENGTH for
/// emptiness; conflating them would turn a 0-byte object file into "unreadable".
/// Closes the file, exactly as `read_all` does.
///
/// The length is an out-parameter rather than a `Result[SomeStruct, str]` on
/// purpose: this code is bundled into the compiler's own image and used by the
/// linker that relinks it, so it deliberately introduces no new struct type and
/// no new generic instantiation on the self-hosting path. `read` already uses the
/// same address-taken-local idiom for ReadFile's out-parameter.
pub fn read_all_bytes(self: File, out_len: ptr[i64]) -> ptr[u8]:
    out_len[0] = 0 as i64
    mut cap := 65536 as i64
    mut buf := @alloc(cap) as ptr[u8]
    mut total := 0 as i64
    mut reader := self
    mut looping := true
    while looping:
        // Grow BEFORE reading, so `cap - total` handed to `read` is never 0 —
        // a 0-count read returns Ok(0), which is this loop's EOF terminator, and
        // a full buffer would therefore be mistaken for end of file.
        if total >= cap:
            let ncap = cap * 2 as i64
            let nbuf = @alloc(ncap) as ptr[u8]
            @memcpy(nbuf, buf, total)
            @free(buf)
            buf = nbuf
            cap = ncap
        let r = reader.read((buf as i64 + total) as ptr[u8], cap - total)
        if r.is_ok():
            let n = r.unwrap()
            if n == 0 as i64:
                looping = false
            else:
                total = total + n
        else:
            @free(buf)
            let _ = reader.close()
            return null as ptr[u8]
    let _ = reader.close()
    out_len[0] = total
    return buf

/// Write exactly `len` raw bytes, looping over short writes. `true` iff all of
/// them reached the OS.
///
/// ⚠️ Unlike `write_all`, this does **NOT** close the file. A binary writer emits
/// several buffers into one file (the PE writer emits headers, code, .idata and
/// .edata separately), so closing after each one would be wrong; the caller owns
/// the handle and must `close` it.
pub fn write_bytes(mut self: File, data: ptr[u8], len: i64) -> bool:
    mut done := 0 as i64
    while done < len:
        let r = self.write((data as i64 + done) as ptr[u8], len - done)
        if r.is_ok():
            let n = r.unwrap()
            if n == 0 as i64:
                return false
            done = done + n
        else:
            return false
    return true

// ── Raw stream tokens ───────────────────────────────────────────────────────
// The same OS objects as `File`, handed out as an opaque `ptr[void]` token, for
// callers shaped like C stdio. The AXIOM compiler's own backends (cgen, wasm,
// the asm emitter, the COFF/ELF object writers, the linker) model an output
// stream as a `FILE*` field and call it from ~90 places; the token form lets them
// stop importing libc stdio without changing a single struct field or signature.
// New AXIOM code should use `File` and the methods above instead.
//
// The token is the OS handle **biased by +1**, so that 0 (== null) means "no
// stream" on BOTH platforms. The bias is not cosmetic: on Linux fd 0 is a valid
// descriptor, so an unbiased token would make a legitimately opened file
// indistinguishable from failure at every `== null` call site.
/// Create-or-truncate for writing. ⚠️ There is NO text mode: the bytes handed to
/// `stream_write`/`stream_puts` reach the file unchanged. `fopen(path, "w")` used
/// to translate '\n' to CRLF on Windows, so the C and WAT backends emitted
/// different bytes on Windows than on Linux for the same input; they are now
/// LF-only everywhere, which is the reproducible-output behaviour CLAUDE.md asks
/// for. Adding a translating mode here would be exactly the hidden runtime
/// behaviour §11 forbids.
pub fn stream_create(path: str) -> ptr[void]:
    let r = create(path)
    if r.is_ok():
        let f = r.unwrap()
        return (f.handle + 1 as i64) as ptr[void]
    return null as ptr[void]

pub fn stream_write(stream: ptr[void], data: ptr[u8], len: i64) -> i64:
    if stream == null as ptr[void]:
        return 0 as i64
    mut f := File(handle: (stream as i64) - 1 as i64, path: "", mode: 1 as i32)
    if f.write_bytes(data, len):
        return len
    return 0 as i64

/// NUL-terminated write. The argument order mirrors C's `fputs(s, stream)` on
/// purpose: it made the ~90 compiler call sites a pure identifier rename, and a
/// 90-site argument reshuffle is a typo surface, not an improvement.
pub fn stream_puts(s: ptr[u8], stream: ptr[void]) -> i32:
    if stream == null as ptr[void]:
        return -1
    mut n := 0 as i64
    while s[n] != 0 as u8:
        n = n + 1
    if n == 0 as i64:
        return 0
    if stream_write(stream, s, n) == n:
        return 0
    return -1

pub fn stream_close(stream: ptr[void]) -> i32:
    if stream == null as ptr[void]:
        return -1
    mut f := File(handle: (stream as i64) - 1 as i64, path: "", mode: 1 as i32)
    let r = f.close()
    if r.is_ok():
        return 0
    return -1

/// Standard input/output/error. handle=-1 means NOT backed by an OS object, so
/// `read`/`write` on these return Err and `close` is a no-op — unchanged in
/// intent from the previous `handle=0`, but expressed with a sentinel that cannot
/// be confused with Linux fd 0 (which IS stdin). They are deliberately NOT wired
/// to the real std handles: `write_all` closes the file it writes, so a stdout()
/// backed by the real handle would close the process's own stdout.
pub fn stdin() -> File:
    return File(handle: -1 as i64, path: "stdin", mode: 0 as i32)

pub fn stdout() -> File:
    return File(handle: -1 as i64, path: "stdout", mode: 1 as i32)

pub fn stderr() -> File:
    return File(handle: -1 as i64, path: "stderr", mode: 2 as i32)

/// Buffered Reader wrapper.
pub struct BufReader[R]:
    pub reader: R
    pub buffer: ptr[u8]
    pub capacity: i64
    pub pos: i64
    pub len: i64

pub fn new_buf_reader[R: Reader](reader: R, capacity: i64) -> BufReader[R]:
    return BufReader[R](
        reader: reader,
        buffer: @alloc(capacity) as ptr[u8],
        capacity: capacity,
        pos: 0 as i64,
        len: 0 as i64,
    )

pub fn read_buf[R: Reader](mut self: BufReader[R], dest: ptr[u8], count: i64) -> Result[i64, str]:
    if self.pos >= self.len:
        let r = self.reader.read(self.buffer, self.capacity)
        if r.is_ok():
            let n = r.unwrap()
            self.len = n
            self.pos = 0 as i64
            if n == 0 as i64:
                return Ok(0 as i64)
        else:
            return Err(r.unwrap_err())
    let available = self.len - self.pos
    mut to_copy := count
    if available < count:
        to_copy = available
    mut i := 0 as i64
    while i < to_copy:
        ((dest as i64 + i) as ptr[u8]).* = ((self.buffer as i64 + self.pos + i) as ptr[u8]).*
        i = i + 1
    self.pos = self.pos + to_copy
    return Ok(to_copy)

/// Buffered Writer wrapper.
pub struct BufWriter[W]:
    pub writer: W
    pub buffer: ptr[u8]
    pub capacity: i64
    pub len: i64

pub fn new_buf_writer[W: Writer](writer: W, capacity: i64) -> BufWriter[W]:
    return BufWriter[W](
        writer: writer,
        buffer: @alloc(capacity) as ptr[u8],
        capacity: capacity,
        len: 0 as i64,
    )
