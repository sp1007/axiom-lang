// AXIOM Standard Library — std.collections
//
// Dynamic array (Vec), HashMap, HashSet.

import std.result

pub struct Vec[T]:
    data: ptr[T]     // pointer to heap allocation
    len: i64         // number of elements
    cap: i64         // allocated capacity

pub fn new_vec[T]() -> Vec[T]:
    return Vec[T](data: null as ptr[T], len: 0 as i64, cap: 0 as i64)

pub fn with_capacity[T](capacity: i64) -> Vec[T]:
    if capacity <= 0:
        return new_vec[T]()
    let data = @alloc(capacity * (@compiler_intrinsic("size_of")[T]() as i64)) as ptr[T]
    return Vec[T](data: data, len: 0 as i64, cap: capacity)

pub fn push[T](mut self: Vec[T], item: T):
    if self.len == self.cap:
        mut new_cap := 16 as i64
        if self.cap != 0:
            new_cap = self.cap * 2
        let item_size = @compiler_intrinsic("size_of")[T]() as i64
        let new_data = @alloc(new_cap * item_size) as ptr[T]
        if self.data != null as ptr[T]:
            @memcpy(new_data as ptr[u8], self.data as ptr[u8], self.len * item_size)
            @free(self.data as ptr[u8])
        self.data = new_data
        self.cap = new_cap
    self.data[self.len] = item
    self.len = self.len + 1

pub fn pop[T](mut self: Vec[T]) -> Option[T]:
    if self.len == 0:
        return None
    self.len = self.len - 1
    return Some(self.data[self.len])

pub fn get[T](self: Vec[T], index: i64) -> Option[T]:
    if index < 0 or index >= self.len:
        return None
    return Some(self.data[index])

pub fn clear[T](mut self: Vec[T]):
    self.len = 0

pub fn destroy[T](mut self: Vec[T]):
    if self.data != null as ptr[T]:
        @free(self.data as ptr[u8])
        self.data = null as ptr[T]
    self.len = 0
    self.cap = 0

// Higher-order methods. These accept an inline lambda (or a named fn / fn-ptr):
// generic type-arg inference from a fn-typed parameter was enabled by the
// NODE_CLOSURE_EXPR + NODE_FUNC_TYPE inference work in typecheck (commit 2cc67ed).

// map: build a new Vec[U] by applying `f` to every element.
pub fn map[T, U](self: Vec[T], f: fn(T) -> U) -> Vec[U]:
    mut result := Vec[U](data: null as ptr[U], len: 0 as i64, cap: 0 as i64)
    mut i := 0 as i64
    while i < self.len:
        result.push(f(self.data[i]))
        i = i + 1
    return result

// filter: build a new Vec[T] with the elements for which `pred` is true.
pub fn filter[T](self: Vec[T], pred: fn(T) -> bool) -> Vec[T]:
    mut result := Vec[T](data: null as ptr[T], len: 0 as i64, cap: 0 as i64)
    mut i := 0 as i64
    while i < self.len:
        let item = self.data[i]
        if pred(item):
            result.push(item)
        i = i + 1
    return result

// fold: left-fold the elements into an accumulator starting from `init`.
pub fn fold[T, U](self: Vec[T], init: U, f: fn(U, T) -> U) -> U:
    mut acc := init
    mut i := 0 as i64
    while i < self.len:
        acc = f(acc, self.data[i])
        i = i + 1
    return acc

// any: true if `pred` holds for at least one element.
pub fn any[T](self: Vec[T], pred: fn(T) -> bool) -> bool:
    mut i := 0 as i64
    while i < self.len:
        if pred(self.data[i]):
            return true
        i = i + 1
    return false

// all: true if `pred` holds for every element (vacuously true when empty).
pub fn all[T](self: Vec[T], pred: fn(T) -> bool) -> bool:
    mut i := 0 as i64
    while i < self.len:
        if not pred(self.data[i]):
            return false
        i = i + 1
    return true

// find: the first element for which `pred` holds, else None.
pub fn find[T](self: Vec[T], pred: fn(T) -> bool) -> Option[T]:
    mut i := 0 as i64
    while i < self.len:
        let item = self.data[i]
        if pred(item):
            return Some(item)
        i = i + 1
    return None

// count: number of elements for which `pred` holds.
pub fn count[T](self: Vec[T], pred: fn(T) -> bool) -> i64:
    mut n := 0 as i64
    mut i := 0 as i64
    while i < self.len:
        if pred(self.data[i]):
            n = n + 1
        i = i + 1
    return n

// position: index of the first element for which `pred` holds, else None.
pub fn position[T](self: Vec[T], pred: fn(T) -> bool) -> Option[i64]:
    mut i := 0 as i64
    while i < self.len:
        if pred(self.data[i]):
            return Some(i)
        i = i + 1
    return None

// take_while: a new Vec[T] of the leading run of elements for which `pred` holds.
pub fn take_while[T](self: Vec[T], pred: fn(T) -> bool) -> Vec[T]:
    mut result := Vec[T](data: null as ptr[T], len: 0 as i64, cap: 0 as i64)
    mut i := 0 as i64
    while i < self.len:
        let item = self.data[i]
        if not pred(item):
            return result
        result.push(item)
        i = i + 1
    return result

// skip_while: a new Vec[T] dropping the leading run for which `pred` holds.
pub fn skip_while[T](self: Vec[T], pred: fn(T) -> bool) -> Vec[T]:
    mut result := Vec[T](data: null as ptr[T], len: 0 as i64, cap: 0 as i64)
    mut i := 0 as i64
    mut skipping := true
    while i < self.len:
        let item = self.data[i]
        if skipping and pred(item):
            i = i + 1
        else:
            skipping = false
            result.push(item)
            i = i + 1
    return result

// reverse: a new Vec[T] with the elements in reverse order.
pub fn reverse[T](self: Vec[T]) -> Vec[T]:
    mut result := Vec[T](data: null as ptr[T], len: 0 as i64, cap: 0 as i64)
    mut i := self.len - 1
    while i >= 0:
        result.push(self.data[i])
        i = i - 1
    return result

// enumerate: build a new Vec of `(index, element)` tuples. Unblocked by aa419a2
// (is_generic recursing into __tup fields), which lets a `Vec[(i64, T)]` — a Vec
// whose element is a tuple containing the generic param T — monomorphize correctly.
pub fn enumerate[T](self: Vec[T]) -> Vec[(i64, T)]:
    mut result: Vec[(i64, T)] = Vec.new()
    mut i := 0 as i64
    while i < self.len:
        result.push((i, self.data[i]))
        i = i + 1
    return result

// NOTE: `partition[T](self, pred) -> (Vec[T], Vec[T])` was tried and REVERTED —
// adding it broke t_modcollide (module-qualified `lib_a.close`/`lib_b.close` both
// resolved to lib_a → 2 instead of 101). The tuple-of-Vecs return itself works
// (probe passed 62 at O0/O1). Root is NOT registration/resolution (both verified
// correct via trace: distinct symbols 1619/1622, resolve_field returns each) — it
// is a codegen SYMBOL-EMISSION bug: the MODDUP `__m` uniquing is not applied to
// these `close` symbols in the self-link path so they emit bare `ax_close` and
// link-collide. See [[bug-crossmodule-resolution-fragility-open]] for the full
// (multi-layer) trace trail. Defer to a dedicated codegen-emission (B==C) session.

// is_empty: true when the Vec has no elements.
pub fn is_empty[T](self: Vec[T]) -> bool:
    return self.len == 0 as i64

// extend: append every element of `other` (a copy of each element).
pub fn extend[T](mut self: Vec[T], other: Vec[T]):
    mut i := 0 as i64
    while i < other.len:
        self.push(other.data[i])
        i = i + 1

// NOTE: deliberately NOT adding `first`/`last` here. In the native bundled-stdlib
// model every stdlib fn name is globally visible, so a common method name shadows a
// user free function of the same name (BUG#80 class) — e.g. a user `fn first(a, b)`
// mis-resolves to `Vec.first` and miscompiles. `v.get(0)` / `v.get(v.len - 1)` cover
// these safely until the free-fn-vs-method overload resolution is hardened.

// Hash helper supporting all types generically by FNV-1a hashing their bytes.
// Specialized for 'str' key types by checking size == 16 (since strings contain a ptr + len).
fn hash_key[K](key: K) -> u64:
    let ptr = &key as ptr[u8]
    let size = @compiler_intrinsic("size_of")[K]()
    if size == 16:
        // Treat as string key
        let s = (ptr as ptr[str]).*
        mut h := 14695981039346656037 as u64
        mut i := 0 as i64
        while i < s.len:
            h = h ^ (s.ptr[i] as u64)
            h = h * 1099511628211 as u64
            i = i + 1
        return h
    else:
        // Hash raw bytes
        mut h := 14695981039346656037 as u64
        mut i := 0 as i64
        while i < size:
            h = h ^ (ptr[i] as u64)
            h = h * 1099511628211 as u64
            i = i + 1
        return h

pub struct HashMap[K, V]:
    keys:    ptr[K]
    values:  ptr[V]
    hashes:  ptr[u64]
    occupied: ptr[bool]
    size:     i64
    cap:     i64

pub fn new_hashmap[K, V]() -> HashMap[K, V]:
    return HashMap[K, V](
        keys: null as ptr[K],
        values: null as ptr[V],
        hashes: null as ptr[u64],
        occupied: null as ptr[bool],
        size: 0 as i64,
        cap: 0 as i64
    )

pub fn len[K, V](self: HashMap[K, V]) -> i64:
    return self.size

pub fn insert[K, V](mut self: HashMap[K, V], key: K, value: V):
    if self.cap == 0:
        // Initialize capacity to 16
        self.cap = 16
        self.keys = @alloc(self.cap * (@compiler_intrinsic("size_of")[K]() as i64)) as ptr[K]
        self.values = @alloc(self.cap * (@compiler_intrinsic("size_of")[V]() as i64)) as ptr[V]
        self.hashes = @alloc(self.cap * 8) as ptr[u64]
        self.occupied = @alloc(self.cap * 1) as ptr[bool]
        mut i := 0 as i64
        while i < self.cap:
            self.occupied[i] = false
            i = i + 1

    if self.size * 2 >= self.cap:
        // Resize to double capacity
        let old_cap = self.cap
        let old_keys = self.keys
        let old_values = self.values
        let old_hashes = self.hashes
        let old_occupied = self.occupied

        self.cap = old_cap * 2
        self.keys = @alloc(self.cap * (@compiler_intrinsic("size_of")[K]() as i64)) as ptr[K]
        self.values = @alloc(self.cap * (@compiler_intrinsic("size_of")[V]() as i64)) as ptr[V]
        self.hashes = @alloc(self.cap * 8) as ptr[u64]
        self.occupied = @alloc(self.cap * 1) as ptr[bool]
        mut i := 0 as i64
        while i < self.cap:
            self.occupied[i] = false
            i = i + 1

        self.size = 0
        mut j := 0 as i64
        while j < old_cap:
            if old_occupied[j]:
                self.insert(old_keys[j], old_values[j])
            j = j + 1

        if old_keys != null as ptr[K]:
            @free(old_keys as ptr[u8])
            @free(old_values as ptr[u8])
            @free(old_hashes as ptr[u8])
            @free(old_occupied as ptr[u8])

    mut curr_h := hash_key[K](key)
    mut curr_key := key
    mut curr_value := value
    mut idx := (curr_h % (self.cap as u64)) as i64
    mut current_dib := 0 as i64
    mut loop := true

    while loop:
        if not self.occupied[idx]:
            self.keys[idx] = curr_key
            self.values[idx] = curr_value
            self.hashes[idx] = curr_h
            self.occupied[idx] = true
            self.size = self.size + 1
            loop = false
        elif self.hashes[idx] == curr_h and self.keys[idx] == curr_key:
            self.values[idx] = curr_value
            loop = false
        else:
            let resident_h = self.hashes[idx]
            let resident_dib = (idx - (resident_h % (self.cap as u64)) as i64 + self.cap) % self.cap
            if current_dib > resident_dib:
                let tmp_key = self.keys[idx]
                let tmp_value = self.values[idx]
                let tmp_h = resident_h

                self.keys[idx] = curr_key
                self.values[idx] = curr_value
                self.hashes[idx] = curr_h

                curr_key = tmp_key
                curr_value = tmp_value
                curr_h = tmp_h
                current_dib = resident_dib

            idx = (idx + 1) % self.cap
            current_dib = current_dib + 1

pub fn get[K, V](self: HashMap[K, V], key: K) -> Option[V]:
    if self.cap == 0:
        return None
    let h = hash_key[K](key)
    mut idx := (h % (self.cap as u64)) as i64
    mut current_dib := 0 as i64
    mut loop := true

    while loop:
        if not self.occupied[idx]:
            return None
        elif self.hashes[idx] == h and self.keys[idx] == key:
            return Some(self.values[idx])
        else:
            let resident_h = self.hashes[idx]
            let resident_dib = (idx - (resident_h % (self.cap as u64)) as i64 + self.cap) % self.cap
            if current_dib > resident_dib:
                return None
            idx = (idx + 1) % self.cap
            current_dib = current_dib + 1
            if current_dib >= self.cap:
                return None

/// Returns true iff `key` is present. The membership API for HashMap (mirrors
/// Rust's `HashMap::contains_key`). Named `contains_key` — NOT `contains` — so it
/// does not collide with `HashSet.contains` (method dispatch is by name + self
/// base-type; a distinct name avoids any ambiguity). A direct bool probe (same
/// Robin-Hood scan as `get`) so it never round-trips through Option.
pub fn contains_key[K, V](self: HashMap[K, V], key: K) -> bool:
    if self.cap == 0:
        return false
    let h = hash_key[K](key)
    mut idx := (h % (self.cap as u64)) as i64
    mut current_dib := 0 as i64
    mut loop := true
    while loop:
        if not self.occupied[idx]:
            return false
        elif self.hashes[idx] == h and self.keys[idx] == key:
            return true
        else:
            let resident_h = self.hashes[idx]
            let resident_dib = (idx - (resident_h % (self.cap as u64)) as i64 + self.cap) % self.cap
            if current_dib > resident_dib:
                return false
            idx = (idx + 1) % self.cap
            current_dib = current_dib + 1
            if current_dib >= self.cap:
                return false
    return false

pub fn remove[K, V](mut self: HashMap[K, V], key: K) -> bool:
    if self.cap == 0:
        return false
    let h = hash_key[K](key)
    mut idx := (h % (self.cap as u64)) as i64
    mut current_dib := 0 as i64
    mut found := false

    mut loop := true
    while loop:
        if not self.occupied[idx]:
            return false
        elif self.hashes[idx] == h and self.keys[idx] == key:
            found = true
            loop = false
        else:
            let resident_h = self.hashes[idx]
            let resident_dib = (idx - (resident_h % (self.cap as u64)) as i64 + self.cap) % self.cap
            if current_dib > resident_dib:
                return false
            idx = (idx + 1) % self.cap
            current_dib = current_dib + 1
            if current_dib >= self.cap:
                return false

    if not found:
        return false

    // Found it! Shift subsequent elements backward
    self.size = self.size - 1
    mut curr := idx
    mut next := (idx + 1) % self.cap
    mut shift_loop := true

    while shift_loop:
        if not self.occupied[next]:
            self.occupied[curr] = false
            shift_loop = false
        else:
            let next_h = self.hashes[next]
            let next_dib = (next - (next_h % (self.cap as u64)) as i64 + self.cap) % self.cap
            if next_dib == 0 as i64:
                self.occupied[curr] = false
                shift_loop = false
            else:
                self.keys[curr] = self.keys[next]
                self.values[curr] = self.values[next]
                self.hashes[curr] = next_h
                self.occupied[curr] = true
                curr = next
                next = (next + 1) % self.cap
    return true

pub fn destroy[K, V](mut self: HashMap[K, V]):
    if self.keys != null as ptr[K]:
        @free(self.keys as ptr[u8])
        @free(self.values as ptr[u8])
        @free(self.hashes as ptr[u8])
        @free(self.occupied as ptr[u8])
        self.keys = null as ptr[K]
        self.values = null as ptr[V]
        self.hashes = null as ptr[u64]
        self.occupied = null as ptr[bool]
    self.size = 0
    self.cap = 0

pub struct HashSet[T]:
    map: HashMap[T, bool]

pub fn new_hashset[T]() -> HashSet[T]:
    return HashSet[T](map: new_hashmap[T, bool]())

pub fn len[T](self: HashSet[T]) -> i64:
    return self.map.len()

pub fn contains[T](self: HashSet[T], item: T) -> bool:
    // NB: block-form match arms — inline arms (`Some(_): true`) mis-lower to always
    // taking the first arm, so this used to return true for ANY item.
    match self.map.get(item):
        Some(x):
            return true
        None:
            return false

pub fn insert[T](mut self: HashSet[T], item: T) -> bool:
    let exists = self.contains(item)
    self.map.insert(item, true)
    return not exists

pub fn remove[T](mut self: HashSet[T], item: T) -> bool:
    return self.map.remove(item)

pub fn destroy[T](mut self: HashSet[T]):
    self.map.destroy()
