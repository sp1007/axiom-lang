// AXIOM Standard Library — std.math
//
// Pure-AXIOM mathematical constants and functions. NO libm / extern dependency:
// every transcendental is implemented in AXIOM (Newton, range-reduction,
// Taylor / atanh series).
//
// Backend note (BUG#44): the native backend does not yet preserve callee-saved
// XMM registers across calls, so a float value held ACROSS an internal call is
// corrupted. Functions here are therefore written either as leaves (no internal
// call) or as single tail-style compositions where the float param is consumed
// before the call (e.g. `ln(x) / LN2`). Compositions that need a float param
// AFTER a call (pow, tan) inline their dependencies instead of calling them.

// --- Constants ---
pub const PI:      f64 = 3.14159265358979323846
pub const TAU:     f64 = 6.28318530717958647692
pub const HALF_PI: f64 = 1.57079632679489661923
pub const E:       f64 = 2.71828182845904523536
pub const SQRT2:   f64 = 1.41421356237309504880
pub const LN2:     f64 = 0.69314718055994530942
pub const LN10:    f64 = 2.30258509299404568402
pub const PHI:     f64 = 1.61803398874989484820

// --- Absolute value / rounding (leaf) ---

pub fn abs(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x

pub fn floor(x: f64) -> f64:
    let t = (x as i64) as f64
    if t > x:
        return t - 1.0
    return t

pub fn ceil(x: f64) -> f64:
    let t = (x as i64) as f64
    if t < x:
        return t + 1.0
    return t

pub fn round(x: f64) -> f64:
    if x < 0.0:
        return (x - 0.5) as i64 as f64
    return (x + 0.5) as i64 as f64

pub fn fmod(x: f64, y: f64) -> f64:
    if y == 0.0:
        return 0.0
    let q = (x / y) as i64 as f64
    return x - q * y

// --- Roots / exp / log (leaf, self-contained) ---

// Newton-Raphson square root.
pub fn sqrt(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut g := x
    mut i := 0 as i32
    while i < 80:
        let ng = (g + x / g) * 0.5
        mut d := ng - g
        if d < 0.0:
            d = 0.0 - d
        if d < 0.000000000001:
            return ng
        g = ng
        i = i + 1
    return g

// e^x via range reduction (e^x = 2^k * e^r, k = round(x/ln2)) + Taylor on r.
pub fn exp(x: f64) -> f64:
    mut k := (x / LN2 + 0.5) as i64
    if x < 0.0:
        k = (x / LN2 - 0.5) as i64
    let r = x - (k as f64) * LN2
    mut term := 1.0
    mut sum := 1.0
    mut n := 1 as i32
    while n < 18:
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    mut res := sum
    mut kk := k
    while kk > 0 as i64:
        res = res * 2.0
        kk = kk - 1 as i64
    while kk < 0 as i64:
        res = res * 0.5
        kk = kk + 1 as i64
    return res

// Natural log via ln(m * 2^e) = e*ln2 + ln(m), m in [1,2),
// ln(m) = 2 * atanh((m-1)/(m+1)).
pub fn ln(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    mut m := x
    mut e := 0 as i64
    while m >= 2.0:
        m = m * 0.5
        e = e + 1 as i64
    while m < 1.0:
        m = m * 2.0
        e = e - 1 as i64
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    mut term := t
    mut sum := 0.0
    mut n := 0 as i32
    while n < 20:
        sum = sum + term / ((2 * n + 1) as f64)
        term = term * t2
        n = n + 1
    return (e as f64) * LN2 + 2.0 * sum

// Single tail-composition: param x is consumed by ln() before the divide, so it
// is not held across the call (BUG#44-safe).
pub fn log2(x: f64) -> f64:
    return ln(x) / LN2

pub fn log10(x: f64) -> f64:
    return ln(x) / LN10

// b^p = exp(p * ln b). Inlined (p must survive past the ln computation).
pub fn pow(b: f64, p: f64) -> f64:
    if b <= 0.0:
        return 0.0
    mut m := b
    mut le := 0 as i64
    while m >= 2.0:
        m = m * 0.5
        le = le + 1 as i64
    while m < 1.0:
        m = m * 2.0
        le = le - 1 as i64
    let lt = (m - 1.0) / (m + 1.0)
    let lt2 = lt * lt
    mut lterm := lt
    mut lsum := 0.0
    mut li := 0 as i32
    while li < 20:
        lsum = lsum + lterm / ((2 * li + 1) as f64)
        lterm = lterm * lt2
        li = li + 1
    let lnb = (le as f64) * LN2 + 2.0 * lsum
    let x = p * lnb
    mut k := (x / LN2 + 0.5) as i64
    if x < 0.0:
        k = (x / LN2 - 0.5) as i64
    let r = x - (k as f64) * LN2
    mut eterm := 1.0
    mut esum := 1.0
    mut en := 1 as i32
    while en < 18:
        eterm = eterm * r / (en as f64)
        esum = esum + eterm
        en = en + 1
    mut res := esum
    mut kk := k
    while kk > 0 as i64:
        res = res * 2.0
        kk = kk - 1 as i64
    while kk < 0 as i64:
        res = res * 0.5
        kk = kk + 1 as i64
    return res

// --- Trigonometry ---

// sin via reduction to [-pi, pi] then Taylor (leaf, self-contained).
pub fn sin(x: f64) -> f64:
    mut a := x
    let q = (a / TAU) as i64
    a = a - (q as f64) * TAU
    if a > PI:
        a = a - TAU
    if a < (0.0 - PI):
        a = a + TAU
    let a2 = a * a
    mut term := a
    mut sum := a
    mut n := 1 as i32
    while n < 12:
        let d = ((2 * n) * (2 * n + 1)) as f64
        term = (0.0 - term) * a2 / d
        sum = sum + term
        n = n + 1
    return sum

// cos(x) = sin(x + pi/2). Single tail-composition (x consumed before the call).
pub fn cos(x: f64) -> f64:
    return sin(x + HALF_PI)

// tan = sin/cos, inlined (x is needed for both halves -> cannot survive a call).
pub fn tan(x: f64) -> f64:
    // reduce once
    mut a := x
    let q = (a / TAU) as i64
    a = a - (q as f64) * TAU
    if a > PI:
        a = a - TAU
    if a < (0.0 - PI):
        a = a + TAU
    // sin(a)
    let a2 = a * a
    mut sterm := a
    mut s := a
    mut sn := 1 as i32
    while sn < 12:
        let sd = ((2 * sn) * (2 * sn + 1)) as f64
        sterm = (0.0 - sterm) * a2 / sd
        s = s + sterm
        sn = sn + 1
    // cos(a) = 1 - a^2/2! + ...
    mut cterm := 1.0
    mut c := 1.0
    mut cn := 1 as i32
    while cn < 12:
        let cd = ((2 * cn - 1) * (2 * cn)) as f64
        cterm = (0.0 - cterm) * a2 / cd
        c = c + cterm
        cn = cn + 1
    if c == 0.0:
        return 0.0
    return s / c

// Reciprocal trig. Each holds at most one call-result at a time (BUG#48-safe).
pub fn sec(x: f64) -> f64:
    return 1.0 / cos(x)

pub fn csc(x: f64) -> f64:
    return 1.0 / sin(x)

pub fn cot(x: f64) -> f64:
    let s = sin(x)
    return cos(x) / s

// --- Float predicates ---

pub fn is_nan(x: f64) -> bool:
    return x != x

pub fn is_inf(x: f64) -> bool:
    return x > 1.0e308 or x < (0.0 - 1.0e308)

pub fn is_finite(x: f64) -> bool:
    return not is_nan(x) and not is_inf(x)

// --- Integer helpers ---

pub fn abs_i64(x: i64) -> i64:
    if x < 0 as i64:
        return 0 as i64 - x
    return x

pub fn min_i64(a: i64, b: i64) -> i64:
    if a <= b:
        return a
    return b

pub fn max_i64(a: i64, b: i64) -> i64:
    if a >= b:
        return a
    return b

pub fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

pub fn min_f64(a: f64, b: f64) -> f64:
    if a <= b:
        return a
    return b

pub fn max_f64(a: f64, b: f64) -> f64:
    if a >= b:
        return a
    return b

// Fast integer exponentiation (exponentiation by squaring).
pub fn pow_i64(base: i64, exp: i64) -> i64:
    mut result := 1 as i64
    mut b := base
    mut e := exp
    while e > 0 as i64:
        if e % 2 as i64 == 1 as i64:
            result = result * b
        b = b * b
        e = e / 2 as i64
    return result

// Greatest common divisor (Euclid).
pub fn gcd(a: i64, b: i64) -> i64:
    mut x := a
    if x < 0 as i64:
        x = 0 as i64 - x
    mut y := b
    if y < 0 as i64:
        y = 0 as i64 - y
    while y != 0 as i64:
        let t = y
        y = x % y
        x = t
    return x

// Least common multiple.
pub fn lcm(a: i64, b: i64) -> i64:
    if a == 0 as i64 or b == 0 as i64:
        return 0 as i64
    mut g := gcd(a, b)
    mut ax := a
    if ax < 0 as i64:
        ax = 0 as i64 - ax
    mut bx := b
    if bx < 0 as i64:
        bx = 0 as i64 - bx
    return ax / g * bx

// ============================================================================
// Extended scalar functions (RFC-free library growth; all leaf or tail-safe to
// avoid BUG#44 — a float value must never be held across a call, so use the
// `let r = f(...); return CONST op r` order, never `CONST op f(...)`).
// ============================================================================

// --- Additional constants ---
pub const LOG2E:   f64 = 1.44269504088896340736
pub const LOG10E:  f64 = 0.43429448190325182765
pub const SQRT1_2: f64 = 0.70710678118654752440
pub const EPSILON: f64 = 0.00000000000000022204460492503131

pub fn sign(x: f64) -> f64:
    if x > 0.0:
        return 1.0
    if x < 0.0:
        return 0.0 - 1.0
    return 0.0

pub fn clamp(x: f64, lo: f64, hi: f64) -> f64:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

pub fn trunc(x: f64) -> f64:
    return (x as i64) as f64

pub fn fract(x: f64) -> f64:
    return x - (x as i64) as f64

pub fn square(x: f64) -> f64:
    return x * x

pub fn cube(x: f64) -> f64:
    return x * x * x

pub fn recip(x: f64) -> f64:
    return 1.0 / x

// cbrt via Newton (leaf): converge y^3 = x
pub fn cbrt(x: f64) -> f64:
    if x == 0.0:
        return 0.0
    mut neg := false
    mut a := x
    if a < 0.0:
        neg = true
        a = 0.0 - a
    mut y := a
    mut i := 0 as i32
    while i < 100:
        let y3 = y * y * y
        let ny = y - (y3 - a) / (3.0 * y * y)
        mut d := ny - y
        if d < 0.0:
            d = 0.0 - d
        if d < 0.000000000001:
            y = ny
            i = 100
        else:
            y = ny
            i = i + 1
    if neg:
        return 0.0 - y
    return y

pub fn hypot(x: f64, y: f64) -> f64:
    return sqrt(x * x + y * y)

// exp2 = exp(x*ln2): x consumed before call -> tail-safe
pub fn exp2(x: f64) -> f64:
    return exp(x * LN2)

pub fn exp10(x: f64) -> f64:
    return exp(x * LN10)

pub fn log1p(x: f64) -> f64:
    return ln(1.0 + x)

// atan via half-angle reduction (inlined sqrt) + Taylor: leaf, ~8 digits
pub fn atan(x: f64) -> f64:
    mut sgn := 1.0
    mut a := x
    if a < 0.0:
        sgn = 0.0 - 1.0
        a = 0.0 - a
    mut addpi := 0.0
    if a > 1.0:
        // atan(a) = pi/2 - atan(1/a)
        addpi = HALF_PI
        a = 1.0 / a
    // one half-angle: z = a/(1+sqrt(1+a^2))  -> atan(a)=2*atan(z)
    let s = a * a
    mut g := 1.0 + s
    mut gi := 0 as i32
    while gi < 60:
        g = (g + (1.0 + s) / g) * 0.5
        gi = gi + 1
    let z = a / (1.0 + g)
    let z2 = z * z
    mut term := z
    mut sum := z
    mut n := 1 as i32
    while n < 30:
        term = (0.0 - term) * z2
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    mut res := 2.0 * sum
    if addpi > 0.0:
        res = addpi - res
    return sgn * res

pub fn asin(x: f64) -> f64:
    if x >= 1.0:
        return HALF_PI
    if x <= (0.0 - 1.0):
        return 0.0 - HALF_PI
    // asin(x) = atan(x/sqrt(1-x^2)); inline sqrt of (1-x^2)
    let s = 1.0 - x * x
    mut g := s
    if g < 0.0:
        g = 0.0
    mut gg := 1.0
    if s > 0.0:
        gg = s
        mut gi := 0 as i32
        while gi < 60:
            gg = (gg + s / gg) * 0.5
            gi = gi + 1
    return atan(x / gg)

pub fn acos(x: f64) -> f64:
    if x >= 1.0:
        return 0.0
    if x <= (0.0 - 1.0):
        return PI
    let s = 1.0 - x * x
    mut gg := 1.0
    if s > 0.0:
        gg = s
        mut gi := 0 as i32
        while gi < 60:
            gg = (gg + s / gg) * 0.5
            gi = gi + 1
    let r = atan(x / gg)
    return HALF_PI - r

pub fn atan2(y: f64, x: f64) -> f64:
    if x > 0.0:
        return atan(y / x)
    if x < 0.0:
        if y >= 0.0:
            return atan(y / x) + PI
        return atan(y / x) - PI
    if y > 0.0:
        return HALF_PI
    if y < 0.0:
        return 0.0 - HALF_PI
    return 0.0

// sinh/cosh/tanh via exp (x consumed before call -> tail-safe)
pub fn sinh(x: f64) -> f64:
    let e = exp(x)
    return (e - 1.0 / e) * 0.5

pub fn cosh(x: f64) -> f64:
    let e = exp(x)
    return (e + 1.0 / e) * 0.5

pub fn tanh(x: f64) -> f64:
    let e = exp(x + x)
    return (e - 1.0) / (e + 1.0)

pub fn asinh(x: f64) -> f64:
    // ln(x + sqrt(x^2+1)); inline sqrt
    let s = x * x + 1.0
    mut g := s
    mut gi := 0 as i32
    while gi < 60:
        g = (g + s / g) * 0.5
        gi = gi + 1
    return ln(x + g)

pub fn acosh(x: f64) -> f64:
    if x < 1.0:
        return 0.0
    let s = x * x - 1.0
    mut g := s
    if s > 0.0:
        mut gi := 0 as i32
        while gi < 60:
            g = (g + s / g) * 0.5
            gi = gi + 1
    else:
        g = 0.0
    return ln(x + g)

pub fn atanh(x: f64) -> f64:
    let x2 = x * x
    mut term := x
    mut sum := x
    mut n := 1 as i32
    while n < 60:
        term = term * x2
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    return sum

pub fn deg_to_rad(d: f64) -> f64:
    return d * (PI / 180.0)

pub fn rad_to_deg(r: f64) -> f64:
    return r * (180.0 / PI)

pub fn lerp(a: f64, b: f64, t: f64) -> f64:
    return a + (b - a) * t

pub fn inverse_lerp(a: f64, b: f64, v: f64) -> f64:
    if b == a:
        return 0.0
    return (v - a) / (b - a)

pub fn smoothstep(e0: f64, e1: f64, x: f64) -> f64:
    mut t := (x - e0) / (e1 - e0)
    if t < 0.0:
        t = 0.0
    if t > 1.0:
        t = 1.0
    return t * t * (3.0 - 2.0 * t)

pub fn saturate(x: f64) -> f64:
    if x < 0.0:
        return 0.0
    if x > 1.0:
        return 1.0
    return x

pub fn approx_equal(a: f64, b: f64, eps: f64) -> bool:
    mut d := a - b
    if d < 0.0:
        d = 0.0 - d
    return d <= eps

// sigmoid(x) = 1/(1+exp(-x)) : tail-safe
pub fn sigmoid(x: f64) -> f64:
    let e = exp(0.0 - x)
    return 1.0 / (1.0 + e)

pub fn relu(x: f64) -> f64:
    if x < 0.0:
        return 0.0
    return x

pub fn leaky_relu(x: f64, a: f64) -> f64:
    if x < 0.0:
        return a * x
    return x

pub fn softplus(x: f64) -> f64:
    let e = exp(x)
    return ln(1.0 + e)

// swish(x) = x*sigmoid(x): x reused after transcendental -> inline exp (leaf)
pub fn swish(x: f64) -> f64:
    let nx = 0.0 - x
    mut k := (nx / LN2 + 0.5) as i64
    if nx < 0.0:
        k = (nx / LN2 - 0.5) as i64
    let r = nx - (k as f64) * LN2
    mut term := 1.0
    mut e := 1.0
    mut n := 1 as i32
    while n < 18:
        term = term * r / (n as f64)
        e = e + term
        n = n + 1
    mut kk := k
    while kk > 0 as i64:
        e = e * 2.0
        kk = kk - 1 as i64
    while kk < 0 as i64:
        e = e * 0.5
        kk = kk + 1 as i64
    return x / (1.0 + e)

// ---- integer bit math ----

pub fn popcount(x: u64) -> i64:
    mut v := x
    mut c := 0 as i64
    while v != 0 as u64:
        c = c + (v & 1 as u64) as i64
        v = v >> 1
    return c

pub fn clz(x: u64) -> i64:
    if x == 0 as u64:
        return 64 as i64
    mut v := x
    mut n := 0 as i64
    while (v & (1 as u64 << 63)) == 0 as u64:
        v = v << 1
        n = n + 1
    return n

pub fn ctz(x: u64) -> i64:
    if x == 0 as u64:
        return 64 as i64
    mut v := x
    mut n := 0 as i64
    while (v & 1 as u64) == 0 as u64:
        v = v >> 1
        n = n + 1
    return n

pub fn bit_width(x: u64) -> i64:
    return 64 as i64 - clz(x)

pub fn rotate_left(x: u64, k: i64) -> u64:
    let r = k & 63 as i64
    if r == 0 as i64:
        return x
    return (x << r) | (x >> (64 as i64 - r))

pub fn has_single_bit(x: u64) -> bool:
    return x != 0 as u64 and (x & (x - 1 as u64)) == 0 as u64

pub fn mul_hi(a: u64, b: u64) -> u64:
    let mask = 4294967295 as u64
    let aL = a & mask
    let aH = a >> 32
    let bL = b & mask
    let bH = b >> 32
    let cross = aL * bH + aH * bL
    mut carry := 0 as u64
    if cross < aL * bH:
        carry = 1 as u64
    let lo = aL * bL + (cross << 32)
    mut c2 := 0 as u64
    if lo < aL * bL:
        c2 = 1 as u64
    return aH * bH + (cross >> 32) + (carry << 32) + c2


// --- Error function (Abramowitz-Stegun 7.1.26, ~1e-7; composes exp) ---
pub fn erf(x: f64) -> f64:
    mut sgn := 1.0
    mut a := x
    if a < 0.0:
        sgn = 0.0 - 1.0
        a = 0.0 - a
    let t = 1.0 / (1.0 + 0.3275911 * a)
    let poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
    let e = exp(0.0 - a * a)
    return sgn * (1.0 - poly * e)

pub fn erfc(x: f64) -> f64:
    let v = erf(x)
    return 1.0 - v

// --- Gamma family via log-form Lanczos (g=7, no pow -> accurate) ---
const LN2PI_HALF: f64 = 0.91893853320467274178   // 0.5*ln(2*pi)

fn lanczos_sum_g(z: f64) -> f64:
    mut x := 0.99999999999980993
    x = x + 676.5203681218851 / (z + 1.0)
    x = x + (0.0 - 1259.1392167224028) / (z + 2.0)
    x = x + 771.32342877765313 / (z + 3.0)
    x = x + (0.0 - 176.61502916214059) / (z + 4.0)
    x = x + 12.507343278686905 / (z + 5.0)
    x = x + (0.0 - 0.13857109526572012) / (z + 6.0)
    x = x + 0.0000099843695780195716 / (z + 7.0)
    x = x + 0.00000015056327351493116 / (z + 8.0)
    return x

// natural log of |gamma(z)| (z > 0).
pub fn lgamma(z: f64) -> f64:
    if z < 0.5:
        mut sp := sin(PI * z)
        if sp < 0.0:
            sp = 0.0 - sp
        let lg1 = lgamma(1.0 - z)
        return ln(PI / sp) - lg1
    let zz = z - 1.0
    let t = zz + 7.5
    let s = lanczos_sum_g(zz)
    return LN2PI_HALF + (zz + 0.5) * ln(t) - t + ln(s)

// gamma(z).
pub fn tgamma(z: f64) -> f64:
    let lg = lgamma(z)
    let g = exp(lg)
    if z < 0.5:
        let sp = sin(PI * z)
        if sp < 0.0:
            return 0.0 - g
    return g

// beta(a,b) = gamma(a)gamma(b)/gamma(a+b), via lgamma (no overflow).
pub fn beta(a: f64, b: f64) -> f64:
    return exp(lgamma(a) + lgamma(b) - lgamma(a + b))

// --- Fill-ins: exp/log/angle/fp utility ---

// e^x - 1 (composition; param consumed before the call).
pub fn expm1(x: f64) -> f64:
    return exp(x) - 1.0

// Logarithm of x in an arbitrary base b: ln(x)/ln(b).
pub fn log_base(b: f64, x: f64) -> f64:
    return ln(x) / ln(b)

// Wrap an angle into [-PI, PI).
pub fn normalize_angle(a: f64) -> f64:
    return a - TAU * floor((a + PI) / TAU)

// Magnitude of `mag` with the sign of `sgn`.
pub fn copysign(mag: f64, sgn: f64) -> f64:
    mut m := mag
    if m < 0.0:
        m = 0.0 - m
    if sgn < 0.0:
        return 0.0 - m
    return m

// Round x to `d` decimal places.
pub fn round_to(x: f64, d: i64) -> f64:
    mut p := 1.0
    mut i := 0 as i64
    while i < d:
        p = p * 10.0
        i = i + 1
    return round(x * p) / p

// --- Bit math fill-ins (u64) ---

// Rotate the 64-bit value right by k bits.
pub fn rotate_right(x: u64, k: u64) -> u64:
    if k == 0 as u64:
        return x
    return (x >> k) | (x << (64 as u64 - k))

// Reverse the order of all 64 bits.
pub fn reverse_bits(x: u64) -> u64:
    mut r := 0 as u64
    mut v := x
    mut i := 0 as i32
    while i < 64:
        r = (r << 1) | (v & 1 as u64)
        v = v >> 1
        i = i + 1
    return r

// Largest power of two <= x (0 for x == 0).
pub fn bit_floor(x: u64) -> u64:
    if x == 0 as u64:
        return 0 as u64
    mut p := (1 as u64) << 63
    while p > x:
        p = p >> 1
    return p

// Smallest power of two >= x (1 for x <= 1).
pub fn bit_ceil(x: u64) -> u64:
    if x <= 1 as u64:
        return 1 as u64
    let f = bit_floor(x)
    if f == x:
        return x
    return f << 1

// 1 if x has an odd number of set bits, else 0.
pub fn parity(x: u64) -> u64:
    mut v := x
    mut c := 0 as u64
    while v != 0 as u64:
        c = c + (v & 1 as u64)
        v = v >> 1
    return c & 1 as u64

// --- Special functions ---

// Real-valued factorial x! = gamma(x+1).
pub fn factorial_real(x: f64) -> f64:
    return tgamma(x + 1.0)

// Digamma psi(x): recurrence up to x>=6 then the asymptotic expansion.
pub fn digamma(x: f64) -> f64:
    mut xx := x
    mut r := 0.0
    while xx < 6.0:
        r = r - 1.0 / xx
        xx = xx + 1.0
    let inv = 1.0 / xx
    let inv2 = inv * inv
    let tail = ln(xx) - 0.5 * inv - inv2 * (1.0 / 12.0 - inv2 * (1.0 / 120.0 - inv2 / 252.0))
    return r + tail

// Bessel function of the first kind, order 0, via the ascending power series
// (accurate for |x| up to ~10).
pub fn bessel_j0(x: f64) -> f64:
    let h2 = x * x * 0.25
    mut term := 1.0
    mut sum := 1.0
    mut m := 1 as i32
    while m < 40:
        term = term * (0.0 - h2) / ((m * m) as f64)
        sum = sum + term
        m = m + 1
    return sum
